def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def normalized_sha256(path: Path) -> str:
    text = path.read_text(encoding="utf-8").replace("\r\n", "\n")
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def record(path: Path) -> dict[str, str]:
    return {
        "path": str(path.relative_to(ROOT)).replace("\\", "/"),
        "sha256": sha256(path),
    }


def selected_g3an() -> tuple[Path, Path]:
    canonical_g3ap = record(G3AP)
    candidates = (
        (G3AN_DIRECT, G3AN_DIRECT_VERIFIER),
        (G3AN_FULL, G3AN_FULL_VERIFIER),
    )
    stale: list[str] = []
    for path, verifier in candidates:
        if not path.is_file():
            continue
        packet = load(path)
        if (
            packet.get("inputs", {}).get("selected_G3AP_certificate")
            == canonical_g3ap
        ):
            return path, verifier
        stale.append(str(path.relative_to(ROOT)))
    if stale:
        raise AssertionError(
            "G3AN packets exist but are stale against canonical G3AP: "
            + ", ".join(stale)
        )
    raise AssertionError("missing selected G3AN direct or full-response certificate")


