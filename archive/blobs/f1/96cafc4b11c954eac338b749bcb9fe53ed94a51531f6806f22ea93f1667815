def element(values: Iterable[int]) -> Element:
    entries = [int(value) % P for value in values]
    require(len(entries) <= 3, "cubic field element length")
    entries += [0] * (3 - len(entries))
    return tuple(entries)  # type: ignore[return-value]


ZERO = element(())
ONE = element((1,))


def e_add(left: Element, right: Element) -> Element:
    return element(a + b for a, b in zip(left, right))


def e_neg(value: Element) -> Element:
    return element(-entry for entry in value)


def e_sub(left: Element, right: Element) -> Element:
    return e_add(left, e_neg(right))


def e_mul(left: Element, right: Element) -> Element:
    work = [0] * 5
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            work[i + j] = (work[i + j] + a * b) % P
    for degree in range(4, 2, -1):
        coefficient = work[degree] % P
        work[degree] = 0
        work[degree - 3] -= RELATION[0] * coefficient
        work[degree - 2] -= RELATION[1] * coefficient
        work[degree - 1] -= RELATION[2] * coefficient
    return element(work[:3])


def e_pow(value: Element, exponent: int) -> Element:
    require(exponent >= 0, "nonnegative exponent")
    result = ONE
    base = value
    while exponent:
        if exponent & 1:
            result = e_mul(result, base)
        base = e_mul(base, base)
        exponent //= 2
    return result


def e_inv(value: Element) -> Element:
    require(value != ZERO, "nonzero field element")
    inverse = e_pow(value, P**3 - 2)
    require(e_mul(value, inverse) == ONE, "field inverse")
    return inverse


def p_trim(values: Polynomial) -> Polynomial:
    values = list(values)
    while len(values) > 1 and values[-1] == ZERO:
        values.pop()
    return values or [ZERO]


def p_pad(values: Polynomial, size: int) -> Polynomial:
    return list(values) + [ZERO] * max(0, size - len(values))


def p_add(left: Polynomial, right: Polynomial) -> Polynomial:
    size = max(len(left), len(right))
    left = p_pad(left, size)
    right = p_pad(right, size)
    return p_trim([e_add(a, b) for a, b in zip(left, right)])


def p_neg(value: Polynomial) -> Polynomial:
    return p_trim([e_neg(entry) for entry in value])


def p_sub(left: Polynomial, right: Polynomial) -> Polynomial:
    return p_add(left, p_neg(right))


def p_scale(value: Polynomial, scalar: Element) -> Polynomial:
    return p_trim([e_mul(entry, scalar) for entry in value])


def p_mul(left: Polynomial, right: Polynomial) -> Polynomial:
    result = [ZERO] * (len(left) + len(right) - 1)
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            result[i + j] = e_add(result[i + j], e_mul(a, b))
    return p_trim(result)


def p_pow(value: Polynomial, exponent: int) -> Polynomial:
    result = [ONE]
    base = value
    while exponent:
        if exponent & 1:
            result = p_mul(result, base)
        base = p_mul(base, base)
        exponent //= 2
    return result


def p_shift(value: Polynomial, degree: int) -> Polynomial:
    return [ZERO] * degree + list(value)


def matrix_rank(matrix: list[list[Element]]) -> int:
    work = [row[:] for row in matrix]
    row_count = len(work)
    column_count = len(work[0]) if work else 0
    rank = 0
    for column in range(column_count):
        pivot = next(
            (row for row in range(rank, row_count) if work[row][column] != ZERO),
            None,
        )
        if pivot is None:
            continue
        work[rank], work[pivot] = work[pivot], work[rank]
        inverse = e_inv(work[rank][column])
        work[rank] = [e_mul(value, inverse) for value in work[rank]]
        for row in range(row_count):
            if row == rank or work[row][column] == ZERO:
                continue
            factor = work[row][column]
            work[row] = [
                e_sub(value, e_mul(factor, pivot_value))
                for value, pivot_value in zip(work[row], work[rank])
            ]
        rank += 1
        if rank == row_count:
            break
    return rank


def determinant(matrix: list[list[Element]]) -> Element:
    size = len(matrix)
    require(size and all(len(row) == size for row in matrix), "square matrix")
    work = [row[:] for row in matrix]
    result = ONE
    sign = 1
    for column in range(size):
        pivot = next(
            (row for row in range(column, size) if work[row][column] != ZERO),
            None,
        )
        require(pivot is not None, "nonsingular matrix")
        if pivot != column:
            work[column], work[pivot] = work[pivot], work[column]
            sign *= -1
        pivot_value = work[column][column]
        result = e_mul(result, pivot_value)
        inverse = e_inv(pivot_value)
        for row in range(column + 1, size):
            if work[row][column] == ZERO:
                continue
            factor = e_mul(work[row][column], inverse)
            for slot in range(column, size):
                work[row][slot] = e_sub(
                    work[row][slot], e_mul(factor, work[column][slot])
                )
    return e_neg(result) if sign < 0 else result


def rows_to_polynomial(rows: list[list[int]]) -> Polynomial:
    return p_trim([element(row) for row in rows])


def build_marked_map_jacobian(selected: dict, line_rows: list[list[int]]) -> list[list[Element]]:
    p_value = rows_to_polynomial(selected["P_coefficients_ascending"])
    q_value = rows_to_polynomial(selected["Q_coefficients_ascending"])
    s_value = rows_to_polynomial(selected["S_coefficients_ascending"])
    h_value = rows_to_polynomial(line_rows)
    lambda_value = element(selected["lambda"])

    p_linearization = p_scale(
        p_mul(q_value, p_pow(p_value, 2)), element((3,))
    )
    s_linearization = p_scale(
        p_mul(h_value, s_value), e_mul(element((-2,)), lambda_value)
    )
    columns = [p_shift(p_linearization, degree) for degree in range(4)]
    columns.extend(p_shift(s_linearization, degree) for degree in range(3))
    columns.append(p_neg(p_mul(h_value, p_pow(s_value, 2))))
    padded = [p_pad(column, 13) for column in columns]
    return [[padded[column][row] for column in range(8)] for row in range(13)]


