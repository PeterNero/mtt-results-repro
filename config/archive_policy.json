{
  "schema": "MTTPublicArchivePolicy.v1",
  "max_default_artifact_bytes": 524288,
  "always_archive_suffixes": [
    ".csv",
    ".md",
    ".py",
    ".tsv",
    ".txt"
  ],
  "always_hash_only_globs": [
    "sm_closure/candidate_data/selected_q79covariantperiodbranchcutsetandtightbetatransport/selected_alignment_thimble_periods/covariant_floating_probe/**",
    "**/.gitattributes"
  ],
  "policy": {
    "all_artifacts_remain_sha256_indexed": true,
    "large_raw_outputs_are_hash_only": true,
    "selected_release_dependencies_must_be_archived": true,
    "purpose": "Keep the public Git repository clonable while preserving exact provenance for bulk diagnostics."
  }
}
