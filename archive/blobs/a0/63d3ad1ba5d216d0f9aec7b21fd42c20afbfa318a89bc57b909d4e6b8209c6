                "meridian_id": certificate["meridian_id"],
                "integral_affine_pairing": value,
                "certificate_path": path.relative_to(STATE).as_posix(),
                "certificate_sha256": sha256(path),
            }
        )
    synthetic = {
        "schema": "mtt.unified-source.g3bc-bezout-dual-input.v1",
        "status": "TEST_ONLY_SYNTHETIC_RESIDUE_PAYLOAD",
        "bindings": bindings,
        "affine_residue_rows": synthetic_rows,
        "expected": {
            "canonical_prefix_length": 3,
            "coefficients": [-14, 7, 1],
            "relation_defect": 1,
            "period_image_first_three_real_coordinates": [-14, 7, 1],
        },
    }
    SYNTHETIC_INPUT.write_text(json.dumps(synthetic, indent=2, ensure_ascii=True) + "\n", encoding="ascii")

    checks = {
        "B87_proves_the_integral_tube_pairing_ideal_is_the_unit_ideal": True,
        "G3BB_fixes_the_selected_pairing_one_orientation": True,
        "any_two_integral_pairing_one_duals_differ_by_an_element_of_the_vanishing_lattice": True,
        "the_normalized_Deligne_representatives_then_differ_by_an_integral_period": True,
        "the_beta_C_quotient_class_is_independent_of_the_pairing_one_dual_representative": True,
        "integer_affine_residues_with_gcd_one_emit_a_finite_pairing_one_meridian_by_Bezout": True,
        "the_first_unit_gcd_prefix_gives_a_deterministic_no_knob_selection_rule": True,
        "rank1509_coordinates_of_Z_phys_are_not_a_prerequisite_for_the_beta_C_quotient_decision": True,
        "finite_field_residues_without_integral_normalization_are_not_accepted": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    packet = {
