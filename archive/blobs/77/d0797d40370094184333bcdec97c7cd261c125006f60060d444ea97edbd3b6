def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path, *, repository: Path = ROOT) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def hilbert_dimension(degree: int) -> int:
    """Coefficient of (1-t^5)^3/(1-t)^3 for a plane-sextic Jacobian CI."""
    result = 0
    for chosen in range(4):
        shifted = degree - 5 * chosen
        if shifted < 0:
            continue
        result += (-1) ** chosen * sp.binomial(3, chosen) * sp.binomial(
            shifted + 2, 2
        )
    return int(result)


def selected_polynomials() -> tuple[
    dict[str, object],
    dict[str, object],
    dict[str, object],
    sp.Poly,
    sp.Poly,
    sp.Poly,
    sp.Poly,
]:
    base = runtime.load(runtime.BASE)
    pdelta_packet = runtime.load(runtime.PDELTA)
    g3bi = runtime.load(runtime.G3BI)
    x, y, z = sp.symbols("x y z")
    variables = (x, y, z)
    local = {"x": x, "y": y, "z": z}
    sextic = sp.Poly(
        sp.sympify(
            base["explicit_K3"]["F6_equals_G3_squared_plus_Q2_H4"],
            locals=local,
        ),
        *variables,
        domain=sp.QQ,
    )
    g3 = sp.Poly(
        sp.sympify(base["explicit_K3"]["G3"], locals=local),
        *variables,
        domain=sp.QQ,
    )
    h4 = sp.Poly(
        sp.sympify(base["explicit_K3"]["H4"], locals=local),
        *variables,
        domain=sp.QQ,
    )
    pdelta = sp.Poly(
        sp.sympify(
            pdelta_packet["residue_polynomial"]["expanded"], locals=local
        ),
        *variables,
        domain=sp.QQ,
    )
    return base, pdelta_packet, g3bi, sextic, g3, h4, pdelta


