    inverse_vandermonde = invert_matrix_mod(vandermonde, modulus)
    candidates = [
        [int(value) for value in row]
        for row in g3ei["selected_candidate_free_coefficients"]
    ]
    require(len(candidates) == 10 and all(len(row) == 60 for row in candidates), "candidate shape")
    require(independent_candidates(candidates) == list(range(10)), "candidate independence")
    vectors = interpolate_vectors(
