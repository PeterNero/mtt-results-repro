def canonical_q79_fock_output_measure() -> dict[str, Any]:
    p = reynolds_two_copy_s3()
    i6 = eye(6)
    q = sub(i6, p)

    def flatten(matrix: list[list[Fraction]]) -> list[Fraction]:
        return [value for row in matrix for value in row]

    def superoperator(transform: Any) -> list[list[Fraction]]:
        output = zeros(36, 36)
        for row in range(6):
            for column in range(6):
                basis = zeros(6, 6)
                basis[row][column] = Fraction(1)
                image = flatten(transform(basis))
                source_column = row * 6 + column
                for target_row, value in enumerate(image):
                    output[target_row][source_column] = value
        return output

    def diagonal_part(matrix: list[list[Fraction]]) -> list[list[Fraction]]:
        return add(mul(mul(p, matrix), p), mul(mul(q, matrix), q))

    def stopped_channel(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return add(
            scale(attenuation, matrix),
            scale(Fraction(1) - attenuation, diagonal_part(matrix)),
        )

    def stopped_ready(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(attenuation, matrix)

    def stopped_p(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1) - attenuation,
            mul(mul(p, matrix), p),
        )

    def stopped_q(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1) - attenuation,
            mul(mul(q, matrix), q),
        )

    def trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum(
            (matrix[index][index] for index in range(len(matrix))),
            Fraction(0),
        )

    def trace_pair(
        density: list[list[Fraction]], effect: list[list[Fraction]]
    ) -> Fraction:
        return trace(mul(density, effect))

    lens_attenuation = Fraction(1, 7)
    circle_attenuation = Fraction(1, 64)
    checkpoint_attenuation = lens_attenuation * circle_attenuation
    capture_fraction = Fraction(1) - checkpoint_attenuation

    ready_effect = scale(checkpoint_attenuation, i6)
    p_effect = scale(capture_fraction, p)
    q_effect = scale(capture_fraction, q)
    checkpoint_channel = superoperator(
        lambda matrix: stopped_channel(matrix, checkpoint_attenuation)
    )
    stopped_instrument_sum = add(
        add(
            superoperator(
                lambda matrix: stopped_ready(
                    matrix, checkpoint_attenuation
                )
            ),
            superoperator(
                lambda matrix: stopped_p(
                    matrix, checkpoint_attenuation
                )
            ),
        ),
        superoperator(
            lambda matrix: stopped_q(matrix, checkpoint_attenuation)
        ),
    )

    first_interval_capture = Fraction(1) - lens_attenuation
    second_interval_capture_after_ready = lens_attenuation * (
