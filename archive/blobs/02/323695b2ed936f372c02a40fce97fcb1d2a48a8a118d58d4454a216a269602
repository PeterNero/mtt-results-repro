#!/usr/bin/env python3
"""Independently verify the six-root G3BT H02 endpoint action."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

import numpy as np

import build_ust_g3bt_h02_endpoint_action_one_split_prime as builder
import build_ust_g3bs_h02_endpoint_action_root5 as source_builder
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3bt_h02_endpoint_action_one_split_prime.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any], default_repository: Path = ROOT) -> Path:
    relative = record.get("path", record.get("repository_relative_path"))
    require(isinstance(relative, str), "record path")
    repository = Path(record.get("repository_path", default_repository))
    candidate = Path(relative)
    path = candidate if candidate.is_absolute() else repository / candidate
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def load_verified(record: dict[str, Any], default_repository: Path = ROOT) -> dict[str, Any]:
    return json.loads(verify_record(record, default_repository).read_text(encoding="utf-8"))


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="utf-8"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3bt-h02-endpoint-action-one-split-prime.v1",
        "schema",
    )
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    inputs = packet["inputs"]
    g3bi = load_verified(inputs["G3BI"])
    g3bk = load_verified(inputs["G3BK"])
    load_verified(inputs["G3BR"])
    load_verified(inputs["G3BS"])
    b103 = load_verified(inputs["B103"], mld)
    macaulay = load_verified(inputs["H02_Macaulay"], mld)
    csc = load_verified(inputs["H02_CSC"], mld)
    factor = load_verified(inputs["H02_factorization"], mld)
    residue = load_verified(inputs["split_prime_roots"], mld)
    oracle_packet = load_verified(inputs["three_block_oracle"], mld)
    base_packet = load_verified(inputs["base"], mld)
    global_f0 = load_verified(inputs["global_F0"], mld)
    b89 = load_verified(inputs["B89"], mld)
    verify_record(inputs["split_prime_solver"], mld)
    require(all(oracle_packet["checks"].values()), "three-block oracle checks")

    roots = [int(value) for value in packet["field"]["roots_of_selected_sextic"]]
    require(
        roots == [int(value) for value in residue["field"]["roots_of_selected_sextic"]],
        "canonical split roots",
    )
    require(len(roots) == len(set(roots)) == 6, "six distinct roots")
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"]["minimal_polynomial_coefficients_ascending"]
    ]
    require(
        all(
            sum(value * pow(root, degree, builder.PRIME) for degree, value in enumerate(minpoly))
            % builder.PRIME
            == 0
            for root in roots
        ),
        "selected sextic roots",
    )
    expected_lagrange = [
        arithmetic.interpolate(
            roots, [1 if row == column else 0 for row in range(6)], builder.PRIME
        )
        for column in range(6)
    ]
    require(
        expected_lagrange == packet["field"]["lagrange_rows_root_to_power_basis"],
        "Lagrange transform",
    )

    generators0, _, _ = oracle.exact_generators(base_packet, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = [int(value) for value in csc["binary"]["quotient_unit_rows"]]
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    require(len(target_lookup) == builder.DIMENSION, "target dimension")
    require(len(quotient_rows) == builder.QUOTIENT_UNITS, "quotient dimension")
    require(len(descriptors) == builder.IMAGE_RANK, "image dimension")
    expected_source_digest = g3bk["characteristic_zero_derivative_sources"]["H11_to_H02"][
        "canonical_exact_source_sha256"
    ]
    quotient_values: list[np.ndarray] = []
    determinants: list[int] = []
    total_residuals = 0
    require(len(packet["root_solves"]) == 6, "six root records")
    for root, row in zip(roots, packet["root_solves"], strict=True):
        require(int(row["gamma_root"]) == root, "root order")
        exact_chart, construction = builder.endpoint_chart(
            builder.PRIME,
            root,
            g3bi,
            macaulay,
            factor,
            quotient_rows,
            descriptors,
            generators0,
            target_lookup,
            oracle,
            exporter,
        )
        require(construction == row["construction"], f"root {root} construction metrics")
        chart_path = verify_record(row["endpoint_chart"])
        rhs_path = verify_record(row["RHS"])
        solution_path = verify_record(row["solution"])
        log_path = verify_record(row["solver_log"])
        chart = split_io.as_scipy(arithmetic.read_csc(chart_path, b"MTTSPC1\0", 6))
        rhs = split_io.as_scipy(arithmetic.read_csc(rhs_path, b"MTTSRH1\0", 4))
        solution = split_io.as_scipy(arithmetic.read_csc(solution_path, b"MTTSCO1\0", 6))
        require((chart != exact_chart).nnz == 0, f"root {root} exact endpoint chart")
        exact_rhs, source_digest = source_builder.exact_source_matrix(
            g3bi, b103, macaulay, exporter, root, builder.PRIME
        )
        require(source_digest == expected_source_digest, f"root {root} source digest")
        require((rhs != exact_rhs).nnz == 0, f"root {root} exact RHS")
        require(solution.shape == (builder.DIMENSION, builder.SOURCE_COLUMNS), "solution shape")
        residual = split_io.residual_nonzeros(chart, solution, rhs, builder.PRIME)
        require(residual == int(row["residual_nonzeros"]) == 0, f"root {root} residual")
        total_residuals += residual
        require(solution.nnz == int(row["solution_nonzero_entries"]), "solution nnz")
        require(rhs.nnz == int(row["source_nonzero_entries"]), "source nnz")
        quotient = solution[: builder.QUOTIENT_UNITS, :].toarray().astype(
            np.uint32, copy=False
        )
        require(np.count_nonzero(quotient) == int(row["quotient_nonzero_entries"]), "quotient nnz")
        require(
            solution[builder.QUOTIENT_UNITS :, :].nnz
            == int(row["preimage_nonzero_entries"]),
            "preimage nnz",
        )
        quotient_values.append(quotient)
        fields = initializer_fields(log_path)
        require(fields.get("STATUS") == "SUCCESS", "solver status")
        determinant = int(fields["CHART_DETERMINANT"])
        require(determinant == int(row["endpoint_determinant_mod21817"]), "determinant")
        require(determinant != 0, "nonzero determinant")
        determinants.append(determinant)

    coefficients64 = np.zeros(
        (builder.QUOTIENT_UNITS, builder.SOURCE_COLUMNS, 6), dtype=np.uint64
    )
    for root_index, values in enumerate(quotient_values):
        values64 = values.astype(np.uint64, copy=False)
        for degree, coefficient in enumerate(expected_lagrange[root_index]):
            coefficients64[:, :, degree] = (
                coefficients64[:, :, degree] + values64 * coefficient
            ) % builder.PRIME
    coefficients = coefficients64.astype(np.uint32)
    stored_coefficients = np.load(
        verify_record(packet["operator_action"]["quotient_power_basis"]["binary"]),
        allow_pickle=False,
    )
    require(stored_coefficients.dtype == np.dtype("uint32"), "quotient tensor dtype")
    require(stored_coefficients.shape == coefficients.shape, "quotient tensor shape")
    require(np.array_equal(stored_coefficients, coefficients), "quotient tensor coefficients")
    mismatches = 0
    for root_index, root in enumerate(roots):
        evaluated = np.zeros((builder.QUOTIENT_UNITS, builder.SOURCE_COLUMNS), dtype=np.uint64)
        for degree in reversed(range(6)):
            evaluated = (evaluated * root + coefficients[:, :, degree]) % builder.PRIME
        mismatches += int(
            np.count_nonzero(evaluated.astype(np.uint32) != quotient_values[root_index])
        )
    require(total_residuals == int(packet["verification"]["linear_system_residual_nonzeros"]) == 0, "total residual")
    require(
        mismatches
        == int(packet["verification"]["quotient_interpolation_evaluation_mismatches"])
        == 0,
        "interpolation replay",
    )
    require(
        int(np.count_nonzero(coefficients))
        == int(packet["operator_action"]["quotient_power_basis"]["nonzero_coefficients"]),
        "quotient coefficient nnz",
    )
    require(
        builder.representation_digest(roots, expected_lagrange, packet["root_solves"])
        == packet["operator_action"]["full_action_representation_sha256"],
        "full action representation digest",
    )
    print("UST.G3BT H02 endpoint action one split prime verifier: PASS")
    print(
        f"roots=6 determinants={determinants} residuals={total_residuals} "
        f"quotient_mismatches={mismatches} quotient_coeff_nnz={np.count_nonzero(coefficients)}"
    )


def initializer_fields(path: Path) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition(" ")
        if separator:
            fields[key] = value.strip()
    return fields


if __name__ == "__main__":
    main()
