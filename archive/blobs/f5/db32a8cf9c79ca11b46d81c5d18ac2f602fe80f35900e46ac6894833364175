    dependent_open_rows = [
        "vanishing_Gauss_BRST_Ward_defect"
    ]
    expected_independent_open_rows = [
        "geometry_selected_q79_external_regulator_family",
        "full_nonabelian_chiral_measure_at_fixed_cutoff",
        "cofinal_embedding_or_asymptotic_morphism_package",
        "uniform_Lieb_Robinson_or_asymptotic_microcausality_bound",
        "uniform_phase_space_energy_or_nuclearity_bound",
