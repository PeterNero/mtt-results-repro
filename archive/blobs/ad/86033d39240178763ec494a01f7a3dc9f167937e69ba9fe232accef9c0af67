#!/usr/bin/env python3
"""Add exact first-root samples for second-jet number-field reconstruction."""

from __future__ import annotations

import hashlib
import json
import subprocess
from pathlib import Path

import numpy as np

import build_ust_g3dg_h02_split_place_full_coupling_rank as rank_runtime
import build_ust_g3di_h02_split_algebra_kernel_relations as kernel_io
import build_ust_g3fe_component20_eight_prime_graded_promotion_audit as interpolation
import build_ust_g3fn_component20_hilbert_burch_source as hilbert_burch
import build_ust_g3ft_component20_full_relation_height_campaign as height_campaign
import build_ust_g3fz_component20_second_jet_o8_source as second_jet
import build_ust_g3ga_component20_second_jet_qgamma_promotion as campaign
import probe_ust_g3ga_extra_split_prime_full_rank as border_runtime
import probe_ust_g3fy_selected_degree21_source_span as source_runtime
import probe_ust_g3bl_endpoint_chart_unit as codex_runtime


ROOT = Path(__file__).resolve().parent
EVIDENCE = ROOT / "evidence/ust_g3gb"
SCRATCH = ROOT / "state/ust_g3gb_scratch"
ARRAYS = EVIDENCE / "H02.component20.extra_root_second_jet_height.npz"
CERTIFICATE = EVIDENCE / "H02.component20.extra_root_second_jet_height.json"
PRIMES = tuple(list(height_campaign.FIBERS)[10:])


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def root_paths(prime: int, gamma: int) -> tuple[Path, Path]:
    return (
        EVIDENCE / f"H02.component20.p{prime}.g{gamma}.second_jet_source.npz",
        EVIDENCE / f"H02.component20.p{prime}.g{gamma}.second_jet_source.json",
    )


def compute_root(
    prime: int,
    gamma: int,
    context: dict[str, object],
    coefficient_vectors: list[list[int]],
    d7_coordinates: np.ndarray,
    b6_coordinates: np.ndarray,
) -> tuple[np.ndarray, dict[str, object]]:
    cache, metadata_path = root_paths(prime, gamma)
    if cache.is_file() and metadata_path.is_file():
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        if metadata.get("arithmetic_schema") == campaign.ARITHMETIC_SCHEMA:
            require(metadata["artifact"]["sha256"] == sha256(cache), "cache hash")
            return np.load(cache, allow_pickle=False)["source_coefficient"], metadata

    border = border_runtime.border_matrix(prime, gamma, context)
    chart = SCRATCH / f"p{prime}.g{gamma}.border.bin"
    kernel = SCRATCH / f"p{prime}.g{gamma}.kernel.bin"
    log = SCRATCH / f"p{prime}.g{gamma}.kernel.log"
    context["exporter"].write_chart(
        chart,
        prime,
        border.shape[0],
        0,
        border.shape[0],
        border.indptr.astype(np.uint64).tolist(),
        border.indices.astype(np.uint32).tolist(),
        border.data.astype(np.uint32).tolist(),
    )
    completed = subprocess.run(
        [
            "wsl",
            codex_runtime.wsl_path(context["executable"]),
            "--chart",
            codex_runtime.wsl_path(chart),
            "--kernel",
            codex_runtime.wsl_path(kernel),
            "--log",
            codex_runtime.wsl_path(log),
            "--update-start",
            str(campaign.UPDATE_START),
            "--progress-seconds",
            "20",
        ],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    fields = rank_runtime.initializer.parse_log(log)
    coupling_rank = int(fields["RANK"]) - campaign.UPDATE_START
    kernel_dimension = int(fields["VERIFIED_RELATIONS"])
    require(
        coupling_rank + kernel_dimension == campaign.UPDATE_DIMENSION,
        "rank-nullity",
    )
    payload = kernel_io.read_kernel(kernel)
    generators, syzygy_block, _ = interpolation.extract_fiber(kernel, prime)
    o8, _, _, _ = hilbert_burch.canonical_degree8_syzygy(
        generators[11], syzygy_block[:12], syzygy_block[12:], prime
    )
    forms9 = tuple(
        source_runtime.evaluate_selected_form(
            coefficient_vectors, theta, gamma, prime
        )
        for theta in range(3)
    )
    _, source_coefficient, profile, source_profile = second_jet.fiber_source(
        generators[11],
        syzygy_block,
        second_jet.evaluate_coordinates(d7_coordinates, gamma, prime),
        second_jet.evaluate_coordinates(b6_coordinates, gamma, prime),
        forms9,
        o8,
        prime,
    )
    np.savez_compressed(
        cache,
        prime=np.asarray([prime], dtype=np.uint32),
        gamma=np.asarray([gamma], dtype=np.uint32),
        source_coefficient=source_coefficient.astype(np.uint32),
    )
    metadata = {
        "arithmetic_schema": campaign.ARITHMETIC_SCHEMA,
        "prime": prime,
        "gamma_root": gamma,
        "coupling_rank": coupling_rank,
        "kernel_dimension": kernel_dimension,
        "component20_second_jet_profile": list(profile),
        "source_normalization_profile_sha256": hashlib.sha256(
            np.asarray(source_profile, dtype="<i2").tobytes()
        ).hexdigest(),
        "kernel_nonzero_entries": int(payload["matrix"].nnz),
        "kernel_elapsed_seconds": float(fields["ELAPSED_SECONDS"]),
        "ephemeral_kernel_sha256": sha256(kernel),
        "artifact": record(cache),
    }
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
    for path in (chart, kernel, log):
        path.unlink(missing_ok=True)
    return source_coefficient.astype(np.uint32), metadata


def main() -> None:
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    SCRATCH.mkdir(parents=True, exist_ok=True)
    g3bi = second_jet.load(second_jet.G3BI)
    g3fx = np.load(second_jet.G3FX, allow_pickle=False)
    context = campaign.full_kernel_context(g3bi)
    values: list[np.ndarray] = []
    rows: list[dict[str, object]] = []
    for index, prime in enumerate(PRIMES, start=1):
        gamma = height_campaign.FIBERS[prime][0]
        value, row = compute_root(
            prime,
            gamma,
            context,
            g3bi["selected_source"]["coefficient_vectors"],
            g3fx["D7_gamma_coordinates"],
            g3fx["B6_gamma_coordinates"],
        )
        values.append(value)
        rows.append(row)
        print(
            f"G3GB root {index}/{len(PRIMES)} p={prime} gamma={gamma}: "
            f"rank={row['coupling_rank']} kernel={row['kernel_dimension']} second_jet=1",
            flush=True,
        )
    values_array = np.stack(values)
    require(values_array.shape == (len(PRIMES), 132), "sample shape")
    np.savez_compressed(
        ARRAYS,
        primes=np.asarray(PRIMES, dtype=np.uint32),
        gamma_roots=np.asarray(
            [height_campaign.FIBERS[prime][0] for prime in PRIMES],
            dtype=np.uint32,
        ),
        second_jet_source_coefficients=values_array,
    )
    packet = {
        "schema": "ust.g3gb.h02.component20.extra-root-second-jet-height.v1",
        "date": "2026-08-15",
        "theorem_id": "UST.G3GB",
        "status": "CLOSED_EXACT_EXTRA_ROOT_SECOND_JET_HEIGHT_SAMPLES",
        "campaign": {
            "arithmetic_schema": campaign.ARITHMETIC_SCHEMA,
            "primes": list(PRIMES),
            "samples": len(PRIMES),
            "root_rows": rows,
            "artifact": record(ARRAYS),
        },
        "checks": {
            "all_extra_first_roots_have_exact_full_kernels": True,
            "all_extra_first_roots_have_the_corrected4748_1274_global_profile": all(
                row["coupling_rank"] == campaign.EXPECTED_COUPLING_RANK
                and row["kernel_dimension"] == campaign.EXPECTED_KERNEL_DIMENSION
                for row in rows
            ),
            "all_extra_first_roots_preserve_the_component20_second_jet_profile": all(
                row["component20_second_jet_profile"] == [15, 5, 0, 33, 17, 1]
                for row in rows
            ),
        },
        "guardrails": {
            "claims_the_original4748_1274_global_profile_is_characteristic_zero": False,
            "claims_the_extra_root_samples_alone_promote_Qgamma_coefficients": False,
            "claims_global_H02_rank_equality": False,
            "claims_a_physical_endpoint": False,
        },
        "next_required_object": (
            "Use these mixed-prime root evaluations in a seven-coordinate "
            "algebraic-number lattice reconstruction and reserve an unused root "
            "as an independent validation sample."
        ),
    }
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    CERTIFICATE.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print(
        "UST.G3GB extra-root second-jet height campaign: PASS "
        f"samples={len(PRIMES)} global=4748/1274 component20=stable"
    )


if __name__ == "__main__":
    main()
