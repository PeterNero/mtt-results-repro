'''


def parse_leaders(output: str) -> tuple[list[tuple[int, ...]], list[tuple[int, tuple[int, ...]]]]:
    base_count = re.search(r"^G3AP_F2_QRING_BASE_GB_SIZE=(\d+)$", output, re.MULTILINE)
    module_count = re.search(r"^G3AP_F2_QRING_MODULE_GB_SIZE=(\d+)$", output, re.MULTILINE)
    require(base_count is not None and module_count is not None, "qring basis counts")
    base = {
        int(match.group(1)): tuple(int(value) for value in match.group(2).split(","))
        for match in re.finditer(r"^G3AP_F2_QRING_BASE_LEADER_(\d+)_EXP=([0-9,]+)$", output, re.MULTILINE)
    }
    components = {
        int(match.group(1)): int(match.group(2))
        for match in re.finditer(r"^G3AP_F2_QRING_MODULE_LEADER_(\d+)_COMP=(\d+)$", output, re.MULTILINE)
    }
    exponents = {
        int(match.group(1)): tuple(int(value) for value in match.group(2).split(","))
        for match in re.finditer(r"^G3AP_F2_QRING_MODULE_LEADER_(\d+)_EXP=([0-9,]+)$", output, re.MULTILINE)
    }
    base_size = int(base_count.group(1))
    module_size = int(module_count.group(1))
    require(set(base) == set(range(1, base_size + 1)), "all base leaders")
    require(set(components) == set(exponents) == set(range(1, module_size + 1)), "all quotient-module leaders")
    base_leaders = [base[index] for index in range(1, base_size + 1)]
    module_leaders = [(components[index], exponents[index]) for index in range(1, module_size + 1)]
    require(all(len(value) == 7 for value in base_leaders), "base leader widths")
    require(all(1 <= component <= 6 and len(value) == 7 for component, value in module_leaders), "module leader types")
    return base_leaders, module_leaders


def combined_leaders(
    base: list[tuple[int, ...]], module: list[tuple[int, tuple[int, ...]]]
) -> list[tuple[int, tuple[int, ...]]]:
    return module + [(component, exponent) for component in range(1, 7) for exponent in base]


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    source = SOURCE.read_text(encoding="ascii")
    SCRIPT.write_text(qring_script(source), encoding="ascii")
    if args.emit_only:
        print(f"emitted {SCRIPT.relative_to(ROOT)}")
        return
    BASE_CACHE.unlink(missing_ok=True)
    MODULE_CACHE.unlink(missing_ok=True)
    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, "fiber-two qring execution")
    require("G3AP_F2_QRING_LEADER_EXPORT_PASS" in completed.stdout, "qring pass")
    require(BASE_CACHE.is_file() and BASE_CACHE.stat().st_size > 0, "base cache")
    require(MODULE_CACHE.is_file() and MODULE_CACHE.stat().st_size > 0, "module cache")
    base, module = parse_leaders(completed.stdout)
    standards, sectors = fiber2.enumerate_target(combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "unique qring top standard")
    checks = {
        "selected_F101e6_source_is_hash_bound": True,
        "base_quotient_is_exactly_B_mod_K_E_C": True,
        "the_21_module_generators_are_the_remaining_fiber_degree_two_derivative_relations": True,
