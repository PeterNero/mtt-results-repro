#!/usr/bin/env python3
"""Export the exact low-degree smooth-primal Lagrange locus for G3AO uvs."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess

import sympy as sp

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as common
import run_ust_g3ao_selected_cayley_toric_regularity as direct
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
CAMPAIGN = direct.CAMPAIGN / "uvs_primal_lagrange_msolve"
EXPORT_SCRIPT = CAMPAIGN / "export_smooth_primal_lagrange.sing"
RAW_OUTPUT = CAMPAIGN / "export_smooth_primal_lagrange.singular.out"
INPUT = CAMPAIGN / "smooth.msolve.in"
OUT = CAMPAIGN / "inputs.packet.json"
BIDUAL_IDENTITY = ROOT / "state" / "ust_g3ao_elliptic_bidual_identity.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def make_export_script(polynomials: dict[str, str]) -> str:
    return f'''// UST.G3AO exact smooth-primal Lagrange export for full uvs.
ring source=(101,g),(x,y,z,w),dp;
minpoly={polynomials["minpoly"]};
poly F6={polynomials["F6"]};
poly A0={polynomials["A0"]};
poly A1={polynomials["A1"]};
poly A2={polynomials["A2"]};
poly P0=A0;
poly P1=A0+A1+3*A2;
poly P2=A0+7*A1+7*A2;
ring orbit=(101,g),(y,z,w,Y,Z,lagrange,orbitInv),dp;
minpoly={polynomials["minpoly"]};
map orbitMap=source,1,y,z,w;
poly F6=orbitMap(F6);
poly K=w^2-F6;
poly Ap0=orbitMap(P0);
poly Ap1=orbitMap(P1);
poly Ap2=orbitMap(P2);
poly dual0=-14*Ap0;
poly dual1=-4*Ap0+7*Ap1-3*Ap2;
poly dual2=6*Ap0-7*Ap1+Ap2;
poly Fermat=1+Y^3+Z^3;
poly covector1=dual1-dual0*Y^2;
poly covector2=dual2-dual0*Z^2;
poly T0=-14-4*Y+6*Z;
poly T1=7*Y-7*Z;
poly T2=-3*Y+Z;
poly responseY=T0*diff(Ap0,y)+T1*diff(Ap1,y)+T2*diff(Ap2,y);
poly responseZ=T0*diff(Ap0,z)+T1*diff(Ap1,z)+T2*diff(Ap2,z);
poly responseW=T0*diff(Ap0,w)+T1*diff(Ap1,w)+T2*diff(Ap2,w);
poly lagrangeY=responseY-lagrange*diff(K,y);
poly lagrangeZ=responseZ-lagrange*diff(K,z);
poly lagrangeW=responseW-lagrange*diff(K,w);
ideal smoothPrimalLagrange=K,Fermat,covector1,covector2,
  lagrangeY,lagrangeZ,lagrangeW,orbitInv*(y*z*w*Y*Z*dual0)-1;
int exportIndex;
print("G3AO_MSOLVE_SMOOTH_COUNT="+string(size(smoothPrimalLagrange)));
for (exportIndex=1;exportIndex<=size(smoothPrimalLagrange);exportIndex++)
{{ print("G3AO_MSOLVE_SMOOTH_"+string(exportIndex)+"="+string(smoothPrimalLagrange[exportIndex])); }}
print("G3AO_MSOLVE_EXPORT_PASS");
quit;
'''


def make_msolve_input(polynomials: dict[str, str], generators: list[str]) -> str:
    equations = [common.normalize_for_msolve(polynomials["minpoly"])]
    equations.extend(common.normalize_for_msolve(value) for value in generators)
    return "y,z,w,Y,Z,lagrange,orbitInv,g\n101\n" + ",\n".join(equations) + "\n"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=1800)
    parser.add_argument("--reuse-export", action="store_true")
    args = parser.parse_args()
    require(args.timeout > 0, "positive timeout")
    CAMPAIGN.mkdir(parents=True, exist_ok=True)
    polynomials = direct.selected_polynomials()
    require(BIDUAL_IDENTITY.is_file(), "elliptic-bidual identity packet")
    bidual_identity = json.loads(BIDUAL_IDENTITY.read_text(encoding="ascii"))
    require(all(bidual_identity["checks"].values()), "elliptic-bidual identity checks")
    g = sp.symbols("g")
    minpoly = sp.Poly(sp.sympify(polynomials["minpoly"].replace("^", "**")), g, modulus=101)
    require(minpoly.degree() == 6 and minpoly.is_irreducible, "irreducible F101 extension")
    EXPORT_SCRIPT.write_text(make_export_script(polynomials), encoding="ascii")
    if args.reuse_export:
        require(RAW_OUTPUT.is_file(), "reusable raw export")
        raw = RAW_OUTPUT.read_text(encoding="utf-8")
    else:
        completed = subprocess.run(
            singular_command(ROOT, EXPORT_SCRIPT),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        RAW_OUTPUT.write_text(completed.stdout, encoding="utf-8")
        require(completed.returncode == 0, "Singular primal-Lagrange export")
        raw = completed.stdout
    require("G3AO_MSOLVE_EXPORT_PASS" in raw, "export marker")
    generators = common.parse_locus(raw, "smooth")
    INPUT.write_text(make_msolve_input(polynomials, generators), encoding="ascii")
    packet = {
        "schema": "mtt.unified-source.g3ao-uvs-smooth-primal-lagrange-msolve-input.v1",
        "source_sha256": sha256(direct.SOURCE),
        "dependencies": {
            "elliptic_bidual_identity": {
                "path": str(BIDUAL_IDENTITY.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BIDUAL_IDENTITY),
                "theorem_id": bidual_identity["theorem_id"],
            }
        },
        "field_presentation": {
            "characteristic": 101,
            "extension_variable": "g",
            "minpoly": polynomials["minpoly"],
            "degree": 6,
            "irreducible_over_F101": True,
            "all_roots_are_Frobenius_conjugate": True,
        },
        "export_script": {
            "path": str(EXPORT_SCRIPT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(EXPORT_SCRIPT),
        },
        "raw_output": {
            "path": str(RAW_OUTPUT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(RAW_OUTPUT),
        },
        "input": {
            "path": str(INPUT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(INPUT),
        },
        "generator_count_including_minpoly": len(generators) + 1,
        "checks": {
            "smooth_Fermat_contacts_have_all_X_Y_Z_nonzero": True,
            "the_X_one_chart_covers_the_entire_smooth_dual_contact_locus": True,
            "the_covector_is_proportional_to_the_Fermat_gradient_1_Y2_Z2": True,
            "the_contact_t_is_adjL_times_1_Y_Z": True,
            "dK_dw_equals_2w_and_is_nonzero_on_the_selected_torus": True,
            "the_Lagrange_equations_are_equivalent_to_the_three_base_minors": True,
            "the_full_selected_base_torus_and_smooth_contact_are_saturated": True,
            "the_extension_minpoly_is_irreducible_and_adjoined_over_F101": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(f"UST.G3AO uvs smooth-primal Lagrange input: PASS generators={len(generators)+1}")


if __name__ == "__main__":
    main()
