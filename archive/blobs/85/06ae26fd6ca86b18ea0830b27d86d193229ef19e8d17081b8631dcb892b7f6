        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    path, repository = path.resolve(), repository.resolve()
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def coefficient_add(left: tuple[int, ...], right: tuple[int, ...]) -> tuple[int, ...]:
    return tuple(a + b for a, b in zip(left, right, strict=True))


def coefficient_scale(value: tuple[int, ...], scalar: int) -> tuple[int, ...]:
    return tuple(scalar * item for item in value)


def coefficient_multiply(left: tuple[int, ...], right: tuple[int, ...]) -> tuple[int, ...]:
    work = [0] * 11
    for left_degree, left_value in enumerate(left):
        if not left_value:
            continue
        for right_degree, right_value in enumerate(right):
            if right_value:
                work[left_degree + right_degree] += left_value * right_value
    for degree in reversed(range(6, 11)):
        value = work[degree]
        if not value:
            continue
        work[degree] = 0
        for lower, coefficient in enumerate(MINIMAL[:-1]):
            work[degree - 6 + lower] -= value * coefficient
    return tuple(work[:6])


def add_entry(
    entries: dict[tuple[int, int], tuple[int, ...]],
    key: tuple[int, int],
    value: tuple[int, ...],
) -> None:
    updated = coefficient_add(entries.get(key, ZERO), value)
    if any(updated):
        entries[key] = updated
    else:
        entries.pop(key, None)


def add_polynomial_term(
    polynomial: dict[tuple[int, int, int], tuple[int, ...]],
    exponent: tuple[int, int, int],
    value: tuple[int, ...],
) -> None:
    updated = coefficient_add(polynomial.get(exponent, ZERO), value)
    if any(updated):
        polynomial[exponent] = updated
    else:
        polynomial.pop(exponent, None)


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (x, y, degree - x - y)
        for x in range(degree + 1)
        for y in range(degree - x + 1)
    ]


def shift_polynomial(
    polynomial: dict[tuple[int, int, int], tuple[int, ...]],
    shift: tuple[int, int, int],
) -> dict[tuple[int, int, int], tuple[int, ...]]:
    return {
        tuple(exponent[index] + shift[index] for index in range(3)): value
        for exponent, value in polynomial.items()
    }


def multiply_polynomials(
    left: dict[tuple[int, int, int], tuple[int, ...]],
    right: dict[tuple[int, int, int], tuple[int, ...]],
) -> dict[tuple[int, int, int], tuple[int, ...]]:
    result: dict[tuple[int, int, int], tuple[int, ...]] = {}
    for left_exponent, left_value in left.items():
        for right_exponent, right_value in right.items():
            exponent = tuple(
                left_exponent[index] + right_exponent[index] for index in range(3)
            )
            add_polynomial_term(
                result, exponent, coefficient_multiply(left_value, right_value)
            )
    return result


def polynomial_scale(
    polynomial: dict[tuple[int, int, int], tuple[int, ...]], scalar: int
) -> dict[tuple[int, int, int], tuple[int, ...]]:
    return {
        exponent: coefficient_scale(value, scalar)
        for exponent, value in polynomial.items()
        if any(coefficient_scale(value, scalar))
    }


def coefficient_matrices(
    entries: dict[tuple[int, int], tuple[int, ...]], shape: tuple[int, int]
) -> list[sparse.csc_matrix]:
    matrices = []
    for degree in range(6):
        triples = [
            (row, column, value[degree])
            for (row, column), value in entries.items()
            if value[degree]
        ]
        if triples:
            rows, columns, values = zip(*triples, strict=True)
            matrix = sparse.csc_matrix(
                (np.asarray(values, dtype=np.int64), (rows, columns)), shape=shape
            )
        else:
            matrix = sparse.csc_matrix(shape, dtype=np.int64)
        matrices.append(matrix)
    return matrices


def write_number_field_matrix(
    path: Path,
    entries: dict[tuple[int, int], tuple[int, ...]],
