def marker(output: str, label: str) -> int:
    match = re.search(rf"^{re.escape(label)}=(-?\d+)$", output, flags=re.MULTILINE)
    require(match is not None, f"missing marker {label}")
    return int(match.group(1))


def parse_field_number(text: str) -> int:
    text = text.strip().strip("()")
    if "/" in text:
        numerator_text, denominator_text = text.split("/", 1)
        numerator = int(numerator_text) % PRIME
        denominator = int(denominator_text) % PRIME
        require(denominator != 0, "nonzero finite-field denominator")
        return numerator * pow(denominator, -1, PRIME) % PRIME
    return int(text) % PRIME


def parse_polynomial(text: str) -> dict[tuple[int, ...], int]:
    compact = text.replace(" ", "")
    if compact == "0":
        return {}
    require("gamma" not in compact, "split-fiber polynomial has scalar coefficients")
    variable_index = {name: index for index, name in enumerate(VARIABLES)}
    terms: dict[tuple[int, ...], int] = {}
    for signed_term in re.findall(r"[+-]?[^+-]+", compact):
        sign = 1
        if signed_term.startswith("-"):
            sign = -1
            signed_term = signed_term[1:]
        elif signed_term.startswith("+"):
            signed_term = signed_term[1:]
        require(bool(signed_term), "nonempty polynomial term")
        coefficient = sign
        exponent = [0] * len(VARIABLES)
        for factor in signed_term.split("*"):
            variable_match = re.fullmatch(
                r"(t0|t1|t2|x|y|z|w|u|v|s)(?:\^(\d+))?", factor
            )
            if variable_match:
                exponent[variable_index[variable_match.group(1)]] += int(
                    variable_match.group(2) or 1
                )
            else:
                coefficient *= parse_field_number(factor)
        key = tuple(exponent)
        terms[key] = (terms.get(key, 0) + coefficient) % PRIME
    return {key: value for key, value in terms.items() if value}


def run_singular(script: Path, raw: Path, timeout: float, residue: Any) -> tuple[str, str, float]:
    output, engine, timed_out, elapsed = residue.run_singular(script, timeout)
    raw.write_text(output, encoding="utf-8")
    require(not timed_out, f"Singular timeout after {elapsed:.1f}s in {script.name}")
    return output, engine, elapsed


def validated_basis_reusable(script_hash: str) -> bool:
    if not BASIS_RESULT.is_file() or not BASIS_CACHE.is_file():
        return False
    result = load(BASIS_RESULT)
    return bool(
        result.get("passed")
        and result.get("schema")
        == "mtt.unified-source.g3gk-endpoint-graded-basis-result.v2"
        and result.get("script_sha256") == script_hash
        and result.get("cache_sha256") == sha256(BASIS_CACHE)
        and result.get("affine_dimension") == 4
        and result.get("quotient_dimension") == -1
    )


def completed_partial_basis_recoverable(script_hash: str) -> tuple[bool, str]:
    if not BASIS_PARTIAL.is_file() or not BASIS_RAW.is_file() or not BASIS_SCRIPT.is_file():
        return False, ""
    if sha256(BASIS_SCRIPT) != script_hash:
        return False, ""
    output = BASIS_RAW.read_text(encoding="utf-8")
    try:
        valid = bool(
            "G3GK_ENDPOINT_BASIS_PASS" in output
            and marker(output, "G3GK_BASIS_PRIME") == PRIME
            and marker(output, "G3GK_BASIS_GAMMA") == ROOT_VALUE
            and marker(output, "G3GK_BASIS_J_GENERATORS") == 10
            and marker(output, "G3GK_BASIS_GB_SIZE") > 0
            and marker(output, "G3GK_BASIS_AFFINE_DIMENSION") == 4
            and marker(output, "G3GK_BASIS_QUOTIENT_DIMENSION") == -1
            and marker(output, "G3GK_BASIS_ORIGINAL_RESIDUAL_ZERO") == 1
        )
    except AssertionError:
        return False, ""
    return valid, output


def accept_basis_checkpoint(
    output: str,
    script_hash: str,
    engine: str,
    elapsed: float | None,
    provenance: dict[str, Any],
) -> dict[str, Any]:
    require("G3GK_ENDPOINT_BASIS_PASS" in output, output[-4000:])
    require(marker(output, "G3GK_BASIS_PRIME") == PRIME, "basis prime")
    require(marker(output, "G3GK_BASIS_GAMMA") == ROOT_VALUE, "basis root")
    require(marker(output, "G3GK_BASIS_J_GENERATORS") == 10, "ten Jacobian generators")
    require(
        marker(output, "G3GK_BASIS_AFFINE_DIMENSION") == 4,
        "expected four-dimensional multiplier-zero Cayley component",
    )
    require(
        marker(output, "G3GK_BASIS_QUOTIENT_DIMENSION") == -1,
        "positive-dimensional Jacobian quotient",
    )
    require(marker(output, "G3GK_BASIS_ORIGINAL_RESIDUAL_ZERO") == 1, "basis contains J")
    require(BASIS_PARTIAL.is_file(), "basis partial emitted")
    os.replace(BASIS_PARTIAL, BASIS_CACHE)
    result = {
        "schema": "mtt.unified-source.g3gk-endpoint-graded-basis-result.v2",
        "passed": True,
        "script_sha256": script_hash,
        "raw_sha256": sha256(BASIS_RAW),
        "cache_sha256": sha256(BASIS_CACHE),
        "cache_bytes": BASIS_CACHE.stat().st_size,
        "Groebner_basis_size": marker(output, "G3GK_BASIS_GB_SIZE"),
        "affine_dimension": marker(output, "G3GK_BASIS_AFFINE_DIMENSION"),
        "quotient_dimension": marker(output, "G3GK_BASIS_QUOTIENT_DIMENSION"),
        "graded_reduction_contract": (
            "The multiplier-zero component has affine dimension four. Exact "
            "membership and normal forms are used only in fixed positive weighted degrees."
        ),
        "engine": engine,
        "elapsed_seconds": elapsed,
        "provenance": provenance,
    }
    atomic_json(BASIS_RESULT, result)
    update_progress("basis_complete", basis=result)
    return result


def build_basis(
    script_text: str,
    timeout: float,
    residue: Any,
    force: bool,
    provenance: dict[str, Any],
) -> dict[str, Any]:
    BASIS_SCRIPT.write_text(script_text, encoding="ascii")
    script_hash = sha256(BASIS_SCRIPT)
    if not force and validated_basis_reusable(script_hash):
        result = load(BASIS_RESULT)
        print(f"G3GK reused endpoint basis sha256={result['cache_sha256']}", flush=True)
        return result
    recoverable, recovered_output = completed_partial_basis_recoverable(script_hash)
    if not force and recoverable:
        result = accept_basis_checkpoint(
            recovered_output,
            script_hash,
            "Singular recovered from complete marker log",
            None,
            provenance,
        )
        print(
            f"G3GK recovered completed endpoint basis sha256={result['cache_sha256']}",
            flush=True,
        )
        return result
    BASIS_PARTIAL.unlink(missing_ok=True)
    update_progress("basis_running", script_sha256=script_hash, provenance=provenance)
    output, engine, elapsed = run_singular(BASIS_SCRIPT, BASIS_RAW, timeout, residue)
    return accept_basis_checkpoint(
        output, script_hash, engine, elapsed, provenance
    )


def ambient_matrix_from_output(
    output: str, target_lookup: dict[tuple[int, ...], int]
) -> sparse.csc_matrix:
    entries: dict[tuple[int, int], int] = {}
    for column in range(SOURCE_DIMENSION):
        match = re.search(rf"^G3GK_AMBIENT_{column}=(.*)$", output, flags=re.MULTILINE)
        require(match is not None, f"ambient row {column}")
        polynomial = parse_polynomial(match.group(1).strip())
        for exponent, coefficient in polynomial.items():
            row = target_lookup.get(exponent)
            require(row is not None, f"ambient exponent lies in H02 target: {exponent}")
            entries[(row, column)] = coefficient
    keys = sorted(entries)
    result = sparse.csc_matrix(
        (
            np.asarray([entries[key] for key in keys], dtype=np.uint32),
            (
                np.asarray([key[0] for key in keys], dtype=np.int32),
                np.asarray([key[1] for key in keys], dtype=np.int32),
            ),
        ),
        shape=(AMBIENT_DIMENSION, SOURCE_DIMENSION),
        dtype=np.uint32,
    )
    result.sum_duplicates()
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def chart_project(
    ambient: sparse.csc_matrix,
    mld: Path,
    g3bt: dict[str, Any],
) -> tuple[np.ndarray, int, int]:
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import export_q79_eta9_split_prime_selected_chart as exporter

    root_record = next(
        row for row in g3bt["root_solves"] if int(row["gamma_root"]) == ROOT_VALUE
    )
    chart_path = ROOT / root_record["endpoint_chart"]["path"]
    require(chart_path.is_file(), "root-five endpoint chart")
    require(sha256(chart_path) == root_record["endpoint_chart"]["sha256"], "endpoint chart hash")
    exporter.write_rhs(
        AMBIENT_RHS,
        PRIME,
        AMBIENT_DIMENSION,
        ambient.indptr.astype(np.uint64).tolist(),
        ambient.indices.astype(np.uint32).tolist(),
        ambient.data.astype(np.uint32).tolist(),
    )
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(chart_path),
        "--rhs",
        runtime.wsl_path(AMBIENT_RHS),
        "--output",
        runtime.wsl_path(CHART_SOLUTION),
        "--log",
        runtime.wsl_path(CHART_LOG),
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    chart = split_io.as_scipy(arithmetic.read_csc(chart_path, b"MTTSPC1\0", 6))
    stored_rhs = split_io.as_scipy(arithmetic.read_csc(AMBIENT_RHS, b"MTTSRH1\0", 4))
    solution = split_io.as_scipy(
        arithmetic.read_csc(CHART_SOLUTION, b"MTTSCO1\0", 6)
    )
    residual = split_io.residual_nonzeros(chart, solution, stored_rhs, PRIME)
    require(residual == 0, "endpoint chart projection residual")
    fields = initializer.parse_log(CHART_LOG)
    determinant = int(fields["CHART_DETERMINANT"])
    require(determinant == int(root_record["endpoint_determinant_mod21817"]), "chart determinant")
    quotient = solution[:QUOTIENT_DIMENSION, :].toarray().astype(np.int64) % PRIME
    return quotient, residual, determinant


