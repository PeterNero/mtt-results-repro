        "the_product_chain_is_integral_primitive_finite_and_closed": True,
        "the_source_pairing_factorizes_as_delta_gamma_times_uA_uB_equal_one": True,
        "Poincare_Leray_naturality_transfers_pairing_one_to_unit_affine_defect": True,
