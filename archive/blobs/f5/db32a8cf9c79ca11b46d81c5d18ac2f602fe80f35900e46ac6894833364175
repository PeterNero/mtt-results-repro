    low_block = [
        row[:2] for row in coupled_hessian[:2]
    ]
    coupling_block = [
        row[2:] for row in coupled_hessian[:2]
    ]
    high_block = [
        row[2:] for row in coupled_hessian[2:]
    ]
    high_inverse = diagonal(
        [Fraction(1, 3), Fraction(1, 4)]
    )
    self_energy = mul(
        mul(coupling_block, high_inverse),
        transpose(coupling_block),
    )
    feshbach_at_zero = sub(low_block, self_energy)

    block_left = eye(4)
    block_right = eye(4)
    block_diagonal = zeros(4, 4)
    upper_transport = mul(coupling_block, high_inverse)
    lower_transport = mul(
        high_inverse,
        transpose(coupling_block),
    )
    for row in range(2):
        for column in range(2):
            block_left[row][column + 2] = (
                upper_transport[row][column]
            )
            block_right[row + 2][column] = (
                lower_transport[row][column]
            )
            block_diagonal[row][column] = (
