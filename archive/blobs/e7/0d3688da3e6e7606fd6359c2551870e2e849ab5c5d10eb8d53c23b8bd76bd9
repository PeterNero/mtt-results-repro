#!/usr/bin/env python3
"""Emit the polarized primal-only B89 rank-one transport reduction."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
LOCK = STATE / "upstream-lock.json"
G3AS = STATE / "ust_g3as_selected_finite_normal_operator.packet.json"
G3AR_DOC = ROOT / "UST_G3AR_SAME_MEMBER_BETA_C_SOURCE_AND_NORMAL_DECISION_CONTRACT_v1.md"
OUT = STATE / "ust_g3at_polarized_primal_transport.packet.json"
RANK = 1509
PATHS = 3


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": str(path.relative_to(ROOT)).replace("\\", "/"),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def locked_source(lock: dict, repository_id: str, source_path: str) -> dict:
    repository = next(item for item in lock["repositories"] if item["id"] == repository_id)
    source = next(item for item in repository["sources"] if item["path"] == source_path)
    require(len(repository["commit"]) == 40, "locked source commit")
    require(len(source["sha256"]) == 64, "locked source hash")
    return {
        "repository_id": repository_id,
        "remote": repository["remote"],
        "branch": repository["branch"],
        "commit": repository["commit"],
        **source,
    }


def main() -> None:
    lock = load(LOCK)
    g3as = load(G3AS)
    require(
        g3as["status"] == "CLOSED_EXACT_SELECTED_FINITE_RESIDUE_NORMAL_OPERATOR_RANK126",
        "G3AS input",
    )
    residue_source = locked_source(
        lock,
        "eta9-source-execution",
        "Q79_ETA9_B89_RESIDUE_MERIDIAN_EXTRACTION_v1.md",
    )

    old_odes = 2 * PATHS
    new_odes = PATHS
    old_scalars = old_odes * RANK
    new_scalars = new_odes * RANK
    dense_scalars = PATHS * RANK * RANK
    checks = {
        "locked_B89_residue_theorem_supplies_a_common_polarized_rank1509_frame": True,
        "the_selected_A1_monodromies_are_minus_two_Picard_Lefschetz_reflections": True,
        "metric_compatibility_determines_the_adjoint_solution_from_the_primal_solution": True,
        "the_dual_covector_is_scale_covariant_under_rescaling_of_the_vanishing_vector": True,
        "only_three_primal_rank1509_terminal_ODEs_remain": True,
        "no_dense_rank1509_fundamental_matrix_is_required": True,
        "the_common_base_polarization_application_is_an_explicit_required_certificate": True,
        "integral_minus_two_normalization_is_not_assumed_before_the_integral_marking": True,
        "no_meridian_integral_coordinate_period_beta_or_endpoint_value_is_invented": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    packet = {
        "schema": "mtt.unified-source.g3at-polarized-primal-transport.v1",
        "date": "2026-08-11",
        "theorem_id": "UST.G3AT",
        "status": "CLOSED_EXACT_POLARIZED_PRIMAL_ONLY_TRANSPORT_REDUCTION_THREE_ODES",
        "inputs": {
            "upstream_lock": record(LOCK),
            "locked_B89_residue_theorem": residue_source,
            "G3AS": record(G3AS),
            "G3AR_contract": record(G3AR_DOC),
        },
        "polarized_transport_identity": {
            "frame": "one algebraic B103 trivialization along a frozen B89 path",
            "pairing": "Q(q)=Q(q)^T is the nondegenerate Gauss-Manin polarization matrix",
            "metric_compatibility": "Qdot + A^T Q + Q A = 0",
            "primal_equation": "edot=Ae",
            "self_pairing": "s=e^T Q e is nonzero and constant",
            "dual_reconstruction": "ell=e^T Q/s",
            "dual_equation": "elldot=-ell A",
            "projector": "P=e ell",
            "projector_equation": "Pdot=AP-PA",
            "normalization": "ell(e)=1; P^2=P; tr(P)=1",
            "integral_minus_two_specialization": "if e^T Q e=-2, then ell=-(1/2)e^T Q",
            "reflection": "T=I-2P is Q-orthogonal",
        },
        "execution_reduction": {
