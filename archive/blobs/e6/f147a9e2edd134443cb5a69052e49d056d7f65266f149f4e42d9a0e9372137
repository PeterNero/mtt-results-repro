def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path, *, repository: Path = ROOT) -> dict[str, object]:
    return {
        "path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def homogeneous(exponents: np.ndarray, coefficients: np.ndarray, variables: tuple[sp.Symbol, ...]) -> sp.Expr:
    return sp.expand(
        sum(
            int(coefficient)
            * sp.prod(variable ** int(power) for variable, power in zip(variables, exponent, strict=True))
            for exponent, coefficient in zip(exponents, coefficients, strict=True)
        )
    )


def weighted_exponents(degree: int) -> list[tuple[int, int, int, int]]:
    return [
        (a, b, c, w_power)
        for w_power in range(degree // 3 + 1)
        for a in range(degree - 3 * w_power + 1)
        for b in range(degree - 3 * w_power - a + 1)
        for c in [degree - 3 * w_power - a - b]
    ]


def encode(
    polynomials: list[sp.Expr],
    degree: int,
    variables: tuple[sp.Symbol, ...],
) -> tuple[np.ndarray, np.ndarray]:
    exponents = weighted_exponents(degree)
    rows = []
    for polynomial in polynomials:
        value = sp.Poly(polynomial, *variables, domain=sp.ZZ)
        rows.append(
            [
                int(value.coeff_monomial(sp.prod(variable ** power for variable, power in zip(variables, exponent, strict=True))))
                for exponent in exponents
            ]
        )
    coefficients = np.asarray(rows, dtype=object)
    maximum = max(abs(int(value)) for value in coefficients.reshape(-1))
    require(maximum < 2**63, f"degree{degree} coefficients fit int64")
    return np.asarray(exponents, dtype=np.int16), coefficients.astype(np.int64)


def main() -> None:
    g3fi, g3fj, g3fk, pdelta = map(load, (G3FI, G3FJ, G3FK, PDELTA))
    for label, packet in (("G3FI", g3fi), ("G3FJ", g3fj), ("G3FK", g3fk), ("Pdelta", pdelta)):
        require(all(packet["checks"].values()), f"{label} checks")

    artifact_path = ROOT / g3fj["matrix_factorization"]["artifact"]["path"]
    require(sha256(artifact_path) == g3fj["matrix_factorization"]["artifact"]["sha256"], "G3FJ artifact hash")
    artifact = np.load(artifact_path, allow_pickle=False)
    x, y, z, w = sp.symbols("x y z w")
    variables = (x, y, z, w)
    xyz = (x, y, z)
    q = x * z - y**2
    g3 = sum(
        coefficient * x ** exponent[0] * y ** exponent[1] * z ** exponent[2]
        for exponent, coefficient in conic.G3_TERMS.items()
    )
    r = w + g3
    rbar = w - g3
    h4 = homogeneous(
        artifact["degree4_exponents"], artifact["H4_coefficients"], xyz
    )
    k3 = sp.expand(q * h4 + r * rbar)

    normal_functions = sp.Matrix([q, h4, rbar, r])
    jacobian = normal_functions.jacobian(variables)
    determinant = sp.expand(jacobian.det())
    pdelta_exact = sp.sympify(
        pdelta["residue_polynomial"]["expanded"],
        locals={"x": x, "y": y, "z": z, "w": w},
    )
    require(sp.expand(determinant - 6 * pdelta_exact) == 0, "Jacobian determinant normalization")

    b6_rows = artifact["B6_gamma_coordinates"].astype(np.int64)
    d7_rows = artifact["D7_gamma_coordinates"].astype(np.int64)
    basis6 = np.asarray(normal_runtime.homogeneous_exponents(6), dtype=np.int16)
    basis7 = np.asarray(normal_runtime.homogeneous_exponents(7), dtype=np.int16)
    adjugate = jacobian.adjugate()
    homotopies: list[list[sp.Expr]] = []
    residuals: list[sp.Expr] = []
    identity_residuals: list[sp.Expr] = []
    for coordinate in range(6):
        b6 = homogeneous(basis6, b6_rows[:, coordinate], xyz)
        d7 = homogeneous(basis7, d7_rows[:, coordinate], xyz)
        residual = sp.expand(r * b6 + q * d7)
        vector = sp.Matrix([0, d7, b6, 0])
        homotopy = [sp.expand(value) for value in adjugate * vector]
        replay = sp.expand(
            sum(value * sp.diff(k3, variable) for value, variable in zip(homotopy, variables, strict=True))
            - determinant * residual
        )
        require(replay == 0, f"adjugate homotopy coordinate{coordinate}")
        homotopies.append(homotopy)
        residuals.append(residual)
        identity_residuals.append(replay)

    hx_exponents, hx_coefficients = encode(
        [homotopies[field][component] for field in range(6) for component in range(3)],
        10,
        variables,
    )
    hw_exponents, hw_coefficients = encode(
        [homotopies[field][3] for field in range(6)], 12, variables
    )
    hx_coefficients = hx_coefficients.reshape(6, 3, -1)
    require(hx_coefficients.shape[0:2] == (6, 3), "xyz homotopy shape")
    require(hw_coefficients.shape[0] == 6, "w homotopy shape")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(
        ARRAYS,
        field_power_basis_degrees=np.arange(6, dtype=np.int8),
        xyz_multiplier_weighted_exponents=hx_exponents,
        xyz_multiplier_coefficients=hx_coefficients,
        w_multiplier_weighted_exponents=hw_exponents,
        w_multiplier_coefficients=hw_coefficients,
        H4_coefficients=artifact["H4_coefficients"],
        B6_gamma_coordinates=b6_rows,
        D7_gamma_coordinates=d7_rows,
    )

