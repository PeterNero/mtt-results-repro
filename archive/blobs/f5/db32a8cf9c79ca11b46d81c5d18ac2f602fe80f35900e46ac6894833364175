            cofinal["all_checks_pass"]
        ),
        "prior_based_gauge_frame_orbit_passes": (
            gauge_orbit["all_checks_pass"]
        ),
        "prior_formal_Lorentzian_SP_QME_bridge_passes": (
            formal_bridge["all_checks_pass"]
        ),
        "prior_fixed_coupling_regulated_Cstar_landing_passes": (
            regulated["all_checks_pass"]
        ),
        "cofinal_free_BV_spectral_family_is_closed": (
            cofinal["blocker_assessment"][
                "B.QFT.02_cofinal_free_BV_spectral_cutoff_family"
            ]
            == "closed_on_each_admissible_compact_auxiliary_chart"
        ),
        "cofinal_spectral_projectors_converge_strongly_to_identity": (
            cofinal["abstract_cofinal_theorem"]["strong_limit"]
            == "P_Lambda -> I strongly as Lambda -> infinity"
        ),
        "finite_Cstar_family_compresses_the_same_declared_action_source": (
            "compress the declared action Hamiltonian and evaluate it at any fixed nonzero coupling vector"
            in regulated["regulated_Cstar_landing_theorem"][
                "construction"
            ]
        ),
        "normalized_SP_comparison_is_already_accepted": (
            formal_bridge["direct_six_row_bridge"]["normalization"][
                "accepted"
            ]
        ),
        "EG_target_identification_is_already_accepted": (
            formal_bridge["direct_six_row_bridge"][
                "EG_target_identification"
            ]["accepted"]
        ),
        "BDF_regularized_flow_and_SP_theorem_is_registered": (
            "Brunetti-Duetsch-Fredenhagen pAQFT renormalization group"
            in external_names
        ),
        "Buchholz_Fredenhagen_relative_S_framework_is_registered": (
            "Buchholz-Fredenhagen dynamical Cstar algebra"
            in external_names
        ),
    }

    # Exact first-order witness over one gauge-invariant finite shell.
    # Complex matrices are stored as real/imaginary pairs. The free
    # Hamiltonian is zero only in this executable witness; the theorem uses
    # the norm-Duhamel formula for arbitrary bounded H_0 at finite cutoff.
    witness_dimension = 4
    gauge_unitary = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(-1),
            Fraction(-1),
        ]
    )
    gauss_projector = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(0),
            Fraction(0),
        ]
    )
    interaction = zeros(witness_dimension, witness_dimension)
    interaction[0][1] = Fraction(1)
    interaction[1][0] = Fraction(1)
    interaction[2][3] = Fraction(2)
    interaction[3][2] = Fraction(2)
    probe = zeros(witness_dimension, witness_dimension)
    probe[0][0] = Fraction(1)
    core_projector = gauss_projector
    core_compressed_interaction = mul(
        mul(core_projector, interaction),
        core_projector,
    )

    def commutator(
        left: list[list[Fraction]],
        right: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return sub(mul(left, right), mul(right, left))

    def gauge_conjugate(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return mul(
            mul(gauge_unitary, observable),
            transpose(gauge_unitary),
        )

    def interaction_derivation(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return commutator(interaction, observable)

    matrix_units = []
    for row in range(witness_dimension):
        for column in range(witness_dimension):
            unit = zeros(witness_dimension, witness_dimension)
            unit[row][column] = Fraction(1)
            matrix_units.append(unit)

    witness_time = Fraction(1)
    first_interval = Fraction(1, 2)
    second_interval = Fraction(1, 3)
    integrated_interaction = scale(witness_time, interaction)
    relative_cocycle_tangent_imaginary = scale(
        Fraction(-1),
        integrated_interaction,
    )
    observable_tangent_imaginary = interaction_derivation(probe)
    retarded_response_imaginary = scale(
        witness_time,
        interaction_derivation(probe),
    )

    exact_tangent_checks = {
        "interaction_is_self_adjoint": (
            transpose(interaction) == interaction
        ),
        "interaction_is_gauge_invariant": (
            gauge_conjugate(interaction) == interaction
        ),
        "probe_is_self_adjoint_gauge_invariant_and_Gauss_neutral": (
            transpose(probe) == probe
            and gauge_conjugate(probe) == probe
            and mul(
                mul(gauss_projector, probe),
                gauss_projector,
            )
            == probe
        ),
        "relative_cocycle_tangent_is_minus_i_integrated_interaction": (
            relative_cocycle_tangent_imaginary
            == scale(Fraction(-1), interaction)
        ),
        "relative_cocycle_tangent_is_skew_adjoint": (
            transpose(relative_cocycle_tangent_imaginary)
            == relative_cocycle_tangent_imaginary
        ),
        "observable_tangent_is_nonzero": (
            observable_tangent_imaginary
            != zeros(witness_dimension, witness_dimension)
        ),
        "observable_tangent_is_self_adjoint": (
            transpose(observable_tangent_imaginary)
            == scale(Fraction(-1), observable_tangent_imaginary)
        ),
        "Duhamel_and_first_retarded_response_are_identical": (
            observable_tangent_imaginary
            == retarded_response_imaginary
        ),
        "tangent_preserves_gauge_invariance": (
            gauge_conjugate(observable_tangent_imaginary)
            == observable_tangent_imaginary
        ),
        "tangent_preserves_the_Gauss_neutral_corner": (
            mul(
                mul(
                    gauss_projector,
                    observable_tangent_imaginary,
                ),
                gauss_projector,
            )
            == observable_tangent_imaginary
        ),
        "compressed_common_source_has_the_same_tangent_on_the_retained_core": (
            interaction_derivation(probe)
            == commutator(core_compressed_interaction, probe)
        ),
        "finite_core_vectors_are_eventually_fixed_by_nested_projectors": (
            mul(core_projector, probe) == probe
            and mul(probe, core_projector) == probe
        ),
        "interaction_commutator_obeys_Leibniz_on_all_matrix_units": all(
            interaction_derivation(mul(left, right))
            == add(
                mul(interaction_derivation(left), right),
                mul(left, interaction_derivation(right)),
            )
            for left in matrix_units
            for right in matrix_units
        ),
        "i_times_interaction_commutator_is_star_compatible": all(
            interaction_derivation(transpose(unit))
            == scale(
                Fraction(-1),
                transpose(interaction_derivation(unit)),
            )
            for unit in matrix_units
        ),
        "integrated_interaction_obeys_the_first_order_cocycle_law": (
            scale(first_interval + second_interval, interaction)
            == add(
                scale(first_interval, interaction),
                scale(second_interval, interaction),
            )
        ),
        "gauge_conjugation_intertwines_the_derivation": all(
            gauge_conjugate(interaction_derivation(unit))
            == interaction_derivation(gauge_conjugate(unit))
            for unit in matrix_units
        ),
    }

    # A normalized SP map fixes the first S-matrix tangent but not the
    # untransported first interaction correction to an inserted composite
    # probe. This one-coordinate quadratic jet makes the distinction exact.
    sp_quadratic_coefficient = Fraction(1)
    interaction_coordinate = Fraction(1)
    probe_coordinate = Fraction(1)

