    def laurent_matrix_mul(
        left: list[
            list[dict[int, tuple[Fraction, Fraction]]]
        ],
        right: list[
            list[dict[int, tuple[Fraction, Fraction]]]
        ],
    ) -> list[
        list[dict[int, tuple[Fraction, Fraction]]]
    ]:
        output = laurent_matrix_zero(
            len(left),
            len(right[0]),
        )
        for row in range(len(left)):
            for column in range(len(right[0])):
                for index in range(len(right)):
                    output[row][column] = laurent_add(
                        output[row][column],
                        laurent_mul(
                            left[row][index],
                            right[index][column],
                        ),
                    )
        return output

    def laurent_matrix_adjoint(
        matrix: list[
            list[dict[int, tuple[Fraction, Fraction]]]
