    )
    classical_bv = q79_continuum_sm_classical_bv_composition()
    hyperbolic_bv = q79_sm_gaugefixed_hyperbolic_bv_equicausal()
    local_state = q79_sm_local_formal_physical_state()
    manifest = json.loads(
