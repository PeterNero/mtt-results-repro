    def rational_future_normal(
        parameter: Fraction,
    ) -> list[list[Fraction]]:
        denominator = Fraction(1) - parameter * parameter
        return [
            [
                (
                    Fraction(1) + parameter * parameter
                )
                / denominator
            ],
            [(-2 * parameter) / denominator],
            [Fraction(0)],
            [Fraction(0)],
        ]

    def companion_metric(
        normal: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        normal_flat = mul(lorentz_metric, normal)
        return add(
            lorentz_metric,
            scale(Fraction(2), outer(normal_flat, normal_flat)),
        )

    def companion_inverse(
        normal: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return add(
            lorentz_metric,
            scale(Fraction(2), outer(normal, normal)),
        )

