def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": str(path.relative_to(ROOT)).replace("\\", "/"),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def cup_constant(a: int, b: int, d: int) -> Fraction:
    require(a + b == d - 1, "complementary residue degrees")
    exponent = a * (a + 1) // 2 + b * (b + 1) // 2 + a * a + d - 1
    sign = -1 if exponent % 2 else 1
    return Fraction(sign, math.factorial(a) * math.factorial(b))


def fraction_text(value: Fraction) -> str:
    return str(value.numerator) if value.denominator == 1 else f"{value.numerator}/{value.denominator}"


def locked_sources(source_lock: dict) -> dict[str, object]:
    require(source_lock["schema"] == "mtt.unified-source.g3av-b103-source-lock.v1", "B103 source schema")
    require(source_lock["repository_id"] == SOURCE_REPOSITORY_ID, "B103 source repository")
    require(source_lock["commit"] == SOURCE_COMMIT, "B103 source commit")
    indexed = {item["path"]: item for item in source_lock["sources"]}
    require(set(SOURCE_PATHS).issubset(indexed), "B103 source paths")
    sources = []
    for path in SOURCE_PATHS:
        item = indexed[path]
        require(len(item["git_blob"]) == 40, f"B103 blob {path}")
        require(len(item["sha256"]) == 64, f"B103 hash {path}")
        sources.append(item)
    return {
        "repository_id": source_lock["repository_id"],
        "remote": source_lock["remote"],
        "branch": source_lock["branch"],
        "commit": source_lock["commit"],
        "sources": sources,
    }


