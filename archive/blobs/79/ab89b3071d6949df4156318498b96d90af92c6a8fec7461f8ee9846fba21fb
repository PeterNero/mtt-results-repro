#!/usr/bin/env python3
"""Independently replay the exact G3AO elliptic-bidual identities."""

from __future__ import annotations

import json

import build_ust_g3ao_elliptic_bidual_identity as builder


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def main() -> None:
    recorded = json.loads(builder.OUT.read_text(encoding="ascii"))
    replayed = builder.build_packet()
    require(recorded == replayed, "exact packet replay")
    require(all(recorded["checks"].values()), "all symbolic checks")
    require(not any(recorded["guardrails"].values()), "guardrails remain false")
    print("UST.G3AO elliptic bidual identity verifier: PASS")


if __name__ == "__main__":
    main()
