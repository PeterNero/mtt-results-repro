#!/usr/bin/env python3
"""Independently verify a certified H-major/L-truncated G3AP squeeze."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import build_ust_g3ap_selected_cayley_ordinary_top_lower_bound as lower
import build_ust_g3ap_hmajor_ltrunc_hilbert_hint as hint_builder
import certify_ust_g3ap_selected_cayley_fiber2_hmajor_ltrunc_candidate as certifier
import certify_ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_candidate as canonical
import certify_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_candidate as common
import run_ust_g3ap_selected_cayley_fiber2_hmajor_ltrunc_std_hedge as runner
import run_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_hilbert_hedge as permuted


ROOT = Path(__file__).resolve().parent


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--permutation", choices=tuple(permuted.PERMUTATIONS), required=True)
    parser.add_argument(
        "--candidate-engine", choices=certifier.CANDIDATE_ENGINES, default="std"
    )
    args = parser.parse_args()
    label = args.permutation
    candidate_engine = args.candidate_engine
    order = permuted.PERMUTATIONS[label]
    old_to_new, new_to_old = permuted.position_maps(order)
    candidate_paths = runner.paths(label, candidate_engine)
    paths = certifier.certified_paths(label, candidate_engine)

    subprocess.run(
        [sys.executable, str(ROOT / "verify_ust_g3ap_hmajor_ltrunc_routes.py")],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [sys.executable, str(ROOT / "verify_ust_g3ap_selected_cayley_ordinary_top_lower_bound.py")],
        cwd=ROOT,
        check=True,
    )
    require(paths["packet"].is_file(), "certified packet")
    packet = json.loads(paths["packet"].read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-ltrunc-leading-squeeze-certified-top.v1",
        "packet schema",
    )
    require(
        packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_FIBER2_HMAJOR_LTRUNC_LEADING_SQUEEZE_TOP_DIMENSION_ONE",
        "packet status",
    )
    require(packet["candidate_engine"] == candidate_engine, "candidate engine")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    require(
        packet["permutation"]["label"] == label
        and tuple(packet["permutation"]["old_components_in_new_position_order"])
        == order,
        "packet permutation",
    )
    require(
        packet["regrading"]
        == {
            "Cox_functional": "9H+L",
            "base_weights": list(runner.BASE_WEIGHTS),
            "component_shifts_old_order": list(runner.COMPONENT_SHIFTS),
            "target_scalar_degree": runner.TARGET_SCALAR_DEGREE,
            "H_weight_exceeds_every_target_L_degree": True,
        },
        "H-major regrading",
    )
    require(
        packet["truncation"]["L_boundary_generator_count"] == 165
        and packet["truncation"]["explicit_H_boundary_generator_count"] == 0
        and packet["truncation"]["one_H_step_exits_the_scalar_bound_in_every_component"]
        and packet["truncation"]["target_divisor_box_is_preserved"],
        "target-preserving truncation",
    )

    candidate_packet_path = checked(packet["inputs"]["candidate"], "candidate packet")
    require(candidate_packet_path == candidate_paths["packet"], "candidate path")
    candidate = json.loads(candidate_packet_path.read_text(encoding="ascii"))
    require(
        candidate["schema"] == certifier.candidate_schema(candidate_engine)
        and candidate.get("candidate_engine", "std") == candidate_engine,
        "candidate identity",
    )
    require(
        candidate["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-ltrunc-std-candidate.v1",
        "candidate schema",
    )
    require(candidate["permutation"] == packet["permutation"], "copied permutation")
    source = checked(candidate["inputs"]["selected_source"], "selected source")
    candidate_base = checked(
        candidate["execution"]["candidate_base_cache"], "candidate base"
    )
    candidate_module = checked(
        candidate["execution"]["candidate_module_cache"], "candidate module"
    )
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    candidate_output = checked(candidate["execution"]["output"], "candidate output")
    source_text = source.read_text(encoding="ascii")
    hilbert_hint = None
    if candidate_engine == "hilbert":
        hint_path = checked(
            candidate["inputs"]["non_authoritative_hilbert_hint"],
            "non-authoritative H-major Hilbert hint",
        )
        require(hint_path == hint_builder.PACKET, "canonical H-major hint path")
        subprocess.run(
            [
                sys.executable,
                str(ROOT / "verify_ust_g3ap_hmajor_ltrunc_hilbert_hint.py"),
            ],
            cwd=ROOT,
            check=True,
        )
        _, hilbert_hint = hint_builder.load_hint()
    require(
        candidate_script.read_text(encoding="ascii")
        == runner.candidate_script(
            source_text,
            label,
            order,
            candidate_base,
            candidate_module,
            candidate_engine,
            hilbert_hint,
        ),
        "candidate script reconstruction",
    )
    require(
        f"{certifier.candidate_marker(label, candidate_engine)}_LEADER_EXPORT_PASS"
        in candidate_output.read_text(encoding="utf-8"),
        "candidate process marker",
    )

    script = checked(packet["execution"]["script"], "certification script")
    output = checked(packet["execution"]["output"], "certification output")
    certified_base = checked(packet["execution"]["certified_base_cache"], "certified base")
    certified_module = checked(
        packet["execution"]["certified_module_cache"], "certified module"
    )
    require(
        script.read_text(encoding="ascii")
        == certifier.certification_script(
            source_text,
            label,
            order,
            candidate_base,
            candidate_module,
            certified_base,
            certified_module,
            candidate_engine,
        ),
        "certification script reconstruction",
    )
    raw = output.read_text(encoding="utf-8")
    marker = certifier.certification_marker(label, candidate_engine)
    require(f"{marker}_PASS" in raw, "certification marker")
    expected = {
        f"{marker}_BASE_CANDIDATE_IS_SB_ATTR": 0,
        f"{marker}_BASE_IDEAL_EQUAL": 1,
        f"{marker}_MODULE_CANDIDATE_IS_SB_ATTR": 0,
        f"{marker}_COX_HOMOGENEOUS": 1,
        f"{marker}_ORIGINAL_GENERATORS": 21,
        f"{marker}_BAD_GENERATOR_REMAINDERS": 0,
    }
    for field, value in expected.items():
        require(
            re.search(rf"^{field}={value}$", raw, re.MULTILINE) is not None,
            field,
        )
    base, module_new = certifier.parse_bases(raw, label, candidate_engine)
    candidate_base_leaders = canonical.parse_candidate_base_leaders(raw, marker)
    require(
        canonical.same_monomial_ideal(candidate_base_leaders, base),
        "base leading ideal equality",
    )
    module_old = [
        (new_to_old[component], exponent) for component, exponent in module_new
    ]
    standards, sectors = fiber2.enumerate_target(
        qring.combined_leaders(base, module_old)
    )
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL and len(standards) == 1, "one-line target")
    effective = common.effective_leader_count(module_old)
    require(
        effective == packet["execution"]["target_effective_reducer_count"],
        "target-effective reducer count",
    )
    component, exponent = standards[0]
    top = packet["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["weighted_scalar_degree"] == runner.TARGET_SCALAR_DEGREE
        and top["enumerated_monomials"] == total
        and top["dimension"] == 1
        and top["standard_old_component"] == component
        and top["standard_new_component"] == old_to_new[component]
        and top["standard_exponent"] == list(exponent),
        "certified top line",
    )
    normal = re.search(rf"^{marker}_CANONICAL_NORMAL=(.+)$", raw, re.MULTILINE)
    zero = re.search(rf"^{marker}_CANONICAL_NORMAL_ZERO=([01])$", raw, re.MULTILINE)
    require(
        normal is not None
        and zero is not None
        and top["canonical_socle_normal_form"] == normal.group(1).strip()
        and top["canonical_socle_normal_form_is_nonzero"] == (zero.group(1) == "0"),
        "canonical normal diagnostic",
    )
    lower_packet = json.loads(lower.OUT.read_text(encoding="ascii"))
    require(
        lower_packet["ordinary_top_piece"]["lower_bound_dimension"] == 1,
        "independent lower bound",
    )
    print(
        f"UST.G3AP H-major/L-truncated certificate ({label}, {candidate_engine}): PASS "
        f"reducers={len(module_new)} effective={effective} "
        f"standard={standards[0]} dimension=1"
    )


if __name__ == "__main__":
    main()
