#!/usr/bin/env python3
"""Independently replay the G3DH six-root H02 coupling-rank campaign."""

from __future__ import annotations

import hashlib
import json
import subprocess
import tempfile
from pathlib import Path
from typing import Any

import build_ust_g3dg_h02_split_place_full_coupling_rank as rank_runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3dh_h02_all_split_roots_coupling_rank.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def checked_path(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"missing {path}")
    require(path.stat().st_size == int(record["bytes"]), f"size {path.name}")
    require(sha256(path) == record["sha256"], f"hash {path.name}")
    return path


def parse_vector(fields: dict[str, str], key: str) -> tuple[int, ...]:
    values = tuple(int(value) for value in fields[key].split())
    require(values and values[0] == len(values) - 1, f"{key} count")
    return values[1:]


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(all(packet["checks"].values()), "packet checks")
    require(packet["field"]["roots"] == [5, 1971, 6912, 10062, 10605, 14055], "roots")
    executable = checked_path(packet["rank_tool"]["executable"])
    checked_path(packet["rank_tool"]["source"])

    pivot_columns: list[tuple[int, ...]] = []
    dependent_columns: list[tuple[int, ...]] = []
    pivot_row_sets: list[frozenset[int]] = []
    for row in packet["campaign"]:
        checked_path(row["endpoint_chart"])
        checked_path(row["core_chart"])
        core_log = checked_path(row["core_determinant_log"])
        border_chart = checked_path(row["border_chart"])
        rank_log = checked_path(row["border_rank_log"])
        core_fields = rank_runtime.initializer.parse_log(core_log)
        rank_fields = rank_runtime.initializer.parse_log(rank_log)
        require(int(core_fields["CHART_DETERMINANT"]) == int(row["core_determinant_mod21817"]), "core determinant transcript")
        require(int(rank_fields["RANK"]) == int(row["border_rank"]) == 29515, "border rank transcript")
        require(int(rank_fields["NULLITY"]) == int(row["border_nullity"]) == 1274, "border nullity transcript")
        require(int(row["Q_rank"]) == 4748, "Q rank")
        require(int(row["Q_structural_upper_bound"]) == 5223, "structural upper")
        require(sha256(border_chart) == row["border_chart"]["sha256"], "border hash replay")
        pivots = parse_vector(rank_fields, "PIVOT_COLUMNS")
        dependents = parse_vector(rank_fields, "DEPENDENT_COLUMNS")
        rows = parse_vector(rank_fields, "PIVOT_ROWS")
        require(len(pivots) == len(rows) == 29515 and len(dependents) == 1274, "rank witness sizes")
        pivot_columns.append(pivots)
        dependent_columns.append(dependents)
        pivot_row_sets.append(frozenset(rows))

    require(all(value == pivot_columns[0] for value in pivot_columns), "common pivot-column basis")
    require(all(value == dependent_columns[0] for value in dependent_columns), "common dependent columns")
    require(all(value == pivot_row_sets[0] for value in pivot_row_sets), "common pivot-row set")
    require(all(column >= 24767 for column in dependent_columns[0]), "only update columns dependent")

    replay = next(row for row in packet["campaign"] if int(row["gamma_root"]) == 14055)
    replay_chart = checked_path(replay["border_chart"])
    with tempfile.TemporaryDirectory(prefix="ust_g3dh_verify_") as temporary:
        replay_log = Path(temporary) / "rank.log"
        completed = subprocess.run(
            [
                "wsl",
                rank_runtime.runtime.wsl_path(executable),
                "--chart",
                rank_runtime.runtime.wsl_path(replay_chart),
                "--log",
                rank_runtime.runtime.wsl_path(replay_log),
                "--progress-seconds",
                "60",
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        require(completed.returncode == 0, completed.stdout + completed.stderr)
        fields = rank_runtime.initializer.parse_log(replay_log)
        require(int(fields["RANK"]) == 29515 and int(fields["NULLITY"]) == 1274, "independent root-14055 rank replay")
        require(parse_vector(fields, "PIVOT_COLUMNS") == pivot_columns[0], "independent pivot-column replay")

    result = packet["result"]
    require(result["rank_at_each_split_root"] == [4748] * 6, "packet six ranks")
    require((result["characteristic_zero_rank_lower_bound"], result["characteristic_zero_rank_upper_bound"]) == (4748, 5223), "packet generic interval")
    require(packet["guardrails"]["claims_rank_Q_gamma_Q_is_exactly4748"] is False, "promotion guardrail")
    print(
        "UST.G3DH independent verification: PASS "
        "six_ranks=4748 common_pivot_columns=true generic_interval=4748..5223"
    )


if __name__ == "__main__":
    main()
