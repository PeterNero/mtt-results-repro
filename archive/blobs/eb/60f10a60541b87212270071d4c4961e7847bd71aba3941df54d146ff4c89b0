            "the_same_graded_ideal_profile_occurs_at_all_six_roots": True,
            "the_same_normalization_charts_occur_at_all_six_roots": True,
            "four_degree11_fifteen_degree14_and_eleven_degree15_generators_are_minimal_by_degree": True,
            "the30_generators_reconstruct_the_full_degree15_kernel_at_every_root": True,
            "six_root_power_basis_interpolation_replays_without_mismatch": True,
            "the_characteristic_zero_promotion_payload_is_reduced_from541100_to3608_field_coefficients": field_coefficients == 3608,
        },
        "guardrails": {
            "claims_the30_generators_lift_to_Qgamma": False,
            "claims_the_full_5411_coordinate_lift_is_reconstructed": False,
            "claims_component20_rank36_over_Qgamma": False,
            "claims_global_H02_rank_equality": False,
            "claims_a_physical_endpoint": False,
        },
        "theorem": {
            "name": "ustG3fdComponent20GradedKernelGeneratorReduction",
            "tier": "CLOSED_EXACT_COMPLETE_SPLIT_ALGEBRA_GRADED_GENERATOR_REDUCTION",
            "statement": (
                "At every root of the selected sextic modulo 21817, the canonical "
