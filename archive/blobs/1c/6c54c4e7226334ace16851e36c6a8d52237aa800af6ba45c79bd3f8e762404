#!/usr/bin/env python3
"""Saturate the G3EC component-12 quotient by exact +/-1 pivots."""

from __future__ import annotations

import json
from collections import defaultdict
from pathlib import Path

import numpy as np
from scipy import sparse
from scipy.sparse.csgraph import maximum_bipartite_matching

from build_ust_g3eb_h02_component12_two_level_cayley_lift import (
    ONE,
    ZERO,
    coefficient_add,
    coefficient_multiply,
    coefficient_scale,
    write_number_field_matrix,
)
from build_ust_g3ec_h02_component12_unit_pivot_reduction import (
    PRIME,
    ROOT,
    evaluate,
    finite_rank,
)


INPUT = ROOT / "evidence/ust_g3ec/H02.component12.unit_pivot_reduced.number_field.sms"
INPUT_CERTIFICATE = ROOT / "evidence/ust_g3ec/H02.component12.unit_pivot_reduction.json"
OUTPUT = ROOT / "evidence/ust_g3ed/H02.component12.unit_saturated.number_field.sms"
CERTIFICATE = ROOT / "evidence/ust_g3ed/H02.component12.unit_saturation.json"
NEGATIVE_ONE = (-1, 0, 0, 0, 0, 0)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def parse_matrix() -> tuple[int, list[dict[int, tuple[int, ...]]]]:
    with INPUT.open("r", encoding="ascii") as handle:
        rows, columns, degree, declared = map(int, handle.readline().split())
        minimal = tuple(map(int, handle.readline().split()))
        require(degree == 6 and minimal == (64, 16, 33, 44, 89, 24, 1), "input field")
        result: list[dict[int, tuple[int, ...]]] = [dict() for _ in range(columns)]
        count = 0
        for line in handle:
            values = list(map(int, line.split()))
            result[values[1] - 1][values[0] - 1] = tuple(values[2:])
            count += 1
    require(count == declared, "declared entries")
    return rows, result


def add_scaled(
    target: dict[int, tuple[int, ...]],
    source: dict[int, tuple[int, ...]],
    scalar: tuple[int, ...],
) -> None:
    for row, value in source.items():
        updated = coefficient_add(
            target.get(row, ZERO), coefficient_multiply(scalar, value)
        )
        if updated == ZERO:
            target.pop(row, None)
        else:
            target[row] = updated


def main() -> None:
    upstream = json.loads(INPUT_CERTIFICATE.read_text(encoding="utf-8"))
    rows_count, columns = parse_matrix()
    require([rows_count, len(columns)] == upstream["output"]["shape"], "upstream shape")
    protected = set(int(value) for value in upstream["output"]["free_component12_columns"])
    require(len(protected) == 10, "ten protected component12 columns")

    active_columns = set(range(len(columns)))
    active_rows = {row for column in columns for row in column}
    pivots: list[dict[str, int]] = []
    while True:
        row_degree: dict[int, int] = defaultdict(int)
        for column in active_columns:
            for row in columns[column]:
                if row in active_rows:
                    row_degree[row] += 1
        candidates: list[tuple[int, int, int, int]] = []
        for column in active_columns - protected:
            column_degree = sum(row in active_rows for row in columns[column])
            for row, value in columns[column].items():
                if row not in active_rows or value not in (ONE, NEGATIVE_ONE):
                    continue
                cost = (column_degree - 1) * (row_degree[row] - 1)
                candidates.append((cost, row_degree[row], column, row))
        if not candidates:
            break
        _, _, pivot_column, pivot_row = min(candidates)
        pivot_value = columns[pivot_column][pivot_row]
        sign = pivot_value[0]
        affected = [
            column for column in active_columns - {pivot_column}
            if pivot_row in columns[column]
        ]
        before_nnz = sum(len(columns[column]) for column in active_columns)
        for column in affected:
            factor = coefficient_scale(columns[column][pivot_row], -sign)
            add_scaled(columns[column], columns[pivot_column], factor)
            require(pivot_row not in columns[column], "unit-pivot cancellation")
        active_columns.remove(pivot_column)
        active_rows.remove(pivot_row)
        after_nnz = sum(len(columns[column]) for column in active_columns)
        pivots.append(
            {
                "column": pivot_column,
                "row": pivot_row,
                "sign": sign,
                "affected_columns": len(affected),
                "fill_delta": after_nnz - (before_nnz - len(columns[pivot_column])),
            }
        )

    retained_columns = sorted(active_columns)
    retained_rows = sorted(
        {row for column in retained_columns for row in columns[column] if row in active_rows}
    )
    row_lookup = {old: new for new, old in enumerate(retained_rows)}
    reduced_columns = [
        {row_lookup[row]: value for row, value in columns[old].items() if row in row_lookup}
        for old in retained_columns
    ]
    entries = {
        (row, column): value
        for column, values in enumerate(reduced_columns)
        for row, value in values.items()
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    write_number_field_matrix(OUTPUT, entries, (len(retained_rows), len(reduced_columns)))

    pattern = sparse.csr_matrix(
        (
            np.ones(len(entries), dtype=np.uint8),
            (
                np.asarray([row for row, _ in entries], dtype=np.int32),
                np.asarray([column for _, column in entries], dtype=np.int32),
            ),
        ),
        shape=(len(retained_rows), len(reduced_columns)),
    )
    structural_rank = int(
        np.count_nonzero(maximum_bipartite_matching(pattern, perm_type="column") >= 0)
    )
    rank = finite_rank(reduced_columns, list(range(len(retained_rows))))
    free_columns = [retained_columns.index(column) for column in sorted(protected)]
    require(len(free_columns) == 10, "protected columns retained")
    require(len(reduced_columns) - rank == 10, "finite nullity ten retained")
    payload = {
        "schema": "ust.g3ed.h02.component12.unit-saturation.v1",
        "input": INPUT.relative_to(ROOT).as_posix(),
        "input_shape": [rows_count, len(columns)],
        "protected_input_columns": sorted(protected),
        "exact_unit_pivots": pivots,
        "output": {
            "matrix": OUTPUT.relative_to(ROOT).as_posix(),
            "shape": [len(retained_rows), len(reduced_columns)],
            "nonzero_entries": len(entries),
            "structural_rank": structural_rank,
            "finite_rank_at_p21817_gamma5": rank,
            "finite_nullity": len(reduced_columns) - rank,
            "free_component12_columns": free_columns,
            "retained_input_columns": retained_columns,
            "retained_input_rows": retained_rows,
        },
        "claim_boundary": (
            "Every deletion uses a literal +1 or -1 pivot and preserves kernel "
            "dimension exactly. The rank at the displayed split reduction remains "
            "a characteristic-zero lower bound only."
        ),
    }
    CERTIFICATE.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    print(
        f"G3ED_UNIT_SATURATION input={rows_count}x{len(columns)} pivots={len(pivots)} "
        f"output={len(retained_rows)}x{len(reduced_columns)} nnz={len(entries)} "
        f"structural={structural_rank} finite_rank={rank} "
        f"nullity={len(reduced_columns)-rank}"
    )


if __name__ == "__main__":
    main()
