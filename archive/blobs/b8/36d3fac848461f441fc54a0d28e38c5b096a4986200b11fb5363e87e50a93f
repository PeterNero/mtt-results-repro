            "kernel_tool_source": record(SOURCE),
            "kernel_tool_executable": record(EXECUTABLE),
        },
        "field": {
            "prime": PRIME,
            "roots": list(ROOTS),
            "algebra": "F_21817[gamma]/(m_gamma) is the product over the six roots",
        },
        "compile_stdout": compile_stdout,
        "root_kernels": root_payloads,
        "split_algebra_kernel": {
            "Q": "W*A_H02,B89^-1*U",
            "kernel_shape": [UPDATE_DIMENSION, KERNEL_DIMENSION],
