#!/usr/bin/env python3
"""Run and independently validate one isolated G3GI shard."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


HERE = Path(__file__).resolve().parent


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--prime-index", required=True, type=int)
    arguments = parser.parse_args()
    common = ["--prime-index", str(arguments.prime_index)]
    subprocess.run(
        [sys.executable, str(HERE / "run_shard.py"), *common], check=True
    )
    subprocess.run(
        [sys.executable, str(HERE / "verify_shard.py"), *common], check=True
    )


if __name__ == "__main__":
    main()
