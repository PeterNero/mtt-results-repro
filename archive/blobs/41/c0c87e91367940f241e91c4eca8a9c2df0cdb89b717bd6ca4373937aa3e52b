#!/usr/bin/env python3
"""Export three exact low-degree cusp-cover inputs for the G3AO uvs chart."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess

import sympy as sp

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as common
import run_ust_g3ao_selected_cayley_toric_regularity as direct
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
CAMPAIGN = direct.CAMPAIGN / "uvs_cusp_msolve"
EXPORT_SCRIPT = CAMPAIGN / "export_cusp_cover.sing"
RAW_OUTPUT = CAMPAIGN / "export_cusp_cover.singular.out"
OUT = CAMPAIGN / "inputs.packet.json"
CASES = ("dual0", "dual1", "dual2")
BIDUAL_IDENTITY = ROOT / "state" / "ust_g3ao_elliptic_bidual_identity.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def make_export_script(polynomials: dict[str, str]) -> str:
    return f'''// UST.G3AO exact three-case cover of the Fermat-dual cusp locus.
ring source=(101,g),(x,y,z,w),dp;
minpoly={polynomials["minpoly"]};
poly F6={polynomials["F6"]};
poly K=w^2-F6;
poly A0={polynomials["A0"]};
poly A1={polynomials["A1"]};
poly A2={polynomials["A2"]};
poly Ap0=A0;
poly Ap1=A0+A1+3*A2;
poly Ap2=A0+7*A1+7*A2;
poly D0=-14*Ap0;
poly D1=-4*Ap0+7*Ap1-3*Ap2;
poly D2=6*Ap0-7*Ap1+Ap2;
ring orbit=(101,g),(y,z,w,rho,orbitInv),dp;
minpoly={polynomials["minpoly"]};
map orbitMap=source,1,y,z,w;
poly K=orbitMap(K);
poly D0=orbitMap(D0);
poly D1=orbitMap(D1);
poly D2=orbitMap(D2);
poly cubeRoot=rho^3-1;
poly torus=orbitInv*y*z*w-1;
ideal cuspDual0=K,D0,D1-rho*D2,cubeRoot,torus;
ideal cuspDual1=K,D1,D0-rho*D2,cubeRoot,torus;
ideal cuspDual2=K,D2,D0-rho*D1,cubeRoot,torus;
int exportIndex;
print("G3AO_MSOLVE_DUAL0_COUNT="+string(size(cuspDual0)));
for (exportIndex=1;exportIndex<=size(cuspDual0);exportIndex++)
{{ print("G3AO_MSOLVE_DUAL0_"+string(exportIndex)+"="+string(cuspDual0[exportIndex])); }}
print("G3AO_MSOLVE_DUAL1_COUNT="+string(size(cuspDual1)));
for (exportIndex=1;exportIndex<=size(cuspDual1);exportIndex++)
{{ print("G3AO_MSOLVE_DUAL1_"+string(exportIndex)+"="+string(cuspDual1[exportIndex])); }}
print("G3AO_MSOLVE_DUAL2_COUNT="+string(size(cuspDual2)));
for (exportIndex=1;exportIndex<=size(cuspDual2);exportIndex++)
{{ print("G3AO_MSOLVE_DUAL2_"+string(exportIndex)+"="+string(cuspDual2[exportIndex])); }}
print("G3AO_MSOLVE_EXPORT_PASS");
quit;
'''


def make_msolve_input(polynomials: dict[str, str], generators: list[str]) -> str:
    equations = [common.normalize_for_msolve(polynomials["minpoly"])]
    equations.extend(common.normalize_for_msolve(value) for value in generators)
    return "y,z,w,rho,orbitInv,g\n101\n" + ",\n".join(equations) + "\n"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=1800)
    parser.add_argument("--reuse-export", action="store_true")
    args = parser.parse_args()
    require(args.timeout > 0, "positive timeout")
    CAMPAIGN.mkdir(parents=True, exist_ok=True)
    polynomials = direct.selected_polynomials()
    require(BIDUAL_IDENTITY.is_file(), "elliptic-bidual identity packet")
    bidual_identity = json.loads(BIDUAL_IDENTITY.read_text(encoding="ascii"))
    require(all(bidual_identity["checks"].values()), "elliptic-bidual identity checks")
    g = sp.symbols("g")
    minpoly = sp.Poly(sp.sympify(polynomials["minpoly"].replace("^", "**")), g, modulus=101)
    require(minpoly.degree() == 6 and minpoly.is_irreducible, "irreducible F101 extension")
    EXPORT_SCRIPT.write_text(make_export_script(polynomials), encoding="ascii")
    if args.reuse_export:
        require(RAW_OUTPUT.is_file(), "reusable raw export")
        raw = RAW_OUTPUT.read_text(encoding="utf-8")
    else:
        completed = subprocess.run(
            singular_command(ROOT, EXPORT_SCRIPT),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        RAW_OUTPUT.write_text(completed.stdout, encoding="utf-8")
        require(completed.returncode == 0, "Singular cusp-cover export")
        raw = completed.stdout
    require("G3AO_MSOLVE_EXPORT_PASS" in raw, "export marker")
    records: dict[str, dict[str, object]] = {}
    for case in CASES:
        generators = common.parse_locus(raw, case)
        input_path = CAMPAIGN / f"{case}.msolve.in"
        input_path.write_text(make_msolve_input(polynomials, generators), encoding="ascii")
        records[case] = {
            "generator_count_including_minpoly": len(generators) + 1,
            "input": {
                "path": str(input_path.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
                "sha256": sha256(input_path),
            },
        }
    packet = {
        "schema": "mtt.unified-source.g3ao-uvs-cusp-cover-msolve-inputs.v1",
        "source_sha256": sha256(direct.SOURCE),
        "dependencies": {
            "elliptic_bidual_identity": {
                "path": str(BIDUAL_IDENTITY.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BIDUAL_IDENTITY),
                "theorem_id": bidual_identity["theorem_id"],
            }
        },
        "field_presentation": {
            "characteristic": 101,
            "extension_variable": "g",
            "minpoly": polynomials["minpoly"],
            "degree": 6,
            "irreducible_over_F101": True,
            "all_roots_are_Frobenius_conjugate": True,
        },
        "export_script": {
            "path": str(EXPORT_SCRIPT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(EXPORT_SCRIPT),
        },
        "raw_output": {
            "path": str(RAW_OUTPUT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(RAW_OUTPUT),
        },
        "cases": records,
        "checks": {
            "the_dual_gradient_singular_locus_is_covered_by_three_zero_coordinate_cases": True,
            "each_remaining_cube_equality_is_parameterized_by_rho_cubed_equal_one": True,
            "the_zero_covector_is_retained_in_the_cover": True,
            "the_selected_base_torus_is_saturated": True,
            "the_extension_minpoly_is_irreducible_and_adjoined_over_F101": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    sizes = ", ".join(f"{case}={records[case]['generator_count_including_minpoly']}" for case in CASES)
    print(f"UST.G3AO uvs cusp-cover msolve inputs: PASS {sizes}")


if __name__ == "__main__":
    main()
