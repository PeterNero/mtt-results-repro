            + " ".join(str(value) for value in coefficients)
            for (row, column), coefficients in sorted(entries.items())
        )
        + "\n",
        encoding="ascii",
        newline="\n",
    )


def run_rank_tool(matrix: Path, certificate: Path) -> tuple[int, str]:
    completed = subprocess.run(
        [sys.executable, str(RANK_TOOL), str(matrix), "--certificate", str(certificate)],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    require(completed.returncode == 0, completed.stdout[-2000:])
    match = re.search(r"\brank=(\d+)\b", completed.stdout)
    require(match is not None, "exact rank marker")
    return int(match.group(1)), completed.stdout


def evaluate_matrix(matrices: list[sparse.csc_matrix], root: int) -> sparse.csc_matrix:
    result = sparse.csc_matrix(matrices[0].shape, dtype=np.int64)
    power = 1
    for matrix in matrices:
        term = matrix.copy().astype(np.int64)
        term.data %= PRIME
        term.data = term.data * power % PRIME
        result += term
        power = power * root % PRIME
    result = result.tocsc()
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def nullspace_mod(matrix: np.ndarray) -> np.ndarray:
    work = matrix.astype(np.int64) % PRIME
    row = 0
    pivots: list[int] = []
    for column in range(work.shape[1]):
        choices = np.flatnonzero(work[row:, column] % PRIME)
        if choices.size == 0:
            continue
        pivot = row + int(choices[0])
        if pivot != row:
            work[[row, pivot]] = work[[pivot, row]]
        work[row] = work[row] * pow(int(work[row, column]), -1, PRIME) % PRIME
        for target in range(work.shape[0]):
            if target == row:
                continue
            factor = int(work[target, column] % PRIME)
            if factor:
                work[target] = (work[target] - factor * work[row]) % PRIME
        pivots.append(column)
        row += 1
        if row == work.shape[0]:
            break
    free = [column for column in range(work.shape[1]) if column not in pivots]
    result = np.zeros((work.shape[1], len(free)), dtype=np.int64)
    for index, column in enumerate(free):
        result[column, index] = 1
        for pivot_row, pivot_column in enumerate(pivots):
            result[pivot_column, index] = -work[pivot_row, column] % PRIME
    require(np.count_nonzero(matrix @ result % PRIME) == 0, "modular nullspace")
    return result


def rank_mod(matrix: np.ndarray) -> int:
    return matrix.shape[1] - nullspace_mod(matrix).shape[1]


def exact_action(
    entries: dict[tuple[int, int], tuple[int, ...]],
    descriptors: list[tuple[int, tuple[int, ...]]],
    generators: list[dict[tuple[int, ...], tuple[int, ...]]],
    target_lookup: dict[tuple[int, ...], int],
) -> dict[tuple[int, int], tuple[int, ...]]:
    result: dict[tuple[int, int], tuple[int, ...]] = {}
    for (coordinate, column), source_value in entries.items():
        generator, multiplier = descriptors[coordinate]
        for exponent, generator_value in generators[generator].items():
            product = tuple(
                multiplier[index] + exponent[index] for index in range(10)
            )
            add_entry(
                result,
                (target_lookup[product], column),
                coefficient_multiply(source_value, generator_value),
            )
    return result


