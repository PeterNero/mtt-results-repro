            "q": "xz-y^2",
            "r": "w+G3",
            "rbar": "w-G3",
            "H4": str(h4.as_expr()),
            "identity": "K3=r*rbar+q*H4",
            "H4_nonzero_coefficients": int(np.count_nonzero(h4_rows)),
            "gcd_q_H4": "1",
        },
        "matrix_factorization": {
            "M": [["r", "q"], ["-H4", "rbar"]],
            "N": [["rbar", "-q"], ["H4", "r"]],
            "identities": ["M*N=K3*I2", "N*M=K3*I2"],
            "first_row_normal_map": "(B,D) maps to r*B+q*D",
            "denominator_free_syzygies_on_K3": [
                "(rbar,H4): r*rbar+q*H4=K3=0",
                "(-q,r): -r*q+q*r=0",
            ],
            "graded_pair": "B has degree n and D degree n+1; preimages have degrees n-3 and n-2",
            "artifact": record(TRANSFER),
        },
        "selected_source_binding": {
            "normal_pair": "(B6,D7)",
            "source_identity": "A0_selected-A1=[r q]*(B6,D7)^T",
            "coordinates_replayed": 6,
            "meaning": (
                "The selected derivative difference is now a section of the exact "
