MONOTONE_LEMMA = ROOT / "UST_G3AP_MONOTONE_FULL_SOURCE_RANK_SQUEEZE_LEMMA_v1.md"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def relative(path: Path) -> str:
    return str(path.relative_to(ROOT)).replace("\\", "/")


def record(path: Path) -> dict[str, object]:
    return {
        "path": relative(path),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def checked(item: dict[str, object], label: str) -> Path:
    path = ROOT / str(item["path"])
    require(
        path.is_file()
        and sha256(path) == item["sha256"]
        and path.stat().st_size == item.get("bytes", path.stat().st_size),
        label,
    )
    return path


def packet_scope(
    packet: dict[str, object],
    schema_suffix: str,
    status: str | tuple[str, ...],
    label: str,
) -> None:
    accepted_statuses = (status,) if isinstance(status, str) else status
    require(
        packet["schema"].endswith(schema_suffix)
        and packet["status"] in accepted_statuses
        and all(packet["checks"].values())
        and not any(packet["guardrails"].values()),
        label,
    )


