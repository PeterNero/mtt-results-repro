        "theorem_id": "UST.G3CF",
        "status": "CLOSED_EXACT_RATIONAL_STATIC_SCHUR_GAUGE_ON_OPEN_G3BJ_ARC_AND_B89_DYNAMIC_RICCATI_AND_COEFFICIENT_EXECUTION_OPEN",
        "inputs": {name: record(path) for name, path in INPUTS.items()},
        "coefficient_field": {
