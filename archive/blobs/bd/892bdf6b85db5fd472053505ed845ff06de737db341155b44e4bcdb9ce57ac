            "second_H_rank": g3af_packet["simultaneous_linear_system"]["second_H_rank"],
            "two_H_stacked_rank": g3af_packet["simultaneous_linear_system"]["stacked_rank"],
            "four_H_rank": len(pivots_four_h),
