namespace {

constexpr std::uint32_t kNoBasis = std::numeric_limits<std::uint32_t>::max();

struct Entry {
    std::uint32_t index;
    std::uint32_t value;
};

struct Chart {
    std::uint64_t prime{};
    std::uint64_t rows{};
    std::uint64_t columns{};
    std::uint64_t nonzeros{};
    std::uint64_t quotient_units{};
    std::uint64_t image_rank{};
    std::vector<std::uint64_t> indptr;
    std::vector<std::uint32_t> indices;
    std::vector<std::uint32_t> data;
};

template <typename T>
void read_exact(std::ifstream& input, T* destination, std::size_t count) {
    input.read(
        reinterpret_cast<char*>(destination),
        static_cast<std::streamsize>(sizeof(T) * count));
    if (!input) throw std::runtime_error("truncated chart binary");
}

Chart read_chart(const std::string& path) {
    std::ifstream input(path, std::ios::binary);
    if (!input) throw std::runtime_error("cannot open chart: " + path);
    std::array<char, 8> magic{};
    read_exact(input, magic.data(), magic.size());
    const std::array<char, 8> expected{'M','T','T','S','P','C','1','\0'};
    if (magic != expected) throw std::runtime_error("unexpected chart magic");
    Chart chart;
    read_exact(input, &chart.prime, 1);
    read_exact(input, &chart.rows, 1);
    read_exact(input, &chart.columns, 1);
    read_exact(input, &chart.nonzeros, 1);
    read_exact(input, &chart.quotient_units, 1);
    read_exact(input, &chart.image_rank, 1);
    if (chart.prime < 3 || chart.prime >= (std::uint64_t{1} << 31) ||
        chart.rows == 0 || chart.columns == 0) {
        throw std::runtime_error("invalid chart header");
    }
    chart.indptr.resize(chart.columns + 1);
    chart.indices.resize(chart.nonzeros);
    chart.data.resize(chart.nonzeros);
    read_exact(input, chart.indptr.data(), chart.indptr.size());
    read_exact(input, chart.indices.data(), chart.indices.size());
    read_exact(input, chart.data.data(), chart.data.size());
    if (chart.indptr.front() != 0 || chart.indptr.back() != chart.nonzeros) {
        throw std::runtime_error("invalid CSC endpoints");
    }
    for (std::size_t column = 0; column < chart.columns; ++column) {
        if (chart.indptr[column] > chart.indptr[column + 1]) {
            throw std::runtime_error("nonmonotone CSC pointers");
        }
    }
    for (std::size_t index = 0; index < chart.nonzeros; ++index) {
        if (chart.indices[index] >= chart.rows || chart.data[index] == 0 ||
            chart.data[index] >= chart.prime) {
            throw std::runtime_error("invalid CSC entry");
        }
    }
    return chart;
}

std::uint32_t multiply_mod(
    std::uint32_t left, std::uint32_t right, std::uint32_t prime) {
    return static_cast<std::uint32_t>(
        (static_cast<std::uint64_t>(left) * right) % prime);
}

std::uint32_t subtract_product(
    std::uint32_t current,
    std::uint32_t left,
    std::uint32_t right,
    std::uint32_t prime) {
    const auto product = multiply_mod(left, right, prime);
    return current >= product ? current - product : current + prime - product;
}

std::uint32_t power_mod(
    std::uint32_t value, std::uint64_t exponent, std::uint32_t prime) {
    auto result = std::uint32_t{1};
    while (exponent != 0) {
        if (exponent & 1U) result = multiply_mod(result, value, prime);
        value = multiply_mod(value, value, prime);
        exponent >>= 1U;
    }
    return result;
}

std::uint32_t inverse_mod(std::uint32_t value, std::uint32_t prime) {
    if (value == 0) throw std::runtime_error("attempted inversion of zero");
    return power_mod(value, prime - 2, prime);
}

class ExactSparseRank {
public:
    ExactSparseRank(
        const Chart& chart,
        std::vector<std::uint32_t> original_to_priority)
        : chart_(chart),
          prime_(static_cast<std::uint32_t>(chart.prime)),
          rows_(chart.rows),
          original_to_priority_(std::move(original_to_priority)),
          basis_(rows_),
          work_(rows_, 0),
          nonzero_words_((rows_ + 63) / 64, 0) {}

    bool insert_column(std::uint32_t column) {
        ensure_empty();
        for (auto index = chart_.indptr[column]; index < chart_.indptr[column + 1]; ++index) {
            set_value(
                original_to_priority_[chart_.indices[index]],
                chart_.data[index]);
        }
        std::size_t search_from = 0;
        while (current_nonzeros_ != 0) {
            const auto pivot = first_nonzero(search_from);
            if (basis_[pivot].empty()) {
                const auto inverse = inverse_mod(work_[pivot], prime_);
                auto& vector = basis_[pivot];
                vector.reserve(current_nonzeros_);
                for (std::size_t word_index = pivot / 64;
                     word_index < nonzero_words_.size(); ++word_index) {
                    auto word = nonzero_words_[word_index];
                    while (word != 0) {
                        const auto bit = static_cast<unsigned>(__builtin_ctzll(word));
                        const auto row = static_cast<std::uint32_t>(word_index * 64 + bit);
                        if (row < rows_) {
                            vector.push_back(
                                Entry{row, multiply_mod(work_[row], inverse, prime_)});
                            work_[row] = 0;
                        }
                        word &= word - 1;
                    }
                    nonzero_words_[word_index] = 0;
                }
                basis_terms_ += vector.size();
                current_nonzeros_ = 0;
                pivot_rows_.push_back(pivot);
                pivot_columns_.push_back(column);
                ++rank_;
                maximum_working_terms_ = std::max(maximum_working_terms_, vector.size());
                return true;
            }
            const auto factor = work_[pivot];
            for (const auto& entry : basis_[pivot]) {
                update_value(
                    entry.index,
                    subtract_product(work_[entry.index], factor, entry.value, prime_));
            }
            ++reductions_;
            maximum_working_terms_ = std::max(maximum_working_terms_, current_nonzeros_);
            search_from = pivot;
        }
        dependent_columns_.push_back(column);
        return false;
    }

    std::size_t rank() const { return rank_; }
    std::uint64_t basis_terms() const { return basis_terms_; }
    std::uint64_t reductions() const { return reductions_; }
    std::size_t maximum_working_terms() const { return maximum_working_terms_; }
    const std::vector<std::uint32_t>& pivot_rows() const { return pivot_rows_; }
    const std::vector<std::uint32_t>& pivot_columns() const { return pivot_columns_; }
    const std::vector<std::uint32_t>& dependent_columns() const {
        return dependent_columns_;
    }

private:
    void ensure_empty() const {
        if (current_nonzeros_ != 0) throw std::runtime_error("working vector not empty");
    }

    void set_value(std::uint32_t row, std::uint32_t value) {
        if (value == 0 || work_[row] != 0) {
            throw std::runtime_error("zero or duplicate sparse coefficient");
        }
        work_[row] = value;
        nonzero_words_[row / 64] |= std::uint64_t{1} << (row % 64);
        ++current_nonzeros_;
    }

    void update_value(std::uint32_t row, std::uint32_t value) {
        const auto old = work_[row];
        if (old == 0 && value != 0) {
            nonzero_words_[row / 64] |= std::uint64_t{1} << (row % 64);
            ++current_nonzeros_;
        } else if (old != 0 && value == 0) {
            nonzero_words_[row / 64] &= ~(std::uint64_t{1} << (row % 64));
            --current_nonzeros_;
        }
        work_[row] = value;
    }

    std::uint32_t first_nonzero(std::size_t start) const {
        auto word_index = start / 64;
        auto word = nonzero_words_[word_index] &
                    ((~std::uint64_t{0}) << (start % 64));
        while (true) {
            if (word != 0) {
                return static_cast<std::uint32_t>(
                    word_index * 64 + static_cast<unsigned>(__builtin_ctzll(word)));
            }
            ++word_index;
            if (word_index >= nonzero_words_.size()) {
                throw std::runtime_error("bitset/coefficient inconsistency");
            }
            word = nonzero_words_[word_index];
        }
    }

    const Chart& chart_;
    std::uint32_t prime_;
    std::size_t rows_;
    std::vector<std::uint32_t> original_to_priority_;
    std::vector<std::vector<Entry>> basis_;
    std::vector<std::uint32_t> work_;
    std::vector<std::uint64_t> nonzero_words_;
    std::vector<std::uint32_t> pivot_rows_;
    std::vector<std::uint32_t> pivot_columns_;
    std::vector<std::uint32_t> dependent_columns_;
    std::size_t current_nonzeros_{};
    std::size_t rank_{};
    std::uint64_t basis_terms_{};
    std::uint64_t reductions_{};
    std::size_t maximum_working_terms_{};
};

void write_u32_vector(std::ofstream& output, const std::vector<std::uint32_t>& values) {
    output << values.size();
    for (const auto value : values) output << ' ' << value;
    output << '\n';
}

}  // namespace

int main(int argc, char** argv) {
    try {
        std::string chart_path;
        std::string log_path;
        double progress_seconds = 10.0;
        for (int index = 1; index < argc; ++index) {
            const std::string argument = argv[index];
            if (argument == "--chart" && index + 1 < argc) chart_path = argv[++index];
            else if (argument == "--log" && index + 1 < argc) log_path = argv[++index];
            else if (argument == "--progress-seconds" && index + 1 < argc) {
                progress_seconds = std::stod(argv[++index]);
            } else {
                throw std::runtime_error("unknown or incomplete argument: " + argument);
            }
        }
        if (chart_path.empty() || log_path.empty()) {
            throw std::runtime_error("--chart and --log are required");
        }
        const auto chart = read_chart(chart_path);
        std::vector<std::uint32_t> incidence(chart.rows, 0);
        for (const auto row : chart.indices) ++incidence[row];
        std::vector<std::uint32_t> priority_to_original(chart.rows);
        std::iota(priority_to_original.begin(), priority_to_original.end(), 0);
        std::stable_sort(
            priority_to_original.begin(),
            priority_to_original.end(),
            [&incidence](std::uint32_t left, std::uint32_t right) {
                return incidence[left] != incidence[right]
                    ? incidence[left] < incidence[right] : left < right;
            });
        std::vector<std::uint32_t> original_to_priority(chart.rows);
        for (std::size_t priority = 0; priority < chart.rows; ++priority) {
            original_to_priority[priority_to_original[priority]] =
                static_cast<std::uint32_t>(priority);
        }

        ExactSparseRank ranker(chart, std::move(original_to_priority));
        const auto started = std::chrono::steady_clock::now();
        auto next_progress = started + std::chrono::duration<double>(progress_seconds);
        for (std::uint32_t column = 0; column < chart.columns; ++column) {
            ranker.insert_column(column);
            const auto now = std::chrono::steady_clock::now();
            if (now >= next_progress) {
                const auto elapsed = std::chrono::duration<double>(now - started).count();
                std::cout << "PROGRESS columns=" << column + 1 << '/' << chart.columns
                          << " rank=" << ranker.rank()
                          << " dependent=" << ranker.dependent_columns().size()
                          << " elapsed=" << std::fixed << std::setprecision(3)
                          << elapsed << '\n' << std::flush;
                next_progress = now + std::chrono::duration<double>(progress_seconds);
            }
        }
        const auto finished = std::chrono::steady_clock::now();
        const auto elapsed = std::chrono::duration<double>(finished - started).count();
        std::ofstream log(log_path);
        if (!log) throw std::runtime_error("cannot open log: " + log_path);
        log << "SCHEMA MTTSplitPrimeSparseRank.v1\n";
        log << "STATUS SUCCESS\n";
        log << "PRIME " << chart.prime << '\n';
        log << "ROWS " << chart.rows << '\n';
        log << "COLUMNS " << chart.columns << '\n';
        log << "NONZEROS " << chart.nonzeros << '\n';
        log << "RANK " << ranker.rank() << '\n';
        log << "NULLITY " << chart.columns - ranker.rank() << '\n';
        log << "BASIS_TERMS " << ranker.basis_terms() << '\n';
        log << "REDUCTIONS " << ranker.reductions() << '\n';
        log << "MAXIMUM_WORKING_TERMS " << ranker.maximum_working_terms() << '\n';
        log << "ELAPSED_SECONDS " << std::fixed << std::setprecision(6) << elapsed << '\n';
        log << "PIVOT_ROWS ";
        write_u32_vector(log, ranker.pivot_rows());
        log << "PIVOT_COLUMNS ";
        write_u32_vector(log, ranker.pivot_columns());
        log << "DEPENDENT_COLUMNS ";
        write_u32_vector(log, ranker.dependent_columns());
        log << "END_CERTIFICATE\n";
        std::cout << "SUCCESS prime=" << chart.prime
                  << " rows=" << chart.rows
                  << " columns=" << chart.columns
                  << " rank=" << ranker.rank()
                  << " nullity=" << chart.columns - ranker.rank()
                  << " elapsed=" << std::fixed << std::setprecision(3)
                  << elapsed << '\n';
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "ERROR " << error.what() << '\n';
        return 1;
    }
}
