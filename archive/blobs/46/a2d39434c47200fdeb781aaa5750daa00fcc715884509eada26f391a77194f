#!/usr/bin/env python3
"""Independently verify a direct 9H+L/L-truncated G3AP certificate."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

import build_ust_g3ap_hmajor_ltrunc_hilbert_hint as hint_builder
import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_ordinary_top_lower_bound as lower
import certify_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_candidate as certifier
import certify_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_candidate as common
import run_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_hilbert_hedge as runner
import run_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_sba_hedge as sba_runner
import run_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_sba_warm_hilbert_hedge as warm_runner
import run_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_hilbert_hedge as permuted


ROOT = Path(__file__).resolve().parent


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--permutation", choices=tuple(permuted.PERMUTATIONS), required=True)
    parser.add_argument(
        "--candidate-engine", choices=tuple(certifier.RUNNERS), default="hilbert"
    )
    args = parser.parse_args()
    label = args.permutation
    candidate_engine = args.candidate_engine
    selected_runner = certifier.RUNNERS[candidate_engine]
    grading_runner = (
        selected_runner
        if hasattr(selected_runner, "BASE_WEIGHTS")
        else selected_runner.direct
    )
    order = permuted.PERMUTATIONS[label]
    old_to_new, new_to_old = permuted.position_maps(order)
    candidate_paths = selected_runner.paths(label)
    paths = certifier.certified_paths(label, candidate_engine)
    route_verifier = {
        "hilbert": "verify_ust_g3ap_hmajor_direct_ltrunc_routes.py",
        "sba": "verify_ust_g3ap_hmajor_direct_ltrunc_sba_routes.py",
        "sba_warm_hilbert": "verify_ust_g3ap_hmajor_direct_ltrunc_sba_warm_hilbert_route.py",
    }[candidate_engine]
    subprocess.run(
        [sys.executable, str(ROOT / route_verifier)],
        cwd=ROOT,
        check=True,
    )
    if candidate_engine in ("hilbert", "sba_warm_hilbert"):
        subprocess.run(
            [
                sys.executable,
                str(ROOT / "verify_ust_g3ap_hmajor_ltrunc_hilbert_hint.py"),
            ],
            cwd=ROOT,
            check=True,
        )
    subprocess.run(
        [sys.executable, str(ROOT / "verify_ust_g3ap_selected_cayley_ordinary_top_lower_bound.py")],
        cwd=ROOT,
        check=True,
    )
    require(paths["packet"].is_file(), "certified packet")
    packet = json.loads(paths["packet"].read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-direct-ltrunc-leading-squeeze-certified-top.v1"
        and packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_FIBER2_HMAJOR_DIRECT_LTRUNC_LEADING_SQUEEZE_TOP_DIMENSION_ONE",
        "packet identity",
    )
    require(packet["candidate_engine"] == candidate_engine, "candidate engine")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    require(
        packet["permutation"]["label"] == label
        and tuple(packet["permutation"]["old_components_in_new_position_order"])
        == order,
        "packet permutation",
    )
    require(
        packet["regrading"]
        == {
            "Cox_functional": "9H+L",
            "base_weights": list(grading_runner.BASE_WEIGHTS),
            "component_shifts_old_order": list(grading_runner.COMPONENT_SHIFTS),
            "target_scalar_degree": selected_runner.TARGET_SCALAR_DEGREE,
        },
        "positive regrading",
    )
    require(
        packet["truncation"]["L_boundary_generator_count"] == 165
        and packet["truncation"]["target_Cox_piece_of_boundary_submodule_is_zero"]
        and packet["truncation"]["one_H_step_exits_the_scalar_bound_in_every_component"],
        "target-preserving truncation",
    )

    candidate_packet_path = checked(packet["inputs"]["candidate"], "candidate packet")
    require(candidate_packet_path == candidate_paths["packet"], "candidate path")
    candidate = json.loads(candidate_packet_path.read_text(encoding="ascii"))
    expected_candidate_identity = {
        "hilbert": (
            "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-direct-ltrunc-hilbert-candidate.v1",
            "CANDIDATE_REQUIRES_INDEPENDENT_HMAJOR_DIRECT_LTRUNC_CERTIFICATION",
        ),
        "sba": (
            "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-direct-ltrunc-sba-candidate.v1",
            "CANDIDATE_REQUIRES_INDEPENDENT_HMAJOR_DIRECT_LTRUNC_SBA_CERTIFICATION",
        ),
        "sba_warm_hilbert": (
            "mtt.unified-source.g3ap-selected-cayley-fiber2-hmajor-direct-ltrunc-sba-warm-hilbert-candidate.v1",
            "CANDIDATE_REQUIRES_INDEPENDENT_HMAJOR_DIRECT_LTRUNC_SBA_WARM_HILBERT_CERTIFICATION",
        ),
    }[candidate_engine]
    require(
        (candidate["schema"], candidate["status"]) == expected_candidate_identity
        and candidate["candidate_engine"] == candidate_engine,
        "candidate identity",
    )
    require(candidate["permutation"] == packet["permutation"], "copied permutation")
    source = checked(candidate["inputs"]["selected_source"], "selected source")
    require(
        checked(packet["inputs"]["selected_source"], "copied selected source") == source,
        "selected source binding",
    )
    require(
        checked(
            packet["inputs"]["selected_ordinary_top_lower_bound"],
            "selected ordinary-top lower bound",
        )
        == lower.OUT,
        "lower-bound binding",
    )
    hilbert_values: list[int] | None = None
    seed_module: Path | None = None
    if candidate_engine in ("hilbert", "sba_warm_hilbert"):
        hint = checked(
            candidate["inputs"]["non_authoritative_hilbert_hint"], "Hilbert hint"
        )
        require(hint == hint_builder.PACKET, "canonical Hilbert hint")
        require(
            checked(
                packet["inputs"]["non_authoritative_hilbert_hint"],
                "copied Hilbert hint",
            )
            == hint,
            "Hilbert-hint binding",
        )
        _, hilbert_values = hint_builder.load_hint()
    else:
        require(
            "non_authoritative_hilbert_hint" not in candidate["inputs"]
            and "non_authoritative_hilbert_hint" not in packet["inputs"],
            "SBA has no Hilbert premise",
        )
    if candidate_engine == "sba_warm_hilbert":
        seed_record = candidate["inputs"]["exact_selected_source_SBA_warm_start"]
        copied_seed = packet["inputs"]["exact_selected_source_SBA_warm_start"]
        require(copied_seed == seed_record, "copied SBA warm-start provenance")
        seed_paths = sba_runner.paths(label)
        seed_script = checked(seed_record["script"], "SBA warm-start script")
        seed_output = checked(seed_record["output"], "SBA warm-start output")
        seed_module = checked(seed_record["module_cache"], "SBA warm-start module")
        require(
            (seed_script, seed_output, seed_module)
            == (seed_paths["script"], seed_paths["output"], seed_paths["module_cache"]),
            "canonical SBA warm-start paths",
        )
        seed_raw = seed_output.read_text(encoding="utf-8")
        require(
            seed_script.read_text(encoding="ascii")
            == sba_runner.candidate_script(
                source.read_text(encoding="ascii"), label, order, seed_module
            )
            and f"{sba_runner.marker(label)}_LEADER_EXPORT_PASS" in seed_raw
            and not any(line.lstrip().startswith("?") for line in seed_raw.splitlines()),
            "SBA warm-start reconstruction",
        )
        seed_basis = sba_runner.parse_module(seed_raw, label)
        require(
            len(seed_basis) == seed_record["reduction_set_size"]
            == candidate["execution"]["SBA_warm_start_size"],
            "SBA warm-start size",
        )
    candidate_module = checked(
        candidate["execution"]["candidate_module_cache"], "candidate module"
    )
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    candidate_output = checked(candidate["execution"]["output"], "candidate output")
    source_text = source.read_text(encoding="ascii")
    if candidate_engine == "hilbert":
        expected_candidate_script = selected_runner.candidate_script(
            source_text, label, order, candidate_module, hilbert_values
        )
    elif candidate_engine == "sba":
        expected_candidate_script = selected_runner.candidate_script(
            source_text, label, order, candidate_module
        )
    else:
        require(seed_module is not None and hilbert_values is not None, "warm inputs")
        expected_candidate_script = selected_runner.candidate_script(
            source_text,
            label,
            order,
            seed_module,
            candidate_module,
            hilbert_values,
        )
    require(
        candidate_script.read_text(encoding="ascii") == expected_candidate_script,
        "candidate script reconstruction",
    )
    require(
        f"{selected_runner.marker(label)}_LEADER_EXPORT_PASS"
        in candidate_output.read_text(encoding="utf-8"),
        "candidate process marker",
    )

    script = checked(packet["execution"]["script"], "certification script")
    output = checked(packet["execution"]["output"], "certification output")
    certified_module = checked(
        packet["execution"]["certified_module_cache"], "certified module"
    )
    require(
        script.read_text(encoding="ascii")
        == certifier.certification_script(
            source_text,
            label,
            order,
            candidate_module,
            certified_module,
            candidate_engine,
        ),
        "certification script reconstruction",
    )
    raw = output.read_text(encoding="utf-8")
    tag = certifier.marker(label, candidate_engine)
    require(f"{tag}_PASS" in raw, "certification marker")
    expected = {
        f"{tag}_MODULE_CANDIDATE_IS_SB_ATTR": 0,
        f"{tag}_COX_HOMOGENEOUS": 1,
        f"{tag}_ORIGINAL_GENERATORS": 39,
        f"{tag}_BAD_GENERATOR_REMAINDERS": 0,
    }
    for field, value in expected.items():
        require(re.search(rf"^{field}={value}$", raw, re.MULTILINE) is not None, field)
    module_new = certifier.parse_module(raw, label, candidate_engine)
    module_old = [(new_to_old[component], exponent) for component, exponent in module_new]
    standards, sectors = fiber2.enumerate_target(module_old)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL and len(standards) == 1, "one-line target")
    require(
        common.effective_leader_count(module_old)
        == packet["execution"]["target_effective_reducer_count"],
        "effective reducers",
    )
    component, exponent = standards[0]
    top = packet["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["weighted_scalar_degree"] == selected_runner.TARGET_SCALAR_DEGREE
        and top["enumerated_monomials"] == total
        and top["dimension"] == 1
        and top["standard_old_component"] == component
        and top["standard_new_component"] == old_to_new[component]
        and top["standard_exponent"] == list(exponent),
        "certified top line",
    )
    normal = re.search(rf"^{tag}_CANONICAL_NORMAL=(.+)$", raw, re.MULTILINE)
    zero = re.search(rf"^{tag}_CANONICAL_NORMAL_ZERO=([01])$", raw, re.MULTILINE)
    require(
        normal is not None
        and zero is not None
        and top["canonical_socle_normal_form"] == normal.group(1).strip()
        and top["canonical_socle_normal_form_is_nonzero"] == (zero.group(1) == "0"),
        "canonical normal diagnostic",
    )
    lower_packet = json.loads(lower.OUT.read_text(encoding="ascii"))
    require(
        lower_packet["ordinary_top_piece"]["lower_bound_dimension"] == 1,
        "independent lower bound",
    )
    print(
        f"UST.G3AP direct H-major/L-truncated certificate "
        f"({label}/{candidate_engine}): PASS "
        f"reducers={len(module_new)} effective={common.effective_leader_count(module_old)} "
        f"standard={standards[0]} dimension=1"
    )


if __name__ == "__main__":
    main()
