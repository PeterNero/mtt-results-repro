#!/usr/bin/env python3
"""Refresh JSON dependency records downstream of explicit regenerated files.

The command is deliberately narrow: only records whose ``path`` names a seed
or a JSON owner changed in the preceding round are updated. It therefore
propagates a known regeneration through the dependency DAG without accepting
unrelated stale locks.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def relative(path: Path) -> str:
    return path.resolve().relative_to(ROOT).as_posix()


def candidate_json_files() -> list[Path]:
    paths = list((ROOT / "state").glob("*.json"))
    paths.extend((ROOT / "evidence").glob("ust_g3f*/**/*.json"))
    paths.extend((ROOT / "evidence").glob("ust_g3g*/**/*.json"))
    return sorted({path.resolve() for path in paths if path.is_file()})


def refresh_node(node: Any, changed: set[str]) -> tuple[Any, int]:
    updates = 0
    if isinstance(node, dict):
        dependency = node.get("path")
        if (
            isinstance(dependency, str)
            and dependency.replace("\\", "/") in changed
            and isinstance(node.get("sha256"), str)
        ):
            path = ROOT / dependency
            if not path.is_file():
                raise FileNotFoundError(f"missing dependency: {dependency}")
            digest = sha256(path)
            size = path.stat().st_size
            if node["sha256"] != digest:
                node["sha256"] = digest
                updates += 1
            if "bytes" in node and node["bytes"] != size:
                node["bytes"] = size
                updates += 1
        for key, value in list(node.items()):
            node[key], child_updates = refresh_node(value, changed)
            updates += child_updates
        return node, updates
    if isinstance(node, list):
        for index, value in enumerate(node):
            node[index], child_updates = refresh_node(value, changed)
            updates += child_updates
    return node, updates


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("seeds", nargs="+", help="regenerated paths relative to the repository")
    parser.add_argument("--apply", action="store_true", help="write the refreshed JSON files")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    changed = {relative(ROOT / seed) for seed in args.seeds}
    for seed in sorted(changed):
        if not (ROOT / seed).is_file():
            raise FileNotFoundError(f"missing seed: {seed}")

    candidates = candidate_json_files()
    touched: list[str] = []
    total_updates = 0
    for round_number in range(1, len(candidates) + 2):
        next_changed: set[str] = set()
        round_updates = 0
        for owner in candidates:
            payload = json.loads(owner.read_text(encoding="utf-8"))
            payload, updates = refresh_node(payload, changed)
            if not updates:
                continue
            owner_relative = relative(owner)
            next_changed.add(owner_relative)
            touched.append(owner_relative)
            round_updates += updates
            if args.apply:
                owner.write_text(
                    json.dumps(payload, indent=2, ensure_ascii=True) + "\n",
                    encoding="ascii",
                )
        total_updates += round_updates
        print(
            f"round={round_number} changed_inputs={len(changed)} "
            f"owners={len(next_changed)} field_updates={round_updates}"
        )
        if not next_changed:
            break
        if not args.apply:
            break
        changed = next_changed
    else:
        raise RuntimeError("dependency propagation did not reach a fixed point")

    mode = "APPLY" if args.apply else "DRY_RUN"
    print(f"{mode}: owners={len(set(touched))} field_updates={total_updates}")
    for owner in sorted(set(touched)):
        print(owner)


if __name__ == "__main__":
    main()
