            "certified_primal_path_transports": PATHS,
            "common_base_polarization_apply_rows": PATHS,
            "polarization_conditions": [
                "nondegenerate on the transported vanishing lines",
                "Gauss-Manin compatibility in the declared B103 frame",
                "local projector is the Q-orthogonal projector onto the A1 vanishing line",
            ],
            "reconstructed_outputs": "three common-base rank-one projectors and reflections",
