                ["0", "qe", "A1"],
                ["0", "t2^2", "A2"],
            ],
            "origin": "transpose of the exact G3FK three-equation/four-normal coefficient matrix",
        },
        "maximal_minors": {
            "C_E": "qe*A2-t2^2*A1",
            "C_K": "t0*(H4*B6-rbar*D7)",
            "signed_vector": ["rbar*C_E", "-H4*C_E", "-t2^2*C_K", "qe*C_K"],
            "syzygy_identity": "S^T*Delta=0",
        },
        "grade_two_certificate": {
            "proof": (
                "H4 and rbar=w-G3 are coprime, while qe and t2^2 are coprime. "
                "A common divisor of C_E and C_K would therefore either be t0, "
                "which does not divide C_E, or a base-variable divisor of both A1 "
                "and A2. The displayed good-reduction weighted restriction has gcd1, "
                "so A1 and A2 are coprime over Q(gamma). Thus the four maximal minors "
                "have gcd1. Their proper determinantal ideal has height at most2 and "
                "no height-one prime, hence height exactly2. Hilbert-Burch applies."
            ),
            "good_reduction": {"prime": PRIME, "gamma_root": GAMMA},
            "weighted_restriction": {
                "map": "x=s,y=t,z=s+2t,w=s^3+2*s*t^2+t^3; then s=1",
                "A1_degree": restricted_a1.degree(),
                "A2_degree": restricted_a2.degree(),
                "A1_coefficients_ascending_centered": centered_coefficients(restricted_a1),
                "A2_coefficients_ascending_centered": centered_coefficients(restricted_a2),
                "gcd": "1",
            },
            "height": 2,
        },
        "exact_complex": {
            "sequence": "0 -> R^3 --S--> R^4 --Delta^T--> I_3(S) -> 0",
            "kind": "Cox-homogeneous Hilbert-Burch complex",
            "source_parameters_added": 0,
        },
        "comparison_with_finite_component20": {
            "common_architecture": "four generators, three first syzygy columns",
            "finite_G3FN_column_degrees": [1, 2, 8],
            "status": "OPEN_COX_TO_APOLAR_INTERTWINER",
            "required_equality": (
