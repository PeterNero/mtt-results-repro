            "Hilbert_hint_is_selected_source_evidence": False,
        },
        "ordinary_top_piece": {
            "Cox_degree": [18, 2, 2],
            "H_plus_L_scalar_degree": 44,
            "weighted_scalar_degree": selected_runner.TARGET_SCALAR_DEGREE,
            "enumerated_monomials": fiber2.EXPECTED_TOTAL,
