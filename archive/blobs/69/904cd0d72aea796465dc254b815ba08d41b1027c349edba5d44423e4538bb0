        "G3BN_and_G3BR_close_the_H11_and_H02_parent_charts_at_a1": True,
        "the_canonical_1261_square_lower_block_is_nonzero_over_Q_gamma_a": True,
        "every_zero_or_pole_of_its_nonzero_determinant_is_algebraic": True,
        "the_transcendental_G3BJ_interior_avoids_every_lower_block_zero_and_pole": True,
        "the_terminal_B89_point_a0_is_in_the_same_Schur_gauge": True,
        "the_248_square_Schur_operator_and_effective_source_exist_uniquely_on_0_less_t_le_1": True,
        "the_only_unresolved_gauge_boundary_is_the_Schur_lower_block_at_G3BI_a1": True,
        "no_dense_characteristic_zero_coefficients_path_solution_or_beta_value_is_inferred": True,
    }
    packet = {
