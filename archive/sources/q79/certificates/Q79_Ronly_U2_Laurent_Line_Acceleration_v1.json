  "Laurent_line_isomorphism": {
    "fixed_nonzero_a": true,
    "forward": "u3=a*v^(-1)",
    "inverse": "v=a*u3^(-1)",
    "rings": "F_101[v,v^(-1)] isomorphic to F_101[u3,u3^(-1)]",
    "finite_inverse_checks": 10000
