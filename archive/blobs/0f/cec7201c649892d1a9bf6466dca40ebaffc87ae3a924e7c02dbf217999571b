#!/usr/bin/env python3
"""Independently verify the H11 DM source-observation corridor."""

from __future__ import annotations

import hashlib
import json
from collections import Counter
from pathlib import Path
from typing import Any

import numpy as np
from flint import nmod_mat
from scipy import sparse

import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3cx_h11_dm_source_observation_corridor.packet.json"
PRIME = 21817


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_local(item: dict[str, Any]) -> Path:
    path = ROOT / item["path"]
    require(path.stat().st_size == int(item["bytes"]), f"bytes {path}")
    require(sha256(path) == item["sha256"], f"hash {path}")
    return path


def union_pattern(items: list[dict[str, Any]]) -> sparse.csr_matrix:
    matrices = [sparse.load_npz(ROOT / item["path"]).tocsr() for item in items]
    result = sparse.csr_matrix(matrices[0].shape, dtype=np.uint8)
    for matrix in matrices:
        current = matrix.copy()
        current.data = np.ones(current.nnz, dtype=np.uint8)
        result = result + current
    result.data[:] = 1
    result.eliminate_zeros()
    return result


def closure(seed: set[int], adjacency: list[set[int]]) -> set[int]:
    reached = set(seed)
    stack = list(seed)
    while stack:
        current = stack.pop()
        for target in adjacency[current]:
            if target not in reached:
                reached.add(target)
                stack.append(target)
    return reached


def evaluate(coefficients: np.ndarray, root: int) -> np.ndarray:
    value = coefficients[-1].astype(np.uint64)
    for degree in reversed(range(coefficients.shape[0] - 1)):
        value = (value * root + coefficients[degree]) % PRIME
    return value.astype(np.uint16)


def main() -> None:
    packet = load(PACKET)
    require(all(packet["checks"].values()), "packet checks")
    g3cv = load(verify_local(packet["inputs"]["G3CV"]))
    g3cw = load(verify_local(packet["inputs"]["G3CW"]))
    arrays_path = verify_local(packet["exact_component_DAG"]["arrays"])
    emitted = np.load(arrays_path, allow_pickle=False)

    mld = runtime.resolve_mld()
    dm_item = packet["inputs"]["H11_DM"]
    dm_path = mld / dm_item["repository_relative_path"]
    require(sha256(dm_path) == dm_item["sha256"], "DM packet hash")
    dm = load(dm_path)
    dm_arrays_item = packet["inputs"]["H11_DM_arrays"]
    dm_arrays_path = mld / dm_arrays_item["repository_relative_path"]
    require(sha256(dm_arrays_path) == dm_arrays_item["sha256"], "DM arrays hash")
    arrays = np.load(dm_arrays_path, allow_pickle=False)
    component_by_row = arrays["component_by_complement_row"].astype(np.int32)
    component_by_column = arrays["component_by_image_column"].astype(np.int32)
    component_sizes = arrays["component_sizes"].astype(np.int32)
    complement_rows = arrays["complement_ambient_rows"].astype(np.int32)

    chart_item = packet["inputs"]["root5_B89_chart"]
    chart_path = mld / chart_item["repository_relative_path"]
    require(sha256(chart_path) == chart_item["sha256"], "root5 chart hash")
    chart, prime, quotient, image = initializer.read_chart(chart_path)
    require((prime, quotient, image) == (PRIME, 1013, 4426), "chart typing")
    pattern = chart[complement_rows, 1013:].tocoo()
    require(
        pattern.nnz == int(dm["exact_complement_pattern"]["nonzero_entries"]),
        "exact support cardinality",
    )

    count = int(component_sizes.size)
    successors: list[set[int]] = [set() for _ in range(count)]
    predecessors: list[set[int]] = [set() for _ in range(count)]
    edges: set[tuple[int, int]] = set()
    for left, right in zip(
        component_by_row[pattern.row].tolist(),
        component_by_column[pattern.col].tolist(),
        strict=True,
    ):
        left = int(left)
        right = int(right)
        if left != right:
            successors[left].add(right)
            predecessors[right].add(left)
            edges.add((left, right))

    u_pattern = union_pattern(g3cv["factorization"]["U_gamma_coefficients"])
    w_pattern = union_pattern(g3cv["factorization"]["W_gamma_coefficients"])
    source_components = set(
        int(value) for value in np.unique(component_by_row[u_pattern.nonzero()[0]])
    )
    observation_components = set(
        int(value)
        for value in np.unique(component_by_column[w_pattern.nonzero()[1]])
    )
    solution = closure(source_components, predecessors)
    descendants = closure(observation_components, successors)
    corridor = solution & descendants

    u_csc = u_pattern.tocsc()
    active_columns: list[int] = []
    zero_columns: list[int] = []
    for column in range(988):
        rows = u_csc.indices[u_csc.indptr[column] : u_csc.indptr[column + 1]]
        components = set(int(value) for value in component_by_row[rows])
        (active_columns if components & descendants else zero_columns).append(column)
    active_rows: list[int] = []
    for row in range(988):
        columns = w_pattern.indices[
            w_pattern.indptr[row] : w_pattern.indptr[row + 1]
        ]
        components = set(int(value) for value in component_by_column[columns])
        if components & solution:
            active_rows.append(row)

    require(
        np.array_equal(emitted["source_components"], np.asarray(sorted(source_components))),
        "source components",
    )
    require(
        np.array_equal(
            emitted["observation_components"], np.asarray(sorted(observation_components))
        ),
        "observation components",
    )
    require(
        np.array_equal(emitted["solution_components"], np.asarray(sorted(solution))),
        "solution components",
    )
    require(
        np.array_equal(emitted["corridor_components"], np.asarray(sorted(corridor))),
        "corridor components",
    )
    require(
        np.array_equal(emitted["active_kernel_columns"], np.asarray(active_columns)),
        "active kernel columns",
    )
    require(
        np.array_equal(
            emitted["structurally_zero_kernel_columns"], np.asarray(zero_columns)
        ),
        "zero kernel columns",
    )
    require(
        np.array_equal(emitted["active_kernel_rows"], np.asarray(active_rows)),
        "active kernel rows",
    )
    require(len(corridor) == 394, "corridor component count")
    require(int(component_sizes[list(corridor)].sum()) == 2786, "corridor dimension")
    require(
        Counter(int(component_sizes[value]) for value in corridor)
        == Counter({1: 392, 684: 1, 1710: 1}),
        "corridor block sizes",
    )
    require((len(active_columns), len(zero_columns), len(active_rows)) == (740, 248, 988), "kernel support counts")

    q_path = ROOT / g3cw["reduced_kernel_action"]["coefficient_archive"]["path"]
    q_coefficients = np.load(q_path, allow_pickle=False)["coefficients"]
    q_support = np.any(q_coefficients != 0, axis=0)
    require(
        np.flatnonzero(np.any(q_support, axis=0)).tolist() == active_columns,
        "Q column replay",
    )
    split_ranks = [
        int(nmod_mat(988, 988, evaluate(q_coefficients, int(root)).reshape(-1).tolist(), PRIME).rank())
        for root in g3cw["field"]["gamma_roots"]
    ]
    require(split_ranks == [710] * 6, "split ranks")
    require(packet["kernel_reduction"]["proved_characteristic_zero_rank_interval"] == [710, 740], "rank interval")
    print("UST.G3CX H11 DM source-observation corridor verifier: PASS")
    print(
        "corridor=394/2786 blocks=1710+684+392x1 "
        "active_columns=740 zero_columns=248 rank_interval=710..740"
    )


if __name__ == "__main__":
    main()
