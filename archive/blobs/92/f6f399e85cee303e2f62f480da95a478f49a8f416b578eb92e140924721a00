"""Run plain ``std`` on a permuted target-preserving G3AP Cox box.

This is an independent execution hedge beside the Hilbert-driven and
``qslimgb`` routes.  Process success emits candidate evidence only; the
shared certifier must reconstruct the selected source and prove the target
upper/lower squeeze before canonical adoption.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import build_ust_g3ap_selected_cayley_fiber2_weighted_hilbert_hint as weighted
import run_ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_hedge as weighted_hilbert
import run_ust_g3ap_selected_cayley_fiber2_weighted_boxtrunc_hilbert_hedge as boxtrunc
import run_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_hilbert_hedge as permuted
import run_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_qslimgb_hedge as qslimgb_runner
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
BASE_CACHE = weighted_hilbert.BASE_CACHE


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def paths(label: str) -> dict[str, Path]:
    stem = f"ust_g3ap_selected_cayley_fiber2_weighted_boxperm_{label}_std"
    return {
        "script": STATE / f"{stem}.sing",
        "output": STATE / f"{stem}.singular.out",
        "cache": STATE / f"{stem}_degree254.ssi",
        "packet": STATE / f"{stem}.packet.json",
    }


def candidate_script(
    source: str, label: str, order: tuple[int, ...], cache: Path
) -> str:
    script = qslimgb_runner.candidate_script(source, label, order, cache)
    script = script.replace(
        f"G3AP_F2_WBOXPERMQSLIM_{label.upper()}",
        f"G3AP_F2_WBOXPERMSTD_{label.upper()}",
    )
    script = script.replace("module G=qslimgb(MT);", "module G=std(MT);")
    require("qslimgb(MT)" not in script, "plain std route")
    return script


def parse_bases(raw: str, label: str):
    marker = f"G3AP_F2_WBOXPERMSTD_{label.upper()}_"
    return qring.parse_leaders(raw.replace(marker, "G3AP_F2_QRING_"))


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--permutation", choices=tuple(permuted.PERMUTATIONS), required=True)
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    label = args.permutation
    order = permuted.PERMUTATIONS[label]
    old_to_new, new_to_old = permuted.position_maps(order)
    route = paths(label)
    require(BASE_CACHE.is_file() and BASE_CACHE.stat().st_size > 0, "weighted base cache")
    hint = json.loads(boxtrunc.HINT_PACKET.read_text(encoding="ascii"))
    require(not any(hint["guardrails"].values()), "Cox-box hint guardrails")
    source = SOURCE.read_text(encoding="ascii")
    route["script"].write_text(
        candidate_script(source, label, order, route["cache"]), encoding="ascii"
    )
    if args.emit_only:
        print(f"emitted {route['script'].relative_to(ROOT)}")
        return

    route["cache"].unlink(missing_ok=True)
    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, route["script"]),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    raw = completed.stdout
    route["output"].write_text(raw, encoding="utf-8")
    marker = f"G3AP_F2_WBOXPERMSTD_{label.upper()}"
    require(completed.returncode == 0, "permuted Cox-box std execution")
    require(
        not any(line.lstrip().startswith("?") for line in raw.splitlines()),
        "Singular execution errors",
    )
    require(f"{marker}_LEADER_EXPORT_PASS" in raw, "permuted Cox-box std marker")
    require(route["cache"].is_file() and route["cache"].stat().st_size > 0, "module cache")
    base, module_new = parse_bases(raw, label)
    module_old = [(new_to_old[component], exponent) for component, exponent in module_new]
    standards, sectors = fiber2.enumerate_target(
        qring.combined_leaders(base, module_old)
    )
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(len(standards) == 1, "candidate target upper bound one")
    standard_old_component, standard_exponent = standards[0]
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-weighted-permuted-boxtrunc-std-candidate.v1",
        "date": "2026-08-10",
        "status": "CANDIDATE_REQUIRES_INDEPENDENT_PERMUTATION_AND_TARGET_BOX_CERTIFICATION",
        "permutation": {
            "label": label,
            "old_components_in_new_position_order": list(order),
            "old_to_new": {str(key): value for key, value in old_to_new.items()},
            "new_to_old": {str(key): value for key, value in new_to_old.items()},
            "new_position_shifts": list(permuted.mapped_shifts(order)),
            "is_degree_preserving_module_isomorphism": True,
        },
        "inputs": {
            "selected_source": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            },
            "weighted_base_cache": {
                "path": str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BASE_CACHE),
                "bytes": BASE_CACHE.stat().st_size,
                "isSB_trust_attribute_stored": False,
            },
            "canonical_box_hint": {
                "path": str(boxtrunc.HINT_PACKET.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(boxtrunc.HINT_PACKET),
                "schema": hint["schema"],
                "authoritative": False,
            },
        },
        "truncation": hint["truncation"],
        "execution": {
            "engine": "Singular std on the exact target-preserving Cox-box module",
            "script": {
                "path": str(route["script"].relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(route["script"]),
            },
            "output": {
                "path": str(route["output"].relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(route["output"]),
            },
            "elapsed_seconds": time.time() - started,
            "base_basis_size": len(base),
            "selected_derivative_generator_count": 21,
            "truncation_generator_count": 12159,
            "candidate_basis_size_through_bound": len(module_new),
            "candidate_module_cache": {
                "path": str(route["cache"].relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(route["cache"]),
                "bytes": route["cache"].stat().st_size,
                "valid_through_weighted_scalar_degree": weighted.TARGET_SCALAR_DEGREE,
                "isSB_trust_attribute_stored": False,
            },
        },
        "candidate_top_piece": {
            "Cox_degree": [18, 2, 2],
            "weighted_scalar_degree": weighted.TARGET_SCALAR_DEGREE,
            "enumerated_monomials": total,
            "dimension_if_certified": 1,
            "standard_old_component": standard_old_component,
            "standard_new_component": old_to_new[standard_old_component],
            "standard_exponent": list(standard_exponent),
        },
        "guardrails": {
            "claims_std_process_success_is_a_proof": False,
            "claims_target_effective_reducers_are_certified": False,
            "claims_G3AP_is_closed": False,
            "claims_response_rank_or_beta_C_is_computed": False,
        },
        "next_required_object": (
            "Independently reconstruct the selected base, permutation, 21 generators, "
            "target box and candidate cache before combining the upper bound with G3AP.LOWER."
        ),
    }
    route["packet"].write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        f"G3AP permuted Cox-box std candidate ({label}): PASS "
        f"module={len(module_new)} standard={standards[0]} certification=OPEN"
    )


if __name__ == "__main__":
    main()
