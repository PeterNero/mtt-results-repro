        ]

    def polynomial_matrix_trace(
        matrix: list[
            list[
                dict[
                    tuple[int, int],
                    tuple[Fraction, Fraction],
                ]
            ]
        ],
    ) -> dict[tuple[int, int], tuple[Fraction, Fraction]]:
        output = polynomial_constant()
        for index in range(len(matrix)):
            output = polynomial_add(
                output,
                matrix[index][index],
            )
        return output

    def polynomial_kronecker_rational(
        left: list[
            list[
                dict[
                    tuple[int, int],
                    tuple[Fraction, Fraction],
                ]
            ]
        ],
        right: list[list[Fraction]],
    ) -> list[
        list[
            dict[tuple[int, int], tuple[Fraction, Fraction]]
        ]
    ]:
        output = polynomial_zero_matrix(
            len(left) * len(right),
            len(left[0]) * len(right[0]),
        )
        for left_row in range(len(left)):
            for left_column in range(len(left[0])):
                for right_row in range(len(right)):
                    for right_column in range(len(right[0])):
                        output[
                            left_row * len(right) + right_row
                        ][
                            left_column * len(right[0])
                            + right_column
                        ] = polynomial_scale(
                            left[left_row][left_column],
                            (
                                right[right_row][right_column],
                                Fraction(0),
                            ),
                        )
        return output

    def polynomial_matrix_terms(
        matrix: list[
            list[
                dict[
                    tuple[int, int],
                    tuple[Fraction, Fraction],
                ]
            ]
        ],
    ) -> list[list[list[dict[str, int | str]]]]:
        return [
            [polynomial_terms(value) for value in row]
            for row in matrix
        ]

    polynomial_one = polynomial_constant(1)
    polynomial_minus_one = polynomial_constant(-1)
    coordinate_u = polynomial_variable((1, 0))
    coordinate_v = polynomial_variable((0, 1))
    radius_squared = polynomial_add(
        polynomial_mul(coordinate_u, coordinate_u),
        polynomial_mul(coordinate_v, coordinate_v),
    )
    denominator = polynomial_add(
        polynomial_one,
        radius_squared,
    )
    complex_coordinate = polynomial_add(
        coordinate_u,
        polynomial_scale(coordinate_v, gaussian_i),
    )
    conjugate_coordinate = polynomial_conjugate(
        complex_coordinate
    )
    bott_numerator = [
        [polynomial_one, conjugate_coordinate],
        [complex_coordinate, radius_squared],
    ]
    bott_numerator_squared = polynomial_matrix_mul(
        bott_numerator,
        bott_numerator,
    )
    bott_determinant = polynomial_add(
        polynomial_mul(
            bott_numerator[0][0],
            bott_numerator[1][1],
        ),
        polynomial_scale(
            polynomial_mul(
