    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        f"UST.G3AP direct H-major result ({label}/{candidate_engine}) adopted: "
        f"dimension=1 basis={basis}"
    )


if __name__ == "__main__":
    main()
