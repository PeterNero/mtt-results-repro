def evaluate_gamma(coordinates: list[int] | tuple[int, ...]) -> int:
    value = 0
    for coordinate in reversed(coordinates):
        value = (value * ROOT_VALUE + int(coordinate)) % PRIME
    return value


def monomial_xyz(exponent: tuple[int, int, int], *, sheet: bool = False) -> str:
    pieces = []
    for variable, power in zip(("x", "y", "z"), exponent, strict=True):
        if power == 1:
            pieces.append(variable)
        elif power > 1:
            pieces.append(f"{variable}^{power}")
    if sheet:
        pieces.append("w")
    return "*".join(pieces) if pieces else "1"


def scaled_term(coefficient: int, monomial: str) -> str:
    coefficient %= PRIME
    if coefficient == 0:
        return ""
    if monomial == "1":
        return str(coefficient)
    if coefficient == 1:
        return monomial
    return f"{coefficient}*{monomial}"


def endpoint_coefficient_rows(g3bi: dict[str, Any], cayley: Any) -> list[str]:
    vectors = g3bi["selected_source"]["coefficient_vectors"]
    require(len(vectors) == 249, "249 selected endpoint coefficient vectors")
    degree9 = [tuple(int(value) for value in row) for row in cayley.monomials(9)]
    degree6 = [tuple(int(value) for value in row) for row in cayley.monomials(6)]
    require(len(degree9) == 55 and len(degree6) == 28, "55+28 spectral basis")
    result = []
    for theta in range(3):
        terms = []
        offset = theta * 83
        for local, exponent in enumerate(degree9):
            term = scaled_term(evaluate_gamma(vectors[offset + local]), monomial_xyz(exponent))
            if term:
                terms.append(term)
        for local, exponent in enumerate(degree6):
            term = scaled_term(
                evaluate_gamma(vectors[offset + 55 + local]),
                monomial_xyz(exponent, sheet=True),
            )
            if term:
                terms.append(term)
        require(terms, f"nonzero endpoint A{theta}")
        result.append("+".join(terms))
    return result


def correction_row(g3bi: dict[str, Any]) -> str:
    terms = []
    for row in g3bi["exact_construction"]["right_inverse_rows"]:
        coefficient = evaluate_gamma(row["correction_gamma_coordinates"])
        monomial = monomial_xyz(tuple(int(value) for value in row["source_monomial"]))
        term = scaled_term(coefficient, monomial)
        if term:
            terms.append(term)
    require(terms, "nonzero selected correction row")
    return "+".join(terms)


def source_rows(
    quotient: np.ndarray, h02: dict[str, Any], ordinary: Any
) -> list[str]:
    require(quotient.shape == (QUOTIENT_DIMENSION, SOURCE_DIMENSION), "G3GJ quotient shape")
    exponents = [
        tuple(int(value) for value in row) for row in h02["basis_exponent_vectors"]
    ]
    require(len(exponents) == QUOTIENT_DIMENSION, "248 H02 basis exponents")
    result = []
    for column in range(SOURCE_DIMENSION):
        terms = []
        for row in np.flatnonzero(quotient[:, column] % PRIME):
            term = scaled_term(
                int(quotient[row, column]), ordinary.monomial_text(exponents[int(row)])
            )
            if term:
                terms.append(term)
        require(terms, f"nonzero G3GJ quotient source column {column}")
        result.append("+".join(terms))
    return result


