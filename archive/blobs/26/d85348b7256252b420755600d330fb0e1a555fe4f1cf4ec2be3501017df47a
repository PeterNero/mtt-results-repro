#!/usr/bin/env python3
"""Certify an untrusted Hilbert-guided G3AP fiber-two candidate."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import run_ust_g3ap_selected_cayley_fiber2_hilbert_hedge as guided
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
CANDIDATE = guided.PACKET
SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_hilbert_certify.sing"
OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_hilbert_certify.singular.out"
CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_hilbert_certified_degree44.ssi"
PACKET = STATE / "ust_g3ap_selected_cayley_fiber2_hilbert_certified.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def certification_script(source: str) -> str:
    generators = ",\n  ".join(fiber2.module_generators())
    candidate_relative = str(guided.CACHE.relative_to(ROOT)).replace("\\", "/")
    cache_relative = str(CACHE.relative_to(ROOT)).replace("\\", "/")
    return fiber2.selected_base_prefix(source) + f'''module M=
  {generators};
intvec componentShifts=12,15,8,18,11,4;
attrib(M,"isHomog",componentShifts);
def cachedCandidate=read("ssi:r {candidate_relative}");
module candidateBasis=cachedCandidate;
print("G3AP_F2_HCERT_CANDIDATE_IS_SB_ATTR="+string(attrib(candidateBasis,"isSB")));
attrib(candidateBasis,"isHomog",componentShifts);
option(noredTail);
degBound=44;
module G=std(candidateBasis);
int badGeneratorRemainders=0;
int i;
for (i=1;i<=size(M);i++)
{{ if (reduce(M[i],G)!=0) {{ badGeneratorRemainders=badGeneratorRemainders+1; }} }}
print("G3AP_F2_HCERT_BOUND="+string(degBound));
print("G3AP_F2_HCERT_ORIGINAL_GENERATORS="+string(size(M)));
print("G3AP_F2_HCERT_BAD_GENERATOR_REMAINDERS="+string(badGeneratorRemainders));
print("G3AP_F2_HCERT_MODULE_GB_SIZE="+string(size(G)));
for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_HCERT_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_HCERT_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isHomog",componentShifts);
attrib(G,"isSB",0);
write("ssi:w {cache_relative}",G);
print("G3AP_F2_HCERT_PASS");
quit;
'''


def parse_leaders(raw: str) -> list[tuple[int, tuple[int, ...]]]:
    normalized = raw.replace("G3AP_F2_HCERT_", "G3AP_F2_MODULE_")
    return fiber2.parse_leaders(normalized)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    candidate = json.loads(CANDIDATE.read_text(encoding="ascii"))
    require(
        candidate["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-hilbert-guided-candidate.v1",
        "candidate schema",
    )
    require(
        candidate["status"] == "CANDIDATE_REQUIRES_INDEPENDENT_SELECTED_SOURCE_CERTIFICATION",
        "candidate status",
    )
    require(all(candidate["checks"].values()), "candidate checks")
    require(not any(candidate["guardrails"].values()), "candidate guardrails")
    source_path = checked(candidate["inputs"]["selected_source"], "selected source")
    checked(candidate["inputs"]["predecessor_hint"], "hint packet")
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    checked(candidate["execution"]["output"], "candidate output")
    candidate_cache = checked(candidate["execution"]["cache"], "candidate cache")
    source = source_path.read_text(encoding="ascii")
    _, hint = guided.load_hint()
    require(candidate_script.read_text(encoding="ascii") == guided.guided_script(source, hint), "candidate script reconstruction")
    require(candidate_cache == guided.CACHE, "canonical candidate cache path")
    SCRIPT.write_text(certification_script(source), encoding="ascii")
    if args.emit_only:
        print(f"emitted {SCRIPT.relative_to(ROOT)}")
        return
    CACHE.unlink(missing_ok=True)
    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, "candidate certification execution")
    require("G3AP_F2_HCERT_PASS" in completed.stdout, "certification pass marker")
    require(re.search(r"^G3AP_F2_HCERT_CANDIDATE_IS_SB_ATTR=0$", completed.stdout, re.MULTILINE) is not None, "candidate trust cleared")
    require(re.search(r"^G3AP_F2_HCERT_BAD_GENERATOR_REMAINDERS=0$", completed.stdout, re.MULTILINE) is not None, "all original generators reduce")
    require(CACHE.is_file() and CACHE.stat().st_size > 0, "certified cache")
    leaders = parse_leaders(completed.stdout)
    standards, sectors = fiber2.enumerate_target(leaders)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "certified unique top")
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-hilbert-certified-top.v1",
        "date": "2026-08-10",
        "theorem_id": "UST.G3AP.FIBER2.HILBERT.CERTIFIED",
        "status": "CLOSED_EXACT_SELECTED_F1016_FIBER2_HILBERT_CERTIFIED_TOP_DIMENSION_ONE",
        "inputs": {
            "candidate": {"path": str(CANDIDATE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(CANDIDATE)},
            "selected_source": {"path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(SOURCE)},
        },
        "execution": {
            "script": {"path": str(SCRIPT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(SCRIPT)},
            "output": {"path": str(OUTPUT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(OUTPUT)},
            "elapsed_seconds": time.time() - started,
            "original_module_generator_count": 39,
            "certified_basis_size_through_bound": len(leaders),
            "scalar_degree_bound": 44,
            "certified_cache": {
                "path": str(CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(CACHE),
                "bytes": CACHE.stat().st_size,
                "valid_through_total_scalar_degree": 44,
                "isSB_trust_attribute_stored": False,
            },
        },
        "fiber_degree_two_module": {
            "components": [name for _, name, _, _ in fiber2.COMPONENTS],
            "component_scalar_shifts": [shift for _, _, _, shift in fiber2.COMPONENTS],
            "sectors": sectors,
        },
        "ordinary_top_piece": {
            "Cox_degree": [18, 2, 2],
            "scalar_weight": 44,
            "enumerated_monomials": total,
            "dimension": 1,
            "basis": ["w^12*t2^4*s^2"],
            "basis_component": "s2",
            "basis_base_exponent": list(fiber2.EXPECTED_STANDARD[1]),
        },
        "checks": {
            "candidate_cache_is_reloaded_without_isSB_trust": True,
            "component_shifts_are_reasserted_before_candidate_recomputation": True,
            "ordinary_std_is_recomputed_from_the_candidate": True,
            "candidate_elements_originate_from_exact_std_operations_on_the_39_selected_generators": True,
            "all_39_original_selected_generators_reduce_to_zero": True,
            "therefore_the_candidate_and_selected_modules_are_equal": True,
            "all_174865_target_monomials_are_enumerated": True,
            "selected_ordinary_top_piece_has_dimension_one": True,
            "no_predecessor_entry_is_used_as_selected_source_evidence": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
        "guardrails": {
            "claims_an_unrestricted_module_basis": False,
            "claims_response_rank_or_beta_C_is_computed": False,
            "claims_characteristic_zero_promotion": False,
        },
        "next_required_object": "Independently verify this certificate packet, then adopt canonical G3AP.",
    }
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP fiber2 Hilbert candidate certification: PASS "
        f"leaders={len(leaders)} monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
