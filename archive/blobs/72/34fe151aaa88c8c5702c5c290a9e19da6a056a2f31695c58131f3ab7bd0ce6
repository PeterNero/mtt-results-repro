#!/usr/bin/env python3
"""Certify and retire the first component-16 checkpoint recovery basis."""

from __future__ import annotations

import hashlib
import json
import re
from pathlib import Path


ROOT = Path(__file__).resolve().parent
G3EQ = ROOT / "evidence/ust_g3eq/H02.component16.independent_rows.json"
G3ET = ROOT / "evidence/ust_g3et/H02.component16.checkpoint_recovery_rows.json"
INVALID_KERNEL = (
    ROOT
    / "evidence/ust_g3et/rejected_free_basis/H02.component16.exact_kernel.recovered.nfk"
)
EXACT_MAP = (
    ROOT
    / "evidence/ust_g3eu/rejected_free_basis/H02.component16.exact_residual_map.no_rank.nfr"
)
STDOUT = (
    ROOT
    / "evidence/ust_g3eu/rejected_free_basis/H02.component16.exact_audit_replay.stdout.log"
)
CAMPAIGN = (
    ROOT
    / "evidence/ust_g3eu/rejected_free_basis/H02.component16.modular_residual_campaign.json"
)
OUTPUT = ROOT / "state/ust_g3eu_component16_recovery_basis_mismatch_audit.packet.json"

RELATIONS = 21
WRONG_FREE_COLUMNS = tuple(range(986, 1007))
CORRECTED_FREE_COLUMNS = (
    1199,
    1200,
    1201,
    1202,
    1204,
    1205,
    1206,
    1207,
    1208,
    1209,
    1210,
    1211,
    1212,
    1213,
    1214,
    1215,
    1216,
    1217,
    1218,
    1219,
    1220,
)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path, *, hash_file: bool = True) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    result: dict[str, object] = {
        "path": path.relative_to(ROOT).as_posix(),
        "bytes": path.stat().st_size,
    }
    if hash_file:
        result["sha256"] = sha256(path)
    return result


def audit_exact_map() -> tuple[list[int], str]:
    digest = hashlib.sha256()
    source_rows: list[int] = []
    with EXACT_MAP.open("rb") as handle:
        header_line = handle.readline()
        digest.update(header_line)
        header = [int(value) for value in header_line.split()]
        require(header == [120, RELATIONS, 6, -1], "invalid-map header")
        lines = 0
        for line in handle:
            digest.update(line)
            values = line.split(b" ", 2)
            require(len(values) == 3, "invalid-map line prefix")
            source_row = int(values[0]) - 1
            relation = int(values[1]) - 1
            require(relation == lines % RELATIONS, "invalid-map relation order")
            if relation == 0:
                source_rows.append(source_row)
            else:
                require(source_rows[-1] == source_row, "invalid-map row grouping")
            lines += 1
    require(lines == 120 * RELATIONS, "invalid-map completeness")
    require(source_rows == sorted(set(source_rows)), "invalid-map source rows")
    return source_rows, digest.hexdigest()


def main() -> None:
    for path in (G3EQ, G3ET, INVALID_KERNEL, EXACT_MAP, STDOUT, CAMPAIGN):
        require(path.is_file(), f"required input exists: {path.name}")

    g3eq = json.loads(G3EQ.read_text(encoding="utf-8"))
    g3et = json.loads(G3ET.read_text(encoding="utf-8"))
    campaign = json.loads(CAMPAIGN.read_text(encoding="utf-8"))
    selected = set(
        int(value)
        for value in g3eq["specialization"]["selected_source_rows_zero_based"]
    )
    omitted = set(range(1238)) - selected
    require((len(selected), len(omitted)) == (1200, 38), "subsystem partition")

    source_rows, exact_map_hash = audit_exact_map()
    stdout = STDOUT.read_text(encoding="utf-8")
    match = re.search(
        r"NONZERO checked=(\d+) defects=(\d+) slots=(\d+).*source_rows=([0-9,]+)",
        stdout,
    )
    require(match is not None, "native audit summary")
    checked, defects, slots = map(int, match.groups()[:3])
    stdout_rows = [int(value) - 1 for value in match.group(4).split(",")]
    require((checked, defects, slots) == (438, 120, 2072), "native audit counts")
    require(stdout_rows == source_rows, "native/map defect-row agreement")

    selected_defects = [row for row in source_rows if row in selected]
    omitted_defects = [row for row in source_rows if row in omitted]
    require(len(selected_defects) == 101, "selected-subsystem defect count")
    require(len(omitted_defects) == 19, "omitted-row defect count")
    require(len(selected_defects) + len(omitted_defects) == defects, "defect partition")
    require(tuple(g3et["free_columns_zero_based"]) == CORRECTED_FREE_COLUMNS, "corrected profile")
    require(WRONG_FREE_COLUMNS != CORRECTED_FREE_COLUMNS, "basis profiles differ")
    require(campaign["ranks"] == [4, 4, 4, 4], "rejected campaign ranks")

    packet = {
        "schema": "mtt.unified-source.g3eu-component16-recovery-basis-mismatch-audit.v1",
        "date": "2026-08-14",
        "theorem_id": "UST.G3EU",
        "status": "CLOSED_EXACT_RECOVERY_BASIS_MISMATCH_NOGO",
        "inputs": {
            "G3EQ": record(G3EQ),
            "corrected_G3ET_selection": record(G3ET),
            "rejected_kernel_archive": record(INVALID_KERNEL, hash_file=False),
            "rejected_exact_residual_map": {
                **record(EXACT_MAP, hash_file=False),
                "sha256": exact_map_hash,
            },
            "rejected_native_audit_stdout": record(STDOUT),
            "rejected_modular_campaign": record(CAMPAIGN),
        },
        "basis_mismatch": {
            "incorrect_imposed_free_columns_zero_based": list(WRONG_FREE_COLUMNS),
            "corrected_standard_free_columns_zero_based": list(CORRECTED_FREE_COLUMNS),
            "shared_cardinality": RELATIONS,
            "profiles_equal": False,
        },
        "exact_counterexample": {
            "audited_rows": checked,
            "defect_rows": defects,
            "nonzero_residual_slots": slots,
            "selected_subsystem_defect_rows": len(selected_defects),
            "omitted_defect_rows": len(omitted_defects),
            "selected_subsystem_defect_rows_zero_based": selected_defects,
            "omitted_defect_rows_zero_based": omitted_defects,
        },
        "adjudication": {
            "recovered_archive_is_a_kernel_of_the_selected1200_row_subsystem": False,
            "four_rank_omitted_slice_is_promotable": False,
            "reason": (
                "A candidate kernel must annihilate all 1200 selected subsystem rows. "
                "The displayed archive fails 101 of them exactly. Its four-rank "
                "omitted-row specializations therefore describe only a slice of a "
                "rejected candidate and cannot bound the true component rank."
            ),
            "corrective_action": (
                "Recover again with the standard free-column profile, then replay the "
                "400-row selected complement and all 38 omitted rows before any rank "
                "promotion."
            ),
        },
        "checks": {
            "exact_residual_map_is_complete": True,
            "native_summary_matches_the_exact_map": True,
            "101_selected_subsystem_failures_reject_the_candidate": True,
            "the_wrong_and_corrected_free_profiles_are_distinct": True,
            "the_rank_four_omitted_slice_is_retired_as_a_proof_source": True,
        },
        "guardrails": {
            "claims_component16_characteristic_zero_rank": False,
            "claims_global_H02_upper5085": False,
            "claims_the_corrected_recovery_has_completed": False,
            "claims_a_physical_endpoint": False,
        },
        "next_required_object": (
            "Complete the corrected exact 800x800 recovery, replay all selected and "
            "omitted equations, and only then adjudicate the residual rank."
        ),
    }
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print(
        "UST.G3EU recovery-basis mismatch audit: PASS "
        "selected_defects=101 omitted_defects=19 rejected_rank4_slice=true"
    )


if __name__ == "__main__":
    main()
