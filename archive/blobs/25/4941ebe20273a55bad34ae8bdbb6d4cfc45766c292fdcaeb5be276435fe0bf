            }
        },
        "leading_ideal": {
            "method": {
                "hilbert": "selected_source_direct_Hmajor_Ltrunc_Hilbert_guided_polynomial_module_upper_bound_squeezed_by_selected_R1_lower_bound_in_Cox_degree_18_2_2",
                "sba": "selected_source_direct_Hmajor_Ltrunc_SBA_polynomial_module_upper_bound_squeezed_by_selected_R1_lower_bound_in_Cox_degree_18_2_2",
                "sba_warm_hilbert": "selected_source_direct_Hmajor_Ltrunc_SBA_warm_Hilbert_guided_polynomial_module_upper_bound_squeezed_by_selected_R1_lower_bound_in_Cox_degree_18_2_2",
            }[candidate_engine],
            "candidate_engine": source["candidate_engine"],
            "Cox_functional": "9H+L",
            "permutation": source["permutation"],
            "module_generator_count": 39,
            "explicit_truncation_generator_count": 165,
            "target_reduction_set_size": source["execution"]["certified_reduction_set_size"],
            "target_effective_reducer_count": source["execution"]["target_effective_reducer_count"],
            "weighted_scalar_degree_bound": selected_runner.TARGET_SCALAR_DEGREE,
            "certified_module_cache": source["execution"]["certified_module_cache"],
            "full_standard_basis_claimed": False,
