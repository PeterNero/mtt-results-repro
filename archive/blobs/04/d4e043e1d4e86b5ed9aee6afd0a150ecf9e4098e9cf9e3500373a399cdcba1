        "rank_and_determinant_are_computed_exactly_over_GF11": True,
        "the_G3CC_selected_H02_source_is_embedded_in_the_last248_target_rows": True,
        "the_1510_by1510_affine_coefficient_operator_is_emitted": True,
        "the_homogeneous_coordinate_has_zero_derivative": True,
