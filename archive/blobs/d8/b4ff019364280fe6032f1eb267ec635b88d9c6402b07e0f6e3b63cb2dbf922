def selected_fiber2_reduction() -> dict[str, object]:
    reduction = _selected_fiber2_reduction()
    if "coverage" not in reduction:
        reduction["coverage"] = {
            "kind": "scalar_prefix",
            "Cox_functional": reduction.get("Cox_functional", "H+L"),
            "valid_through_scalar_degree": reduction["valid_through_scalar_degree"],
        }
    reduction["fiber_coordinates"] = selected_fiber2_coordinates()
    return reduction


def require_response_target_coverage(reduction: dict[str, object]) -> None:
    """Reject a cache that does not cover every G3AM/G3AN target product."""
    coverage = reduction["coverage"]
    if coverage["kind"] == "scalar_prefix":
        if int(coverage["valid_through_scalar_degree"]) < int(
            reduction.get(
                "maximum_target_scalar_degree",
                TARGET_RESPONSE_H_PLUS_L_DEGREE,
            )
        ):
            raise AssertionError("reduction scalar prefix misses response target")
        return
    if (
        coverage.get("kind") != "exact_Cox_target"
        or coverage.get("Cox_degree") != TARGET_RESPONSE_COX_DEGREE
        or coverage.get("H_plus_L_scalar_degree")
        != TARGET_RESPONSE_H_PLUS_L_DEGREE
    ):
        raise AssertionError("reduction exact Cox target scope")
    honly_scope = {
        "computational_H_degree": honly.TARGET_H_DEGREE,
        "zero_L_weights_are_proof_premise": False,
    }
    hmajor_direct_scope = {
        "computational_Cox_functional": "9H+L",
        "computational_scalar_degree": hmajor_direct.TARGET_SCALAR_DEGREE,
        "Hilbert_hint_is_proof_premise": False,
    }
    functional_scope = {
        "base_quotient_target_coordinates": 39726,
        "exact_quotient_rank": 1,
        "functional_replay_is_proof_premise": True,
    }
    detail = {
        key: value
        for key, value in coverage.items()
        if key not in ("kind", "Cox_degree", "H_plus_L_scalar_degree")
    }
    if detail not in (honly_scope, hmajor_direct_scope, functional_scope):
        raise AssertionError("reduction exact Cox target execution scope")


def response_reduction_basis(reduction: dict[str, object]) -> dict[str, object]:
    """Return the canonical packet record for a response reduction cache."""
    require_response_target_coverage(reduction)
    return {
        "kind": reduction["kind"],
        "coverage": reduction["coverage"],
        "valid_through_scalar_degree": reduction["valid_through_scalar_degree"],
        "maximum_reduced_scalar_degree": int(
            reduction.get(
                "maximum_target_scalar_degree",
                TARGET_RESPONSE_H_PLUS_L_DEGREE,
            )
        ),
        "Cox_functional": reduction.get("Cox_functional", "H+L"),
        "is_full_standard_basis": reduction.get("is_full_standard_basis", True),
        "component_coordinates": reduction["fiber_coordinates"],
    }
