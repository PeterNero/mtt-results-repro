        name = generator["name"]
        generator_degree = tuple(int(value) for value in generator["Cox_degree"])
        multiplier_degree = tuple(
            TARGET_DEGREE[index] - generator_degree[index] for index in range(3)
        )
        multiplier_count = len(macaulay.monomials_of_cox_degree(multiplier_degree))
        term_count = len(generator["terms"])
        block_nonzeros = multiplier_count * term_count
        changed = name in changed_names
        if changed:
            changed_columns += multiplier_count
            exact_update_nonzeros += multiplier_count * int(exact_counts[name])
            good_update_nonzeros += multiplier_count * int(good_counts[name])
        blocks.append(
            {
                "generator": name,
                "generator_Cox_degree": list(generator_degree),
                "multiplier_Cox_degree": list(multiplier_degree),
                "multiplier_columns": multiplier_count,
                "generator_terms_at_B89": term_count,
                "base_matrix_nonzero_entries": block_nonzeros,
                "changed_by_G3BI_family": changed,
                "exact_family_derivative_terms": int(exact_counts[name]) if changed else 0,
                "good_reduction_family_derivative_terms": int(good_counts[name]) if changed else 0,
