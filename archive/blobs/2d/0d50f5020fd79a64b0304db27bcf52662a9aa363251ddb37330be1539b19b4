    {"coefficient": -1, "elliptic_winding": [0, 1], "sheet_index": 0, "thimble_index": 17},
    {"coefficient": 1, "elliptic_winding": [0, 1], "sheet_index": 0, "thimble_index": 26},
    {"coefficient": -1, "elliptic_winding": [0, 1], "sheet_index": 0, "thimble_index": 27},
    {"coefficient": 1, "elliptic_winding": [0, 1], "sheet_index": 0, "thimble_index": 28},
]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def main() -> None:
    paths = {"B87": B87, "selected_gamma": SELECTED, "gamma_product": PRODUCT}
    require(
        {name: sha256(path) for name, path in paths.items()} == EXPECTED_HASHES,
        "vendored source hashes",
    )
    b87 = load(B87)
    selected = load(SELECTED)
    product = load(PRODUCT)
    require(all(b87["checks"].values()), "B87 checks")
    require(all(selected["checks"].values()), "selected gamma checks")
    require(all(product["checks"].values()), "gamma product checks")

    chain = selected["selected_chain"]
    require(chain["support"] == EXPECTED_SUPPORT, "selected four-thimble support")
    require(chain["product_pairing"] == 1, "selected product pairing")
    require(
        product["ambient_product_chain"]["support"] == EXPECTED_SUPPORT
        and product["ambient_product_chain"]["boundary"] == [0, 0, 0, 0],
        "closed product support",
    )
    require(
        product["pairing_certificate"]["delta_dot_gamma"]
        == product["pairing_certificate"]["u_A_dot_u_B"]
        == product["pairing_certificate"]["product_pairing"]
        == 1,
        "pairing factorization",
    )
    require(math.gcd(*(abs(row["coefficient"]) for row in EXPECTED_SUPPORT)) == 1, "primitive support")
    require(
        product["compact_dual_consequence"]["finite_integral_eta9_tube_combination_exists"]
        and product["compact_dual_consequence"]["selected_transgression_index"] == 1,
        "B87 finite unit transgression consequence",
