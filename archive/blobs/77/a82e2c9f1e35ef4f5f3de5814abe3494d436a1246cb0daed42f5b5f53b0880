def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"packet exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def evaluate_at_prime(
    records: list[dict[str, object]], gamma: int, prime: int
) -> sparse.csr_matrix:
    """Evaluate a Z[gamma] sparse matrix at the requested finite place."""
    result: sparse.csr_matrix | None = None
    power = 1
    for row in records:
        matrix = sparse.load_npz(ROOT / str(row["path"])).tocsr().astype(np.int64)
        result = matrix * power if result is None else result + matrix * power
        power = power * gamma % prime
    require(result is not None, "nonempty coefficient record")
    result.data %= prime
    result.eliminate_zeros()
    return result


def normalize_at_prime(matrix: sparse.spmatrix, prime: int) -> sparse.csc_matrix:
    """Canonicalize a sparse matrix without importing another fiber's modulus."""
    value = matrix.tocsc().astype(np.int64)
    value.sum_duplicates()
    value.data %= prime
    value.eliminate_zeros()
    return value.astype(np.uint32)


