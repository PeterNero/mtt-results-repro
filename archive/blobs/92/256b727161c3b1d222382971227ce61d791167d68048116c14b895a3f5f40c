CALIBRATION_PRIME = 11
CALIBRATION_ROOT = 3


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    repository = repository.resolve()
    try:
        relative = resolved.relative_to(repository)
    except ValueError:
        repository = next(
            (
                candidate
                for candidate in (resolved.parent, *resolved.parents)
                if (candidate / ".git").exists()
            ),
            resolved.parent,
        )
        relative = resolved.relative_to(repository)
    return {
        "repository": repository.name,
        "repository_path": str(repository),
        "repository_relative_path": relative.as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def signed(value: int, modulus: int) -> int:
    value %= modulus
    return value if value <= modulus // 2 else value - modulus


def write_unit_rhs(path: Path, prime: int, row: int, exporter: Any) -> None:
    exporter.write_rhs(path, prime, action.DIMENSION, [0, 1], [row], [1])


def run_determinant(
    solver: Path, chart_path: Path, rhs_path: Path, log_path: Path, mld: Path
) -> tuple[int, str]:
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(chart_path),
        "--rhs",
        runtime.wsl_path(rhs_path),
        "--log",
        runtime.wsl_path(log_path),
        "--determinant-only",
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    fields = initializer.parse_log(log_path)
    require(fields.get("STATUS") == "SUCCESS", "determinant solver status")
    return int(fields["CHART_DETERMINANT"]), completed.stdout.strip()


def determinant_record(
    prime: int,
    root: int,
    chart: sparse.csc_matrix,
    construction: dict[str, int],
    quotient_row: int,
    exporter: Any,
    solver: Path,
    mld: Path,
) -> dict[str, Any]:
    stem = f"H02.p{prime}.g{root}.G3BI_endpoint"
    chart_path = EVIDENCE / f"{stem}.chart.bin"
    rhs_path = EVIDENCE / f"{stem}.unit.rhs.bin"
    log_path = EVIDENCE / f"{stem}.determinant.log"
    prior_chart_hash = sha256(chart_path) if chart_path.is_file() else None
    prior_fields = initializer.parse_log(log_path) if log_path.is_file() else {}
    exporter.write_chart(
        chart_path,
        prime,
        action.DIMENSION,
        action.QUOTIENT_UNITS,
        action.IMAGE_RANK,
        chart.indptr.astype(np.uint64).tolist(),
        chart.indices.astype(np.uint32).tolist(),
        chart.data.astype(np.uint32).tolist(),
    )
    write_unit_rhs(rhs_path, prime, quotient_row, exporter)
    if (
        prior_chart_hash == sha256(chart_path)
        and prior_fields.get("STATUS") == "SUCCESS"
        and prior_fields.get("PRIME") == str(prime)
        and prior_fields.get("ROWS") == str(action.DIMENSION)
    ):
        determinant = int(prior_fields["CHART_DETERMINANT"])
        solver_stdout = "reused hash-identical exact determinant checkpoint"
    else:
        determinant, solver_stdout = run_determinant(
            solver, chart_path, rhs_path, log_path, mld
        )
    require(0 < determinant < prime, "nonzero split-root determinant")
    return {
        "gamma_root": root,
        "construction": construction,
        "endpoint_chart": record(chart_path),
        "unit_RHS": record(rhs_path),
        "solver_log": record(log_path),
        "endpoint_determinant": determinant,
        "solver_stdout": solver_stdout,
    }


def main() -> None:
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_CRT_reconstruction_probe_v2 as crt
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    g3bi_path = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
    g3bk_path = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"
    g3bt_path = ROOT / "state" / "ust_g3bt_h02_endpoint_action_one_split_prime.packet.json"
    g3bi = load(g3bi_path)
    g3bk = load(g3bk_path)
    g3bt = load(g3bt_path)
    for packet, label in ((g3bi, "G3BI"), (g3bk, "G3BK"), (g3bt, "G3BT")):
        require(all(packet["checks"].values()), f"{label} checks")

    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H02.packet.json"
    csc_path = mld / "q79_eta9_original_jacobian_macaulay_H02_csc.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H02.packet.json"
    macaulay = load(macaulay_path)
    csc = load(csc_path)
    factor = load(factor_path)
    for packet, label in ((macaulay, "Macaulay"), (csc, "CSC"), (factor, "factor")):
        require(all(packet["checks"].values()), f"{label} checks")
    base_packet = load(oracle.BASE)
    global_f0 = load(oracle.GLOBAL_F0)
    b89 = load(oracle.B89)
    generators0, _, _ = oracle.exact_generators(base_packet, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = [int(value) for value in csc["binary"]["quotient_unit_rows"]]
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    require(len(target_lookup) == action.DIMENSION, "H02 target dimension")
    require(len(quotient_rows) == action.QUOTIENT_UNITS, "H02 quotient units")
    require(len(descriptors) == action.IMAGE_RANK, "H02 image rank")
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"]["minimal_polynomial_coefficients_ascending"]
    ]
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    EVIDENCE.mkdir(parents=True, exist_ok=True)

    per_prime: list[dict[str, Any]] = []
    coefficient_residues: list[list[int]] = []
    root_packet_records: list[dict[str, Any]] = []
    for prime_index, prime in enumerate(PRIMES, start=1):
        residue_path = (
            mld
            / "eta9_split_prime_H11_residues"
            / f"H11.physical_H20_to_H11.p{prime}.packet.json"
        )
        residue = load(residue_path)
        require(all(residue["checks"].values()), f"split-root packet p={prime}")
        roots = [int(value) for value in residue["field"]["roots_of_selected_sextic"]]
        require(len(roots) == len(set(roots)) == 6, f"six roots p={prime}")
        require(
            all(arithmetic.evaluate(minpoly, root, prime) == 0 for root in roots),
            f"selected roots p={prime}",
        )
        root_packet_records.append(external_record(residue_path, mld))
        print(f"G3BU prime {prime_index}/{len(PRIMES)}: p={prime}", flush=True)
        root_records: list[dict[str, Any]] = []
        determinants: list[int] = []
        for root_index, root in enumerate(roots, start=1):
            print(f"G3BU p={prime} root {root_index}/6 gamma={root}", flush=True)
            if prime == action.PRIME:
                source = next(
                    row for row in g3bt["root_solves"] if int(row["gamma_root"]) == root
                )
                determinant = int(source["endpoint_determinant_mod21817"])
                root_record = {
                    "gamma_root": root,
                    "construction": source["construction"],
                    "endpoint_chart": source["endpoint_chart"],
                    "unit_RHS": None,
                    "solver_log": source["solver_log"],
                    "endpoint_determinant": determinant,
                    "solver_stdout": "reused independently verified G3BT determinant",
                }
            else:
                chart, construction = action.endpoint_chart(
                    prime,
                    root,
                    g3bi,
                    macaulay,
                    factor,
                    quotient_rows,
                    descriptors,
                    generators0,
                    target_lookup,
                    oracle,
                    exporter,
                )
                root_record = determinant_record(
                    prime,
                    root,
                    chart,
                    construction,
                    quotient_rows[0],
                    exporter,
                    solver,
                    mld,
                )
                determinant = int(root_record["endpoint_determinant"])
                del chart
            require(0 < determinant < prime, f"nonzero determinant p={prime} root={root}")
            determinants.append(determinant)
            root_records.append(root_record)
            print(
                f"G3BU p={prime} gamma={root}: determinant={determinant}", flush=True
            )
        coefficients = arithmetic.interpolate(roots, determinants, prime)
        require(
            all(
                arithmetic.evaluate(coefficients, root, prime) == determinant
                for root, determinant in zip(roots, determinants, strict=True)
            ),
            f"determinant interpolation p={prime}",
        )
        coefficient_residues.append(coefficients)
        per_prime.append(
            {
                "prime": prime,
                "roots": roots,
                "determinants_at_roots": determinants,
                "determinant_power_basis_coefficients_mod_prime": coefficients,
                "root_solves": root_records,
            }
        )
        checkpoint = EVIDENCE / f"H02.p{prime}.determinant-coefficients.json"
        checkpoint.write_text(
            json.dumps(per_prime[-1], indent=2, ensure_ascii=True) + "\n", encoding="ascii"
        )

    holdout_tests: list[dict[str, Any]] = []
    for prefix_length in range(1, len(PRIMES)):
        prefix_primes = PRIMES[:prefix_length]
        holdout_prime = PRIMES[prefix_length]
        modulus = math.prod(prefix_primes)
        candidates: list[int] = []
        matches: list[bool] = []
        for degree in range(6):
            value, checked_modulus = crt.crt_scalar(
                [row[degree] for row in coefficient_residues[:prefix_length]],
                prefix_primes,
            )
            require(checked_modulus == modulus, "CRT prefix modulus")
            candidate = signed(value, modulus)
            candidates.append(candidate)
            matches.append(candidate % holdout_prime == coefficient_residues[prefix_length][degree])
        holdout_tests.append(
            {
                "prefix_primes": prefix_primes,
                "prefix_modulus": modulus,
                "prefix_modulus_bits": modulus.bit_length(),
                "holdout_prime": holdout_prime,
                "signed_coefficient_candidates": candidates,
                "coefficient_matches": matches,
                "holdout_matches": sum(matches),
            }
        )
    full_modulus = math.prod(PRIMES)
    full_candidates: list[int] = []
    for degree in range(6):
        value, checked_modulus = crt.crt_scalar(
            [row[degree] for row in coefficient_residues], PRIMES
        )
        require(checked_modulus == full_modulus, "full CRT modulus")
        full_candidates.append(signed(value, full_modulus))

    checks = {
        "all_eight_primes_are_completely_split_for_the_selected_sextic": True,
        "all48_selected_H02_endpoint_determinants_are_nonzero": all(
            value != 0 for row in per_prime for value in row["determinants_at_roots"]
        ),
        "all_eight_degree_less_than_six_determinant_residues_interpolate_exactly": True,
        "every_proper_prime_prefix_is_tested_against_the_next_independent_prime": True,
        "no_CRT_candidate_is_promoted_without_holdout_stability_and_a_height_bound": True,
    }
    require(all(checks.values()), "G3BU checks")
    packet = {
        "schema": "mtt.unified-source.g3bu-h02-endpoint-determinant-crt-campaign.v1",
        "date": "2026-08-12",
        "status": "EXACT_H02_ENDPOINT_DETERMINANT_CRT_CAMPAIGN_COMPLETE_PROMOTION_PENDING_BOUND",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
            "G3BI": record(g3bi_path),
            "G3BK": record(g3bk_path),
            "G3BT": record(g3bt_path),
            "H02_Macaulay": external_record(macaulay_path, mld),
            "H02_CSC": external_record(csc_path, mld),
            "H02_factorization": external_record(factor_path, mld),
            "three_block_oracle": external_record(oracle.OUT, mld),
            "base": external_record(oracle.BASE, mld),
            "global_F0": external_record(oracle.GLOBAL_F0, mld),
            "B89": external_record(oracle.B89, mld),
            "split_prime_solver": external_record(solver, mld),
            "split_root_packets": root_packet_records,
        },
        "selected_chart": {
            "block": "H02",
            "dimension": action.DIMENSION,
            "coefficient_field": "Q(gamma)",
            "minimal_polynomial_coefficients_ascending": minpoly,
        },
        "prime_residues": per_prime,
        "CRT": {
            "primes": PRIMES,
            "full_modulus": full_modulus,
            "full_modulus_bits": full_modulus.bit_length(),
            "holdout_tests": holdout_tests,
            "full_signed_coefficient_candidates": full_candidates,
            "latest_prefix_holdout_matches": holdout_tests[-1]["holdout_matches"],
            "exact_promotion": False,
            "missing_promotion_certificate": (
                "a proved coefficient-height bound below half the stable CRT modulus, "
                "or an independent exact determinant relation"
            ),
        },
        "checks": checks,
        "guardrails": {
            "claims_centered_CRT_is_the_characteristic_zero_determinant": False,
            "claims_determinant_cleared_H02_adjugate_action": False,
            "claims_characteristic_zero_H02_inverse_action": False,
            "claims_integral_parallel_transport_or_terminal_readout": False,
        },
        "theorem": {
            "name": "ustG3buH02EndpointDeterminantCrtCampaign",
            "tier": "CLOSED_EXACT_MULTIPRIME_DETERMINANT_SCREEN_PROMOTION_OPEN",
            "statement": (
                "The selected G3BI H02 endpoint determinant is evaluated at all 48 roots of "
                "eight independent completely split primes. Each six-root interpolation is exact "
                "and every proper prime prefix is tested against the next prime. Centered CRT "
                "representatives remain nonpromotable without the displayed holdout and bound rule."
            ),
        },
        "next_required_object": (
            "If the final prefix is not stable, add split primes only to these six determinant "
            "coordinates. Once stable, prove a coefficient-height bound or exact relation, then "
            "multiply the modular G3BT actions by the certified determinant and reconstruct the "
            "integral adjugate-action coefficients before any Q(gamma) promotion."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3BU H02 endpoint determinant CRT campaign: PASS", flush=True)
    print(
        f"primes={len(PRIMES)} roots=48 full_modulus_bits={full_modulus.bit_length()} "
        f"latest_holdout_matches={holdout_tests[-1]['holdout_matches']}/6",
        flush=True,
    )
    print(f"full_candidates={full_candidates}", flush=True)
    print(f"packet_sha256={sha256(OUT)}", flush=True)


if __name__ == "__main__":
    main()
