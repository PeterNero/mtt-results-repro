#!/usr/bin/env python3
"""Assemble D1 and prove the selected full-response Schur rank over F_101^6."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re

import assemble_ust_g3am_selected_cayley_principal_response as g3am_math
import build_ust_g3am_selected_cayley_fiber2_response_chunk as response_chunk
import build_ust_g3ad_fixed_fq_second_h_graph_obstruction as g3ad
import build_ust_g3ak_full_graph_incidence_normal_decomposition as g3ak
import ust_cayley_fiber2_reduction as fiber2


ROOT = Path(__file__).resolve().parent
CHUNK_DIR = ROOT / "state" / "g3am_cayley_fiber2_response_chunks"
G3AL_PACKET = ROOT / "state" / "ust_g3al_selected_carrier_response_schur.packet.json"
G3AM_PACKET = ROOT / "state" / "ust_g3am_selected_cayley_principal_response.packet.json"
OUT = ROOT / "state" / "ust_g3an_selected_cayley_full_response_schur.packet.json"
BUNDLE = ROOT / "state" / "ust_g3an_selected_cayley_full_response_schur.f101e6.u8"
P = 101
DEGREE = 6
Element = g3ad.Element


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked_artifact(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"{label} exists")
    require(sha256(path) == record["sha256"], f"{label} hash")
    return path


def canonical_hash(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def transpose(matrix: list[list[Element]]) -> list[list[Element]]:
    return [list(row) for row in zip(*matrix)]


def dot(left: list[Element], right: list[Element], ring: g3ad.QuotientRing) -> Element:
    result = ring.zero
    for a, b in zip(left, right):
        result = ring.add(result, ring.mul(a, b))
    return result


def matvec(
    matrix: list[list[Element]], vector: list[Element], ring: g3ad.QuotientRing
) -> list[Element]:
    return [dot(row, vector, ring) for row in matrix]


def inverse_matrix(
    matrix: list[list[Element]], ring: g3ad.QuotientRing
) -> list[list[Element]]:
    size = len(matrix)
    require(size > 0 and all(len(row) == size for row in matrix), "square inverse")
    augmented = [
        list(row)
        + [ring.one if row_index == column else ring.zero for column in range(size)]
        for row_index, row in enumerate(matrix)
    ]
    reduced, pivots = g3ak.rref(augmented, ring)
    require(pivots[:size] == list(range(size)), "invertible matrix")
    require(
        all(
            reduced[row][column] == (ring.one if row == column else ring.zero)
            for row in range(size)
            for column in range(size)
        ),
        "inverse identity block",
    )
    return [row[size:] for row in reduced]


def decode_matrix(path: Path, shape: tuple[int, int, int]) -> list[list[Element]]:
    rows, columns, degree = shape
    require(degree == DEGREE, "extension degree")
    raw = path.read_bytes()
    require(len(raw) == rows * columns * degree, "matrix byte size")
    matrix = []
    offset = 0
    for _ in range(rows):
        row = []
        for _ in range(columns):
            row.append(tuple(raw[offset : offset + degree]))
            offset += degree
        matrix.append(row)
    require(offset == len(raw), "matrix fully decoded")
    return matrix


def append_matrix(
    payload: bytearray,
    records: dict[str, dict],
    name: str,
    matrix: list[list[Element]],
) -> None:
    rows = len(matrix)
    columns = len(matrix[0]) if matrix else 0
    require(all(len(row) == columns for row in matrix), f"rectangular {name}")
    start = len(payload)
    for row in matrix:
        for value in row:
            payload.extend(value)
    records[name] = {
        "shape": [rows, columns, DEGREE],
        "byte_offset": start,
        "byte_length": len(payload) - start,
        "canonical_sha256": canonical_hash(
            [[list(value) for value in row] for row in matrix]
        ),
    }


def multiply(
    left: list[list[Element]],
    right: list[list[Element]],
    ring: g3ad.QuotientRing,
) -> list[list[Element]]:
    require(left and right and len(left[0]) == len(right), "matrix product dimensions")
    right_columns = transpose(right)
    return [[dot(row, column, ring) for column in right_columns] for row in left]


def main() -> None:
    g3al = load(G3AL_PACKET)
    g3am = load(G3AM_PACKET)
    reduction = fiber2.selected_fiber2_reduction()
    reduction_scope = fiber2.response_reduction_basis(reduction)
    require(g3am["theorem_id"] == "UST.G3AM", "G3AM theorem id")
    require(g3am["principal_response"]["rank"] == 33, "selected rank(D0)=33")
    require(
        g3am["inputs"]["selected_G3AP_certificate"] == reduction["certificate"]
        and g3am["inputs"]["selected_G3AP_source_certificate"]
        == reduction["source_certificate"],
        "same canonical G3AP reduction",
    )
    field = g3al["residue_field"]
    relation = [int(value) for value in field["gamma_relation_coefficients_ascending"]]
    require(field["prime"] == P and field["extension_degree"] == DEGREE, "selected field")
    ring = g3ad.QuotientRing(P, relation)
    functional_route = reduction["module_cache_record"] is None
    if functional_route:
        checked_artifact(
            reduction["quotient_functional_record"],
            "selected fiber-two quotient functional",
        )
    else:
        checked_artifact(
            reduction["module_cache_record"], "selected fiber-two module cache"
        )
    if reduction["base_cache_record"] is not None:
        checked_artifact(reduction["base_cache_record"], "selected fiber-two base cache")

    d0_artifact = g3am["principal_response"]["binary_artifact"]
    d0_path = ROOT / d0_artifact["path"]
    require(d0_path.is_file() and sha256(d0_path) == d0_artifact["sha256"], "D0 artifact")
    d0 = decode_matrix(d0_path, (248, 33, DEGREE))
    pivot_rows = [int(value) for value in g3am["principal_response"]["independent_row_indices_zero_based"]]
    require(len(pivot_rows) == 33, "D0 pivot rows")
    pivot_set = set(pivot_rows)
    quotient_rows = [row for row in range(248) if row not in pivot_set]
    r0_inverse = inverse_matrix([d0[row] for row in pivot_rows], ring)

    cells: dict[tuple[int, int], Element] = {}
    chunk_records: dict[str, dict] = {}
    for path in sorted(CHUNK_DIR.glob("*.packet.json")):
        packet = load(path)
        rectangle = packet.get("rectangle", {})
        if (
            int(rectangle.get("column_start_zero_based", -1)) != 33
            or int(rectangle.get("column_count", -1)) != 89
        ):
            continue
        require(
            packet["schema"]
            == "mtt.unified-source.g3am-selected-cayley-fiber2-response-chunk.v1",
            f"chunk schema {path.name}",
        )
        require(
            packet["status"]
            == "CLOSED_EXACT_SELECTED_CARRIER_FIBER2_RESIDUE_RECTANGLE",
            f"chunk status {path.name}",
        )
        require(all(packet["checks"].values()), f"chunk checks {path.name}")
        require(packet["inputs"]["G3AL"]["sha256"] == sha256(G3AL_PACKET), f"chunk G3AL {path.name}")
        require(
            packet["inputs"]["G3AP"] == reduction["certificate"]
            and packet["inputs"]["G3AP_source"] == reduction["source_certificate"],
            f"chunk G3AP {path.name}",
        )
        require(
            all(
                packet["reduction_basis"].get(key) == value
                for key, value in reduction_scope.items()
            ),
            f"chunk reduction scope {path.name}",
        )
        if functional_route:
            require(
                packet["inputs"]["module_cache"] is None,
                f"chunk no module cache {path.name}",
            )
            checked_artifact(
                packet["inputs"]["quotient_functional"],
                f"chunk quotient functional {path.name}",
            )
            require(
                packet["inputs"]["quotient_functional"]["sha256"]
                == reduction["quotient_functional_record"]["sha256"],
                f"chunk selected quotient functional {path.name}",
            )
        else:
            checked_artifact(
                packet["inputs"]["module_cache"],
                f"chunk module cache {path.name}",
            )
            require(
                packet["inputs"]["module_cache"]["sha256"]
                == reduction["module_cache_record"]["sha256"],
                f"chunk selected module cache {path.name}",
            )
        if reduction["base_cache_record"] is None:
            require(packet["inputs"]["base_cache"] is None, f"chunk no base cache {path.name}")
        else:
            require(
                packet["inputs"]["base_cache"]["sha256"]
                == reduction["base_cache_record"]["sha256"],
                f"chunk base cache {path.name}",
            )
        checked_artifact(packet["script"], f"chunk script {path.name}")
        output_path = checked_artifact(packet["output"], f"chunk output {path.name}")
        output = None
        packed_rows = rectangle.get("entries_F1016_packed")
        if functional_route:
            require(
                isinstance(packed_rows, list), f"chunk packed rows {path.name}"
            )
            replayed, replayed_terms = response_chunk.replay_functional_output(
                output_path,
                int(rectangle["row_count"]),
                int(rectangle["column_count"]),
                reduction,
            )
            require(
                replayed == packed_rows
                and replayed_terms == rectangle["exported_base_quotient_terms"],
                f"chunk functional transcript {path.name}",
            )
        else:
            output = output_path.read_text(encoding="utf-8")
            require("G3AM_F2_RESPONSE_CHUNK_PASS" in output, f"chunk pass {path.name}")
        row_start = int(rectangle["row_start_zero_based"])
        rows = rectangle["entries_F1016_singular"]
        require(len(rows) == int(rectangle["row_count"]), f"chunk height {path.name}")
        for local_row, row in enumerate(rows):
            require(len(row) == 89, f"chunk width {path.name}")
            if functional_route:
                require(
                    len(packed_rows[local_row]) == 89
                    and [
                        response_chunk.packed_to_singular(value)
                        for value in packed_rows[local_row]
                    ]
                    == row,
                    f"functional packed row identity {path.name}:{local_row}",
                )
            else:
                match = re.search(
                    rf"^G3AM_F2_RESPONSE_ROW_{row_start + local_row}=([^\r\n]*)$",
                    output,
                    flags=re.MULTILINE,
                )
                require(
                    match is not None and match.group(1).split(",") == row,
                    f"raw row {path.name}",
                )
            for local_column, raw_value in enumerate(row):
                cell = (row_start + local_row, local_column)
                require(cell not in cells, f"duplicate D1 cell {cell}")
                cells[cell] = g3am_math.field_value(raw_value, ring)
        chunk_records[path.name] = {
            "path": str(path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(path),
            "status": packet["status"],
        }

    expected = {(row, column) for row in range(248) for column in range(89)}
    require(set(cells) == expected, f"complete 248x89 coverage, got {len(cells)} cells")
    d1 = [[cells[(row, column)] for column in range(89)] for row in range(248)]

    def n0(vector: list[Element]) -> list[Element]:
        coordinates = matvec(r0_inverse, [vector[row] for row in pivot_rows], ring)
        return [
            ring.sub(vector[row], dot(d0[row], coordinates, ring))
            for row in quotient_rows
        ]

    require(
        all(all(value == ring.zero for value in n0(column)) for column in transpose(d0)),
        "N0 D0=0",
    )
    e_columns = [n0(column) for column in transpose(d1)]
    e = transpose(e_columns)
    _, e_column_pivots = g3ak.rref(e, ring)
    e_rank = len(e_column_pivots)
    _, e_row_pivots = g3ak.rref(transpose(e), ring)
    require(len(e_row_pivots) == e_rank, "E row and column rank")
    full_rank = 33 + e_rank

    n0_operator: list[list[Element]] = []
    for row in quotient_rows:
        coefficients = [
            dot(d0[row], [r0_inverse[index][column] for index in range(33)], ring)
            for column in range(33)
        ]
        operator_row = [ring.zero] * 248
        operator_row[row] = ring.one
        for position, pivot_row in enumerate(pivot_rows):
            operator_row[pivot_row] = ring.neg(coefficients[position])
        n0_operator.append(operator_row)
    require(multiply(n0_operator, d0, ring) == [[ring.zero] * 33 for _ in range(215)], "explicit N0D0")
    require(multiply(n0_operator, d1, ring) == e, "explicit E=N0D1")

    e0_inverse: list[list[Element]] = []
    final_rows: list[int] = []
    l_operator: list[list[Element]] = []
    if e_rank == 89:
        e0_inverse = inverse_matrix([e[row] for row in e_row_pivots], ring)
        e_pivot_set = set(e_row_pivots)
        final_rows = [row for row in range(215) if row not in e_pivot_set]
        for row in final_rows:
            coefficients = [
                dot(e[row], [e0_inverse[index][column] for index in range(89)], ring)
                for column in range(89)
            ]
            operator_row = [ring.zero] * 215
            operator_row[row] = ring.one
            for position, pivot_row in enumerate(e_row_pivots):
                operator_row[pivot_row] = ring.neg(coefficients[position])
            l_operator.append(operator_row)
        require(len(final_rows) == 126, "final normal dimension")
        require(multiply(l_operator, e, ring) == [[ring.zero] * 89 for _ in range(126)], "L E=0")

    payload = bytearray()
    layout: dict[str, dict] = {}
    append_matrix(payload, layout, "D1_extra_response", d1)
    append_matrix(payload, layout, "E_N0D1", e)
    append_matrix(payload, layout, "N0_principal_quotient", n0_operator)
    append_matrix(payload, layout, "R0_inverse", r0_inverse)
    if e_rank == 89:
        append_matrix(payload, layout, "L_extra_quotient", l_operator)
        append_matrix(payload, layout, "E0_inverse", e0_inverse)
    BUNDLE.write_bytes(payload)
    checks = {
        "G3AM_selected_principal_rank33_is_hash_current": True,
        "all_22072_extra_products_map_to_the_same_selected_one_dimensional_top_quotient": True,
        "all_extra_chunks_cover_each_248x89_cell_exactly_once": True,
        "N0_has_shape215x248_and_annihilates_D0": True,
        "E_equals_N0_times_D1_exactly": True,
        "E_row_rank_equals_E_column_rank": True,
        "rank_D_equals_33_plus_rank_E": True,
        "rank89_emits_a_rank126_factored_left_normal_if_and_only_if_available": (
            (e_rank == 89 and len(l_operator) == 126)
            or (e_rank < 89 and not l_operator)
        ),
        "the_emitted_L_annihilates_E_when_rank_E_is89": e_rank < 89 or bool(l_operator),
        "no_GF11_response_entry_is_imported": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    require(all(checks.values()), "full response checks")
    packet = {
        "schema": "mtt.unified-source.g3an-selected-cayley-full-response-schur.v1",
        "date": "2026-08-11",
        "theorem_id": "UST.G3AN",
        "status": (
            "CLOSED_EXACT_SELECTED_CARRIER_FULL_RESPONSE_RANK122_OVER_F1016"
            if e_rank == 89
            else f"CLOSED_EXACT_SELECTED_CARRIER_FULL_RESPONSE_RANK{full_rank}_OVER_F1016"
        ),
        "inputs": {
            "G3AL": {"path": str(G3AL_PACKET.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(G3AL_PACKET)},
            "G3AM": {"path": str(G3AM_PACKET.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(G3AM_PACKET)},
            "selected_G3AP_certificate": reduction["certificate"],
            "selected_G3AP_source_certificate": reduction["source_certificate"],
            **{f"chunk_{Path(name).stem}": record for name, record in chunk_records.items()},
        },
        "residue_field": field,
        "reduction_basis": reduction_scope,
        "full_response_schur": {
            "D0_shape": [248, 33],
            "D1_shape": [248, 89],
            "E_shape": [215, 89],
            "rank_D0": 33,
            "rank_E": e_rank,
            "rank_D": full_rank,
            "full_left_nullity": 248 - full_rank,
            "principal_pivot_rows_zero_based": pivot_rows,
            "principal_quotient_rows_zero_based": quotient_rows,
            "extra_pivot_rows_in_principal_quotient_zero_based": e_row_pivots if e_rank == 89 else [],
            "final_normal_rows_in_principal_quotient_zero_based": final_rows,
            "binary_artifact": {
                "path": str(BUNDLE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BUNDLE),
                "bytes": len(payload),
                "layout": layout,
            },
        },
        "checks": checks,
        "theorem": {
            "name": "selectedCarrierFullCayleyResponseSchurRankTheorem",
            "tier": (
                "CLOSED_EXACT_SELECTED_FINITE_RESIDUE_FULL_RESPONSE_RANK122"
                if e_rank == 89
                else "CLOSED_EXACT_SELECTED_FINITE_RESIDUE_FULL_RESPONSE_WITH_RANK_DEFECT"
            ),
            "statement": (
                "On the same hash-certified selected F_101^6 Cayley carrier, the exact extra response D1 is quotiented by the proven rank-33 principal image. The emitted E=N0D1 has the displayed rank, so rank(D)=33+rank(E). When rank(E)=89, the emitted factored operators N0 and L prove full response rank 122 and a rank-126 left normal. This is a finite selected-residue statement; characteristic-zero transport and beta_C remain separate."
            ),
        },
        "parameter_ledger": {"new_continuous_fit_parameters": 0, "new_discrete_fit_parameters": 0, "accepted_physical_knobs": 0},
        "guardrails": {
            "claims_characteristic_zero_rank_promotion": False,
            "claims_beta_C_is_computed": False,
            "claims_Nfull_beta_C_is_zero": False,
            "claims_the_Hull_Strominger_endpoint_is_closed": False,
            "imports_GF11_response_values": False,
        },
        "next_required_object": (
            "Promote the selected finite-residue response through the required characteristic-zero/toric comparison, emit beta_C from the same selected Deligne source in the 248-row basis, and evaluate L*N0*beta_C exactly."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        f"UST.G3AN selected full response: PASS rank(D0)=33 rank(E)={e_rank} "
        f"rank(D)={full_rank} left_nullity={248-full_rank}"
    )


if __name__ == "__main__":
    main()
