from __future__ import annotations

import hashlib
import json
import os
import struct
import sys
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3cn_pole_six_family_transform_first_jet.packet.json"
PRIME = 11


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def resolve_mld() -> Path:
    configured = os.environ.get("MTT_MLD_REPO")
    candidates = ([Path(configured)] if configured else []) + [
        ROOT.parent / "20 Mathematical Language Discovery Program",
        ROOT.parent / "Mathematical Language Discovery Program",
    ]
    for candidate in candidates:
        if (candidate / "q79_eta9_targeted_original_jacobian_macaulay_schedule.packet.json").is_file():
            return candidate.resolve()
    raise FileNotFoundError("Mathematical Language Discovery Program repository")


def checked_local(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"local artifact {record['path']}")
    require(sha256(path) == record["sha256"], f"local hash {record['path']}")
    return path


def checked_external(record: dict[str, Any], repository: Path) -> Path:
    require(record["repository"] == repository.name, "external repository name")
    path = repository / record["repository_relative_path"]
    require(path.is_file(), f"external artifact {record['repository_relative_path']}")
    require(sha256(path) == record["sha256"], f"external hash {record['repository_relative_path']}")
    return path


def read_rhs(path: Path) -> sparse.csc_matrix:
    raw = path.read_bytes()
    require(raw[:8] == b"MTTRHS1\0", "RHS magic")
    rows, columns, nonzeros = struct.unpack_from("<3Q", raw, 8)
    offset = 8 + 3 * 8
    indptr = np.frombuffer(raw, dtype="<u8", count=columns + 1, offset=offset)
    offset += indptr.nbytes
    indices = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset)
    offset += indices.nbytes
    data = np.frombuffer(raw, dtype=np.uint8, count=nonzeros, offset=offset)
    offset += data.nbytes
    require(offset == len(raw), "RHS byte count")
    return sparse.csc_matrix(
        (data.copy(), indices.copy(), indptr.astype(np.int64)),
        shape=(rows, columns),
    )


def normalized(matrix: sparse.spmatrix) -> sparse.csc_matrix:
    result = matrix.tocsc().astype(np.int32)
    result.sum_duplicates()
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def residual_nonzeros(left: sparse.spmatrix, right: sparse.spmatrix) -> int:
    return int(normalized(left.astype(np.int32) - right.astype(np.int32)).nnz)


def main() -> None:
    mld = resolve_mld()
    sys.path.insert(0, str(mld))
    import verify_q79_eta9_original_jacobian_coordinate_solver as solver_io

    packet = load(PACKET)
    require(packet["schema"] == "mtt.unified-source.g3cn-pole-six-family-transform-first-jet.v1", "schema")
    require(packet["theorem_id"] == "UST.G3CN", "theorem id")
    require(packet["status"] == "CLOSED_EXACT_POLE_SIX_THIRTY_CHART_WOODBURY_ATLAS_AND_GF11_FIRST_JET", "status")
    require(all(packet["checks"].values()), "packet checks")
    require(len(packet["groups"]) == 30, "thirty groups")
    require(packet["woodbury_atlas"]["selected_Groebner_generators"] == 225, "225 selected generators")
    checked_local(packet["inputs"]["G3BI"])
    checked_external(packet["inputs"]["targeted_transform_schedule"], mld)

    total_active = 0
    total_exact_update_nonzeros = 0
    total_good_update_nonzeros = 0
    total_quotient_nonzeros = 0
    groups_with_quotient: list[int] = []
    maximum_core = 0
    for row in packet["groups"]:
        index = int(row["group_index"])
        if index == 0:
            require(row["active_update_columns"] == 0, "group zero update")
            require(row["first_jet_quotient_nonzero_entries"] == 0, "group zero quotient jet")
            continue

        group_path = checked_external(row["inputs"]["group"], mld)
        factor_path = checked_external(row["inputs"]["factorization"], mld)
        old_coordinate_path = checked_external(row["inputs"]["old_coordinates"], mld)
        group = load(group_path)
        require(all(group["checks"].values()), f"group {index} checks")
        factor_packet = load(
            mld
            / "eta9_targeted_original_jacobian_macaulay_groups"
            / f"group_{index:02d}.factor.packet.json"
        )
        require(sha256(factor_path) == factor_packet["inputs"]["factorization_binary"]["sha256"], f"factor {index} binding")

        update = sparse.load_npz(
            checked_local(row["artifacts"]["family_update_mod11"])
        ).tocsc()
        rhs = read_rhs(checked_local(row["artifacts"]["first_jet_rhs"]))
        first_jet, jet_q, jet_rank = solver_io.read_coordinates(
            checked_local(row["artifacts"]["first_jet_coordinates"])
        )
        old_coordinates, old_q, old_rank = solver_io.read_coordinates(old_coordinate_path)
        log_path = checked_local(row["artifacts"]["solver_log"])
        require("SUCCESS" in log_path.read_text(encoding="utf-8"), f"group {index} solver success")

        quotient_units = int(row["quotient_units"])
        image_rank = int(factor_packet["dimensions"]["certified_image_rank"])
        require((old_q, old_rank) == (quotient_units, image_rank), f"group {index} old split")
        require((jet_q, jet_rank) == (quotient_units, image_rank), f"group {index} jet split")
        require(update.shape == (int(row["ambient_dimension"]), image_rank), f"group {index} update shape")
        require(rhs.shape[1] == int(row["selected_generators"]), f"group {index} RHS columns")
        require(update.nnz == int(row["good_reduction_update_nonzero_entries"]), f"group {index} update nnz")

        independent_rhs = normalized(
            -(update.astype(np.int32) @ old_coordinates[quotient_units:, :].astype(np.int32))
        )
        require(residual_nonzeros(independent_rhs, rhs) == 0, f"group {index} differentiated RHS")

        matrix_path = (
            mld
            / "eta9_targeted_original_jacobian_macaulay_groups"
            / f"group_{index:02d}.macaulay.npz"
        )
        require(sha256(matrix_path) == group["Macaulay_matrix"]["sha256"], f"group {index} matrix hash")
        matrix = sparse.load_npz(matrix_path).tocsc()
        selected_columns = np.asarray(
            factor_packet["selected_original_Jacobian_matrix_columns_zero_based"],
            dtype=np.int64,
        )
        quotient_rows = np.asarray(
            group["Macaulay_matrix"]["quotient_unit_rows_zero_based"],
            dtype=np.int32,
        )
        quotient = sparse.csc_matrix(
            (
                np.ones(quotient_units, dtype=np.uint8),
                (quotient_rows, np.arange(quotient_units, dtype=np.int32)),
            ),
            shape=(matrix.shape[0], quotient_units),
        )
        chart = sparse.hstack([quotient, matrix[:, selected_columns]], format="csc")
        require(
            residual_nonzeros(
                normalized(chart.astype(np.int32) @ first_jet.astype(np.int32)),
                rhs,
            )
            == 0,
            f"group {index} first-jet replay",
        )

        quotient_nonzeros = int(first_jet[:quotient_units, :].nnz)
        require(quotient_nonzeros == int(row["first_jet_quotient_nonzero_entries"]), f"group {index} quotient count")
        if quotient_nonzeros:
            groups_with_quotient.append(index)
        active = int(row["active_update_columns"])
        total_active += active
        maximum_core = max(maximum_core, active)
        total_exact_update_nonzeros += int(row["exact_update_nonzero_entries_over_Q_gamma"])
        total_good_update_nonzeros += int(update.nnz)
        total_quotient_nonzeros += quotient_nonzeros

    atlas = packet["woodbury_atlas"]
    require(total_active == int(atlas["total_active_update_columns"]), "total active columns")
    require(maximum_core == int(atlas["maximum_core_dimension_upper_bound"]), "maximum core")
    require(total_exact_update_nonzeros == int(atlas["total_exact_update_nonzero_entries_over_Q_gamma"]), "exact update total")
    require(total_good_update_nonzeros == int(atlas["total_good_reduction_update_nonzero_entries"]), "good update total")
    require(groups_with_quotient == packet["first_jet"]["groups_with_nonzero_quotient_jet"], "quotient group list")
    require(total_quotient_nonzeros == int(packet["first_jet"]["total_quotient_jet_nonzero_entries"]), "quotient total")
    require(len(groups_with_quotient) == 28 and total_quotient_nonzeros == 15211, "decisive quotient result")
    print("UST.G3CN independent verifier: PASS")
    print(
        f"groups=30 active_columns={total_active} max_core={maximum_core} "
        f"quotient_groups={len(groups_with_quotient)} quotient_nnz={total_quotient_nonzeros}"
    )


if __name__ == "__main__":
    main()
