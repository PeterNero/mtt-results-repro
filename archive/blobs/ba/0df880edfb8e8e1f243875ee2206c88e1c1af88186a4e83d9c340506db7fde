def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    path, repository = path.resolve(), repository.resolve()
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (left, middle, degree - left - middle)
        for left in range(degree + 1)
        for middle in range(degree - left + 1)
    ]


def sparse_matrix(
    entries: dict[tuple[int, int], int], shape: tuple[int, int]
) -> sparse.csc_matrix:
    triples = [(row, column, value) for (row, column), value in entries.items() if value]
    if not triples:
        return sparse.csc_matrix(shape, dtype=np.int64)
    rows, columns, values = zip(*sorted(triples), strict=True)
    return sparse.csc_matrix(
        (np.asarray(values, dtype=np.int64), (rows, columns)), shape=shape
    )


def run_rank_tool(matrix_path: Path, certificate_path: Path) -> tuple[int, str]:
    arguments = [
        sys.executable, str(RANK_TOOL), str(matrix_path),
        "--certificate", str(certificate_path),
    ]
    completed = subprocess.run(
        arguments, cwd=ROOT, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
    )
    require(completed.returncode == 0, f"exact number-field rank: {completed.stdout[-2000:]}")
    match = re.search(r"\brank=(\d+)\b", completed.stdout)
    require(match is not None, "exact number-field rank marker")
    return int(match.group(1)), completed.stdout


def write_number_field_matrix(
    path: Path,
    entries: dict[tuple[int, int], tuple[int, ...]],
    minimal: list[int],
) -> None:
    degree = len(minimal) - 1
    path.write_text(
        f"{PRESENTATION_ROWS} {PRESENTATION_COLUMNS} {degree} {len(entries)}\n"
        + " ".join(str(value) for value in minimal)
        + "\n"
        + "\n".join(
            f"{row + 1} {column + 1} "
            + " ".join(str(value) for value in coefficients)
            for (row, column), coefficients in sorted(entries.items())
        )
        + "\n",
        encoding="ascii",
        newline="\n",
    )


def base_dv_action(
    lift: sparse.csc_matrix,
    descriptors: list[tuple[int, tuple[int, ...]]],
    target_lookup: dict[tuple[int, ...], int],
    complement_lookup: dict[int, int],
) -> sparse.csc_matrix:
    entries: dict[tuple[int, int], int] = defaultdict(int)
    coo = lift.tocoo()
    for coordinate, source, value in zip(coo.row, coo.col, coo.data, strict=True):
        generator, multiplier = descriptors[int(coordinate)]
        require(generator == 8, "lift lies in dPhi/dv block")
        for variable in (4, 5, 6):
            exponent = list(multiplier)
            exponent[variable] += 3
            ambient = target_lookup[tuple(exponent)]
            entries[(complement_lookup[ambient], int(source))] += int(value)
    return sparse_matrix(entries, (COMPLEMENT_DIMENSION, PRESENTATION_COLUMNS))


