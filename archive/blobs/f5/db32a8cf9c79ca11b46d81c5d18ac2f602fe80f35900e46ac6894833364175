            "Luscher anomaly-free chiral lattice regularization"
            in external_names
        ),
        "Lieb_Robinson_uniform_locality_tool_registered": (
            "Nachtergaele-Sims Lieb-Robinson bounds"
            in external_names
        ),
        "Sokal_Borel_uniqueness_registered": (
            "Sokal Borel uniqueness theorem" in external_names
        ),
    }

    # Exact finite compact-gauge witness. The Z2 representation is only the
    # smallest executable model of Haar reduction; the theorem below applies
    # to every finite-rank compact-G representation, including the declared
    # q79 Standard-Model carrier at a chosen external regulator.
    witness_dimension = 4
    gauge_unitary = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(-1),
            Fraction(-1),
        ]
    )
    gauss_projector = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(0),
            Fraction(0),
        ]
    )
    matrix_units = []
    for row in range(witness_dimension):
        for column in range(witness_dimension):
            unit = zeros(witness_dimension, witness_dimension)
            unit[row][column] = Fraction(1)
            matrix_units.append(unit)

    def gauge_conjugate(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return mul(
            mul(gauge_unitary, observable),
            transpose(gauge_unitary),
        )

    def haar_reynolds(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1, 2),
            add(observable, gauge_conjugate(observable)),
        )

    fixed_matrix_units = [
        unit
        for unit in matrix_units
        if gauge_conjugate(unit) == unit
    ]
    vectorized_fixed_units = [
        [
            fixed_matrix_units[column][row // witness_dimension][
                row % witness_dimension
            ]
            for column in range(len(fixed_matrix_units))
        ]
        for row in range(witness_dimension**2)
    ]

    free_hamiltonian = diagonal(
        [
            Fraction(0),
            Fraction(1),
            Fraction(2),
            Fraction(3),
        ]
    )
    interaction_hamiltonian = zeros(
        witness_dimension,
        witness_dimension,
    )
    interaction_hamiltonian[0][1] = Fraction(1)
    interaction_hamiltonian[1][0] = Fraction(1)
    interaction_hamiltonian[2][3] = Fraction(2)
    interaction_hamiltonian[3][2] = Fraction(2)
    witness_fixed_coupling = Fraction(1, 3)
    fixed_coupling_hamiltonian = add(
        free_hamiltonian,
        scale(
            witness_fixed_coupling,
            interaction_hamiltonian,
        ),
    )

    rotation_two = [
