import re
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_qring.sing"
OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_qring.singular.out"
BASE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qring_base.ssi"
MODULE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qring_module_degree44.ssi"
PACKET = STATE / "ust_g3ap_selected_cayley_fiber2_qring.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def derivative_generators() -> list[str]:
    generators = []
    for variable in ("x", "y", "z", "w"):
        dk = f"dK_{variable}"
        dc = f"dC_{variable}"
        generators.extend(
            (
                f"{dk}*gen(1)+{dc}*gen(3)",
                f"{dk}*gen(2)+{dc}*gen(5)",
                f"{dk}*gen(3)+{dc}*gen(6)",
            )
        )
    for variable in ("t0", "t1", "t2"):
        de = f"dE_{variable}"
        dc = f"dC_{variable}"
        generators.extend(
            (
                f"{de}*gen(2)+{dc}*gen(3)",
                f"{de}*gen(4)+{dc}*gen(5)",
                f"{de}*gen(5)+{dc}*gen(6)",
            )
        )
    require(len(generators) == 21, "21 derivative generators")
    return generators


def derivative_representatives() -> tuple[str, str]:
    before = []
    after = []
    for equation, variables in (
        ("K", ("x", "y", "z", "w")),
        ("E", ("t0", "t1", "t2")),
        ("C", ("x", "y", "z", "w", "t0", "t1", "t2")),
    ):
        for variable in variables:
            name = f"d{equation}_{variable}"
            source_name = f"r_{name}"
            before.append(f"poly {source_name}=diff({equation},{variable});")
            after.append(f"poly {name}=imap(r,{source_name});")
    return "\n".join(before), "\n".join(after)


def qring_script(source: str) -> str:
    generators = ",\n  ".join(derivative_generators())
    representatives_before, representatives_after = derivative_representatives()
    return fiber2.selected_base_prefix(source) + f'''option(noredTail);
{representatives_before}
ideal I0=K,E,C;
