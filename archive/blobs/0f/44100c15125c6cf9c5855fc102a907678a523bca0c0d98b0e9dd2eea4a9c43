#!/usr/bin/env python3
"""Adopt the certified degree-44 computation as canonical UST.G3AP."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
BOUNDED = ROOT / "state" / "ust_g3ap_selected_cayley_bounded_top.packet.json"
OUT = ROOT / "state" / "ust_g3ap_selected_cayley_ordinary_top_dimension.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    source = json.loads(BOUNDED.read_text(encoding="ascii"))
    require(
        source["schema"] == "mtt.unified-source.g3ap-selected-cayley-bounded-top.v1",
        "bounded schema",
    )
    require(
        source["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_DIMENSION_ONE",
        "bounded status",
    )
    require(all(source["checks"].values()), "bounded checks")
    require(not any(source["guardrails"].values()), "bounded guardrails")
    checked(source["inputs"]["selected_source"], "selected source")
    checked(source["execution"]["script"], "bounded script")
    checked(source["execution"]["output"], "bounded output")
    checked(source["execution"]["bounded_basis_cache"], "bounded cache")
    top = source["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["scalar_weight"] == 44
        and top["enumerated_monomials"] == 174865
        and top["dimension"] == 1
        and top["basis"] == ["w^12*t2^4*s^2"],
        "selected top line",
    )
    checks = {
        "selected_bounded_top_certificate_is_hash_current": True,
        "homogeneous_standard_basis_is_complete_through_scalar_degree_44": True,
        "all_174865_Cox_degree_18_2_2_monomials_are_enumerated": True,
        "standard_monomials_are_decided_by_exact_leading_ideal_divisibility": True,
        "the_selected_ordinary_top_piece_has_dimension_one": True,
        "its_unique_basis_is_w12_t2_4_s2": True,
        "no_full_basis_is_claimed_or_needed_for_this_degree": True,
        "no_GF11_leading_monomial_is_imported": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1",
        "date": "2026-08-10",
        "theorem_id": "UST.G3AP",
        "status": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_SOCLE_DIMENSION_ONE",
        "inputs": {
            "bounded_top": {
                "path": str(BOUNDED.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BOUNDED),
            }
        },
        "leading_ideal": {
            "method": "homogeneous_standard_basis_truncated_through_scalar_degree_44",
            "basis_size": source["execution"]["leading_basis_size_through_bound"],
            "scalar_degree_bound": 44,
            "export_script": source["execution"]["script"],
            "raw_output": source["execution"]["output"],
            "bounded_basis_cache": source["execution"]["bounded_basis_cache"],
            "full_standard_basis_claimed": False,
        },
        "ordinary_top_piece": top,
        "checks": checks,
        "guardrails": {
            "claims_toric_R1_survival_without_G3AO": False,
            "claims_characteristic_zero_rank_promotion": False,
            "claims_beta_C_is_computed": False,
        },
        "theorem": {
            "name": "selectedCayleyOrdinaryTopDimensionTheorem",
            "tier": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_ONE",
            "statement": (
                "For the selected F_101^6 Cayley member, the homogeneous weighted "
                "standard basis complete through scalar degree 44 leaves exactly "
                "w^12*t2^4*s^2 among all 174,865 monomials of Cox degree (18,2,2)."
            ),
        },
        "next_required_object": (
            "Execute the principal and direct Schur response blocks with the same "
            "degree-44-complete cache, then apply G3AQ to the resulting unit minor."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print("UST.G3AP bounded top adopted as canonical ordinary top dimension one")


if __name__ == "__main__":
    main()
