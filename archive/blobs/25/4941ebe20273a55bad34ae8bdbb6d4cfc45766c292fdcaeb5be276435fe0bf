            "claims_scalar_prefix_coverage": False,
            "claims_characteristic_zero_rank_promotion": False,
            "claims_beta_C_is_computed": False,
        },
        "theorem": {
            "name": "selectedCayleyOrdinaryTopDimensionByDirectHmajorLtruncatedLeadingSqueezeTheorem",
            "tier": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_ONE",
            "statement": (
                "For the selected F_101^6 Cayley member, a direct 39-generator "
                "fiber-degree-two ordinary-Jacobian module with 165 target-external "
                "L boundaries leaves at most one class in Cox degree (18,2,2). "
