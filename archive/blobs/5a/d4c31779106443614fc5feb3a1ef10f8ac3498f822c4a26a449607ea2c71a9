            "claims_beta_C_is_defined_or_evaluated_on_the_ball": False,
            "claims_beta_C_has_a_zero": False,
            "claims_MTT_selects_one_member": False,
            "claims_visible_twisted_V3_or_HYM": False,
            "closes_B_ETA9_01": False,
            "closes_B_ETA9_02": False,
            "closes_B_HS_01": False,
