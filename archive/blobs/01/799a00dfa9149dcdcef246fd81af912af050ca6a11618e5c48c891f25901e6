    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    CERTIFICATE.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print(
        "UST.G3FJ K3 normal matrix factorization: PASS "
        "K3=r*rbar+q*H4 H4_terms=13 source_coordinates=6"
    )


def source_polynomial(
    coefficients: list[list[int]],
    theta: int,
    coordinate: int,
    x: sp.Symbol,
    y: sp.Symbol,
    z: sp.Symbol,
    w: sp.Symbol,
) -> sp.Poly:
    offset = 83 * theta
    expression = sum(
        int(coefficients[offset + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(g3ff_runtime.source_monomials(9))
    )
    expression += w * sum(
        int(coefficients[offset + 55 + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(g3ff_runtime.source_monomials(6))
    )
    return sp.Poly(expression, x, y, z, w, domain=sp.ZZ)


