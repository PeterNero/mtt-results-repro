#!/usr/bin/env python3
"""Independently replay the G3FI ambient root-ideal normal-pair certificate."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import numpy as np
import sympy as sp


ROOT = Path(__file__).resolve().parent
CERTIFICATE = ROOT / "evidence/ust_g3fi/H02.component20.root_ideal_normal_pair.json"
G3BI = ROOT / "state/ust_g3bi_explicit_root_start.packet.json"
EXPECTED_STATUS = (
    "CLOSED_EXACT_AMBIENT_ROOT_IDEAL_NORMAL_PAIR_NORMAL_JET_HOMOTOPY_OPEN"
)
G3_TERMS = {
    (3, 0, 0): -2,
    (2, 0, 1): -2,
    (1, 2, 0): 1,
    (1, 1, 1): 1,
    (1, 0, 2): 2,
    (0, 3, 0): -1,
    (0, 1, 2): -2,
    (0, 0, 3): -1,
}


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def monomials(degree: int) -> list[tuple[int, int, int]]:
    return [
        (a, b, degree - a - b)
        for a in reversed(range(degree + 1))
        for b in reversed(range(degree - a + 1))
    ]


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (a, b, degree - a - b)
        for a in range(degree + 1)
        for b in range(degree - a + 1)
    ]


def source(
    coefficients: list[list[int]], theta: int, coordinate: int
) -> sp.Poly:
    x, y, z, w = sp.symbols("x y z w")
    offset = 83 * theta
    expression = sum(
        int(coefficients[offset + local][coordinate])
        * x**exponent[0]
        * y**exponent[1]
        * z**exponent[2]
        for local, exponent in enumerate(monomials(9))
    )
    expression += w * sum(
        int(coefficients[offset + 55 + local][coordinate])
        * x**exponent[0]
        * y**exponent[1]
        * z**exponent[2]
        for local, exponent in enumerate(monomials(6))
    )
    return sp.Poly(expression, x, y, z, w, domain=sp.ZZ)


def polynomial_from_rows(
    rows: np.ndarray, coordinate: int, degree: int
) -> sp.Poly:
    x, y, z = sp.symbols("x y z")
    return sp.Poly(
        sum(
            int(rows[local, coordinate])
            * x**exponent[0]
            * y**exponent[1]
            * z**exponent[2]
            for local, exponent in enumerate(homogeneous_exponents(degree))
        ),
        x,
        y,
        z,
        domain=sp.ZZ,
    )


def main() -> None:
    certificate = load(CERTIFICATE)
    g3bi = load(G3BI)
    require(certificate["status"] == EXPECTED_STATUS, "status")
    require(all(certificate["checks"].values()), "certificate checks")
    require(not any(certificate["guardrails"].values()), "guardrails")
    require(
        certificate["inputs"]["G3BI"]["sha256"] == sha256(G3BI), "G3BI hash"
    )

    artifact_row = certificate["exact_ambient_normal_pair"]["normal_pair_artifact"]
    artifact = ROOT / artifact_row["path"]
    require(artifact.is_file(), "normal-pair artifact")
    require(sha256(artifact) == artifact_row["sha256"], "normal-pair hash")
    data = np.load(artifact, allow_pickle=False)
    b6_rows = data["B6_gamma_coordinates"].astype(np.int64)
    d7_rows = data["D7_gamma_coordinates"].astype(np.int64)
    require(b6_rows.shape == (28, 6), "B6 shape")
    require(d7_rows.shape == (36, 6), "D7 shape")
    require(
        np.array_equal(
            data["degree6_exponents"], np.asarray(homogeneous_exponents(6))
        ),
        "degree6 order",
    )
    require(
        np.array_equal(
            data["degree7_exponents"], np.asarray(homogeneous_exponents(7))
        ),
        "degree7 order",
    )

    x, y, z, w = sp.symbols("x y z w")
    q = x * z - y**2
    g3 = sum(
        coefficient * x**exponent[0] * y**exponent[1] * z**exponent[2]
        for exponent, coefficient in G3_TERMS.items()
    )
    coefficients = g3bi["selected_source"]["coefficient_vectors"]
    b_polynomials: list[sp.Poly] = []
    d_polynomials: list[sp.Poly] = []
    for coordinate in range(6):
        delta = source(coefficients, 0, coordinate) - source(
            coefficients, 1, coordinate
        )
        b6 = polynomial_from_rows(b6_rows, coordinate, 6)
        d7 = polynomial_from_rows(d7_rows, coordinate, 7)
        replay = sp.Poly(
            (w + g3) * b6.as_expr() + q * d7.as_expr(),
            x,
            y,
            z,
            w,
            domain=sp.ZZ,
        )
        require(replay == delta, f"ambient identity coordinate {coordinate}")
        restricted = sp.Poly(delta.as_expr().subs(w, -g3), x, y, z, domain=sp.ZZ)
        require(
            restricted == sp.Poly(q * d7.as_expr(), x, y, z, domain=sp.ZZ),
            f"restricted identity coordinate {coordinate}",
        )
        require(
            sp.Poly(delta.as_expr(), w).coeff_monomial(w) == b6.as_expr(),
            f"canonical w coefficient {coordinate}",
        )
        b_polynomials.append(b6)
        d_polynomials.append(d7)

    b_gcd = b_polynomials[0]
    d_gcd = d_polynomials[0]
    for b6, d7 in zip(b_polynomials[1:], d_polynomials[1:], strict=True):
        b_gcd = sp.gcd(b_gcd, b6)
        d_gcd = sp.gcd(d_gcd, d7)
    require(b_gcd.as_expr() == 1, "primitive B6")
    require(d_gcd.as_expr() == 1, "primitive D7")
    require(sp.Poly(w + g3, w).LC() == 1, "r monic in w")
    require(sp.factor(q) == q, "q irreducible")

    layers = tuple(2 * degree + 1 for degree in (15, 13, 11, 9))
    require(layers == (31, 27, 23, 19), "layer dimensions")
    require(sum(layers) == 100 and 100 + 36 == 136, "100+36 split")
    print(
        "UST.G3FI independent verification: PASS "
        "ambient_coordinates=6 layers=31+27+23+19 normal=36"
    )


if __name__ == "__main__":
    main()
