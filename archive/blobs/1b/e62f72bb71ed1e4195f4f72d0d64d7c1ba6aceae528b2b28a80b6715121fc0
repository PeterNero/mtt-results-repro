def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1",
        "packet schema",
    )
    require(packet["theorem_id"] == "UST.G3AP", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    if "bounded_top" in packet["inputs"]:
        verify_bounded(packet)
        return
    if "fiber2_module_top" in packet["inputs"]:
        verify_fiber2(packet)
        return
    if "fiber2_qring_top" in packet["inputs"]:
        verify_fiber2_qring(packet)
        return
    if "fiber2_qring_hilbert_certified_top" in packet["inputs"]:
        verify_fiber2_qring_hilbert_certified(packet)
        return
    if "fiber2_qring_weighted_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_qring_weighted_hilbert_certified(packet)
        return
    if "fiber2_weighted_permuted_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_weighted_permuted_certified(packet)
        return
    if "fiber2_hmajor_direct_ltrunc_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_hmajor_direct_ltrunc_certified(packet)
        return
    if "target_macaulay_rank_squeeze_certified_top" in packet["inputs"]:
        verify_target_macaulay_rank_squeeze(packet)
        return
    if "fiber2_honly_direct_ltrunc_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_honly_ltrunc_certified(packet, direct=True)
        return
    if "fiber2_honly_ltrunc_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_honly_ltrunc_certified(packet, direct=False)
        return
    if "fiber2_hmajor_ltrunc_leading_squeeze_certified_top" in packet["inputs"]:
        verify_fiber2_hmajor_ltrunc_certified(packet)
        return
    if "fiber2_hilbert_certified_top" in packet["inputs"]:
        verify_fiber2_hilbert_certified(packet)
        return
    for name, record in packet["inputs"].items():
        path = ROOT / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"input {name}")
    leading = packet["leading_ideal"]
    script = ROOT / leading["export_script"]["path"]
    output = ROOT / leading["raw_output"]["path"]
    require(script.is_file() and sha256(script) == leading["export_script"]["sha256"], "script")
    require(output.is_file() and sha256(output) == leading["raw_output"]["sha256"], "output")
    script_text = script.read_text(encoding="ascii")
    require("ring r=(101,g)" in script_text and "ring r=11" not in script_text, "field")
    require(packet["inputs"]["basis_cache"]["path"] in script_text, "cache binding")
    raw = output.read_text(encoding="utf-8")
    require("G3AP_LEADING_EXPONENT_EXPORT_PASS" in raw, "raw pass")
    count = re.search(r"^G3AP_LEADING_EXPONENT_COUNT=(\d+)$", raw, re.MULTILINE)
    require(count is not None, "raw count")
    leaders = [
        tuple(int(item) for item in match.group(1).split(","))
        for match in re.finditer(
            r"^G3AP_LEADING_EXPONENT_\d+=([0-9,]+)$", raw, re.MULTILINE
        )
    ]
    require(len(leaders) == int(count.group(1)) == leading["basis_size"], "all leaders")
    require(all(len(value) == 10 for value in leaders), "leader widths")
    standards = []
    total = 0
    sector_counts = {}
    for u_power in range(3):
        for v_power in range(3 - u_power):
            s_power = 2 - u_power - v_power
            trie = trie_for(leaders, (u_power, v_power, s_power))
            h_degree = 18 + 6 * u_power + 9 * s_power
            l_degree = 2 + 3 * v_power + s_power
            sector_total = 0
            sector_standard = 0
            for w_power in range(h_degree // 3 + 1):
                xyz_degree = h_degree - 3 * w_power
                for x_power in range(xyz_degree + 1):
                    for y_power in range(xyz_degree - x_power + 1):
                        z_power = xyz_degree - x_power - y_power
                        for t0_power in range(l_degree + 1):
                            for t1_power in range(l_degree - t0_power + 1):
                                t2_power = l_degree - t0_power - t1_power
                                exponent = (
                                    x_power, y_power, z_power, w_power,
                                    t0_power, t1_power, t2_power,
                                    u_power, v_power, s_power,
                                )
                                sector_total += 1
                                point = tuple(exponent[index] for index in PROJECTION)
                                if not trie.divides(point):
                                    standards.append(exponent)
                                    sector_standard += 1
            total += sector_total
            sector_counts[f"u{u_power}_v{v_power}_s{s_power}"] = (
                sector_total,
                sector_standard,
            )
    top = packet["ordinary_top_piece"]
    require(total == top["enumerated_monomials"] == 174865, "target enumeration")
    require(standards == [EXPECTED_SOCLE], "unique socle")
    require(top["dimension"] == 1, "top dimension")
    require(top["basis"] == ["w^12*t2^4*s^2"], "top basis")
    require(top["basis_exponent_vectors"] == [list(EXPECTED_SOCLE)], "top exponent")
    for key, (sector_total, sector_standard) in sector_counts.items():
        require(
            top["fiber_sectors"][key]["enumerated_monomials"] == sector_total
            and top["fiber_sectors"][key]["standard_monomials"] == sector_standard,
            f"sector {key}",
        )
    print(
        f"UST.G3AP selected ordinary top line: PASS leaders={len(leaders)} "
        "Cox_monomials=174865 dimension=1"
    )


