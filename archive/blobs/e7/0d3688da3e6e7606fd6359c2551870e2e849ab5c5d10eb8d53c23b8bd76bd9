            "previous_primal_and_adjoint_terminal_ODEs": old_odes,
            "previous_scalar_ODE_unknowns": old_scalars,
            "required_primal_terminal_ODEs": new_odes,
            "required_scalar_ODE_unknowns": new_scalars,
            "exact_reduction_factor_from_rank_one_pair_transport": "2",
            "three_dense_fundamental_matrix_scalar_unknowns": dense_scalars,
            "exact_reduction_factor_from_dense_transport": str(RANK),
        },
        "required_execution_certificate": {
            "same_source_path_bindings": PATHS,
