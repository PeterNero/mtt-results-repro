    packet = load(PACKET_PATH)
    picard = load(PICARD_PATH)
    global_bk3 = load(GLOBAL_BK3_PATH)
    k3 = load(K3_PATH)
    require(
        packet["schema"] == "q79K3RealStructureBK3Kernel.v1",
        "packet schema",
    )
    require(
        packet["sources"]["selected_k3"]["sha256"] == sha256(K3_PATH),
        "selected K3 source hash",
    )
    require(
        packet["sources"]["exact_picard"]["sha256"] == sha256(PICARD_PATH),
        "Picard source hash",
    )
    require(
        packet["sources"]["global_b_K3_cutset"]["sha256"]
        == sha256(GLOBAL_BK3_PATH),
        "global b_K3 source hash",
    )
    x, y, z = sp.symbols("x y z")
    f6 = sp.expand(
        sp.sympify(
            k3["explicit_K3"]["F6_equals_G3_squared_plus_Q2_H4"]
        )
    )
    require(sp.Poly(f6, x, y, z).total_degree() == 6, "source sextic degree")
    require(
        k3["checks"]["plane_branch_sextic_is_projectively_smooth"],
        "source sextic smoothness",
    )
    verify_projection(packet, f6)
    verify_hodge_obstruction(packet, picard, global_bk3)
    require(
        packet["status"] == "CLOSED_EXACT_BK3_LARGE_GAUGE_KERNEL_RANK_ZERO",
        "closed status",
    )
    print("Q79_K3_REAL_STRUCTURE_BK3_KERNEL_VERIFY_PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
