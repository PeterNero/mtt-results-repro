#!/usr/bin/env python3
"""Verify exact reconstruction of the reciprocal G3AO vs F4 inputs."""

from __future__ import annotations

import hashlib
import json

import sympy as sp

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as common
import build_ust_g3ao_selected_cayley_toric_vs_reciprocal_msolve_inputs as builder
import run_ust_g3ao_selected_cayley_toric_regularity as direct


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    packet = json.loads(builder.OUT.read_text(encoding="ascii"))
    require(packet["source_sha256"] == sha256(direct.SOURCE), "selected source")
    require(all(packet["checks"].values()), "input checks")
    polynomials = direct.selected_polynomials()
    g = sp.symbols("g")
    minpoly = sp.Poly(
        sp.sympify(polynomials["minpoly"].replace("^", "**")),
        g,
        modulus=101,
    )
    require(minpoly.degree() == 6 and minpoly.is_irreducible, "irreducible F101 extension")
    for locus in ("smooth", "cusp"):
        record = packet["loci"][locus]
        script = direct.CAMPAIGN / record["export_script"]["path"]
        raw_path = direct.CAMPAIGN / record["raw_output"]["path"]
        input_path = direct.CAMPAIGN / record["input"]["path"]
        require(script.is_file() and sha256(script) == record["export_script"]["sha256"], f"{locus} script")
        require(raw_path.is_file() and sha256(raw_path) == record["raw_output"]["sha256"], f"{locus} raw")
        require(input_path.is_file() and sha256(input_path) == record["input"]["sha256"], f"{locus} input")
        require(
            script.read_text(encoding="ascii") == builder.make_export_script(polynomials, locus),
            f"{locus} exact script",
        )
        raw = raw_path.read_text(encoding="utf-8")
        require("G3AO_MSOLVE_EXPORT_PASS" in raw, f"{locus} marker")
        generators = (
            common.parse_locus(raw, "smooth")
            if locus == "smooth"
            else builder.parse_cusp(raw)
        )
        expected = builder.make_msolve_input(polynomials, generators, locus)
        require(input_path.read_text(encoding="ascii") == expected, f"{locus} exact input")
        require(record["generator_count"] == len(generators) + 1, f"{locus} count")
    print("UST.G3AO vs reciprocal msolve input verifier: PASS")


if __name__ == "__main__":
    main()
