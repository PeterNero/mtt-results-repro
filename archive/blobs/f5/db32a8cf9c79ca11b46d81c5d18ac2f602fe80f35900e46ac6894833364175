def framed_q79_free_dirac_car_net() -> dict[str, Any]:
    zero = (Fraction(0), Fraction(0))
    one = (Fraction(1), Fraction(0))
    minus_one = (Fraction(-1), Fraction(0))
    imag = (Fraction(0), Fraction(1))
    minus_imag = (Fraction(0), Fraction(-1))

    def block_2x2(
        upper_left: list[list[tuple[Fraction, Fraction]]],
        upper_right: list[list[tuple[Fraction, Fraction]]],
        lower_left: list[list[tuple[Fraction, Fraction]]],
        lower_right: list[list[tuple[Fraction, Fraction]]],
    ) -> list[list[tuple[Fraction, Fraction]]]:
        return [
            upper_left[row] + upper_right[row] for row in range(2)
        ] + [
            lower_left[row] + lower_right[row] for row in range(2)
        ]

    zero2 = [[zero, zero], [zero, zero]]
    identity2 = g_eye(2)
    minus_identity2 = g_scale_matrix(minus_one, identity2)
    sigma1 = [[zero, one], [one, zero]]
    sigma2 = [[zero, minus_imag], [imag, zero]]
    sigma3 = [[one, zero], [zero, minus_one]]

    gamma0 = block_2x2(identity2, zero2, zero2, minus_identity2)
    gamma_spatial = [
        block_2x2(
            zero2,
            sigma,
            g_scale_matrix(minus_one, sigma),
            zero2,
        )
        for sigma in (sigma1, sigma2, sigma3)
    ]
    gammas = [gamma0, *gamma_spatial]
    identity4 = g_eye(4)
    zero4 = g_scale_matrix(zero, identity4)

    gamma5 = g_scale_matrix(
        imag,
        g_mul_matrix(
            g_mul_matrix(g_mul_matrix(gamma0, gamma_spatial[0]), gamma_spatial[1]),
            gamma_spatial[2],
        ),
    )
    chirality_plus = g_scale_matrix(
        (Fraction(1, 2), Fraction(0)),
        g_add_matrix(identity4, gamma5),
    )
    chirality_minus = g_scale_matrix(
        (Fraction(1, 2), Fraction(0)),
        g_sub_matrix(identity4, gamma5),
    )

    clifford_checks: dict[str, bool] = {}
    signature = [1, -1, -1, -1]
    for mu, gamma_mu in enumerate(gammas):
        for nu, gamma_nu in enumerate(gammas):
            anticommutator_value = g_add_matrix(
                g_mul_matrix(gamma_mu, gamma_nu),
                g_mul_matrix(gamma_nu, gamma_mu),
            )
            coefficient = 2 * signature[mu] if mu == nu else 0
            expected = g_scale_matrix(
                (Fraction(coefficient), Fraction(0)),
                identity4,
            )
            clifford_checks[f"clifford_{mu}_{nu}"] = (
                anticommutator_value == expected
            )

    p = reynolds_two_copy_s3()
    q = sub(eye(6), p)
    p_complex = g_from_rational_matrix(p)
    q_complex = g_from_rational_matrix(q)
    identity6 = g_eye(6)
    identity24 = g_eye(24)
    p24 = g_kronecker(identity4, p_complex)
    q24 = g_kronecker(identity4, q_complex)
    chirality_plus24 = g_kronecker(chirality_plus, identity6)
    chirality_minus24 = g_kronecker(chirality_minus, identity6)
    gamma24 = [g_kronecker(gamma, identity6) for gamma in gammas]

    lowering = [[zero, one], [zero, zero]]
    parity = [[one, zero], [zero, minus_one]]
    a1 = g_kronecker(lowering, identity2)
    a2 = g_kronecker(parity, lowering)
    a1_star = g_transpose_conjugate(a1)
    a2_star = g_transpose_conjugate(a2)
    identity_car = g_eye(4)

    def anticommutator(
        left: list[list[tuple[Fraction, Fraction]]],
        right: list[list[tuple[Fraction, Fraction]]],
    ) -> list[list[tuple[Fraction, Fraction]]]:
        return g_add_matrix(g_mul_matrix(left, right), g_mul_matrix(right, left))

    def commutator(
        left: list[list[tuple[Fraction, Fraction]]],
        right: list[list[tuple[Fraction, Fraction]]],
    ) -> list[list[tuple[Fraction, Fraction]]]:
        return g_sub_matrix(g_mul_matrix(left, right), g_mul_matrix(right, left))

    number1 = g_mul_matrix(a1_star, a1)
    number2 = g_mul_matrix(a2_star, a2)

    source_rows = source_freshness()["sources"]
    current_source_ids = {
        row["id"] for row in source_rows if row["state"] == "current"
    }
    manifest = json.loads((ROOT / "source_manifest.json").read_text(encoding="utf-8"))
    external_names = {row["name"] for row in manifest["external_theorems"]}

    exact_checks = {
        **clifford_checks,
        "gamma0_hermitian": g_transpose_conjugate(gamma0) == gamma0,
        "spatial_gammas_antihermitian": all(
            g_transpose_conjugate(gamma)
            == g_scale_matrix(minus_one, gamma)
            for gamma in gamma_spatial
        ),
        "gamma5_hermitian": g_transpose_conjugate(gamma5) == gamma5,
        "gamma5_square_identity": g_mul_matrix(gamma5, gamma5) == identity4,
        "gamma5_anticommutes_with_all_gammas": all(
            anticommutator(gamma5, gamma) == zero4 for gamma in gammas
        ),
        "positive_chirality_projector": (
            g_mul_matrix(chirality_plus, chirality_plus) == chirality_plus
            and g_transpose_conjugate(chirality_plus) == chirality_plus
            and g_rank(chirality_plus) == 2
        ),
        "negative_chirality_projector": (
            g_mul_matrix(chirality_minus, chirality_minus) == chirality_minus
            and g_transpose_conjugate(chirality_minus) == chirality_minus
            and g_rank(chirality_minus) == 2
        ),
        "chirality_is_complete_and_orthogonal": (
            g_add_matrix(chirality_plus, chirality_minus) == identity4
            and g_mul_matrix(chirality_plus, chirality_minus) == zero4
        ),
        "q79_spinor_projectors_complete": (
            g_add_matrix(p24, q24) == identity24
            and g_mul_matrix(p24, q24)
            == g_scale_matrix(zero, identity24)
        ),
        "q79_spinor_projector_ranks_8_16": (
            g_rank(p24) == 8 and g_rank(q24) == 16
        ),
        "chiral_q79_ranks_12_12": (
            g_rank(chirality_plus24) == 12
            and g_rank(chirality_minus24) == 12
        ),
        "joint_chiral_pq_ranks_4_8": (
            g_rank(g_mul_matrix(chirality_plus24, p24)) == 4
            and g_rank(g_mul_matrix(chirality_plus24, q24)) == 8
            and g_rank(g_mul_matrix(chirality_minus24, p24)) == 4
            and g_rank(g_mul_matrix(chirality_minus24, q24)) == 8
        ),
        "pq_projectors_commute_with_clifford_action": all(
            commutator(gamma, p24)
            == g_scale_matrix(zero, identity24)
            and commutator(gamma, q24)
            == g_scale_matrix(zero, identity24)
            for gamma in gamma24
        ),
        "two_mode_car_annihilators_anticommute": (
