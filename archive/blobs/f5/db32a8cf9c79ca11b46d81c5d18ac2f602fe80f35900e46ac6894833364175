            formal_bridge["blocker_assessment"][
                "B.QFT.02_interacting_fixed_coupling_Cstar_limit"
            ]
            == "open"
        ),
        "Buchholz_Fredenhagen_fixed_coupling_benchmark_registered": (
            "Buchholz-Fredenhagen dynamical Cstar algebra"
            in external_names
        ),
        "Fermi_dynamical_Cstar_extension_registered": (
            "Brunetti-Duetsch-Fredenhagen-Rejzner Fermi "
            "dynamical Cstar algebra"
            in external_names
