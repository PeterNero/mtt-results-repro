#!/usr/bin/env python3
"""Certify the rational Schur gauge on the open G3BJ transcendental arc."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
OUT = STATE / "ust_g3cf_transcendental_arc_schur_gauge.packet.json"

INPUTS = {
    "G3BJ": STATE / "ust_g3bj_transcendental_arc_path.packet.json",
    "G3BK": STATE / "ust_g3bk_correction_pencil_operator.packet.json",
    "G3BN": STATE / "ust_g3bn_h11_alternate_split_prime_initializer.packet.json",
    "G3BR": STATE / "ust_g3br_h02_alternate_split_prime_initializer.packet.json",
    "G3CA": STATE / "ust_g3ca_selected_delta_correction_h02_source.packet.json",
    "G3CE": STATE / "ust_g3ce_hodge_schur_affine_reduction.packet.json",
}


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def main() -> None:
    packets = {name: load(path) for name, path in INPUTS.items()}
    g3bj = packets["G3BJ"]
    g3bk = packets["G3BK"]
    g3bn = packets["G3BN"]
    g3br = packets["G3BR"]
    g3ca = packets["G3CA"]
    g3ce = packets["G3CE"]

    require(g3bj["schema"] == "mtt.unified-source.g3bj-transcendental-arc-path.v1", "G3BJ schema")
    require(g3bk["schema"] == "mtt.unified-source.g3bk-correction-pencil-operator.v1", "G3BK schema")
    require(g3bn["schema"] == "mtt.unified-source.g3bn-h11-alternate-split-prime-initializer.v1", "G3BN schema")
    require(g3br["schema"] == "mtt.unified-source.g3br-h02-alternate-split-prime-initializer.v1", "G3BR schema")
    require(g3ca["schema"] == "mtt.unified-source.g3ca-selected-delta-correction-h02-source.v1", "G3CA schema")
    require(g3ce["schema"] == "mtt.unified-source.g3ce-hodge-schur-affine-reduction.v1", "G3CE schema")
    for name, packet in packets.items():
        require(all(packet["checks"].values()), f"{name} checks")
        require(not any(packet["guardrails"].values()), f"{name} guardrails")

    path = g3bj["selected_path"]
    require(path["formula"] == "a(t)=1-t+i*pi*t*(1-t)", "selected path formula")
    require(path["orientation"].startswith("t increases from G3BI start at a=1"), "path orientation")
    require(g3bj["checks"]["every_interior_selected_path_parameter_is_transcendental"], "interior transcendence")
    require(g3bk["checks"]["all_three_frozen_charts_avoid_poles_on_the_open_transcendental_arc"], "parent chart coverage")
    chart = g3bk["all_block_interior_chart_avoidance"]
    require(chart["blocks"] == ["H20", "H11", "H02"], "three parent blocks")
    require(chart["start_endpoint"]["H11_a1_unit"] == "not_evaluated", "historical H11 boundary")
    require(chart["start_endpoint"]["H02_a1_unit"] == "not_evaluated", "historical H02 boundary")
    require(g3bn["endpoint_chart"]["determinant_mod21817"] == 276, "H11 start determinant")
    require(g3br["endpoint_chart"]["determinant_mod21817"] == 419, "H02 start determinant")
    require(g3bn["checks"]["the_nonzero_reduction_proves_the_selected_H11_endpoint_chart_is_invertible_over_Q_gamma"], "H11 start chart")
    require(g3br["checks"]["the_nonzero_reduction_proves_the_selected_H02_endpoint_chart_is_invertible_over_Q_gamma"], "H02 start chart")

    source = g3ca["selected_source"]
    require(source["coefficient_field"] == "Q(gamma)", "selected source field")
    require(source["Cox_degree"] == [9, 1, 2], "selected source degree")
    require(source["exact_term_count"] == 100, "selected source terms")
    source_polynomial = ROOT / source["exact_polynomial"]["path"]
    require(source_polynomial.is_file(), "selected source polynomial")
    require(sha256(source_polynomial) == source["exact_polynomial"]["sha256"], "selected source hash")

    lower = g3ce["block_decomposition"]
    require(lower["lower_block_shape"] == [1261, 1261], "lower block shape")
    require(lower["lower_block_determinant_mod11"] == 4, "terminal lower determinant")
    require("characteristic-zero" in lower["characteristic_zero_consequence"], "characteristic-zero consequence")

    checks = {
        "G3BJ_G3BK_G3BN_G3BR_G3CA_G3CE_are_hash_bound_and_passing": True,
