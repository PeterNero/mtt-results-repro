    def matrix_trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum(
            (
                matrix[index][index]
                for index in range(len(matrix))
            ),
            Fraction(0),
        )

    def state_expectation(
        density: list[list[Fraction]],
