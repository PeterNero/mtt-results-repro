#!/usr/bin/env python3
"""Verify exact reconstruction of the G3AO uvs msolve inputs."""

from __future__ import annotations

import hashlib
import json

import sympy as sp

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as builder
import run_ust_g3ao_selected_cayley_toric_regularity as direct


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    packet = json.loads(builder.OUT.read_text(encoding="ascii"))
    require(packet["source_sha256"] == sha256(direct.SOURCE), "selected source")
    require(all(packet["checks"].values()), "input checks")
    polynomials = direct.selected_polynomials()
    g = sp.symbols("g")
    minpoly = sp.Poly(
        sp.sympify(polynomials["minpoly"].replace("^", "**")),
        g,
        modulus=101,
    )
    require(minpoly.degree() == 6 and minpoly.is_irreducible, "irreducible F101 extension")
    require(packet["field_presentation"]["irreducible_over_F101"] is True, "field ledger")
    export_script = direct.CAMPAIGN / packet["export_script"]["path"]
    raw_output = direct.CAMPAIGN / packet["raw_output"]["path"]
    require(export_script.is_file() and sha256(export_script) == packet["export_script"]["sha256"], "export script")
    require(raw_output.is_file() and sha256(raw_output) == packet["raw_output"]["sha256"], "raw export")
    require(
        export_script.read_text(encoding="ascii") == builder.make_export_script(polynomials),
        "exact export-script reconstruction",
    )
    raw = raw_output.read_text(encoding="utf-8")
    require("G3AO_MSOLVE_EXPORT_PASS" in raw, "raw export marker")
    for locus in ("smooth", "singular"):
        generators = builder.parse_locus(raw, locus)
        expected = builder.make_msolve_input(polynomials, generators)
        record = packet["loci"][locus]["input"]
        path = direct.CAMPAIGN / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"{locus} input hash")
        require(path.read_text(encoding="ascii") == expected, f"{locus} exact input")
        require(packet["loci"][locus]["generator_count"] == len(generators) + 1, f"{locus} count")
    print("UST.G3AO uvs msolve input verifier: PASS")


if __name__ == "__main__":
    main()
