            "extra_kernel_free_columns_zero_based": [free_columns[index] for index in extra_free_positions],
            "selected_member_sha256": canonical_hash([list(value) for value in selected_member]),
            "projective_tangent_frame_sha256": canonical_hash(
                [[list(value) for value in vector] for vector in projective_tangent_columns]
            ),
            "kernel_frame_sha256": canonical_hash(
