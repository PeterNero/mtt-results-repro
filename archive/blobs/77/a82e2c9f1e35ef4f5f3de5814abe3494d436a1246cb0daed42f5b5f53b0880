def cache_paths(prime: int) -> tuple[Path, Path]:
    return (
        EVIDENCE / f"H02.component20.p{prime}.second_jet_source.npz",
        EVIDENCE / f"H02.component20.p{prime}.second_jet_source.json",
    )


def read_cache(
    prime: int, roots: tuple[int, ...]
) -> tuple[np.ndarray, np.ndarray, dict[str, object]] | None:
    arrays_path, metadata_path = cache_paths(prime)
    if not (arrays_path.is_file() and metadata_path.is_file()):
        return None
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    if metadata.get("arithmetic_schema") != ARITHMETIC_SCHEMA:
        return None
    require(metadata["artifact"]["sha256"] == sha256(arrays_path), "cache hash")
    arrays = np.load(arrays_path, allow_pickle=False)
    require(int(arrays["prime"][0]) == prime, "cache prime")
    require(tuple(int(value) for value in arrays["roots"]) == roots, "cache roots")
    values = arrays["second_jet_source_coefficients"].astype(np.uint32)
    residues = arrays["second_jet_source_power_basis_residues"].astype(np.uint32)
    require(values.shape == (6, 132) and residues.shape == (6, 132), "cache shapes")
    return values, residues, metadata


def cleanup(*paths: Path) -> None:
    for path in paths:
        path.unlink(missing_ok=True)


def build_prime(
    prime: int,
    roots: tuple[int, ...],
    context: dict[str, object],
    coefficient_vectors: list[list[int]],
    d7_coordinates: np.ndarray,
    b6_coordinates: np.ndarray,
) -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
    cached = read_cache(prime, roots)
    if cached is not None:
        return cached
    values: list[np.ndarray] = []
    fibers: list[dict[str, object]] = []
    for gamma in roots:
        root_cache = EVIDENCE / f"H02.component20.p{prime}.g{gamma}.second_jet_source.npz"
        root_metadata = EVIDENCE / f"H02.component20.p{prime}.g{gamma}.second_jet_source.json"
        if root_cache.is_file() and root_metadata.is_file():
            metadata = json.loads(root_metadata.read_text(encoding="utf-8"))
            if metadata.get("arithmetic_schema") != ARITHMETIC_SCHEMA:
                metadata = None
            if metadata is not None:
                require(metadata["artifact"]["sha256"] == sha256(root_cache), "root cache hash")
                cached = np.load(root_cache, allow_pickle=False)
                require(
                    (int(cached["prime"][0]), int(cached["gamma"][0]))
                    == (prime, gamma),
                    "root cache field",
                )
                values.append(cached["source_coefficient"].astype(np.uint32))
                fibers.append(metadata["fiber"])
                print(f"G3GA p={prime} gamma={gamma}: reused root cache", flush=True)
                continue
        endpoint, construction = endpoint_action.endpoint_chart(
            prime,
            gamma,
            context["g3bi"],
            context["macaulay"],
            context["factor"],
            context["quotient_rows"],
            context["descriptors"],
            context["generators0"],
            context["target_lookup"],
            context["oracle"],
            context["exporter"],
        )
        dm = context["dm"]
        core_rows = context["core_rows"]
        core_columns = context["core_columns"]
        delta = evaluate_at_prime(context["delta_records"], gamma, prime)
        u = evaluate_at_prime(context["u_records"], gamma, prime)
        w = evaluate_at_prime(context["w_records"], gamma, prime)
        base = normalize_at_prime(
            endpoint[dm["complement_rows"], :][:, 248:] - delta, prime
        )
        a_core = normalize_at_prime(base[core_rows, :][:, core_columns], prime)
        u_core = normalize_at_prime(u[core_rows, :], prime)
        w_core = normalize_at_prime(w[:, core_columns], prime)
        outside = np.ones(u.shape[0], dtype=bool)
        outside[core_rows] = False
        require(u[outside, :].nnz == 0, "U core support")
        border = normalize_at_prime(
            sparse.bmat(
                [
                    [a_core, u_core],
                    [
                        w_core,
                        sparse.csc_matrix(
                            (UPDATE_DIMENSION, UPDATE_DIMENSION), dtype=np.uint32
                        ),
                    ],
                ],
                format="csc",
            ),
            prime,
        )
        stem = f"p{prime}.g{gamma}"
        chart = SCRATCH / f"{stem}.border.bin"
        kernel = SCRATCH / f"{stem}.kernel.bin"
        kernel_log = SCRATCH / f"{stem}.kernel.log"
        context["exporter"].write_chart(
            chart,
            prime,
            border.shape[0],
            0,
            border.shape[0],
            border.indptr.astype(np.uint64).tolist(),
            border.indices.astype(np.uint32).tolist(),
            border.data.astype(np.uint32).tolist(),
        )
        prior_fields = (
            rank_runtime.initializer.parse_log(kernel_log)
            if kernel.is_file() and kernel_log.is_file()
            else {}
        )
        if (
            prior_fields.get("STATUS") == "SUCCESS"
            and prior_fields.get("PRIME") == str(prime)
            and prior_fields.get("ROWS") == str(border.shape[0])
        ):
            solver_stdout = "reused exact full-kernel checkpoint"
        else:
            completed = subprocess.run(
                [
                    "wsl",
                    codex_runtime.wsl_path(context["executable"]),
                    "--chart",
                    codex_runtime.wsl_path(chart),
                    "--kernel",
                    codex_runtime.wsl_path(kernel),
                    "--log",
                    codex_runtime.wsl_path(kernel_log),
                    "--update-start",
                    str(UPDATE_START),
                    "--progress-seconds",
                    "20",
                ],
                cwd=ROOT,
                capture_output=True,
                text=True,
                check=False,
            )
            require(completed.returncode == 0, completed.stdout + completed.stderr)
            solver_stdout = completed.stdout.strip()
        fields = rank_runtime.initializer.parse_log(kernel_log)
        coupling_rank = int(fields["RANK"]) - UPDATE_START
        kernel_dimension = int(fields["VERIFIED_RELATIONS"])
        require(
            coupling_rank + kernel_dimension == UPDATE_DIMENSION,
            "full rank-nullity",
        )
        payload = kernel_io.read_kernel(kernel)
        require(
            payload["matrix"].shape == (UPDATE_DIMENSION, kernel_dimension),
            "full kernel shape",
        )

        generators, syzygy_block, _ = interpolation.extract_fiber(kernel, prime)
        o8, _, _, _ = hilbert_burch.canonical_degree8_syzygy(
            generators[11], syzygy_block[:12], syzygy_block[12:], prime
        )
        forms9 = tuple(
            source_runtime.evaluate_selected_form(
                coefficient_vectors, theta, gamma, prime
            )
            for theta in range(3)
        )
        _, source_coefficient, profile, source_profile = second_jet.fiber_source(
            generators[11],
            syzygy_block,
            second_jet.evaluate_coordinates(d7_coordinates, gamma, prime),
            second_jet.evaluate_coordinates(b6_coordinates, gamma, prime),
            forms9,
            o8,
            prime,
        )
        values.append(source_coefficient.astype(np.uint32))
        fiber_record = {
            "gamma_root": gamma,
            "arithmetic_schema": ARITHMETIC_SCHEMA,
            "coupling_rank": coupling_rank,
            "kernel_dimension": kernel_dimension,
            "second_jet_profile": list(profile),
            "source_normalization_profile_sha256": hashlib.sha256(
                np.asarray(source_profile, dtype="<i2").tobytes()
            ).hexdigest(),
            "endpoint_construction": construction,
            "border_nonzero_entries": int(border.nnz),
            "kernel_nonzero_entries": int(payload["matrix"].nnz),
            "kernel_elapsed_seconds": float(fields["ELAPSED_SECONDS"]),
            "ephemeral_kernel_sha256": sha256(kernel),
            "solver_stdout": solver_stdout,
        }
        fibers.append(fiber_record)
        np.savez_compressed(
            root_cache,
            prime=np.asarray([prime], dtype=np.uint32),
            gamma=np.asarray([gamma], dtype=np.uint32),
            source_coefficient=source_coefficient.astype(np.uint32),
        )
        root_metadata.write_text(
            json.dumps(
                {
                    "arithmetic_schema": ARITHMETIC_SCHEMA,
                    "fiber": fiber_record,
                    "artifact": record(root_cache),
                },
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
        cleanup(chart, kernel, kernel_log)
        print(
            f"G3GA p={prime} gamma={gamma}: rank={coupling_rank} "
            f"kernel={kernel_dimension} "
            "second_jet=1",
            flush=True,
        )
    value_array = np.stack(values)
    residues = interpolation.interpolate(value_array.astype(np.int64), roots, prime)
    require(value_array.shape == residues.shape == (6, 132), "prime source shapes")
    arrays_path, metadata_path = cache_paths(prime)
    np.savez_compressed(
        arrays_path,
        prime=np.asarray([prime], dtype=np.uint32),
        roots=np.asarray(roots, dtype=np.uint32),
        second_jet_source_coefficients=value_array,
        second_jet_source_power_basis_residues=residues.astype(np.uint32),
    )
    metadata = {
        "arithmetic_schema": ARITHMETIC_SCHEMA,
        "prime": prime,
        "roots": list(roots),
        "fibers": fibers,
        "artifact": record(arrays_path),
    }
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
    return value_array, residues.astype(np.uint32), metadata


def reconstruction_audit(
    values: np.ndarray, primes: tuple[int, ...], prefix: int
) -> tuple[dict[str, object], np.ndarray, np.ndarray, np.ndarray]:
    require(values.shape == (len(primes), 792), "reconstruction matrix")
    require(2 <= prefix <= len(primes), "prefix")
    modulus = math.prod(primes[: prefix - 1])
    bound = math.isqrt((modulus - 1) // 2)
    combined = [int(value) for value in values[0]]
    running = primes[0]
    for prime, row in zip(
        primes[1 : prefix - 1], values[1 : prefix - 1], strict=True
    ):
        inverse = pow(running % prime, -1, prime)
        combined = [
            value
            + running * (((int(target) - value % prime) * inverse) % prime)
            for value, target in zip(combined, row, strict=True)
        ]
        running *= prime
    require(running == modulus, "CRT modulus")
    holdout_prime = primes[prefix - 1]
    holdout = values[prefix - 1]
    numerators = np.zeros(792, dtype=object)
    denominators = np.zeros(792, dtype=object)
    valid = np.zeros(792, dtype=bool)
    passed = np.zeros(792, dtype=bool)
    for index, (residue, target) in enumerate(zip(combined, holdout, strict=True)):
        numerator, denominator, candidate = height_campaign.rational_reconstruct(
            residue, modulus, bound
        )
        if not candidate:
            continue
        numerators[index] = numerator
        denominators[index] = denominator
        valid[index] = True
        passed[index] = (numerator - int(target) * denominator) % holdout_prime == 0
    zeros = passed & np.asarray([int(value) == 0 for value in numerators])
    units = passed & np.asarray(
        [abs(int(value)) == 1 for value in numerators]
    ) & np.asarray([int(value) == 1 for value in denominators])
    integers = passed & np.asarray([int(value) == 1 for value in denominators])
    result = {
        "prefix_primes": prefix,
        "construction_primes": prefix - 1,
        "holdout_prime": holdout_prime,
        "modulus": str(modulus),
        "modulus_bits": modulus.bit_length(),
        "uniqueness_bound": str(bound),
        "coefficients": 792,
        "valid_candidates": int(np.count_nonzero(valid)),
        "holdout_passes": int(np.count_nonzero(passed)),
        "holdout_aliases": int(np.count_nonzero(valid & ~passed)),
        "outside_uniqueness_range": int(np.count_nonzero(~valid)),
        "passing_zeros": int(np.count_nonzero(zeros)),
        "passing_units": int(np.count_nonzero(units)),
        "passing_integers": int(np.count_nonzero(integers)),
        "passing_nontrivial_coefficients": int(np.count_nonzero(passed & ~zeros & ~units)),
        "complete": bool(np.all(passed)),
    }
    return result, numerators, denominators, passed


def main() -> None:
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    SCRATCH.mkdir(parents=True, exist_ok=True)
    prior = np.load(second_jet.ARRAYS, allow_pickle=False)
    g3bi = second_jet.load(second_jet.G3BI)
    g3fx = np.load(second_jet.G3FX, allow_pickle=False)
    coefficient_vectors = g3bi["selected_source"]["coefficient_vectors"]

    context = full_kernel_context(g3bi)
    residues = [
        prior["second_jet_source_power_basis_residues"][index]
        .reshape(-1)
        .astype(np.uint32)
        for index in range(8)
    ]
    campaign_rows: list[dict[str, object]] = []
    for prime in FRESH_PRIMES:
        roots = height_campaign.FIBERS[prime]
        _, prime_residues, metadata = build_prime(
            prime,
            roots,
            context,
            coefficient_vectors,
            g3fx["D7_gamma_coordinates"],
            g3fx["B6_gamma_coordinates"],
        )
        residues.append(prime_residues.reshape(-1).astype(np.uint32))
        campaign_rows.append(metadata)
        print(f"G3GA prime={prime}: second-jet payload=6x132", flush=True)

    primes = tuple(list(height_campaign.FIBERS)[:8]) + FRESH_PRIMES
    residue_matrix = np.stack(residues)
    require(
        residue_matrix.shape == (len(primes), 792),
        "adaptive-prime residue matrix",
    )
    audits: list[dict[str, object]] = []
    final_numerators = final_denominators = final_passed = None
    for prefix in (8, len(primes)):
        audit, numerators, denominators, passed = reconstruction_audit(
            residue_matrix, primes, prefix
        )
        audits.append(audit)
        if prefix == len(primes):
            final_numerators, final_denominators, final_passed = (
                numerators,
                denominators,
                passed,
            )
        print(
            f"G3GA reconstruct prefix={prefix}: "
            f"passes={audit['holdout_passes']}/792 "
            f"nontrivial={audit['passing_nontrivial_coefficients']}",
            flush=True,
        )
    require(
        final_numerators is not None
        and final_denominators is not None
        and final_passed is not None,
        "final reconstruction",
    )
    complete = bool(audits[-1]["complete"])
    np.savez_compressed(
        ARRAYS,
        primes=np.asarray(primes, dtype=np.uint32),
        roots=np.asarray(
            [height_campaign.FIBERS[prime] for prime in primes], dtype=np.uint32
        ),
        second_jet_source_power_basis_residues=residue_matrix,
        reconstructed_numerators=np.asarray(
            [str(value) for value in final_numerators], dtype="U80"
        ),
        reconstructed_denominators=np.asarray(
            [str(value) for value in final_denominators], dtype="U80"
        ),
        reconstruction_pass=final_passed.astype(np.uint8),
    )
    packet = {
