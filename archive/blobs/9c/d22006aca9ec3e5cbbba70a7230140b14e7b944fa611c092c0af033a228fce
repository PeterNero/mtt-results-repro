    factor = load(factor_path)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = {int(value) for value in csc["binary"]["quotient_unit_rows"]}
    complement_rows = np.asarray(
        [row for row in range(len(target)) if row not in quotient_rows], dtype=np.int32
    )
    complement_lookup = {
        int(ambient_row): local_row
        for local_row, ambient_row in enumerate(complement_rows.tolist())
    }
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    require(len(descriptors) == complement_rows.size == 42458, "H02 complement dimensions")
    corrections = endpoint.correction_derivatives_exact(g3bi)
    coefficient_matrices = exact_coefficient_matrices(
        descriptors, corrections, target_lookup, complement_lookup
    )
    pattern, evaluated = exact_path_update(
        descriptors, corrections, target_lookup, complement_lookup, GAMMA_ROOT
    )

    exact_matching = maximum_bipartite_matching(pattern, perm_type="column").astype(np.int32)
    exact_upper = int(np.count_nonzero(exact_matching >= 0))
    split_evaluations: dict[int, sparse.csr_matrix] = {}
    split_ranks: dict[int, int] = {}
    split_components: dict[int, list[dict[str, int]]] = {}
    split_matching_bounds: dict[int, int] = {}
    for gamma_root in GAMMA_ROOTS:
        root_pattern, root_evaluated = exact_path_update(
            descriptors, corrections, target_lookup, complement_lookup, gamma_root
        )
        require((root_pattern != pattern).nnz == 0, "root-independent exact support")
        root_evaluated_pattern = root_evaluated.copy()
        root_evaluated_pattern.data = np.ones(
            root_evaluated_pattern.nnz, dtype=np.uint8
        )
        root_matching = maximum_bipartite_matching(
            root_evaluated_pattern, perm_type="column"
        ).astype(np.int32)
        split_matching_bounds[gamma_root] = int(np.count_nonzero(root_matching >= 0))
        summaries, _, _ = component_rank_certificate(
            root_evaluated, PRIME, select_minor=False
        )
        split_evaluations[gamma_root] = root_evaluated
        split_components[gamma_root] = summaries
        split_ranks[gamma_root] = sum(item["rank"] for item in summaries)
    best_root = max(GAMMA_ROOTS, key=lambda root: split_ranks[root])
    best_evaluated = split_evaluations[best_root]
    best_components, matched_rows, matched_columns = component_rank_certificate(
        best_evaluated, PRIME, select_minor=True
    )
    modular_lower = split_ranks[best_root]
    defective_components = exact_defective_component_ranks(
        coefficient_matrices,
        best_evaluated,
        g3bi["selected_source"]["minimal_polynomial_coefficients_ascending"],
        best_components,
    )
    exact_algebraic_defect = sum(
        item["algebraic_defect_from_matching"] for item in defective_components
    )
    exact_rank = exact_upper - exact_algebraic_defect
    require(exact_rank == modular_lower, "exact field rank reaches modular lower bound")
    exact_rank_closed = True

    g3br_update_path = ROOT / g3br["endpoint_update"]["matrix"]["path"]
    g3br_update = sparse.load_npz(g3br_update_path).tocsr()[complement_rows, :]
    require((g3br_update != evaluated).nnz == 0, "G3BR evaluated update replay")

    require(np.unique(matched_columns).size == matched_columns.size, "matching columns unique")
    require(np.unique(matched_rows).size == matched_rows.size, "matching rows unique")
    minor = best_evaluated[matched_rows, :][:, matched_columns].tocsc()
    require(minor.shape == (modular_lower, modular_lower), "square path-update minor")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    arrays_path = EVIDENCE / "G3BI_H02_affine_path_update_rank_arrays.npz"
    coefficient_paths = [
        EVIDENCE / f"G3BI_H02_affine_path_update.gamma_degree{degree}.npz"
        for degree in range(6)
    ]
    minor_path = EVIDENCE / "H02.G3BI.affine_path_update.rank_minor.chart.bin"
    rhs_path = EVIDENCE / "H02.G3BI.affine_path_update.unit.rhs.bin"
    log_path = EVIDENCE / "H02.G3BI.affine_path_update.rank_minor.log"
    np.savez_compressed(
        arrays_path,
        complement_rows=complement_rows,
        exact_matching_column_by_row=exact_matching,
        gamma_roots=np.asarray(GAMMA_ROOTS, dtype=np.int32),
        split_ranks=np.asarray([split_ranks[root] for root in GAMMA_ROOTS], dtype=np.int32),
        matched_rows=matched_rows,
        matched_columns=matched_columns,
    )
    for path, matrix in zip(coefficient_paths, coefficient_matrices, strict=True):
        sparse.save_npz(path, matrix, compressed=True)
    exporter.write_chart(
        minor_path,
        PRIME,
        modular_lower,
        0,
        modular_lower,
        minor.indptr.astype(np.uint64).tolist(),
        minor.indices.astype(np.uint32).tolist(),
        minor.data.astype(np.uint32).tolist(),
    )
    exporter.write_rhs(rhs_path, PRIME, modular_lower, [0, 1], [0], [1])
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(minor_path),
        "--rhs",
        runtime.wsl_path(rhs_path),
        "--log",
        runtime.wsl_path(log_path),
        "--determinant-only",
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    fields = initializer.parse_log(log_path)
    require(fields.get("STATUS") == "SUCCESS", "path-update determinant status")
    determinant = int(fields["CHART_DETERMINANT"])
    require(determinant != 0, "nonzero path-update minor")

    exact_rank_description = str(exact_rank)
    checks = {
        "the_exact_Q_gamma_affine_path_update_support_is_reconstructed": True,
        "the_split_place_evaluation_matches_the_certified_G3BR_update": True,
        "all_six_selected_split_roots_are_rank_evaluated": len(split_ranks) == 6,
        "the_exact_support_has_structural_rank_upper_bound6037": exact_upper == 6037,
        "exact_number_field_elimination_finds_five_rank359_defective_blocks": (
            len(defective_components) == 5
            and all(item["exact_Q_gamma_rank"] == 359 for item in defective_components)
        ),
        "the_rank_revealing_minor_has_nonzero_determinant_mod21817": determinant != 0,
        "matching_upper_minus_exact_block_defects_equals_modular_lower": (
            exact_rank == modular_lower == 6022
        ),
        "no_integral_transport_period_or_beta_value_is_inferred": True,
    }
    require(all(checks.values()), "G3BZ checks")
    packet = {
        "schema": "mtt.unified-source.g3bz-g3bi-h02-exact-path-update-rank.v1",
        "date": "2026-08-12",
        "theorem_id": "UST.G3BZ",
        "status": (
            "CLOSED_EXACT_SELECTED_AFFINE_PATH_UPDATE_RANK_6022"
