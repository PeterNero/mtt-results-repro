            scalar = common_scalar(minors, generators11, prime)
            require(graded.rref(minors, prime)[0] == 4, "four maximal minors")
            restrictions = [
                projective_line_restriction(generators11[:, column], prime)
                for column in range(4)
            ]
            require(
                any(int(restriction[11]) % prime for restriction in restrictions),
                "restricted forms have no common projective s factor",
            )
            gcd = restrictions[0]
            for restriction in restrictions[1:]:
                gcd = polynomial_gcd(gcd, restriction, prime)
            require(gcd.size == 1, "degree11 generators have no common factor")

            degree8_values[prime_index, root_index] = syzygy8.astype(np.uint32)
            maximal_minor_scalars[prime_index, root_index] = scalar
            local_values.append(syzygy8)
            local_profiles.append((pivot_rows, normalization_coordinate))
            normalization_profiles.append((pivot_rows, normalization_coordinate))
            print(
                f"G3FN p={prime} gamma={root}: syzygies=1,1,1 "
