#!/usr/bin/env python3
"""Optional WSL fplll candidate-reduction backend."""

from __future__ import annotations

import re
import subprocess


def reduce_fplll(
    lattice: list[list[int]],
    delta: float,
    eta: float,
    mode: str,
    float_type: str,
    lovasz: bool,
    early_reduction: bool,
    precision: int | None = None,
) -> list[list[int]]:
    rows = len(lattice)
    columns = len(lattice[0])
    encoded = "[" + "\n".join(
        "[" + " ".join(str(value) for value in row) + " ]" for row in lattice
    ) + "\n]\n"
    command = [
        "wsl.exe",
        "fplll",
        "-a",
        "lll",
        "-d",
        str(delta),
        "-e",
        str(eta),
        "-m",
        mode,
        "-l",
        "1" if lovasz else "0",
    ]
    if mode != "wrapper":
        command.extend(["-f", float_type])
    if float_type == "mpfr" and precision is not None:
        command.extend(["-p", str(precision)])
    if early_reduction:
        command.append("-y")
    completed = subprocess.run(
        command,
        input=encoded,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(f"fplll failed: {completed.stderr[-2000:]}")
    values = [int(value) for value in re.findall(r"-?\d+", completed.stdout)]
    if len(values) != rows * columns:
        raise RuntimeError(
            f"fplll output shape: expected {rows * columns}, got {len(values)}"
        )
    return [
        values[index * columns : (index + 1) * columns]
        for index in range(rows)
    ]
