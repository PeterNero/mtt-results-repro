                "H11_H02": record(H11_H02_COORDINATES),
                "H11_H11": record(H11_H11_COORDINATES),
                "H11_H20": record(H11_H20_COORDINATES),
            },
            "recursive_divergence_packets": {
                "H20_lower": record(H20_LOWER_PACKET),
                "H11_lower": record(H11_LOWER_PACKET),
