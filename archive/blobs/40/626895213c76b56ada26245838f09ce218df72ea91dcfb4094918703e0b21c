#!/usr/bin/env python3
"""Run the exact-source G3AP quotient module in the positive grading 5H+18L."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import build_ust_g3ap_selected_cayley_fiber2_weighted_hilbert_hint as weighted
import ust_g3ap_module_cache_recovery as cache_recovery
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
HINT = weighted.PACKET
SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert.sing"
OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert.singular.out"
BASE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_base.ssi"
MODULE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_degree254.ssi"
PACKET = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert.packet.json"
RECOVERY_SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_leader_recovery.sing"
RECOVERY_OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_leader_recovery.singular.out"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def candidate_script(source: str, hilbert: list[int]) -> str:
    generators = ",\n  ".join(qring.derivative_generators())
    representatives_before, representatives_after = qring.derivative_representatives()
    hint = ",".join(str(value) for value in hilbert)
    shifts = ",".join(str(value) for value in weighted.COMPONENT_SHIFTS)
    weights = ",".join(str(value) for value in weighted.BASE_WEIGHTS)
    base_relative = str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/")
    return weighted.weighted_base_prefix(source) + f'''option(noredTail);
{representatives_before}
ideal I0=K,E,C;
ideal GI=std(I0);
int i;
print("G3AP_F2_WQH_BASE_GB_SIZE="+string(size(GI)));
for (i=1;i<=size(GI);i++)
{{ print("G3AP_F2_WQH_BASE_LEADER_"+string(i)+"_EXP="+string(leadexp(GI[i]))); }}
attrib(GI,"isSB",0);
write("ssi:w {base_relative}",GI);
attrib(GI,"isSB",1);
qring q=GI;
{representatives_after}
module M=
  {generators};
intvec componentShifts={shifts};
attrib(M,"isHomog",componentShifts);
bigintvec predecessorHilbert={hint};
intvec selectedWeights={weights};
degBound={weighted.TARGET_SCALAR_DEGREE};
module G=std(M,predecessorHilbert,selectedWeights);
print("G3AP_F2_WQH_BOUND="+string(degBound));
print("G3AP_F2_WQH_MODULE_GENERATORS="+string(size(M)));
print("G3AP_F2_WQH_MODULE_GB_SIZE="+string(size(G)));
for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_WQH_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_WQH_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isSB",0);
write("ssi:w {module_relative}",G);
print("G3AP_F2_WQH_LEADER_EXPORT_PASS");
quit;
'''


def parse_leaders(
    raw: str,
) -> tuple[list[tuple[int, ...]], list[tuple[int, tuple[int, ...]]]]:
    normalized = raw.replace("G3AP_F2_WQH_", "G3AP_F2_QRING_")
    return qring.parse_leaders(normalized)


def annotate_weighted_sectors(sectors: dict[str, dict[str, int]]) -> None:
    shifts = {
        name: shift
        for (_, name, _, _), shift in zip(fiber2.COMPONENTS, weighted.COMPONENT_SHIFTS)
    }
    for name, sector in sectors.items():
        sector["H_plus_L_target_scalar_degree"] = sector.pop("target_scalar_degree")
        sector["weighted_component_shift"] = shifts[name]
        sector["weighted_target_scalar_degree"] = weighted.TARGET_SCALAR_DEGREE


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    parser.add_argument("--postprocess-existing", action="store_true")
    args = parser.parse_args()
    weighted.validate_grading()
    hint_packet, hilbert = weighted.load_hint()
    source = SOURCE.read_text(encoding="ascii")
    if not args.postprocess_existing:
        SCRIPT.write_text(candidate_script(source, hilbert), encoding="ascii")
    else:
        require(SCRIPT.is_file(), "executed weighted script")
    if args.emit_only:
        print(f"emitted {SCRIPT.relative_to(ROOT)}")
        return
    recovery_used = False
    evidence_output = OUTPUT
    if args.postprocess_existing:
        require(OUTPUT.is_file(), "existing weighted output")
        raw = OUTPUT.read_text(encoding="utf-8")
        if "G3AP_F2_WQH_MODULE_LEADER_1_COMP=" not in raw:
            raw = cache_recovery.recover(
                source_path=SOURCE,
                base_cache=BASE_CACHE,
                module_cache=MODULE_CACHE,
                marker="G3AP_F2_WQH",
                module_generator_count=21,
                canonical_component=6,
                script_path=RECOVERY_SCRIPT,
                output_path=RECOVERY_OUTPUT,
                timeout=args.timeout,
            )
            recovery_used = True
            evidence_output = RECOVERY_OUTPUT
        returncode = 0
        elapsed_seconds = None
    else:
        BASE_CACHE.unlink(missing_ok=True)
        MODULE_CACHE.unlink(missing_ok=True)
        started = time.time()
        completed = subprocess.run(
            singular_command(ROOT, SCRIPT),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        raw = completed.stdout
        returncode = completed.returncode
        elapsed_seconds = time.time() - started
        OUTPUT.write_text(raw, encoding="utf-8")
    require(returncode == 0, "weighted quotient Hilbert execution")
    require("G3AP_F2_WQH_LEADER_EXPORT_PASS" in raw, "weighted pass")
    require(BASE_CACHE.is_file() and BASE_CACHE.stat().st_size > 0, "weighted base cache")
    require(MODULE_CACHE.is_file() and MODULE_CACHE.stat().st_size > 0, "weighted module cache")
    base, module = parse_leaders(raw)
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    annotate_weighted_sectors(sectors)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "candidate unique top standard")
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-weighted-hilbert-candidate.v1",
        "date": "2026-08-10",
        "status": "CANDIDATE_REQUIRES_INDEPENDENT_SELECTED_TARGET_CERTIFICATION",
        "inputs": {
            "selected_source": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            },
            "predecessor_hint": {
                "path": str(HINT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(HINT),
            },
        },
        "grading": hint_packet["grading"],
        "execution": {
            "script": {
                "path": str(SCRIPT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SCRIPT),
            },
            "output": {
                "path": str(evidence_output.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(evidence_output),
            },
            "original_execution_output": {"path": str(OUTPUT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(OUTPUT)},
            "leader_recovery_used": recovery_used,
            "leader_recovery": None if not recovery_used else {"script": {"path": str(RECOVERY_SCRIPT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(RECOVERY_SCRIPT)}, "output": {"path": str(RECOVERY_OUTPUT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(RECOVERY_OUTPUT)}},
            "returncode": returncode,
            "elapsed_seconds": elapsed_seconds,
            "base_basis_size": len(base),
            "module_generator_count": 21,
            "candidate_basis_size_through_bound": len(module),
            "scalar_degree_bound": weighted.TARGET_SCALAR_DEGREE,
            "untrusted_base_cache": {
                "path": str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BASE_CACHE),
                "bytes": BASE_CACHE.stat().st_size,
                "isSB_trust_attribute_stored": False,
            },
            "candidate_module_cache": {
                "path": str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(MODULE_CACHE),
                "bytes": MODULE_CACHE.stat().st_size,
                "valid_through_weighted_scalar_degree": weighted.TARGET_SCALAR_DEGREE,
                "isSB_trust_attribute_stored": False,
            },
        },
        "fiber_degree_two_module": {
            "base_quotient": "B/(K,E,C)",
            "components": [name for _, name, _, _ in fiber2.COMPONENTS],
            "component_weighted_shifts": list(weighted.COMPONENT_SHIFTS),
            "sectors": sectors,
        },
        "candidate_top_piece": {
            "Cox_degree": [18, 2, 2],
            "H_plus_L_scalar_degree": 44,
            "weighted_scalar_degree": weighted.TARGET_SCALAR_DEGREE,
            "enumerated_monomials": total,
            "dimension_if_candidate_is_certified": 1,
            "basis_if_candidate_is_certified": ["w^12*t2^4*s^2"],
        },
        "checks": {
            "selected_source_is_hash_bound": True,
            "strictly_positive_Cox_order_is_used": True,
            "base_ideal_is_recomputed_from_selected_K_E_C_in_that_order": True,
            "all_21_selected_quotient_module_generators_are_supplied_to_std": True,
            "predecessor_is_used_only_as_a_regraded_Hilbert_hint": True,
            "all_174865_target_monomials_are_enumerated": True,
            "candidate_leading_module_leaves_one_target_standard": True,
        },
        "guardrails": {
            "claims_the_predecessor_hint_proves_selected_flatness": False,
            "claims_the_candidate_module_is_independently_certified": False,
            "claims_G3AP_is_closed": False,
            "claims_response_rank_or_beta_C_is_computed": False,
        },
        "next_required_object": (
            "Reload both caches without isSB trust, reconstruct the selected base "
            "ideal, reduce all 21 selected generators, and certify either a no-hint "
            "target standard basis or the exact selected lower/upper leading squeeze."
        ),
    }
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP weighted qring Hilbert candidate: PASS "
        f"base={len(base)} module={len(module)} monomials={total} certification=OPEN"
    )


if __name__ == "__main__":
    main()
