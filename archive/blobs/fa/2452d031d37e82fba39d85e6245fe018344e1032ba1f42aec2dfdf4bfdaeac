def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def relative(path: Path) -> str:
    return str(path.relative_to(ROOT)).replace("\\", "/")


def checked(record: dict[str, object], label: str) -> Path:
    path = ROOT / str(record["path"])
    require(
        path.is_file()
        and sha256(path) == record["sha256"]
        and ("bytes" not in record or path.stat().st_size == record["bytes"]),
        label,
    )
    return path


def artifact(path: Path) -> dict[str, object]:
    return {"path": relative(path), "sha256": sha256(path), "bytes": path.stat().st_size}


