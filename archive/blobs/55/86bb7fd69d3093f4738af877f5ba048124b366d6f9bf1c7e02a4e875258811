        },
        "guardrails": {
            "claims_entrywise_equality_with_the_G3FN_RREF_matrix": False,
            "claims_the_Cox_complex_has_already_been_projected_to_the_apolar_ring": False,
            "claims_the_G3FR_inverse_primitives_are_derived": False,
            "claims_component20_rank36_over_Qgamma": False,
