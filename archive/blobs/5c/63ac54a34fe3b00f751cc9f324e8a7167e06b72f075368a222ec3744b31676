print("G3AL_SOCLE_TERMS="+string(size(reducedSocle)));
print("G3AL_SOCLE_LEAD="+string(leadmonom(reducedSocle)));
write("ssi:w {BASIS_CACHE}",G);
print("G3AL_SELECTED_CAYLEY_BASIS_PASS");
quit;
'''


def append_matrix(
    payload: bytearray,
    name: str,
    matrix: list[list[Element]],
    records: dict[str, object],
) -> None:
    rows = len(matrix)
    columns = len(matrix[0]) if matrix else 0
    require(all(len(row) == columns for row in matrix), f"rectangular {name}")
    start = len(payload)
    for row in matrix:
        for value in row:
            payload.extend(value)
    records[name] = {
        "shape": [rows, columns, 6],
        "byte_offset": start,
        "byte_length": len(payload) - start,
        "canonical_sha256": canonical_hash(
            [[list(value) for value in row] for row in matrix]
        ),
    }


