@cache
def q79_bulk_to_boundary_dirac_family_source_cutset() -> dict[str, Any]:
    freshness = source_freshness()
    free_dirac = framed_q79_free_dirac_car_net()
    local_regulator = q79_sm_local_auxiliary_elliptic_bv_regulator()
    prior_crossing = q79_sm_boundary_crossing_line_reduction()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    source_rows = {
        row["id"]: row for row in freshness["sources"]
    }
    manifest_sources = {
        row["id"]: row for row in manifest["sources"]
    }
    coframe_packet = json.loads(
        (
            ROOT
            / manifest_sources["Q79_LORENTZIAN_COFRAME"]["path"]
        )
        .resolve()
        .read_text(encoding="utf-8")
    )
    external_names = {
        row["name"]
        for row in manifest["external_theorems"]
        if "name" in row
    }

    source_checks = {
        "all_hash_pinned_sources_are_current": freshness["all_current"],
        "q79_lorentzian_coframe_source_is_current": (
            source_rows["Q79_LORENTZIAN_COFRAME"]["state"]
            == "current"
        ),
        "selected_framed_free_Dirac_operator_is_available": (
            free_dirac["all_checks_pass"]
        ),
        "auxiliary_APS_boundary_package_is_available": (
            local_regulator["all_checks_pass"]
        ),
        "finite_crossing_line_reduction_is_available": (
            prior_crossing["all_checks_pass"]
        ),
        "coframe_is_selected_only_up_to_diff_and_frame_gauge": (
            coframe_packet["claim_tiers"][
                "global_lorentzian_coframe_after_A_QG_A_causal"
            ]
            == "CLOSED_CONSTRUCTED_UP_TO_DIFF_AND_LOCAL_LORENTZ_GAUGE"
        ),
        "current_regulator_boundary_is_explicitly_auxiliary": (
            local_regulator["capability_checks"][
                "auxiliary_boundary_choice_is_not_counted_as_physical_parameter"
            ]
        ),
        "Bar_Ballmann_boundary_theory_is_registered": (
            "Bar-Ballmann first-order elliptic boundary problems"
            in external_names
        ),
        "Kirk_Lesch_boundary_spectral_flow_is_registered": (
            "Kirk-Lesch eta Maslov spectral-flow boundary theorem"
            in external_names
        ),
        "Dai_Freed_determinant_line_theory_is_registered": (
            "Dai-Freed eta determinant-line holonomy"
            in external_names
        ),
        "BV_BFV_boundary_framework_is_registered": (
            "Cattaneo-Mnev-Reshetikhin BV-BFV boundary framework"
            in external_names
        ),
    }

    a_start = Fraction(1, 2)
    a_cross = Fraction(1)
    a_end = Fraction(3, 2)
    crossing_mode = -1

    def circle_eigenvalue(mode: int, connection_coordinate: Fraction) -> Fraction:
        return Fraction(mode) + connection_coordinate

    spectrum_modes = list(range(-4, 4))
    circle_spectrum_rows = [
        {
            "a": str(connection_coordinate),
            "eigenvalues": {
                str(mode): str(
                    circle_eigenvalue(mode, connection_coordinate)
                )
                for mode in spectrum_modes
            },
        }
        for connection_coordinate in (a_start, a_cross, a_end)
    ]
    endpoint_gauge_residual = a_end - a_start - 1
    crossing_starts_negative = (
        circle_eigenvalue(crossing_mode, a_start) < 0
    )
    crossing_ends_positive = (
        circle_eigenvalue(crossing_mode, a_end) > 0
    )
    lower_modes_stay_negative = (
        circle_eigenvalue(-2, a_end) == Fraction(-1, 2)
        and circle_eigenvalue(-2, a_end) < 0
    )
    upper_modes_stay_positive = (
        circle_eigenvalue(0, a_start) == Fraction(1, 2)
        and circle_eigenvalue(0, a_start) > 0
    )
    crossing_form = (
        circle_eigenvalue(crossing_mode, a_cross + 1)
        - circle_eigenvalue(crossing_mode, a_cross)
    )
    winding_spectral_flow = int(
        crossing_starts_negative
        and crossing_ends_positive
        and lower_modes_stay_negative
        and upper_modes_stay_positive
        and crossing_form > 0
    )
    constant_path_derivative = a_start - a_start
    constant_spectral_flow = (
        0 if constant_path_derivative == 0 else None
    )
    circle_crossing_checks = {
        "q79_sign_basepoint_is_minus_one": (
            prior_crossing["shared_line_parity_shadow"][
                "crossing_value"
            ]["shared_sign_holonomy"]
            == "-1"
        ),
        "endpoint_connection_coordinates_differ_by_one": (
            a_end - a_start == 1
        ),
        "endpoint_flat_holonomy_classes_are_equal": (
            a_start.denominator == 2
            and a_end.denominator == 2
            and endpoint_gauge_residual == 0
        ),
        "endpoint_gauge_conjugacy_residual_is_zero": (
            endpoint_gauge_residual == 0
        ),
        "crossing_mode_is_zero_exactly_at_a_one": (
            circle_eigenvalue(crossing_mode, a_cross) == 0
        ),
        "all_modes_below_crossing_stay_negative": (
            lower_modes_stay_negative
        ),
        "all_modes_above_crossing_stay_positive": (
            upper_modes_stay_positive
        ),
        "crossing_form_is_positive_one": (
            crossing_form == 1
        ),
        "unit_winding_circle_family_has_spectral_flow_one": (
            winding_spectral_flow == 1
        ),
        "constant_sign_based_family_has_spectral_flow_zero": (
            constant_spectral_flow == 0
        ),
    }

    galerkin_modes = [-3, -1, 2]
    t_values = [Fraction(-1), Fraction(0), Fraction(1)]
    homotopy_values = [Fraction(0), Fraction(1, 2), Fraction(1)]

    def continuum_galerkin(connection_parameter: Fraction) -> list[list[Fraction]]:
        connection_coordinate = 1 + connection_parameter / 2
        return diagonal(
            [
                circle_eigenvalue(mode, connection_coordinate)
                for mode in galerkin_modes
            ]
        )

    def flattened_witness(connection_parameter: Fraction) -> list[list[Fraction]]:
        return diagonal(
            [
                Fraction(-2),
                connection_parameter,
                Fraction(3),
            ]
        )

    def flattening_homotopy(
        connection_parameter: Fraction,
        homotopy_parameter: Fraction,
    ) -> list[list[Fraction]]:
        spectator_scale = 1 - homotopy_parameter
        crossing_scale = (
            Fraction(1, 2)
            + homotopy_parameter / 2
        )
        return diagonal(
            [
                Fraction(-2)
                + spectator_scale * connection_parameter / 2,
                crossing_scale * connection_parameter,
                Fraction(3)
                + spectator_scale * connection_parameter / 2,
            ]
        )

    continuum_galerkin_rows = [
        {
            "t": str(value),
            "a": str(1 + value / 2),
            "matrix": fraction_matrix_strings(
                continuum_galerkin(value)
            ),
        }
        for value in t_values
    ]
    flattening_rows = [
        {
            "r": str(homotopy_parameter),
            "t": str(connection_parameter),
            "matrix": fraction_matrix_strings(
                flattening_homotopy(
                    connection_parameter,
                    homotopy_parameter,
                )
            ),
        }
        for homotopy_parameter in homotopy_values
        for connection_parameter in t_values
    ]
    galerkin_checks = {
        "three_mode_restriction_is_exact": all(
            continuum_galerkin(value)
            == diagonal(
                [
                    Fraction(-2) + value / 2,
                    value / 2,
                    Fraction(3) + value / 2,
                ]
            )
            for value in t_values
        ),
        "homotopy_starts_at_continuum_Galerkin_family": all(
            flattening_homotopy(value, Fraction(0))
            == continuum_galerkin(value)
            for value in t_values
        ),
        "homotopy_ends_at_prior_finite_witness": all(
            flattening_homotopy(value, Fraction(1))
            == flattened_witness(value)
            for value in t_values
        ),
        "prior_finite_endpoint_matrices_match_exactly": (
            fraction_matrix_strings(flattened_witness(Fraction(-1)))
            == prior_crossing["exact_APS_crossing"]["A_minus"]
            and fraction_matrix_strings(flattened_witness(Fraction(0)))
            == prior_crossing["exact_APS_crossing"]["A_zero"]
            and fraction_matrix_strings(flattened_witness(Fraction(1)))
            == prior_crossing["exact_APS_crossing"]["A_plus"]
        ),
        "negative_spectator_never_crosses_zero": all(
            flattening_homotopy(
                connection_parameter,
                homotopy_parameter,
            )[0][0]
            < 0
            for homotopy_parameter in homotopy_values
            for connection_parameter in t_values
        ),
        "positive_spectator_never_crosses_zero": all(
            flattening_homotopy(
                connection_parameter,
                homotopy_parameter,
            )[2][2]
            > 0
            for homotopy_parameter in homotopy_values
            for connection_parameter in t_values
