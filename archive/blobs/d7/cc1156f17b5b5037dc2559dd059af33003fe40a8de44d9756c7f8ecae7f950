def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"packet exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def legacy_border(
    prime: int, gamma: int, context: dict[str, object]
) -> sparse.csc_matrix:
    """Replay the superseded builder, including its inherited modulus 33863."""
    endpoint, _ = campaign.endpoint_action.endpoint_chart(
        prime,
        gamma,
        context["g3bi"],
        context["macaulay"],
        context["factor"],
        context["quotient_rows"],
        context["descriptors"],
        context["generators0"],
        context["target_lookup"],
        context["oracle"],
        context["exporter"],
    )
    dm = context["dm"]
    core_rows = context["core_rows"]
    core_columns = context["core_columns"]
    delta = legacy_arithmetic.evaluate(context["delta_records"], gamma)
    u = legacy_arithmetic.evaluate(context["u_records"], gamma)
    w = legacy_arithmetic.evaluate(context["w_records"], gamma)
    base = legacy_arithmetic.normalize(
        endpoint[dm["complement_rows"], :][:, 248:] - delta
    )
    a_core = legacy_arithmetic.normalize(base[core_rows, :][:, core_columns])
    u_core = legacy_arithmetic.normalize(u[core_rows, :])
    w_core = legacy_arithmetic.normalize(w[:, core_columns])
    return legacy_arithmetic.normalize(
        sparse.bmat(
            [
                [a_core, u_core],
                [
                    w_core,
                    sparse.csc_matrix(
                        (campaign.UPDATE_DIMENSION, campaign.UPDATE_DIMENSION),
                        dtype=np.uint32,
                    ),
                ],
            ],
            format="csc",
        )
    )


def run_fresh_probe(
    context: dict[str, object], chart: Path, kernel: Path, log: Path
) -> None:
    border = border_runtime.border_matrix(FRESH_PRIME, FRESH_GAMMA, context)
    context["exporter"].write_chart(
        chart,
        FRESH_PRIME,
        border.shape[0],
        0,
        border.shape[0],
        border.indptr.astype(np.uint64).tolist(),
        border.indices.astype(np.uint32).tolist(),
        border.data.astype(np.uint32).tolist(),
    )
    completed = subprocess.run(
        [
            "wsl",
            codex_runtime.wsl_path(context["executable"]),
            "--chart",
            codex_runtime.wsl_path(chart),
            "--kernel",
            codex_runtime.wsl_path(kernel),
            "--log",
            codex_runtime.wsl_path(log),
            "--update-start",
            str(campaign.UPDATE_START),
            "--progress-seconds",
            "20",
        ],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    require(completed.returncode == 0, completed.stdout + completed.stderr)


def corrected_source(
    kernel: Path, source_path: Path, g3bi: dict[str, object]
) -> tuple[tuple[int, ...], int, bool]:
    g3fx = np.load(campaign.second_jet.G3FX, allow_pickle=False)
    generators, syzygy_block, _ = campaign.interpolation.extract_fiber(
        kernel, FRESH_PRIME
    )
    o8, _, _, _ = campaign.hilbert_burch.canonical_degree8_syzygy(
        generators[11], syzygy_block[:12], syzygy_block[12:], FRESH_PRIME
    )
    forms9 = tuple(
        campaign.source_runtime.evaluate_selected_form(
            g3bi["selected_source"]["coefficient_vectors"],
            theta,
            FRESH_GAMMA,
            FRESH_PRIME,
        )
        for theta in range(3)
    )
    _, source, profile, _ = campaign.second_jet.fiber_source(
        generators[11],
        syzygy_block,
        campaign.second_jet.evaluate_coordinates(
            g3fx["D7_gamma_coordinates"], FRESH_GAMMA, FRESH_PRIME
        ),
        campaign.second_jet.evaluate_coordinates(
            g3fx["B6_gamma_coordinates"], FRESH_GAMMA, FRESH_PRIME
        ),
        forms9,
        o8,
        FRESH_PRIME,
    )
    np.savez_compressed(
        source_path,
        prime=np.asarray([FRESH_PRIME], dtype=np.uint32),
        gamma=np.asarray([FRESH_GAMMA], dtype=np.uint32),
        source_coefficient=source.astype(np.uint32),
    )
    operator = fixed_minor.source_operator(
        generators[11],
        campaign.second_jet.evaluate_coordinates(
            g3fx["D7_gamma_coordinates"], FRESH_GAMMA, FRESH_PRIME
        ),
        campaign.second_jet.evaluate_coordinates(
            g3fx["B6_gamma_coordinates"], FRESH_GAMMA, FRESH_PRIME
        ),
        forms9,
        FRESH_PRIME,
    )
    rank, rows, _ = fixed_minor.graded.rref(operator.T, FRESH_PRIME)
    square = fixed_minor.chart_matrix(operator, FRESH_PRIME)
    determinant = fixed_minor.determinant_mod(square, FRESH_PRIME)
    rhs = np.zeros(132, dtype=np.int64)
    rhs[-1] = 1
    replay = (
        rank == 115
        and tuple(rows) == fixed_minor.OPERATOR_ROWS
        and determinant != 0
        and np.array_equal(square @ source % FRESH_PRIME, rhs)
    )
    return tuple(int(value) for value in profile), determinant, replay


