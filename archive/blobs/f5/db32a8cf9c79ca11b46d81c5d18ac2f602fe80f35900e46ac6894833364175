        "status": (
            "COMPACT_GAUGE_AND_GHOST_ZERO_BRST_OBSERVABLE_DEFECT_"
            "EXACT_UNIFORM_ZERO_AT_FINITE_REGULATORS_AND_CSTAR_"
            "REDUCED_PRODUCT_FULL_QUANTUM_WARD_DEFECT_REDUCED_TO_"
            "NONPERTURBATIVE_CHIRAL_MEASURE_JACOBIAN_CONTINUUM_"
            "TABLE_REMAINS_ONE_OF_NINE"
        ),
        "domain": {
            "finite_algebra": (
                "the compact-gauge fixed-point Cstar algebra and "
                "Gauss-neutral corner at every admitted finite auxiliary "
                "q79 regulator"
            ),
            "BRST_scope": (
                "the ghost-number-zero physical observable differential "
                "induced by the infinitesimal compact-gauge generators; "
                "not a construction of the complete indefinite BV ghost "
                "state space"
            ),
            "dynamics": (
                "bounded gauge-invariant finite-regulator Hamiltonians "
