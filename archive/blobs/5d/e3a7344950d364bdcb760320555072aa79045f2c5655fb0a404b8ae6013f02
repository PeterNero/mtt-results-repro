                rank, _, _ = graded.rref(multiplication, prime)
                nullities.append(multiplication.shape[1] - rank)
            require(tuple(nullities) == EXPECTED_SYZYGY_NULLITIES, "syzygy Hilbert profile")

            syzygy8, pivot_rows, normalization_coordinate, _selected = (
                canonical_degree8_syzygy(
                    generators11, syzygy1, syzygy2, prime
