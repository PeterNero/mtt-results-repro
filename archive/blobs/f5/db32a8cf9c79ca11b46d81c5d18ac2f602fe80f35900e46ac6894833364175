def canonical_q79_hessian_recorder_source() -> dict[str, Any]:
    p = reynolds_two_copy_s3()
    identity = eye(6)
    q = sub(identity, p)
    representations = two_copy_s3_representations()
    residual_blocks = [sub(identity, representation) for representation in representations]
    residual_stack = [row for block in residual_blocks for row in block]
    residual_gram = mul(transpose(residual_stack), residual_stack)
    normalized_residual_gram = scale(Fraction(1, 12), residual_gram)
    output_gauge_stack = list(reversed(residual_stack))
    output_gauge_gram = scale(
        Fraction(1, 12),
        mul(transpose(output_gauge_stack), output_gauge_stack),
    )

    defect_cosine = Fraction(7, 25)
    defect_sine = Fraction(24, 25)
    defect_ready = add(p, scale(defect_cosine, q))
    defect_record = scale(defect_sine, q)
    defect_isometry = defect_ready + defect_record
    defect_gram = add(
        mul(transpose(defect_ready), defect_ready),
        mul(transpose(defect_record), defect_record),
    )

    lueders_isometry = p + q
    lueders_gram = add(mul(transpose(p), p), mul(transpose(q), q))

    equal_rate = Fraction(3)
    equal_total_hazard_operator = add(
        scale(equal_rate, p),
        scale(equal_rate, q),
    )
    unequal_p_rate = Fraction(1)
    unequal_q_rate = Fraction(2)
    unequal_total_hazard_operator = add(
        scale(unequal_p_rate, p),
        scale(unequal_q_rate, q),
    )

    p_vector = [
        [Fraction(1)],
        [Fraction(1)],
        [Fraction(1)],
        [Fraction(0)],
        [Fraction(0)],
        [Fraction(0)],
    ]
    q_vector = [
        [Fraction(1)],
        [Fraction(-1)],
        [Fraction(0)],
        [Fraction(0)],
        [Fraction(0)],
        [Fraction(0)],
    ]

    def rayleigh(
        operator: list[list[Fraction]], vector: list[list[Fraction]]
    ) -> Fraction:
        numerator = mul(transpose(vector), mul(operator, vector))[0][0]
        denominator = mul(transpose(vector), vector)[0][0]
        return numerator / denominator

    unequal_p_hazard = rayleigh(unequal_total_hazard_operator, p_vector)
    unequal_q_hazard = rayleigh(unequal_total_hazard_operator, q_vector)

    p_cosine = Fraction(3, 5)
    p_sine = Fraction(4, 5)
    q_cosine = Fraction(5, 13)
