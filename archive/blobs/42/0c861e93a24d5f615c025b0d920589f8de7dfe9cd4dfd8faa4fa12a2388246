        (g3cy, "G3CY"),
        (g3da, "G3DA"),
        (g3db, "G3DB"),
        (g3dc, "G3DC"),
    ):
        require(all(packet["checks"].values()), f"{label} checks")

    roots = isolated_roots(args.root_bits, args.maxprec)
    gamma = roots[EMBEDDING_INDEX]
    powers = [acb(1)]
    for _ in range(5):
        powers.append(powers[-1] * gamma)

    base_x_path = checked_local(g3dc["inverse_source_actions"]["A0_inverse_B89"]["archive"])
    correction_x_path = checked_local(g3dc["inverse_source_actions"]["A0_inverse_BC"]["archive"])
    with np.load(base_x_path, allow_pickle=False) as archive:
        base_x = {key: archive[key] for key in archive.files}
    with np.load(correction_x_path, allow_pickle=False) as archive:
        correction_x = {key: archive[key] for key in archive.files}

    w_coefficients = [
        sparse.load_npz(checked_local(item)).tocsr()
        for item in g3cv["factorization"]["W_gamma_coefficients"]
    ]
    s_coefficients = [
        sparse.load_npz(checked_local(item)).tocsr()
        for item in g3cv["factorization"]["S_gamma_coefficients"]
    ]
    w_pattern = union_pattern(w_coefficients)
    observed_coordinates = np.unique(w_pattern.nonzero()[1]).astype(np.int32)
    require(w_pattern.shape == (FIRST_DIMENSION, H11_DIMENSION), "W shape")
    require(w_pattern.nnz == 15630 and observed_coordinates.size == 1186, "W support corridor")

    contraction_started = time.perf_counter()
    x_observed = acb_mat(
        int(observed_coordinates.size),
        SOURCE_DIMENSION,
        [
            reconstructed_ball(base_x, int(coordinate), source)
            if source < H20_DIMENSION
            else reconstructed_ball(correction_x, int(coordinate), source - H20_DIMENSION)
            for coordinate in observed_coordinates.tolist()
            for source in range(SOURCE_DIMENSION)
        ],
    )
    observed_lookup = {int(coordinate): position for position, coordinate in enumerate(observed_coordinates.tolist())}
    y = acb_mat(FIRST_DIMENSION, SOURCE_DIMENSION)
    for row in range(FIRST_DIMENSION):
        support = np.unique(w_pattern[row, :].nonzero()[1]).astype(np.int32)
        w_row, _ = evaluate_dense(
            w_coefficients,
            np.asarray([row], dtype=np.int32),
            support,
            powers,
        )
        x_rows = acb_mat(
            len(support),
            SOURCE_DIMENSION,
            [
                x_observed[observed_lookup[int(coordinate)], source]
                for coordinate in support.tolist()
                for source in range(SOURCE_DIMENSION)
            ],
        )
        product = w_row * x_rows
        for source in range(SOURCE_DIMENSION):
            y[row, source] = product[0, source]
        if (row + 1) % 200 == 0:
            print(
                f"G3DD W contraction: rows={row + 1}/{FIRST_DIMENSION} "
                f"seconds={time.perf_counter() - contraction_started:.3f}",
                flush=True,
            )
    y_accuracy = matrix_accuracy(y)
    contraction_seconds = time.perf_counter() - contraction_started

    s_started = time.perf_counter()
    all_first_rows = np.arange(FIRST_DIMENSION, dtype=np.int32)
    s_matrix, s_support = evaluate_dense(
        s_coefficients, all_first_rows, all_first_rows, powers
    )
    require(s_support == 12336, "S support")
    z = s_matrix.solve(y, algorithm="precond")
    residual = s_matrix * z - y
    residual_zero = sum(value.contains(0) for value in residual.entries())
    require(residual_zero == FIRST_DIMENSION * SOURCE_DIMENSION, "all S residual balls")
    z_accuracy = matrix_accuracy(z)
    require(z_accuracy["minimum_relative_accuracy_bits_away_from_zero"] >= 48, "Z accuracy")
    s_seconds = time.perf_counter() - s_started
    print(
        f"G3DD S solve: residuals={residual_zero} min_accuracy="
        f"{z_accuracy['minimum_relative_accuracy_bits_away_from_zero']} seconds={s_seconds:.3f}",
        flush=True,
    )

    q_path = checked_local(g3da["reduced_coupling"]["persisted_enclosure"]["archive"])
    with np.load(q_path, allow_pickle=False) as archive:
        q_arrays = {key: archive[key] for key in archive.files}
    active_columns = q_arrays["active_kernel_columns"].astype(np.int32)
    minor_rows = q_arrays["selected_minor_rows"].astype(np.int32)
    minor_columns = q_arrays["selected_minor_columns"].astype(np.int32)
    require(active_columns.size == ACTIVE_Q_COLUMNS, "740 active Q columns")
    require(minor_rows.size == minor_columns.size == SECOND_DIMENSION, "710 minor")
    active_lookup = {int(column): position for position, column in enumerate(active_columns.tolist())}
    require(all(int(column) in active_lookup for column in minor_columns.tolist()), "minor columns active")

    second_started = time.perf_counter()
    v_active = acb_mat(
        SECOND_DIMENSION,
        ACTIVE_Q_COLUMNS,
        [
            reconstructed_ball(q_arrays, int(row), active_position)
            for row in minor_rows.tolist()
            for active_position in range(ACTIVE_Q_COLUMNS)
        ],
    )
    z_active = acb_mat(
        ACTIVE_Q_COLUMNS,
        SOURCE_DIMENSION,
        [z[int(column), source] for column in active_columns.tolist() for source in range(SOURCE_DIMENSION)],
    )
    h = v_active * z_active
    h_accuracy = matrix_accuracy(h)
    require(h_accuracy["minimum_relative_accuracy_bits_away_from_zero"] >= 24, "H accuracy")
    second_seconds = time.perf_counter() - second_started
    print(
        f"G3DD 710 contraction: shape={SECOND_DIMENSION}x{SOURCE_DIMENSION} "
        f"min_accuracy={h_accuracy['minimum_relative_accuracy_bits_away_from_zero']} "
        f"seconds={second_seconds:.3f}",
        flush=True,
    )

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    persist_started = time.perf_counter()
    z_b89 = acb_mat(FIRST_DIMENSION, H20_DIMENSION, [z[row, column] for row in range(FIRST_DIMENSION) for column in range(H20_DIMENSION)])
    z_correction = acb_mat(FIRST_DIMENSION, H20_DIMENSION, [z[row, H20_DIMENSION + column] for row in range(FIRST_DIMENSION) for column in range(H20_DIMENSION)])
    h_b89 = acb_mat(SECOND_DIMENSION, H20_DIMENSION, [h[row, column] for row in range(SECOND_DIMENSION) for column in range(H20_DIMENSION)])
    h_correction = acb_mat(SECOND_DIMENSION, H20_DIMENSION, [h[row, H20_DIMENSION + column] for row in range(SECOND_DIMENSION) for column in range(H20_DIMENSION)])
    z_b89_record = persist_matrix(EVIDENCE / "H11.Z_B89.embedding4.p256.ddball.npz", z_b89, "first_Woodbury_coordinate")
    z_correction_record = persist_matrix(EVIDENCE / "H11.Z_C.embedding4.p256.ddball.npz", z_correction, "first_Woodbury_coordinate")
    h_b89_record = persist_matrix(EVIDENCE / "H11.H_B89.embedding4.p256.ddball.npz", h_b89, "selected_710_row")
    h_correction_record = persist_matrix(EVIDENCE / "H11.H_C.embedding4.p256.ddball.npz", h_correction, "selected_710_row")
    persist_seconds = time.perf_counter() - persist_started
    require(
        min(
            z_b89_record["minimum_relative_accuracy_bits_away_from_zero"],
            z_correction_record["minimum_relative_accuracy_bits_away_from_zero"],
            h_b89_record["minimum_relative_accuracy_bits_away_from_zero"],
            h_correction_record["minimum_relative_accuracy_bits_away_from_zero"],
        )
        >= 20,
        "portable reduced source accuracy",
    )

    checks = {
        "G3CV_G3CY_G3DA_G3DB_and_G3DC_are_hash_bound_and_passing": True,
        "the_exact_W_support_observes1186_of4426_base_coordinates": observed_coordinates.size == 1186,
        "both_complete248_column_inverse_source_maps_are_contracted_with_W": y.nrows() == 988 and y.ncols() == 496,
        "all490048_S_solve_residual_balls_contain_zero": residual_zero == 490048,
        "the_selected_Q_minor_rows_contract_both_source_families_to710_by248_maps": h.nrows() == 710 and h.ncols() == 496,
        "the_selected710_RHS_is_an_exactly_derived_affine_operator_on_c20": True,
