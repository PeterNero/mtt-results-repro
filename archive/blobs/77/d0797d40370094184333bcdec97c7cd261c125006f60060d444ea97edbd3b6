    base, pdelta_packet, g3bi, sextic, g3_polynomial, h4_polynomial, pdelta_polynomial = (
        selected_polynomials()
    )
    require(base["checks"]["plane_branch_sextic_is_projectively_smooth"], "smooth sextic")
    require(pdelta_packet["checks"]["selected_delta_has_nonzero_square"], "Pdelta square")
    require((hilbert_dimension(6), hilbert_dimension(12)) == (19, 1), "Hilbert dimensions")

    g3fr = np.load(runtime.G3FR, allow_pickle=False)
    prime = int(g3fr["primes"][0])
    gamma = int(g3fr["roots"][0, 0])
    require((prime, gamma) == (21817, 5), "anchor fiber")
    kernel18, profile = runtime.pdelta_kernel(
        sextic, pdelta_polynomial, prime
    )
    require(profile["kernel_dimension"] == 18, "finite kernel dimension")

    x, y, z = sextic.gens
    variables = (x, y, z)
    q = runtime.polynomial_vector(sp.Poly(x * z - y**2, *variables), 2, prime)
    g3 = runtime.polynomial_vector(g3_polynomial, 3, prime)
    h4 = runtime.polynomial_vector(h4_polynomial, 4, prime)
    pdelta = runtime.polynomial_vector(pdelta_polynomial, 6, prime)
    factors = runtime.selected_degree12_factors(q, g3, h4, pdelta, prime)
    require(len(factors) == 11, "selected degree12 factor count")

    target = g3fr["degree15_primitives"][0, 0].astype(np.int64) % prime
    require(graded.rref(target, prime)[0] == 18, "target primitive rank")
    _, _, target_annihilator = graded.rref(
        target.T, prime, emit_nullspace=True
    )
    require(
        target_annihilator is not None and target_annihilator.shape == (136, 118),
        "target annihilator",
    )
    coefficient_vectors = g3bi["selected_source"]["coefficient_vectors"]

    raw_ranks = np.zeros((3, 2), dtype=np.int16)
    for theta in range(3):
        a_theta = runtime.evaluate_selected_form(
            coefficient_vectors, theta, gamma, prime
        )
        raw = np.stack(
            [
                runtime.product(
                    kernel18[:, column], 6, a_theta, 9, prime
                )
                for column in range(18)
            ],
            axis=1,
        )
        raw_ranks[theta] = (
            graded.rref(raw, prime)[0],
            graded.rref(np.concatenate((raw, target), axis=1), prime)[0],
        )
    require(np.array_equal(raw_ranks, np.tile([18, 36], (3, 1))), "raw multiplication no-go")

    source_labels: list[str] = []
    source21_rows: list[np.ndarray] = []
    for theta in range(3):
        a_theta = runtime.evaluate_selected_form(
            coefficient_vectors, theta, gamma, prime
        )
        for label, factor in factors.items():
            source_labels.append(f"A{theta}*{label}")
            source21_rows.append(runtime.product(factor, 12, a_theta, 9, prime))
    require(len(source_labels) == 33, "selected source count")

    candidate_ranks = np.zeros((2, 33), dtype=np.int16)
    joint_ranks = np.zeros((2, 33), dtype=np.int16)
    obstruction_ranks = np.zeros(2, dtype=np.int16)
    obstruction_nullities = np.zeros(2, dtype=np.int16)
    for convention, ordinary in enumerate((False, True)):
        candidates = [
            runtime.contract(kernel18, source21, prime, ordinary=ordinary)
            for source21 in source21_rows
        ]
        for source, candidate in enumerate(candidates):
            candidate_ranks[convention, source] = graded.rref(candidate, prime)[0]
            joint_ranks[convention, source] = graded.rref(
                np.concatenate((candidate, target), axis=1), prime
            )[0]
        obstruction = np.stack(
            [
                (target_annihilator.T @ candidate % prime).reshape(-1)
                for candidate in candidates
            ],
            axis=1,
        )
        obstruction_ranks[convention] = graded.rref(obstruction, prime)[0]
        obstruction_nullities[convention] = 33 - obstruction_ranks[convention]
    require(np.array_equal(obstruction_ranks, [33, 33]), "full obstruction ranks")
    require(np.array_equal(obstruction_nullities, [0, 0]), "zero common-source nullities")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(
        ARRAYS,
        prime=np.asarray([prime], dtype=np.uint32),
        gamma=np.asarray([gamma], dtype=np.uint32),
        degree6_exponents=np.asarray(graded.homogeneous_exponents(6), dtype=np.int16),
        pdelta_kernel_degree6=kernel18.astype(np.uint32),
        target_primitive_degree15=target.astype(np.uint32),
        selected_degree12_factor_labels=np.asarray(list(factors), dtype="U40"),
        selected_degree21_source_labels=np.asarray(source_labels, dtype="U48"),
        raw_multiplication_ranks=raw_ranks,
        candidate_ranks=candidate_ranks,
        joint_ranks_with_selected_primitive15=joint_ranks,
        target_containment_obstruction_ranks=obstruction_ranks,
