            ),
            "continuum_scope": (
                "Cstar reduced products of exact-zero algebraic defect "
                "sequences; the chiral determinant measure remains a "
                "separate quantum input"
            ),
        },
        "uniform_algebraic_defect_theorem": {
            "gauge_defect": (
                "d_N^G(A)=sup_{g in G_N} ||gamma_N(g)A-A||"
            ),
            "BRST_defect": (
