            "normalization_component": component,
            "normalization_base_exponent": list(exponent),
            "normalization_basis": full_certifier.monomial_label(component, exponent),
            "normalization_value_packed": 1,
            "annihilates_all_92979_selected_relation_rows": True,
            "annihilates_every_campaign_relation_row": True,
