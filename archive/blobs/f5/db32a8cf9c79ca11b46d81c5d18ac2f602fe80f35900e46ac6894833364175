@cache
def q79_heat_kernel_counterterm_seed_and_qme_induction_cutset() -> dict[str, Any]:
    renormalized = json.loads(
        (
            ROOT
            / "certificates"
            / "q79_sm_renormalized_timeordering_local_qme.certificate.json"
        ).read_text(encoding="utf-8")
    )
    boundary_gluing = json.loads(
        (
            ROOT
            / "certificates"
            / "q79_boundaryless_bv_bfv_gluing_phase_reduction.certificate.json"
        ).read_text(encoding="utf-8")
    )
    cofinal = json.loads(
        (
            ROOT
            / "certificates"
            / (
                "q79_cofinal_free_bv_cutoff_and_interacting_"
                "counterterm_cutset.certificate.json"
            )
        ).read_text(encoding="utf-8")
    )
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    external_names = {
        row["name"]
        for row in manifest["external_theorems"]
        if "name" in row
    }

    source_checks = {
        "Albert_boundary_heat_kernel_theorem_is_registered": (
            "Albert heat-kernel BV renormalization with boundary"
            in external_names
        ),
        "Stueckelberg_Petermann_comparison_theorem_is_registered": (
            "Brunetti-Duetsch-Fredenhagen pAQFT renormalization group"
            in external_names
        ),
        "local_BRST_anomaly_classification_is_registered": (
            "Barnich-Brandt-Henneaux local BRST cohomology"
            in external_names
        ),
        "Wilsonian_QME_compatibility_is_registered": (
            "Igarashi-Itoh-So Wilsonian QME" in external_names
        ),
        "formal_EG_target_remains_closed": (
            cofinal["blocker_assessment"][
                "B.QFT.02_formal_EG_interacting_continuum_scheme"
            ]
            == "remains_closed_not_reopened"
        ),
        "all_orders_anomaly_free_QME_scheme_remains_closed": (
            renormalized["blocker_assessment"][
                "B.QFT.02_all_orders_perturbative_QME_scheme"
            ]
            == (
                "closed_by_exact_one_loop_zero_plus_Adler_Bardeen_"
                "and_renormalized_BV_theorems"
            )
        ),
        "auxiliary_boundary_phase_gluing_remains_closed": (
            boundary_gluing["blocker_assessment"][
                "B.QFT.02_auxiliary_boundary_phase_after_gluing"
            ]
            == "closed_formal_exact_as_dual_line_cancellation"
        ),
    }

    # Three two-term acyclic blocks with weights 1, 2 and 3. Their Hodge
    # Laplacian has eigenvalues 1, 4 and 9, each repeated twice.
    weights = [1, 2, 3]
    q = zeros(6, 6)
    for block, weight in enumerate(weights):
        q[2 * block][2 * block + 1] = Fraction(weight)
    q_dagger = transpose(q)
    delta = add(mul(q, q_dagger), mul(q_dagger, q))
    expected_delta = diagonal(
        [
            Fraction(value)
            for weight in weights
            for value in (weight * weight, weight * weight)
        ]
    )
    delta_inverse = diagonal(
        [
            Fraction(1, value)
            for weight in weights
            for value in (weight * weight, weight * weight)
        ]
    )

    def dyadic_heat(time_index: int) -> list[list[Fraction]]:
        return diagonal(
            [
                Fraction(1, 2 ** (time_index * value))
                for weight in weights
                for value in (weight * weight, weight * weight)
            ]
        )

    def regulated_propagator(
        lower_time_index: int,
        upper_time_index: int,
    ) -> list[list[Fraction]]:
        return mul(
            mul(q_dagger, delta_inverse),
            sub(
                dyadic_heat(lower_time_index),
                dyadic_heat(upper_time_index),
            ),
        )

    heat_1 = dyadic_heat(1)
    heat_2 = dyadic_heat(2)
