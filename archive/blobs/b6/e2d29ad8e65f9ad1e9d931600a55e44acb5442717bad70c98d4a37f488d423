#!/usr/bin/env python3
"""Independently verify the bounded G3AP ordinary-top computation."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import tempfile

import build_ust_g3ap_selected_cayley_bounded_top_dimension as bounded
import build_ust_g3ap_selected_cayley_ordinary_top_dimension as top
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ap_selected_cayley_bounded_top.packet.json"
WEIGHTS = (1, 1, 1, 3, 1, 1, 1, 6, 9, 2)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def weighted_monomial_degree(text: str, allowed: dict[str, int]) -> int:
    powers = {
        name: int(power or "1")
        for name, power in re.findall(r"([A-Za-z][A-Za-z0-9]*)(?:\^(\d+))?", text)
        if name in allowed
    }
    return sum(allowed[name] * power for name, power in powers.items())


def assignment(text: str, name: str) -> str:
    match = re.search(rf"^poly {re.escape(name)}=(.*);$", text, re.MULTILINE)
    require(match is not None, f"assignment {name}")
    return match.group(1)


def verify_untrusted_cache(cache: Path, expected_size: int) -> None:
    cache_relative = str(cache.relative_to(ROOT)).replace("\\", "/")
    script_text = f'''ring r=(101,g),(x,y,z,w,t0,t1,t2,u,v,s),wp(1,1,1,3,1,1,1,6,9,2);
minpoly=64+16*g^1+33*g^2+44*g^3+89*g^4+24*g^5+g^6;
def cachedBasis=read("ssi:r {cache_relative}");
ideal G=cachedBasis;
print("G3AP_CACHE_IS_SB_ATTR="+string(attrib(G,"isSB")));
print("G3AP_CACHE_SIZE="+string(size(G)));
print("G3AP_CACHE_RELOAD_PASS");
quit;
'''
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            suffix=".sing",
            prefix="ust_g3ap_cache_reload_",
            dir=ROOT / "state",
            delete=False,
        ) as temporary:
            temporary.write(script_text)
            temporary_path = Path(temporary.name)
        completed = subprocess.run(
            singular_command(ROOT, temporary_path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=300,
            check=False,
        )
        require(completed.returncode == 0, "bounded cache reload")
        require("G3AP_CACHE_RELOAD_PASS" in completed.stdout, "cache reload pass")
        require(
            re.search(r"^G3AP_CACHE_IS_SB_ATTR=0$", completed.stdout, re.MULTILINE)
            is not None,
            "cache reload keeps isSB trust cleared",
        )
        size = re.search(r"^G3AP_CACHE_SIZE=(\d+)$", completed.stdout, re.MULTILINE)
        require(size is not None and int(size.group(1)) == expected_size, "cache basis size")
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--packet", type=Path, default=PACKET)
    args = parser.parse_args()
    packet_path = args.packet if args.packet.is_absolute() else ROOT / args.packet
    packet = json.loads(packet_path.read_text(encoding="ascii"))
    require(
        packet["schema"] == "mtt.unified-source.g3ap-selected-cayley-bounded-top.v1",
        "schema",
    )
    require(packet["theorem_id"] == "UST.G3AP.BOUNDED", "theorem id")
    require(all(packet["checks"].values()), "all exact checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    source = checked(packet["inputs"]["selected_source"], "selected source")
    script = checked(packet["execution"]["script"], "execution script")
    output = checked(packet["execution"]["output"], "execution output")
    cache = checked(packet["execution"]["bounded_basis_cache"], "bounded basis cache")
    source_text = source.read_text(encoding="ascii")
    script_text = script.read_text(encoding="ascii")
    expected_script = bounded.bounded_script(source_text)
    options = packet["execution"].get("standard_basis_options", [])
    require(options in ([], ["noredTail"]), "allowed bounded-basis options")
    if options == ["noredTail"]:
        expected_script = expected_script.replace(
            "degBound=44;", "option(noredTail);\ndegBound=44;", 1
        ).replace(
            "state/ust_g3ap_selected_cayley_bounded_top_degree44.ssi",
            packet["execution"]["bounded_basis_cache"]["path"],
        )
    require(script_text == expected_script, "script reconstruction")
    require("ring r=(101,g)" in script_text and "ring r=11" not in script_text, "field")
    require(
        "wp(" + ",".join(str(value) for value in WEIGHTS) + ")" in script_text,
        "positive selected weights",
    )
    require("degBound=44;" in script_text, "exact degree bound")
    require("ideal G=std(J);" in script_text, "bounded standard basis command")
    require("slimgb(J)" not in script_text, "no unbounded basis command")
    require(
        (options == [] and "option(noredTail);" not in script_text)
        or (options == ["noredTail"] and "option(noredTail);" in script_text),
        "declared tail-reduction option",
    )
    cache_write = (
        'write("ssi:w '
        + packet["execution"]["bounded_basis_cache"]["path"]
        + '",G);'
    )
    require(
        'attrib(G,"isSB",0);' in script_text and cache_write in script_text,
        "bounded cache is stored without full-basis trust",
    )
    require(cache.stat().st_size == packet["execution"]["bounded_basis_cache"]["bytes"], "cache size")
    require(
        packet["execution"]["bounded_basis_cache"]["valid_through_scalar_degree"] == 44
        and packet["execution"]["bounded_basis_cache"]["isSB_trust_attribute_stored"] is False,
        "bounded cache scope",
    )
    verify_untrusted_cache(cache, packet["execution"]["leading_basis_size_through_bound"])
    # The selected construction is homogeneous of scalar degree 12:
    # wt(K)=6, wt(E)=3, wt(C)=10 and wt(u,v,s)=(6,9,2).
    require("poly Phi=u*K+v*E+s*C;" in script_text, "selected Cayley polynomial")
    require("poly K=w^2-F6;" in script_text, "K degree six")
    require("poly E=t0^3+t1^3+t2^3;" in script_text, "E degree three")
    require("poly C=A0*t0+A1*t1+A2*t2;" in script_text, "C degree ten")
    f6 = assignment(script_text, "F6")
    f6_terms = re.split(r"\s+[+-]\s+", f6)
    require(len(f6_terms) > 20, "explicit F6 terms")
    require(
        all(weighted_monomial_degree(term, {"x": 1, "y": 1, "z": 1, "w": 3}) == 6 for term in f6_terms),
        "every F6 monomial has weight six",
    )
    for name in ("A0", "A1", "A2"):
        row = assignment(script_text, name)
        monomials = re.findall(r"\)\*([xyzw0-9*^]+)(?=\+\(|$)", row)
        require(len(monomials) > 40, f"explicit {name} monomials")
        require(
            all(weighted_monomial_degree(term, {"x": 1, "y": 1, "z": 1, "w": 3}) == 9 for term in monomials),
            f"every {name} monomial has weight nine",
        )
    raw = output.read_text(encoding="utf-8")
    require("G3AP_BOUND=44" in raw, "raw degree bound")
    require("G3AP_LEADING_EXPONENT_EXPORT_PASS" in raw, "raw pass")
    exponents = top.parse_exponents(raw)
    require(
        len(exponents) == packet["execution"]["leading_basis_size_through_bound"],
        "leading basis size",
    )
    require(
        all(sum(weight * power for weight, power in zip(WEIGHTS, exponent)) <= 44 for exponent in exponents),
        "all exported leaders lie through the bound",
    )
    standards, sectors = top.enumerate_top(exponents)
    target = packet["ordinary_top_piece"]
    total = sum(value["enumerated_monomials"] for value in sectors.values())
    require(total == target["enumerated_monomials"] == 174865, "complete enumeration")
    require(standards == [top.EXPECTED_SOCLE], "unique selected top standard monomial")
    require(target["dimension"] == 1, "top dimension")
    require(target["basis"] == ["w^12*t2^4*s^2"], "top basis")
    require(
        target["basis_exponent_vectors"] == [list(top.EXPECTED_SOCLE)],
        "top exponent",
    )
    for key, value in sectors.items():
        require(target["fiber_sectors"][key] == value, f"sector {key}")
    # Every target monomial has scalar degree 44, so no leading term above the
    # homogeneous degree bound can divide one of them.
    require(
        sum(weight * power for weight, power in zip(WEIGHTS, top.EXPECTED_SOCLE))
        == 44,
        "target scalar weight",
    )
    require(packet["execution"]["full_standard_basis_claimed"] is False, "scope")
    print(
        "UST.G3AP.BOUNDED selected ordinary top: PASS "
        f"leaders={len(exponents)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
