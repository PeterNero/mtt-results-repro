#!/usr/bin/env python3
"""Independently replay the direct selected E=N0D1 Schur certificate."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

import build_ust_g3al_selected_carrier_response_schur as g3al
import build_ust_g3an_selected_cayley_schur_chunk as chunk_builder
import verify_ust_g3ak_full_graph_incidence_normal_decomposition as arithmetic
import verify_ust_g3am_selected_cayley_principal_response as g3am_verify
import ust_cayley_fiber2_reduction as fiber2


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3an_selected_cayley_direct_schur.packet.json"
G3AM_PACKET = ROOT / "state" / "ust_g3am_selected_cayley_principal_response.packet.json"
P = 101
DEGREE = 6
Element = tuple[int, ...]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_hash(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def transpose(matrix: list[list[Element]]) -> list[list[Element]]:
    return [list(row) for row in zip(*matrix)]


def dot(left: list[Element], right: list[Element], relation: tuple[int, ...]) -> Element:
    value = arithmetic.arithmetic.qzero(DEGREE)
    for a, b in zip(left, right):
        value = arithmetic.add(value, arithmetic.mul(a, b, relation))
    return value


def multiply(
    left: list[list[Element]],
    right: list[list[Element]],
    relation: tuple[int, ...],
) -> list[list[Element]]:
    require(left and right and len(left[0]) == len(right), "matrix product dimensions")
    columns = transpose(right)
    return [[dot(row, column, relation) for column in columns] for row in left]


def determinant(matrix: list[list[Element]], relation: tuple[int, ...]) -> Element:
    size = len(matrix)
    require(size > 0 and all(len(row) == size for row in matrix), "square minor")
    zero = arithmetic.arithmetic.qzero(DEGREE)
    result = arithmetic.arithmetic.qone(DEGREE)
    work = [list(row) for row in matrix]
    for column in range(size):
        pivot = next(
            (row for row in range(column, size) if work[row][column] != zero),
            None,
        )
        require(pivot is not None, "nonsingular minor")
        if pivot != column:
            work[column], work[pivot] = work[pivot], work[column]
            result = arithmetic.neg(result)
        pivot_value = work[column][column]
        result = arithmetic.mul(result, pivot_value, relation)
        inverse = arithmetic.inverse(pivot_value, relation, DEGREE)
        for row in range(column + 1, size):
            if work[row][column] == zero:
                continue
            factor = arithmetic.mul(work[row][column], inverse, relation)
            work[row] = [
                arithmetic.sub(value, arithmetic.mul(factor, pivot_entry, relation))
                for value, pivot_entry in zip(work[row], work[column])
            ]
    return result


def decode(raw: bytes, record: dict, label: str) -> list[list[Element]]:
    rows, columns, degree = [int(value) for value in record["shape"]]
    require(degree == DEGREE, f"{label} degree")
    start = int(record["byte_offset"])
    length = int(record["byte_length"])
    require(length == rows * columns * degree, f"{label} byte length")
    data = raw[start : start + length]
    matrix = []
    offset = 0
    for _ in range(rows):
        row = []
        for _ in range(columns):
            row.append(tuple(data[offset : offset + degree]))
            offset += degree
        matrix.append(row)
    require(
        canonical_hash([[list(value) for value in row] for row in matrix])
        == record["canonical_sha256"],
        f"{label} canonical hash",
    )
    return matrix


def main() -> None:
    subprocess.run(
        [sys.executable, str(ROOT / "verify_ust_g3am_selected_cayley_principal_response.py")],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    packet = load(PACKET)
    g3am = load(G3AM_PACKET)
    reduction = fiber2.selected_fiber2_reduction()
    reduction_scope = fiber2.response_reduction_basis(reduction)
    require(
        packet["schema"] == "mtt.unified-source.g3an-selected-cayley-direct-schur.v1",
        "packet schema",
    )
    require(packet["theorem_id"] == "UST.G3AN", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    require(
        packet["inputs"]["selected_G3AP_certificate"]
        == reduction["certificate"]
        and packet["inputs"]["selected_G3AP_source_certificate"]
        == reduction["source_certificate"],
        "canonical G3AP inputs",
    )
    require(
        g3am["inputs"]["selected_G3AP_certificate"]
        == reduction["certificate"]
        and g3am["inputs"]["selected_G3AP_source_certificate"]
        == reduction["source_certificate"],
        "G3AM uses canonical G3AP reduction",
    )
    require(
        packet["reduction_basis"] == reduction_scope,
        "canonical G3AP reduction scope",
    )
    for name, record in packet["inputs"].items():
        path = ROOT / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"input {name}")

    field = packet["residue_field"]
    relation = tuple(int(value) for value in field["gamma_relation_coefficients_ascending"])
    require(field["prime"] == P and field["extension_degree"] == DEGREE, "selected field")
    zero = arithmetic.arithmetic.qzero(DEGREE)
    one = arithmetic.arithmetic.qone(DEGREE)
    frames = g3al.selected_frames()
    carrier_basis = frames["basis"]
    require(
        all(g3am_verify.carrier_row_weight(row) == 10 for row in carrier_basis),
        "every selected carrier section has scalar weight ten",
    )
    pivot = int(frames["projective_pivot"])
    primitive_rows = [
        chunk_builder.section(row)
        for index, row in enumerate(carrier_basis)
        if index != pivot
    ]
    n0 = chunk_builder.decode_n0(g3am)
    quotient_rows_as_polynomials = [
        chunk_builder.linear_polynomial(row, primitive_rows) for row in n0
    ]
    extra_columns = [
        chunk_builder.tangent_polynomial(vector, carrier_basis)
        for vector in frames["extra"]
    ]
    g3al_packet = load(ROOT / packet["inputs"]["G3AL"]["path"])
    cycle = g3al_packet["K3_cycle_source"]
    require(g3am_verify.polynomial_weights(cycle["Q2"]) == {2}, "Q2 scalar degree two")
    require(g3am_verify.polynomial_weights(cycle["G3"]) == {3}, "G3 scalar degree three")
    require(g3am_verify.polynomial_weights(cycle["H4"]) == {4}, "H4 scalar degree four")
    block = packet["direct_schur_response"]
    principal_artifact = block["principal_quotient_artifact"]
    require(
        principal_artifact == g3am["principal_response"]["quotient_artifact"],
        "G3AM principal quotient artifact",
    )
    principal_path = ROOT / principal_artifact["path"]
    require(
        principal_path.is_file()
        and sha256(principal_path) == principal_artifact["sha256"],
        "principal quotient artifact hash",
    )
    require(
        principal_artifact["layout"]["N0"]["shape"] == [215, 248, 6]
        and principal_artifact["layout"]["R0_inverse"]["shape"] == [33, 33, 6],
        "principal quotient certificate shapes",
    )
    artifact = block["binary_artifact"]
    path = ROOT / artifact["path"]
    raw = path.read_bytes()
    require(sha256(path) == artifact["sha256"] and len(raw) == artifact["bytes"], "bundle")
    layout = artifact["layout"]
    e = decode(raw, layout["E_N0D1"], "E")
    require((len(e), len(e[0])) == (215, 89), "E shape")

    replay: dict[tuple[int, int], Element] = {}
    chunk_count = 0
    for name, record in packet["inputs"].items():
        if not name.startswith("chunk_"):
            continue
        chunk = load(ROOT / record["path"])
        require(
            chunk["schema"] == "mtt.unified-source.g3an-selected-cayley-schur-chunk.v1",
            f"{name} schema",
        )
        require(all(chunk["checks"].values()), f"{name} checks")
        for dependency in (
            "G3AL",
            "G3AM",
            "G3AP",
            "G3AP_source",
            "module_cache",
            "principal_quotient",
        ):
            dependency_record = chunk["inputs"][dependency]
            dependency_path = ROOT / dependency_record["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency_record["sha256"],
                f"{name} dependency {dependency}",
            )
        if reduction["base_cache_record"] is None:
            require(chunk["inputs"]["base_cache"] is None, f"{name} no base cache")
        else:
            base_record = chunk["inputs"]["base_cache"]
            base_path = ROOT / base_record["path"]
            require(
                base_path.is_file()
                and sha256(base_path) == base_record["sha256"]
                and base_record["sha256"]
                == reduction["base_cache_record"]["sha256"],
                f"{name} base cache",
            )
        require(
            chunk["inputs"]["G3AP"] == reduction["certificate"]
            and chunk["inputs"]["G3AP_source"]
            == reduction["source_certificate"]
            and chunk["inputs"]["module_cache"]["sha256"]
            == reduction["module_cache_record"]["sha256"]
            and all(
                chunk["reduction_basis"].get(key) == value
                for key, value in reduction_scope.items()
            ),
            f"{name} selected G3AP reduction scope",
        )
        output_path = ROOT / chunk["output"]["path"]
        script_path = ROOT / chunk["script"]["path"]
        require(output_path.is_file() and sha256(output_path) == chunk["output"]["sha256"], f"{name} output")
        require(script_path.is_file() and sha256(script_path) == chunk["script"]["sha256"], f"{name} script")
        script = script_path.read_text(encoding="ascii")
        require("ring r=(101,g)" in script and "ring r=11" not in script, f"{name} field")
        rectangle = chunk["rectangle"]
        row_start = int(rectangle["row_start_zero_based"])
        row_count = int(rectangle["row_count"])
        require(
            script
            == chunk_builder.make_script(
                quotient_rows_as_polynomials[row_start : row_start + row_count],
                extra_columns,
                row_start,
                g3al_packet,
                reduction,
            ),
            f"{name} exact selected-script reconstruction",
        )
        require(
            "poly fixedBase=Pdelta*t0*t1*t2;" in script
            and "module preparedRows=reduce(fixedBase*quotientRows,G);" in script
            and "rowProducts[gi]=preparedRows[ri]*extraColumns[gi];" in script
            and "rowNormals=reduce(rowProducts,G);" in script
            and "entryNormal=rowNormals[gi];" in script,
            f"{name} degree-24 plus degree-10 plus degree-10 response product",
        )
        output = output_path.read_text(encoding="utf-8")
        require("G3AN_SCHUR_CHUNK_PASS" in output, f"{name} pass")
        require(int(rectangle["column_count"]) == 89, f"{name} width")
        for local_row, row in enumerate(rectangle["entries_F1016_singular"]):
            match = re.search(
                rf"^G3AN_SCHUR_ROW_{row_start + local_row}=([^\r\n]*)$",
                output,
                flags=re.MULTILINE,
            )
            require(match is not None and match.group(1).split(",") == row, f"{name} raw row")
            for column, value in enumerate(row):
                cell = (row_start + local_row, column)
                require(cell not in replay, f"duplicate E cell {cell}")
                replay[cell] = g3am_verify.field_value(value, relation)
        chunk_count += 1
    require(
        set(replay) == {(row, column) for row in range(215) for column in range(89)},
        "full E chunk coverage",
    )
    require(
        e == [[replay[(row, column)] for column in range(89)] for row in range(215)],
        "raw chunks equal E",
    )
    _, e_column_pivots = arithmetic.rref(e, relation, DEGREE)
    _, e_row_pivots = arithmetic.rref(transpose(e), relation, DEGREE)
    rank_e = len(e_column_pivots)
    require(rank_e == len(e_row_pivots) == block["rank_E"], "rank E")
    require(block["rank_D0"] == 33, "rank D0")
    require(block["rank_D"] == 33 + rank_e, "Schur rank identity")
    require(block["full_left_nullity"] == 248 - 33 - rank_e, "left nullity")
    require(block["products_reduced"] == 215 * 89, "direct product count")
    require(
        block["nonzero_entries"] == sum(value != zero for row in e for value in row),
        "nonzero entries",
    )

    quotient_rows = [
        int(value)
        for value in g3am["principal_response"]["principal_quotient_row_indices_zero_based"]
    ]
    principal_rows = [
        int(value)
        for value in g3am["principal_response"]["independent_row_indices_zero_based"]
    ]
    require(
        len(principal_rows) == 33
        and len(quotient_rows) == 215
        and sorted(principal_rows + quotient_rows) == list(range(248))
        and block["principal_pivot_rows_zero_based"] == principal_rows
        and block["principal_quotient_rows_zero_based"] == quotient_rows,
        "G3AM principal row partition",
    )
    if rank_e == 89:
        l_operator = decode(raw, layout["L_extra_quotient"], "L")
        e0_inverse = decode(raw, layout["E0_inverse"], "E0 inverse")
        pivot_rows = [
            int(value)
            for value in block["extra_pivot_rows_in_principal_quotient_zero_based"]
        ]
        final_rows = [
            int(value)
            for value in block["final_normal_rows_in_principal_quotient_zero_based"]
        ]
        require(pivot_rows == e_row_pivots and len(final_rows) == 126, "E row split")
        require(sorted(pivot_rows + final_rows) == list(range(215)), "E row partition")
        e0 = [e[row] for row in pivot_rows]
        e_minor_determinant = determinant(e0, relation)
        require(
            list(e_minor_determinant)
            == block["Schur_rank_minor_determinant_gamma_coefficients_ascending"],
            "Schur minor determinant",
        )
        principal_determinant = tuple(
            int(value)
            for value in g3am["principal_response"][
                "rank_minor_determinant_gamma_coefficients_ascending"
            ]
        )
        full_minor_determinant = arithmetic.mul(
            principal_determinant, e_minor_determinant, relation
        )
        require(full_minor_determinant != zero, "nonzero full response minor")
        require(
            list(full_minor_determinant)
            == block[
                "factored_full_response_minor_determinant_gamma_coefficients_ascending"
            ],
            "factored full response minor determinant",
        )
        require(
            block["full_rank_minor_ordered_original_rows_zero_based"]
            == principal_rows + [quotient_rows[row] for row in pivot_rows],
            "full response minor rows",
        )
        require(
            multiply(e0_inverse, e0, relation)
            == [[one if row == column else zero for column in range(89)] for row in range(89)],
            "E0 inverse",
        )
        require((len(l_operator), len(l_operator[0])) == (126, 215), "L shape")
        require(multiply(l_operator, e, relation) == [[zero] * 89 for _ in range(126)], "LE=0")
        require(
            all(
                l_operator[row][column] == (one if row == index else zero)
                for row in range(126)
                for index, column in enumerate(final_rows)
            ),
            "L identity minor",
        )
        nfull_identity_columns = [quotient_rows[index] for index in final_rows]
        require(len(set(nfull_identity_columns)) == 126, "rank-126 Nfull identity columns")
    else:
        require("L_extra_quotient" not in layout and "E0_inverse" not in layout, "no false L")
        require(
            block["Schur_rank_minor_determinant_gamma_coefficients_ascending"] is None
            and block[
                "factored_full_response_minor_determinant_gamma_coefficients_ascending"
            ]
            is None
            and not block["full_rank_minor_ordered_original_rows_zero_based"],
            "no false full-rank minor",
        )
    print(
        f"UST.G3AN direct selected Schur: PASS rank(E)={rank_e} "
        f"rank(D)={33+rank_e} left_nullity={248-33-rank_e} chunks={chunk_count}"
    )
    print("characteristic-zero promotion and same-source beta_C remain open")


if __name__ == "__main__":
    main()
