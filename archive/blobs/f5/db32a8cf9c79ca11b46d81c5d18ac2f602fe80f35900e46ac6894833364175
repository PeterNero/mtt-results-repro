@cache
def q79_sm_boundary_crossing_line_reduction() -> dict[str, Any]:
    freshness = source_freshness()
    local_regulator = q79_sm_local_auxiliary_elliptic_bv_regulator()
    shell_comparison = (
        q79_sm_finite_shell_bv_pushforward_regulator_comparison()
    )
    phase_quotient = q79_sm_determinant_phase_torsor_quotient()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    source_rows = {
        row["id"]: row for row in freshness["sources"]
    }
    manifest_sources = {
        row["id"]: row for row in manifest["sources"]
    }
    shared_line_packet = json.loads(
        (
            ROOT
            / manifest_sources["MLD_Q79_UNIVERSAL_SHARED_LINE"]["path"]
        )
        .resolve()
        .read_text(encoding="utf-8")
    )
    determinant_type_packet = json.loads(
        (
            ROOT
            / manifest_sources[
                "SM_FLAVOR_VS_ANALYTIC_DETERMINANT_TYPE"
            ]["path"]
        )
        .resolve()
        .read_text(encoding="utf-8")
    )
    external_names = {
        row["name"]
        for row in manifest["external_theorems"]
        if "name" in row
    }

    source_checks = {
        "all_hash_pinned_sources_are_current": freshness["all_current"],
        "shared_line_packet_is_current": (
            source_rows["MLD_Q79_UNIVERSAL_SHARED_LINE"]["state"]
            == "current"
        ),
        "determinant_type_guardrail_packet_is_current": (
            source_rows[
                "SM_FLAVOR_VS_ANALYTIC_DETERMINANT_TYPE"
            ]["state"]
            == "current"
        ),
        "prior_local_regulator_certificate_passes": (
            local_regulator["all_checks_pass"]
        ),
        "prior_finite_shell_comparison_certificate_passes": (
            shell_comparison["all_checks_pass"]
        ),
        "prior_common_phase_quotient_certificate_passes": (
            phase_quotient["all_checks_pass"]
        ),
        "registered_crossing_path_has_spectral_flow_one": (
            shell_comparison["crossing_cutset"]["boundary_path"]
            == "A(s)=diag(-2,s,3), -1<=s<=1"
            and shell_comparison["crossing_cutset"]["spectral_flow"]
            == 1
        ),
        "local_APS_package_assigns_zero_mode_to_adjoint_complement": (
            local_regulator["APS_checks"][
                "zero_boundary_mode_is_assigned_once_to_adjoint_domain"
            ]
        ),
        "Booss_Bavnbek_Lesch_Phillips_is_registered": (
            "Booss-Bavnbek-Lesch-Phillips spectral flow"
            in external_names
        ),
        "Kirk_Lesch_boundary_theorem_is_registered": (
            "Kirk-Lesch eta Maslov spectral-flow boundary theorem"
            in external_names
        ),
        "Dai_Freed_determinant_line_theorem_is_registered": (
            "Dai-Freed eta determinant-line holonomy"
            in external_names
        ),
    }

    a_minus = diagonal(
        [Fraction(-2), Fraction(-1), Fraction(3)]
    )
    a_zero = diagonal(
        [Fraction(-2), Fraction(0), Fraction(3)]
    )
    a_plus = diagonal(
        [Fraction(-2), Fraction(1), Fraction(3)]
    )
    a_derivative = diagonal(
        [Fraction(0), Fraction(1), Fraction(0)]
    )
    p_minus = diagonal(
        [Fraction(1), Fraction(1), Fraction(0)]
    )
    p_zero = diagonal(
        [Fraction(1), Fraction(0), Fraction(0)]
    )
    p_plus = diagonal(
        [Fraction(1), Fraction(0), Fraction(0)]
    )
    p_crossing = diagonal(
        [Fraction(0), Fraction(1), Fraction(0)]
    )
    e0 = [[Fraction(1)], [Fraction(0)], [Fraction(0)]]
    e1 = [[Fraction(0)], [Fraction(1)], [Fraction(0)]]

    def negative_count(matrix: list[list[Fraction]]) -> int:
        return sum(
            1
            for index in range(len(matrix))
            if matrix[index][index] < 0
        )

    crossing_form = mul(
        transpose(e1),
        mul(a_derivative, e1),
    )[0][0]
    spectral_flow = (
        negative_count(a_minus) - negative_count(a_plus)
    )
    exact_crossing_checks = {
        "endpoint_operators_are_self_adjoint": (
            transpose(a_minus) == a_minus
            and transpose(a_plus) == a_plus
        ),
        "crossing_operator_has_one_dimensional_kernel": (
            rank(a_zero) == 2
            and rank(p_crossing) == 1
            and mul(a_zero, p_crossing) == zeros(3, 3)
        ),
        "negative_projectors_are_exact": (
            mul(p_minus, p_minus) == p_minus
            and mul(p_plus, p_plus) == p_plus
            and transpose(p_minus) == p_minus
            and transpose(p_plus) == p_plus
        ),
        "zero_mode_rule_matches_registered_APS_cutset": (
            p_zero == p_plus
        ),
        "negative_rank_drops_from_two_to_one": (
            rank(p_minus) == 2
            and rank(p_zero) == 1
            and rank(p_plus) == 1
        ),
        "crossing_line_is_orthogonal_to_final_negative_space": (
            mul(p_crossing, p_plus) == zeros(3, 3)
            and mul(p_plus, p_crossing) == zeros(3, 3)
        ),
        "initial_negative_space_splits_as_final_plus_crossing": (
            add(p_plus, p_crossing) == p_minus
        ),
        "crossing_form_is_exactly_positive_one": (
            crossing_form == 1
        ),
        "spectral_flow_is_exactly_positive_one": (
            spectral_flow == 1
        ),
        "rank_obstruction_excludes_unitary_projector_conjugacy": (
            rank(p_minus) != rank(p_plus)
        ),
        "minimal_stabilization_dimension_is_one": (
            rank(p_minus) - rank(p_plus) == 1
        ),
    }

    def wedge_two(
        left: list[list[Fraction]],
        right: list[list[Fraction]],
    ) -> list[Fraction]:
        left_values = [row[0] for row in left]
        right_values = [row[0] for row in right]
        return [
            left_values[0] * right_values[1]
            - left_values[1] * right_values[0],
            left_values[0] * right_values[2]
            - left_values[2] * right_values[0],
            left_values[1] * right_values[2]
            - left_values[2] * right_values[1],
        ]

    initial_determinant_basis = wedge_two(e0, e1)
    determinant_factorization_checks = {
        "initial_determinant_basis_is_e0_wedge_e1": (
            initial_determinant_basis
            == [Fraction(1), Fraction(0), Fraction(0)]
        ),
        "determinant_dimensions_factor_as_two_equals_one_plus_one": (
            rank(p_minus)
            == rank(p_plus) + rank(p_crossing)
        ),
        "orthogonal_exact_sequence_splits": (
            mul(p_plus, p_crossing) == zeros(3, 3)
            and add(p_plus, p_crossing) == p_minus
        ),
        "scalar_comparison_requires_crossing_line_trivialization": (
            rank(p_crossing) == 1
            and rank(p_minus) != rank(p_plus)
        ),
    }

    Gaussian = tuple[Fraction, Fraction]
    zero_g: Gaussian = (Fraction(0), Fraction(0))
    one_g: Gaussian = (Fraction(1), Fraction(0))
    phases: list[Gaussian] = [
        one_g,
        (Fraction(0), Fraction(1)),
        (Fraction(-1), Fraction(0)),
        (Fraction(0), Fraction(-1)),
    ]
    a_path_gaussian = [
        g_from_rational_matrix(matrix)
        for matrix in (a_minus, a_zero, a_plus)
    ]
    projector_gaussian = [
        g_from_rational_matrix(matrix)
        for matrix in (p_minus, p_plus, p_crossing)
    ]
    crossing_vector = [[zero_g], [one_g], [zero_g]]
    stabilizer_rows = []
    transformed_crossing_vectors = []
    for phase in phases:
        stabilizer = g_eye(3)
        stabilizer[1][1] = phase
        stabilizer_adjoint = g_transpose_conjugate(stabilizer)
        transformed_vector = g_mul_matrix(
            stabilizer,
            crossing_vector,
        )
        transformed_crossing_vectors.append(transformed_vector)
        stabilizer_rows.append(
            {
                "phase": {
                    "real": str(phase[0]),
                    "imaginary": str(phase[1]),
                },
                "unitary": (
                    g_mul_matrix(stabilizer_adjoint, stabilizer)
                    == g_eye(3)
                ),
                "fixes_entire_operator_path": all(
                    g_mul_matrix(
                        g_mul_matrix(stabilizer, operator),
                        stabilizer_adjoint,
                    )
                    == operator
                    for operator in a_path_gaussian
                ),
                "fixes_all_projectors": all(
                    g_mul_matrix(
                        g_mul_matrix(stabilizer, projector),
                        stabilizer_adjoint,
                    )
                    == projector
                    for projector in projector_gaussian
                ),
                "crossing_vector": gaussian_matrix_strings(
                    transformed_vector
                ),
            }
        )

    stabilizer_checks = {
        "four_exact_stabilizer_phases_are_distinct": (
            len(set(phases)) == 4
        ),
        "all_stabilizers_are_unitary": all(
            row["unitary"] for row in stabilizer_rows
        ),
        "all_stabilizers_fix_the_operator_path": all(
            row["fixes_entire_operator_path"]
            for row in stabilizer_rows
        ),
        "all_stabilizers_fix_the_projector_data": all(
            row["fixes_all_projectors"]
            for row in stabilizer_rows
        ),
        "stabilizers_act_nontrivially_on_crossing_line": (
            len(
                {
                    tuple(entry for row in vector for entry in row)
                    for vector in transformed_crossing_vectors
                }
            )
            == 4
        ),
        "minus_one_has_no_nonzero_fixed_vector_on_crossing_line": (
            phases[2] != one_g
            and transformed_crossing_vectors[2]
            != crossing_vector
        ),
        "source_free_equivariant_unit_selector_is_impossible": (
            stabilizer_rows[0]["fixes_entire_operator_path"]
            and stabilizer_rows[2]["fixes_entire_operator_path"]
            and transformed_crossing_vectors[2]
            != crossing_vector
        ),
    }

    two_torsion_z64 = [
        value
        for value in range(64)
        if (2 * value) % 64 == 0
