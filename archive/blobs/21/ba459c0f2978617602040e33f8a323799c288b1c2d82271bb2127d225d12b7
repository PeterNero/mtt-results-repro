    require(all(packet["checks"].values()), "packet checks")
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print("UST.G3CN pole-six family transform first jet: PASS")
    print(
        f"groups={len(summaries)} active_columns={total_active} "
        f"exact_update_nnz={total_exact_update_nonzeros} "
        f"mod11_update_nnz={total_good_reduction_update_nonzeros} "
        f"quotient_jet_nnz={total_quotient_nonzeros}"
    )


if __name__ == "__main__":
