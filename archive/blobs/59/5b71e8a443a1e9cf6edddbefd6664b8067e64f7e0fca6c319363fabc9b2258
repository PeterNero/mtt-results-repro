def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def payload_record(path: Path) -> dict[str, str]:
    return {
        "path": path.relative_to(STATE).as_posix(),
        "sha256": sha256(path),
    }


def dump(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, ensure_ascii=True) + "\n", encoding="ascii")


def rational(value: Fraction | int) -> list[int]:
    value = Fraction(value)
    return [value.numerator, value.denominator]


def point(real: Fraction | int = 0, imag: Fraction | int = 0) -> dict[str, Any]:
    return {
        "real": {"lower": rational(real), "upper": rational(real)},
        "imag": {"lower": rational(imag), "upper": rational(imag)},
    }


def exact_complex(real: Fraction | int = 0, imag: Fraction | int = 0) -> dict[str, Any]:
    return {"real": rational(real), "imag": rational(imag)}


def vector(entries: dict[int, Fraction | int]) -> list[dict[str, Any]]:
    return [point(entries.get(index, 0)) for index in range(DIMENSION)]


def linear_combination(columns, coefficients):
    result: dict[int, Fraction] = {}
    for coefficient, column in zip(coefficients, columns, strict=True):
        for index, value in column.items():
            result[index] = result.get(index, Fraction(0)) + coefficient * Fraction(value)
    return vector(result)


def write_certificate(path: Path, value: dict[str, Any]) -> Path:
    dump(path, value)
    return path


