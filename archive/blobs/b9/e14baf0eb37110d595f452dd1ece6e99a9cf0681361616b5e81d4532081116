    require(
        int(scalars["SOURCE_ROWS"]) == 92979
        and int(scalars["TARGET_COORDINATES"])
        == macaulay.EXPECTED_TARGET_COORDINATES
        and int(scalars["MATRIX_NONZEROS"])
        == incremental_campaign["matrix"]["nonzeros"]
        and int(scalars["MINOR_SIZE"]) == TARGET_RANK
        and minor.determinant(
            vectors["PIVOT_TARGET_COORDINATES_ZERO_BASED"],
            vectors["PIVOT_COEFFICIENTS_PACKED"],
        )
        == int(scalars["MINOR_DETERMINANT_PACKED"])
        != 0,
        "incremental exact rank transcript",
    )
    if "linbox_givaro_sparse_elimination" in witness["engines"]:
        linbox = witness["engines"]["linbox_givaro_sparse_elimination"]
        linbox_output = checked(linbox["output"], "LinBox output")
        checked(linbox["source"], "LinBox source")
        checked(linbox["binary"], "LinBox binary")
        linbox_shape = shared_runner.parse_linbox(
            linbox_output.read_text(encoding="utf-8")
        )
        require(
            linbox_shape[0] == linbox_shape[1] == linbox_shape[3] == TARGET_RANK
            and linbox_shape[2] == extraction["minor"]["nonzeros"],
            "independent exact incremental minor rank",
        )
        independent_rank_route = "monolithic_selected_minor"
    elif "givaro_map_pivot_replay" in witness["engines"]:
        checked(
            witness["inputs"]["givaro_map_replay_lemma"],
            "Givaro-map replay lemma",
        )
        replay = witness["engines"]["givaro_map_pivot_replay"]
        replay_source = checked(replay["source"], "Givaro-map replay source")
        checked(replay["binary"], "Givaro-map replay binary")
        checked(replay["selftest_matrix"], "Givaro-map self-test matrix")
        checked(replay["selftest_output"], "Givaro-map self-test output")
        checked(replay["pivot_order_extraction"], "pivot-order extraction")
        pivot_minor = checked(replay["pivot_order_minor"], "pivot-order minor")
        replay_output = checked(replay["output"], "Givaro-map replay output")
        replay_shape = givaro_witness.parse_replay(
            givaro_witness.read_replay(replay_output)
        )
        require(
            replay_shape[:5]
            == (
                TARGET_RANK,
                TARGET_RANK,
                extraction["minor"]["nonzeros"],
                TARGET_RANK,
                int(scalars["MINOR_DETERMINANT_PACKED"]),
