{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mtt/preprojection/certificate.schema.json",
  "title": "MTT preprojection research certificate",
  "type": "object",
  "required": ["schema", "id", "tier", "claim", "checks", "all_passed", "guard"],
  "properties": {
    "schema": {"const": "mtt.preprojection.certificate.v1"},
    "id": {"type": "string"},
    "tier": {"type": "string"},
    "claim": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "all_passed": {"type": "boolean"},
    "guard": {"type": "string"}
  },
  "additionalProperties": true
}
