"""Build the reference-source registry for SM-equivalence measured data."""

from __future__ import annotations

import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "candidate_data"
CERTS = ROOT / "certificates"
CORPUS = ROOT / "proof_corpus"

MANIFEST = DATA / "sm_equivalence_measured_parameter_replay_manifest.candidate.json"
OUTPUT = DATA / "sm_equivalence_reference_source_registry.candidate.json"
CERT = CERTS / "sm_equivalence_reference_source_registry_certificate.json"
NOTE = CORPUS / "MTT_SM_Equivalence_Reference_Source_Registry_v1.md"

STATUS = "MTT_SM_EQUIVALENCE_REFERENCE_SOURCE_REGISTRY_BUILT_VALUES_OPEN"
NEXT = "MTT_SM_Equivalence_Reference_Data_Values_Fill_v1"


def rel(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT)).replace("\\", "/")
    except ValueError:
        return str(path)


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    manifest = load(MANIFEST)

    source_registry = {
        "PDG_2025": {
            "source_name": "Particle Data Group Review of Particle Physics 2025 update",
            "source_url": "https://pdg.lbl.gov/2025/",
            "api_or_download_url": "https://pdg.lbl.gov/api",
            "scope": [
                "particle masses",
                "decay data where needed for replay checks",
                "CKM and quark-mixing references",
                "Higgs and electroweak summary data",
                "quark and charged-lepton summary values",
            ],
            "edition_policy": "Use 2025 update unless a later PDG edition is explicitly frozen.",
            "source_status": "APPROVED_REFERENCE_SOURCE_VALUES_NOT_COPIED",
        },
        "NIST_CODATA_2022": {
            "source_name": "NIST/CODATA 2022 recommended values of fundamental physical constants",
            "source_url": "https://www.nist.gov/pml/fundamental-physical-constants",
            "database_url": "https://physics.nist.gov/constants",
            "scope": [
                "dimensionful constants",
                "unit conversions",
                "electromagnetic constants where a replay convention requires SI anchoring",
            ],
            "edition_policy": "Use CODATA 2022 Web Version 9.0 unless a later CODATA release is explicitly frozen.",
            "source_status": "APPROVED_REFERENCE_SOURCE_VALUES_NOT_COPIED",
        },
        "NuFIT_6_0": {
            "source_name": "NuFIT 6.0 three-neutrino global fit",
            "source_url": "https://www.nu-fit.org/?q=node/294",
            "publication_url": "https://link.springer.com/article/10.1007/JHEP12%282024%29216",
            "scope": [
                "PMNS angles and phase conventions",
                "neutrino mass-squared splittings",
                "mass ordering policy",
            ],
            "edition_policy": "Use NuFIT 6.0 global data as of September 2024 unless a later NuFIT release is explicitly frozen.",
            "source_status": "APPROVED_REFERENCE_SOURCE_VALUES_NOT_COPIED",
        },
    }

    slot_source_map = {
        "gauge.alpha_1_alpha_2_alpha_3": ["PDG_2025", "NIST_CODATA_2022"],
        "yukawa.Y_u_Y_d_Y_e": ["PDG_2025", "NIST_CODATA_2022"],
        "mixing.CKM": ["PDG_2025"],
        "mixing.PMNS": ["NuFIT_6_0", "PDG_2025"],
        "higgs.v_mh_lambda_or_potential": ["PDG_2025", "NIST_CODATA_2022"],
        "neutrino.yukawa_or_mass_splittings": ["NuFIT_6_0", "PDG_2025"],
    }

    fill_contract = {
        "values_filled_here": False,
        "next_values_fill_must": [
            "record a source key from this registry for every numeric value",
            "record retrieval date and edition",
            "record units, scheme, scale, and basis conventions",
            "record uncertainty and correlation policy",
            "preserve the selected source boundary unchanged",
            "write all conversion formulas used to map reference values into replay slots",
        ],
        "disallowed_sources": [
            "uncited memory values",
            "blog or forum tables as primary data",
            "inverse-fit values generated by this repo",
            "any value chosen because it improves MTT residuals",
        ],
    }

    candidate = {
        "candidate": "MTTSMEquivalenceReferenceSourceRegistry",
        "status": STATUS,
        "inputs": {
            "measured_parameter_replay_manifest": rel(MANIFEST),
        },
        "source_registry": source_registry,
        "slot_source_map": slot_source_map,
        "fill_contract": fill_contract,
        "superset_strategy_use": manifest["superset_strategy_use"],
        "what_closes_now": {
            "approved_reference_source_registry": True,
            "slot_to_source_mapping": True,
            "values_fill_contract": True,
            "source_selection_guardrails_preserved": True,
        },
        "what_remains_open": {
            "numeric_reference_values": True,
            "value_conversion_formulas": True,
            "actual_numeric_tree_level_replay": True,
            "RG_scheme_transport_replay": True,
            "empirical_equivalence_audit_run": True,
            "full_SM_equivalence_closure": True,
            "full_no_knob_closure": True,
        },
        "closure_claimed": False,
        "sm_equivalence_claimed": False,
        "no_knob_closure_claimed": False,
        "observed_data_used_as_selector": False,
        "target_fitting_used": False,
        "next_required_artifact": NEXT,
        "theorem": {
            "name": "SMEquivalenceReferenceSourceRegistryTheorem",
            "proved": True,
            "statement": (
                "The measured replay manifest has a versioned reference-source registry sufficient "
                "to fill SM-equivalence values in the next artifact. The registry authorizes PDG, "
                "NIST/CODATA, and NuFIT sources for their respective slots, while forbidding uncited, "
                "inverse-fit, or residual-selected values."
            ),
        },
    }

    cert = {
        "status": STATUS,
        "candidate_path": rel(OUTPUT),
        "note_path": rel(NOTE),
        "theorem_proved": True,
        "closure_claimed": False,
        "sm_equivalence_claimed": False,
        "no_knob_closure_claimed": False,
        "observed_data_used_as_selector": False,
        "target_fitting_used": False,
        "what_closes": candidate["what_closes_now"],
        "what_remains_open": candidate["what_remains_open"],
        "next_required_artifact": NEXT,
    }

    note = f"""# MTT SM-Equivalence Reference Source Registry v1

Status: `{STATUS}`.

## Result

The measured replay now has approved external reference sources, but no numeric
values are copied in this artifact.

- PDG 2025: particle data, CKM, Higgs/electroweak, quark and charged-lepton references.
- NIST/CODATA 2022: fundamental constants, SI anchors, and unit conversions.
- NuFIT 6.0: neutrino oscillation parameters and PMNS conventions.

## Guardrail

This registry is still downstream of the selected source boundary.  It cannot
select topology, operators, branches, dynamic overlap tensors, or no-knob
kernels.  The next artifact, `{NEXT}`, must freeze values and conversion
formulas before numeric replay.
"""

    OUTPUT.write_text(json.dumps(candidate, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    CERT.write_text(json.dumps(cert, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    NOTE.write_text(note, encoding="utf-8")
    print(json.dumps({"candidate": rel(OUTPUT), "status": STATUS}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
