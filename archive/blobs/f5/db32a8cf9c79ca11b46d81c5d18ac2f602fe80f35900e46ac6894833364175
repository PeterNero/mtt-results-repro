def shared_circle_marked_poisson_actualization() -> dict[str, Any]:
    rates = [Fraction(1, 6), Fraction(1, 3), Fraction(1, 2)]
    total_rate = Fraction(12)
    channel_rates = [total_rate * rate for rate in rates]
    first_capture_probabilities = [
        channel_rate / sum(channel_rates, Fraction(0))
        for channel_rate in channel_rates
    ]
    coarse_rates = [
        rates[0] + rates[1],
        rates[2],
    ]

    survival_at_checkpoint = Fraction(1, 4)
    capture_mass_at_checkpoint = 1 - survival_at_checkpoint
    channel_capture_masses = [
        capture_mass_at_checkpoint * rate for rate in rates
    ]

    rescaled_total_rate = Fraction(35)
    rescaled_channel_rates = [
        rescaled_total_rate * rate for rate in rates
    ]
    rescaled_first_capture_probabilities = [
        channel_rate / sum(rescaled_channel_rates, Fraction(0))
        for channel_rate in rescaled_channel_rates
    ]

    p = reynolds_two_copy_s3()
    q = sub(eye(6), p)
    q79_rates = [p[0][0], q[0][0]]
    q79_total_rate = Fraction(15)
    q79_channel_rates = [
        q79_total_rate * rate for rate in q79_rates
    ]

    identity_2 = eye(2)
    rho_axis_ensemble = scale(Fraction(1, 2), identity_2)
    plus_projector = [
        [Fraction(1, 2), Fraction(1, 2)],
        [Fraction(1, 2), Fraction(1, 2)],
    ]
    minus_projector = [
        [Fraction(1, 2), Fraction(-1, 2)],
        [Fraction(-1, 2), Fraction(1, 2)],
    ]
    rho_rotated_ensemble = scale(
        Fraction(1, 2),
        add(plus_projector, minus_projector),
    )
    effects = [
        [[Fraction(1), Fraction(0)], [Fraction(0), Fraction(0)]],
        [[Fraction(0), Fraction(0)], [Fraction(0), Fraction(1)]],
    ]

    def trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum(
            (matrix[index][index] for index in range(len(matrix))),
            Fraction(0),
        )

    def trace_probability(
        density: list[list[Fraction]], effect: list[list[Fraction]]
    ) -> Fraction:
        return trace(mul(density, effect))

    axis_probabilities = [
        trace_probability(rho_axis_ensemble, effect) for effect in effects
    ]
    rotated_probabilities = [
        trace_probability(rho_rotated_ensemble, effect) for effect in effects
