#!/usr/bin/env python3
"""Independently verify the G3CG Schur-Riccati transport cutset."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3cg_schur_riccati_transport_cutset.packet.json"
PRIME = 11


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def rank_mod_prime(matrix: np.ndarray) -> int:
    work = np.asarray(matrix, dtype=np.int64).copy() % PRIME
    rows, columns = work.shape
    rank = 0
    for column in range(columns):
        candidates = np.flatnonzero(work[rank:, column])
        if candidates.size == 0:
            continue
        selected = rank + int(candidates[0])
        if selected != rank:
            work[[rank, selected]] = work[[selected, rank]]
        work[rank] = work[rank] * pow(int(work[rank, column]), -1, PRIME) % PRIME
        active = np.flatnonzero(work[:, column])
        active = active[active != rank]
        for start in range(0, active.size, 97):
            batch = active[start : start + 97]
            work[batch] = (
                work[batch] - work[batch, column, None] * work[rank]
            ) % PRIME
        rank += 1
        if rank == rows:
            break
    return rank


def main() -> None:
    packet = load(PACKET)
    require(packet["schema"] == "mtt.unified-source.g3cg-schur-riccati-transport-cutset.v1", "schema")
    require(packet["theorem_id"] == "UST.G3CG", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    g3cd = load(verify_record(packet["inputs"]["G3CD"]))
    g3ce = load(verify_record(packet["inputs"]["G3CE"]))
    load(verify_record(packet["inputs"]["G3CF"]))
    require(g3cd["selected_affine_source"]["unscaled_equation_convention"].startswith("dy/da=K_C*y+b_C"), "connection convention")

    X = np.load(verify_record(g3ce["block_decomposition"]["lower_response"]), allow_pickle=False).astype(np.int64)
    S = np.load(verify_record(g3ce["schur_operator"]["operator"]), allow_pickle=False).astype(np.int64)
    b_eff = np.load(verify_record(g3ce["effective_affine_source"]["source"]), allow_pickle=False).astype(np.int64)
    stored_X_prime = np.load(verify_record(packet["dynamic_riccati_cutset"]["required_X_prime_at_a0"]), allow_pickle=False).astype(np.int64)
    stored_y_prime = np.load(verify_record(packet["dynamic_riccati_cutset"]["required_y_prime_at_a0"]), allow_pickle=False).astype(np.int64)
    stored_affine = np.load(verify_record(packet["constant_graph_tangency_defect"]["affine_defect"]), allow_pickle=False).astype(np.int64)

    homogeneous = X @ S % PRIME
    source = X @ b_eff % PRIME
    affine = np.column_stack([homogeneous, source]) % PRIME
    require(np.array_equal(stored_X_prime % PRIME, -homogeneous % PRIME), "required X prime")
    require(np.array_equal(stored_y_prime % PRIME, -source % PRIME), "required y prime")
    require(np.array_equal(stored_affine % PRIME, affine), "affine defect payload")

    rank_X = rank_mod_prime(X)
    rank_homogeneous = rank_mod_prime(homogeneous)
    rank_affine = rank_mod_prime(affine)
    require(rank_X == packet["static_graph"]["X_rank_mod11"] == 248, "X rank")
    require(rank_homogeneous == packet["constant_graph_tangency_defect"]["homogeneous_rank_mod11"] == 247, "homogeneous defect rank")
    require(rank_affine == packet["constant_graph_tangency_defect"]["affine_rank_mod11"] == 248, "affine defect rank")
    require(np.count_nonzero(source) == packet["constant_graph_tangency_defect"]["source_nonzero_entries"] == 1132, "source support")

    print("UST.G3CG Schur-Riccati transport cutset verifier: PASS")
    print(f"rankX={rank_X} rank_XS={rank_homogeneous} rank_affine={rank_affine} actual_jets=open")


if __name__ == "__main__":
    main()
