#!/usr/bin/env python3
"""Run the exact G3AP quotient module with Singular's qslimgb path."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
BASE_CACHE = qring.BASE_CACHE
SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_qslimgb.sing"
OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_qslimgb.singular.out"
MODULE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qslimgb_degree44.ssi"
PACKET = STATE / "ust_g3ap_selected_cayley_fiber2_qslimgb.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def qslimgb_script(source: str) -> str:
    before, after = qring.derivative_representatives()
    generators = ",\n  ".join(qring.derivative_generators())
    base_relative = str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/")
    return fiber2.selected_base_prefix(source) + f'''LIB("standard.lib");
option(noredTail);
{before}
def cachedBase=read("ssi:r {base_relative}");
ideal GI=cachedBase;
attrib(GI,"isSB",1);
int i;
print("G3AP_F2_QSLIM_BASE_GB_SIZE="+string(size(GI)));
for (i=1;i<=size(GI);i++)
{{ print("G3AP_F2_QSLIM_BASE_LEADER_"+string(i)+"_EXP="+string(leadexp(GI[i]))); }}
qring q=GI;
{after}
module M=
  {generators};
intvec componentShifts=12,15,8,18,11,4;
attrib(M,"isHomog",componentShifts);
degBound=44;
module G=qslimgb(M);
print("G3AP_F2_QSLIM_BOUND="+string(degBound));
print("G3AP_F2_QSLIM_MODULE_GENERATORS="+string(size(M)));
print("G3AP_F2_QSLIM_MODULE_GB_SIZE="+string(size(G)));
for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_QSLIM_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_QSLIM_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isSB",0);
write("ssi:w {module_relative}",G);
print("G3AP_F2_QSLIM_LEADER_EXPORT_PASS");
quit;
'''


def parse_bases(raw: str) -> tuple[list[tuple[int, ...]], list[tuple[int, tuple[int, ...]]]]:
    normalized = raw.replace("G3AP_F2_QSLIM_", "G3AP_F2_QRING_")
    return qring.parse_leaders(normalized)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    source = SOURCE.read_text(encoding="ascii")
    SCRIPT.write_text(qslimgb_script(source), encoding="ascii")
    if args.emit_only:
        print(f"emitted {SCRIPT.relative_to(ROOT)}")
        return
    require(BASE_CACHE.is_file() and BASE_CACHE.stat().st_size > 0, "base cache")
    MODULE_CACHE.unlink(missing_ok=True)
    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, "qslimgb execution")
    require("G3AP_F2_QSLIM_LEADER_EXPORT_PASS" in completed.stdout, "qslimgb pass")
    require(MODULE_CACHE.is_file() and MODULE_CACHE.stat().st_size > 0, "module cache")
    base, module = parse_bases(completed.stdout)
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "unique top standard")
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-qslimgb-top.v1",
        "date": "2026-08-10",
        "theorem_id": "UST.G3AP.FIBER2.QSLIMGB",
        "status": "CLOSED_EXACT_SELECTED_F1016_FIBER2_QSLIMGB_TOP_DIMENSION_ONE",
        "inputs": {
            "selected_source": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            },
            "base_cache": {
                "path": str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BASE_CACHE),
                "bytes": BASE_CACHE.stat().st_size,
                "isSB_trust_attribute_stored": False,
            },
        },
        "execution": {
            "script": {
                "path": str(SCRIPT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SCRIPT),
            },
            "output": {
                "path": str(OUTPUT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(OUTPUT),
            },
            "returncode": completed.returncode,
            "elapsed_seconds": time.time() - started,
            "base_basis_size": len(base),
            "module_generator_count": 21,
            "module_basis_size_through_bound": len(module),
            "scalar_degree_bound": 44,
            "bounded_module_cache": {
                "path": str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(MODULE_CACHE),
                "bytes": MODULE_CACHE.stat().st_size,
                "valid_through_base_scalar_degree": 44,
                "isSB_trust_attribute_stored": False,
            },
        },
        "fiber_degree_two_module": {
            "base_quotient": "B/(K,E,C)",
            "components": [name for _, name, _, _ in fiber2.COMPONENTS],
            "component_scalar_shifts": [shift for _, _, _, shift in fiber2.COMPONENTS],
            "sectors": sectors,
        },
        "ordinary_top_piece": {
            "Cox_degree": [18, 2, 2],
            "scalar_weight": 44,
            "enumerated_monomials": total,
            "dimension": 1,
            "basis": ["w^12*t2^4*s^2"],
            "basis_component": "s2",
            "basis_base_exponent": list(fiber2.EXPECTED_STANDARD[1]),
        },
        "checks": {
            "selected_source_and_base_cache_are_hash_bound": True,
            "qslimgb_adds_the_base_quotient_ideal_componentwise": True,
            "the_exact_21_derivative_vectors_are_used": True,
            "the_degree_bound_is_44": True,
            "all_174865_target_monomials_are_enumerated": True,
            "ordinary_top_piece_has_dimension_one": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
        "guardrails": {
            "claims_independent_verification_before_the_dedicated_verifier": False,
            "claims_response_rank_or_beta_C_is_computed": False,
            "claims_characteristic_zero_promotion": False,
        },
        "next_required_object": "Independently reconstruct the qslimgb presentation and both caches before canonical adoption.",
    }
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "UST.G3AP.FIBER2.QSLIMGB top: PASS "
        f"base={len(base)} module={len(module)} monomials={total}"
    )


if __name__ == "__main__":
    main()
