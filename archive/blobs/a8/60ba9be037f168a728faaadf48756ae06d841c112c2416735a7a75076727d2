#!/usr/bin/env python3
"""Independently replay the G3FK selected four-normal Cayley source."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import numpy as np
import sympy as sp


ROOT = Path(__file__).resolve().parent
CERTIFICATE = ROOT / "evidence/ust_g3fk/selected_four_normal_cayley_source.json"
EXPECTED_STATUS = (
    "CLOSED_EXACT_SELECTED_FOUR_NORMAL_CAYLEY_KOSZUL_SOURCE_H02_INTERTWINER_OPEN"
)
G3_TERMS = {
    (3, 0, 0): -2,
    (2, 0, 1): -2,
    (1, 2, 0): 1,
    (1, 1, 1): 1,
    (1, 0, 2): 2,
    (0, 3, 0): -1,
    (0, 1, 2): -2,
    (0, 0, 3): -1,
}


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def local_path(row: dict[str, object]) -> Path:
    path = ROOT / str(row["path"])
    require(path.is_file(), f"local input exists: {path}")
    require(path.stat().st_size == int(row["bytes"]), f"local size: {path.name}")
    require(sha256(path) == row["sha256"], f"local hash: {path.name}")
    return path


def external_path(row: dict[str, object]) -> Path:
    repository = ROOT.parent / str(row["repository"])
    path = repository / str(row["repository_relative_path"])
    require(path.is_file(), f"external input exists: {path}")
    require(path.stat().st_size == int(row["bytes"]), f"external size: {path.name}")
    require(sha256(path) == row["sha256"], f"external hash: {path.name}")
    return path


def source_monomials(degree: int) -> list[tuple[int, int, int]]:
    return [
        (a, b, degree - a - b)
        for a in reversed(range(degree + 1))
        for b in reversed(range(degree - a + 1))
    ]


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (a, b, degree - a - b)
        for a in range(degree + 1)
        for b in range(degree - a + 1)
    ]


def source(
    coefficients: list[list[int]], theta: int, coordinate: int
) -> sp.Expr:
    x, y, z, w = sp.symbols("x y z w")
    offset = 83 * theta
    result = sum(
        int(coefficients[offset + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(source_monomials(9))
    )
    result += w * sum(
        int(coefficients[offset + 55 + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(source_monomials(6))
    )
    return sp.expand(result)


def exterior_incidence() -> tuple[np.ndarray, np.ndarray]:
    wedge = np.zeros((4, 16, 16), dtype=np.int8)
    contraction = np.zeros((4, 16, 16), dtype=np.int8)
    for index in range(4):
        below = (1 << index) - 1
        for mask in range(16):
            sign = -1 if (mask & below).bit_count() % 2 else 1
            if not mask & (1 << index):
                wedge[index, mask | (1 << index), mask] = sign
            if mask & (1 << index):
                contraction[index, mask ^ (1 << index), mask] = sign
    return wedge, contraction


def main() -> None:
    packet = load(CERTIFICATE)
    require(packet["status"] == EXPECTED_STATUS, "status")
    require(all(packet["checks"].values()), "declared checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    g3bi_path = local_path(packet["inputs"]["G3BI"])
    local_path(packet["inputs"]["G3FI"])
    g3fj_path = local_path(packet["inputs"]["G3FJ"])
    pdelta_path = external_path(packet["inputs"]["q79_delta_residue"])
    clifford_path = local_path(
        packet["Koszul_Clifford_matrix_factorization"]["artifact"]
    )

    g3bi = load(g3bi_path)
    g3fj = load(g3fj_path)
    pdelta = load(pdelta_path)
    normal_path = local_path(g3fj["matrix_factorization"]["artifact"])
    normal = np.load(normal_path, allow_pickle=False)
    clifford = np.load(clifford_path, allow_pickle=False)
    require(
        np.array_equal(clifford["H4_coefficients"], normal["H4_coefficients"]),
        "H4 inheritance",
    )
    require(
        np.array_equal(
            clifford["B6_gamma_coordinates"], normal["B6_gamma_coordinates"]
        ),
        "B6 inheritance",
    )
    require(
        np.array_equal(
            clifford["D7_gamma_coordinates"], normal["D7_gamma_coordinates"]
        ),
        "D7 inheritance",
    )

    x, y, z, w, t0, t1, t2, u, v, s = sp.symbols(
        "x y z w t0 t1 t2 u v s"
    )
    q = x * z - y**2
    g3 = sum(
        coefficient * x ** exponent[0] * y ** exponent[1] * z ** exponent[2]
        for exponent, coefficient in G3_TERMS.items()
    )
    r = w + g3
    rbar = w - g3
    ell = t0 + t1
    qe = t0**2 - t0 * t1 + t1**2
    h4_rows = normal["H4_coefficients"].astype(np.int64)
    b6_rows = normal["B6_gamma_coordinates"].astype(np.int64)
    d7_rows = normal["D7_gamma_coordinates"].astype(np.int64)
    h4 = sum(
        int(h4_rows[local])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(homogeneous_exponents(4))
    )
    k3 = sp.expand(r * rbar + q * h4)
    elliptic = t0**3 + t1**3 + t2**3
    require(sp.expand(ell * qe + t2**3 - elliptic) == 0, "elliptic decomposition")

    coefficients = g3bi["selected_source"]["coefficient_vectors"]
    a = [
        [source(coefficients, theta, coordinate) for coordinate in range(6)]
        for theta in range(3)
    ]
    b6 = [
        sum(
            int(b6_rows[local, coordinate])
            * x ** exponent[0]
            * y ** exponent[1]
            * z ** exponent[2]
            for local, exponent in enumerate(homogeneous_exponents(6))
        )
        for coordinate in range(6)
    ]
    d7 = [
        sum(
            int(d7_rows[local, coordinate])
            * x ** exponent[0]
            * y ** exponent[1]
            * z ** exponent[2]
            for local, exponent in enumerate(homogeneous_exponents(7))
        )
        for coordinate in range(6)
    ]
    for coordinate in range(6):
        eta9 = t0 * a[0][coordinate] + t1 * a[1][coordinate] + t2 * a[2][coordinate]
        eta9_factored = (
            q * t0 * d7[coordinate]
            + r * t0 * b6[coordinate]
            + ell * a[1][coordinate]
            + t2 * a[2][coordinate]
        )
        require(sp.expand(eta9 - eta9_factored) == 0, f"eta9 coordinate {coordinate}")
        gq = s * t0 * d7[coordinate]
        gr = s * t0 * b6[coordinate]
        ge = s * a[1][coordinate]
        gt = s * a[2][coordinate]
        potential = s * eta9
        if coordinate == 0:
            gq += u * h4
            gr += u * rbar
            ge += v * qe
            gt += v * t2**2
            potential += u * k3 + v * elliptic
        require(
            sp.expand(potential - (q * gq + r * gr + ell * ge + t2 * gt)) == 0,
            f"Cayley coordinate {coordinate}",
        )

    determinant = sp.expand(
        sp.Matrix(
            [
                [sp.diff(polynomial, variable) for variable in (x, y, z, w)]
                for polynomial in (q, h4, rbar, r)
            ]
        ).det()
    )
    pdelta_expr = sp.sympify(
        pdelta["residue_polynomial"]["expanded"],
        locals={"x": x, "y": y, "z": z, "w": w},
    )
    require(sp.expand(determinant - 6 * pdelta_expr) == 0, "Pdelta replay")

    wedge_expected, contraction_expected = exterior_incidence()
    wedge = clifford["wedge"].astype(np.int8)
    contraction = clifford["contraction"].astype(np.int8)
    require(np.array_equal(wedge, wedge_expected), "wedge incidence")
    require(np.array_equal(contraction, contraction_expected), "contraction incidence")
    identity = np.eye(16, dtype=np.int8)
    zero = np.zeros((16, 16), dtype=np.int8)
    for i in range(4):
        for j in range(4):
            require(np.array_equal(wedge[i] @ wedge[j] + wedge[j] @ wedge[i], zero), "wedge Clifford")
            require(
                np.array_equal(
                    contraction[i] @ contraction[j]
                    + contraction[j] @ contraction[i],
                    zero,
                ),
                "contraction Clifford",
            )
            require(
                np.array_equal(
                    wedge[i] @ contraction[j] + contraction[j] @ wedge[i],
                    identity if i == j else zero,
                ),
                "mixed Clifford",
            )
    require(
        tuple(int(value) for value in clifford["even_masks"])
        == tuple(mask for mask in range(16) if mask.bit_count() % 2 == 0),
        "even masks",
    )
    require(
        tuple(int(value) for value in clifford["odd_masks"])
        == tuple(mask for mask in range(16) if mask.bit_count() % 2 == 1),
        "odd masks",
    )
    print(
        "UST.G3FK independent verification: PASS "
        "four_normals=4 equations=3 field_coordinates=6 Clifford=16"
    )


if __name__ == "__main__":
    main()
