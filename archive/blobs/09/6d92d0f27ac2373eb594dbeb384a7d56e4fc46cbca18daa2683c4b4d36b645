#!/usr/bin/env python3
"""Independently verify the persisted UST.G3CZ core action certificate."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

import numpy as np
from flint import acb, acb_poly, arb, ctx
from scipy import sparse

import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3cz_h11_core221_archimedean_action.packet.json"
G3CV = ROOT / "state" / "ust_g3cv_h11_fraction_free_path_woodbury.packet.json"
G3CY = ROOT / "state" / "ust_g3cy_h11_exact_base_resolvent_coupling_rank.packet.json"
MINPOLY = [64, 16, 33, 44, 89, 24, 1]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(item: dict[str, Any], repository: Path) -> Path:
    key = "path" if "path" in item else "repository_relative_path"
    path = repository / item[key]
    require(path.is_file(), f"record exists: {path}")
    require(path.stat().st_size == int(item["bytes"]), f"record size: {path}")
    require(sha256(path) == item["sha256"], f"record hash: {path}")
    return path


def reconstructed_ball(arrays: Any, row: int, column: int) -> acb:
    real = (
        arb(float(arrays["real_high"][row, column]))
        + arb(float(arrays["real_low"][row, column]))
        + arb(0, float(arrays["real_radius"][row, column]))
    )
    imag = (
        arb(float(arrays["imag_high"][row, column]))
        + arb(float(arrays["imag_low"][row, column]))
        + arb(0, float(arrays["imag_radius"][row, column]))
    )
    return acb(real, imag)


def evaluate(coefficients: list[int] | tuple[int, ...], gamma: acb) -> acb:
    value = acb(0)
    for coefficient in reversed(coefficients):
        value = value * gamma + int(coefficient)
    return value


def main() -> None:
    packet = load(PACKET)
    require(packet["theorem_id"] == "UST.G3CZ", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(
        packet["status"]
        == "CLOSED_CERTIFIED_SELECTED_H11_CORE221_ACTION_ON_ONE_CONJUGATE_ARCHIMEDEAN_PAIR",
        "packet status",
    )
    require(
        not any(bool(value) for value in packet["guardrails"].values()),
        "all guardrail claims remain false",
    )

    mld = runtime.resolve_mld()
    local_inputs = ("G3CV", "G3CX", "G3CY", "implementation")
    for label in local_inputs:
        verify_record(packet["inputs"][label], ROOT)
    for label in (
        "H11_DM",
        "H11_DM_arrays",
        "H11_Macaulay",
        "H11_factorization",
        "B89_oracle",
    ):
        verify_record(packet["inputs"][label], mld)

    action = packet["selected_action"]
    archive_path = verify_record(action["persisted_enclosure"]["archive"], ROOT)
    arrays = np.load(archive_path, allow_pickle=False)
    expected_shape = (1710, 499)
    for key in (
        "real_high",
        "real_low",
        "real_radius",
        "imag_high",
        "imag_low",
        "imag_radius",
    ):
        require(arrays[key].shape == expected_shape, f"archive shape {key}")
        require(bool(np.all(np.isfinite(arrays[key]))), f"finite archive {key}")
    require(bool(np.all(arrays["real_radius"] >= 0)), "nonnegative real radii")
    require(bool(np.all(arrays["imag_radius"] >= 0)), "nonnegative imaginary radii")
    require(arrays["selected_kernel_columns"].shape == (499,), "499 kernel columns")
    require(
        arrays["selected_minor_column_positions"].shape == (499,),
        "499 minor positions",
    )
    require(arrays["core_local_rows"].shape == (1710,), "1710 local rows")
    require(arrays["core_ambient_rows"].shape == (1710,), "1710 ambient rows")

    g3cv = load(G3CV)
    g3cy = load(G3CY)
    dm_path = mld / packet["inputs"]["H11_DM"]["repository_relative_path"]
    dm = load(dm_path)
    dm_arrays = np.load(
        mld / dm["Dulmage_Mendelsohn"]["arrays"]["path"], allow_pickle=False
    )
    component_by_row = dm_arrays["component_by_complement_row"].astype(np.int32)
    component_by_column = dm_arrays["component_by_image_column"].astype(np.int32)
    independently_selected_rows = np.flatnonzero(component_by_row == 221).astype(np.int32)
    independently_selected_columns = np.flatnonzero(component_by_column == 221).astype(
        np.int32
    )
    require(
        np.array_equal(independently_selected_rows, arrays["core_local_rows"]),
        "core row selection",
    )
    require(independently_selected_columns.size == 1710, "core column selection")
    rank_archive = np.load(
        ROOT / g3cy["rank_identity"]["certificate"]["path"], allow_pickle=False
    )
    minor_columns = rank_archive["Q_minor_columns"].astype(np.int32)
    u_coefficients = [
        sparse.load_npz(ROOT / item["path"]).tocsr()
        for item in g3cv["factorization"]["U_gamma_coefficients"]
    ]
    selected_positions: list[int] = []
    for position, kernel_column in enumerate(minor_columns.tolist()):
        support_rows = np.concatenate(
            [matrix[:, kernel_column].nonzero()[0] for matrix in u_coefficients]
        )
        if support_rows.size and np.any(component_by_row[support_rows] == 221):
            selected_positions.append(position)
    selected_positions_array = np.asarray(selected_positions, dtype=np.int32)
    require(
        np.array_equal(
            selected_positions_array, arrays["selected_minor_column_positions"]
        ),
        "independent selected positions",
    )
    require(
        np.array_equal(
            minor_columns[selected_positions_array], arrays["selected_kernel_columns"]
        ),
        "independent selected kernel columns",
    )

    precision = int(packet["field"]["precision_bits"])
    ctx.prec = precision
    roots = acb_poly(MINPOLY).roots(
        tol=arb(2) ** (-int(packet["field"]["root_isolation_bits"])),
        maxprec=1024,
    )
    roots = sorted(
        roots,
        key=lambda value: (float(value.real.mid()), float(value.imag.mid())),
    )
    gamma = roots[4]
    require(acb_poly(MINPOLY)(gamma).contains(0), "embedding root residual")
    require(roots[5].overlaps(gamma.conjugate()), "conjugate embedding")
    require(str(gamma) == packet["field"]["evaluated_gamma_ball"], "root ball replay")

    samples_by_index = {
        int(item["flat_index"]): item for item in action["samples"]
    }
    for index, item in samples_by_index.items():
        row, column = divmod(index, 499)
        reconstructed = reconstructed_ball(arrays, row, column)
        require(
            reconstructed.real.contains(arb(item["real_ball"])),
            "sample real enclosure",
        )
        require(
            reconstructed.imag.contains(arb(item["imag_ball"])),
            "sample imaginary enclosure",
        )

    sys.path.insert(0, str(mld))
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update

    macaulay = load(
        mld / packet["inputs"]["H11_Macaulay"]["repository_relative_path"]
    )
    factor = load(
        mld / packet["inputs"]["H11_factorization"]["repository_relative_path"]
    )
    base = load(oracle.BASE)
    global_f0 = load(oracle.GLOBAL_F0)
    b89 = load(oracle.B89)
    generators0, _, _ = oracle.exact_generators(base, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    original_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, original_columns)
    ambient_rows = arrays["core_ambient_rows"].astype(np.int32)
    test_rows = (0, 855, 1709)
    test_columns = (0, 249, 498)
    exact_rows: dict[int, list[tuple[int, tuple[int, ...]]]] = {
        row: [] for row in test_rows
    }
    ambient_to_test = {int(ambient_rows[row]): row for row in test_rows}
    for local_column, global_column in enumerate(independently_selected_columns.tolist()):
        exact_column = oracle.exact_column(
            descriptors[global_column], generators0, target_lookup
        )
        for ambient_row, coefficients in exact_column.items():
            test_row = ambient_to_test.get(int(ambient_row))
            if test_row is not None:
                exact_rows[test_row].append(
                    (local_column, tuple(int(value) for value in coefficients))
                )
    replayed_residuals = 0
    for row in test_rows:
        for selected_column in test_columns:
            lhs = acb(0)
            for local_column, coefficients in exact_rows[row]:
                lhs += evaluate(coefficients, gamma) * reconstructed_ball(
                    arrays, local_column, selected_column
                )
            kernel_column = int(arrays["selected_kernel_columns"][selected_column])
            rhs_coefficients = [
                int(matrix[int(arrays["core_local_rows"][row]), kernel_column])
                for matrix in u_coefficients
            ]
            require((lhs - evaluate(rhs_coefficients, gamma)).contains(0), "sample residual")
            replayed_residuals += 1
    require(replayed_residuals == 9, "nine independent residual samples")
    print("UST.G3CZ independent verifier: PASS")
    print(
        "archive_shape=1710x499 selected_core_columns=499 "
        "sample_residuals=9 conjugate_pair=4,5"
    )


if __name__ == "__main__":
    main()
