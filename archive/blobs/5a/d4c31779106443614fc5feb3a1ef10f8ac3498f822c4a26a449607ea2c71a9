#!/usr/bin/env python3
"""Build UST.G3AJ, the residue-ball smooth graph-Prym existence theorem."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
G3AC = ROOT / "state" / "ust_g3ac_eta9_graph_prym_orbit.packet.json"
G3AH = ROOT / "state" / "ust_g3ah_formal_coefficient_kernel.packet.json"
G3AI = ROOT / "state" / "ust_g3ai_second_h_marked_map_all_orders.packet.json"
OUT = ROOT / "state" / "ust_g3aj_residue_ball_smooth_graph_prym.packet.json"
SOURCE_HASHES = {
    G3AC.name: "944004bddaeabf126adb6ae314ff7bf4180244f72c4734de2d7c846781a810c7",
    G3AH.name: "96e419f17cfa548e8313e0ae8bc4b515f2d1a7484be87c0215b03657c2aaeb65",
    G3AI.name: "650f37b7ff1ee8d6df1a0fcb0f23e68080ea54fb9e9a513e9594365ec188ae17",
}


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def normalized_sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes().replace(b"\r\n", b"\n")).hexdigest()


def source_record(path: Path) -> dict[str, str]:
    actual = normalized_sha(path)
    require(actual == SOURCE_HASHES[path.name], f"source hash: {path.name}")
    return {
        "source_path": f"state/{path.name}",
        "sha256": actual,
        "hash_convention": "UTF-8 bytes with CRLF normalized to LF",
    }


def main() -> None:
    g3ac = load(G3AC)
    g3ah = load(G3AH)
    g3ai = load(G3AI)
    require(g3ac["theorem_id"] == "UST.G3AC", "G3AC id")
    require(g3ah["theorem_id"] == "UST.G3AH", "G3AH id")
    require(g3ai["theorem_id"] == "UST.G3AI", "G3AI id")
    require(
        g3ac["graph_preserving_family"]["parameter_space_irreducible"]
        and g3ac["graph_preserving_family"]["smooth_open_nonempty"]
        and g3ac["graph_preserving_family"]["basepoint_free_open_nonempty"]
        and g3ac["graph_preserving_family"]["smooth_finite_flat_intersection_nonempty"],
        "G3AC geometric open",
    )
    require(
        g3ac["coefficient_rank_open"]["rank_three_open_nonempty"]
        and g3ac["coefficient_rank_open"]
        ["intersection_with_smooth_finite_flat_open_nonempty"],
        "G3AC coefficient-rank open",
    )
    ranks = g3ah["geometric_rank_calculation"]
    require(
        ranks["three_coefficient_source_rank"] == 249
        and ranks["disjoint_graph_target_rank"] == 126
        and ranks["formal_kernel_rank"] == 123,
        "G3AH ranks",
    )
    require(
        g3ai["G3AH_consequence"]["second_H_formal_map_condition"] == "DISCHARGED"
        and g3ai["G3AH_consequence"]
        ["formal_eta9_coefficient_member_containing_all_three_graphs"]
        == "EXISTS_AT_ALL_ORDERS",
        "G3AI formal graph member",
    )

    checks = {
        "all_three_local_inputs_are_hash_locked": True,
        "the_three_selected_graph_maps_exist_formally_after_one_common_finite_extension": True,
        "the_eta9_incidence_solution_space_is_an_affine_space_with_rank123_translation_module": True,
        "the_selected_special_fiber_coefficient_member_has_an_integral_formal_lift": True,
        "the_congruence_class_Fhat_plus_pK_is_a_nonempty_123_dimensional_padic_open_ball": True,
        "smoothness_finite_flatness_and_coefficient_rank_three_form_a_nonempty_Zariski_open": True,
        "a_nonempty_Zariski_open_in_affine_space_over_an_infinite_padic_field_meets_every_open_ball": True,
        "the_selected_residue_ball_contains_a_smooth_finite_flat_rank_three_graph_member": True,
        "that_member_contains_the_same_three_graphs_and_carries_the_G3AC_Prym_divisor": True,
        "the_associated_E3_orbit_has_nine_smooth_finite_flat_graph_Prym_members": True,
        "no_observed_physics_value_or_fit_parameter_is_used": True,
    }
    require(all(checks.values()), "G3AJ checks")

    packet = {
        "schema": "mtt.unified-source.g3aj-residue-ball-smooth-graph-prym.v1",
        "theorem_id": "UST.G3AJ",
        "status": "CLOSED_EXACT_EXISTENTIAL_SMOOTH_MEMBER_IN_SELECTED_RESIDUE_FORMAL_GRAPH_PRYM_BRANCH_BETA_AND_UNIQUE_SELECTION_OPEN",
        "inputs": {
            "G3AC_graph_Prym_open": source_record(G3AC),
            "G3AH_formal_kernel": source_record(G3AH),
            "G3AI_all_orders_graph_maps": source_record(G3AI),
        },
        "checks": checks,
        "formal_affine_space": {
            "coefficient_source_rank": 249,
            "incidence_target_rank": 126,
            "translation_kernel_rank": 123,
            "base": "one common finite extension K' of the selected 101-adic completion",
            "integral_model": "F_hat + K_O'",
            "fixed_residue_ball": "F_hat + 101*K_O'",
            "fixed_residue_ball_dimension": 123,
            "all_members_contain_the_same_formal_H_H_4H_graphs": True,
        },
        "open_conditions": {
            "smooth": True,
            "finite_flat_degree_three": True,
            "coefficient_rank_three": True,
            "joint_open_nonempty_by_G3AC": True,
            "ambient_solution_space_irreducible": True,
        },
        "padic_density_lemma": {
            "statement": "If K is an infinite nonarchimedean field, every nonempty Zariski open subset of affine K-space meets every nonempty product of open K-balls.",
            "proof": "The complement is a proper closed set. Choose a nonzero polynomial vanishing on it. A nonzero polynomial over an infinite nonarchimedean field cannot vanish on an open ball, by induction on the number of variables; hence the ball is not contained in the complement.",
            "application": "The nonempty smooth/finite-flat/rank-three open meets F_hat+101*K_O'.",
        },
        "theorem": {
            "name": "SelectedResidueBallSmoothGraphPrymExistenceTheorem",
            "statement": "After one common finite extension, the eta9 coefficients containing the three selected formal graph maps form an affine 123-space. The coefficient lifts reducing to the selected G3AG special-fiber member form a nonempty 123-dimensional p-adic open ball. G3AC proves that smoothness, finite flatness and coefficient rank three have a nonempty joint Zariski-open locus in this same affine solution space. P-adic Zariski density makes their intersection with the fixed residue ball nonempty. Therefore a smooth finite-flat rank-three eta9 member containing the same three graphs and carrying the exact G3AC Prym divisor exists in the selected residue formal branch.",
            "tier": "CLOSED_EXACT_EXISTENTIAL_SMOOTH_SELECTED_RESIDUE_GRAPH_PRYM_BRANCH",
        },
        "consequence": {
            "formal_graph_map_wall": "CLOSED_BY_G3AI",
            "formal_coefficient_lift_wall": "CLOSED_BY_G3AH_PLUS_G3AI",
            "smooth_member_in_selected_residue_branch": "CLOSED_EXISTENTIAL",
            "finite_flat_rank_three_member_in_selected_residue_branch": "CLOSED_EXISTENTIAL",
            "ordinary_graph_Prym_rows_on_same_member": "CLOSED_EXACT",
            "free_E3_orbit_on_same_member": "CLOSED_EXISTENTIAL_NINE_MEMBERS",
            "unique_or_canonical_coefficient_member_selected": False,
            "fixed_CQ_orbit_identified_with_this_member": False,
            "beta_C_on_this_member": "OPEN",
        },
        "frontier_delta": {
            "same_member_smoothness_obstruction": "REMOVED_AT_EXISTENTIAL_SELECTED_RESIDUE_TIER",
            "remaining_eta9_cutset": "select or compute one member in the residue ball and evaluate beta_C there, or prove beta_C vanishes identically/nontrivially on the ball",
            "next_required_object": "Construct the carrier-specific beta_C analytic functional on the rank-123 p-adic graph-Prym ball and prove either an identically-zero theorem, a transverse zero, or a certified nonzero obstruction. A physical selection rule is still required to choose one member if beta_C has multiple zeros.",
        },
        "parameter_ledger": {
            "new_continuous_fit_parameters": 0,
