#!/usr/bin/env python3
"""Emit the exact fraction-free Woodbury data for the selected H11 path update."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse
from scipy.sparse.csgraph import connected_components


ROOT = Path(__file__).resolve().parent
G3CU = ROOT / "state" / "ust_g3cu_h11_exact_path_update_rank.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3cv"
OUT = ROOT / "state" / "ust_g3cv_h11_fraction_free_path_woodbury.packet.json"
PRIME = 21817


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def evaluate(matrices: list[sparse.csr_matrix], root: int) -> sparse.csr_matrix:
    result = sparse.csr_matrix(matrices[0].shape, dtype=np.int64)
    power = 1
    for matrix in matrices:
        result = result + matrix.astype(np.int64) * power
        power = power * root % PRIME
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def solve_mod(left: np.ndarray, right: np.ndarray, prime: int) -> np.ndarray:
    a = np.asarray(left, dtype=np.int64).copy() % prime
    b = np.asarray(right, dtype=np.int64).copy() % prime
    require(a.shape[0] == a.shape[1] == b.shape[0], "square modular solve")
    for column in range(a.shape[0]):
        choices = np.flatnonzero(a[column:, column])
        require(choices.size > 0, "modular pivot")
        selected = column + int(choices[0])
        if selected != column:
            a[[column, selected]] = a[[selected, column]]
            b[[column, selected]] = b[[selected, column]]
        inverse = pow(int(a[column, column]), -1, prime)
        a[column] = a[column] * inverse % prime
        b[column] = b[column] * inverse % prime
        active = np.flatnonzero(a[:, column])
        active = active[active != column]
        if active.size:
            factors = a[active, column].copy()
            a[active] = (a[active] - factors[:, None] * a[column]) % prime
            b[active] = (b[active] - factors[:, None] * b[column]) % prime
    require(np.array_equal(a, np.eye(a.shape[0], dtype=np.int64)), "reduced identity")
    return b


def replay_factorization(
    delta: sparse.csr_matrix,
    selected_rows: np.ndarray,
    selected_columns: np.ndarray,
) -> tuple[int, list[dict[str, int]]]:
    coo = delta.tocoo()
    dimension = delta.shape[0]
    graph = sparse.csr_matrix(
        (
            np.ones(2 * coo.nnz, dtype=np.uint8),
            (
                np.concatenate((coo.row, dimension + coo.col)),
                np.concatenate((dimension + coo.col, coo.row)),
            ),
        ),
        shape=(2 * dimension, 2 * dimension),
    )
    _, labels = connected_components(graph, directed=False, return_labels=True)
    mismatches = 0
    summaries = []
    for component in np.unique(labels[coo.row]).tolist():
        rows = np.flatnonzero(labels[:dimension] == component)
        columns = np.flatnonzero(labels[dimension:] == component)
        pivot_rows = np.intersect1d(rows, selected_rows, assume_unique=True)
        pivot_columns = np.intersect1d(columns, selected_columns, assume_unique=True)
        require(pivot_rows.size == pivot_columns.size, "component pivot balance")
        rank = int(pivot_rows.size)
        if rank == 0:
            require(delta[rows, :][:, columns].nnz == 0, "zero-rank component")
            continue
        u = delta[rows, :][:, pivot_columns].toarray()
        s = delta[pivot_rows, :][:, pivot_columns].toarray()
        w = delta[pivot_rows, :][:, columns].toarray()
        coordinates = solve_mod(s, w, PRIME)
        recovered = u.astype(np.int64) @ coordinates.astype(np.int64) % PRIME
        target = delta[rows, :][:, columns].toarray().astype(np.int64) % PRIME
        component_mismatches = int(np.count_nonzero(recovered != target))
        mismatches += component_mismatches
        summaries.append(
            {
                "rows": int(rows.size),
                "columns": int(columns.size),
                "rank": rank,
                "factorization_mismatches": component_mismatches,
            }
        )
    return mismatches, summaries


def main() -> None:
    g3cu = load(G3CU)
    require(all(g3cu["checks"].values()), "G3CU checks")
    update = g3cu["affine_path_update"]
    require(int(update["exact_rank_over_Q_gamma"]) == 988, "G3CU exact rank")
    coefficient_matrices = [
        sparse.load_npz(ROOT / value["path"]).tocsr().astype(np.int64)
        for value in update["exact_gamma_coefficient_matrices"]
    ]
    arrays = np.load(ROOT / update["construction_arrays"]["path"], allow_pickle=False)
    selected_rows = arrays["minor_rows"].astype(np.int32)
    selected_columns = arrays["minor_columns"].astype(np.int32)
    require(selected_rows.size == selected_columns.size == 988, "selected minor size")
    require(np.unique(selected_rows).size == 988, "unique selected rows")
    require(np.unique(selected_columns).size == 988, "unique selected columns")

    u_matrices = [matrix[:, selected_columns].tocsr() for matrix in coefficient_matrices]
    w_matrices = [matrix[selected_rows, :].tocsr() for matrix in coefficient_matrices]
    s_matrices = [
        matrix[selected_rows, :][:, selected_columns].tocsr()
        for matrix in coefficient_matrices
    ]
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    selection_path = EVIDENCE / "H11.path_woodbury_selection.npz"
    np.savez_compressed(
        selection_path,
        selected_rows=selected_rows,
        selected_columns=selected_columns,
    )
    emitted: dict[str, list[dict[str, Any]]] = {"U": [], "W": [], "S": []}
    for name, matrices in (("U", u_matrices), ("W", w_matrices), ("S", s_matrices)):
        for degree, matrix in enumerate(matrices):
            path = EVIDENCE / f"H11.path_woodbury_{name}.gamma_degree{degree}.npz"
            sparse.save_npz(path, matrix, compressed=True)
            emitted[name].append(
                {
                    **record(path),
                    "shape": list(matrix.shape),
                    "nonzero_entries": int(matrix.nnz),
                }
            )

    selected_root = int(update["selected_rank_place"]["gamma_root"])
    delta_at_root = evaluate(coefficient_matrices, selected_root)
    mismatches, component_replay = replay_factorization(
        delta_at_root, selected_rows, selected_columns
    )
    require(mismatches == 0, "selected-place factorization replay")

    s_at_root = evaluate(s_matrices, selected_root)
    require(s_at_root.shape == (988, 988), "selected minor evaluation")
    require(
        int(update["selected_minor_determinant_mod21817"]) != 0,
        "bound nonzero minor",
    )
    checks = {
        "G3CU_is_hash_bound_and_passing": True,
        "the988_selected_rows_and_columns_are_distinct": True,
        "U_W_and_S_are_exact_polynomial_submatrices_of_Delta_H11": True,
        "S_is_the_G3CU_nonzero988_square_number_field_minor": True,
        "the_selected_split_place_replays_Delta_equals_U_S_inverse_W_componentwise": mismatches
        == 0,
        "G3CU_rank_and_invertible_S_prove_the_identity_over_Q_gamma": True,
        "the_fraction_free_representation_uses_no_fitted_or_observed_values": True,
        "no_base_inverse_path_action_integration_or_beta_value_is_inferred": True,
    }
    require(all(checks.values()), "G3CV checks")
    packet = {
        "schema": "mtt.unified-source.g3cv-h11-fraction-free-path-woodbury.v1",
        "date": "2026-08-13",
        "theorem_id": "UST.G3CV",
        "status": "CLOSED_EXACT_SELECTED_H11_FRACTION_FREE_PATH_WOODBURY_FACTORIZATION",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {"G3CU": record(G3CU)},
        "factorization": {
            "field": "Q(gamma)",
            "update": "Delta_H11,C(gamma)",
            "identity": "Delta=U*S^-1*W",
            "fraction_free_identity": "Delta*det(S)=U*adj(S)*W",
            "ambient_shape": [4426, 4426],
            "rank": 988,
            "U_shape": [4426, 988],
            "W_shape": [988, 4426],
            "S_shape": [988, 988],
            "selection": record(selection_path),
            "U_gamma_coefficients": emitted["U"],
            "W_gamma_coefficients": emitted["W"],
            "S_gamma_coefficients": emitted["S"],
            "selected_place": {"prime": PRIME, "gamma_root": selected_root},
            "selected_place_factorization_mismatches": mismatches,
            "component_replay": component_replay,
        },
        "reduced_inverse_equation": {
            "full_equation": "(A0+a*U*S^-1*W)x=b",
            "base_actions": "P=A0^-1*U and x0=A0^-1*b",
            "reduced_equation": "(S+a*W*P)z=a*W*x0",
            "recovery": "x=x0-P*z",
            "reduced_dimension": 988,
            "remaining_data": [
                "the exact or Arb-certified B89 actions P=A0^-1 U",
                "the exact or Arb-certified evolving-source action x0=A0^-1 b",
            ],
        },
        "checks": checks,
        "guardrails": {
            "claims_S_inverse_is_materialized_over_Q_gamma": False,
            "claims_A0_inverse_U_is_emitted": False,
            "claims_the_characteristic_zero_H11_path_action_is_complete": False,
            "claims_integral_transport_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3cvSelectedH11FractionFreePathWoodbury",
            "tier": "CLOSED_EXACT_SELECTED_H11_FRACTION_FREE_FACTORIZATION",
            "statement": "The G3CU rank-revealing rows and columns define exact polynomial matrices U, S and W over Z[gamma], with S a nonzero 988-square minor and Delta_H11,C=U S^-1 W over Q(gamma). The identity is replayed componentwise at the selected split place with zero mismatch. Thus every selected H11 family inverse action reduces exactly to the displayed 988-square Woodbury equation once the two B89 base actions are supplied.",
        },
        "frontier_delta": {
            "before": "G3CU fixed the exact update rank but did not select an executable rank factorization.",
            "after": "The exact U/S/W polynomial data and reduced 988-square inverse equation are emitted. H11 path execution now has only two explicit base-action inputs rather than an unspecified low-rank kernel.",
        },
        "next_required_object": "Use the existing exact H11 DM/fraction-free machinery to compute or Arb-certify P=A_H11,B89^-1 U and x0=A_H11,B89^-1 b for the selected evolving source. Evaluate S+a W P along G3BJ and validate its endpoint values and derivative against G3CT.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3CV selected H11 fraction-free path Woodbury: PASS")
    print(
        f"rank=988 U={u_matrices[0].shape} W={w_matrices[0].shape} "
        f"S={s_matrices[0].shape} split_mismatches={mismatches}"
    )
    print(f"packet_sha256={sha256(OUT)}")


