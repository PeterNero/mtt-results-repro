#!/usr/bin/env python3
"""Build the exact Hilbert--Burch complex carried by the G3FK source matrix."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import sympy as sp

import build_ust_g3ff_component20_conic_fourth_normal_source as conic


ROOT = Path(__file__).resolve().parent
G3BI = ROOT / "state/ust_g3bi_explicit_root_start.packet.json"
G3FK = ROOT / "evidence/ust_g3fk/selected_four_normal_cayley_source.json"
EVIDENCE = ROOT / "evidence/ust_g3fv"
CERTIFICATE = EVIDENCE / "selected_cox_hilbert_burch_source.json"

PRIME = 21817
GAMMA = 5


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def field_value(row: list[int]) -> int:
    return sum(
        int(coefficient) * pow(GAMMA, degree, PRIME)
        for degree, coefficient in enumerate(row)
    ) % PRIME


def restricted_source(
    coefficients: list[list[int]], theta: int
) -> sp.Poly:
    """Restrict a weighted degree-nine source form to one binary test curve."""
    s, t = sp.symbols("s t")
    x = s
    y = t
    z = s + 2 * t
    w = s**3 + 2 * s * t**2 + t**3
    offset = 83 * theta
    expression = sum(
        field_value(coefficients[offset + local])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(conic.source_monomials(9))
    )
    expression += w * sum(
        field_value(coefficients[offset + 55 + local])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(conic.source_monomials(6))
    )
    return sp.Poly(sp.expand(expression.subs(s, 1)), t, modulus=PRIME)


def centered_coefficients(polynomial: sp.Poly) -> list[int]:
    coefficients = [
        int(polynomial.nth(degree)) % PRIME
        for degree in range(polynomial.degree() + 1)
    ]
    return [value if value <= PRIME // 2 else value - PRIME for value in coefficients]


def main() -> None:
    g3bi = load(G3BI)
    g3fk = load(G3FK)
    require(all(g3bi["checks"].values()), "G3BI checks")
    require(all(g3fk["checks"].values()), "G3FK checks")

    # Work universally in the coefficient ring. G3FK supplies the displayed
    # symbols as exact Q(gamma)-polynomials with the stated bidegrees.
    h4, rbar, qe, t2sq, a1, a2, b6, d7, t0 = sp.symbols(
        "H4 rbar qe t2sq A1 A2 B6 D7 t0"
    )
    source = sp.Matrix(
        [
            [h4, 0, t0 * d7],
            [rbar, 0, t0 * b6],
            [0, qe, a1],
            [0, t2sq, a2],
        ]
    )
    signed_minors = []
    for omitted in range(4):
        minor = source.copy()
        minor.row_del(omitted)
        signed_minors.append(sp.expand((-1) ** omitted * minor.det()))
    elliptic_cofactor = qe * a2 - t2sq * a1
    k3_cofactor = t0 * (h4 * b6 - rbar * d7)
    expected = [
        rbar * elliptic_cofactor,
        -h4 * elliptic_cofactor,
        -t2sq * k3_cofactor,
        qe * k3_cofactor,
    ]
    require(
        all(sp.expand(left - right) == 0 for left, right in zip(signed_minors, expected, strict=True)),
        "maximal-minor factorization",
    )
    require(
        all(sp.expand(value) == 0 for value in source.T * sp.Matrix(signed_minors)),
        "Hilbert-Burch syzygy identity",
    )

    coefficients = g3bi["selected_source"]["coefficient_vectors"]
    require(len(coefficients) == 249, "three selected source forms")
    restricted_a1 = restricted_source(coefficients, 1)
    restricted_a2 = restricted_source(coefficients, 2)
    restriction_gcd = sp.gcd(restricted_a1, restricted_a2)
    require(restricted_a1.degree() == restricted_a2.degree() == 9, "weighted restriction degrees")
    require(restriction_gcd.degree() == 0, "restricted source gcd")
    require(restriction_gcd.monic() == sp.Poly(1, *restriction_gcd.gens, modulus=PRIME), "unit gcd")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    packet = {
        "schema": "ust.g3fv.selected-cox-hilbert-burch-source.v1",
        "date": "2026-08-15",
        "theorem_id": "UST.G3FV",
        "status": "CLOSED_EXACT_SELECTED_COX_HILBERT_BURCH_SOURCE_APOLAR_COMPARISON_OPEN",
