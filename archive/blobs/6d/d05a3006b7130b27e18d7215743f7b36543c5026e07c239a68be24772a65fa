#!/usr/bin/env python3
"""Certify a Hilbert-guided candidate by an independent standard-basis run."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import time

from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
CANDIDATE_RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert.result.json"
SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_certify.sing"
OUTPUT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_certify.singular.out"
CACHE = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_certified.ssi"
RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_certify.result.json"
NORED_CANDIDATE_RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored.result.json"
NORED_SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored_certify.sing"
NORED_OUTPUT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored_certify.singular.out"
NORED_CACHE = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored_certified.ssi"
NORED_RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored_certify.result.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def artifact(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def scalar(output: str, label: str) -> int:
    match = re.search(rf"^{re.escape(label)}=(-?\d+)$", output, flags=re.MULTILINE)
    require(match is not None, f"missing {label}")
    return int(match.group(1))


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=86400)
    parser.add_argument("--variant", choices=("red", "nored"), default="red")
    args = parser.parse_args()
    no_red = args.variant == "nored"
    candidate_result_path = NORED_CANDIDATE_RESULT if no_red else CANDIDATE_RESULT
    script_path = NORED_SCRIPT if no_red else SCRIPT
    output_path = NORED_OUTPUT if no_red else OUTPUT
    cache_path = NORED_CACHE if no_red else CACHE
    result_path = NORED_RESULT if no_red else RESULT
    cache_output_relative = str(cache_path.relative_to(ROOT)).replace("\\", "/")
    candidate = json.loads(candidate_result_path.read_text(encoding="ascii"))
    require(
        candidate["schema"]
        == "mtt.unified-source.g3am-selected-cayley-basis-hilbert-hedge-result.v1",
        "candidate schema",
    )
    require(candidate["candidate_completed"] is True, "candidate completed")
    require(candidate["passed"] is False, "candidate is not self-certifying")
    source = artifact(candidate["source"], "source hash")
    artifact(candidate["script"], "candidate script hash")
    artifact(candidate["output"], "candidate output hash")
    candidate_cache = artifact(candidate["cache"], "candidate cache hash")
    cache_relative = str(candidate_cache.relative_to(ROOT)).replace("\\", "/")
    source_text = source.read_text(encoding="ascii")
    require(source_text.count("ideal G=slimgb(J);") == 1, "one source basis command")
    if no_red:
        require(source_text.count("option(redSB);\n") == 1, "one redSB option")
        source_text = source_text.replace("option(redSB);\n", "", 1)
    replacement = f'''def cachedCandidate=read("ssi:r {cache_relative}");
ideal candidateBasis=cachedCandidate;
// SSI input is deliberately not marked isSB: std must recheck and complete it.
print("G3AM_HILBERT_CERT_CANDIDATE_IS_SB_ATTR="+string(attrib(candidateBasis,"isSB")));
ideal G=std(candidateBasis);
int badGeneratorRemainders=0;
int generatorIndex;
for (generatorIndex=1;generatorIndex<=size(J);generatorIndex++)
{{
  if (reduce(J[generatorIndex],G)!=0)
  {{ badGeneratorRemainders=badGeneratorRemainders+1; }}
}}
print("G3AM_HILBERT_CERT_BAD_J_REMAINDERS="+string(badGeneratorRemainders));
print("G3AM_HILBERT_CERT_CANDIDATE_SIZE="+string(size(candidateBasis)));'''
    script_text = source_text.replace("ideal G=slimgb(J);", replacement).replace(
        'write("ssi:w state/ust_g3al_selected_cayley_basis.ssi",G);',
        f'write("ssi:w {cache_output_relative}",G);',
    ).replace(
        'print("G3AL_SELECTED_CAYLEY_BASIS_PASS");',
        '''if (badGeneratorRemainders==0 && reducedSocle!=0)
{ print("G3AL_SELECTED_CAYLEY_BASIS_PASS"); print("G3AM_HILBERT_CERTIFIED_BASIS_PASS"); }
else { print("G3AM_HILBERT_CERTIFIED_BASIS_FAIL"); }''',
    )
    script_path.write_text(script_text, encoding="ascii")
    started = time.time()
    timed_out = False
    try:
        completed = subprocess.run(
            singular_command(ROOT, script_path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        output = completed.stdout
        returncode = completed.returncode
    except subprocess.TimeoutExpired as error:
        timed_out = True
        raw = error.stdout or b""
        output = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else raw
        returncode = 124
    output_path.write_text(output, encoding="utf-8")
    passed = (
        not timed_out
        and returncode == 0
        and "G3AM_HILBERT_CERTIFIED_BASIS_PASS" in output
        and scalar(output, "G3AM_HILBERT_CERT_CANDIDATE_IS_SB_ATTR") == 0
        and scalar(output, "G3AM_HILBERT_CERT_BAD_J_REMAINDERS") == 0
        and scalar(output, "G3AL_SOCLE_ZERO") == 0
        and cache_path.is_file()
        and cache_path.stat().st_size > 0
    )
    result = {
        "schema": "mtt.unified-source.g3am-selected-cayley-basis-hilbert-certification.v1",
        "status": (
            "CLOSED_EXACT_SELECTED_CARRIER_STANDARD_BASIS"
            if passed
            else "HILBERT_CANDIDATE_NOT_CERTIFIED"
        ),
        "candidate_result": {
            "path": str(candidate_result_path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(candidate_result_path),
        },
        "script": {
            "path": str(script_path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(script_path),
        },
        "output": {
            "path": str(output_path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(output_path),
        },
        "cache": (
            {
                "path": cache_output_relative,
                "sha256": sha256(cache_path),
                "bytes": cache_path.stat().st_size,
            }
            if cache_path.is_file()
            else None
        ),
        "algorithm": (
            "std_of_untrusted_hilbert_guided_candidate_nored"
            if no_red
            else "std_of_untrusted_hilbert_guided_candidate_redSB"
        ),
        "uses_redSB": not no_red,
        "proof_logic": {
            "candidate_polynomials_are_generated_by_the_original_J": True,
            "candidate_is_not_assumed_to_be_a_standard_basis": True,
            "candidate_cache_has_no_isSB_trust_attribute": passed,
            "std_is_recomputed_on_the_candidate": True,
            "every_original_J_generator_reduces_to_zero": passed,
            "therefore_candidate_ideal_equals_original_J": passed,
        },
        "elapsed_seconds": time.time() - started,
        "returncode": returncode,
        "timed_out": timed_out,
        "passed": passed,
    }
    result_path.write_text(json.dumps(result, indent=2) + "\n", encoding="ascii")
    print(f"G3AM Hilbert candidate certification variant={args.variant} passed={passed}")
    if not passed:
        raise SystemExit(returncode or 1)


if __name__ == "__main__":
    main()
