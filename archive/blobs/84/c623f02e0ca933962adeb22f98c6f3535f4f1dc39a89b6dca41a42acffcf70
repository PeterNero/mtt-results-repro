#!/usr/bin/env python3
"""Independently verify the G3BU H02 determinant CRT campaign."""

from __future__ import annotations

import hashlib
import json
import math
import sys
from pathlib import Path
from typing import Any

import build_ust_g3bt_h02_endpoint_action_one_split_prime as action
import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3bu_h02_endpoint_determinant_crt_campaign.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any], default_repository: Path = ROOT) -> Path:
    relative = record.get("path", record.get("repository_relative_path"))
    require(isinstance(relative, str), "record path")
    repository = Path(record.get("repository_path", default_repository))
    candidate = Path(relative)
    path = candidate if candidate.is_absolute() else repository / candidate
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def load_verified(record: dict[str, Any], default_repository: Path = ROOT) -> dict[str, Any]:
    return json.loads(verify_record(record, default_repository).read_text(encoding="utf-8"))


def evaluate(coefficients: list[int], value: int, prime: int) -> int:
    result = 0
    for coefficient in reversed(coefficients):
        result = (result * value + coefficient) % prime
    return result


def multiply(left: list[int], right: list[int], prime: int) -> list[int]:
    result = [0] * (len(left) + len(right) - 1)
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            result[i + j] = (result[i + j] + a * b) % prime
    return result


def interpolate(roots: list[int], values: list[int], prime: int) -> list[int]:
    result = [0] * len(roots)
    for index, root in enumerate(roots):
        basis = [1]
        denominator = 1
        for other_index, other in enumerate(roots):
            if other_index == index:
                continue
            basis = multiply(basis, [-other % prime, 1], prime)
            denominator = denominator * (root - other) % prime
        scale = values[index] * pow(denominator, -1, prime) % prime
        for degree, coefficient in enumerate(basis):
            result[degree] = (result[degree] + scale * coefficient) % prime
    return result


def crt_scalar(residues: list[int], primes: list[int]) -> tuple[int, int]:
    value = 0
    modulus = 1
    for residue, prime in zip(residues, primes, strict=True):
        correction = (residue - value) * pow(modulus, -1, prime) % prime
        value += modulus * correction
        modulus *= prime
        value %= modulus
    return value, modulus


def signed(value: int, modulus: int) -> int:
    value %= modulus
    return value if value <= modulus // 2 else value - modulus


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="utf-8"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3bu-h02-endpoint-determinant-crt-campaign.v1",
        "schema",
    )
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails")

    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    inputs = packet["inputs"]
    g3bi = load_verified(inputs["G3BI"])
    g3bk = load_verified(inputs["G3BK"])
    load_verified(inputs["G3BT"])
    macaulay = load_verified(inputs["H02_Macaulay"], mld)
    load_verified(inputs["H02_CSC"], mld)
    factor = load_verified(inputs["H02_factorization"], mld)
    load_verified(inputs["three_block_oracle"], mld)
    base_packet = load_verified(inputs["base"], mld)
    global_f0 = load_verified(inputs["global_F0"], mld)
    b89 = load_verified(inputs["B89"], mld)
    verify_record(inputs["split_prime_solver"], mld)
    root_packets = [load_verified(row, mld) for row in inputs["split_root_packets"]]

    generators0, _, _ = oracle.exact_generators(base_packet, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = [
        int(value)
        for value in load_verified(inputs["H02_CSC"], mld)["binary"]["quotient_unit_rows"]
    ]
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"]["minimal_polynomial_coefficients_ascending"]
    ]
    require(minpoly == packet["selected_chart"]["minimal_polynomial_coefficients_ascending"], "minimal polynomial")

    primes = [int(value) for value in packet["CRT"]["primes"]]
    require(primes == [int(row["prime"]) for row in packet["prime_residues"]], "prime order")
    require(len(primes) == len(root_packets) == 8, "eight prime packets")
    coefficient_residues: list[list[int]] = []
    rebuilt_charts = 0
    for prime_row, root_packet in zip(packet["prime_residues"], root_packets, strict=True):
        prime = int(prime_row["prime"])
        roots = [int(value) for value in prime_row["roots"]]
        require(
            roots == [int(value) for value in root_packet["field"]["roots_of_selected_sextic"]],
            f"canonical roots p={prime}",
        )
        require(len(roots) == len(set(roots)) == 6, f"six roots p={prime}")
        require(all(evaluate(minpoly, root, prime) == 0 for root in roots), f"sextic roots p={prime}")
        determinants: list[int] = []
        for root, root_row in zip(roots, prime_row["root_solves"], strict=True):
            require(int(root_row["gamma_root"]) == root, f"root order p={prime}")
            exact_chart, construction = action.endpoint_chart(
                prime,
                root,
                g3bi,
                macaulay,
                factor,
                quotient_rows,
                descriptors,
                generators0,
                target_lookup,
                oracle,
                exporter,
            )
            require(construction == root_row["construction"], f"construction p={prime} root={root}")
            chart_path = verify_record(root_row["endpoint_chart"])
            stored_chart, chart_prime, quotient_units, image_rank = initializer.read_chart(chart_path)
            require(
                (chart_prime, quotient_units, image_rank)
                == (prime, action.QUOTIENT_UNITS, action.IMAGE_RANK),
                f"chart header p={prime} root={root}",
            )
            require((stored_chart != exact_chart).nnz == 0, f"exact chart p={prime} root={root}")
            if root_row["unit_RHS"] is not None:
                verify_record(root_row["unit_RHS"])
            fields = initializer.parse_log(verify_record(root_row["solver_log"]))
            require(fields.get("STATUS") == "SUCCESS", f"determinant status p={prime} root={root}")
            determinant = int(fields["CHART_DETERMINANT"])
            require(determinant == int(root_row["endpoint_determinant"]), f"determinant p={prime} root={root}")
            require(0 < determinant < prime, f"unit determinant p={prime} root={root}")
            determinants.append(determinant)
            rebuilt_charts += 1
            del exact_chart, stored_chart
        require(determinants == [int(value) for value in prime_row["determinants_at_roots"]], f"determinant vector p={prime}")
        coefficients = interpolate(roots, determinants, prime)
        require(
            coefficients
            == [int(value) for value in prime_row["determinant_power_basis_coefficients_mod_prime"]],
            f"interpolation p={prime}",
        )
        require(all(evaluate(coefficients, root, prime) == value for root, value in zip(roots, determinants, strict=True)), f"interpolation replay p={prime}")
        coefficient_residues.append(coefficients)

    holdouts: list[dict[str, Any]] = []
    for prefix_length in range(1, len(primes)):
        prefix = primes[:prefix_length]
        holdout_prime = primes[prefix_length]
        modulus = math.prod(prefix)
        candidates: list[int] = []
        matches: list[bool] = []
        for degree in range(6):
            value, checked_modulus = crt_scalar(
                [row[degree] for row in coefficient_residues[:prefix_length]], prefix
            )
            require(checked_modulus == modulus, "prefix CRT modulus")
            candidate = signed(value, modulus)
            candidates.append(candidate)
            matches.append(candidate % holdout_prime == coefficient_residues[prefix_length][degree])
        holdouts.append(
            {
                "prefix_primes": prefix,
                "prefix_modulus": modulus,
                "prefix_modulus_bits": modulus.bit_length(),
                "holdout_prime": holdout_prime,
                "signed_coefficient_candidates": candidates,
                "coefficient_matches": matches,
                "holdout_matches": sum(matches),
            }
        )
    require(holdouts == packet["CRT"]["holdout_tests"], "progressive holdouts")
    full_modulus = math.prod(primes)
    full_candidates: list[int] = []
    for degree in range(6):
        value, checked_modulus = crt_scalar([row[degree] for row in coefficient_residues], primes)
        require(checked_modulus == full_modulus, "full CRT modulus")
        full_candidates.append(signed(value, full_modulus))
    require(full_modulus == int(packet["CRT"]["full_modulus"]), "full modulus")
    require(full_modulus.bit_length() == int(packet["CRT"]["full_modulus_bits"]), "modulus bits")
    require(full_candidates == [int(value) for value in packet["CRT"]["full_signed_coefficient_candidates"]], "full CRT candidates")
    require(holdouts[-1]["holdout_matches"] == int(packet["CRT"]["latest_prefix_holdout_matches"]) == 0, "latest holdout rejection")
    require(packet["CRT"]["exact_promotion"] is False, "no promotion")

    print("UST.G3BU H02 endpoint determinant CRT campaign verifier: PASS")
    print(
        f"rebuilt_charts={rebuilt_charts} primes={len(primes)} modulus_bits={full_modulus.bit_length()} "
        f"latest_holdout={holdouts[-1]['holdout_matches']}/6 promotion=false"
    )


if __name__ == "__main__":
    main()
