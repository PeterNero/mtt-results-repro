        (EVIDENCE / "g3cd_H20_H20.coordinates.solver.out", 248),
        (EVIDENCE / "g3cd_H11_H02.coordinates.solver.out", 1013),
        (EVIDENCE / "g3cd_H11_H11.coordinates.solver.out", 1013),
        (EVIDENCE / "g3cd_H11_H20.coordinates.solver.out", 1013),
    ):
        require_log(path, count)

    h20_h11, h20_h11_q, h20_h11_image = solver_io.read_coordinates(H20_H11_COORDINATES)
    h20_h20, h20_h20_q, h20_h20_image = solver_io.read_coordinates(H20_H20_COORDINATES)
    h11_h02, h11_h02_q, h11_h02_image = solver_io.read_coordinates(H11_H02_COORDINATES)
    h11_h11, h11_h11_q, h11_h11_image = solver_io.read_coordinates(H11_H11_COORDINATES)
    h11_h20, h11_h20_q, h11_h20_image = solver_io.read_coordinates(H11_H20_COORDINATES)
    require(h20_h11.shape == (5439, 248) and (h20_h11_q, h20_h11_image) == (1013, 4426), "H20/H11 coordinate shape")
    require(h20_h20.shape == (282, 248) and (h20_h20_q, h20_h20_image) == (248, 34), "H20/H20 coordinate shape")
    require(h11_h02.shape == (42706, 1013) and (h11_h02_q, h11_h02_image) == (248, 42458), "H11/H02 coordinate shape")
    require(h11_h11.shape == (5439, 1013) and (h11_h11_q, h11_h11_image) == (1013, 4426), "H11/H11 coordinate shape")
    require(h11_h20.shape == (282, 1013) and (h11_h20_q, h11_h20_image) == (248, 34), "H11/H20 coordinate shape")

    h20_lower = load(H20_LOWER_PACKET)
    h11_lower = load(H11_LOWER_PACKET)
    h11_terminal = load(H11_TERMINAL_PACKET)
    for label, packet in (
        ("H20 lower", h20_lower),
        ("H11 lower", h11_lower),
        ("H11 terminal", h11_terminal),
    ):
        require(all(packet["checks"].values()), f"{label} checks")

    h11_selected, _ = common.selected_source_matrix("H11")
    h20_selected, _ = common.selected_source_matrix("H20")
    h02_selected, _ = common.selected_source_matrix("H02")
    h20_direct_rhs = sparse.load_npz(ROOT / direct["blocks"]["H20"]["NPZ"]["path"]).tocsc()
    h11_direct_rhs = sparse.load_npz(ROOT / direct["blocks"]["H11"]["NPZ"]["path"]).tocsc()
    h20_lower_rhs = sparse.load_npz(Path(h20_lower["lower_pole_ambient_RHS"]["NPZ"]["path"])).tocsc()
    h11_lower_rhs = sparse.load_npz(Path(h11_lower["lower_pole_ambient_RHS"]["NPZ"]["path"])).tocsc()
    h11_terminal_rhs = sparse.load_npz(Path(h11_terminal["lower_pole_ambient_RHS"]["NPZ"]["path"])).tocsc()

    h20_direct_reconstruction = normalize(h11_selected @ h20_h11.astype(np.int32))
    h20_lower_reconstruction = normalize(h20_selected @ h20_h20.astype(np.int32))
    h20_direct_residual = exact_residual_nonzeros(h20_direct_reconstruction, h20_direct_rhs)
    h20_lower_residual = exact_residual_nonzeros(h20_lower_reconstruction, h20_lower_rhs)
    require(h20_direct_residual == h20_lower_residual == 0, "H20 source reconstructions")

    sample_columns = np.asarray([0, 1, 127, 255, 511, 767, 1011, 1012], dtype=np.int32)
    h11_direct_sample = normalize(
        h02_selected @ h11_h02[:, sample_columns].astype(np.int32)
    )
    h11_direct_sample_residual = exact_residual_nonzeros(
        h11_direct_sample, h11_direct_rhs[:, sample_columns]
    )
    h11_lower_reconstruction = normalize(h11_selected @ h11_h11.astype(np.int32))
    h11_terminal_reconstruction = normalize(h20_selected @ h11_h20.astype(np.int32))
    h11_lower_residual = exact_residual_nonzeros(h11_lower_reconstruction, h11_lower_rhs)
    h11_terminal_residual = exact_residual_nonzeros(h11_terminal_reconstruction, h11_terminal_rhs)
    require(
        h11_direct_sample_residual == h11_lower_residual == h11_terminal_residual == 0,
        "H11 source reconstructions",
    )

    h20_block = normalize(
        sparse.vstack(
            [
                h20_h20[:h20_h20_q, :],
                h20_h11[:h20_h11_q, :],
                sparse.csc_matrix((248, 248), dtype=np.uint8),
            ],
            format="csc",
        )
    )
    h11_block = normalize(
        sparse.vstack(
            [
                h11_h20[:h11_h20_q, :],
                h11_h11[:h11_h11_q, :],
                h11_h02[:h11_h02_q, :],
            ],
            format="csc",
        )
    )
    require(h20_block.shape == (1509, 248), "H20 full block shape")
    require(h11_block.shape == (1509, 1013), "H11 full block shape")

    h02_record = g3bq["full_block"]["NPZ"]
    h02_path = ROOT / h02_record["path"]
    require(sha256(h02_path) == h02_record["sha256"], "G3BQ H02 block hash")
    h02_block = normalize(sparse.load_npz(h02_path))
    require(h02_block.shape == (1509, 248), "H02 full block shape")

    sparse.save_npz(H20_BLOCK, h20_block, compressed=True)
    sparse.save_npz(H11_BLOCK, h11_block, compressed=True)
    connection = normalize(sparse.hstack([h20_block, h11_block, h02_block], format="csc"))
    require(connection.shape == (1509, 1509), "full correction operator shape")
    sparse.save_npz(CONNECTION, connection, compressed=True)
    connection_dense = connection.toarray().astype(np.uint8)
    CONNECTION_DENSE.write_bytes(connection_dense.tobytes(order="C"))
    determinant = linear.determinant_mod_prime(connection_dense)
    if determinant:
        connection_rank = 1509
        connection_pivots = list(range(1509))
    else:
        connection_rank, connection_pivots = linear.echelon_pivot_columns(connection_dense)

    source_record = g3cc["terminal_source"]["B103_H02_vector"]
    source_path = ROOT / source_record["path"]
    require(sha256(source_path) == source_record["sha256"], "G3CC source hash")
    source_h02 = np.load(source_path, allow_pickle=False).astype(np.uint8)
    require(source_h02.shape == (248,), "G3CC H02 vector shape")
    source_1509 = np.concatenate([np.zeros(1261, dtype=np.uint8), source_h02])
    np.save(SOURCE_1509, source_1509, allow_pickle=False)
    source_column = sparse.csc_matrix(source_1509.reshape(-1, 1))
    affine = normalize(
        sparse.bmat(
            [
                [connection, source_column],
                [sparse.csc_matrix((1, 1509), dtype=np.uint8), sparse.csc_matrix((1, 1), dtype=np.uint8)],
            ],
            format="csc",
        )
    )
    require(affine.shape == (1510, 1510), "affine operator shape")
    sparse.save_npz(AFFINE, affine, compressed=True)
    affine_dense = affine.toarray().astype(np.uint8)
    AFFINE_DENSE.write_bytes(affine_dense.tobytes(order="C"))
    if connection_rank == 1509:
        affine_rank = 1509
        source_in_connection_image = True
    else:
        augmented_rank, _ = linear.echelon_pivot_columns(
            np.column_stack([connection_dense, source_1509])
        )
        affine_rank = augmented_rank
        source_in_connection_image = augmented_rank == connection_rank

    require(connection_rank == 1508, "selected correction operator rank 1508")
    require(affine_rank == 1509 and not source_in_connection_image, "selected source fills cokernel")
    right_kernel, right_pivots, right_pivot_rows, rank_minor_determinant = normalized_null_vector(connection_dense)
    left_cokernel, left_pivots, _, _ = normalized_null_vector(connection_dense.T)
    require(len(right_pivots) == len(left_pivots) == 1508, "one-dimensional kernel and cokernel")
    require(not np.any(connection_dense.astype(np.int64) @ right_kernel.astype(np.int64) % PRIME), "right-kernel identity")
    require(not np.any(left_cokernel.astype(np.int64) @ connection_dense.astype(np.int64) % PRIME), "left-cokernel identity")
    obstruction_pairing = int(left_cokernel.astype(np.int64) @ source_1509.astype(np.int64) % PRIME)
    require(obstruction_pairing != 0, "selected affine obstruction is nonzero")
    np.save(RIGHT_KERNEL, right_kernel, allow_pickle=False)
    np.save(LEFT_COKERNEL, left_cokernel, allow_pickle=False)
    np.savez_compressed(
        RANK_MINOR,
        rows=np.asarray(right_pivot_rows, dtype=np.int32),
        columns=np.asarray(right_pivots, dtype=np.int32),
    )
    require(rank_minor_determinant != 0, "rank-1508 minor determinant")

    h20_rank, h20_pivots = linear.echelon_pivot_columns(h20_block.toarray().T)
    h11_rank, h11_pivots = linear.echelon_pivot_columns(h11_block.toarray().T)
    h02_rank = int(g3bq["full_block"]["rank_mod11"])
    require(h02_rank == 248, "G3BQ H02 rank")

