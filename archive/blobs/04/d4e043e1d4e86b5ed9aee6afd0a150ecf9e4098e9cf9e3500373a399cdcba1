        "explicit_normalized_right_kernel_and_left_cokernel_witnesses_are_emitted": True,
        "a_nonzero_1508_square_minor_certificate_is_emitted": True,
        "the_selected_source_pairs_nontrivially_with_the_unique_left_cokernel": True,
