            "exact_full_reduced_nullity": exact_full_reduced_nullity,
            "kernel_preserving_contractions_reversed": contractions,
            "exact_source_presentation_rank": exact_source_rank,
            "component16_dimension": 159,
            "exact_component16_rank_increment": component16_rank,
            "finite_component16_rank_increment": 138,
            "finite_kernel_directions_that_lift": lifted_directions,
            "finite_kernel_directions_that_do_not_lift": nonlifting_directions,
            "previous_global_Q_rank_interval": [4748, 5102],
            "certified_global_Q_rank_interval": [4748, global_upper],
            "remaining_global_gap": global_gap,
