    uncoupled_compression = mul(
        mul(finite_projector, uncoupled_hessian),
        finite_projector,
    )
    coupled_compression = mul(
        mul(finite_projector, coupled_hessian),
        finite_projector,
    )
    uncoupled_residual = mul(
        mul(finite_complement, uncoupled_hessian),
        finite_projector,
    )
    coupled_residual = mul(
        mul(finite_complement, coupled_hessian),
        finite_projector,
