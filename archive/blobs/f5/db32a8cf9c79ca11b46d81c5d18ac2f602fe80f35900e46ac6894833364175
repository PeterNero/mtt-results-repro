def canonical_cauchy_quantum_model() -> dict[str, Any]:
    p = reynolds_two_copy_s3()
    i6 = eye(6)
    q = sub(i6, p)

    def flatten(matrix: list[list[Fraction]]) -> list[Fraction]:
        return [value for row in matrix for value in row]

    def superoperator(transform: Any) -> list[list[Fraction]]:
        output = zeros(36, 36)
        for row in range(6):
            for column in range(6):
                basis = zeros(6, 6)
                basis[row][column] = Fraction(1)
                image = flatten(transform(basis))
                source_column = row * 6 + column
                for target_row, value in enumerate(image):
                    output[target_row][source_column] = value
        return output

    def diagonal_part(matrix: list[list[Fraction]]) -> list[list[Fraction]]:
        return add(mul(mul(p, matrix), p), mul(mul(q, matrix), q))

    def channel(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        diagonal_blocks = diagonal_part(matrix)
        return add(
            diagonal_blocks,
            scale(attenuation, sub(matrix, diagonal_blocks)),
        )

    def generator(matrix: list[list[Fraction]]) -> list[list[Fraction]]:
        return sub(diagonal_part(matrix), matrix)

    def gksl_generator(matrix: list[list[Fraction]]) -> list[list[Fraction]]:
        jump_term = diagonal_part(matrix)
        gram = add(p, q)
        anticommutator = scale(
            Fraction(1, 2),
            add(mul(gram, matrix), mul(matrix, gram)),
        )
        return sub(jump_term, anticommutator)

    def p_record(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1) - attenuation,
            mul(mul(p, matrix), p),
        )

    def q_record(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1) - attenuation,
            mul(mul(q, matrix), q),
        )

    def ready_record(
        matrix: list[list[Fraction]], attenuation: Fraction
    ) -> list[list[Fraction]]:
        return scale(attenuation, matrix)

    identity_super = eye(36)
    dephasing_super = superoperator(diagonal_part)
    generator_super = superoperator(generator)
    checkpoint_attenuation = Fraction(1, 448)
    lens_factor = Fraction(1, 7)
    circle_factor = Fraction(1, 64)
    checkpoint_channel = superoperator(
        lambda matrix: channel(matrix, checkpoint_attenuation)
    )
    lens_channel = superoperator(lambda matrix: channel(matrix, lens_factor))
    circle_channel = superoperator(
        lambda matrix: channel(matrix, circle_factor)
    )

    ready_super = superoperator(
        lambda matrix: ready_record(matrix, checkpoint_attenuation)
    )
    p_record_super = superoperator(
        lambda matrix: p_record(matrix, checkpoint_attenuation)
    )
    q_record_super = superoperator(
        lambda matrix: q_record(matrix, checkpoint_attenuation)
    )

    gauge = two_copy_s3_representations()[1]
    gauge_transpose = transpose(gauge)
    gauge_super = superoperator(
        lambda matrix: mul(mul(gauge, matrix), gauge_transpose)
    )

    preparation = zeros(6, 6)
    preparation[0][0] = Fraction(1)
    ready_effect = scale(checkpoint_attenuation, i6)
    p_effect = scale(Fraction(1) - checkpoint_attenuation, p)
    q_effect = scale(Fraction(1) - checkpoint_attenuation, q)

    def trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum((matrix[index][index] for index in range(6)), Fraction(0))

    record_probabilities = [
        trace(mul(preparation, ready_effect)),
        trace(mul(preparation, p_effect)),
        trace(mul(preparation, q_effect)),
    ]
    eventual_probabilities = [p[0][0], q[0][0]]
    jump_amplitude_rank = rank([flatten(p), flatten(q)])

    checks = {
        "finite_projectors_are_complementary": add(p, q) == i6,
        "finite_projectors_are_nonzero": rank(p) == 2 and rank(q) == 4,
        "dephasing_map_is_idempotent": (
            mul(dephasing_super, dephasing_super) == dephasing_super
        ),
        "dephasing_map_has_rank_twenty": rank(dephasing_super) == 20,
        "generator_shape_is_diagonal_projection_minus_identity": (
            generator_super == sub(dephasing_super, identity_super)
        ),
        "generator_has_rank_sixteen": rank(generator_super) == 16,
        "generator_square_is_minus_generator": (
            mul(generator_super, generator_super)
            == scale(Fraction(-1), generator_super)
        ),
        "gksl_and_block_generators_agree": (
            superoperator(gksl_generator) == generator_super
        ),
        "jump_gram_is_identity": add(mul(transpose(p), p), mul(transpose(q), q))
        == i6,
        "informative_jump_amplitudes_are_independent": jump_amplitude_rank == 2,
        "channel_identity_at_unit_attenuation": (
            superoperator(lambda matrix: channel(matrix, Fraction(1)))
            == identity_super
        ),
        "channel_dephases_at_zero_attenuation": (
            superoperator(lambda matrix: channel(matrix, Fraction(0)))
            == dephasing_super
        ),
        "channel_composition_multiplies_attenuations": (
            mul(lens_channel, circle_channel) == checkpoint_channel
        ),
        "checkpoint_is_exact_one_over_448": (
            lens_factor * circle_factor == checkpoint_attenuation
        ),
        "stopped_instrument_sums_to_channel": (
            add(add(ready_super, p_record_super), q_record_super)
            == checkpoint_channel
        ),
        "stopped_instrument_effects_are_complete": (
            add(add(ready_effect, p_effect), q_effect) == i6
        ),
        "record_effect_coefficients_are_nonnegative": (
            checkpoint_attenuation > 0
            and Fraction(1) - checkpoint_attenuation > 0
        ),
        "preparation_has_unit_trace": trace(preparation) == 1,
        "checkpoint_record_probabilities_are_normalized": (
            sum(record_probabilities, Fraction(0)) == 1
        ),
        "checkpoint_record_probabilities_are_exact": (
            record_probabilities
            == [Fraction(1, 448), Fraction(149, 448), Fraction(149, 224)]
        ),
        "eventual_q79_records_are_one_third_two_thirds": (
            eventual_probabilities == [Fraction(1, 3), Fraction(2, 3)]
        ),
        "gauge_intertwines_channel": (
            mul(gauge_super, checkpoint_channel)
            == mul(checkpoint_channel, gauge_super)
        ),
        "gauge_intertwines_p_record": (
            mul(gauge_super, p_record_super)
            == mul(p_record_super, gauge_super)
        ),
        "gauge_intertwines_q_record": (
            mul(gauge_super, q_record_super)
            == mul(q_record_super, gauge_super)
        ),
        "finite_collision_checkpoint_has_zero_reduced_error": (
            add(add(ready_super, p_record_super), q_record_super)
            == checkpoint_channel
        ),
    }

    return {
