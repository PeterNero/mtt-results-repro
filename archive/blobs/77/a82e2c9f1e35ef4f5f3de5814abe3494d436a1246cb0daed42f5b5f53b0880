            if complete
            else "CLOSED_EXACT_ADAPTIVE_SECOND_JET_HEIGHT_AUDIT_QGAMMA_PROMOTION_OPEN"
        ),
        "inputs": {
            "G3FZ": record(second_jet.CERTIFICATE),
            "G3FZ_arrays": record(second_jet.ARRAYS),
            "G3FT": record(height_campaign.CERTIFICATE),
            "full_kernel_tool": record(
                ROOT
                / load(ROOT / "state/ust_g3di_h02_split_algebra_kernel_relations.packet.json")[
                    "inputs"
                ]["kernel_tool_source"]["path"]
            ),
        },
        "campaign": {
            "arithmetic_schema": ARITHMETIC_SCHEMA,
