            "transverse_projector_kills_longitudinal_direction": (
                mul(transverse, k_column) == zeros(4, 1)
            ),
            "symbol_level_gauge_fixing_squares_to_zero": (
                mul(gauge_fixing, gauge_fixing) == zeros(10, 10)
            ),
            "graded_commutator_is_scalar_Laplace_symbol": (
                commutator == expected
            ),
        }
        return {
            "covector": [str(value) for value in k],
            "norm_squared": str(norm_squared),
            "Maxwell_symbol": fraction_matrix_strings(maxwell),
            "transverse_projector": fraction_matrix_strings(transverse),
            "commutator": fraction_matrix_strings(commutator),
