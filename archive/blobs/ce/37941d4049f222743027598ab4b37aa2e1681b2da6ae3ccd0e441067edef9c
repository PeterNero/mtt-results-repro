    tensor_transport = all(
        derivative_at_zero(target_cost, directions)
        * math.prod(transform[direction][direction] for direction in directions)
        == derivative_at_zero(source_cost, directions)
        for order in range(5)
        for directions in product(range(2), repeat=order)
    )
    semigroup_power_transport = all(
        multiply(
            transform,
            matrix_power(source_hessian_operator, power),
        )
        == multiply(
            matrix_power(target_hessian_operator, power),
            transform,
        )
        for power in range(9)
    )

    checks = {
