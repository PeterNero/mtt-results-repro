"""Prove the exact Q(gamma) rank of the selected H11 base-resolvent coupling."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np
from flint import nmod_mat
from scipy import sparse
from scipy.sparse.csgraph import maximum_bipartite_matching

import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import build_ust_g3cx_h11_dm_source_observation_corridor as corridor
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
G3CV = ROOT / "state" / "ust_g3cv_h11_fraction_free_path_woodbury.packet.json"
G3CW = ROOT / "state" / "ust_g3cw_h11_split_place_base_action.packet.json"
G3CX = ROOT / "state" / "ust_g3cx_h11_dm_source_observation_corridor.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3cy"
OUT = ROOT / "state" / "ust_g3cy_h11_exact_base_resolvent_coupling_rank.packet.json"
PRIME = 21817
ROOT_VALUE = 5
BASE_DIMENSION = 4426
FIRST_REDUCTION = 988
SECOND_REDUCTION = 710


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    return {
        "repository": repository.name,
        "repository_relative_path": resolved.relative_to(repository.resolve()).as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def minimum_vertex_cover(
    graph: sparse.csr_matrix, matching_row_to_column: np.ndarray
) -> tuple[np.ndarray, np.ndarray]:
    rows, columns = graph.shape
    matched_row_by_column = np.full(columns, -1, dtype=np.int32)
    for row, column in enumerate(matching_row_to_column.tolist()):
        if column >= 0:
            require(matched_row_by_column[column] < 0, "matching is injective")
            matched_row_by_column[column] = row
    reached_rows = np.zeros(rows, dtype=bool)
    reached_columns = np.zeros(columns, dtype=bool)
    stack = np.flatnonzero(matching_row_to_column < 0).astype(np.int32).tolist()
    reached_rows[stack] = True
    while stack:
        row = stack.pop()
        for column in graph.indices[graph.indptr[row] : graph.indptr[row + 1]]:
            column = int(column)
            if int(matching_row_to_column[row]) == column or reached_columns[column]:
                continue
            reached_columns[column] = True
            matched_row = int(matched_row_by_column[column])
            if matched_row >= 0 and not reached_rows[matched_row]:
                reached_rows[matched_row] = True
                stack.append(matched_row)
    cover_rows = np.flatnonzero(~reached_rows).astype(np.int32)
    cover_columns = np.flatnonzero(reached_columns).astype(np.int32)
    return cover_rows, cover_columns


def pivot_columns(matrix: nmod_mat, expected_rank: int) -> list[int]:
    reduced, rank = matrix.rref()
    require(int(rank) == expected_rank, "RREF rank")
    result: list[int] = []
    search = 0
    for row in range(expected_rank):
        while search < matrix.ncols() and int(reduced[row, search]) == 0:
            search += 1
        require(search < matrix.ncols(), "RREF pivot")
        require(int(reduced[row, search]) == 1, "normalized RREF pivot")
        result.append(search)
        search += 1
    return result


def main() -> None:
    g3cv = load(G3CV)
    g3cw = load(G3CW)
    g3cx = load(G3CX)
    for packet, label in ((g3cv, "G3CV"), (g3cw, "G3CW"), (g3cx, "G3CX")):
        require(all(packet["checks"].values()), f"{label} checks")

    mld = runtime.resolve_mld()
    dm_arrays_item = g3cx["inputs"]["H11_DM_arrays"]
    dm_arrays_path = mld / dm_arrays_item["repository_relative_path"]
    require(sha256(dm_arrays_path) == dm_arrays_item["sha256"], "DM arrays hash")
    dm_arrays = np.load(dm_arrays_path, allow_pickle=False)
    complement_rows = dm_arrays["complement_ambient_rows"].astype(np.int32)
    root_chart_item = g3cx["inputs"]["root5_B89_chart"]
    root_chart_path = mld / root_chart_item["repository_relative_path"]
    require(sha256(root_chart_path) == root_chart_item["sha256"], "root5 chart hash")
    full_chart, chart_prime, quotient, image = initializer.read_chart(root_chart_path)
    require((chart_prime, quotient, image) == (PRIME, 1013, BASE_DIMENSION), "chart typing")
    a_pattern = full_chart[complement_rows, 1013:].tocsr()
    a_pattern.data = np.ones(a_pattern.nnz, dtype=np.uint8)

    u_pattern = corridor.union_pattern(
        [
            sparse.load_npz(ROOT / item["path"]).tocsr()
            for item in g3cv["factorization"]["U_gamma_coefficients"]
        ]
    )
    w_pattern = corridor.union_pattern(
        [
            sparse.load_npz(ROOT / item["path"]).tocsr()
            for item in g3cv["factorization"]["W_gamma_coefficients"]
        ]
    )
    require(a_pattern.shape == (BASE_DIMENSION, BASE_DIMENSION), "A0 pattern")
    require(u_pattern.shape == (BASE_DIMENSION, FIRST_REDUCTION), "U pattern")
    require(w_pattern.shape == (FIRST_REDUCTION, BASE_DIMENSION), "W pattern")
    bordered = sparse.bmat(
        [[a_pattern, u_pattern], [w_pattern, None]], format="csr", dtype=np.uint8
    )
    bordered.sum_duplicates()
    bordered.data[:] = 1
    matching = maximum_bipartite_matching(bordered, perm_type="column").astype(
        np.int32
    )
    structural_rank = int(np.count_nonzero(matching >= 0))
    cover_rows, cover_columns = minimum_vertex_cover(bordered, matching)
    require(structural_rank == BASE_DIMENSION + SECOND_REDUCTION, "bordered structural rank")
    require(
        cover_rows.size + cover_columns.size == structural_rank,
        "matching-cover equality",
    )
    coo = bordered.tocoo()
    covered = np.isin(coo.row, cover_rows) | np.isin(coo.col, cover_columns)
    require(bool(np.all(covered)), "minimum vertex cover covers every edge")

    q_path = ROOT / g3cw["reduced_kernel_action"]["coefficient_archive"]["path"]
    q_coefficients = np.load(q_path, allow_pickle=False)["coefficients"]
    q_root = corridor.evaluate_dense(q_coefficients, ROOT_VALUE)
    q_mod = nmod_mat(
        FIRST_REDUCTION,
        FIRST_REDUCTION,
        q_root.reshape(-1).tolist(),
        PRIME,
    )
    q_rank = int(q_mod.rank())
    require(q_rank == SECOND_REDUCTION, "good-reduction Q rank")
    selected_columns = pivot_columns(q_mod, SECOND_REDUCTION)
    selected_column_matrix = q_root[:, np.asarray(selected_columns, dtype=np.int32)]
    selected_rows = pivot_columns(
        nmod_mat(
            SECOND_REDUCTION,
            FIRST_REDUCTION,
            selected_column_matrix.T.reshape(-1).tolist(),
            PRIME,
        ),
        SECOND_REDUCTION,
    )
    minor = q_root[
        np.ix_(
            np.asarray(selected_rows, dtype=np.int32),
            np.asarray(selected_columns, dtype=np.int32),
        )
    ]
    minor_determinant = int(
        nmod_mat(
            SECOND_REDUCTION,
            SECOND_REDUCTION,
            minor.reshape(-1).tolist(),
            PRIME,
        ).det()
    )
    require(minor_determinant != 0, "nonzero Q rank minor")
    g3cx_arrays = np.load(
        ROOT / g3cx["exact_component_DAG"]["arrays"]["path"], allow_pickle=False
    )
    active_columns = set(g3cx_arrays["active_kernel_columns"].astype(int).tolist())
    require(set(selected_columns).issubset(active_columns), "minor uses active columns")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    certificate_path = EVIDENCE / "H11.base_resolvent_coupling.rank_certificate.npz"
    np.savez_compressed(
        certificate_path,
        bordered_matching_row_to_column=matching,
        bordered_minimum_vertex_cover_rows=cover_rows,
        bordered_minimum_vertex_cover_columns=cover_columns,
        Q_minor_rows=np.asarray(selected_rows, dtype=np.int32),
        Q_minor_columns=np.asarray(selected_columns, dtype=np.int32),
    )
    checks = {
        "G3CV_G3CW_and_G3CX_are_hash_bound_and_passing": True,
        "the_bordered_exact_support_is_A0_U_over_W_zero": True,
        "the_bordered_support_has_a5136_matching": structural_rank == 5136,
        "an_explicit5136_vertex_cover_certifies_the_matching_is_maximal": cover_rows.size
        + cover_columns.size
        == 5136
        and bool(np.all(covered)),
        "Schur_elimination_bounds_rank_Q_gamma_Q_by5136_minus4426_equals710": True,
        "the_good_reduction_Q_has_rank710_and_a_nonzero710_minor": q_rank
        == SECOND_REDUCTION
        and minor_determinant != 0,
        "good_reduction_rank_is_a_lower_bound_for_characteristic_zero_rank": True,
        "the_matching_upper_and_good_reduction_lower_bounds_meet_at710": True,
        "the_selected710_minor_defines_an_exact_second_Woodbury_factorization": True,
        "no_observed_value_floating_point_or_fitted_parameter_is_used": True,
    }
    require(all(checks.values()), "G3CY checks")
    packet = {
        "schema": "mtt.unified-source.g3cy-h11-exact-base-resolvent-coupling-rank.v1",
        "date": "2026-08-13",
        "theorem_id": "UST.G3CY",
        "status": "CLOSED_EXACT_H11_BASE_RESOLVENT_COUPLING_RANK_710_AND_SECOND_WOODBURY_DIMENSION",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
            "G3CV": record(G3CV),
            "G3CW": record(G3CW),
            "G3CX": record(G3CX),
            "H11_DM_arrays": external_record(dm_arrays_path, mld),
            "root5_B89_chart": external_record(root_chart_path, mld),
            "implementation": record(Path(__file__).resolve()),
        },
        "rank_identity": {
            "field": "Q(gamma)",
            "A0_dimension": BASE_DIMENSION,
            "Q": "W*A0^-1*U",
            "bordered_matrix": "[[A0,U],[W,0]]",
            "Schur_rank_identity": "rank([[A0,U],[W,0]])=4426+rank(Q)",
            "bordered_shape": list(bordered.shape),
            "bordered_exact_support_nonzeros": int(bordered.nnz),
            "bordered_maximum_matching_size": structural_rank,
            "bordered_minimum_vertex_cover_size": int(
                cover_rows.size + cover_columns.size
            ),
            "characteristic_zero_rank_upper_bound": structural_rank
            - BASE_DIMENSION,
            "good_reduction": {
                "prime": PRIME,
                "gamma_root": ROOT_VALUE,
                "rank_lower_bound": q_rank,
                "selected_minor_shape": [SECOND_REDUCTION, SECOND_REDUCTION],
                "selected_minor_determinant_mod21817": minor_determinant,
            },
            "exact_rank_over_Q_gamma": SECOND_REDUCTION,
            "certificate": record(certificate_path),
        },
        "second_Woodbury_reduction": {
            "first_kernel": "S+a*Q",
            "first_dimension": FIRST_REDUCTION,
            "selected_rows": "R from the emitted nonzero710 minor",
            "selected_columns": "C from the emitted nonzero710 minor",
            "U_Q": "Q[:,C]",
            "T_Q": "Q[R,C]",
            "W_Q": "Q[R,:]",
            "identity": "Q=U_Q*T_Q^-1*W_Q",
            "base_action": "P_Q=S^-1*U_Q",
            "base_solution": "z0=S^-1*r",
            "reduced_equation": "(T_Q+a*W_Q*P_Q)y=a*W_Q*z0",
            "recovery": "z=z0-P_Q*y",
            "minimal_path_update_dimension": SECOND_REDUCTION,
        },
        "checks": checks,
        "guardrails": {
            "claims_the_characteristic_zero_entries_of_Q_are_materialized": False,
            "claims_the_second_Woodbury_base_actions_are_evaluated": False,
            "claims_the_Archimedean_path_kernel_is_certified": False,
            "claims_x0_integration_integral_marking_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3cyH11ExactBaseResolventCouplingRank",
            "tier": "CLOSED_EXACT_SELECTED_H11_SECOND_UPDATE_RANK",
            "statement": "Because A0 is invertible over Q(gamma), Schur elimination gives rank([[A0,U],[W,0]])=4426+rank(W*A0^-1*U). The exact bordered support has a maximum matching and minimum vertex cover of size 5136, so rank(Q)<=710. G3CW supplies a nonzero 710-square good-reduction minor, so rank(Q)>=710. Hence rank_Q(gamma)(Q)=710 exactly. The emitted minor selects an exact second Woodbury factorization and reduces the path-dependent H11 kernel from 988 to the minimal dimension 710.",
        },
        "frontier_delta": {
            "before": "G3CX left the exact characteristic-zero rank of Q in the interval 710 to 740.",
            "after": "The bordered-support Schur identity closes the upper bound at 710, meeting the good-reduction lower bound. The exact base-resolvent coupling rank and minimal second Woodbury dimension are 710.",
        },
        "next_required_object": "Use the G3CX corridor and G3CY 710-minor to evaluate the selected second Woodbury data with directed-rounding balls on every Archimedean embedding, then compute the evolving-source action and validate the first jet against G3CT.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3CY H11 exact base-resolvent coupling rank: PASS")
    print(
        f"bordered_matching={structural_rank} cover={cover_rows.size + cover_columns.size} "
        f"rank_Q={SECOND_REDUCTION} minor_det={minor_determinant}"
    )
    print(f"packet_sha256={sha256(OUT)}")


