#!/usr/bin/env python3
"""Build UST.G3AY, the relative Gram-jet and unit-screen compiler."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
G3AJ = STATE / "ust_g3aj_residue_ball_smooth_graph_prym.packet.json"
G3AW = STATE / "ust_g3aw_three_line_gram_meridian_reduction.packet.json"
G3AX = STATE / "ust_g3ax_selected_dvr_top_functional_lift.packet.json"
OUT = STATE / "ust_g3ay_relative_gram_jet_unit_screening.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": str(path.relative_to(ROOT)).replace("\\", "/"),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def main() -> None:
    g3aj = load(G3AJ)
    g3aw = load(G3AW)
    g3ax = load(G3AX)
    directions = g3aj["formal_affine_space"]["fixed_residue_ball_dimension"]
    outputs = g3aw["three_line_pairing"]["top_reductions"]
    target = g3ax["target_relation_map"]
    require(directions == 123, "graph-ball directions")
    require(outputs == 6, "six Gram outputs")
    require(
        target["selected_minor_rows"] == target["selected_minor_columns"] == 39725
        and target["normalization_coordinate_zero_based"] == 28267
        and target["DVR_determinant_is_a_unit"],
        "G3AX unit system",
    )
    require(
        g3ax["relative_unique_lift"]["relative_analytic_section"]
        and not g3ax["relative_unique_lift"]["member_ambiguity_removed"],
        "relative member boundary",
    )

    forward_solves = 1 + directions
    adjoint_solves = 1 + outputs
    packet = {
        "schema": "mtt.unified-source.g3ay-relative-gram-jet-unit-screening.v1",
        "date": "2026-08-12",
        "theorem_id": "UST.G3AY",
        "status": "CLOSED_EXACT_RELATIVE_GRAM_JET_COMPILER_AND_UNIT_SCREEN_INPUTS_OPEN",
        "inputs": {
            "G3AJ": record(G3AJ),
            "G3AW": record(G3AW),
            "G3AX": record(G3AX),
        },
        "relative_system": {
            "member_coordinates": directions,
            "minor_dimension": target["selected_minor_rows"],
            "normalization_coordinate_zero_based": 28267,
            "base_equation": "B(u)x(u)+c(u)=0",
            "functional_coordinates": "t(u)=(x(u),1) in declared J,j_star order",
            "Gram_outputs": outputs,
            "Gram_product_formula": g3aw["three_line_pairing"][
                "combined_top_polynomial"
            ],
        },
        "adjoint_compiler": {
            "scalar": "h_a=p_a_star+p_a_J^T*x=p_a_star-y_a^T*c",
            "adjoint_equation": "B^T*y_a=p_a_J",
            "directional_derivative": (
                "D h_a=D p_a_star+(D p_a_J)^T*x"
                "-y_a^T*((D B)*x+D c)"
            ),
            "one_reusable_factorization": True,
            "forward_RHS_solves": forward_solves,
            "adjoint_RHS_solves": adjoint_solves,
            "RHS_solves_removed_for_six_output_full_jet": forward_solves
            - adjoint_solves,
            "general_batch_rule": "1+min(number_of_directions,number_of_outputs)",
            "symbolic_matrix_inverse_required": False,
        },
        "finite_unit_screen": {
            "residue_field": "F_(101^6)",
            "finite_functional_already_emitted": True,
            "requires_same_source_reduced_transport_vectors": True,
            "requires_exact_DVR_reduction_or_independently_finite_common_frame_transport": True,
            "complex_numerical_transport_is_automatically_reducible_mod101": False,
            "nonzero_diagonal_mod101_promotes_to_unit_for_every_ball_lift": True,
            "nonzero_Gram_determinant_mod101_promotes_to_nondegeneracy_for_every_ball_lift": True,
            "nonidentity_word_mod101_proves_nonidentity_in_characteristic_zero": True,
            "zero_mod101_promotes_to_zero_in_characteristic_zero": False,
            "identity_mod101_promotes_to_identity_in_characteristic_zero": False,
        },
        "required_execution_certificate": {
            "first_stage": (
                "establish an exact DVR/finite common-frame comparison for the "
                "three G3AT lines, then compute six contractions with the G3AP "
                "functional; otherwise evaluate the six characteristic-zero "
                "pairings directly"
            ),
            "uniform_nondegeneracy_exit": (
                "three nonzero finite diagonal entries plus nonzero finite det(H)"
            ),
            "lifted_stage_if_required": (
                "one source-bound reusable unit-pivot factorization, one base "
                "functional RHS and six adjoint RHS solves"
            ),
            "all_outputs_must_bind_one_graph_ball_member": True,
        },
        "checks": {
            "G3AJ_G3AW_G3AX_are_hash_bound": True,
            "the_graph_ball_has123_directions": True,
            "the_immediate_Gram_problem_has6_outputs": True,
            "implicit_differentiation_gives_the_declared_forward_formula": True,
            "the_adjoint_identity_gives_the_declared_scalar_and_derivative_formulas": True,
            "seven_RHS_solves_replace124_for_the_six_output_full_jet": True,
            "a_nonzero_residue_value_is_a_unit_in_every_same_residue_integral_lift": True,
            "the_unit_screen_is_one_way_only": True,
            "ordinary_complex_numerics_have_no_automatic_mod101_reduction": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
        "theorem": {
            "name": "RelativeGramJetAndUnitScreeningTheorem",
            "tier": "CLOSED_EXACT_EXECUTION_COMPILER",
            "statement": (
                "For the G3AX relative normalized functional, the value and all "
                "123 directional derivatives of each G3AW scalar follow from "
                "one base solve, one adjoint solve per scalar and exact matrix-"
                "vector products. Thus the six-output jet uses 7 rather than "
                "124 right-hand-side solves after one factorization. Moreover, "
                "nonzero Gram diagonals and determinant in the common residue "
                "fiber are units for every graph-ball lift."
            ),
        },
        "parameter_ledger": {
            "observed_values_used": 0,
            "new_continuous_fit_parameters": 0,
            "new_discrete_fit_parameters": 0,
        },
        "guardrails": {
            "claims_the_three_transports_are_emitted": False,
            "claims_complex_numerical_transport_can_be_reduced_mod101": False,
            "claims_the_six_finite_or_characteristic_zero_Gram_values_are_emitted": False,
            "claims_a_reusable_factorization_is_emitted": False,
            "claims_a_graph_ball_member_is_selected": False,
            "claims_zero_mod101_implies_zero_in_characteristic_zero": False,
            "claims_Gram_nondegeneracy_or_meridian": False,
            "claims_beta_C_or_an_endpoint": False,
        },
        "next_required_object": (
            "After the three transports arrive, first bind an exact DVR/finite "
            "common-frame comparison or evaluate the six characteristic-zero "
            "pairings directly. Only an admissible exact finite packet may use "
            "the unit screen. Use the seven-solve relative adjoint compiler for "
            "values or jets that still require lifting."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print(
        "UST.G3AY relative Gram jet: PASS "
        f"{forward_solves} -> {adjoint_solves} RHS solves, unit screen compiled"
    )


if __name__ == "__main__":
    main()
