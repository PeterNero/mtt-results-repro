#!/usr/bin/env python3
"""Construct an alternate split-prime H11 initializer for the G3BI endpoint."""

from __future__ import annotations

import hashlib
import json
import struct
import subprocess
import sys
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse

import build_ust_g3bk_correction_pencil_operator_compiler as compiler
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
EVIDENCE = ROOT / "evidence" / "ust_g3bn"
OUT = ROOT / "state" / "ust_g3bn_h11_alternate_split_prime_initializer.packet.json"
PRIME = 21817
GAMMA_ROOT = 5


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    return {
        "repository": repository.name,
        "repository_relative_path": resolved.relative_to(repository).as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def read_chart(path: Path) -> tuple[sparse.csc_matrix, int, int, int]:
    raw = path.read_bytes()
    require(raw[:8] == b"MTTSPC1\0", "chart magic")
    prime, rows, columns, nonzeros, quotient_units, image_rank = struct.unpack_from(
        "<6Q", raw, 8
    )
    offset = 8 + 6 * 8
    indptr = np.frombuffer(raw, dtype="<u8", count=columns + 1, offset=offset)
    offset += indptr.nbytes
    indices = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset)
    offset += indices.nbytes
    data = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset)
    offset += data.nbytes
    require(offset == len(raw), "chart byte count")
    matrix = sparse.csc_matrix(
        (data.copy(), indices.copy(), indptr.astype(np.int64)), shape=(rows, columns)
    )
    return matrix, int(prime), int(quotient_units), int(image_rank)


def correction_derivatives(
    g3bi: dict[str, Any],
    exporter,
    prime: int = PRIME,
    gamma_root: int = GAMMA_ROOT,
) -> list[dict[tuple[int, ...], int]]:
    terms = []
    for row in g3bi["exact_construction"]["right_inverse_rows"]:
        coefficients = tuple(int(value) for value in row["correction_gamma_coordinates"])
        value = exporter.evaluate(coefficients, prime, gamma_root)
        exponent = tuple(int(value) for value in row["source_monomial"]) + (
            0,
            1,
            0,
            0,
            0,
            0,
            1,
        )
        terms.append((exponent, value))
    require(
        len(terms) == 19 and any(value for _, value in terms),
        "19 evaluated split-prime terms with nonzero direction",
    )
    derivatives: list[dict[tuple[int, ...], int]] = []
    for variable in range(10):
        derivative: dict[tuple[int, ...], int] = {}
        for exponent, coefficient in terms:
            power = exponent[variable]
            if power == 0:
                continue
            lowered = list(exponent)
            lowered[variable] -= 1
            key = tuple(lowered)
            derivative[key] = (derivative.get(key, 0) + coefficient * power) % prime
        derivatives.append({key: value for key, value in derivative.items() if value})
    return derivatives


def correction_update(
    macaulay: dict[str, Any],
    factor: dict[str, Any],
    derivatives,
    prime: int = PRIME,
) -> sparse.csc_matrix:
    target = [
        tuple(int(value) for value in row)
        for row in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {row: index for index, row in enumerate(target)}
    descriptors = compiler.selected_column_descriptors(macaulay, factor)
    rows: list[int] = []
    columns: list[int] = []
    data: list[int] = []
    for selected_index, (generator, multiplier) in enumerate(descriptors):
        entries: dict[int, int] = {}
        for exponent, coefficient in derivatives[generator].items():
            product = tuple(a + b for a, b in zip(multiplier, exponent, strict=True))
            target_row = target_lookup.get(product)
            require(target_row is not None, "split-prime update term in H11 ambient basis")
            entries[target_row] = (entries.get(target_row, 0) + coefficient) % prime
        for target_row, coefficient in entries.items():
            if coefficient:
                rows.append(target_row)
                columns.append(selected_index)
                data.append(coefficient)
    matrix = sparse.csc_matrix(
        (
            np.asarray(data, dtype=np.uint32),
            (np.asarray(rows, dtype=np.int32), np.asarray(columns, dtype=np.int32)),
        ),
        shape=(len(target), len(descriptors)),
        dtype=np.uint32,
    )
    matrix.sum_duplicates()
    matrix.data %= prime
    matrix.eliminate_zeros()
    return matrix


def parse_log(path: Path) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition(" ")
        if separator:
            fields[key] = value.strip()
    return fields


def main() -> None:
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import export_q79_eta9_split_prime_selected_chart as exporter

    g3bi_path = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
    g3bk_path = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"
    g3bl_path = ROOT / "state" / "ust_g3bl_h11_proof_prime_initializer_nogo.packet.json"
    g3bi = load(g3bi_path)
    g3bk = load(g3bk_path)
    g3bl = load(g3bl_path)
    require(all(g3bi["checks"].values()) and all(g3bk["checks"].values()), "G3BI/G3BK checks")
    require(all(g3bl["checks"].values()), "G3BL checks")
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"][
            "minimal_polynomial_coefficients_ascending"
        ]
    ]
    require(
        sum(value * pow(GAMMA_ROOT, power, PRIME) for power, value in enumerate(minpoly))
        % PRIME
        == 0,
        "selected gamma split root",
    )

    residue_packet_path = (
        mld
        / "eta9_split_prime_H11_residues"
        / f"H11.physical_H20_to_H11.p{PRIME}.packet.json"
    )
    residue_packet = load(residue_packet_path)
    require(all(residue_packet["checks"].values()), "split-prime residue checks")
    root_record = next(
        row for row in residue_packet["root_solves"] if int(row["gamma_root"]) == GAMMA_ROOT
    )
    base_chart_path = mld / root_record["chart"]["path"]
    rhs_path = mld / root_record["RHS"]["path"]
    require(sha256(base_chart_path) == root_record["chart"]["sha256"], "base chart hash")
    require(sha256(rhs_path) == root_record["RHS"]["sha256"], "RHS hash")
    base_chart, chart_prime, quotient_units, image_rank = read_chart(base_chart_path)
    require(chart_prime == PRIME, "base chart prime")
    require(base_chart.shape == (5439, 5439), "H11 chart shape")
    require(quotient_units + image_rank == 5439 and image_rank == 4426, "H11 chart typing")

    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H11.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H11.packet.json"
    macaulay = load(macaulay_path)
    factor = load(factor_path)
    require(all(macaulay["checks"].values()) and all(factor["checks"].values()), "H11 source checks")
    derivatives = correction_derivatives(g3bi, exporter)
    update = correction_update(macaulay, factor, derivatives)
    require(update.shape == (5439, 4426), "correction update shape")
    endpoint_update = sparse.hstack(
        [sparse.csc_matrix((5439, quotient_units), dtype=np.uint32), update], format="csc"
    )
    endpoint_chart = (base_chart.astype(np.uint64) + endpoint_update.astype(np.uint64)).tocsc()
    endpoint_chart.data %= PRIME
    endpoint_chart.eliminate_zeros()

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    update_path = EVIDENCE / f"H11.p{PRIME}.g{GAMMA_ROOT}.G3BI_endpoint_update.npz"
    chart_path = EVIDENCE / f"H11.p{PRIME}.g{GAMMA_ROOT}.G3BI_endpoint.chart.bin"
    log_path = EVIDENCE / f"H11.p{PRIME}.g{GAMMA_ROOT}.G3BI_endpoint.determinant.log"
    sparse.save_npz(update_path, update, compressed=True)
    exporter.write_chart(
        chart_path,
        PRIME,
        endpoint_chart.shape[0],
        quotient_units,
        image_rank,
        endpoint_chart.indptr.astype(np.uint64).tolist(),
        endpoint_chart.indices.astype(np.uint32).tolist(),
        endpoint_chart.data.astype(np.uint32).tolist(),
    )
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(chart_path),
        "--rhs",
        runtime.wsl_path(rhs_path),
        "--log",
        runtime.wsl_path(log_path),
        "--determinant-only",
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    fields = parse_log(log_path)
    require(fields.get("STATUS") == "SUCCESS", "determinant solver success")
    determinant = int(fields["CHART_DETERMINANT"])
    require(0 < determinant < PRIME, "nonzero endpoint determinant")

    checks = {
        "p21817_is_a_completely_split_good_prime_for_the_selected_sextic": True,
        "gamma5_is_one_of_its_six_selected_roots": True,
        "the_base_H11_chart_is_the_hash_certified_characteristic_zero_source_evaluation": True,
        "the_G3BI_endpoint_update_is_rebuilt_from_all19_exact_Q_gamma_correction_terms": True,
        "the_endpoint_chart_is_C0_plus_the_selected_correction_update": True,
        "the_exact_sparse_factorization_has_full_rank5439_mod21817": True,
        "the_nonzero_reduction_proves_the_selected_H11_endpoint_chart_is_invertible_over_Q_gamma": True,
    }
    require(all(checks.values()), "G3BN checks")
    packet = {
        "schema": "mtt.unified-source.g3bn-h11-alternate-split-prime-initializer.v1",
        "date": "2026-08-12",
        "status": "H11_G3BI_ENDPOINT_SELECTED_CHART_INVERTIBLE_OVER_Q_GAMMA_BY_NONZERO_SPLIT_PRIME_REDUCTION",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "field": {
            "characteristic_zero": "Q(gamma)",
            "minimal_polynomial_coefficients_ascending": minpoly,
            "proof_place": {"prime": PRIME, "gamma_root": GAMMA_ROOT},
        },
        "inputs": {
            "G3BI": record(g3bi_path),
            "G3BK": record(g3bk_path),
            "G3BL": record(g3bl_path),
            "split_prime_residue": external_record(residue_packet_path, mld),
            "base_chart": external_record(base_chart_path, mld),
            "determinant_RHS": external_record(rhs_path, mld),
            "H11_Macaulay": external_record(macaulay_path, mld),
            "H11_factorization": external_record(factor_path, mld),
            "split_prime_solver": external_record(solver, mld),
        },
        "endpoint_update": {
            "shape": list(update.shape),
            "nonzero_entries": int(update.nnz),
            "active_columns": int(np.count_nonzero(np.diff(update.indptr))),
            "matrix": record(update_path),
        },
        "endpoint_chart": {
            "shape": list(endpoint_chart.shape),
            "nonzero_entries": int(endpoint_chart.nnz),
            "determinant_mod21817": determinant,
            "binary": record(chart_path),
            "solver_log": record(log_path),
            "solver_stdout": completed.stdout.strip(),
        },
        "checks": checks,
        "guardrails": {
            "claims_the_bad_GF11_endpoint_chart_is_repaired": False,
            "claims_the_characteristic_zero_inverse_action_has_been_evaluated": False,
            "claims_H02_endpoint_initialization": False,
            "claims_integral_parallel_transport_or_terminal_readout": False,
        },
        "theorem": {
            "name": "ustG3bnH11AlternateSplitPrimeInitializer",
            "tier": "CLOSED_EXACT_CHARACTERISTIC_ZERO_CHART_EXISTENCE",
            "statement": (
                "Evaluation of the exact selected G3BI endpoint H11 chart at the split place "
                "(21817,gamma-5) has the displayed nonzero determinant. Hence the selected "
                "endpoint chart determinant is a nonzero element of Z[gamma] and the chart is "
                "invertible over Q(gamma). The GF(11) corank-one presentation is therefore a "
                "bad initializer place, not a characteristic-zero obstruction."
            ),
        },
        "next_required_object": (
            "Use this selected Q(gamma)-invertible endpoint chart in the split-prime/CRT H11 "
            "inverse-action evaluator, and establish an H02 endpoint initializer independently."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3BN H11 alternate split-prime initializer: PASS")
    print(
        f"p={PRIME} gamma={GAMMA_ROOT} update_nnz={update.nnz} "
        f"chart_nnz={endpoint_chart.nnz} determinant={determinant}"
    )
    print(f"packet_sha256={sha256(OUT)}")


if __name__ == "__main__":
    main()
