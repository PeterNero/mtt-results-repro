#!/usr/bin/env python3
"""Independently verify the exact G3AP fiber-degree-two module."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import subprocess
import tempfile

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ap_selected_cayley_fiber2_module.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def assignment(text: str, name: str) -> str:
    match = re.search(rf"^poly {re.escape(name)}=(.*);$", text, re.MULTILINE)
    require(match is not None, f"assignment {name}")
    return match.group(1)


def weighted_degree(monomial: str, weights: dict[str, int]) -> int:
    return sum(
        weights[name] * int(power or "1")
        for name, power in re.findall(r"([A-Za-z][A-Za-z0-9]*)(?:\^(\d+))?", monomial)
        if name in weights
    )


def verify_cache(cache: Path, expected_size: int) -> None:
    relative = str(cache.relative_to(ROOT)).replace("\\", "/")
    script = f'''ring r=(101,g),(x,y,z,w,t0,t1,t2),(wp(1,1,1,3,1,1,1),C);
minpoly=64+16*g^1+33*g^2+44*g^3+89*g^4+24*g^5+g^6;
def cachedModule=read("ssi:r {relative}");
module G=cachedModule;
print("G3AP_F2_CACHE_IS_SB_ATTR="+string(attrib(G,"isSB")));
print("G3AP_F2_CACHE_SIZE="+string(size(G)));
print("G3AP_F2_CACHE_RELOAD_PASS");
quit;
'''
    path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            suffix=".sing",
            prefix="ust_g3ap_f2_reload_",
            dir=ROOT / "state",
            delete=False,
        ) as temporary:
            temporary.write(script)
            path = Path(temporary.name)
        completed = subprocess.run(
            singular_command(ROOT, path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=300,
            check=False,
        )
        require(completed.returncode == 0, "module cache reload")
        require("G3AP_F2_CACHE_RELOAD_PASS" in completed.stdout, "module reload pass")
        require(re.search(r"^G3AP_F2_CACHE_IS_SB_ATTR=0$", completed.stdout, re.MULTILINE) is not None, "module cache trust cleared")
        size = re.search(r"^G3AP_F2_CACHE_SIZE=(\d+)$", completed.stdout, re.MULTILINE)
        require(size is not None and int(size.group(1)) == expected_size, "module cache size")
    finally:
        if path is not None:
            path.unlink(missing_ok=True)


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(packet["schema"] == "mtt.unified-source.g3ap-selected-cayley-fiber2-module-top.v1", "schema")
    require(packet["theorem_id"] == "UST.G3AP.FIBER2", "theorem id")
    require(all(packet["checks"].values()), "all checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    source = checked(packet["inputs"]["selected_source"], "selected source")
    script = checked(packet["execution"]["script"], "module script")
    output = checked(packet["execution"]["output"], "module output")
    cache = checked(packet["execution"]["bounded_module_cache"], "module cache")
    source_text = source.read_text(encoding="ascii")
    script_text = script.read_text(encoding="ascii")
    require(script_text == fiber2.module_script(source_text), "exact script reconstruction")
    require("(x,y,z,w,t0,t1,t2),(wp(1,1,1,3,1,1,1),C)" in script_text, "seven-variable module ring")
    require("u,v,s" not in script_text.split("ring r=", 1)[1].split(";", 1)[0], "fiber variables become components")
    require("intvec componentShifts=12,15,8,18,11,4;" in script_text, "component shifts")
    require("attrib(M,\"isHomog\",componentShifts);" in script_text, "module homogeneity")
    require("option(noredTail);" in script_text and "degBound=44;" in script_text, "bounded module algorithm")
    require("module G=std(M);" in script_text, "module standard basis")
    require('attrib(G,"isSB",0);' in script_text, "cache trust is cleared")
    for generator in fiber2.module_generators():
        require(generator in script_text, f"module generator {generator}")
    # The six components are u^2,uv,us,v^2,vs,s^2.  The 18 equation
    # generators and 21 derivative generators are exactly the fiber-degree-two
    # part of <K,E,C,u*dK+s*dC,v*dE+s*dC>.
    require(packet["execution"]["module_generator_count"] == 39, "39 generators")
    require(packet["fiber_degree_two_module"]["components"] == ["u2", "uv", "us", "v2", "vs", "s2"], "component order")
    require(packet["fiber_degree_two_module"]["component_scalar_shifts"] == [12, 15, 8, 18, 11, 4], "component weights")
    f6_terms = re.split(r"\s+[+-]\s+", assignment(source_text, "F6"))
    require(
        len(f6_terms) > 20
        and all(weighted_degree(term, {"x": 1, "y": 1, "z": 1, "w": 3}) == 6 for term in f6_terms),
        "F6 is homogeneous of scalar degree six",
    )
    for name in ("A0", "A1", "A2"):
        row = assignment(source_text, name)
        monomials = re.findall(r"\)\*([xyzw0-9*^]+)(?=\+\(|$)", row)
        require(
            len(monomials) > 40
            and all(weighted_degree(term, {"x": 1, "y": 1, "z": 1, "w": 3}) == 9 for term in monomials),
            f"{name} is homogeneous of scalar degree nine",
        )
    # For x,y,z derivatives the paired coefficient degrees are 5 and 9;
    # for w they are 3 and 7; for t_i they are 2 and 9.  Adding the
    # declared component shifts gives one total degree in every vector.
    shifts_by_component = {index: shift for index, _, _, shift in fiber2.COMPONENTS}
    require(
        all(
            dk + shifts_by_component[left] == dc + shifts_by_component[right]
            for dk, dc in ((5, 9), (3, 7))
            for left, right in ((1, 3), (2, 5), (3, 6))
        ),
        "base derivative vectors are shift-homogeneous",
    )
    require(
        all(
            2 + shifts_by_component[left] == 9 + shifts_by_component[right]
            for left, right in ((2, 3), (4, 5), (5, 6))
        ),
        "elliptic derivative vectors are shift-homogeneous",
    )
    raw = output.read_text(encoding="utf-8")
    require("G3AP_F2_MODULE_BOUND=44" in raw, "raw degree bound")
    require("G3AP_F2_MODULE_GENERATORS=39" in raw, "raw generator count")
    require("G3AP_F2_MODULE_LEADER_EXPORT_PASS" in raw, "raw pass")
    leaders = fiber2.parse_leaders(raw)
    require(len(leaders) == packet["execution"]["leading_module_basis_size_through_bound"], "leader count")
    weights = (1, 1, 1, 3, 1, 1, 1)
    require(
        all(
            sum(weight * power for weight, power in zip(weights, exponent)) <= 44
            for _, exponent in leaders
        ),
        "all exported module leaders lie through the conservative base bound",
    )
    standards, sectors = fiber2.enumerate_target(leaders)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL == 174865, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "unique top standard")
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    top = packet["ordinary_top_piece"]
    require(top["Cox_degree"] == [18, 2, 2] and top["dimension"] == 1, "top dimension")
    require(top["basis"] == ["w^12*t2^4*s^2"] and top["basis_component"] == "s2", "top basis")
    cache_record = packet["execution"]["bounded_module_cache"]
    require(cache.stat().st_size == cache_record["bytes"] > 0, "cache byte size")
    require(cache_record["valid_through_total_scalar_degree"] == 44 and cache_record["isSB_trust_attribute_stored"] is False, "cache scope")
    verify_cache(cache, len(leaders))
    print(
        "UST.G3AP.FIBER2 selected ordinary top: PASS "
        f"leaders={len(leaders)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
