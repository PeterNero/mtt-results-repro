#!/usr/bin/env python3
"""Build the exact G3CJ selected-source Krylov and companion certificates."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse

from build_ust_g3ce_hodge_schur_affine_reduction import solve_mod_prime


ROOT = Path(__file__).resolve().parent
G3CD = ROOT / "state" / "ust_g3cd_correction_full_affine_operator.packet.json"
G3CI = ROOT / "state" / "ust_g3ci_selected_source_family_jet.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3cj"
OUT = ROOT / "state" / "ust_g3cj_selected_source_cyclic_full_carrier.packet.json"
PRIME = 11
DIMENSION = 1509
AFFINE_DIMENSION = DIMENSION + 1

KRYLOV = EVIDENCE / "g3cj_selected_source_krylov.mod11.npy"
RECURRENCE = EVIDENCE / "g3cj_K_companion_recurrence.mod11.npy"
AFFINE_RECURRENCE = EVIDENCE / "g3cj_affine_companion_recurrence.mod11.npy"
MINIMAL_POLYNOMIAL = EVIDENCE / "g3cj_K_minimal_polynomial_ascending.mod11.npy"
AFFINE_MINIMAL_POLYNOMIAL = EVIDENCE / "g3cj_affine_minimal_polynomial_ascending.mod11.npy"
COMPANION = EVIDENCE / "g3cj_K_companion_operator.mod11.npz"
AFFINE_COMPANION = EVIDENCE / "g3cj_affine_companion_operator.mod11.npz"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def local_record_path(packet: dict[str, Any], record_value: dict[str, Any]) -> Path:
    path = ROOT / record_value["path"]
    require(path.is_file(), f"missing packet input: {path}")
    require(path.stat().st_size == record_value["bytes"], f"input size: {path.name}")
    require(sha256(path) == record_value["sha256"], f"input hash: {path.name}")
    return path


def build_krylov(operator: np.ndarray, source: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    require(operator.shape == (DIMENSION, DIMENSION), "operator shape")
    require(source.shape == (DIMENSION,), "source shape")
    operator64 = operator.astype(np.int64)
    frame = np.empty((DIMENSION, DIMENSION), dtype=np.uint8)
    vector = source.astype(np.uint8).copy()
    for column in range(DIMENSION):
        frame[:, column] = vector
        vector = (operator64 @ vector.astype(np.int64) % PRIME).astype(np.uint8)
    return frame, vector


def companion_from_recurrence(recurrence: np.ndarray) -> sparse.csc_matrix:
    size = int(recurrence.size)
    recurrence_support = np.flatnonzero(recurrence)
    rows = np.concatenate(
        [np.arange(1, size, dtype=np.int32), recurrence_support.astype(np.int32)]
    )
    columns = np.concatenate(
        [np.arange(0, size - 1, dtype=np.int32), np.full(recurrence_support.size, size - 1, dtype=np.int32)]
    )
    values = np.concatenate(
        [np.ones(size - 1, dtype=np.uint8), recurrence[recurrence_support].astype(np.uint8)]
    )
    return sparse.csc_matrix((values, (rows, columns)), shape=(size, size), dtype=np.uint8)


def main() -> None:
    g3cd = load(G3CD)
    g3ci = load(G3CI)
    require(all(g3cd["checks"].values()), "G3CD checks")
    require(all(g3ci["checks"].values()), "G3CI checks")
    require(
        g3ci["status"]
        == "CLOSED_EXACT_GF11_RAW_SOURCE_DOES_NOT_ANCHOR_AND_H02_GRADED_SOURCE_RICCATI_JET_REJECTED",
        "G3CI frontier status",
    )

    operator_record = g3cd["correction_operator"]["dense_uint8"]
    source_record = g3cd["selected_affine_source"]["source_vector"]
    operator_path = local_record_path(g3cd, operator_record)
    source_path = local_record_path(g3cd, source_record)
    operator = np.fromfile(operator_path, dtype=np.uint8).reshape(DIMENSION, DIMENSION)
    source = np.load(source_path, allow_pickle=False).astype(np.uint8)
    require(int(np.count_nonzero(source)) == 229, "selected-source support")

    frame, next_vector = build_krylov(operator, source)
    recurrence_matrix, frame_determinant = solve_mod_prime(
        frame, next_vector.reshape(-1, 1)
    )
    recurrence = recurrence_matrix[:, 0]
    require(frame_determinant == 7, "selected-source Krylov determinant")
    require(
        not np.any(
            (
                frame.astype(np.int64) @ recurrence.astype(np.int64)
                - next_vector.astype(np.int64)
            )
            % PRIME
        ),
        "terminal recurrence residual",
    )
    require(int(recurrence[0]) == 0, "zero constant recurrence coefficient")
    require(int(recurrence[1]) != 0, "simple zero root coefficient")

    affine_recurrence = np.concatenate(
        [np.zeros(1, dtype=np.uint8), recurrence]
    )
    minimal_polynomial = np.empty(DIMENSION + 1, dtype=np.uint8)
    minimal_polynomial[:DIMENSION] = (-recurrence.astype(np.int64) % PRIME).astype(np.uint8)
    minimal_polynomial[DIMENSION] = 1
    affine_minimal_polynomial = np.empty(AFFINE_DIMENSION + 1, dtype=np.uint8)
    affine_minimal_polynomial[:AFFINE_DIMENSION] = (
        -affine_recurrence.astype(np.int64) % PRIME
    ).astype(np.uint8)
    affine_minimal_polynomial[AFFINE_DIMENSION] = 1
    require(np.array_equal(affine_minimal_polynomial[1:], minimal_polynomial), "m_affine=x*m_K")
    require(int(minimal_polynomial[0]) == 0 and int(minimal_polynomial[1]) != 0, "simple K zero root")
    require(
        int(affine_minimal_polynomial[0]) == 0
        and int(affine_minimal_polynomial[1]) == 0
        and int(affine_minimal_polynomial[2]) != 0,
        "double affine zero root",
    )

    companion = companion_from_recurrence(recurrence)
    affine_companion = companion_from_recurrence(affine_recurrence)
    require(companion.shape == (DIMENSION, DIMENSION), "companion shape")
    require(affine_companion.shape == (AFFINE_DIMENSION, AFFINE_DIMENSION), "affine companion shape")
    require(
        np.array_equal(
            frame[:, 1:],
            (operator.astype(np.int64) @ frame[:, :-1].astype(np.int64) % PRIME).astype(np.uint8),
        ),
        "Krylov successor identities",
    )
    affine_frame_determinant = (-frame_determinant) % PRIME
    require(affine_frame_determinant == 4, "affine Krylov determinant")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    np.save(KRYLOV, frame, allow_pickle=False)
    np.save(RECURRENCE, recurrence, allow_pickle=False)
    np.save(AFFINE_RECURRENCE, affine_recurrence, allow_pickle=False)
    np.save(MINIMAL_POLYNOMIAL, minimal_polynomial, allow_pickle=False)
    np.save(AFFINE_MINIMAL_POLYNOMIAL, affine_minimal_polynomial, allow_pickle=False)
    sparse.save_npz(COMPANION, companion, compressed=True)
    sparse.save_npz(AFFINE_COMPANION, affine_companion, compressed=True)

    recurrence_support = np.flatnonzero(recurrence)
    checks = {
        "G3CD_and_G3CI_are_hash_bound_and_passing": True,
        "the_hash_bound_selected_source_has229_nonzero_coordinates": True,
        "all1509_selected_source_Krylov_columns_are_reconstructed": True,
        "the_Krylov_frame_has_nonzero_determinant7_mod11": frame_determinant == 7,
        "the_selected_source_is_a_cyclic_vector_for_the_terminal_operator": True,
        "the_exact_degree1509_companion_recurrence_is_emitted": True,
        "the_recurrence_residual_is_zero_entrywise": True,
        "the_homogeneous_minimal_and_characteristic_polynomials_coincide": True,
        "zero_is_a_simple_root_of_the_terminal_operator_polynomial": True,
        "the_affine_lift_has_a_cyclic1510_column_frame_with_determinant4": True,
        "the_affine_minimal_polynomial_equals_x_times_the_homogeneous_polynomial": True,
        "zero_is_a_double_root_of_the_affine_companion_polynomial": True,
        "no_lower_dimensional_fixed_linear_invariant_subspace_containing_the_source_exists": True,
        "no_pathwise_or_characteristic_zero_cyclicity_is_inferred": True,
    }
    require(all(checks.values()), "G3CJ checks")

    packet = {
        "schema": "mtt.unified-source.g3cj-selected-source-cyclic-full-carrier.v1",
        "date": "2026-08-13",
        "theorem_id": "UST.G3CJ",
        "status": "CLOSED_EXACT_GF11_SELECTED_SOURCE_CYCLIC_FULL_AFFINE_CARRIER_PATHWISE_PROMOTION_OPEN",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "field": "GF(11) at gamma=3 and terminal family parameter a=0",
        "inputs": {
            "G3CD": record(G3CD),
            "G3CI": record(G3CI),
            "terminal_operator": operator_record,
            "selected_source": source_record,
        },
        "homogeneous_cyclic_frame": {
            "definition": "B=[b,K*b,...,K^1508*b]",
            "shape": [DIMENSION, DIMENSION],
            "determinant_mod11": frame_determinant,
            "rank_mod11": DIMENSION,
            "prefix_rank_formula": "rank[b,Kb,...,K^j b]=j+1 for 0<=j<=1508",
            "selected_source_nonzero_entries": int(np.count_nonzero(source)),
            "last_frame_column_nonzero_entries": int(np.count_nonzero(frame[:, -1])),
            "next_vector_nonzero_entries": int(np.count_nonzero(next_vector)),
            "frame": record(KRYLOV),
        },
        "homogeneous_companion": {
            "recurrence": "K^1509*b=sum_{j=0}^{1508} c_j K^j*b",
            "recurrence_nonzero_entries": int(recurrence_support.size),
            "first_nonzero_coefficient_index": int(recurrence_support[0]),
            "last_nonzero_coefficient_index": int(recurrence_support[-1]),
            "c0_mod11": int(recurrence[0]),
            "c1_mod11": int(recurrence[1]),
            "recurrence_coefficients": record(RECURRENCE),
            "companion_operator": record(COMPANION),
            "minimal_polynomial_formula": "m_K(x)=x^1509-sum_{j=0}^{1508} c_j*x^j",
            "minimal_polynomial_equals_characteristic_polynomial": True,
            "zero_root_algebraic_multiplicity": 1,
            "minimal_polynomial_ascending_coefficients": record(MINIMAL_POLYNOMIAL),
        },
        "affine_cyclic_frame": {
            "operator": "K_tilde=[[K,b],[0,0]]",
            "cyclic_vector": "e_aff=(0,...,0,1)",
            "basis": "[e_aff,K_tilde*e_aff,...,K_tilde^1509*e_aff]",
            "shape": [AFFINE_DIMENSION, AFFINE_DIMENSION],
            "determinant_mod11": affine_frame_determinant,
            "rank_mod11": AFFINE_DIMENSION,
            "determinant_identity": "det(B_aff)=(-1)^1509 det(B)=-7=4 mod11",
            "recurrence_coefficients": record(AFFINE_RECURRENCE),
            "companion_operator": record(AFFINE_COMPANION),
            "minimal_polynomial_formula": "m_Ktilde(x)=x*m_K(x)",
            "minimal_polynomial_equals_characteristic_polynomial": True,
            "zero_root_algebraic_multiplicity": 2,
            "minimal_polynomial_ascending_coefficients": record(AFFINE_MINIMAL_POLYNOMIAL),
        },
        "minimality_consequence": {
            "homogeneous": "Every K-invariant linear subspace containing b contains every K^j*b and hence, because B is invertible, equals GF(11)^1509.",
            "affine": "Every K_tilde-invariant linear subspace containing e_aff contains the 1510-column affine Krylov basis and hence equals GF(11)^1510.",
            "interpretation": "The selected terminal source reaches every B103 direction under repeated application of K. The full carrier can be put in one cyclic companion coordinate system, but it cannot be replaced by a smaller fixed linear source-reachable invariant subsystem.",
        },
        "checks": checks,
        "guardrails": {
            "claims_a_lower_dimensional_transport_reduction": False,
            "claims_the_companion_module_is_a_single_physical_degree_of_freedom": False,
            "claims_a_pathwise_constant_companion_operator": False,
            "claims_the_terminal_cyclic_frame_is_flat_or_horizontal": False,
            "claims_characteristic_zero_cyclicity": False,
            "claims_integral_transport_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3cjSelectedSourceCyclicFullCarrier",
            "tier": "CLOSED_EXACT_SELECTED_GF11_TERMINAL_CYCLICITY",
            "statement": "At the selected terminal good fiber, the G3CD source b is cyclic for the complete 1509-dimensional correction operator K: the exact Krylov frame [b,Kb,...,K^1508b] has determinant 7 modulo 11. Therefore K is similar to the emitted degree-1509 companion operator, its minimal and characteristic polynomials coincide, and no proper fixed K-invariant linear subspace contains b. The 1510-dimensional homogeneous affine lift is likewise cyclic from e_aff, with determinant 4 and minimal polynomial x*m_K. This is a full-dimensional canonical realization, not a dimensional reduction or pathwise horizontal solution.",
        },
        "frontier_delta": {
            "before": "G3CI retired the rank-249 Schur transport for the current selected source and left the full rank-1510 affine continuation as the mandatory route.",
            "after": "The mandatory terminal affine carrier is now proved source-cyclic and minimal among fixed linear source-reachable invariant realizations. It admits an exact full-dimensional companion basis, so no smaller invariant linear subsystem can replace it at this fiber. Family-parametric and characteristic-zero promotion remain open.",
        },
        "next_required_object": "Promote the terminal cyclic frame to the rational selected G3BJ arc by proving the family Krylov determinant is a nonzero rational function and then emit the moving-frame connection and companion coefficients needed for actual continuation. The start endpoint, integral lattice transport and normalized 248-row beta_C readout remain separate obligations.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3CJ selected-source cyclic full carrier: PASS")
    print(
        f"detB={frame_determinant} rankB={DIMENSION} recurrence_nnz={recurrence_support.size} "
        f"c0={int(recurrence[0])} c1={int(recurrence[1])} detB_aff={affine_frame_determinant}"
    )
    print(f"packet_sha256={sha256(OUT)}")


if __name__ == "__main__":
    main()
