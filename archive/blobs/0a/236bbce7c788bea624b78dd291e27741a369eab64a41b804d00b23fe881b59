+static void dump_f4_ancestry_inputs(
+        const mat_t *mat,
+        const bs_t *bs,
+        const md_t *md
+        )
+{
+    const char *path = getenv("MSOLVE_F4_ANCESTRY_DUMP");
+    if (path == NULL || path[0] == '\0') {
+        return;
+    }
+    FILE *file = fopen(path, "a");
+    if (file == NULL) {
+        return;
+    }
+    const ht_t *ht = bs->ht;
+    fprintf(file, "MATRIX\t%d\t%u\t%u\t%u\t%u\t%u\n",
+            mat->cd, bs->ld, mat->nru, mat->nrl, ht->nv, ht->evl);
+    for (len_t block = 0; block < 2; ++block) {
+        hm_t **rows = block == 0 ? mat->rr : mat->tr;
+        const len_t count = block == 0 ? mat->nru : mat->nrl;
+        const char kind = block == 0 ? 'R' : 'T';
+        for (len_t i = 0; i < count; ++i) {
+            const hm_t *row = rows[i];
+            const exp_t *multiplier = ht->ev[row[MULT]];
+            fprintf(file, "INPUT\t%c\t%u\t%u", kind, i, row[BINDEX]);
+            for (len_t k = 0; k < ht->evl; ++k) {
+                fprintf(file, "\t%u", multiplier[k]);
+            }
+            fprintf(file, "\n");
+        }
+    }
+    fprintf(file, "ENDMATRIX\n");
+    fclose(file);
+}
