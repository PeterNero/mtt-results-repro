from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3co_pole_six_automatic_open_arc_exactness.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def resolve_mld() -> Path:
    configured = os.environ.get("MTT_MLD_REPO")
    candidates = ([Path(configured)] if configured else []) + [
        ROOT.parent / "20 Mathematical Language Discovery Program",
        ROOT.parent / "Mathematical Language Discovery Program",
    ]
    for candidate in candidates:
        if (candidate / "q79_eta9_pole_six_membership_frontier.packet.json").is_file():
            return candidate.resolve()
    raise FileNotFoundError("Mathematical Language Discovery Program repository")


def checked_local(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], f"local {record['path']}")
    return path


def checked_external(record: dict[str, Any], repository: Path) -> Path:
    require(record["repository"] == repository.name, "repository name")
    path = repository / record["repository_relative_path"]
    require(path.is_file() and sha256(path) == record["sha256"], f"external {record['repository_relative_path']}")
    return path


def main() -> None:
    mld = resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_original_jacobian_macaulay as macaulay

    packet = load(PACKET)
    require(packet["schema"] == "mtt.unified-source.g3co-pole-six-automatic-open-arc-exactness.v1", "schema")
    require(packet["theorem_id"] == "UST.G3CO", "theorem id")
    require(packet["status"] == "CLOSED_EXACT_POLE_SIX_AUTOMATIC_FINITE_OPEN_ARC_MEMBERSHIP_RIGHT_INVERSE_EXECUTION_AND_START_UNIT_OPEN", "status")
    require(all(packet["checks"].values()), "checks")
    membership = load(checked_external(packet["inputs"]["pole_six_membership"], mld))
    original = load(checked_external(packet["inputs"]["original_Jacobian_generators"], mld))
    g3bj = load(checked_local(packet["inputs"]["G3BJ"]))
    g3cn = load(checked_local(packet["inputs"]["G3CN"]))
    require(all(membership["checks"].values()), "membership checks")
    require(all(g3bj["checks"].values()) and all(g3cn["checks"].values()), "path and jet checks")
    require(tuple(membership["pole_six_piece"]["Cox_degree"]) == (9, 1, 3), "degree")
    require(int(membership["pole_six_piece"]["ambient_monomials_enumerated"]) == 208570, "membership ambient")
    require(int(membership["pole_six_piece"]["standard_monomials_mod_B69_J"]) == 0, "zero quotient")

    target = (9, 1, 3)
    rows = len(macaulay.monomials_of_cox_degree(target))
    columns = 0
    base_nonzeros = 0
    changed_columns = 0
    exact_update_nonzeros = 0
    good_update_nonzeros = 0
    exact_counts = g3cn["family"]["exact_derivative_support_counts"]
    good_counts = g3cn["family"]["good_reduction_derivative_support_counts"]
    changed = set(g3cn["family"]["changed_original_Jacobian_generators"])
    independent_blocks = []
    for generator in original["generators"]:
        degree = tuple(int(value) for value in generator["Cox_degree"])
        multiplier_degree = tuple(target[index] - degree[index] for index in range(3))
        multiplier_count = len(macaulay.monomials_of_cox_degree(multiplier_degree))
        term_count = len(generator["terms"])
        columns += multiplier_count
        base_nonzeros += multiplier_count * term_count
        if generator["name"] in changed:
            changed_columns += multiplier_count
            exact_update_nonzeros += multiplier_count * int(exact_counts[generator["name"]])
            good_update_nonzeros += multiplier_count * int(good_counts[generator["name"]])
        independent_blocks.append((generator["name"], multiplier_count, term_count))

    direct = packet["direct_target_map"]
    update = packet["family_update"]
    require((rows, columns, base_nonzeros) == (208570, 602597, 53850259), "direct dimensions")
    require((rows, columns, base_nonzeros) == (direct["ambient_rows"], direct["coefficient_columns"], direct["base_nonzero_entries"]), "packet direct dimensions")
    require(changed_columns == update["changed_coefficient_columns"] == 255552, "changed columns")
    require(exact_update_nonzeros == update["exact_nonzero_entries_over_Q_gamma"] == 4173408, "exact update")
    require(good_update_nonzeros == update["good_reduction_nonzero_entries"] == 3966576, "good update")
    require(
        independent_blocks
        == [
            (row["generator"], row["multiplier_columns"], row["generator_terms_at_B89"])
            for row in direct["blocks"]
        ],
        "block replay",
    )
    require(packet["guardrails"]["claims_an_explicit_rank_208570_minor"] is False, "minor guard")
    require(packet["guardrails"]["claims_surjectivity_at_the_algebraic_start_a1"] is False, "start guard")
    print("UST.G3CO independent verifier: PASS")
    print(
        f"rows={rows} columns={columns} quotient=0 changed_columns={changed_columns} "
        f"exact_update_nnz={exact_update_nonzeros}"
    )


if __name__ == "__main__":
    main()
