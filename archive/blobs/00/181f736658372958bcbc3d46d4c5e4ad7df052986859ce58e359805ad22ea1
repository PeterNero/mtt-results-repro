def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def inverse_mod(matrix: np.ndarray, prime: int) -> np.ndarray:
    size = matrix.shape[0]
    require(matrix.shape == (size, size), "square inverse")
    work = np.concatenate(
        (matrix.astype(np.int64) % prime, np.eye(size, dtype=np.int64)), axis=1
    )
    for column in range(size):
        choices = np.flatnonzero(work[column:, column])
        require(choices.size > 0, "invertible matrix")
        selected = column + int(choices[0])
        if selected != column:
            work[[column, selected]] = work[[selected, column]]
        work[column] = (
            work[column] * pow(int(work[column, column]), -1, prime)
        ) % prime
        for row in range(size):
            if row != column and work[row, column]:
                work[row] = (
                    work[row] - int(work[row, column]) * work[column]
                ) % prime
    return work[:, size:]


def f1_keys(total_degree: int) -> list[tuple[int, int, tuple[int, int, int]]]:
    result: list[tuple[int, int, tuple[int, int, int]]] = []
    for shift, count in F1_BLOCKS:
        if total_degree < shift:
            continue
        for generator in range(count):
            for exponent in graded.homogeneous_exponents(total_degree - shift):
                result.append((shift, generator, exponent))
    return result


def d1_matrix(
    generators: dict[int, np.ndarray], total_degree: int, prime: int
) -> np.ndarray:
    blocks = [
        graded.multiply_space(generators[shift], shift, total_degree, prime)
        for shift, _ in F1_BLOCKS
        if total_degree >= shift
    ]
    if not blocks:
        return np.zeros(
            (len(graded.homogeneous_exponents(total_degree)), 0), dtype=np.int64
        )
    return np.concatenate(blocks, axis=1) % prime


def multiply_module_vectors(
    vectors: np.ndarray,
    source_degree: int,
    target_degree: int,
    prime: int,
) -> np.ndarray:
    require(target_degree >= source_degree, "nonnegative module multiplier")
    source_keys = f1_keys(source_degree)
    target_keys = f1_keys(target_degree)
    require(vectors.shape[0] == len(source_keys), "module-vector source shape")
    target_lookup = {key: row for row, key in enumerate(target_keys)}
    multipliers = graded.homogeneous_exponents(target_degree - source_degree)
    result = np.zeros(
        (len(target_keys), vectors.shape[1] * len(multipliers)), dtype=np.int64
    )
    for column in range(vectors.shape[1]):
        for multiplier_index, multiplier in enumerate(multipliers):
            output = column * len(multipliers) + multiplier_index
            for row, (shift, generator, exponent) in enumerate(source_keys):
                product = tuple(
                    exponent[index] + multiplier[index] for index in range(3)
                )
                result[target_lookup[(shift, generator, product)], output] = vectors[
                    row, column
                ]
    return result % prime


def canonical_quotient_basis(
    kernel: np.ndarray, inherited: np.ndarray, prime: int
) -> tuple[np.ndarray, tuple[int, ...], tuple[int, ...]]:
    if inherited.shape[1]:
        inherited_rank, inherited_columns, _ = graded.rref(inherited, prime)
        base = inherited[:, inherited_columns]
        require(base.shape[1] == inherited_rank, "inherited independent basis")
        pivot_rank, pivot_rows, _ = graded.rref(base.T, prime)
        require(pivot_rank == inherited_rank, "inherited pivot rows")
        pivots = np.asarray(pivot_rows, dtype=np.int64)
        coefficients = inverse_mod(base[pivots, :], prime) @ kernel[pivots, :] % prime
        reduced = (kernel - base @ coefficients) % prime
        require(np.count_nonzero(reduced[pivots, :]) == 0, "quotient elimination")
    else:
        pivot_rows = ()
        reduced = kernel.copy() % prime

    quotient_rank, quotient_columns, _ = graded.rref(reduced, prime)
    quotient = reduced[:, quotient_columns]
    if quotient_rank:
        pivot_rank, quotient_rows, _ = graded.rref(quotient.T, prime)
        require(pivot_rank == quotient_rank, "quotient pivot rows")
        pivots = np.asarray(quotient_rows, dtype=np.int64)
        quotient = quotient @ inverse_mod(quotient[pivots, :], prime) % prime
        require(
            np.array_equal(quotient[pivots, :], np.eye(quotient_rank, dtype=np.int64)),
            "canonical quotient chart",
        )
    else:
        quotient_rows = ()
    return quotient, tuple(int(value) for value in pivot_rows), tuple(
        int(value) for value in quotient_rows
    )


def fiber_d2(
    generators: dict[int, np.ndarray], prime: int
) -> tuple[dict[int, np.ndarray], tuple[object, ...]]:
    previous_kernel: np.ndarray | None = None
    minimal: dict[int, np.ndarray] = {}
    profile: list[object] = []
    for degree in range(11, 19):
        differential = d1_matrix(generators, degree, prime)
        rank, _, kernel = graded.rref(
            differential, prime, emit_nullspace=True
        )
        require(kernel is not None, f"degree{degree} kernel")
        require(
            kernel.shape[1] == EXPECTED_KERNEL_DIMENSIONS[degree],
            f"degree{degree} kernel dimension",
        )
        inherited = (
            np.zeros((differential.shape[1], 0), dtype=np.int64)
            if previous_kernel is None
            else multiply_module_vectors(previous_kernel, degree - 1, degree, prime)
        )
        quotient, inherited_rows, quotient_rows = canonical_quotient_basis(
            kernel, inherited, prime
        )
        expected = EXPECTED_MINIMAL_COUNTS.get(degree, 0)
        require(quotient.shape[1] == expected, f"degree{degree} minimal syzygies")
        require(
            np.count_nonzero(differential @ quotient % prime) == 0,
            f"degree{degree} complex identity",
        )
        if expected:
            minimal[degree] = quotient
        profile.append((degree, inherited_rows, quotient_rows))
        previous_kernel = kernel

    require(tuple(minimal) == tuple(EXPECTED_MINIMAL_COUNTS), "minimal degree order")
    return minimal, tuple(profile)


