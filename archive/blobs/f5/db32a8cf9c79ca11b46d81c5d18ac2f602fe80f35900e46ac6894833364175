    cofinal_rows = []
    for cutoff_index in cutoff_indices:
        next_index = cutoff_index + 1
        cutoff = cutoff_index * cutoff_index
        next_eigenvalue = next_index * next_index
        rank = (
            cutoff_index
            * cutoff_index
            * (cutoff_index + 1)
            * (cutoff_index + 1)
            // 4
        )
        cofinal_rows.append(
            {
                "N": cutoff_index,
                "Lambda_N": cutoff,
                "model_projector_rank_sum_n_cubed": rank,
                "next_model_eigenvalue": next_eigenvalue,
                "Green_tail_bound": str(Fraction(1, next_eigenvalue)),
                "Hodge_homotopy_tail_bound": str(
                    Fraction(1, next_index)
                ),
            }
        )

    cofinal_checks = {
        "cutoffs_are_strictly_increasing": all(
            left["Lambda_N"] < right["Lambda_N"]
            for left, right in zip(cofinal_rows, cofinal_rows[1:])
        ),
        "model_projector_ranks_are_strictly_increasing": all(
            left["model_projector_rank_sum_n_cubed"]
            < right["model_projector_rank_sum_n_cubed"]
            for left, right in zip(cofinal_rows, cofinal_rows[1:])
