def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def source_operator(
    generators11: np.ndarray,
    d7: np.ndarray,
    b6: np.ndarray,
    forms9: tuple[np.ndarray, np.ndarray, np.ndarray],
    prime: int,
) -> np.ndarray:
    linear_d7 = graded.multiply_space(d7[:, None], 7, 8, prime)
    quadratic_b6 = graded.multiply_space(b6[:, None], 6, 8, prime)
    gradient_a1 = np.stack(
        [second_jet.derivative(forms9[1], 9, variable, prime) for variable in range(3)],
        axis=1,
    )
    gradient_a2 = np.stack(
        [second_jet.derivative(forms9[2], 9, variable, prime) for variable in range(3)],
        axis=1,
    )
    first_order = second_jet.canonical_columns(
        np.concatenate((linear_d7, quadratic_b6, gradient_a1, gradient_a2), axis=1),
        prime,
    )
    second_order = second_jet.canonical_columns(
        np.concatenate(
            (first_order, second_jet.second_derivative_family(forms9[0], prime)),
            axis=1,
        ),
        prime,
    )
    require(first_order.shape == (45, 15), "first source dimension")
    require(second_order.shape == (45, 33), "second source dimension")
    multiplication = graded.multiply_space(generators11, 11, 19, prime)
    operator = multiplication @ second_jet.row_lift(second_order) % prime
    require(operator.shape == (210, 132), "source operator shape")
    return operator


def chart_matrix(operator: np.ndarray, prime: int) -> np.ndarray:
    chart = np.zeros((17, 132), dtype=np.int64)
    for row, coordinate in enumerate(ZERO_CHART + (NORMALIZATION_COORDINATE,)):
        chart[row, coordinate] = 1
    return np.concatenate(
        (operator[np.asarray(OPERATOR_ROWS, dtype=np.int64)], chart), axis=0
    ) % prime


def determinant_mod(matrix: np.ndarray, prime: int) -> int:
    work = matrix.astype(np.int64).copy() % prime
    determinant = 1
    for column in range(work.shape[0]):
        choices = np.flatnonzero(work[column:, column] % prime)
        if choices.size == 0:
            return 0
        pivot = column + int(choices[0])
        if pivot != column:
            work[[column, pivot]] = work[[pivot, column]]
            determinant = -determinant
        pivot_value = int(work[column, column] % prime)
        determinant = determinant * pivot_value % prime
        inverse = pow(pivot_value, -1, prime)
        for row in range(column + 1, work.shape[0]):
            factor = int(work[row, column] % prime) * inverse % prime
            if factor:
                work[row, column:] = (
                    work[row, column:] - factor * work[column, column:]
                ) % prime
    return determinant % prime


