        # self-dual, three-form and four-form coordinates compensates for
        # the unnormalized self-dual basis and makes Q-dagger local with
        # scalar metric principal symbol.
        weights = (
            [Fraction(1)]
            + [Fraction(1)] * 4
            + [Fraction(4)] * 3
            + [Fraction(4)] * 3
            + [Fraction(4)] * 4
            + [Fraction(4)]
        )
        differential = zeros(16, 16)
