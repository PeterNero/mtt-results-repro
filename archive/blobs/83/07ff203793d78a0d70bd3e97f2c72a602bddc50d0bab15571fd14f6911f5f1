#!/usr/bin/env python3
"""Run six-prime H02 reconstruction with an independent seventh holdout."""

from __future__ import annotations

import json
import struct
import subprocess
import tempfile
from pathlib import Path
from typing import Any

import numpy as np

import build_ust_g3dr_h02_five_prime_reconstruction_holdout as prior
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
G3DI = ROOT / "state" / "ust_g3di_h02_split_algebra_kernel_relations.packet.json"
G3DJ = ROOT / "state" / "ust_g3dj_h02_second_prime_kernel_relations.packet.json"
G3DK = ROOT / "state" / "ust_g3dk_h02_third_prime_kernel_relations.packet.json"
G3DM = ROOT / "state" / "ust_g3dm_h02_fourth_prime_holdout_kernel.packet.json"
G3DO = ROOT / "state" / "ust_g3do_h02_fifth_prime_holdout_kernel.packet.json"
G3DQ = ROOT / "state" / "ust_g3dq_h02_sixth_prime_holdout_kernel.packet.json"
G3DR = ROOT / "state" / "ust_g3dr_h02_five_prime_reconstruction_holdout.packet.json"
G3DS = ROOT / "state" / "ust_g3ds_h02_seventh_prime_holdout_kernel.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3dt"
OUT = ROOT / "state" / "ust_g3dt_h02_six_prime_reconstruction_holdout.packet.json"
PRIMES = (21817, 33863, 37493, 38113, 68213, 69011)
HOLDOUT = 72271


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> None:
    packet_paths = (
        ("G3DI", G3DI), ("G3DJ", G3DJ), ("G3DK", G3DK), ("G3DM", G3DM),
        ("G3DO", G3DO), ("G3DQ", G3DQ), ("G3DR", G3DR), ("G3DS", G3DS),
    )
    packets = {label: load(path) for label, path in packet_paths}
    require(all(all(packet["checks"].values()) for packet in packets.values()), "input checks")
    records = (
        packets["G3DI"]["split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DJ"]["second_split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DK"]["third_split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DM"]["fourth_split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DO"]["fifth_split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DQ"]["sixth_split_algebra_kernel"]["power_basis_coefficients"],
        packets["G3DS"]["seventh_split_algebra_kernel"]["power_basis_coefficients"],
    )
    arrays_and_paths = [
        prior.checked_coefficients(value, prime)
        for value, prime in zip(records, PRIMES + (HOLDOUT,), strict=True)
    ]
    g3dr = packets["G3DR"]
    source = ROOT / g3dr["native_executor"]["source"]["path"]
    executable = ROOT / g3dr["native_executor"]["executable"]["path"]
    require(prior.sha256(source) == g3dr["native_executor"]["source"]["sha256"], "native source hash")
    require(prior.sha256(executable) == g3dr["native_executor"]["executable"]["sha256"], "native executable hash")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    candidate_path = EVIDENCE / "H02.Q_kernel.six_prime_candidate.mask.bin"
    pass_path = EVIDENCE / "H02.Q_kernel.seventh_prime_pass.mask.bin"
    nonzero_path = EVIDENCE / "H02.Q_kernel.seventh_prime_nonzero_pass.rational.bin"
    log_path = EVIDENCE / "H02.Q_kernel.six_to_seven.audit.log"
    with tempfile.TemporaryDirectory(prefix="ust_g3dt_raw_") as temporary_name:
        temporary = Path(temporary_name)
        raw_inputs: list[tuple[int, int, Path]] = []
        for (coefficients, _), prime in zip(arrays_and_paths, PRIMES + (HOLDOUT,), strict=True):
            raw_path = temporary / f"p{prime}.{coefficients.dtype.name}.raw"
            coefficients.tofile(raw_path)
            raw_inputs.append((prime, coefficients.dtype.itemsize, raw_path))
        command = [
            "wsl", runtime.wsl_path(executable),
            "--entries", str(prior.ENTRIES),
            "--degree-size", str(prior.ENTRIES_PER_DEGREE),
        ]
        for prime, width, path in raw_inputs[:-1]:
            command += ["--construction", str(prime), str(width), runtime.wsl_path(path)]
        prime, width, path = raw_inputs[-1]
        command += [
            "--holdout", str(prime), str(width), runtime.wsl_path(path),
            "--candidate-mask", runtime.wsl_path(candidate_path),
            "--pass-mask", runtime.wsl_path(pass_path),
            "--nonzero-pass", runtime.wsl_path(nonzero_path),
            "--log", runtime.wsl_path(log_path),
        ]
        completed = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=False)
        require(completed.returncode == 0, completed.stdout + completed.stderr)

    fields = prior.parse_log(log_path)
    require(fields["CONSTRUCTION_PRIMES"] == " ".join(map(str, PRIMES)), "construction primes")
    require(int(fields["HOLDOUT_PRIME"]) == HOLDOUT, "holdout prime")
    candidate_count = int(fields["CANDIDATES"])
    pass_count = int(fields["PASSES"])
    alias_count = int(fields["ALIASES"])
    no_candidate = int(fields["NO_CANDIDATE"])
    require(candidate_count + no_candidate == prior.ENTRIES, "candidate coverage")
    require(pass_count + alias_count == candidate_count, "candidate partition")
    candidate_mask = np.fromfile(candidate_path, dtype=np.uint8).reshape(6, prior.BYTES_PER_DEGREE)
    pass_mask = np.fromfile(pass_path, dtype=np.uint8).reshape(6, prior.BYTES_PER_DEGREE)
    require(sum(int(np.unpackbits(row, bitorder="little")[:prior.ENTRIES_PER_DEGREE].sum()) for row in candidate_mask) == candidate_count, "candidate mask")
    require(sum(int(np.unpackbits(row, bitorder="little")[:prior.ENTRIES_PER_DEGREE].sum()) for row in pass_mask) == pass_count, "pass mask")
    previous_path = ROOT / packets["G3DR"]["evidence"]["holdout_pass_mask"]["path"]
    previous = np.fromfile(previous_path, dtype=np.uint8).reshape(6, prior.BYTES_PER_DEGREE)
    retained = lost = new_stable = 0
    per_degree: list[dict[str, int]] = []
    for degree in range(6):
        old_bits = np.unpackbits(previous[degree], bitorder="little")[:prior.ENTRIES_PER_DEGREE].astype(bool)
        new_bits = np.unpackbits(pass_mask[degree], bitorder="little")[:prior.ENTRIES_PER_DEGREE].astype(bool)
        retained_row = int(np.count_nonzero(old_bits & new_bits))
        lost_row = int(np.count_nonzero(old_bits & ~new_bits))
        new_row = int(np.count_nonzero(~old_bits & new_bits))
        retained += retained_row
        lost += lost_row
        new_stable += new_row
        per_degree.append(
            {
                "degree": degree,
                "entries": int(fields[f"DEGREE_{degree}_ENTRIES"]),
                "six_prime_candidates": int(fields[f"DEGREE_{degree}_CANDIDATES"]),
                "seventh_prime_holdout_passes": int(fields[f"DEGREE_{degree}_PASSES"]),
                "six_prime_aliases": int(fields[f"DEGREE_{degree}_ALIASES"]),
                "six_prime_no_candidate": int(fields[f"DEGREE_{degree}_NO_CANDIDATE"]),
                "pass_integers": int(fields[f"DEGREE_{degree}_PASS_INTEGERS"]),
                "pass_zeros": int(fields[f"DEGREE_{degree}_PASS_ZEROS"]),
                "pass_nonzero": int(fields[f"DEGREE_{degree}_PASS_NONZERO"]),
                "retained_five_prime_passes": retained_row,
                "lost_five_prime_passes": lost_row,
                "new_stable_beyond_five_prime": new_row,
            }
        )
    raw = nonzero_path.read_bytes()[:40]
    require(raw[:8] == b"MTTRRZ1\0", "nonzero magic")
    binary_entries, binary_records, construction_count, binary_holdout = struct.unpack_from("<4Q", raw, 8)
    require(binary_entries == prior.ENTRIES and binary_records == int(fields["PASS_NONZERO"]), "nonzero header")
    require(construction_count == len(PRIMES) and binary_holdout == HOLDOUT, "nonzero provenance")
    require(nonzero_path.stat().st_size == 40 + binary_records * 24, "nonzero length")
    totals = {
        "entries": prior.ENTRIES,
        "six_prime_candidates": candidate_count,
        "seventh_prime_holdout_passes": pass_count,
        "six_prime_aliases": alias_count,
        "six_prime_no_candidate": no_candidate,
        "pass_integers": int(fields["PASS_INTEGERS"]),
        "pass_zeros": int(fields["PASS_ZEROS"]),
        "pass_nonzero": int(fields["PASS_NONZERO"]),
        "retained_five_prime_passes": retained,
        "lost_five_prime_passes": lost,
        "new_stable_beyond_five_prime": new_stable,
    }
    checks = {
        "G3DI_through_G3DS_are_hash_bound_and_passing": True,
        "the_G3DR_signed128_executor_is_hash_bound": True,
        "all46032168_coefficients_are_audited": int(fields["ENTRIES"]) == prior.ENTRIES,
        "six_prime_candidates_are_partitioned_by_independent_prime72271": candidate_count == pass_count + alias_count,
        "candidate_and_pass_masks_replay_native_counts": True,
        "all_nonzero_passing_fractions_are_persisted": binary_records == int(fields["PASS_NONZERO"]),
        "no_finite_holdout_pass_is_promoted_to_Q_gamma": True,
        "no_observed_value_or_fit_is_used": True,
    }
    require(all(checks.values()), "G3DT checks")
    packet = {
        "schema": "mtt.unified-source.g3dt-h02-six-prime-reconstruction-holdout.v1",
        "date": "2026-08-14",
        "theorem_id": "UST.G3DT",
        "status": "CLOSED_EXACT_SIX_PRIME_RECONSTRUCTION_WITH_INDEPENDENT_SEVENTH_PRIME_HOLDOUT",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {label: prior.record(path) for label, path in packet_paths},
        "coefficient_archives": [prior.record(path) for _, path in arrays_and_paths],
        "native_executor": {"source": prior.record(source), "executable": prior.record(executable), "stdout": completed.stdout.strip()},
        "reconstruction_contract": {
            "construction_primes": list(PRIMES),
            "reserved_holdout_prime": HOLDOUT,
            "six_prime_modulus": int(fields["MODULUS"]),
            "six_prime_modulus_bits": int(fields["MODULUS_BITS"]),
            "six_prime_uniqueness_bound": int(fields["UNIQUENESS_BOUND"]),
            "algorithm": "signed-__int128 extended-Euclidean uniqueness-range rational reconstruction",
        },
        "totals": totals,
        "fractions": {
            "candidate_fraction": candidate_count / prior.ENTRIES,
            "holdout_pass_fraction_of_all": pass_count / prior.ENTRIES,
            "holdout_pass_fraction_of_candidates": pass_count / candidate_count,
            "alias_fraction_of_candidates": alias_count / candidate_count,
            "new_stable_fraction_of_all": new_stable / prior.ENTRIES,
        },
        "per_degree": per_degree,
        "evidence": {
            "candidate_mask": prior.record(candidate_path),
            "holdout_pass_mask": prior.record(pass_path),
            "nonzero_passing_fractions": prior.record(nonzero_path),
            "native_log": prior.record(log_path),
        },
        "checks": checks,
        "guardrails": {
            "claims_a_holdout_pass_is_an_exact_rational_coefficient": False,
            "claims_the_relations_lift_to_Q_gamma": False,
            "claims_rank_Q_gamma_Q_equals4748": False,
            "claims_path_source_readout_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3dtH02SixPrimeReconstructionHoldout",
            "tier": "CLOSED_EXACT_U128_MULTIPRIME_RECONSTRUCTION_AUDIT",
            "statement": "The hash-bound signed128 executor reconstructs every H02 kernel coefficient from six split-prime archives and tests it against reserved prime72271. Exact candidate, pass and nonzero rational payloads are persisted without a characteristic-zero promotion.",
        },
        "frontier_delta": {
            "before": "Five-prime candidates had sixth-prime verdicts.",
            "after": "Six-prime candidates have exact seventh-prime verdicts and are ready for the final persisted-prime holdout.",
        },
        "next_required_object": "Execute prime73673, construct seven-prime candidates, perform the eighth-prime holdout, then choose between direct exact relation verification and new-prime generation based on unresolved coefficient count.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3DT H02 six-prime reconstruction holdout: PASS")
    print(f"six_candidates={candidate_count} holdout_pass={pass_count} aliases={alias_count} new_stable={new_stable} nonzero_pass={binary_records}")
    print(f"packet_sha256={prior.sha256(OUT)}")


if __name__ == "__main__":
    main()
