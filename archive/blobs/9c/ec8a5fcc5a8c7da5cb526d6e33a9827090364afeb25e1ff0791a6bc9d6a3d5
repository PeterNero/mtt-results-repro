#!/usr/bin/env python3
"""Verify UST.G3O with exact exterior-algebra arithmetic."""

from __future__ import annotations

import json
from dataclasses import dataclass
from fractions import Fraction
from pathlib import Path


ROOT = Path(__file__).resolve().parent
PACKET_PATH = ROOT / "state" / "ust_g3o_same_object_qutrit_chern_cutset.packet.json"
LOCK_PATH = ROOT / "state" / "upstream-lock.json"

ATOM_DEGREE = {"H": 2, "gamma": 3, "s": 1, "a": 1, "x": 1, "y": 1}
ATOM_ORDER = {name: index for index, name in enumerate(ATOM_DEGREE)}
BASE_ATOMS = {"H", "gamma"}


@dataclass(frozen=True)
class Linear:
    """An exact coefficient c0+c1*d."""

    c0: Fraction = Fraction(0)
    c1: Fraction = Fraction(0)

    def __add__(self, other: "Linear") -> "Linear":
        return Linear(self.c0 + other.c0, self.c1 + other.c1)

    def __neg__(self) -> "Linear":
        return Linear(-self.c0, -self.c1)

    def __sub__(self, other: "Linear") -> "Linear":
        return self + (-other)

    def scale(self, value: int | Fraction) -> "Linear":
        factor = Fraction(value)
        return Linear(factor * self.c0, factor * self.c1)

    def evaluate(self, d: int) -> Fraction:
        return self.c0 + self.c1 * d


Monomial = tuple[str, ...]
Form = dict[Monomial, Linear]


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def load(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def canonicalize(sequence: Monomial) -> tuple[int, Monomial] | None:
    for atom in set(sequence):
        if ATOM_DEGREE[atom] % 2 and sequence.count(atom) > 1:
            return None
    if sum(ATOM_DEGREE[name] for name in sequence if name in BASE_ATOMS) > 4:
        return None

    sign = 1
    for index, left in enumerate(sequence):
        for right in sequence[index + 1 :]:
            if ATOM_ORDER[left] > ATOM_ORDER[right]:
                if (ATOM_DEGREE[left] * ATOM_DEGREE[right]) % 2:
                    sign *= -1
    return sign, tuple(sorted(sequence, key=ATOM_ORDER.__getitem__))


def add(*forms: Form) -> Form:
    result: Form = {}
    for form in forms:
        for monomial, coefficient in form.items():
            result[monomial] = result.get(monomial, Linear()) + coefficient
    return {key: value for key, value in result.items() if value != Linear()}


def scale(form: Form, value: int | Fraction) -> Form:
    return {key: coefficient.scale(value) for key, coefficient in form.items()}


def wedge(left: Form, right: Form) -> Form:
    result: Form = {}
    for left_key, left_value in left.items():
        for right_key, right_value in right.items():
            # Only one input contains d, so the exact product stays linear.
            require(
                left_value.c1 == 0 or right_value.c1 == 0,
                "unexpected quadratic dependence on d",
            )
            canonical = canonicalize(left_key + right_key)
            if canonical is None:
                continue
            sign, key = canonical
            product = Linear(
                left_value.c0 * right_value.c0,
                left_value.c0 * right_value.c1 + left_value.c1 * right_value.c0,
            ).scale(sign)
            result[key] = result.get(key, Linear()) + product
    return {key: value for key, value in result.items() if value != Linear()}


def constant(value: int, *atoms: str) -> Form:
    return {tuple(atoms): Linear(Fraction(value), Fraction(0))}


def d_coefficient(*atoms: str) -> Form:
    return {tuple(atoms): Linear(Fraction(0), Fraction(1))}


def integrate_xy(form: Form) -> Form:
    result: Form = {}
    for monomial, coefficient in form.items():
        if "x" not in monomial or "y" not in monomial:
            continue
        key = tuple(name for name in monomial if name not in {"x", "y"})
        result[key] = result.get(key, Linear()) + coefficient
    return {key: value for key, value in result.items() if value != Linear()}


def verify_source_locks(packet: dict, lock: dict) -> None:
    for source in packet["inputs"].values():
        repository = next(
            item for item in lock["repositories"] if item["id"] == source["repository_id"]
        )
        locked = next(item for item in repository["sources"] if item["path"] == source["path"])
        require(source["sha256"] == locked["sha256"], f"source hash: {source['path']}")


def exact_transport() -> tuple[Form, Form]:
    # Ch_alpha(S_HS)=3H-3 gamma*x+3 x*y-H*x*y.
    spectral_hs = add(
        constant(3, "H"),
        constant(-3, "gamma", "x"),
        constant(3, "x", "y"),
        constant(-1, "H", "x", "y"),
    )
    atiyah = add(constant(3), d_coefficient("x", "y"))
    spectral_tensor = wedge(spectral_hs, atiyah)

    expected_spectral = add(
        constant(9, "H"),
        constant(-9, "gamma", "x"),
        constant(9, "x", "y"),
        {("H", "x", "y"): Linear(Fraction(-3), Fraction(3))},
    )
    require(spectral_tensor == expected_spectral, "spectral tensor Chern row")

    # exp(-F), F=-s*x-a*y. Terms beyond the displayed quadratic term cannot
    # contribute to integration over the one-dimensional target torus.
    inverse_kernel = add(
        constant(1),
        constant(1, "s", "x"),
        constant(1, "a", "y"),
        constant(1, "s", "x", "a", "y"),
    )
    inverse = integrate_xy(wedge(inverse_kernel, spectral_tensor))
    expected_inverse = add(
        constant(9),
        {("H",): Linear(Fraction(-3), Fraction(3))},
        constant(-9, "H", "s", "a"),
        constant(9, "gamma", "a"),
    )
    require(inverse == expected_inverse, "inverse BHT character")
    return spectral_tensor, inverse


def verify_determinant_and_sign(packet: dict, inverse: Form) -> None:
    # c1 coefficient is 3(d-1)H before an ambient base twist nH. After the
    # rank-nine twist it is 3(d-1)+9n. Integrality is equivalent to d=1 mod 3.
    h_coefficient = inverse[("H",)]
    require(h_coefficient == Linear(Fraction(-3), Fraction(3)), "c1 coefficient")
    for d in range(-20, 21):
        numerator = -(d - 1)
        has_integral_twist = numerator % 3 == 0
        require(has_integral_twist == (d % 3 == 1), "determinant congruence")
        if has_integral_twist:
            n = numerator // 3
            require(3 * (d - 1) + 9 * n == 0, "determinant solution")

    require(-1 % 3 != 1, "canonical negative carrier unexpectedly normalizable")
    require(1 % 3 == 1, "dual positive carrier not normalizable")

    # -9H*s*a+9gamma*a = -9(H*s-gamma)*a = -9u in ch2.
    require(inverse[("H", "s", "a")].evaluate(0) == -9, "Hsa coefficient")
    require(inverse[("gamma", "a")].evaluate(0) == 9, "gamma-a coefficient")
    mixed_ch2 = -9
    mixed_c2 = -mixed_ch2
    hidden_target = packet["locked_rows"]["hidden_target_c2_mixed_coefficient"]
    require(mixed_c2 == 9, "candidate mixed c2")
    require(hidden_target == -9, "locked hidden mixed c2")
    require(mixed_c2 - hidden_target == 18, "mixed-sign mismatch")

    decision = packet["hidden_sign_decision"]
    require(decision["determinant_normalized_mixed_ch2"] == mixed_ch2, "packet ch2")
    require(decision["determinant_normalized_mixed_c2"] == mixed_c2, "packet c2")
    require(decision["selected_hidden_mixed_c2"] == hidden_target, "packet target")
    require(decision["coefficient_mismatch"] == 18, "packet mismatch")
    require(decision["decision"] == "NO_GO_FOR_PHYSICAL_HIDDEN_W9", "decision")


def verify_scope(packet: dict) -> None:
    scope = packet["scope"]
    require(scope["ambient_Atiyah_tensor_shortcut_retired"], "shortcut not retired")
    require(scope["direct_global_repaired_g3h_route_open"], "direct route retired")
    require(scope["intrinsic_rank3_twisted_spectral_module_open"], "intrinsic route retired")
    require(scope["nonfactorized_projective_p39_presentation_open"], "P39 route retired")
    require(not scope["physical_hidden_W9_constructed"], "physical W9 promoted")
    require(not scope["B_HS_01_closed"], "B.HS.01 promoted")
    require(packet["continuous_fit_parameters"] == 0, "fit parameter introduced")
    require(packet["observed_inputs"] == 0, "observed input introduced")


def main() -> None:
    packet = load(PACKET_PATH)
    lock = load(LOCK_PATH)
    require(
        packet["schema"] == "mtt.unified-source.q79-same-object-qutrit-chern-cutset.v1",
        "packet schema",
    )
    require(packet["theorem_id"] == "UST.G3O", "theorem id")
    require(
        packet["status"]
        == "CLOSED_EXACT_AMBIENT_ATIYAH_TENSOR_CHERN_ROWS_AND_HIDDEN_SIGN_NOGO_DIRECT_REPAIRED_AND_INTRINSIC_SPECTRAL_ROUTES_OPEN",
        "status",
    )
    verify_source_locks(packet, lock)
    spectral, inverse = exact_transport()
    verify_determinant_and_sign(packet, inverse)
    verify_scope(packet)

    require(spectral[("x", "y")].evaluate(0) == 9, "virtual length nine")
    require(inverse[()].evaluate(0) == 9, "inverse rank nine")

    print("UST.G3O same-object qutrit Chern cutset: PASS")
    print("inverse-BHT row: exp(D) * (9 + 3(d-1)H - 9u)")
    print("determinant-zero condition: d = 1 mod 3")
    print("candidate mixed c2: +9u; selected hidden target: -9u")
    print("ambient Atiyah-tensor hidden shortcut: RETIRED")


if __name__ == "__main__":
    main()
