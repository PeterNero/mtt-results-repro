Monomial = tuple[int, int]
Polynomial = dict[Monomial, Fraction]
Vector = tuple[Fraction, ...]
Matrix = tuple[tuple[Fraction, ...], ...]
Residual = tuple[Polynomial, ...]


def poly_clean(value: Polynomial) -> Polynomial:
    return {key: coefficient for key, coefficient in value.items() if coefficient}


def poly_add(left: Polynomial, right: Polynomial) -> Polynomial:
    output = dict(left)
    for monomial, coefficient in right.items():
        output[monomial] = output.get(monomial, Fraction(0)) + coefficient
    return poly_clean(output)


def poly_scale(coefficient, value: Polynomial) -> Polynomial:
    scalar = Fraction(coefficient)
    return poly_clean({monomial: scalar * item for monomial, item in value.items()})


def poly_multiply(left: Polynomial, right: Polynomial) -> Polynomial:
    output: Polynomial = {}
    for (left_x, left_y), left_value in left.items():
        for (right_x, right_y), right_value in right.items():
            monomial = (left_x + right_x, left_y + right_y)
            output[monomial] = output.get(monomial, Fraction(0)) + left_value * right_value
    return poly_clean(output)


def substitute_diagonal(value: Polynomial, x_scale, y_scale) -> Polynomial:
    x_factor = Fraction(x_scale)
    y_factor = Fraction(y_scale)
    return poly_clean(
        {
            monomial: coefficient
            * x_factor ** monomial[0]
            * y_factor ** monomial[1]
            for monomial, coefficient in value.items()
        }
    )


def repair_cost(residual: Residual) -> Polynomial:
    output: Polynomial = {}
    for component in residual:
        output = poly_add(output, poly_multiply(component, component))
    return poly_scale(Fraction(1, 2), output)


def scalar_metric_repair_cost(residual: Polynomial, metric: Polynomial) -> Polynomial:
    return poly_scale(
        Fraction(1, 2),
        poly_multiply(poly_multiply(residual, metric), residual),
    )


def derivative_at_zero(value: Polynomial, directions: tuple[int, ...]) -> Fraction:
    x_count = directions.count(0)
    y_count = directions.count(1)
    coefficient = value.get((x_count, y_count), Fraction(0))
    return coefficient * math.factorial(x_count) * math.factorial(y_count)


def residual_jet(residual: Residual, directions: tuple[int, ...]) -> Vector:
    return tuple(derivative_at_zero(component, directions) for component in residual)


def dot(left: Vector, right: Vector) -> Fraction:
    return sum(
        (lhs * rhs for lhs, rhs in zip(left, right, strict=True)),
        Fraction(0),
    )


def residual_partition_jet(residual: Residual, directions: tuple[int, ...]) -> Fraction:
    """D^n (1/2 ||Phi||^2) from the complete subset Leibniz formula."""

    total = Fraction(0)
    count = len(directions)
    for mask in range(1 << count):
        left = tuple(directions[index] for index in range(count) if mask & (1 << index))
        right = tuple(directions[index] for index in range(count) if not mask & (1 << index))
        total += dot(residual_jet(residual, left), residual_jet(residual, right))
    return total / 2


def scalar_three_color_jet(
    residual: Polynomial,
    metric: Polynomial,
    directions: tuple[int, ...],
) -> Fraction:
    """Full Phi-W-Phi Leibniz formula for a field-dependent scalar metric."""

    total = Fraction(0)
    for colors in product(range(3), repeat=len(directions)):
        left = tuple(
            direction
            for direction, color in zip(directions, colors, strict=True)
            if color == 0
        )
        middle = tuple(
            direction
            for direction, color in zip(directions, colors, strict=True)
            if color == 1
        )
        right = tuple(
            direction
            for direction, color in zip(directions, colors, strict=True)
            if color == 2
        )
        total += (
            derivative_at_zero(residual, left)
            * derivative_at_zero(metric, middle)
            * derivative_at_zero(residual, right)
        )
    return total / 2


def all_three_color_identities(
    residual: Polynomial,
    metric: Polynomial,
    maximum_order: int,
) -> bool:
    cost = scalar_metric_repair_cost(residual, metric)
    for order in range(maximum_order + 1):
        for directions in product(range(2), repeat=order):
            if derivative_at_zero(cost, directions) != scalar_three_color_jet(
                residual, metric, directions
            ):
                return False
    return True


def all_jet_identities(residual: Residual, maximum_order: int) -> bool:
    cost = repair_cost(residual)
    for order in range(maximum_order + 1):
        for directions in product(range(2), repeat=order):
            if derivative_at_zero(cost, directions) != residual_partition_jet(
                residual, directions
            ):
                return False
    return True


def matrix(rows) -> Matrix:
    return tuple(tuple(Fraction(value) for value in row) for row in rows)


def transpose(value: Matrix) -> Matrix:
    return matrix(zip(*value, strict=True))


def multiply(left: Matrix, right: Matrix) -> Matrix:
    shared = len(right)
    if any(len(row) != shared for row in left):
        raise ValueError("incompatible matrix shapes")
    columns = len(right[0])
    return matrix(
        [
            [
                sum(
                    (left[row][inner] * right[inner][column] for inner in range(shared)),
                    Fraction(0),
                )
                for column in range(columns)
            ]
            for row in range(len(left))
        ]
    )


def inverse_diagonal(value: Matrix) -> Matrix:
    if any(
        entry and row != column
        for row, entries in enumerate(value)
        for column, entry in enumerate(entries)
    ):
        raise ValueError("matrix is not diagonal")
    return matrix(
        [
            [Fraction(1) / value[row][row] if row == column else 0 for column in range(len(value))]
            for row in range(len(value))
        ]
    )


def identity(dimension: int) -> Matrix:
    return matrix(
        [
            [1 if row == column else 0 for column in range(dimension)]
            for row in range(dimension)
        ]
    )


def matrix_power(value: Matrix, exponent: int) -> Matrix:
    output = identity(len(value))
    factor = value
    remaining = exponent
    while remaining:
        if remaining % 2:
            output = multiply(output, factor)
        factor = multiply(factor, factor)
        remaining //= 2
    return output


def hessian_form(cost: Polynomial) -> Matrix:
    return matrix(
        [
            [derivative_at_zero(cost, (row, column)) for column in range(2)]
            for row in range(2)
        ]
    )


def gaussian_even_moment(covariance: Fraction, degree: int) -> Fraction:
    if degree % 2:
        return Fraction(0)
    pairings = math.prod(range(1, degree, 2)) if degree else 1
    return Fraction(pairings) * covariance ** (degree // 2)


def serialize_polynomial(value: Polynomial) -> dict[str, str]:
    return {
        f"x^{monomial[0]}*y^{monomial[1]}": str(coefficient)
        for monomial, coefficient in sorted(value.items())
    }


def serialize_matrix(value: Matrix) -> list[list[str]]:
    return [[str(entry) for entry in row] for row in value]


