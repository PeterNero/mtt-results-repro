#!/usr/bin/env python3
"""Adopt a passing path-isolated std basis as the canonical selected cache."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
HEDGE = ROOT / "state" / "ust_g3am_selected_cayley_basis_std.result.json"
NORED_HEDGE = ROOT / "state" / "ust_g3am_selected_cayley_basis_std_nored.result.json"
CANONICAL = ROOT / "state" / "ust_g3al_selected_cayley_basis.result.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def artifact(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--variant", choices=("red", "nored"), default="red")
    args = parser.parse_args()
    hedge_path = NORED_HEDGE if args.variant == "nored" else HEDGE
    hedge = json.loads(hedge_path.read_text(encoding="ascii"))
    require(
        hedge["schema"] == "mtt.unified-source.g3am-selected-cayley-basis-std-hedge-result.v1",
        "hedge schema",
    )
    require(hedge["passed"] is True, "std hedge passed")
    require(hedge["returncode"] == 0 and hedge["timed_out"] is False, "std execution")
    source = artifact(hedge["source"], "source hash")
    script = artifact(hedge["script"], "std script hash")
    output = artifact(hedge["output"], "std output hash")
    cache = artifact(hedge["cache"], "std cache hash")
    expected_source = source.read_text(encoding="ascii")
    if args.variant == "nored":
        require(hedge["algorithm"] == "std_nored", "nored algorithm")
        require(expected_source.count("option(redSB);\n") == 1, "one redSB option")
        expected_source = expected_source.replace("option(redSB);\n", "", 1)
    else:
        require(hedge["algorithm"] == "std", "redSB algorithm")
    expected = expected_source.replace(
        "ideal G=slimgb(J);", "ideal G=std(J);"
    ).replace(
        'write("ssi:w state/ust_g3al_selected_cayley_basis.ssi",G);',
        f'write("ssi:w {hedge["cache"]["path"]}",G);',
    )
    require(script.read_text(encoding="ascii") == expected, "std script is mechanical hedge")
    raw_output = output.read_text(encoding="utf-8")
    require("G3AL_SELECTED_CAYLEY_BASIS_PASS" in raw_output, "basis pass marker")
    require("G3AL_SOCLE_ZERO=0" in raw_output, "nonzero socle marker")
    require(cache.stat().st_size == hedge["cache"]["bytes"] > 0, "cache bytes")
    result = {
        "schema": "mtt.unified-source.g3al-selected-cayley-basis-result.v1",
        "source": hedge["source"],
        "script": hedge["script"],
        "output": hedge["output"],
        "cache": hedge["cache"],
        "algorithm": hedge["algorithm"],
        "adopted_from": {
            "path": str(hedge_path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(hedge_path),
        },
        "elapsed_seconds": hedge["elapsed_seconds"],
        "returncode": 0,
        "timed_out": False,
        "passed": True,
    }
    CANONICAL.write_text(json.dumps(result, indent=2) + "\n", encoding="ascii")
    print(f"UST.G3AM std Cayley basis adopted variant={args.variant}: PASS")


if __name__ == "__main__":
    main()
