    gaussian_zero = (Fraction(0), Fraction(0))
    gaussian_one = (Fraction(1), Fraction(0))

    def gaussian_add(
        left: tuple[Fraction, Fraction],
        right: tuple[Fraction, Fraction],
    ) -> tuple[Fraction, Fraction]:
        return left[0] + right[0], left[1] + right[1]

    def gaussian_mul(
        left: tuple[Fraction, Fraction],
        right: tuple[Fraction, Fraction],
    ) -> tuple[Fraction, Fraction]:
        return (
            left[0] * right[0] - left[1] * right[1],
            left[0] * right[1] + left[1] * right[0],
        )

    def gaussian_conjugate(
        value: tuple[Fraction, Fraction],
    ) -> tuple[Fraction, Fraction]:
        return value[0], -value[1]

    def laurent_constant(
        real: Fraction | int = 0,
        imag: Fraction | int = 0,
    ) -> dict[int, tuple[Fraction, Fraction]]:
        value = (Fraction(real), Fraction(imag))
        return {} if value == gaussian_zero else {0: value}

    def laurent_monomial(
        exponent: int,
        real: Fraction | int = 1,
        imag: Fraction | int = 0,
    ) -> dict[int, tuple[Fraction, Fraction]]:
        value = (Fraction(real), Fraction(imag))
        return {} if value == gaussian_zero else {exponent: value}

    def laurent_add(
        left: dict[int, tuple[Fraction, Fraction]],
        right: dict[int, tuple[Fraction, Fraction]],
    ) -> dict[int, tuple[Fraction, Fraction]]:
        output = dict(left)
        for exponent, value in right.items():
            combined = gaussian_add(
                output.get(exponent, gaussian_zero),
                value,
            )
            if combined == gaussian_zero:
                output.pop(exponent, None)
            else:
                output[exponent] = combined
        return output

    def laurent_scale(
        polynomial: dict[int, tuple[Fraction, Fraction]],
        scalar: tuple[Fraction, Fraction],
    ) -> dict[int, tuple[Fraction, Fraction]]:
        output = {}
        for exponent, value in polynomial.items():
            scaled = gaussian_mul(value, scalar)
            if scaled != gaussian_zero:
                output[exponent] = scaled
        return output

    def laurent_mul(
        left: dict[int, tuple[Fraction, Fraction]],
        right: dict[int, tuple[Fraction, Fraction]],
    ) -> dict[int, tuple[Fraction, Fraction]]:
        output: dict[int, tuple[Fraction, Fraction]] = {}
        for left_exponent, left_value in left.items():
            for right_exponent, right_value in right.items():
                output = laurent_add(
                    output,
                    {
                        left_exponent + right_exponent: gaussian_mul(
                            left_value,
                            right_value,
                        )
                    },
                )
        return output

    def laurent_conjugate(
        polynomial: dict[int, tuple[Fraction, Fraction]],
    ) -> dict[int, tuple[Fraction, Fraction]]:
        return {
            -exponent: gaussian_conjugate(value)
            for exponent, value in polynomial.items()
        }

    def laurent_derivative(
        polynomial: dict[int, tuple[Fraction, Fraction]],
    ) -> dict[int, tuple[Fraction, Fraction]]:
        return {
            exponent: gaussian_mul(
                value,
                (Fraction(0), Fraction(exponent)),
            )
            for exponent, value in polynomial.items()
            if exponent != 0
        }

    def laurent_matrix_zero(
        rows: int,
        columns: int,
    ) -> list[
        list[dict[int, tuple[Fraction, Fraction]]]
    ]:
        return [
            [laurent_constant() for _ in range(columns)]
            for _ in range(rows)
        ]

    def laurent_matrix_add(
        left: list[
            list[dict[int, tuple[Fraction, Fraction]]]
        ],
        right: list[
            list[dict[int, tuple[Fraction, Fraction]]]
        ],
    ) -> list[
        list[dict[int, tuple[Fraction, Fraction]]]
    ]:
        return [
            [
                laurent_add(
                    left[row][column],
                    right[row][column],
                )
                for column in range(len(left[0]))
            ]
            for row in range(len(left))
        ]

    def laurent_matrix_scale(
        matrix: list[
            list[dict[int, tuple[Fraction, Fraction]]]
        ],
        scalar: tuple[Fraction, Fraction],
    ) -> list[
        list[dict[int, tuple[Fraction, Fraction]]]
    ]:
        return [
            [
                laurent_scale(value, scalar)
                for value in row
            ]
            for row in matrix
