def matrix_unit(row: int, column: int, dimension: int):
    return matrix(
        [
            [1 if i == row and j == column else 0 for j in range(dimension)]
            for i in range(dimension)
        ]
    )


def subtract(left, right):
    return add(left, scale(-1, right))


def nonzero(value) -> bool:
    return any(entry != ZERO for row in value for entry in row)


def conjugate_by(gauge, value):
    return matmul(matmul(gauge, value), inverse(gauge))


def matrix_trace(value):
    return sum((value[index][index] for index in range(len(value))), ZERO)


def matrix_power(value, exponent: int):
    output = identity(len(value))
    for _ in range(exponent):
        output = matmul(output, value)
    return output


def qutrit_data():
    shift = matrix([[0, 0, 1], [1, 0, 0], [0, 1, 0]])
    clock = matrix([[1, 0, 0], [0, OMEGA, 0], [0, 0, OMEGA2]])
    return shift, clock


def spin_qutrit_supercharge(shift):
    unit3 = identity(3)
    e01 = matrix_unit(0, 1, 3)
    e10 = matrix_unit(1, 0, 3)
    e02 = matrix_unit(0, 2, 3)
    e20 = matrix_unit(2, 0, 3)
    return add(
        add(kronecker(e01, unit3), kronecker(e10, unit3)),
        add(kronecker(e02, shift), kronecker(e20, adjoint(shift))),
    )


def coefficient_parity(row: int, column: int) -> int:
    spin_parity = (0, 1, 1)
    return (spin_parity[row // 3] + spin_parity[column // 3]) % 2


def curved_differential(q_value, item, parity: int):
    return subtract(
        matmul(q_value, item),
        scale((-1) ** parity, matmul(item, q_value)),
    )


def output_masks(vector):
    return [mask for mask, coefficient in enumerate(vector) if coefficient != 0]


def heisenberg_overlap_equivariance() -> tuple[bool, bool, bool, bool]:
    product_ok = True
    m3_ok = True
    contraction_ok = True
    triple_ok = True

    for mask in range(NIL.DIMENSION):
        triple_ok = triple_ok and OMEGA ** (3 * NIL.weight(mask)) == ONE
        projected = NIL.project(NIL.basis(mask))
        homotopy = NIL.homotopy(NIL.basis(mask))
        contraction_ok = contraction_ok and all(
            NIL.weight(output_mask) == NIL.weight(mask)
            for output_mask in output_masks(projected) + output_masks(homotopy)
        )

    for left in NIL.HARMONIC_MASKS:
        for right in NIL.HARMONIC_MASKS:
            result = NIL.m2(NIL.basis(left), NIL.basis(right))
            product_ok = product_ok and all(
                NIL.weight(output_mask)
                == (NIL.weight(left) + NIL.weight(right)) % 3
                for output_mask in output_masks(result)
            )
            for final in NIL.HARMONIC_MASKS:
                result3 = NIL.m3(left, right, final)
                m3_ok = m3_ok and all(
                    NIL.weight(output_mask)
                    == (
                        NIL.weight(left)
                        + NIL.weight(right)
                        + NIL.weight(final)
                    )
                    % 3
                    for output_mask in output_masks(result3)
                )
    return product_ok, m3_ok, contraction_ok, triple_ok


def adjoint_is_multiplicative(gauge, dimension: int) -> bool:
    # It is enough to check matrix units because both sides are bilinear.
    basis = [
        matrix_unit(row, column, dimension)
        for row in range(dimension)
        for column in range(dimension)
    ]
    images = [conjugate_by(gauge, item) for item in basis]
    for left_index, left in enumerate(basis):
        for right_index, right in enumerate(basis):
            if not matrix_equal(
                conjugate_by(gauge, matmul(left, right)),
                matmul(images[left_index], images[right_index]),
            ):
                return False
    return True


def curved_differential_glues(q_left, q_right, gauge) -> bool:
    for row in range(9):
        for column in range(9):
            item_right = matrix_unit(row, column, 9)
            parity = coefficient_parity(row, column)
            item_left = conjugate_by(gauge, item_right)
            if not matrix_equal(
                curved_differential(q_left, item_left, parity),
                conjugate_by(
                    gauge,
                    curved_differential(q_right, item_right, parity),
                ),
            ):
                return False
    return True


def main() -> int:
    shift, clock = qutrit_data()
    unit3 = identity(3)
    unit9 = identity(9)

    # These are transition maps from chart j to chart i. Their triple product
    # is scalar, so the fundamental rank-nine atlas is projective rather than
    # an ordinary vector-bundle cocycle.
    g01 = kronecker(unit3, shift)
    g12 = kronecker(unit3, clock)
    g20 = scale(OMEGA, inverse(matmul(g01, g12)))
    projective_triple = matmul(matmul(g01, g12), g20)

    q0 = spin_qutrit_supercharge(shift)
    q1 = conjugate_by(inverse(g01), q0)
    q2 = conjugate_by(inverse(g12), q1)
    local_q = (q0, q1, q2)
    local_f = tuple(matmul(item, item) for item in local_q)
    overlaps = (
        (0, 1, g01),
        (1, 2, g12),
        (2, 0, g20),
    )

    q_gluing = all(
        matrix_equal(local_q[left], conjugate_by(gauge, local_q[right]))
        for left, right, gauge in overlaps
    )
    curvature_gluing = all(
        matrix_equal(local_f[left], conjugate_by(gauge, local_f[right]))
        for left, right, gauge in overlaps
    )
    differential_gluing = all(
        curved_differential_glues(local_q[left], local_q[right], gauge)
        for left, right, gauge in overlaps
    )

    projective_adjoint_triple = all(
        matrix_equal(
            conjugate_by(projective_triple, matrix_unit(row, column, 9)),
            matrix_unit(row, column, 9),
        )
        for row in range(9)
        for column in range(9)
    )

    q_is_odd = all(
        q0[row][column] == ZERO or coefficient_parity(row, column) == 1
        for row in range(9)
        for column in range(9)
    )
    q_self_adjoint = matrix_equal(q0, adjoint(q0))
    f0 = local_f[0]
    f_is_gram_positive = matrix_equal(f0, matmul(adjoint(q0), q0))
    test_direction = kronecker(matrix_unit(1, 2, 3), unit3)
    f_is_noncentral = nonzero(
        subtract(matmul(f0, test_direction), matmul(test_direction, f0))
    )
    q_is_not_overlap_invariant = not matrix_equal(
        q0, conjugate_by(g12, q0)
    )

    zero9 = scale(0, unit9)
    bianchi = all(
        matrix_equal(curved_differential(q, f, 0), zero9)
        for q, f in zip(local_q, local_f, strict=True)
    )
