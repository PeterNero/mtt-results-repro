def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def evaluate_coordinates(rows: np.ndarray, gamma: int, prime: int) -> np.ndarray:
    return sum(
        (rows[:, power].astype(np.int64) % prime) * pow(gamma, power, prime)
        for power in range(rows.shape[1])
    ) % prime


def derivative(
    vector: np.ndarray, degree: int, variable: int, prime: int
) -> np.ndarray:
    source = graded.homogeneous_exponents(degree)
    target = graded.homogeneous_exponents(degree - 1)
    lookup = {exponent: row for row, exponent in enumerate(target)}
    result = np.zeros(len(target), dtype=np.int64)
    for exponent, coefficient in zip(source, vector, strict=True):
        if exponent[variable] == 0:
            continue
        shifted = list(exponent)
        shifted[variable] -= 1
        result[lookup[tuple(shifted)]] = (
            result[lookup[tuple(shifted)]]
            + int(coefficient) * exponent[variable]
        ) % prime
    return result


def second_derivative_family(
    vector: np.ndarray, prime: int
) -> np.ndarray:
    second = np.stack(
        [
            derivative(
                derivative(vector, 9, first, prime), 8, second, prime
            )
            for first in range(3)
            for second in range(first, 3)
        ],
        axis=1,
    )
    return graded.multiply_space(second, 7, 8, prime)


def canonical_columns(matrix: np.ndarray, prime: int) -> np.ndarray:
    _, pivots, _ = graded.rref(matrix, prime)
    return matrix[:, pivots] % prime


def row_lift(space: np.ndarray) -> np.ndarray:
    result = np.zeros((180, 4 * space.shape[1]), dtype=np.int64)
    for row in range(4):
        result[
            row * 45 : (row + 1) * 45,
            row * space.shape[1] : (row + 1) * space.shape[1],
        ] = space
    return result


def canonical_mod_inherited(
    inherited: np.ndarray, candidate: np.ndarray, prime: int
) -> np.ndarray:
    rank, pivot_rows, _ = graded.rref(inherited.T, prime)
    require(rank == 64, "inherited rank")
    pivots = np.asarray(pivot_rows, dtype=np.int64)
    coefficients = (
        hilbert_burch.inverse_mod(inherited[pivots, :], prime)
        @ candidate[pivots]
        % prime
    )
    reduced = (candidate - inherited @ coefficients) % prime
    require(np.count_nonzero(reduced[pivots]) == 0, "quotient pivot zeros")
    support = np.flatnonzero(reduced)
    require(support.size > 0, "nonzero quotient class")
    return reduced * pow(int(reduced[int(support[0])]), -1, prime) % prime


def fiber_source(
    generators11: np.ndarray,
    syzygy_block: np.ndarray,
    d7: np.ndarray,
    b6: np.ndarray,
    forms9: tuple[np.ndarray, np.ndarray, np.ndarray],
    target_o8: np.ndarray,
    prime: int,
) -> tuple[np.ndarray, np.ndarray, tuple[int, ...], tuple[int, ...]]:
    linear_d7 = graded.multiply_space(d7[:, None], 7, 8, prime)
    quadratic_b6 = graded.multiply_space(b6[:, None], 6, 8, prime)
    gradient_a1 = np.stack(
        [derivative(forms9[1], 9, variable, prime) for variable in range(3)],
        axis=1,
    )
    gradient_a2 = np.stack(
        [derivative(forms9[2], 9, variable, prime) for variable in range(3)],
        axis=1,
    )
    first_order = canonical_columns(
        np.concatenate(
            (linear_d7, quadratic_b6, gradient_a1, gradient_a2), axis=1
        ),
        prime,
    )
    require(first_order.shape == (45, 15), "first-order source dimension")
    second_a0 = second_derivative_family(forms9[0], prime)
    second_order = canonical_columns(
        np.concatenate((first_order, second_a0), axis=1), prime
    )
    require(second_order.shape == (45, 33), "second-order source dimension")

    map19 = graded.multiply_space(generators11, 11, 19, prime)
    inherited = np.concatenate(
        (
            hilbert_burch.lift_syzygy(syzygy_block[:12], 1, 8, prime),
            hilbert_burch.lift_syzygy(syzygy_block[12:], 2, 8, prime),
        ),
        axis=1,
    )
    require(graded.rref(inherited, prime)[0] == 64, "inherited syzygies")

    first_lift = row_lift(first_order)
    _, _, first_nullspace = graded.rref(
        map19 @ first_lift % prime, prime, emit_nullspace=True
    )
    require(first_nullspace is not None, "first-order nullspace")
    first_solutions = first_lift @ first_nullspace % prime
    first_solution_rank = graded.rref(first_solutions, prime)[0]
    first_joint_rank = graded.rref(
        np.concatenate((inherited, first_solutions), axis=1), prime
    )[0]
    require((first_nullspace.shape[1], first_solution_rank, first_joint_rank) == (5, 5, 64), "first-order inherited only")

    second_lift = row_lift(second_order)
    _, _, second_nullspace = graded.rref(
        map19 @ second_lift % prime, prime, emit_nullspace=True
    )
    require(second_nullspace is not None, "second-order nullspace")
    second_solutions = second_lift @ second_nullspace % prime
    require(graded.rref(second_solutions, prime)[0] == 17, "second solution rank")
    second_joint_rank = graded.rref(
        np.concatenate((inherited, second_solutions), axis=1), prime
    )[0]
    require(
        (second_nullspace.shape[1], second_solutions.shape[1], second_joint_rank)
        == (17, 17, 65),
        "one new second-order quotient class",
    )
    new, _, combined_rank = graded.complement_columns(
        inherited, second_solutions, prime
    )
    require(new.shape == (180, 1) and combined_rank == 65, "new O8 class")
    canonical = canonical_mod_inherited(inherited, new[:, 0], prime)
    require(np.array_equal(canonical, target_o8 % prime), "canonical O8 replay")

    # Select the same new class in the upstream 132-coordinate source chart.
    intersection_system = np.concatenate((second_solutions, -inherited), axis=1)
    _, _, intersection_relations = graded.rref(
        intersection_system, prime, emit_nullspace=True
    )
    require(
        intersection_relations is not None
        and intersection_relations.shape == (81, 16),
        "16-dimensional inherited intersection",
    )
    intersection_coefficients = (
        second_nullspace @ intersection_relations[:17] % prime
    )
    require(
        graded.rref(intersection_coefficients, prime)[0] == 16,
        "source intersection rank",
    )
    source_new, _, source_combined_rank = graded.complement_columns(
        intersection_coefficients, second_nullspace, prime
    )
    require(
        source_new.shape == (132, 1) and source_combined_rank == 17,
        "one source quotient class",
    )
    intersection_rank, source_pivot_rows, _ = graded.rref(
        intersection_coefficients.T, prime
    )
    require(intersection_rank == 16, "source pivot chart")
    source_pivots = np.asarray(source_pivot_rows, dtype=np.int64)
    inherited_coordinates = (
        hilbert_burch.inverse_mod(
            intersection_coefficients[source_pivots, :], prime
        )
        @ source_new[source_pivots, 0]
        % prime
    )
    source_coefficient = (
        source_new[:, 0]
        - intersection_coefficients @ inherited_coordinates
    ) % prime
    require(
        np.count_nonzero(source_coefficient[source_pivots]) == 0,
        "source quotient pivot zeros",
    )
    source_support = np.flatnonzero(source_coefficient)
    require(source_support.size > 0, "nonzero source quotient")
    source_normalization = int(source_support[0])
    source_coefficient = (
        source_coefficient
        * pow(int(source_coefficient[source_normalization]), -1, prime)
        % prime
    )
    source_output = second_lift @ source_coefficient % prime
    require(np.count_nonzero(map19 @ source_output % prime) == 0, "source syzygy replay")
    require(
        np.array_equal(
            canonical_mod_inherited(inherited, source_output, prime),
            target_o8 % prime,
        ),
        "upstream source emits O8 quotient",
    )
    profile = (
        first_order.shape[1],
        first_nullspace.shape[1],
        first_joint_rank - 64,
        second_order.shape[1],
        second_nullspace.shape[1],
        second_joint_rank - 64,
    )
    source_profile = tuple(int(value) for value in source_pivot_rows) + (
        source_normalization,
    )
    return canonical, source_coefficient, profile, source_profile


