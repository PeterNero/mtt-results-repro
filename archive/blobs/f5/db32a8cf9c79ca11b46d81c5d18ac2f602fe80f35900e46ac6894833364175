        "upper_action_regulator_selection_row_remains_open": (
            not continuum_promotion_rows[
                "geometry_selected_q79_external_regulator_family"
            ]["accepted"]
        ),
        "the_other_seven_analytic_and_state_rows_remain_open": (
            sum(
                int(not row["accepted"])
                for key, row in continuum_promotion_rows.items()
                if key
                not in {
                    "formal_EG_tangent_identification",
                    "geometry_selected_q79_external_regulator_family",
