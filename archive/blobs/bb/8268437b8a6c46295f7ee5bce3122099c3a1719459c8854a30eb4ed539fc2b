#!/usr/bin/env python3
"""Target hard component-16 coordinates in a warm gamma-span lattice."""

from __future__ import annotations

import argparse
import gzip
import json
import statistics
import time
from pathlib import Path
from typing import Any

from build_ust_g3eb_h02_component12_two_level_cayley_lift import (
    coefficient_multiply,
)
from probe_ust_g3ec_component12_padic_kernel import invert_matrix_mod
from probe_ust_g3en_component16_six_embedding_lattice import (
    COLUMNS,
    FIELD_DEGREE,
    MATRIX,
    PRIME,
    RELATIONS,
    RESIDUE,
    VARIABLES,
    candidate_vectors,
    centered,
    exact_replay,
    independent_candidates,
    interpolate_vectors,
)
from ust_fplll_backend import reduce_fplll


ROOT = Path(__file__).resolve().parent
SOURCE = ROOT / "evidence/ust_g3en/H02.component16.six_embedding_lattice.json.gz"
OUTPUT = ROOT / "evidence/ust_g3eo/H02.component16.warm_span_target_lattice.json.gz"
GAMMA = (0, 1, 0, 0, 0, 0)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load_gzip(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    with gzip.open(path, "rt", encoding="utf-8") as handle:
        return json.load(handle)


def write_gzip_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    with gzip.open(temporary, "wt", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"))
        handle.write("\n")
    temporary.replace(path)


def multiply_by_gamma(vector: list[int]) -> list[int]:
    require(len(vector) == VARIABLES, "free coefficient length")
    result: list[int] = []
    for relation in range(RELATIONS):
        coefficient = tuple(
            vector[
                relation * FIELD_DEGREE : (relation + 1) * FIELD_DEGREE
            ]
        )
        result.extend(coefficient_multiply(coefficient, GAMMA))
    return result


def gamma_span(candidates: list[list[int]]) -> list[list[int]]:
    require(len(candidates) == RELATIONS, "warm candidate count")
    basis: list[list[int]] = []
    for source in candidates:
        current = list(source)
        for _ in range(FIELD_DEGREE):
            basis.append(current)
            current = multiply_by_gamma(current)
    require(len(basis) == VARIABLES, "gamma span dimension")
    return basis


def modular_rank(rows: list[list[int]]) -> int:
    matrix = [[int(value) % PRIME for value in row] for row in rows]
    rank = 0
    for column in range(len(matrix[0])):
        pivot = next(
            (index for index in range(rank, len(matrix)) if matrix[index][column]),
            None,
        )
        if pivot is None:
            continue
        matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
        inverse = pow(matrix[rank][column], -1, PRIME)
        matrix[rank] = [value * inverse % PRIME for value in matrix[rank]]
        for index in range(len(matrix)):
            if index == rank:
                continue
            factor = matrix[index][column]
            if factor:
                matrix[index] = [
                    (value - factor * pivot_value) % PRIME
                    for value, pivot_value in zip(
                        matrix[index], matrix[rank], strict=True
                    )
                ]
        rank += 1
        if rank == len(matrix):
            break
    return rank


def target_coupling(
    kernels: list[list[list[int]]],
    roots: list[int],
    inverse_vandermonde: list[list[int]],
    modulus: int,
    targets: list[int],
) -> list[list[int]]:
    output_count = FIELD_DEGREE * len(targets)
    root_powers = [
        [pow(root, degree, modulus) for degree in range(FIELD_DEGREE)]
        for root in roots
    ]
    coupling = [[0] * output_count for _ in range(VARIABLES)]
    for relation in range(RELATIONS):
        for degree in range(FIELD_DEGREE):
            variable = relation * FIELD_DEGREE + degree
            for target_index, coordinate in enumerate(targets):
                root_values = [
                    int(kernels[root][coordinate][relation])
                    * root_powers[root][degree]
                    % modulus
                    for root in range(FIELD_DEGREE)
                ]
                for output_degree in range(FIELD_DEGREE):
                    coupling[variable][
                        target_index * FIELD_DEGREE + output_degree
                    ] = sum(
                        inverse_vandermonde[output_degree][root]
                        * root_values[root]
                        for root in range(FIELD_DEGREE)
                    ) % modulus
    return coupling


def build_target_lattice(
    basis: list[list[int]], coupling: list[list[int]], modulus: int
) -> list[list[int]]:
    output_count = len(coupling[0])
    rows: list[list[int]] = []
    for vector in basis:
        output = [
            centered(
                sum(
                    vector[variable] * coupling[variable][column]
                    for variable in range(VARIABLES)
                ),
                modulus,
            )
            for column in range(output_count)
        ]
        rows.append(vector + output)
    rows.extend(
        [0] * VARIABLES
        + [modulus if column == row else 0 for column in range(output_count)]
        for row in range(output_count)
    )
    require(len(rows) == len(rows[0]), "square target lattice")
    return rows


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--rounds", type=int, default=1)
    parser.add_argument("--targets-per-round", type=int, default=3)
    parser.add_argument("--candidate-count", type=int, default=42)
    parser.add_argument("--threshold-bits", type=int, default=400)
    parser.add_argument("--resume", action="store_true")
    parser.add_argument(
        "--fplll-mode",
        choices=("wrapper", "fast", "heuristic", "proved"),
        default="fast",
    )
    parser.add_argument(
        "--fplll-float",
        choices=("mpfr", "dd", "qd", "dpe", "double", "longdouble"),
        default="longdouble",
    )
    parser.add_argument("--fplll-precision", type=int, default=256)
    arguments = parser.parse_args()
    require(arguments.candidate_count >= RELATIONS, "enough candidates")

    source = load_gzip(SOURCE)
    require(not source["exact_kernel_closed"], "source remains open")
    residue = load_gzip(RESIDUE)
    require(residue["shape"] == [FIELD_DEGREE, COLUMNS, RELATIONS], "residue shape")
    modulus = int(residue["modulus"])
    roots = [int(value) for value in residue["lifted_roots"]]
    kernels = residue["kernels"]
    inverse_vandermonde = invert_matrix_mod(
        [
            [pow(root, degree, modulus) for degree in range(FIELD_DEGREE)]
            for root in roots
        ],
        modulus,
    )
    free = set(int(value) for value in residue["free_columns"])
    available = [coordinate for coordinate in range(COLUMNS) if coordinate not in free]
    warm_candidates = [
        [int(value) for value in row]
        for row in source["selected_candidate_free_coefficients"]
    ]
    targets = sorted(
        int(item["coordinate"])
        for item in source["rounds"][-1]["worst_new_coordinates"][
            : arguments.targets_per_round
        ]
    )
    rounds: list[dict[str, Any]] = []
    if arguments.resume:
        previous = load_gzip(OUTPUT)
        require(not previous["exact_kernel_closed"], "resume only open target search")
        rounds = list(previous["rounds"])
        warm_candidates = [
            [int(value) for value in row]
            for row in previous["selected_candidate_free_coefficients"]
        ]
        targets = sorted(
            {int(value) for value in rounds[-1]["targets"]}
            | {
                int(item["coordinate"])
                for item in rounds[-1]["worst_new_coordinates"][
                    : arguments.targets_per_round
                ]
            }
        )

    exact_nonzeros = int(source["exact_replay_nonzero_slots"])
    exact_slots = int(source["exact_replay_slots"])
    for _ in range(arguments.rounds):
        started = time.monotonic()
        basis = gamma_span(warm_candidates)
        basis_rank = modular_rank(basis)
        require(basis_rank == VARIABLES, "full warm gamma span")
        coupling = target_coupling(
            kernels, roots, inverse_vandermonde, modulus, targets
        )
        lattice = build_target_lattice(basis, coupling, modulus)
        lll_started = time.monotonic()
        reduced = reduce_fplll(
            lattice,
            0.75,
            0.51,
            arguments.fplll_mode,
            arguments.fplll_float,
            True,
            False,
            arguments.fplll_precision,
        )
        lll_elapsed = time.monotonic() - lll_started
        candidates = candidate_vectors(reduced, arguments.candidate_count)
        vectors = interpolate_vectors(
            candidates, kernels, roots, inverse_vandermonde, modulus
        )
        selected = independent_candidates(candidates)
        require(len(selected) == RELATIONS, "21 independent candidates")
        selected_vectors = [vectors[index] for index in selected]
        exact_nonzeros, exact_slots = exact_replay(selected_vectors)
        all_bits: list[int] = []
        scores: list[tuple[int, int, int]] = []
        for coordinate in available:
            bits = [
                abs(value).bit_length()
                for vector in vectors
                for value in vector[coordinate]
            ]
            all_bits.extend(bits)
            scores.append(
                (
                    sum(value > arguments.threshold_bits for value in bits),
                    max(bits),
                    coordinate,
                )
            )
        worst = sorted(
            (score for score in scores if score[2] not in targets), reverse=True
        )[: arguments.targets_per_round]
        row = {
            "round": len(rounds),
            "targets": list(targets),
            "lattice_dimension": len(lattice),
            "warm_gamma_span_rank_mod21817": basis_rank,
            "candidate_count": len(candidates),
            "selected_independent_candidates": selected,
            "coefficient_bit_median": statistics.median(all_bits),
            "coefficient_bit_max": max(all_bits),
            "coefficients_over_threshold": sum(
                value > arguments.threshold_bits for value in all_bits
            ),
            "exact_replay_nonzero_slots": exact_nonzeros,
            "exact_replay_slots": exact_slots,
            "worst_new_coordinates": [
                {
                    "coordinate": coordinate,
                    "over_threshold": count,
                    "max_bits": maximum,
                }
                for count, maximum, coordinate in worst
            ],
            "lll_elapsed_seconds": lll_elapsed,
            "elapsed_seconds": time.monotonic() - started,
        }
        rounds.append(row)
        warm_candidates = [candidates[index] for index in selected]
        payload = {
            "schema": "ust.g3eo.h02.component16.warm-span-target-lattice.v1",
            "date": "2026-08-14",
            "source_search": SOURCE.relative_to(ROOT).as_posix(),
            "source_residue": RESIDUE.relative_to(ROOT).as_posix(),
            "matrix": MATRIX.relative_to(ROOT).as_posix(),
            "rounds": rounds,
            "selected_candidate_free_coefficients": warm_candidates,
            "exact_replay_nonzero_slots": exact_nonzeros,
            "exact_replay_slots": exact_slots,
            "exact_kernel_closed": exact_nonzeros == 0,
            "claim_boundary": (
                "Only literal zero replay of 21 independent Q(gamma) vectors "
                "promotes component16."
            ),
        }
        write_gzip_atomic(OUTPUT, payload)
        print(
            f"G3EO round={row['round']} targets={len(targets)} "
            f"lattice={len(lattice)} lll={lll_elapsed:.3f}s "
            f"median_bits={row['coefficient_bit_median']} "
            f"over={row['coefficients_over_threshold']} "
            f"exact_nonzeros={exact_nonzeros} "
            f"worst={[item[2] for item in worst]} "
            f"elapsed={row['elapsed_seconds']:.3f}s",
            flush=True,
        )
        if exact_nonzeros == 0:
            break
        targets = sorted(set(targets) | {item[2] for item in worst})

    print(
        f"G3EO_FINAL exact_kernel_closed={exact_nonzeros == 0} "
        f"exact_nonzeros={exact_nonzeros} output={OUTPUT.relative_to(ROOT).as_posix()}",
        flush=True,
    )


if __name__ == "__main__":
    main()
