def render_note(candidate: dict[str, object], certificate: dict[str, object]) -> str:
    interfaces = []
    for name, body in candidate["recovery_interfaces"].items():
        maps = "; ".join(body["required_maps"])
        interfaces.append(
            f"- `{name}`: required maps: {maps}. Parity: {body['parity_acceptance']} "
            f"Forbidden: {body['forbidden_shortcut']} No-knob target: {body['no_knob_target']}."
        )
    rules = "\n".join(f"- {rule}" for rule in candidate["recovery_rules"])
    checks = "\n".join(
        f"- `{name}`: {text}" for name, text in candidate["cross_sector_consistency_checks"].items()
    )
    forbidden = "\n".join(f"- {item}" for item in candidate["forbidden_shortcuts"])
    tests = "\n".join(f"- {item}" for item in candidate["acceptance_tests"])
    closes = "\n".join(f"- {name}" for name, value in certificate["what_closes"].items() if value)
    open_items = "\n".join(f"- {name}" for name, value in certificate["what_remains_open"].items() if value)
    return f"""# MTT QM/QFT/GR Recovery Interface v1

## Purpose

This artifact defines the recovery boundary for QM, local QFT, GR, and unit
anchors at the SM-parity standard.

It does not derive Born weights, QFT locality, Einstein dynamics, or physical
absolute normalization.  It declares the interfaces MTT must expose before
empirical equivalence can be audited.

## Recovery Interfaces

{chr(10).join(interfaces)}

## Recovery Rules

{rules}

## Cross-Sector Consistency

{checks}

## Forbidden Shortcuts

{forbidden}

## Acceptance Tests

{tests}

## Interface Theorem

MTT reaches the recovery-interface stage of SM-parity when it declares QM,
QFT, GR, and unit-anchor maps with explicit carriers, observables, parameter
slots, and conventions, and when all measured values are downstream of those
maps.

This permits comparison with accepted QM/QFT/GR practice at parity standard,
while preserving the no-knob targets as open derivation obligations.

## What This Closes

{closes}

## What Remains Open

{open_items}

## Next Artifact

```text
{candidate["next_required_artifact"]}
```
"""


def main() -> None:
    candidate = build_candidate()
    certificate = build_certificate(candidate)
    data_text = json.dumps(candidate, indent=2, sort_keys=True)
    cert_text = json.dumps(certificate, indent=2, sort_keys=True)
    note_text = render_note(candidate, certificate)
    if "--write" in sys.argv:
        OUTPUT_DATA.write_text(data_text + "\n", encoding="utf-8")
        OUTPUT_CERT.write_text(cert_text + "\n", encoding="utf-8")
        OUTPUT_NOTE.write_text(note_text, encoding="utf-8")
    print(cert_text)


if __name__ == "__main__":
    main()
