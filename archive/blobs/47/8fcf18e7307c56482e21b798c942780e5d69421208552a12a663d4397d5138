#!/usr/bin/env python3
"""Independently verify the one-root G3BS H02 endpoint action."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

import numpy as np

import build_ust_g3bs_h02_endpoint_action_root5 as builder
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3bs_h02_endpoint_action_root5.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any], repository: Path = ROOT) -> Path:
    relative = record.get("path", record.get("repository_relative_path"))
    require(isinstance(relative, str), "record path")
    candidate = Path(relative)
    path = candidate if candidate.is_absolute() else repository / candidate
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="utf-8"))
    require(packet["schema"] == "mtt.unified-source.g3bs-h02-endpoint-action-root5.v1", "schema")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import export_q79_eta9_split_prime_selected_chart as exporter

    inputs = packet["inputs"]
    local_paths = {key: verify_record(inputs[key]) for key in ("G3BI", "G3BK", "G3BR")}
    for key in ("B103", "H02_Macaulay", "H02_factorization", "split_prime_solver"):
        verify_record(inputs[key], mld)
    g3bi = json.loads(local_paths["G3BI"].read_text(encoding="utf-8"))
    g3bk = json.loads(local_paths["G3BK"].read_text(encoding="utf-8"))
    g3br = json.loads(local_paths["G3BR"].read_text(encoding="utf-8"))
    b103 = json.loads(verify_record(inputs["B103"], mld).read_text(encoding="utf-8"))
    macaulay = json.loads(verify_record(inputs["H02_Macaulay"], mld).read_text(encoding="utf-8"))
    expected_rhs, digest = builder.exact_source_matrix(g3bi, b103, macaulay, exporter)
    require(
        digest
        == g3bk["characteristic_zero_derivative_sources"]["H11_to_H02"][
            "canonical_exact_source_sha256"
        ],
        "G3BK source digest",
    )

    action = packet["operator_action"]
    chart_path = verify_record(g3br["endpoint_chart"]["binary"])
    rhs_path = verify_record(action["RHS"])
    solution_path = verify_record(action["solution"])
    log_path = verify_record(action["solver_log"])
    chart = split_io.as_scipy(arithmetic.read_csc(chart_path, b"MTTSPC1\0", 6))
    rhs = split_io.as_scipy(arithmetic.read_csc(rhs_path, b"MTTSRH1\0", 4))
    solution = split_io.as_scipy(arithmetic.read_csc(solution_path, b"MTTSCO1\0", 6))
    require((rhs != expected_rhs).nnz == 0, "exact RHS replay")
    require(chart.shape == (42706, 42706), "chart shape")
    require(solution.shape == (42706, 1013), "solution shape")
    residual = split_io.residual_nonzeros(chart, solution, rhs, 21817)
    require(residual == int(action["residual_nonzeros"]) == 0, "zero residual")
    require(solution.nnz == int(action["solution_nonzero_entries"]), "solution nnz")
    require(solution[:248, :].nnz == int(action["quotient_nonzero_entries"]), "quotient nnz")
    require(solution[248:, :].nnz == int(action["preimage_nonzero_entries"]), "preimage nnz")
    fields = {}
    for line in log_path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition(" ")
        if separator:
            fields[key] = value.strip()
    require(fields.get("STATUS") == "SUCCESS", "solver status")
    require(int(fields["CHART_DETERMINANT"]) == int(action["endpoint_determinant_mod21817"]) == 419, "determinant")
    print("UST.G3BS H02 endpoint action root5 verifier: PASS")
    print(
        f"rhs_nnz={rhs.nnz} solution_nnz={solution.nnz} "
        f"quotient_nnz={solution[:248, :].nnz} residual={residual}"
    )


if __name__ == "__main__":
    main()
