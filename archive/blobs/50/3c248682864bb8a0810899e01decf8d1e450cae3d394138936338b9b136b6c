#!/usr/bin/env python3
"""Build the G3BJ explicit discriminant-avoiding transport-path packet."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
G3BI = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
G3BH = ROOT / "state" / "ust_g3bh_fixed_b89_root_containment_nogo.packet.json"
OUT = ROOT / "state" / "ust_g3bj_transcendental_arc_path.packet.json"

EXPECTED_HASHES = {
    "G3BI": "f828986fbf8a4172d58476eade557df0a0724735efcc4b1786836eced3b6bbc9",
    "G3BH": "e79d322eb3e8699944d8a827f21b11318d4a1b09b13ba224679fa841446cd8e9",
}


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def sub(left: list[int], right: list[int]) -> list[int]:
    return [a - b for a, b in zip(left, right)]


def add(left: list[int], right: list[int]) -> list[int]:
    return [a + b for a, b in zip(left, right)]


def main() -> None:
    for name, path in (("G3BI", G3BI), ("G3BH", G3BH)):
        require(sha256(path) == EXPECTED_HASHES[name], f"{name} hash")
    g3bi = load(G3BI)
    require(all(g3bi["checks"].values()), "G3BI checks")
    require(not any(g3bi["guardrails"].values()), "G3BI guardrails")
    start = g3bi["selected_source"]["coefficient_vectors"]
    endpoint = g3bi["smooth_endpoint"]["coefficient_vectors"]
    require(len(start) == len(endpoint) == 249, "coefficient dimensions")
    correction = [sub(left, right) for left, right in zip(start, endpoint)]
    require(any(any(row) for row in correction), "nonconstant correction pencil")
    require(
        [add(endpoint[index], correction[index]) for index in range(249)] == start,
        "pencil endpoint replay",
    )
    require(
        g3bi["selected_source"]["number_field"] == "Q(gamma)"
        and g3bi["smooth_endpoint"]["characteristic_zero_endpoint_is_smooth"],
        "algebraic smooth endpoints",
    )

    packet = {
        "schema": "mtt.unified-source.g3bj-transcendental-arc-path.v1",
        "date": "2026-08-12",
