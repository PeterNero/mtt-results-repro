                "continuum_reduced_product"
            ]
            == "1/9"
        ),
        "finite_BV_regulator_criterion_passes": (
            finite_bv["all_checks_pass"]
        ),
        "finite_BV_regulator_has_exact_nilpotent_differential": (
            finite_bv["blocker_assessment"][
                "B.QFT.02_finite_BV_regulator_criterion"
            ]
            == "closed_exact"
        ),
        "formal_local_QME_certificate_passes": (
            formal_qme["all_checks_pass"]
        ),
        "formal_local_gauge_anomaly_class_is_zero": (
            formal_qme["local_QME_anomaly"]["class_vector"]
            == [0, 0, 0, 0, 0]
        ),
        "Luscher_nonperturbative_abelian_boundary_is_registered": (
            "Luscher nonperturbative abelian chiral lattice measure"
            in external_names
        ),
        "Luscher_general_nonabelian_perturbative_boundary_is_registered": (
            "Luscher anomaly-free chiral lattice regularization"
            in external_names
        ),
    }

    # The charge generator and its Z2 exponential have the same fixed
    # algebra in this exact witness. This is the smallest rational model of
    # the general compact connected-gauge statement used below.
    field_dimension = 4
    charge_values = [
        Fraction(0),
        Fraction(0),
        Fraction(1),
        Fraction(1),
    ]
    charge_generator = diagonal(charge_values)
    gauge_unitary = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(-1),
            Fraction(-1),
        ]
    )
    gauss_projector = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(0),
            Fraction(0),
        ]
    )

    def commutator(
        left: list[list[Fraction]],
        right: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return sub(mul(left, right), mul(right, left))

    def anticommutator(
        left: list[list[Fraction]],
        right: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return add(mul(left, right), mul(right, left))

    def gauge_conjugate(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return mul(
            mul(gauge_unitary, observable),
            transpose(gauge_unitary),
        )

    def haar_reynolds(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return scale(
            Fraction(1, 2),
            add(observable, gauge_conjugate(observable)),
        )

    matrix_units = []
    for row in range(field_dimension):
        for column in range(field_dimension):
            unit = zeros(field_dimension, field_dimension)
            unit[row][column] = Fraction(1)
            matrix_units.append(unit)
    fixed_matrix_units = [
        unit
        for unit in matrix_units
        if gauge_conjugate(unit) == unit
    ]

    ghost_dimension = 2
    ghost_creation = [
        [Fraction(0), Fraction(1)],
        [Fraction(0), Fraction(0)],
    ]
    brst_charge = kronecker(
        charge_generator,
        ghost_creation,
    )
    extended_zero = zeros(
        field_dimension * ghost_dimension,
        field_dimension * ghost_dimension,
    )

    def embed_even(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return kronecker(observable, eye(ghost_dimension))

    def brst_on_even(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return commutator(brst_charge, embed_even(observable))

    def brst_on_odd(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return anticommutator(brst_charge, observable)

    interaction_hamiltonian = zeros(
        field_dimension,
        field_dimension,
    )
    interaction_hamiltonian[0][1] = Fraction(1)
    interaction_hamiltonian[1][0] = Fraction(1)
    interaction_hamiltonian[2][3] = Fraction(2)
    interaction_hamiltonian[3][2] = Fraction(2)
    free_hamiltonian = diagonal(
        [
            Fraction(0),
            Fraction(1),
            Fraction(2),
            Fraction(3),
        ]
    )
    witness_coupling = Fraction(1, 3)
    fixed_coupling_hamiltonian = add(
        free_hamiltonian,
        scale(witness_coupling, interaction_hamiltonian),
    )

    rotation_two = [
        [Fraction(3, 5), Fraction(-4, 5)],
        [Fraction(4, 5), Fraction(3, 5)],
    ]
    zero_two = zeros(2, 2)
    dynamical_unitary = [
        *[
            rotation_two[row] + zero_two[row]
            for row in range(2)
        ],
        *[
            zero_two[row] + rotation_two[row]
            for row in range(2)
        ],
    ]
    extended_dynamical_unitary = kronecker(
        dynamical_unitary,
        eye(ghost_dimension),
    )

    def evolve(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return mul(
            mul(dynamical_unitary, observable),
            transpose(dynamical_unitary),
        )

    def matrix_trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum(
            (
                matrix[index][index]
                for index in range(len(matrix))
            ),
            Fraction(0),
        )

    invariant_density = scale(
        Fraction(1, field_dimension),
        eye(field_dimension),
    )
    off_sector_probe = zeros(field_dimension, field_dimension)
    off_sector_probe[0][2] = Fraction(1)
    physical_probe = zeros(field_dimension, field_dimension)
    physical_probe[0][0] = Fraction(1)
    physical_probe[0][1] = Fraction(1, 2)
    physical_probe[1][0] = Fraction(1, 2)
    physical_probe[1][1] = Fraction(1)

    algebraic_defect_checks = {
        "ghost_generator_is_nonzero_and_nilpotent": (
            ghost_creation != zeros(ghost_dimension, ghost_dimension)
            and mul(ghost_creation, ghost_creation)
            == zeros(ghost_dimension, ghost_dimension)
        ),
        "BRST_charge_is_nonzero_and_nilpotent": (
            brst_charge != extended_zero
            and mul(brst_charge, brst_charge) == extended_zero
        ),
        "Haar_fixed_units_equal_charge_commutant_units": all(
            (gauge_conjugate(unit) == unit)
            == (
                commutator(charge_generator, unit)
                == zeros(field_dimension, field_dimension)
            )
            for unit in matrix_units
        ),
        "Haar_projection_has_exact_zero_Gauss_defect": all(
            commutator(
                charge_generator,
                haar_reynolds(unit),
            )
            == zeros(field_dimension, field_dimension)
            for unit in matrix_units
        ),
        "every_fixed_observable_has_exact_zero_BRST_defect": all(
            brst_on_even(unit) == extended_zero
            for unit in fixed_matrix_units
        ),
        "every_Haar_projected_observable_has_exact_zero_BRST_defect": all(
            brst_on_even(haar_reynolds(unit)) == extended_zero
            for unit in matrix_units
        ),
        "graded_BRST_differential_squares_to_zero_on_even_units": all(
            brst_on_odd(brst_on_even(unit)) == extended_zero
            for unit in matrix_units
        ),
        "BRST_differential_obeys_the_even_Leibniz_rule": all(
            brst_on_even(mul(left, right))
            == add(
                mul(brst_on_even(left), embed_even(right)),
                mul(embed_even(left), brst_on_even(right)),
            )
            for left in matrix_units
            for right in matrix_units
        ),
        "off_sector_probe_has_nonzero_Gauss_defect": (
            commutator(charge_generator, off_sector_probe)
            != zeros(field_dimension, field_dimension)
        ),
        "off_sector_probe_has_nonzero_BRST_defect": (
            brst_on_even(off_sector_probe) != extended_zero
        ),
        "Gauss_projector_is_the_zero_charge_projector": (
            mul(charge_generator, gauss_projector)
            == zeros(field_dimension, field_dimension)
            and mul(gauss_projector, charge_generator)
            == zeros(field_dimension, field_dimension)
        ),
        "physical_probe_is_nonzero_Gauss_neutral_and_BRST_closed": (
            physical_probe
            != zeros(field_dimension, field_dimension)
            and mul(
                mul(gauss_projector, physical_probe),
                gauss_projector,
            )
            == physical_probe
            and commutator(charge_generator, physical_probe)
            == zeros(field_dimension, field_dimension)
            and brst_on_even(physical_probe) == extended_zero
        ),
        "invariant_state_has_exact_zero_infinitesimal_Ward_functional": all(
            matrix_trace(
                mul(
                    invariant_density,
                    commutator(charge_generator, unit),
                )
            )
            == 0
            for unit in matrix_units
        ),
    }

    dynamics_checks = {
        "fixed_coupling_Hamiltonian_commutes_with_the_Gauss_generator": (
            commutator(
                charge_generator,
                fixed_coupling_hamiltonian,
            )
            == zeros(field_dimension, field_dimension)
        ),
        "exact_dynamical_step_commutes_with_the_Gauss_generator": (
            commutator(charge_generator, dynamical_unitary)
            == zeros(field_dimension, field_dimension)
        ),
        "extended_dynamical_step_commutes_with_the_BRST_charge": (
            commutator(
                brst_charge,
                extended_dynamical_unitary,
            )
            == extended_zero
        ),
        "dynamics_preserves_exact_Gauss_closure": all(
            commutator(charge_generator, evolve(unit))
            == zeros(field_dimension, field_dimension)
            for unit in fixed_matrix_units
        ),
        "dynamics_preserves_exact_BRST_closure": all(
            brst_on_even(evolve(unit)) == extended_zero
            for unit in fixed_matrix_units
        ),
        "Haar_projection_and_dynamics_commute_on_all_matrix_units": all(
            evolve(haar_reynolds(unit))
            == haar_reynolds(evolve(unit))
            for unit in matrix_units
