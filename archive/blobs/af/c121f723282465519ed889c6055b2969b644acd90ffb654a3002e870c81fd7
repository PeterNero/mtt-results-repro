P = 101
Element = g3ad.Element
Polynomial = dict[tuple[int, int, int], Element]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_hash(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def add_term(
    polynomial: Polynomial,
    exponent: tuple[int, int, int],
    coefficient: Element,
    ring: g3ad.QuotientRing,
) -> None:
    value = ring.add(polynomial.get(exponent, ring.zero), coefficient)
    if value == ring.zero:
        polynomial.pop(exponent, None)
    else:
        polynomial[exponent] = value


def multiply(
    left: Polynomial, right: Polynomial, ring: g3ad.QuotientRing
) -> Polynomial:
    result: Polynomial = {}
    for left_exponent, left_coefficient in left.items():
        for right_exponent, right_coefficient in right.items():
            exponent = tuple(a + b for a, b in zip(left_exponent, right_exponent))
            add_term(
                result,
                exponent,  # type: ignore[arg-type]
                ring.mul(left_coefficient, right_coefficient),
                ring,
            )
    return result


def homogeneous_monomials(degree: int) -> list[tuple[int, int, int]]:
    return [
        (x_power, y_power, degree - x_power - y_power)
        for x_power in range(degree, -1, -1)
        for y_power in range(degree - x_power, -1, -1)
    ]


def rref(
    matrix: list[list[Element]], ring: g3ad.QuotientRing
) -> tuple[list[list[Element]], list[int]]:
    work = [list(row) for row in matrix]
    row_count = len(work)
    column_count = len(work[0]) if work else 0
    require(all(len(row) == column_count for row in work), "rectangular matrix")
    pivots: list[int] = []
    pivot_row = 0
    for column in range(column_count):
        selected = next(
            (row for row in range(pivot_row, row_count) if work[row][column] != ring.zero),
            None,
        )
        if selected is None:
            continue
        work[pivot_row], work[selected] = work[selected], work[pivot_row]
        inverse = ring.inverse_field(work[pivot_row][column])
        work[pivot_row] = [ring.mul(value, inverse) for value in work[pivot_row]]
        for row in range(row_count):
            if row == pivot_row or work[row][column] == ring.zero:
                continue
            factor = work[row][column]
            work[row] = [
                ring.sub(value, ring.mul(factor, pivot_value))
                for value, pivot_value in zip(work[row], work[pivot_row])
            ]
        pivots.append(column)
        pivot_row += 1
        if pivot_row == row_count:
            break
    return work, pivots


def matrix_vector(
    matrix: list[list[Element]], vector: list[Element], ring: g3ad.QuotientRing
) -> list[Element]:
    result: list[Element] = []
    for row in matrix:
        value = ring.zero
        for entry, coordinate in zip(row, vector):
            value = ring.add(value, ring.mul(entry, coordinate))
        result.append(value)
    return result


def canonical_kernel_basis(
    reduced: list[list[Element]], pivots: list[int], ring: g3ad.QuotientRing
) -> tuple[list[int], list[list[Element]]]:
    column_count = len(reduced[0])
    free = [column for column in range(column_count) if column not in set(pivots)]
    basis: list[list[Element]] = []
    for free_column in free:
        vector = [ring.zero] * column_count
        vector[free_column] = ring.one
        for row, pivot_column in enumerate(pivots):
            vector[pivot_column] = ring.neg(reduced[row][free_column])
        basis.append(vector)
    return free, basis


def coefficient_vector(
    g3ad_packet: dict, basis: list[dict[str, object]], ring: g3ad.QuotientRing
) -> list[Element]:
    by_key = {
        (
            int(row["target_coordinate"]),
            str(row["basis_kind"]),
            tuple(int(value) for value in row["powers_xyz"]),
        ): ring.element(row["gamma_coefficients_ascending"])
        for row in g3ad_packet["fixed_FQ"]["nonzero_gamma_rows"]
    }
    return [
        by_key.get(
            (
                int(row["target_coordinate"]),
                str(row["basis_kind"]),
                tuple(int(value) for value in row["powers_xyz"]),
            ),
            ring.zero,
        )
        for row in basis
    ]


def graph_union(
    g3ad_packet: dict, g3af_packet: dict, ring: g3ad.QuotientRing
) -> tuple[Polynomial, dict[str, object]]:
    first_source = g3af_packet["selected_first_H_graph"]["source_coordinates_mod1012"]
    first_r = ring.constant(int(first_source["r"]) % P)
    first_w = ring.constant(int(first_source["w"]) % P)
    second = g3ae.graph_data(g3ad_packet, ring)["source"]
    first_line: Polynomial = {
        (0, 0, 1): ring.one,
        (1, 0, 0): ring.neg(first_r),
        (0, 1, 0): ring.neg(first_w),
    }
    second_line: Polynomial = {
        (0, 0, 1): ring.one,
        (1, 0, 0): ring.neg(second["r"]),
        (0, 1, 0): ring.neg(second["w"]),
    }
    quartic: Polynomial = {
        (4, 0, 0): ring.constant(8),
        (2, 1, 1): ring.constant(8),
        (1, 3, 0): ring.constant(8),
        (1, 0, 3): ring.constant(-3),
        (0, 2, 2): ring.constant(8),
    }
    union = multiply(multiply(first_line, second_line, ring), quartic, ring)
    require(union and all(sum(exponent) == 6 for exponent in union), "degree-six union")
    source = {
        "first_H_line": "z-r1*x-w1*y",
        "first_H_r_gamma_coordinates": list(first_r),
        "first_H_w_gamma_coordinates": list(first_w),
        "second_H_line": "z-r2*x-w2*y",
        "second_H_r_gamma_coordinates": list(second["r"]),
        "second_H_w_gamma_coordinates": list(second["w"]),
        "four_H_quartic": "8*x^4+8*x^2*y*z+8*x*y^3-3*x*z^3+8*y^2*z^2",
        "union_terms": [
            {"powers_xyz": list(exponent), "gamma_coefficients": list(union[exponent])}
            for exponent in sorted(union)
        ],
    }
    return union, source


def principal_slice(
    union: Polynomial,
    coefficient_basis: list[dict[str, object]],
    ring: g3ad.QuotientRing,
) -> tuple[list[list[Element]], list[dict[str, object]]]:
    lookup = {
        (
            int(row["target_coordinate"]),
            str(row["basis_kind"]),
            tuple(int(value) for value in row["powers_xyz"]),
        ): index
        for index, row in enumerate(coefficient_basis)
    }
    columns: list[list[Element]] = []
    labels: list[dict[str, object]] = []
    degree_three = homogeneous_monomials(3)
    require(len(degree_three) == 10, "ten degree-three monomials")
    for target_coordinate in range(3):
        for monomial in degree_three:
            vector = [ring.zero] * len(coefficient_basis)
            for exponent, coefficient in union.items():
                output = tuple(a + b for a, b in zip(exponent, monomial))
                index = lookup[(target_coordinate, "base_degree9", output)]
                vector[index] = coefficient
            columns.append(vector)
            labels.append(
                {
                    "target_coordinate": target_coordinate,
                    "kind": "s_union_times_degree3",
                    "powers_xyz": list(monomial),
                }
            )
        vector = [ring.zero] * len(coefficient_basis)
        for exponent, coefficient in union.items():
            index = lookup[(target_coordinate, "K3_sheet_times_degree6", exponent)]
            vector[index] = coefficient
        columns.append(vector)
        labels.append(
            {
                "target_coordinate": target_coordinate,
                "kind": "s_union_times_K3_sheet",
                "powers_xyz": [0, 0, 0],
            }
        )
    require(len(columns) == 33, "principal slice has 33 columns")
    return columns, labels


def transpose(columns: list[list[Element]]) -> list[list[Element]]:
    return [list(row) for row in zip(*columns)]


def main() -> None:
    packets = {path.stem: load(path) for path in (G3AD, G3AF, G3AG, G3AH, G3AI, G3AJ)}
    g3ad_packet = packets[G3AD.stem]
    g3af_packet = packets[G3AF.stem]
    g3ag_packet = packets[G3AG.stem]
    g3ah_packet = packets[G3AH.stem]
    g3ai_packet = packets[G3AI.stem]
    g3aj_packet = packets[G3AJ.stem]
    require(g3ag_packet["theorem_id"] == "UST.G3AG", "G3AG input")
    require(g3ah_packet["theorem_id"] == "UST.G3AH", "G3AH input")
    require(g3ai_packet["theorem_id"] == "UST.G3AI", "G3AI input")
    require(g3aj_packet["theorem_id"] == "UST.G3AJ", "G3AJ input")

    relation = g3ad_packet["completion_ring"]["gamma_relation_coefficients_ascending"]
    ring = g3ad.QuotientRing(P, relation)
    mu = ring.element(g3ad_packet["completion_ring"]["mu_residue_gamma_coordinates"])
    basis = g3ae.coefficient_basis()
    first = g3af.first_graph_data(g3af_packet["selected_first_H_graph"], ring)
    second = g3ae.graph_data(g3ad_packet, ring)
    four_targets = g3ag.target_forms(ring, 28, mu)
    incidence = (
        g3af.matrix_for_graph(basis, first, ring)
        + g3af.matrix_for_graph(basis, second, ring)
        + g3ag.four_h_matrix(basis, four_targets, ring)
    )
    serialized_incidence = [[list(value) for value in row] for row in incidence]
    matrix_bytes = bytes(
        coordinate
        for row in serialized_incidence
        for element in row
        for coordinate in element
    )
    require(len(matrix_bytes) == 168 * 249 * 6, "incidence matrix byte count")
    MATRIX_OUT.write_bytes(matrix_bytes)
    system = g3ag_packet["simultaneous_linear_system"]
    require(system["shape"] == [168, 249], "incidence shape")
    require(canonical_hash(serialized_incidence) == system["stacked_matrix_sha256"], "G3AG matrix hash")

    reduced, pivots = rref(incidence, ring)
    require(len(pivots) == 126, "incidence rank 126")
    free_columns, kernel_basis = canonical_kernel_basis(reduced, pivots, ring)
    require(len(free_columns) == len(kernel_basis) == 123, "kernel rank 123")
    require(
        all(all(value == ring.zero for value in matrix_vector(incidence, vector, ring)) for vector in kernel_basis),
        "canonical kernel basis",
    )

    selected_member = coefficient_vector(g3ad_packet, basis, ring)
    require(all(value == ring.zero for value in matrix_vector(incidence, selected_member, ring)), "selected member in kernel")
    union, union_source = graph_union(g3ad_packet, g3af_packet, ring)
    principal_columns, principal_labels = principal_slice(union, basis, ring)
    require(
        all(all(value == ring.zero for value in matrix_vector(incidence, vector, ring)) for vector in principal_columns),
        "principal slice lies in full kernel",
    )

    free_coordinate_columns = [
        [vector[index] for index in free_columns]
        for vector in [selected_member] + principal_columns
    ]
    coordinate_rows = transpose(free_coordinate_columns)
    _, base_pivots = rref(transpose(coordinate_rows), ring)
    require(len(base_pivots) == 34, "radial plus principal slice rank 34")
    extra_free_positions = [index for index in range(123) if index not in set(base_pivots)]
    require(len(extra_free_positions) == 89, "89 omitted graph-preserving directions")
    extra_vectors = [kernel_basis[index] for index in extra_free_positions]
    projective_tangent_columns = principal_columns + extra_vectors
    kernel_frame = [selected_member] + projective_tangent_columns
    _, kernel_frame_pivots = rref(transpose(kernel_frame), ring)
    require(len(kernel_frame_pivots) == 123, "full kernel frame")
    require(len(projective_tangent_columns) == 122, "projective tangent rank")

    complement_columns = []
    for column in pivots:
        vector = [ring.zero] * 249
        vector[column] = ring.one
        complement_columns.append(vector)
    full_frame = kernel_frame + complement_columns
    _, full_frame_pivots = rref(transpose(full_frame), ring)
    require(len(full_frame_pivots) == 249, "kernel plus incidence complement spans source")

    old_slice_quotient = 248 - 33
    omitted_tangent = 122 - 33
    true_normal = 248 - 122
    require((old_slice_quotient, omitted_tangent, true_normal) == (215, 89, 126), "dimension decomposition")
    require(old_slice_quotient == omitted_tangent + true_normal, "215=89+126")

    packet = {
        "schema": "mtt.unified-source.g3ak-full-graph-incidence-normal-decomposition.v1",
