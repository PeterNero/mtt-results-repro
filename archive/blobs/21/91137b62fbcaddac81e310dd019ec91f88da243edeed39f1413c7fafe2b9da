#!/usr/bin/env python3
"""Verify UST.G3AB eta9 theta incidence and two-twist claims."""

from __future__ import annotations

import hashlib
import json
from itertools import product
from pathlib import Path

import sympy as sp


ROOT = Path(__file__).resolve().parent
PACKET_PATH = ROOT / "state" / "ust_g3ab_eta9_theta_incidence_two_twist.packet.json"
LOCK_PATH = ROOT / "state" / "upstream-lock.json"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def load(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def add(g: tuple[int, int], h: tuple[int, int]) -> tuple[int, int]:
    return ((g[0] + h[0]) % 3, (g[1] + h[1]) % 3)


def sigma_exponent(g: tuple[int, int], h: tuple[int, int]) -> int:
    return (-h[0] * g[1]) % 3


def matrix_is_zero(matrix: sp.Matrix) -> bool:
    return all(sp.simplify(value) == 0 for value in matrix)


def verify_upstream_input(lock: dict, source: dict) -> None:
    repository = next(
        item for item in lock["repositories"] if item["id"] == source["repository_id"]
    )
    if "commit" in source:
        require(repository["commit"] == source["commit"], f"stale commit for {source['path']}")
    locked = next(item for item in repository["sources"] if item["path"] == source["path"])
    for field in ("sha256", "git_blob", "git_blob_sha256"):
        if field in source:
            require(locked.get(field) == source[field], f"stale {field} for {source['path']}")


def main() -> None:
    packet = load(PACKET_PATH)
    lock = load(LOCK_PATH)
    require(packet["theorem_id"] == "UST.G3AB", "theorem id")

    local_source = packet["inputs"]["local_G3AA_packet"]
    local_path = ROOT / local_source["path"]
    require(local_path.is_file(), "missing G3AA source")
    require(sha256(local_path) == local_source["sha256"], "stale G3AA source")
    g3aa = load(local_path)
    require(g3aa["theta_multiplier"]["orientation"] == "m=1", "G3AA orientation")
    require(
        g3aa["product_cohomology"]["new_mixed_cocycle_choices"] == 0,
        "G3AA mixed-class lock",
    )
    for key, source in packet["inputs"].items():
        if key != "local_G3AA_packet":
            verify_upstream_input(lock, source)

    linear = packet["eta9_linear_system"]
    require(linear["H_square"] == 2, "K3 polarization")
    require(2 + (9 * 9 * 2) // 2 == linear["h0_K3_9H"] == 83, "K3 h0")
    require(linear["h0_E_3O"] == 3, "elliptic h0")
    require(83 * 3 == linear["h0_L_eta9"] == 249, "eta9 h0")
    require(linear["parameter_space"] == "P(V_eta9)=P248", "eta9 P248")

    zeta = -sp.Rational(1, 2) + sp.sqrt(3) * sp.I / 2
    X = sp.Matrix(packet["theta_representation"]["X"])
    Z = sp.diag(1, zeta, zeta**2)
    require(matrix_is_zero(X * Z - zeta * Z * X), "clock-shift relation")
    require(X**3 == sp.eye(3), "shift order")
    require(matrix_is_zero(Z**3 - sp.eye(3)), "clock order")

    groups = list(product(range(3), repeat=2))

    def U(g: tuple[int, int]) -> sp.Matrix:
        return X ** g[0] * Z ** g[1]

    cocycle_count = 0
    for g, h, k in product(groups, repeat=3):
        phase = zeta ** sigma_exponent(g, h)
        require(
            matrix_is_zero(U(g) * U(h) - phase * U(add(g, h))),
            f"matrix multiplier at {g},{h}",
        )
        residual = (
            sigma_exponent(g, h)
            + sigma_exponent(add(g, h), k)
            - sigma_exponent(h, k)
            - sigma_exponent(g, add(h, k))
        ) % 3
        require(residual == 0, f"cocycle at {g},{h},{k}")
        cocycle_count += 1
    require(cocycle_count == packet["theta_representation"]["cocycle_identities"] == 729, "cocycle count")

    for g in groups[1:]:
        matrix = U(g)
        diagonal_scalar = matrix[0, 0]
        require(
            not matrix_is_zero(matrix - diagonal_scalar * sp.eye(3)),
            f"nonidentity projectively scalar at {g}",
        )

    # The exact modified-theta exponent shifts are n -> n and n -> n+1.
    # Translation by 1/3 contributes omega^k since n=3m+k.
    for k in range(3):
        for m in range(-5, 6):
            n = 3 * m + k
            require(n % 3 == k, "1/3 theta character")
            require((n * n + 2 * n) == (n + 1) ** 2 - 1, "tau/3 q exponent")
            require((n + 1) % 3 == (k + 1) % 3, "tau/3 index shift")

    t0, t1, t2 = sp.symbols("t0 t1 t2")
    t = sp.Matrix([t0, t1, t2])
    fourier = sp.Matrix([[1, 1, 1], [1, zeta, zeta**2], [1, zeta**2, zeta]])
    hesse = sp.diag(1, zeta, 1) * fourier * t
    mu = -2 * zeta**2
    hesse_cubic = sp.expand(sum(value**3 for value in hesse) - 3 * mu * sp.prod(hesse))
    fermat_cubic = 9 * (t0**3 + t1**3 + t2**3)
    require(sp.simplify(hesse_cubic - fermat_cubic) == 0, "Hesse-Fermat identity")

    for g, h in product(groups, repeat=2):
        Cg = U(g).inv().T
        Ch = U(h).inv().T
        inverse_phase = zeta ** (-sigma_exponent(g, h))
        require(
            matrix_is_zero(Cg * Ch - inverse_phase * U(add(g, h)).inv().T),
            f"contragredient multiplier at {g},{h}",
        )
        require(matrix_is_zero(Cg.T * U(g) - sp.eye(3)), f"incidence at {g}")

    incidence = packet["universal_incidence"]
    require(incidence["total_multiplier"] == "1", "incidence multiplier")
    require(incidence["universal_incidence_descends"], "incidence descent")
    require(incidence["central_determinant_on_V249"] == 1, "V249 determinant")
    require(249 % 3 == 0, "central determinant exponent")
    require(int(X.det()) == 1 and sp.simplify(Z.det()) == 1, "generator determinants")

    orbit = packet["selected_smooth_orbit"]
    minor = sp.Matrix(orbit["coefficient_minor"])
    determinant = int(minor.det()) % orbit["rank_witness_prime"]
    require(determinant == orbit["minor_determinant_mod_11"] == 2, "rank witness")
    require(orbit["coefficient_rank"] == 3, "coefficient rank")
    require(orbit["projective_stabilizer_order"] == 1, "selected stabilizer")
    require(orbit["orbit_size"] == 9, "selected orbit size")
    require(orbit["all_orbit_members_smooth"], "orbit smoothness")

    common = packet["common_base"]
    require(common["mixed_projective_class"] == "0", "common-base mixed class")
    require(common["new_continuous_parameters"] == 0, "continuous parameters")
    require(common["new_discrete_fit_parameters"] == 0, "discrete fit parameters")
    require(common["nonflat_HYM_determinant_comparison_closed"] is False, "HYM boundary")

    typing = packet["two_twist_typing"]
    require(typing["twists_are_equal"] is False, "two-twist separation")
    require(typing["twists_are_separate_slots_on_one_source"], "two-twist product")
    require(typing["eta9_finite_theta_background_matches_selected_sigma"], "theta background")
    require(typing["eta9_analytic_primitive_value_closed"] is False, "beta boundary")
    require(typing["discrete_theta_class_predicts_beta_C"] is False, "beta type guard")

    scope = packet["scope"]
    require(scope["eta9_equivariant_background_comparison_closed"], "background closure")
    require(scope["selected_smooth_eta9_orbit_closed"], "selected orbit closure")
    require(scope["B_ETA9_01_closed"] is False, "B.ETA9.01 boundary")
    require(scope["B_ETA9_02_closed"] is False, "B.ETA9.02 boundary")
    require(scope["B_HS_01_closed"] is False, "B.HS.01 boundary")
    require(scope["UST_G3_closed"] is False, "G3 boundary")

    print("UST.G3AB eta9 theta orientation: EXACT m=1")
    print("729 clock-shift cocycle identities: PASS")
    print("universal eta9 incidence multiplier: EXACTLY TRIVIAL")
    print("selected smooth eta9 stabilizer/orbit: 1 / 9")
    print("flat C64-E[3]-eta9 common-base map: CLOSED")
    print("finite sigma and analytic alpha_norm: SEPARATE TWIST SLOTS")
    print("rank-248 primitive beta_C: OPEN")


if __name__ == "__main__":
    main()
