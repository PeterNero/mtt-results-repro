def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def resolve_mld() -> Path:
    configured = os.environ.get("MTT_MLD_REPO")
    candidates = ([Path(configured)] if configured else []) + [
        ROOT.parent / "20 Mathematical Language Discovery Program",
        ROOT.parent / "Mathematical Language Discovery Program",
    ]
    for candidate in candidates:
        if (candidate / "build_q79_eta9_toric_return_stage1_chunk.py").is_file():
            return candidate.resolve()
    raise FileNotFoundError("Mathematical Language Discovery Program repository")


def polynomial_text(polynomial: dict[tuple[int, ...], int], ordinary) -> str:
    pieces = []
    for exponent, coefficient in sorted(polynomial.items()):
        coefficient %= PRIME
        if not coefficient:
            continue
        monomial = ordinary.monomial_text(exponent)
        pieces.append(monomial if coefficient == 1 else f"{coefficient}*{monomial}")
    return "+".join(pieces) if pieces else "0"


def sparse_polynomial(polynomial: dict[tuple[int, ...], int]) -> list[dict[str, Any]]:
    return [
        {"exponent": list(exponent), "coefficient_mod11": int(coefficient % PRIME)}
        for exponent, coefficient in sorted(polynomial.items())
        if coefficient % PRIME
    ]


def derivative(
    polynomial: dict[tuple[int, ...], int], variable_index: int
) -> dict[tuple[int, ...], int]:
    result: dict[tuple[int, ...], int] = {}
    for exponent, coefficient in polynomial.items():
        power = int(exponent[variable_index])
        if power == 0:
            continue
        target = list(exponent)
        target[variable_index] -= 1
        value = int(coefficient) * power % PRIME
        key = tuple(target)
        result[key] = (result.get(key, 0) + value) % PRIME
        if result[key] == 0:
            del result[key]
    return result


def parse_marker(output: str, label: str) -> int:
    match = re.search(rf"^{re.escape(label)}=(-?\d+)$", output, flags=re.MULTILINE)
    require(match is not None, f"missing {label}")
    return int(match.group(1))


def quotient_jet_polynomials(
    g3cn: dict[str, Any], schedule: dict[str, Any], solver_io
) -> list[dict[tuple[int, ...], int]]:
    result: list[dict[tuple[int, ...], int]] = [dict() for _ in range(225)]
    groups = schedule["groups_in_selected_order"]
    require(len(groups) == len(g3cn["groups"]) == 30, "30 group records")
    for group, summary in zip(groups, g3cn["groups"], strict=True):
        require(int(group["group_index"]) == int(summary["group_index"]), "group order")
        start = int(group["selected_column_start"])
        stop = int(group["selected_column_stop"])
        q = int(group["standard_monomial_quotient_dimension"])
        require(stop - start == int(group["selected_generator_count"]), "group width")
        if q == 0 or int(summary["first_jet_quotient_nonzero_entries"]) == 0:
            continue
        path = ROOT / summary["artifacts"]["first_jet_coordinates"]["path"]
        require(path.is_file(), f"missing coordinates for group {group['group_index']}")
        require(sha256(path) == summary["artifacts"]["first_jet_coordinates"]["sha256"], "coordinate hash")
        coordinates, quotient_rows, _ = solver_io.read_coordinates(path)
        require(quotient_rows == q, "quotient split")
        quotient = coordinates[:q, :].tocsc()
        basis = [tuple(int(value) for value in row) for row in group["quotient_standard_exponent_vectors"]]
        require(len(basis) == q and quotient.shape[1] == stop - start, "quotient shape")
        for local_column in range(stop - start):
            column = quotient.getcol(local_column)
            polynomial: dict[tuple[int, ...], int] = {}
            for row, value in zip(column.indices, column.data, strict=True):
                coefficient = int(value) % PRIME
                if coefficient:
                    polynomial[basis[int(row)]] = coefficient
            result[start + local_column] = polynomial
    require(sum(len(row) for row in result) == 15211, "G3CN quotient nnz")
    return result


