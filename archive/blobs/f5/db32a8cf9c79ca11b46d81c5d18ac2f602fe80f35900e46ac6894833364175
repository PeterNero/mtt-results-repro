    # (epsilon_1, epsilon_2, x, y, c, cbar), with ghost numbers
    # (0, 0, 0, 0, +1, -1).  Q x=c and Q cbar=y.
    dimension = 6
    q0 = zeros(dimension, dimension)
    q0[4][2] = Fraction(1)
    q0[3][5] = Fraction(1)

    krein = zeros(dimension, dimension)
    krein[0][0] = Fraction(1)
    krein[1][1] = Fraction(1)
    krein[2][3] = Fraction(1)
    krein[3][2] = Fraction(1)
    krein[4][5] = Fraction(1)
    krein[5][4] = Fraction(1)

    homotopy = zeros(dimension, dimension)
    homotopy[2][4] = Fraction(1)
    homotopy[5][3] = Fraction(1)

    physical_projector = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(0),
            Fraction(0),
            Fraction(0),
            Fraction(0),
        ]
    )

    closed_basis = zeros(dimension, 4)
    for column, row in enumerate([0, 1, 3, 4]):
        closed_basis[row][column] = Fraction(1)

    exact_basis = zeros(dimension, 2)
    for column, row in enumerate([3, 4]):
        exact_basis[row][column] = Fraction(1)

    preimage_basis = zeros(dimension, 2)
    for column, row in enumerate([5, 2]):
        preimage_basis[row][column] = Fraction(1)

    ghost_zero_closed_basis = zeros(dimension, 3)
