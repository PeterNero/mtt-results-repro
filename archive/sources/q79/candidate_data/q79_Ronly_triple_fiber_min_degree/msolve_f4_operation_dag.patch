     rba_t *rba;
     if (tr > 0) {
         rba = mat->rba[tmp_pos];
@@ -286,6 +429,17 @@ static hm_t *reduce_dense_row_by_known_pivots_sparse_ff_8(
         if (q79_f4_provenance_active && dts[BINDEX] > q79_provenance) {
