#!/usr/bin/env python3
"""Independently verify the accepted UST.G3GK same-field result."""

from __future__ import annotations

import sys
from pathlib import Path

import numpy as np
from scipy import sparse

import build_ust_g3gk_same_field_endpoint_griffiths_dwork as build


def verify_record(row: dict[str, object], *, repository: Path = build.ROOT) -> Path:
    path = repository / str(row["path"])
    build.require(path.is_file(), f"artifact exists: {path}")
    build.require(build.sha256(path) == row["sha256"], f"artifact hash: {path.name}")
    build.require(path.stat().st_size == int(row["bytes"]), f"artifact size: {path.name}")
    return path


def main() -> None:
    packet = build.load(build.OUT)
    build.require(
        packet["schema"]
        == "mtt.unified-source.g3gk-same-field-endpoint-griffiths-dwork.v1",
        "G3GK schema",
    )
    build.require(packet["theorem_id"] == "UST.G3GK", "theorem id")
    build.require(all(packet["checks"].values()), "all declared checks")
    provenance = packet["provenance"]
    build.require(int(provenance["prime"]) == build.PRIME, "selected prime")
    build.require(int(provenance["gamma_root"]) == build.ROOT_VALUE, "selected root")
    for label, expected in (
        ("G3BI", build.G3BI),
        ("G3BT", build.G3BT),
        ("G3GJ", build.G3GJ),
        ("G3GJ_quotient", build.G3GJ_QUOTIENT),
    ):
        row = provenance["inputs"][label]
        build.require(str(row["path"]) == expected.relative_to(build.ROOT).as_posix(), f"{label} path")
        verify_record(row)

    basis = packet["basis"]
    build.require(bool(basis["passed"]), "endpoint basis accepted")
    build.require(
        basis["schema"]
        == "mtt.unified-source.g3gk-endpoint-graded-basis-result.v2",
        "graded endpoint basis schema",
    )
    build.require(int(basis["Groebner_basis_size"]) > 0, "nonempty endpoint basis")
    build.require(int(basis["affine_dimension"]) == 4, "multiplier-zero affine dimension")
    build.require(int(basis["quotient_dimension"]) == -1, "positive-dimensional quotient marker")
    build.require(
        "fixed positive weighted degrees" in basis["graded_reduction_contract"],
        "fixed-degree graded reduction contract",
    )
    if "script" in basis:
        verify_record(basis["script"])
        verify_record(basis["raw_output"])
        cache = build.ROOT / str(basis["cache"]["path"])
        if cache.is_file():
            verify_record(basis["cache"])
        else:
            build.require(
                basis["cache"]["sha256"] == basis["cache_sha256"],
                "omitted rebuildable cache remains hash bound",
            )

    raw_path = verify_record(packet["artifacts"]["return_raw"] if "artifacts" in packet else packet["execution"]["raw_output"])
    raw = raw_path.read_text(encoding="utf-8")
    pole_zero = build.marker(raw, "G3GK_POLE6_RESIDUAL_ZERO")

    if packet["status"] == "CLOSED_EXACT_ANCHOR_K6_POLE_SIX_RESIDUAL_NOGO":
        build.require(pole_zero == 0, "exact nonzero pole residual")
        build.require("G3GK_RETURN_NOGO_NONZERO_POLE_RESIDUAL" in raw, "no-go marker")
        build.require(int(packet["execution"]["pole_six_residual_terms"]) > 0, "nonzero residual terms")
        verify_record(packet["execution"]["script"])
        verify_record(packet["execution"]["pole_residual"])
        print("UST.G3GK verifier: PASS exact nonzero pole-six residual (no-go)")
        return

    build.require(
        packet["status"]
        == "CLOSED_EXACT_ANCHOR_SAME_FIELD_K6_TORIC_RETURN_136_PROJECTION_OPEN",
        "positive G3GK status",
    )
    build.require(pole_zero == 1, "zero pole-six residual")
    build.require("G3GK_SAME_FIELD_RETURN_PASS" in raw, "same-field return marker")
    for label, expected in {
        "G3GK_RETURN_PRIME": build.PRIME,
        "G3GK_RETURN_GAMMA": build.ROOT_VALUE,
        "G3GK_RETURN_SOURCE_ROWS": build.SOURCE_DIMENSION,
        "G3GK_RETURN_TRANSFORM_ROWS": 10,
        "G3GK_RETURN_U_IDENTITY": 1,
        "G3GK_RETURN_TRANSFORM_RESIDUAL_ZERO": 1,
        "G3GK_RETURN_ORIGINAL_IDENTITY": 1,
        "G3GK_RETURN_COEFFICIENT_DEGREES_OK": 1,
        "G3GK_RETURN_DEGREES_OK": 1,
    }.items():
        build.require(build.marker(raw, label) == expected, label)

    artifacts = packet["artifacts"]
    for label, row in artifacts.items():
        if label == "return_raw":
            continue
        verify_record(row)
    ambient = sparse.load_npz(build.AMBIENT_MATRIX).tocsc().astype(np.int64)
    quotient = np.load(build.QUOTIENT_MATRIX, allow_pickle=False).astype(np.int64)
    build.require(
        ambient.shape == (build.AMBIENT_DIMENSION, build.SOURCE_DIMENSION),
        "ambient shape",
    )
    build.require(
        quotient.shape == (build.QUOTIENT_DIMENSION, build.SOURCE_DIMENSION),
        "quotient shape",
    )
    ambient.data %= build.PRIME
    ambient.eliminate_zeros()
    build.require(
        ambient.nnz == int(packet["same_field_return"]["ambient_nonzero_entries"]),
        "ambient nnz",
    )
    build.require(
        np.count_nonzero(quotient % build.PRIME)
        == int(packet["same_field_return"]["quotient_nonzero_entries"]),
        "quotient nnz",
    )
    rank = build.graded.rref(quotient % build.PRIME, build.PRIME)[0]
    build.require(rank == int(packet["same_field_return"]["quotient_rank"]), "quotient rank")

    mld = build.runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic

    g3bt = build.load(build.G3BT)
    root_record = next(
        row for row in g3bt["root_solves"] if int(row["gamma_root"]) == build.ROOT_VALUE
    )
    chart_path = build.ROOT / root_record["endpoint_chart"]["path"]
    chart = split_io.as_scipy(arithmetic.read_csc(chart_path, b"MTTSPC1\0", 6))
    rhs = split_io.as_scipy(arithmetic.read_csc(build.AMBIENT_RHS, b"MTTSRH1\0", 4))
    solution = split_io.as_scipy(
        arithmetic.read_csc(build.CHART_SOLUTION, b"MTTSCO1\0", 6)
    )
    build.require((rhs != ambient).nnz == 0, "serialized ambient RHS")
    residual = split_io.residual_nonzeros(chart, solution, rhs, build.PRIME)
    build.require(residual == 0, "independent chart residual")
    replay_quotient = solution[: build.QUOTIENT_DIMENSION, :].toarray().astype(np.int64)
    replay_quotient %= build.PRIME
    build.require(np.array_equal(replay_quotient, quotient % build.PRIME), "quotient replay")

    macaulay = build.load(mld / "q79_eta9_original_jacobian_macaulay_H02.packet.json")
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    raw_ambient = build.ambient_matrix_from_output(raw, target_lookup).astype(np.int64)
    raw_ambient.data %= build.PRIME
    raw_ambient.eliminate_zeros()
    build.require((raw_ambient != ambient).nnz == 0, "raw divergence to ambient matrix replay")
    build.require(not any(packet["guardrails"].values()), "no overclaim guardrail")
    print(
        "UST.G3GK verifier: PASS "
        f"basis={basis['Groebner_basis_size']} used_G={packet['same_field_return']['used_Groebner_generators']} "
        f"quotient_rank={rank}"
    )


if __name__ == "__main__":
    main()
