            "family": "k(a)",
            "archimedean_evaluation": "a=a(t)=1-t+i*pi*t*(1-t)",
        },
        "rational_family_typing": {
            "connection": "K_C(a) belongs to Mat_1509(k(a)) by the G3BK affine chart resolvents and algebraic recursive return",
            "selected_source": "b_C(a) belongs to k(a)^1509 and is H02-typed by the exact 100-term G3CA source",
            "block_formula": "K_C(a)=[[A(a),U(a)],[L(a),J(a)]] in dimensions 248+1261",
            "terminal_nonzero_certificate": "det J(0) reduces to 4 in GF(11), hence det J(a) is not the zero rational function over k(a)",
        },
        "pole_avoidance": {
            "parent_chart_poles": "algebraic by G3BK, with a=1 endpoint units supplied by G3BN and G3BR",
            "lower_block_zeros_and_poles": "algebraic because det J(a) is a nonzero rational function over the algebraic number field k",
            "interior_path_values": "transcendental by G3BJ",
            "conclusion": "J(a(t)) is invertible for every 0<t<1 and also at t=1 (a=0)",
            "unresolved_boundary": "J(1) at t=0 only; all three parent charts are already units there",
        },
        "static_schur_oracle": {
            "domain": "0<t<=1",
            "operator": "S_C(a)=A(a)-U(a)J(a)^-1L(a)",
            "effective_source": "b_eff(a)=-U(a)J(a)^-1b_lower(a)",
            "codomain": "Mat_248(k(a)) x k(a)^248",
