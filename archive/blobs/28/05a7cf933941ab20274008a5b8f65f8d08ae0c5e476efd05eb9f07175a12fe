#!/usr/bin/env python3
"""Emit a seventh-prime H02 kernel reserved from the G3DR candidates."""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

import build_ust_g3dk_h02_third_prime_kernel_relations as exact_campaign


ROOT = Path(__file__).resolve().parent
G3DR = ROOT / "state" / "ust_g3dr_h02_five_prime_reconstruction_holdout.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3ds"
OUT = ROOT / "state" / "ust_g3ds_h02_seventh_prime_holdout_kernel.packet.json"
PRIME = 72271
ROOTS = (6766, 9324, 19584, 44538, 67288, 69289)
SEVEN_PRIME_MODULUS = 21817 * 33863 * 37493 * 38113 * 68213 * 69011 * PRIME


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> None:
    g3dr = load(G3DR)
    require(all(g3dr["checks"].values()), "G3DR checks")
    exact_campaign.PRIME = PRIME
    exact_campaign.ROOTS = ROOTS
    exact_campaign.EVIDENCE = EVIDENCE
    exact_campaign.OUT = OUT
    exact_campaign.THREE_PRIME_MODULUS = 21817 * 33863 * PRIME
    exact_campaign.main()
    raw = load(OUT)
    require(int(raw["field"]["prime"]) == PRIME, "seventh-prime campaign")
    require(tuple(raw["field"]["roots"]) == ROOTS, "seventh-prime roots")
    kernel = raw.pop("third_split_algebra_kernel")
    checks = {
        "G3DR_is_hash_bound_and_closed_before_the_seventh_prime_holdout": True,
        "all_six_roots_of_reserved_prime72271_are_executed": True,
        "all_six_seventh_prime_couplings_have_rank4748_and1274_verified_relations": all(
            int(row["kernel_nonzero_entries"]) > 0 for row in raw["root_kernels"]
        ),
        "the_coordinate_partition_is_identical_across_all_seven_primes": bool(
            kernel["same_selection_as_G3DI_and_G3DJ"]
        ),
        "six_root_interpolation_emits_the_complete_seventh_split_algebra_kernel": int(
            kernel["interpolation_evaluation_mismatches"]
        )
        == 0,
        "prime72271_coefficients_are_stored_as_uint32": kernel[
            "coefficient_storage_dtype"
        ]
        == "uint32",
        "prime72271_was_not_used_in_G3DR_five_prime_construction_or_sixth_holdout": PRIME
        not in g3dr["reconstruction_contract"]["construction_primes"]
        + [g3dr["reconstruction_contract"]["reserved_holdout_prime"]],
        "no_characteristic_zero_promotion_is_inferred_from_seven_prime_agreement": True,
        "no_observed_value_or_fit_is_used": True,
    }
    require(all(checks.values()), "G3DS checks")
    packet = {
        "schema": "mtt.unified-source.g3ds-h02-seventh-prime-holdout-kernel.v1",
        "date": "2026-08-14",
        "theorem_id": "UST.G3DS",
        "status": "CLOSED_EXACT_H02_RESERVED_SEVENTH_SPLIT_PRIME_KERNEL",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {**raw["inputs"], "G3DR": exact_campaign.campaign.record(G3DR)},
        "field": raw["field"],
        "root_kernels": raw["root_kernels"],
        "seventh_split_algebra_kernel": {**kernel, "same_selection_as_all_prior_campaigns": True},
        "multiprime_promotion": {
            "primes": [21817, 33863, 37493, 38113, 68213, 69011, PRIME],
            "CRT_modulus": SEVEN_PRIME_MODULUS,
            "CRT_modulus_bits": SEVEN_PRIME_MODULUS.bit_length(),
            "seventh_prime_role": "held_out_from_six_prime_candidate_construction",
            "height_bound_available": False,
            "exact_Q_gamma_promotion": False,
        },
        "checks": checks,
        "guardrails": {
            "claims_the_relations_lift_to_Q_gamma": False,
            "claims_rank_Q_gamma_Q_equals4748": False,
            "claims_path_source_readout_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3dsH02SeventhPrimeHoldoutKernel",
            "tier": "CLOSED_EXACT_RESERVED_SEVENTH_SPLIT_ALGEBRA_KERNEL",
            "statement": "At all six roots of the previously unused split prime 72271, the H02 coupling again has rank 4748 and exactly 1274 normalized zero-residual relations with the common coordinate partition. The complete seventh split-algebra kernel is persisted as an independent holdout for six-prime candidates.",
        },
        "frontier_delta": {
            "before": "Five-prime candidates had sixth-prime verdicts, but six-prime candidates had no seventh-prime archive.",
            "after": "A complete seventh-prime split-algebra kernel is reserved for the next signed128 reconstruction audit.",
        },
        "next_required_object": "Construct candidates from the first six primes with the G3DR executor, test them against prime72271, and reserve prime73673 for the final persisted-prime holdout.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3DS H02 reserved seventh-prime kernel: PASS")
    print(f"six_ranks=4748 kernel=6022x1274 CRT7_bits={SEVEN_PRIME_MODULUS.bit_length()}")
    print(f"packet_sha256={exact_campaign.campaign.sha256(OUT)}")


if __name__ == "__main__":
    main()
