        [int(value) for value in row]
        for row in g3bi["smooth_endpoint"]["coefficient_vectors"]
    ]
    for row in g3bi["exact_construction"]["right_inverse_rows"]:
        index = int(row["source_index"])
        reconstructed_endpoint[index] = [
            left + int(right)
            for left, right in zip(
                reconstructed_endpoint[index],
                row["correction_gamma_coordinates"],
                strict=True,
            )
        ]
    require(
        reconstructed_endpoint == g3bi["selected_source"]["coefficient_vectors"],
        "G3BI endpoint equals B89 plus the selected correction",
    )

    base = load(residue.BASE)
