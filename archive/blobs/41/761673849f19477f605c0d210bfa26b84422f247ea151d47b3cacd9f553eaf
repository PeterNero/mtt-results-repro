#!/usr/bin/env python3
"""Independently reload and verify the executed selected Cayley basis cache."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess

from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
RESULT = ROOT / "state" / "ust_g3al_selected_cayley_basis.result.json"
RELOAD_SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_reload.sing"
ACTIVE_RELOAD_SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_reload.active.sing"
RELOAD_OUTPUT = ROOT / "state" / "ust_g3am_selected_cayley_basis_reload.singular.out"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def scalar(output: str, label: str) -> int:
    match = re.search(rf"^{re.escape(label)}=(-?\d+)$", output, flags=re.MULTILINE)
    require(match is not None, f"missing {label}")
    return int(match.group(1))


def text_value(output: str, label: str) -> str:
    match = re.search(rf"^{re.escape(label)}=(.*)$", output, flags=re.MULTILINE)
    require(match is not None, f"missing {label}")
    return match.group(1).strip()


def checked_artifact(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"{label} exists")
    require(sha256(path) == record["sha256"], f"{label} hash")
    return path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=1800)
    args = parser.parse_args()
    result = json.loads(RESULT.read_text(encoding="ascii"))
    require(
        result["schema"] == "mtt.unified-source.g3al-selected-cayley-basis-result.v1",
        "basis result schema",
    )
    require(result["passed"] is True, "basis runner passed")
    require(result["returncode"] == 0 and result["timed_out"] is False, "basis execution")
    script = checked_artifact(result["script"], "basis script")
    output_path = checked_artifact(result["output"], "basis output")
    cache_record = result["cache"]
    require(cache_record is not None, "basis cache record")
    cache = checked_artifact(cache_record, "basis cache")
    require(cache.stat().st_size == cache_record["bytes"] > 0, "basis cache size")
    if result.get("source"):
        source = checked_artifact(result["source"], "basis source")
        algorithm = result.get("algorithm")
        require(algorithm in ("std", "std_nored"), "adopted algorithm")
        expected_source = source.read_text(encoding="ascii")
        if algorithm == "std_nored":
            require(expected_source.count("option(redSB);\n") == 1, "one redSB option")
            expected_source = expected_source.replace("option(redSB);\n", "", 1)
        expected = expected_source.replace(
            "ideal G=slimgb(J);", "ideal G=std(J);"
        ).replace(
            'write("ssi:w state/ust_g3al_selected_cayley_basis.ssi",G);',
            f'write("ssi:w {cache_record["path"]}",G);',
        )
        require(script.read_text(encoding="ascii") == expected, "adopted std script identity")
    if result.get("adopted_from"):
        checked_artifact(result["adopted_from"], "adoption result")

    output = output_path.read_text(encoding="utf-8")
    require("G3AL_SELECTED_CAYLEY_BASIS_PASS" in output, "basis pass marker")
    require("error" not in output.lower(), "basis output has no error")
    require(scalar(output, "G3AL_J_GENERATORS") == 10, "ten Jacobian generators")
    basis_size = scalar(output, "G3AL_GB_SIZE")
    dimension = scalar(output, "G3AL_AFFINE_DIMENSION")
    socle_terms = scalar(output, "G3AL_SOCLE_TERMS")
    require(basis_size > 0, "nonempty standard basis")
    require(scalar(output, "G3AL_COVER_REDUCES") == 0, "cover equation reduction")
    require(scalar(output, "G3AL_SOCLE_ZERO") == 0, "nonzero socle")
    require(socle_terms > 0, "socle term count")
    socle_lead = text_value(output, "G3AL_SOCLE_LEAD")
    require(bool(socle_lead), "socle leading monomial")
    require("ring r=(101,g)" in script.read_text(encoding="ascii"), "selected field script")

    cache_relative = str(cache.relative_to(ROOT)).replace("\\", "/")
    reload_source = RELOAD_SCRIPT.read_text(encoding="ascii")
    require(
        reload_source.count("state/ust_g3al_selected_cayley_basis.ssi") == 1,
        "reload cache placeholder",
    )
    ACTIVE_RELOAD_SCRIPT.write_text(
        reload_source.replace("state/ust_g3al_selected_cayley_basis.ssi", cache_relative),
        encoding="ascii",
    )
    completed = subprocess.run(
        singular_command(ROOT, ACTIVE_RELOAD_SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    RELOAD_OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, f"reload return code {completed.returncode}")
    reload_output = completed.stdout
    require("G3AM_SELECTED_CAYLEY_BASIS_RELOAD_PASS" in reload_output, "reload pass")
    require("error" not in reload_output.lower(), "reload output has no error")
    require(scalar(reload_output, "G3AM_RELOAD_GB_SIZE") == basis_size, "reload basis size")
    require(
        scalar(reload_output, "G3AM_RELOAD_AFFINE_DIMENSION") == dimension,
        "reload affine dimension",
    )
    require(scalar(reload_output, "G3AM_RELOAD_SOCLE_ZERO") == 0, "reload socle")
    require(
        scalar(reload_output, "G3AM_RELOAD_SOCLE_TERMS") == socle_terms,
        "reload socle terms",
    )
    require(
        text_value(reload_output, "G3AM_RELOAD_SOCLE_LEAD") == socle_lead,
        "reload socle lead",
    )
    print("UST.G3AM selected Cayley basis execution: PASS")
    print(
        f"basis={basis_size}, affine_dimension={dimension}, "
        f"socle_terms={socle_terms}, cache_bytes={cache.stat().st_size}"
    )


if __name__ == "__main__":
    main()
