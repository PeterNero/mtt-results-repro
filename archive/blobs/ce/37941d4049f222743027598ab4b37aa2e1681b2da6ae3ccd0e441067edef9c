    target_y_covariance = target_covariance[1][1]
    source_quartic_wick = -source_v4 * gaussian_even_moment(source_y_covariance, 4) / math.factorial(4)
    target_quartic_wick = -target_v4 * gaussian_even_moment(target_y_covariance, 4) / math.factorial(4)
    source_cubic_pair_wick = (
        Fraction(1, 2)
        * (source_v3 / math.factorial(3)) ** 2
        * gaussian_even_moment(source_y_covariance, 6)
    )
    target_cubic_pair_wick = (
        Fraction(1, 2)
        * (target_v3 / math.factorial(3)) ** 2
        * gaussian_even_moment(target_y_covariance, 6)
    )

    expected_source_cost: Polynomial = {
        (2, 0): Fraction(1, 2),
        (0, 2): Fraction(1, 2),
        (0, 3): Fraction(1),
        (0, 4): Fraction(1, 2),
