def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def checked_local(item: dict[str, Any]) -> Path:
    path = ROOT / item["path"]
    require(path.is_file(), f"missing {path}")
    require(path.stat().st_size == int(item["bytes"]), f"size {path.name}")
    require(sha256(path) == item["sha256"], f"hash {path.name}")
    return path


def isolated_roots(root_bits: int, maxprec: int) -> list[acb]:
    polynomial = acb_poly([64, 16, 33, 44, 89, 24, 1])
    roots = polynomial.roots(tol=arb(2) ** (-root_bits), maxprec=maxprec)
    require(len(roots) == 6, "six isolated roots")
    roots = sorted(roots, key=lambda value: (float(value.real.mid()), float(value.imag.mid())))
    require(
        all(
            not roots[left].overlaps(roots[right])
            for left in range(6)
            for right in range(left + 1, 6)
        ),
        "pairwise disjoint roots",
    )
    require(all(polynomial(root).contains(0) for root in roots), "root residuals")
    require(roots[5].overlaps(roots[4].conjugate()), "embedding4/5 conjugate pair")
    return roots


def union_pattern(matrices: list[sparse.csr_matrix]) -> sparse.csr_matrix:
    pattern = matrices[0].copy().astype(np.uint8)
    pattern.data[:] = 1
    for matrix in matrices[1:]:
        term = matrix.copy().astype(np.uint8)
        term.data[:] = 1
        pattern = pattern.maximum(term)
    pattern.sum_duplicates()
    pattern.data[:] = 1
    return pattern.tocsr()


def evaluate_dense(
    coefficients: list[sparse.csr_matrix],
    rows: np.ndarray,
    columns: np.ndarray,
    powers: list[acb],
) -> tuple[acb_mat, int]:
    result = acb_mat(len(rows), len(columns))
    support: set[tuple[int, int]] = set()
    for power, matrix in enumerate(coefficients):
        block = matrix[rows, :][:, columns].tocoo()
        for row, column, coefficient in zip(
            block.row.tolist(),
            block.col.tolist(),
            block.data.tolist(),
            strict=True,
        ):
            result[row, column] = result[row, column] + int(coefficient) * powers[power]
            support.add((int(row), int(column)))
    return result, len(support)


def reconstructed_ball(arrays: dict[str, np.ndarray], row: int, column: int) -> acb:
    real = (
        arb(float(arrays["real_high"][row, column]))
        + arb(float(arrays["real_low"][row, column]))
        + arb(0, float(arrays["real_radius"][row, column]))
    )
    imag = (
        arb(float(arrays["imag_high"][row, column]))
        + arb(float(arrays["imag_low"][row, column]))
        + arb(0, float(arrays["imag_radius"][row, column]))
    )
    return acb(real, imag)


def matrix_accuracy(matrix: acb_mat) -> dict[str, Any]:
    entries = matrix.entries()
    require(all(value.is_finite() for value in entries), "finite ball matrix")
    accuracies = [int(value.rel_accuracy_bits()) for value in entries if not value.contains(0)]
    return {
        "entries": len(entries),
        "entries_containing_zero": sum(value.contains(0) for value in entries),
        "minimum_relative_accuracy_bits_away_from_zero": min(accuracies) if accuracies else 0,
        "maximum_real_radius": str(max((value.real.rad() for value in entries), default=arb(0))),
        "maximum_imaginary_radius": str(max((value.imag.rad() for value in entries), default=arb(0))),
    }


def widened_double_double(value: arb) -> tuple[float, float, float, arb]:
    midpoint = value.mid()
    high = float(midpoint)
    low = float((midpoint - arb(high)).mid())
    center = arb(high) + arb(low)
    radius_bound = abs(midpoint - center) + value.rad()
    radius = math.nextafter(float(radius_bound), math.inf)
    enclosure = center + arb(0, radius)
    while not enclosure.contains(value):
        radius = math.nextafter(radius, math.inf)
        enclosure = center + arb(0, radius)
    return high, low, radius, enclosure


def persist_matrix(path: Path, matrix: acb_mat, row_label: str) -> dict[str, Any]:
    rows = matrix.nrows()
    columns = matrix.ncols()
    shape = (rows, columns)
    real_high = np.empty(shape, dtype=np.float64)
    real_low = np.empty(shape, dtype=np.float64)
    real_radius = np.empty(shape, dtype=np.float64)
    imag_high = np.empty(shape, dtype=np.float64)
    imag_low = np.empty(shape, dtype=np.float64)
    imag_radius = np.empty(shape, dtype=np.float64)
    contained = 0
    minimum_accuracy: int | None = None
    zero_containing = 0
    for index, value in enumerate(matrix.entries()):
        row, column = divmod(index, columns)
        rh, rl, rr, real_enclosure = widened_double_double(value.real)
        ih, il, ir, imag_enclosure = widened_double_double(value.imag)
        real_high[row, column] = rh
        real_low[row, column] = rl
        real_radius[row, column] = rr
        imag_high[row, column] = ih
        imag_low[row, column] = il
        imag_radius[row, column] = ir
        enclosure = acb(real_enclosure, imag_enclosure)
        if enclosure.real.contains(value.real) and enclosure.imag.contains(value.imag):
            contained += 1
        if enclosure.contains(0):
            zero_containing += 1
        else:
            accuracy = int(enclosure.rel_accuracy_bits())
            minimum_accuracy = accuracy if minimum_accuracy is None else min(minimum_accuracy, accuracy)
    require(contained == rows * columns, "portable matrix containment")
    np.savez_compressed(
        path,
        row_coordinates=np.arange(rows, dtype=np.int32),
        source_columns=np.arange(columns, dtype=np.int32),
        row_coordinate_type=np.asarray(row_label),
        real_high=real_high,
        real_low=real_low,
        real_radius=real_radius,
        imag_high=imag_high,
        imag_low=imag_low,
        imag_radius=imag_radius,
    )
    return {
        "shape": list(shape),
        "contained_entries": contained,
        "entries_containing_zero": zero_containing,
        "minimum_relative_accuracy_bits_away_from_zero": minimum_accuracy or 0,
        "archive": record(path),
        "format": "real/imag double-double centers plus outward float64 radii",
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--precision", type=int, default=256)
    parser.add_argument("--root-bits", type=int, default=208)
    parser.add_argument("--maxprec", type=int, default=1024)
    args = parser.parse_args()
    require(args.precision >= 192, "minimum precision")
    require(args.root_bits >= 160, "minimum root isolation")
    ctx.prec = args.precision

    started = time.perf_counter()
    g3cv = load(G3CV)
    g3cy = load(G3CY)
    g3da = load(G3DA)
    g3db = load(G3DB)
    g3dc = load(G3DC)
