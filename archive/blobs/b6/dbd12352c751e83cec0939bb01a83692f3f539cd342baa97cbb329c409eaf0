def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"packet exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def rational_reconstruct(residue: int, modulus: int, bound: int) -> tuple[int, int, bool]:
    old_remainder, remainder = modulus, residue
    old_denominator, denominator = 0, 1
    while abs(remainder) > bound:
        quotient = old_remainder // remainder
        old_remainder, remainder = remainder, old_remainder - quotient * remainder
        old_denominator, denominator = denominator, old_denominator - quotient * denominator
    numerator = remainder
    if denominator < 0:
        numerator, denominator = -numerator, -denominator
    valid = (
        denominator > 0
        and denominator <= bound
        and abs(numerator) <= bound
        and math.gcd(numerator, denominator) == 1
    )
    return numerator, denominator, valid


def normalize_kernel(
    kernel_matrix,
    prime: int,
    protected: np.ndarray,
    canonical_relations: tuple[int, ...],
) -> np.ndarray:
    projection = kernel_matrix[protected, :].toarray().astype(np.int64) % prime
    chosen = tuple(kernel_tools.independent_columns(projection, prime))
    require(chosen == canonical_relations, "canonical relation chart")
    pivot = projection[:, np.asarray(chosen)]
    require(pivot.shape == (100, 100), "protected pivot shape")
    inverse = linear_tools.inverse_mod(pivot, prime)
    selected = kernel_matrix[:, np.asarray(chosen)].toarray().astype(np.int64) % prime
    normalized = selected @ inverse % prime
    require(
        np.array_equal(normalized[protected, :], np.eye(100, dtype=np.int64)),
        "normalized protected identity",
    )
    return normalized


def cache_paths(prime: int) -> tuple[Path, Path]:
    return (
        EVIDENCE / f"H02.component20.p{prime}.normalized_relations.npz",
        EVIDENCE / f"H02.component20.p{prime}.normalized_relations.json",
    )


def write_cache(
    prime: int,
    roots: tuple[int, ...],
    values: list[np.ndarray],
    fibers: list[dict[str, object]],
    provenance: str,
) -> tuple[np.ndarray, dict[str, object]]:
    residues = interpolation.interpolate(np.stack(values), roots, prime).astype(np.uint32)
    require(residues.shape == (6, 5411, 100), "normalized residue shape")
    cache, metadata_path = cache_paths(prime)
    np.savez_compressed(
        cache,
        prime=np.asarray([prime], dtype=np.uint32),
        roots=np.asarray(roots, dtype=np.uint32),
        normalized_relation_power_basis_residues=residues,
    )
    metadata = {
        "prime": prime,
        "roots": list(roots),
        "provenance": provenance,
        "fibers": fibers,
        "artifact": record(cache),
    }
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
    return residues, metadata


def read_cache(prime: int, roots: tuple[int, ...]) -> tuple[np.ndarray, dict[str, object]] | None:
    cache, metadata_path = cache_paths(prime)
    if not (cache.is_file() and metadata_path.is_file()):
        return None
    payload = np.load(cache, allow_pickle=False)
    require(int(payload["prime"][0]) == prime, "cached prime")
    require(tuple(int(value) for value in payload["roots"]) == roots, "cached roots")
    residues = payload["normalized_relation_power_basis_residues"].astype(np.uint32)
    require(residues.shape == (6, 5411, 100), "cached residues")
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    require(metadata["artifact"]["sha256"] == sha256(cache), "cached hash")
    return residues, metadata


def cleanup(*paths: Path) -> None:
    for path in paths:
        path.unlink(missing_ok=True)


def archived_rows() -> dict[int, dict[int, dict[str, object]]]:
    grouped: dict[int, dict[int, dict[str, object]]] = defaultdict(dict)
    for packet_path in (G3FB, G3FC):
        packet = load(packet_path)
        require(all(packet["checks"].values()), f"archived checks {packet_path.name}")
        for row in packet["campaign"]["results"]:
            grouped[int(row["prime"])][int(row["gamma_root"])] = row
    require(tuple(grouped) == ARCHIVED_PRIMES, "archived prime order")
    return grouped


def build_archived_prime(
    prime: int,
    roots: tuple[int, ...],
    rows: dict[int, dict[str, object]],
    protected: np.ndarray,
    canonical_relations: tuple[int, ...],
    canonical_dependent: tuple[int, ...],
) -> tuple[np.ndarray, dict[str, object]]:
    cached = read_cache(prime, roots)
    if cached is not None:
        return cached
    values: list[np.ndarray] = []
    fibers: list[dict[str, object]] = []
    for root in roots:
        row = rows[root]
        path = ROOT / row["kernel"]["path"]
        require(sha256(path) == row["kernel"]["sha256"], "archived kernel hash")
        stored_prime, matrix, dependent, _ = kernel_tools.read_kernel(path)
        require(stored_prime == prime, "archived stored prime")
        require(
            tuple(int(dependent[index]) for index in canonical_relations)
            == tuple(canonical_dependent[index] for index in canonical_relations),
            "archived selected dependent chart",
        )
        values.append(normalize_kernel(matrix, prime, protected, canonical_relations))
        fibers.append(
            {
                "gamma_root": root,
                "rank": 5025,
                "nullity": 386,
                "protected_rank": 100,
                "full_dependent_chart_matches_anchor": tuple(
                    int(value) for value in dependent
                )
                == canonical_dependent,
                "kernel": row["kernel"],
            }
        )
        print(f"G3FT archived p={prime} gamma={root}: normalized=5411x100", flush=True)
    return write_cache(prime, roots, values, fibers, "archived_G3FB_G3FC_kernel")


def build_new_prime(
    prime: int,
    roots: tuple[int, ...],
    protected: np.ndarray,
    canonical_relations: tuple[int, ...],
    canonical_dependent: tuple[int, ...],
    row_indices: np.ndarray,
    column_indices: np.ndarray,
    coefficients: np.ndarray,
) -> tuple[np.ndarray, dict[str, object]]:
    cached = read_cache(prime, roots)
    if cached is not None:
        return cached
    values: list[np.ndarray] = []
    fibers: list[dict[str, object]] = []
    for root in roots:
        require(rank_tools.evaluate(rank_tools.MINIMAL, prime, root) == 0, "split root")
        stem = f"p{prime}.g{root}"
        chart = SCRATCH / f"{stem}.chart.bin"
        rank_log = SCRATCH / f"{stem}.rank.log"
        kernel = SCRATCH / f"{stem}.kernel.bin"
        kernel_log = SCRATCH / f"{stem}.kernel.log"
        nonzeros = rank_tools.write_chart(
            chart, prime, root, row_indices, column_indices, coefficients
        )
        rank_fields, _ = rank_tools.run_rank(chart, rank_log)
        require(
            (int(rank_fields["RANK"]), int(rank_fields["NULLITY"])) == (5025, 386),
            "new rank profile",
        )
        kernel_fields, _ = kernel_tools.run_kernel(chart, kernel, kernel_log)
        stored_prime, matrix, dependent, _ = kernel_tools.read_kernel(kernel)
        require(stored_prime == prime, "new stored prime")
        require(int(kernel_fields["VERIFIED_RELATIONS"]) == 386, "new kernel replay")
        require(
            tuple(int(dependent[index]) for index in canonical_relations)
            == tuple(canonical_dependent[index] for index in canonical_relations),
            "new selected dependent chart",
        )
        values.append(normalize_kernel(matrix, prime, protected, canonical_relations))
        fibers.append(
            {
                "gamma_root": root,
                "rank": 5025,
                "nullity": 386,
                "protected_rank": 100,
                "full_dependent_chart_matches_anchor": tuple(
                    int(value) for value in dependent
                )
                == canonical_dependent,
                "nonzero_entries": nonzeros,
                "kernel_nonzeros": int(matrix.nnz),
                "rank_elapsed_seconds": float(rank_fields["ELAPSED_SECONDS"]),
                "kernel_elapsed_seconds": float(kernel_fields["ELAPSED_SECONDS"]),
                "ephemeral_chart_sha256": sha256(chart),
                "ephemeral_kernel_sha256": sha256(kernel),
            }
        )
        cleanup(chart, rank_log, kernel, kernel_log)
        print(f"G3FT new p={prime} gamma={root}: normalized=5411x100", flush=True)
    return write_cache(prime, roots, values, fibers, "fresh_G3EZ_split_kernel")


def reconstruction_audit(
    residue_arrays: list[np.ndarray], primes: tuple[int, ...], prefix: int
) -> dict[str, object]:
    require(2 <= prefix <= len(primes), "audit prefix")
    flattened = [array.reshape(-1) for array in residue_arrays[:prefix]]
    slots = flattened[0].size
    modulus = math.prod(primes[: prefix - 1])
    bound = math.isqrt((modulus - 1) // 2)
    holdout_prime = primes[prefix - 1]
    counts = {
        "valid_candidates": 0,
        "holdout_passes": 0,
        "holdout_aliases": 0,
        "outside_uniqueness_range": 0,
        "passing_zeros": 0,
        "passing_units": 0,
        "passing_integers": 0,
        "passing_nontrivial_coefficients": 0,
    }
    samples: list[dict[str, object]] = []
    chunk_size = 8192
    for first in range(0, slots, chunk_size):
        past = min(first + chunk_size, slots)
        combined = [int(value) for value in flattened[0][first:past]]
        current_modulus = primes[0]
        for prime, row in zip(
            primes[1 : prefix - 1], flattened[1 : prefix - 1], strict=True
        ):
            inverse = pow(current_modulus % prime, -1, prime)
            combined = [
                value
                + current_modulus
                * (((int(target) - value % prime) * inverse) % prime)
                for value, target in zip(combined, row[first:past], strict=True)
            ]
            current_modulus *= prime
        require(current_modulus == modulus, "chunk CRT modulus")
        for local, (value, target) in enumerate(
            zip(combined, flattened[prefix - 1][first:past], strict=True)
        ):
            numerator, denominator, candidate = rational_reconstruct(value, modulus, bound)
            if not candidate:
                counts["outside_uniqueness_range"] += 1
                continue
            counts["valid_candidates"] += 1
            if (numerator - int(target) * denominator) % holdout_prime:
                counts["holdout_aliases"] += 1
                continue
            counts["holdout_passes"] += 1
            if numerator == 0:
                counts["passing_zeros"] += 1
            elif abs(numerator) == 1 and denominator == 1:
                counts["passing_units"] += 1
            else:
                counts["passing_nontrivial_coefficients"] += 1
                if len(samples) < 20:
                    power, row_index, relation = np.unravel_index(
                        first + local, (6, 5411, 100)
                    )
                    samples.append(
                        {
                            "power_basis_degree": int(power),
                            "row_zero_based": int(row_index),
                            "relation_zero_based": int(relation),
                            "numerator": str(numerator),
                            "denominator": str(denominator),
                        }
                    )
            if denominator == 1:
                counts["passing_integers"] += 1
        if first and first % (chunk_size * 32) == 0:
            print(
                f"G3FT reconstruct prefix={prefix} slots={first}/{slots} "
                f"passes={counts['holdout_passes']}",
                flush=True,
            )
    return {
        "prime_count": prefix,
        "construction_primes": list(primes[: prefix - 1]),
        "holdout_prime": holdout_prime,
        "coefficient_slots": int(slots),
        "modulus_bits": modulus.bit_length(),
        "uniqueness_bound_bits": bound.bit_length(),
        **counts,
        "complete": counts["holdout_passes"] == slots,
        "passing_nontrivial_samples": samples,
    }


