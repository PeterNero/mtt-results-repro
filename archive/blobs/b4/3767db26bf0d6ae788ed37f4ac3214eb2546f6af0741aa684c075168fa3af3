            "claims_B_ETA9_02_is_closed": False,
        },
        "artifacts": {"production_template": record(TEMPLATE)},
        "next_required_object": "Transport the exact sparse root input (-e2+2f2) tensor u_B into the fixed B89 integral marking, emit either its rank1509 coordinates or a certified meridian word and its 248 normalized readout, then apply G3BD. Also transport the sparse kernel shift (-e2-2f2) tensor u_B only if the optional G3AU period-descent test is used.",
