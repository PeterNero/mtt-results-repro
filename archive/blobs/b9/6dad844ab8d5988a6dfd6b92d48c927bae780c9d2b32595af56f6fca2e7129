#!/usr/bin/env python3
"""Independently replay the selected full-response Schur certificate."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

import build_ust_g3al_selected_carrier_response_schur as g3al_builder
import build_ust_g3al_selected_cayley_response_chunk as legacy
import build_ust_g3am_selected_cayley_fiber2_response_chunk as chunk_builder
import verify_ust_g3ak_full_graph_incidence_normal_decomposition as arithmetic
import verify_ust_g3am_selected_cayley_principal_response as g3am_verify
import ust_cayley_fiber2_reduction as fiber2


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3an_selected_cayley_full_response_schur.packet.json"
G3AM_PACKET = ROOT / "state" / "ust_g3am_selected_cayley_principal_response.packet.json"
P = 101
DEGREE = 6
Element = tuple[int, ...]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_hash(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def transpose(matrix: list[list[Element]]) -> list[list[Element]]:
    return [list(row) for row in zip(*matrix)]


def dot(left: list[Element], right: list[Element], relation: tuple[int, ...]) -> Element:
    value = arithmetic.arithmetic.qzero(DEGREE)
    for a, b in zip(left, right):
        value = arithmetic.add(value, arithmetic.mul(a, b, relation))
    return value


def multiply(
    left: list[list[Element]],
    right: list[list[Element]],
    relation: tuple[int, ...],
) -> list[list[Element]]:
    require(left and right and len(left[0]) == len(right), "matrix product dimensions")
    columns = transpose(right)
    return [[dot(row, column, relation) for column in columns] for row in left]


def sparse_multiply(
    left: list[list[Element]],
    right: list[list[Element]],
    relation: tuple[int, ...],
) -> list[list[Element]]:
    require(left and right and len(left[0]) == len(right), "sparse product dimensions")
    zero = arithmetic.arithmetic.qzero(DEGREE)
    result = [[zero for _ in range(len(right[0]))] for _ in left]
    for row_index, row in enumerate(left):
        for middle, left_value in enumerate(row):
            if left_value == zero:
                continue
            for column, right_value in enumerate(right[middle]):
                if right_value == zero:
                    continue
                result[row_index][column] = arithmetic.add(
                    result[row_index][column],
                    arithmetic.mul(left_value, right_value, relation),
                )
    return result


def decode(
    raw: bytes,
    record: dict,
    label: str,
) -> list[list[Element]]:
    rows, columns, degree = [int(value) for value in record["shape"]]
    require(degree == DEGREE, f"{label} degree")
    start = int(record["byte_offset"])
    length = int(record["byte_length"])
    require(length == rows * columns * degree, f"{label} byte length")
    data = raw[start : start + length]
    require(len(data) == length, f"{label} data range")
    matrix = []
    offset = 0
    for _ in range(rows):
        row = []
        for _ in range(columns):
            row.append(tuple(data[offset : offset + degree]))
            offset += degree
        matrix.append(row)
    require(
        canonical_hash([[list(value) for value in row] for row in matrix])
        == record["canonical_sha256"],
        f"{label} canonical hash",
    )
    return matrix


def decode_d0(packet: dict) -> list[list[Element]]:
    artifact = packet["principal_response"]["binary_artifact"]
    path = ROOT / artifact["path"]
    raw = path.read_bytes()
    require(sha256(path) == artifact["sha256"], "D0 artifact hash")
    require(len(raw) == 248 * 33 * DEGREE, "D0 artifact bytes")
    matrix = []
    offset = 0
    for _ in range(248):
        row = []
        for _ in range(33):
            row.append(tuple(raw[offset : offset + DEGREE]))
            offset += DEGREE
        matrix.append(row)
    return matrix


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--upstream-g3am-verified-in-caller", action="store_true")
    args = parser.parse_args()
    if not args.upstream_g3am_verified_in_caller:
        subprocess.run(
            [sys.executable, str(ROOT / "verify_ust_g3am_selected_cayley_principal_response.py")],
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
    packet = load(PACKET)
    g3am = load(G3AM_PACKET)
    reduction = fiber2.selected_fiber2_reduction()
    reduction_scope = fiber2.response_reduction_basis(reduction)
    require(
        packet["reduction_basis"] == reduction_scope,
        "full-response packet reduction scope",
    )
    require(
        packet["schema"] == "mtt.unified-source.g3an-selected-cayley-full-response-schur.v1",
        "packet schema",
    )
    require(packet["theorem_id"] == "UST.G3AN", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    for name, record in packet["inputs"].items():
        path = ROOT / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"input {name}")

    field = packet["residue_field"]
    relation = tuple(int(value) for value in field["gamma_relation_coefficients_ascending"])
    require(field["prime"] == P and field["extension_degree"] == DEGREE, "selected field")
    zero = arithmetic.arithmetic.qzero(DEGREE)
    one = arithmetic.arithmetic.qone(DEGREE)
    functional_route = reduction["module_cache_record"] is None
    frames = g3al_builder.selected_frames()
    carrier_basis = frames["basis"]
    pivot = int(frames["projective_pivot"])
    primitive_rows = [
        legacy.section(row)
        for index, row in enumerate(carrier_basis)
        if index != pivot
    ]
    tangent_columns = frames["principal"] + frames["extra"]
    g3al_packet = load(ROOT / packet["inputs"]["G3AL"]["path"])
    block = packet["full_response_schur"]
    bundle = block["binary_artifact"]
    bundle_path = ROOT / bundle["path"]
    raw = bundle_path.read_bytes()
    require(sha256(bundle_path) == bundle["sha256"], "bundle hash")
    require(len(raw) == bundle["bytes"], "bundle bytes")
    layout = bundle["layout"]
    d1 = decode(raw, layout["D1_extra_response"], "D1")
    e = decode(raw, layout["E_N0D1"], "E")
    n0 = decode(raw, layout["N0_principal_quotient"], "N0")
    r0_inverse = decode(raw, layout["R0_inverse"], "R0 inverse")
    require((len(d1), len(d1[0])) == (248, 89), "D1 shape")
    require((len(e), len(e[0])) == (215, 89), "E shape")
    require((len(n0), len(n0[0])) == (215, 248), "N0 shape")
    require((len(r0_inverse), len(r0_inverse[0])) == (33, 33), "R0 inverse shape")

    d0 = decode_d0(g3am)
    pivot_rows = [int(value) for value in block["principal_pivot_rows_zero_based"]]
    quotient_rows = [int(value) for value in block["principal_quotient_rows_zero_based"]]
    require(len(pivot_rows) == 33 and len(quotient_rows) == 215, "principal split")
    require(sorted(pivot_rows + quotient_rows) == list(range(248)), "principal partition")
    r0 = [d0[row] for row in pivot_rows]
    require(
        multiply(r0_inverse, r0, relation)
        == [[one if row == column else zero for column in range(33)] for row in range(33)],
        "R0 inverse identity",
    )
    require(sparse_multiply(n0, d0, relation) == [[zero] * 33 for _ in range(215)], "N0D0=0")
    require(sparse_multiply(n0, d1, relation) == e, "E=N0D1")
    require(
        all(
            n0[row][quotient_row] == (one if row == column else zero)
            for row in range(215)
            for column, quotient_row in enumerate(quotient_rows)
        ),
        "N0 quotient identity and rank 215",
    )
    rank_d0 = 33
    declared_rank_e = int(block["rank_E"])
    require(rank_d0 == block["rank_D0"], "rank D0")
    require(0 <= declared_rank_e <= 89, "declared rank E range")
    rank_full = rank_d0 + declared_rank_e
    require(rank_full == block["rank_D"], "Schur rank identity")
    require(block["full_left_nullity"] == 248 - rank_full, "full left nullity")

    replay_cells: dict[tuple[int, int], Element] = {}
    for name, record in packet["inputs"].items():
        if not name.startswith("chunk_"):
            continue
        chunk = load(ROOT / record["path"])
        require(
            chunk["schema"]
            == "mtt.unified-source.g3am-selected-cayley-fiber2-response-chunk.v1"
            and chunk["status"]
            == "CLOSED_EXACT_SELECTED_CARRIER_FIBER2_RESIDUE_RECTANGLE"
            and all(chunk["checks"].values()),
            f"{name} schema, status and checks",
        )
        require(
            chunk["inputs"]["G3AP"] == reduction["certificate"]
            and chunk["inputs"]["G3AP_source"] == reduction["source_certificate"]
            and all(
                chunk["reduction_basis"].get(key) == value
                for key, value in reduction_scope.items()
            ),
            f"{name} canonical reduction scope",
        )
        for dependency in ("G3AL", "G3AP", "G3AP_source"):
            dependency_record = chunk["inputs"][dependency]
            dependency_path = ROOT / dependency_record["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency_record["sha256"],
                f"{name} dependency {dependency}",
            )
        if chunk["inputs"]["base_cache"] is not None:
            dependency_record = chunk["inputs"]["base_cache"]
            dependency_path = ROOT / dependency_record["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency_record["sha256"],
                f"{name} dependency base_cache",
            )
        if functional_route:
            dependency_record = chunk["inputs"]["quotient_functional"]
            dependency_path = ROOT / dependency_record["path"]
            require(
                chunk["inputs"]["module_cache"] is None
                and dependency_path.is_file()
                and sha256(dependency_path) == dependency_record["sha256"]
                and chunk["inputs"]["quotient_functional"]["sha256"]
                == reduction["quotient_functional_record"]["sha256"],
                f"{name} canonical quotient functional",
            )
        else:
            dependency_record = chunk["inputs"]["module_cache"]
            dependency_path = ROOT / dependency_record["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency_record["sha256"]
                and chunk["inputs"]["module_cache"]["sha256"]
                == reduction["module_cache_record"]["sha256"],
                f"{name} canonical module cache",
            )
        rectangle = chunk["rectangle"]
        require(
            int(rectangle["column_start_zero_based"]) == 33
            and int(rectangle["column_count"]) == 89,
            f"{name} extra rectangle",
        )
        output_path = ROOT / chunk["output"]["path"]
        script_path = ROOT / chunk["script"]["path"]
        require(output_path.is_file() and sha256(output_path) == chunk["output"]["sha256"], f"{name} output")
        require(script_path.is_file() and sha256(script_path) == chunk["script"]["sha256"], f"{name} script")
        script = script_path.read_text(encoding="ascii")
        require("ring r=(101,g)" in script and "ring r=11" not in script, f"{name} selected field")
        row_start = int(rectangle["row_start_zero_based"])
        row_count = int(rectangle["row_count"])
        expected_script = (
            chunk_builder.make_functional_script
            if functional_route
            else chunk_builder.make_script
        )(
            primitive_rows[row_start : row_start + row_count],
            [
                legacy.tangent_polynomial(vector, carrier_basis)
                for vector in tangent_columns[33:122]
            ],
            row_start,
            33,
            g3al_packet,
            reduction,
        )
        require(script == expected_script, f"{name} exact selected-script reconstruction")
        packed_rows = rectangle.get("entries_F1016_packed")
        output = None
        if functional_route:
            replayed, replayed_terms = chunk_builder.replay_functional_output(
                output_path, row_count, 89, reduction
            )
            require(
                replayed == packed_rows
                and replayed_terms == rectangle["exported_base_quotient_terms"],
                f"{name} functional transcript",
            )
        else:
            output = output_path.read_text(encoding="utf-8")
            require("G3AM_F2_RESPONSE_CHUNK_PASS" in output, f"{name} pass marker")
        for local_row, row in enumerate(rectangle["entries_F1016_singular"]):
            if functional_route:
                require(
                    [
                        chunk_builder.packed_to_singular(value)
                        for value in packed_rows[local_row]
                    ]
                    == row,
                    f"{name} packed functional row",
                )
            else:
                match = re.search(
                    rf"^G3AM_F2_RESPONSE_ROW_{row_start + local_row}=([^\r\n]*)$",
                    output,
                    flags=re.MULTILINE,
                )
                require(
                    match is not None and match.group(1).split(",") == row,
                    f"{name} raw row",
                )
            for column, value in enumerate(row):
                cell = (row_start + local_row, column)
                require(cell not in replay_cells, f"duplicate D1 cell {cell}")
                replay_cells[cell] = g3am_verify.field_value(value, relation)
    require(
        set(replay_cells) == {(row, column) for row in range(248) for column in range(89)},
        "full D1 chunk coverage",
    )
    require(
        d1 == [[replay_cells[(row, column)] for column in range(89)] for row in range(248)],
        "raw chunks equal D1",
    )

    if declared_rank_e == 89:
        l_operator = decode(raw, layout["L_extra_quotient"], "L")
        e0_inverse = decode(raw, layout["E0_inverse"], "E0 inverse")
        e_pivot_rows = [
            int(value)
            for value in block["extra_pivot_rows_in_principal_quotient_zero_based"]
        ]
        final_rows = [
            int(value)
            for value in block["final_normal_rows_in_principal_quotient_zero_based"]
        ]
        require(len(e_pivot_rows) == 89 and len(final_rows) == 126, "extra split")
        require(sorted(e_pivot_rows + final_rows) == list(range(215)), "extra partition")
        e0 = [e[row] for row in e_pivot_rows]
        require(
            multiply(e0_inverse, e0, relation)
            == [[one if row == column else zero for column in range(89)] for row in range(89)],
            "E0 inverse identity",
        )
        require((len(l_operator), len(l_operator[0])) == (126, 215), "L shape")
        require(sparse_multiply(l_operator, e, relation) == [[zero] * 89 for _ in range(126)], "LE=0")
        require(
            all(
                l_operator[row][final_row] == (one if row == column else zero)
                for row in range(126)
                for column, final_row in enumerate(final_rows)
            ),
            "L quotient identity and rank 126",
        )
        rank_e = 89
    else:
        require("L_extra_quotient" not in layout and "E0_inverse" not in layout, "no false full-rank normal")
        _, e_pivots = arithmetic.rref(e, relation, DEGREE)
        rank_e = len(e_pivots)
        require(rank_e == declared_rank_e, "rank-defect E replay")
    require(rank_full == rank_d0 + rank_e, "certified Schur rank")
    print(
        f"UST.G3AN selected full response: PASS rank(D0)=33 rank(E)={rank_e} "
        f"rank(D)={rank_full} left_nullity={248-rank_full}"
    )
    print("characteristic-zero transport and same-source beta_C remain open")


if __name__ == "__main__":
    main()
