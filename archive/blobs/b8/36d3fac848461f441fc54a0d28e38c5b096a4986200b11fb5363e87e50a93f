    g3dh = load(G3DH)
    require(all(g3dh["checks"].values()), "G3DH checks")
    require(tuple(g3dh["field"]["roots"]) == ROOTS, "G3DH roots")
    campaign = {int(row["gamma_root"]): row for row in g3dh["campaign"]}
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    compile_stdout = compile_tool()

    root_payloads: list[dict[str, Any]] = []
    matrices: list[sparse.csc_matrix] = []
    for index, root in enumerate(ROOTS, start=1):
        border = ROOT / campaign[root]["border_chart"]["path"]
        require(sha256(border) == campaign[root]["border_chart"]["sha256"], "border hash")
        kernel_path = EVIDENCE / f"H02.Q_kernel.p{PRIME}.g{root}.bin"
        log_path = EVIDENCE / f"H02.Q_kernel.p{PRIME}.g{root}.log"
        print(f"G3DI root {index}/6 gamma={root}: compiling kernel relations", flush=True)
        completed = subprocess.run(
            [
                "wsl",
                runtime.wsl_path(EXECUTABLE),
                "--chart",
                runtime.wsl_path(border),
                "--kernel",
                runtime.wsl_path(kernel_path),
                "--log",
                runtime.wsl_path(log_path),
                "--update-start",
                str(UPDATE_START),
                "--progress-seconds",
                "20",
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        require(completed.returncode == 0, completed.stdout + completed.stderr)
        fields = rank_runtime.initializer.parse_log(log_path)
        require(fields.get("STATUS") == "SUCCESS", "kernel-tool status")
        require(int(fields["RANK"]) == UPDATE_START + COUPLING_RANK, "border rank")
        require(int(fields["VERIFIED_RELATIONS"]) == KERNEL_DIMENSION, "verified relations")
        payload = read_kernel(kernel_path)
        matrix = payload["matrix"]
        require(
            payload["prime"] == PRIME
            and payload["ambient_rows"] == UPDATE_START + UPDATE_DIMENSION
            and payload["ambient_rank"] == UPDATE_START + COUPLING_RANK
            and payload["update_start"] == UPDATE_START,
            "kernel header",
        )
        require(matrix.shape == (UPDATE_DIMENSION, KERNEL_DIMENSION), "kernel shape")
        for column, dependent in enumerate(payload["dependent"]):
            first, past = matrix.indptr[column : column + 2]
            indices = matrix.indices[first:past]
            data = matrix.data[first:past]
            require(indices[-1] == dependent and data[-1] == 1, "unit dependent coordinate")
            require(np.all(indices[:-1] < dependent), "triangular relation")
        matrices.append(matrix)
        root_payloads.append(
            {
                "gamma_root": root,
                "border_chart": record(border),
                "kernel": record(kernel_path),
                "kernel_log": record(log_path),
                "kernel_nonzero_entries": int(matrix.nnz),
                "selected_update_columns": int(payload["selected"].size),
                "dependent_update_columns": int(payload["dependent"].size),
                "solver_stdout": completed.stdout.strip(),
            }
        )
        print(f"G3DI gamma={root}: kernel_nnz={matrix.nnz} verified=1274", flush=True)

    reference_selected = read_kernel(ROOT / root_payloads[0]["kernel"]["path"])["selected"]
    reference_dependent = read_kernel(ROOT / root_payloads[0]["kernel"]["path"])["dependent"]
    require(reference_selected.size == COUPLING_RANK, "selected count")
    require(reference_dependent.size == KERNEL_DIMENSION, "dependent count")
    for row in root_payloads[1:]:
        payload = read_kernel(ROOT / row["kernel"]["path"])
        require(np.array_equal(payload["selected"], reference_selected), "common selected columns")
        require(np.array_equal(payload["dependent"], reference_dependent), "common dependent columns")

    values = np.stack(
        [matrix.toarray().astype(np.uint16, copy=False) for matrix in matrices], axis=0
    )
    coefficients = interpolate(values)
    mismatches = sum(
        int(np.count_nonzero(evaluate(coefficients, root) != values[index]))
        for index, root in enumerate(ROOTS)
    )
    require(mismatches == 0, "kernel interpolation replay")
    power_basis_path = EVIDENCE / "H02.Q_kernel.p21817.power_basis.u16.npz"
    selection_path = EVIDENCE / "H02.Q_kernel.selection.npz"
    np.savez_compressed(power_basis_path, coefficients=coefficients)
    np.savez_compressed(
        selection_path,
        selected_update_columns=reference_selected,
        dependent_update_columns=reference_dependent,
    )
    del values, coefficients

    checks = {
        "G3DH_is_hash_bound_and_passing": True,
        "all_six_exact_border_relations_are_compiled_and_verified_entrywise": True,
        "every_kernel_has_shape6022_by1274_and_full_column_rank_by_unit_triangularity": True,
        "the_same4748_selected_and1274_dependent_columns_are_used_at_all_six_roots": True,
