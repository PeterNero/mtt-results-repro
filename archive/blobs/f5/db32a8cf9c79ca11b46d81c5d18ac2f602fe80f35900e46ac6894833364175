        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return kronecker(
            kronecker(identity_two, observable),
            identity_two,
        )

    def embed_fermion(
        observable: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return kronecker(
            kronecker(identity_two, identity_two),
            observable,
        )

