#!/usr/bin/env python3
"""Verify the selected-source Hilbert-candidate certification packet."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import certify_ust_g3ap_selected_cayley_fiber2_hilbert_candidate as cert
import run_ust_g3ap_selected_cayley_fiber2_hilbert_hedge as guided
from verify_ust_g3ap_selected_cayley_fiber2_module_top_dimension import verify_cache


ROOT = Path(__file__).resolve().parent
PACKET = cert.PACKET


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(packet["schema"] == "mtt.unified-source.g3ap-selected-cayley-fiber2-hilbert-certified-top.v1", "schema")
    require(packet["theorem_id"] == "UST.G3AP.FIBER2.HILBERT.CERTIFIED", "theorem id")
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    candidate_path = checked(packet["inputs"]["candidate"], "candidate packet")
    source_path = checked(packet["inputs"]["selected_source"], "selected source")
    script = checked(packet["execution"]["script"], "certification script")
    output = checked(packet["execution"]["output"], "certification output")
    cache = checked(packet["execution"]["certified_cache"], "certified cache")
    candidate = json.loads(candidate_path.read_text(encoding="ascii"))
    require(candidate["status"] == "CANDIDATE_REQUIRES_INDEPENDENT_SELECTED_SOURCE_CERTIFICATION", "candidate tier")
    require(candidate["inputs"]["selected_source"]["sha256"] == sha256(source_path), "same selected source")
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    _, hint = guided.load_hint()
    source = source_path.read_text(encoding="ascii")
    require(candidate_script.read_text(encoding="ascii") == guided.guided_script(source, hint), "guided provenance reconstruction")
    require(script.read_text(encoding="ascii") == cert.certification_script(source), "certification reconstruction")
    raw = output.read_text(encoding="utf-8")
    require(re.search(r"^G3AP_F2_HCERT_CANDIDATE_IS_SB_ATTR=0$", raw, re.MULTILINE) is not None, "candidate cache untrusted")
    require(re.search(r"^G3AP_F2_HCERT_ORIGINAL_GENERATORS=39$", raw, re.MULTILINE) is not None, "39 original generators")
    require(re.search(r"^G3AP_F2_HCERT_BAD_GENERATOR_REMAINDERS=0$", raw, re.MULTILINE) is not None, "generator equality")
    require("G3AP_F2_HCERT_PASS" in raw, "raw pass")
    leaders = cert.parse_leaders(raw)
    require(len(leaders) == packet["execution"]["certified_basis_size_through_bound"], "leader count")
    standards, sectors = fiber2.enumerate_target(leaders)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == 174865 and standards == [fiber2.EXPECTED_STANDARD], "exact target replay")
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    require(packet["ordinary_top_piece"]["dimension"] == 1 and packet["ordinary_top_piece"]["basis"] == ["w^12*t2^4*s^2"], "top line")
    cache_record = packet["execution"]["certified_cache"]
    require(cache.stat().st_size == cache_record["bytes"] > 0, "cache bytes")
    require(cache_record["valid_through_total_scalar_degree"] == 44 and cache_record["isSB_trust_attribute_stored"] is False, "cache scope")
    verify_cache(cache, len(leaders))
    print(
        "UST.G3AP.FIBER2.HILBERT.CERTIFIED verifier: PASS "
        f"leaders={len(leaders)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
