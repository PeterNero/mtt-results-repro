OUT = STATE / "ust_g3bb_selected_gamma_unit_defect_target.packet.json"

EXPECTED_HASHES = {
    "B87": "d6534e9c4c0e5e03060b5cc71468cdcc1a0628bbac632149cdba21d577fc0952",
    "selected_gamma": "ddf5ddc2a0733a2b1fe5c8bc2c8196e2b095e5af92184d68be9c2389ca130328",
    "gamma_product": "e7ddde7ba35193a3af572b306c20161b51e331a300cee78fa8bacacdfafd6b6b",
}
