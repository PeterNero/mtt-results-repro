for (i=1;i<=size(M);i++)
{{ if (reduce(M[i],G)!=0) {{ badGeneratorRemainders=badGeneratorRemainders+1; }} }}
print("G3AP_F2_WQHCERT_BOUND="+string(degBound));
print("G3AP_F2_WQHCERT_ORIGINAL_GENERATORS="+string(size(M)));
print("G3AP_F2_WQHCERT_BAD_GENERATOR_REMAINDERS="+string(badGeneratorRemainders));
print("G3AP_F2_WQHCERT_MODULE_GB_SIZE="+string(size(G)));
for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_WQHCERT_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_WQHCERT_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isSB",0);
write("ssi:w {module_relative}",G);
print("G3AP_F2_WQHCERT_PASS");
