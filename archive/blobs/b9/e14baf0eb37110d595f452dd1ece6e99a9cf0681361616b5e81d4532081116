    require(all(packet["checks"].values()), "full incremental G3AP checks")
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP full-source monotone rank-squeeze certification: PASS "
        f"rows=92979 witness_rows={incremental_campaign['selection']['selected_nonzero_source_rows']} "
        f"rank={TARGET_RANK} dimension=1 basis={packet['ordinary_top_piece']['basis'][0]}"
    )


if __name__ == "__main__":
    main()
