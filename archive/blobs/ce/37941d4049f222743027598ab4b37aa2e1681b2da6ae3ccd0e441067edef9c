    source_residual: Residual = (x, poly_add(y, poly_multiply(y, y)))
    source_cost = repair_cost(source_residual)

    variable_metric = poly_add(
        {(0, 0): Fraction(1)},
        poly_add(y, poly_multiply(y, y)),
