        "bounded_quotient_module_basis_reaches_the_conservative_base_degree_44": True,
        "all_174865_target_Cox_monomials_are_enumerated": True,
        "ordinary_top_piece_has_dimension_one": True,
        "selected_top_representative_is_w12_t2_4_s2": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-top.v1",
        "date": "2026-08-10",
        "theorem_id": "UST.G3AP.FIBER2.QRING",
        "status": "CLOSED_EXACT_SELECTED_F1016_FIBER2_QRING_TOP_DIMENSION_ONE",
        "inputs": {"selected_source": {"path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(SOURCE)}},
        "execution": {
            "script": {"path": str(SCRIPT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(SCRIPT)},
            "output": {"path": str(OUTPUT.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(OUTPUT)},
            "returncode": completed.returncode,
            "elapsed_seconds": time.time() - started,
            "base_basis_size": len(base),
            "module_generator_count": 21,
            "module_basis_size_through_bound": len(module),
            "scalar_degree_bound": 44,
            "base_cache": {"path": str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(BASE_CACHE), "bytes": BASE_CACHE.stat().st_size, "isSB_trust_attribute_stored": False},
            "bounded_module_cache": {"path": str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(MODULE_CACHE), "bytes": MODULE_CACHE.stat().st_size, "valid_through_base_scalar_degree": 44, "isSB_trust_attribute_stored": False},
        },
        "fiber_degree_two_module": {
            "base_ring_variables": ["x", "y", "z", "w", "t0", "t1", "t2"],
            "base_quotient": "B/(K,E,C)",
