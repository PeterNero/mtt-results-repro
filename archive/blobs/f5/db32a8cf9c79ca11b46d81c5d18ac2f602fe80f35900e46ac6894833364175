    }

    theorem_checks = {
        "auxiliary_fixed_coupling_first_tangent_bridge_is_closed": (
            all(source_checks.values())
            and all(exact_tangent_checks.values())
            and all(sp_qualification_checks.values())
            and all(first_tangent_bridge_checks.values())
        ),
