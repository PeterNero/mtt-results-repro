def q79_sm_gauge_compatible_finite_bv_regulator_criterion() -> dict[str, Any]:
    free_cstar = q79_sm_free_physical_cstar_reference_and_nonpromotion()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    sources = {row["id"]: row for row in manifest["sources"]}
    external_names = {
        row["name"] for row in manifest["external_theorems"]
    }

    def source_text(source_id: str) -> str:
        source_path = (ROOT / sources[source_id]["path"]).resolve()
        return source_path.read_text(encoding="utf-8")

    mld_path = (
        ROOT / sources["MLD_SHIFTED_COTANGENT_BV"]["path"]
    ).resolve()
    mld_seed = json.loads(mld_path.read_text(encoding="utf-8"))
    hym_text = source_text("SM_FINITE_PROJECTED_HYM_SOURCE")
    finite_dirac_text = source_text("SM_A49_PHYSICAL_FINITE_DIRAC")
    product_triple_text = source_text(
        "SM_A52_PRODUCT_TRIPLE_AND_CUTOFF_NOGO"
    )
    fluctuation_text = source_text("SM_A57_GAUGE_FIXED_COMPLEX")

    source_checks = {
        "prior_free_Cstar_and_nonpromotion_certificate_passes": (
            free_cstar["all_checks_pass"]
        ),
        "prior_formal_physical_state_certificate_passes": (
            free_cstar["source_checks"][
                "free_BRST_physical_state_certificate_passes"
            ]
        ),
        "prior_hyperbolic_BV_certificate_passes": (
            free_cstar["source_checks"][
                "gauge_fixed_free_complex_is_Green_hyperbolic"
            ]
        ),
        "finite_projected_HYM_source_is_hash_pinned": (
            "SM_FINITE_PROJECTED_HYM_SOURCE" in sources
        ),
        "finite_HYM_carrier_has_declared_dimension_twenty_seven": (
            "rank(A_N) = 27" in hym_text
            and "dim(H_N) = 27" in hym_text
        ),
        "finite_HYM_exactness_excludes_unprojected_continuum_claim": (
            "not because an unprojected continuum integral"
            in hym_text
        ),
        "finite_Dirac_operator_is_ninety_six_by_ninety_six": (
            "96x96" in finite_dirac_text
        ),
        "finite_Dirac_operator_is_explicitly_profile_tier": (
            "profile tier" in finite_dirac_text
        ),
        "A52_product_triple_does_not_derive_physical_spacetime": (
            "not an MTT derivation of Wick rotation or physical spacetime"
            in product_triple_text
        ),
        "A57_common_internal_spectrum_is_only_scale_translation": (
            "common finite spectrum"
            in fluctuation_text
            and "does not add a threshold shape"
            in fluctuation_text
        ),
        "MLD_finite_QME_seed_has_nonzero_differential": (
            mld_seed["finite_exact_certificate"]["commutative_DGA"][
                "differential"
            ]
            == "d x=eta, d 1=d eta=0"
        ),
        "MLD_finite_QME_seed_passes_every_declared_check": all(
            mld_seed["checks"].values()
        ),
        "MLD_finite_QME_residual_is_zero": (
            mld_seed["finite_measure_seed"]["QME_residual"] == 0
        ),
        "MLD_seed_excludes_physical_spacetime_discretization": (
            not mld_seed["guardrails"][
                "claims_finite_DGA_is_the_physical_spacetime_discretization"
            ]
        ),
    }

    theorem_dependency_checks = {
        "Bruning_Lesch_Hilbert_complexes_registered": (
            "Bruning-Lesch Hilbert complexes" in external_names
        ),
        "Cattaneo_Mnev_BV_pushforward_registered": (
            "Cattaneo-Mnev BV pushforward quasi-isomorphism"
            in external_names
        ),
        "Igarashi_Itoh_So_Wilsonian_QME_registered": (
            "Igarashi-Itoh-So Wilsonian QME" in external_names
        ),
        "Albert_boundary_heat_kernel_registered": (
            "Albert heat-kernel BV renormalization with boundary"
            in external_names
        ),
    }

    # The selected one-mode free gauge quartet is an exact Hodge complex.
    # Its zero eigenspace is the physical two-polarization cohomology.
    quartet_dimension = 6
    q0 = zeros(quartet_dimension, quartet_dimension)
    q0[4][2] = Fraction(1)
    q0[3][5] = Fraction(1)
    q0_adjoint = transpose(q0)
    quartet_laplacian = add(
        mul(q0, q0_adjoint),
        mul(q0_adjoint, q0),
    )
    physical_projector = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(0),
            Fraction(0),
            Fraction(0),
            Fraction(0),
        ]
    )
    reduced_green = quartet_laplacian
    quartet_homotopy = mul(q0_adjoint, reduced_green)

    quartet_hodge_checks = {
        "quartet_BRST_is_nilpotent": (
            mul(q0, q0) == zeros(quartet_dimension, quartet_dimension)
        ),
        "quartet_Hodge_laplacian_is_self_adjoint": (
            transpose(quartet_laplacian) == quartet_laplacian
        ),
        "quartet_Hodge_laplacian_is_diag_zero_zero_one_one_one_one": (
            quartet_laplacian
            == diagonal(
                [
                    Fraction(0),
                    Fraction(0),
                    Fraction(1),
                    Fraction(1),
                    Fraction(1),
                    Fraction(1),
                ]
            )
        ),
        "physical_projector_is_zero_spectral_projector": (
            physical_projector
            == sub(eye(quartet_dimension), quartet_laplacian)
        ),
        "physical_projector_commutes_with_BRST": (
            mul(physical_projector, q0)
            == mul(q0, physical_projector)
        ),
        "reduced_Green_is_inverse_on_positive_spectrum": (
            mul(quartet_laplacian, reduced_green)
            == sub(eye(quartet_dimension), physical_projector)
            and mul(reduced_green, quartet_laplacian)
            == sub(eye(quartet_dimension), physical_projector)
        ),
        "Hodge_homotopy_equals_prior_contracting_homotopy": (
            quartet_homotopy
            == [
                [Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
                [Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
                [Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(1), Fraction(0)],
                [Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
                [Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
                [Fraction(0), Fraction(0), Fraction(0), Fraction(1), Fraction(0), Fraction(0)],
            ]
        ),
        "Hodge_strong_deformation_retract_identity_is_exact": (
            add(
                mul(q0, quartet_homotopy),
                mul(quartet_homotopy, q0),
            )
            == sub(eye(quartet_dimension), physical_projector)
        ),
        "Hodge_homotopy_side_conditions_are_exact": (
            mul(quartet_homotopy, quartet_homotopy)
            == zeros(quartet_dimension, quartet_dimension)
            and mul(quartet_homotopy, physical_projector)
            == zeros(quartet_dimension, quartet_dimension)
            and mul(physical_projector, quartet_homotopy)
            == zeros(quartet_dimension, quartet_dimension)
        ),
        "physical_zero_spectrum_has_rank_two": (
            rank(physical_projector) == 2
        ),
    }

    def block_matrix(
        top_left: list[list[Fraction]],
        top_right: list[list[Fraction]],
        bottom_left: list[list[Fraction]],
        bottom_right: list[list[Fraction]],
    ) -> list[list[Fraction]]:
        return [
            *[
                top_left[row] + top_right[row]
                for row in range(len(top_left))
            ],
            *[
                bottom_left[row] + bottom_right[row]
                for row in range(len(bottom_left))
            ],
        ]

    zero_six = zeros(quartet_dimension, quartet_dimension)
    identity_six = eye(quartet_dimension)
    bv_symplectic_form = block_matrix(
        zero_six,
        identity_six,
        scale(Fraction(-1), identity_six),
        zero_six,
    )
    cotangent_q = block_matrix(
        q0,
        zero_six,
        zero_six,
        scale(Fraction(-1), q0_adjoint),
    )
    cotangent_projector = block_matrix(
        physical_projector,
        zero_six,
        zero_six,
        transpose(physical_projector),
    )
    cotangent_checks = {
        "cotangent_lift_is_nilpotent": (
            mul(cotangent_q, cotangent_q) == zeros(12, 12)
        ),
        "canonical_coefficient_symplectic_form_is_nondegenerate": (
            rank(bv_symplectic_form) == 12
        ),
        "cotangent_lift_preserves_BV_pairing": (
            add(
                mul(transpose(cotangent_q), bv_symplectic_form),
                mul(bv_symplectic_form, cotangent_q),
            )
            == zeros(12, 12)
        ),
        "cotangent_projector_is_idempotent": (
            mul(cotangent_projector, cotangent_projector)
            == cotangent_projector
        ),
        "cotangent_projector_commutes_with_cotangent_BRST": (
            mul(cotangent_projector, cotangent_q)
            == mul(cotangent_q, cotangent_projector)
        ),
        "cotangent_projector_is_BV_pairing_self_adjoint": (
            mul(transpose(cotangent_projector), bv_symplectic_form)
            == mul(bv_symplectic_form, cotangent_projector)
        ),
    }

    # Exact compact-resolvent model: two harmonic rows plus three
    # contractible eigenpairs with eigenvalues 1, 4 and 9.
    spectral_dimension = 8
    d_spectral = zeros(spectral_dimension, spectral_dimension)
    d_spectral[3][2] = Fraction(1)
    d_spectral[5][4] = Fraction(2)
    d_spectral[7][6] = Fraction(3)
    spectral_laplacian = add(
        mul(d_spectral, transpose(d_spectral)),
        mul(transpose(d_spectral), d_spectral),
    )
    spectral_values = [
        Fraction(0),
        Fraction(0),
        Fraction(1),
        Fraction(1),
        Fraction(4),
        Fraction(4),
        Fraction(9),
        Fraction(9),
    ]
    cutoff_projectors = {
        "0": diagonal(
            [Fraction(1), Fraction(1)]
            + [Fraction(0) for _ in range(6)]
        ),
        "1": diagonal(
            [Fraction(1) for _ in range(4)]
            + [Fraction(0) for _ in range(4)]
        ),
        "4": diagonal(
            [Fraction(1) for _ in range(6)]
            + [Fraction(0) for _ in range(2)]
        ),
        "9": eye(spectral_dimension),
    }
    cutoff_one = cutoff_projectors["1"]
    high_green = diagonal(
        [
            Fraction(0),
            Fraction(0),
            Fraction(0),
            Fraction(0),
            Fraction(1, 4),
            Fraction(1, 4),
            Fraction(1, 9),
            Fraction(1, 9),
        ]
    )
    high_homotopy = mul(transpose(d_spectral), high_green)
    cutoff_keys = ["0", "1", "4", "9"]
    nested_pairs = [
        (
            lower,
            upper,
            mul(cutoff_projectors[lower], cutoff_projectors[upper])
            == cutoff_projectors[lower],
        )
        for lower_index, lower in enumerate(cutoff_keys)
        for upper in cutoff_keys[lower_index:]
    ]
    spectral_family_checks = {
        "finite_model_differential_is_nilpotent": (
            mul(d_spectral, d_spectral)
            == zeros(spectral_dimension, spectral_dimension)
        ),
        "finite_model_Hodge_spectrum_is_exact": (
            spectral_laplacian == diagonal(spectral_values)
        ),
        "all_spectral_cutoffs_are_self_adjoint_idempotents": all(
            transpose(projector) == projector
            and mul(projector, projector) == projector
            for projector in cutoff_projectors.values()
        ),
        "all_spectral_cutoffs_commute_with_differential": all(
            mul(projector, d_spectral)
            == mul(d_spectral, projector)
            for projector in cutoff_projectors.values()
        ),
        "spectral_cutoffs_are_nested": all(
            result for _, _, result in nested_pairs
        ),
        "spectral_cutoff_ranks_are_two_four_six_eight": (
            [
                rank(cutoff_projectors[key])
                for key in cutoff_keys
            ]
            == [2, 4, 6, 8]
        ),
        "finite_spectral_family_exhausts_identity": (
            cutoff_projectors["9"] == eye(spectral_dimension)
        ),
        "high_spectrum_reduced_Green_is_exact": (
