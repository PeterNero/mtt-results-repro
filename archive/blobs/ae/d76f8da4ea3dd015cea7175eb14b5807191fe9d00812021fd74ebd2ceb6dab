from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
G3BJ = ROOT / "state" / "ust_g3bj_transcendental_arc_path.packet.json"
G3CN = ROOT / "state" / "ust_g3cn_pole_six_family_transform_first_jet.packet.json"
OUT = ROOT / "state" / "ust_g3co_pole_six_automatic_open_arc_exactness.packet.json"
TARGET_DEGREE = (9, 1, 3)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def local_record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def resolve_mld() -> Path:
    configured = os.environ.get("MTT_MLD_REPO")
    candidates = ([Path(configured)] if configured else []) + [
        ROOT.parent / "20 Mathematical Language Discovery Program",
        ROOT.parent / "Mathematical Language Discovery Program",
    ]
    for candidate in candidates:
        if (candidate / "q79_eta9_pole_six_membership_frontier.packet.json").is_file():
            return candidate.resolve()
    raise FileNotFoundError("Mathematical Language Discovery Program repository")


