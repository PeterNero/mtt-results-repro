@cache
def q79_binary_monodromy_reynolds_descent_corrected_symmetry_exit() -> dict[
    str, Any
]:
    prior = q79_support_stratified_spectral_strain_boundary_hessian()
    freshness = source_freshness()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    manifest_sources = {
        row["id"]: row for row in manifest["sources"]
    }
    freshness_sources = {
        row["id"]: row for row in freshness["sources"]
    }
    source_id = "SM_Q79_SIGNED_SHEET_SPIN_LIFT"
    source_path = (
        ROOT / manifest_sources[source_id]["path"]
    ).resolve()
    source_packet = json.loads(source_path.read_text(encoding="utf-8"))
    sheet_theorem = source_packet["q79_sheet_monodromy_theorem"]
    binary_theorem = source_packet["binary_spin_theorem"]
    interpretation = source_packet["interpretation"]

    permutation_tuples = tuple(permutations(range(3)))
    sheet_actions = [
        permutation_matrix(permutation)
        for permutation in permutation_tuples
    ]
    strain_actions = two_copy_s3_representations()
    identity3 = eye(3)
    identity6 = eye(6)
    zero6 = zeros(6, 6)

    deck_centralizer = [
        permutation_tuples[index]
        for index, candidate in enumerate(sheet_actions)
        if all(
            mul(candidate, holonomy) == mul(holonomy, candidate)
            for holonomy in sheet_actions
        )
    ]

    reynolds_s3 = reynolds_two_copy_s3()
    reynolds_dic3_sum = zero6
    lifted_strain_actions = []
    for action in strain_actions:
        # The exact sequence has the two-point fiber {g,-g} over each
        # sigma.  Its central element acts trivially after Spin(3)->SO(3)
        # and on the quadratic strain shadow, so both lifts have this action.
        lifted_strain_actions.extend((action, action))
        reynolds_dic3_sum = add(
            reynolds_dic3_sum,
            add(action, action),
        )
    reynolds_dic3 = scale(Fraction(1, 12), reynolds_dic3_sum)
    tt_projector = sub(identity6, reynolds_s3)
    lane_quarterturn = jde()
    lane_quarterturn_squared = mul(
        lane_quarterturn,
        lane_quarterturn,
    )
    lane_quarterturn_fourth = mul(
        lane_quarterturn_squared,
        lane_quarterturn_squared,
    )

    generic_vector = [Fraction(2), Fraction(3), Fraction(5)]

    def permutation_parity(permutation: tuple[int, ...]) -> int:
        inversions = sum(
            int(permutation[left] > permutation[right])
            for left in range(len(permutation))
            for right in range(left + 1, len(permutation))
        )
        return -1 if inversions % 2 else 1

    def apply_matrix(
        matrix: list[list[Fraction]], vector: list[Fraction]
    ) -> list[Fraction]:
        return [
            sum(
                (
                    entry * vector[column]
                    for column, entry in enumerate(row)
                ),
                Fraction(0),
            )
            for row in matrix
        ]

    sign_cancellation_checks = {}
    for permutation, action in zip(
        permutation_tuples,
        sheet_actions,
        strict=True,
    ):
        sign = Fraction(permutation_parity(permutation))
        signed_image = [
            sign * value
            for value in apply_matrix(action, generic_vector)
        ]
        squared_signed_image = [value**2 for value in signed_image]
        permuted_squares = apply_matrix(
            action,
            [value**2 for value in generic_vector],
        )
        key = "".join(str(value) for value in permutation)
        sign_cancellation_checks[
            f"signed_sheet_quadratic_shadow_descends_{key}"
        ] = squared_signed_image == permuted_squares

    monodromy_checks = {
        "selected_q79_cover_has_degree_three": (
            sheet_theorem["degree"] == 3
        ),
        "selected_q79_cover_is_connected": (
            sheet_theorem["spectral_surface_connected"]
        ),
        "selected_q79_monodromy_is_full_S3": (
            sheet_theorem["proved"]
            and sheet_theorem["monodromy_group"] == "S3"
        ),
        "full_S3_natural_sheet_action_has_trivial_centralizer": (
            deck_centralizer == [(0, 1, 2)]
        ),
        "connected_nonGalois_degree_three_cover_has_no_nontrivial_deck_S3_action": (
            len(deck_centralizer) == 1
        ),
        "all_signed_sheet_quadratic_shadows_descend": all(
            sign_cancellation_checks.values()
        ),
    }
    binary_descent_checks = {
        "upstream_binary_extension_checks_pass": all(
            binary_theorem["checks"].values()
        ),
        "upstream_binary_group_has_order_twelve": (
            binary_theorem["generated_group_order"] == 12
