def preparation_selection_nogo() -> dict[str, Any]:
    representations = two_copy_s3_representations()
    p = reynolds_two_copy_s3()
    q = sub(eye(6), p)
    j = jde()
    jp = mul(j, p)

    def to_gaussian(a: list[list[Fraction]]) -> list[list[tuple[Fraction, Fraction]]]:
        return [[(value, Fraction(0)) for value in row] for row in a]

    def kernel_polarization(sign: int) -> list[list[tuple[Fraction, Fraction]]]:
        return [
            [
                (p[r][c] / 2, Fraction(sign) * jp[r][c] / 2)
                for c in range(6)
            ]
            for r in range(6)
        ]

    k_plus = kernel_polarization(-1)
    k_minus = kernel_polarization(1)
    q_g = to_gaussian(q)
    zero_g = [[(Fraction(0), Fraction(0)) for _ in range(6)] for _ in range(6)]
    trace_plus = sum((k_plus[i][i][0] for i in range(6)), Fraction(0)), sum(
        (k_plus[i][i][1] for i in range(6)), Fraction(0)
    )
    trace_minus = sum((k_minus[i][i][0] for i in range(6)), Fraction(0)), sum(
        (k_minus[i][i][1] for i in range(6)), Fraction(0)
    )
    checks = {
