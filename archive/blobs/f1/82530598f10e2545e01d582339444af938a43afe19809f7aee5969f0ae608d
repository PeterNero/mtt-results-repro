P = 101
F3 = tuple[int, int, int]
K = tuple[int, int, int, int, int, int]
ZERO3: F3 = (0, 0, 0)
ONE3: F3 = (1, 0, 0)
ZERO: K = (0, 0, 0, 0, 0, 0)
ONE: K = (1, 0, 0, 0, 0, 0)


def require(condition: bool, label: str) -> None:
