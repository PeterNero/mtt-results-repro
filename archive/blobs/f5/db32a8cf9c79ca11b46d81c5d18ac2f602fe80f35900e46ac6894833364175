def canonical_q79_minimal_recorder_action() -> dict[str, Any]:
    p = reynolds_two_copy_s3()
    q = sub(eye(6), p)
    z = sub(p, q)

    def kron(
        left: list[list[Fraction]], right: list[list[Fraction]]
    ) -> list[list[Fraction]]:
        return [
            [
                left[left_row][left_column] * right[right_row][right_column]
                for left_column in range(len(left[0]))
                for right_column in range(len(right[0]))
            ]
            for left_row in range(len(left))
            for right_row in range(len(right))
        ]

    def inject_pointer(pointer_index: int, pointer_dimension: int) -> list[list[Fraction]]:
        return [
            [
                Fraction(1)
                if row == column * pointer_dimension + pointer_index
                else Fraction(0)
                for column in range(6)
            ]
            for row in range(6 * pointer_dimension)
        ]

    two_pointer_rotation = [
        [Fraction(0), Fraction(-1)],
        [Fraction(1), Fraction(0)],
    ]
    two_state_generator = kron(q, two_pointer_rotation)
    two_ready = inject_pointer(0, 2)
    two_loss = inject_pointer(1, 2)
    two_generator_on_ready = mul(two_state_generator, two_ready)

    two_cosine = Fraction(7, 25)
    two_sine = Fraction(24, 25)
    two_no_record = add(p, scale(two_cosine, q))
    two_defect_record = scale(two_sine, q)
    two_effect_no_record = mul(transpose(two_no_record), two_no_record)
    two_effect_defect = mul(
        transpose(two_defect_record), two_defect_record
    )

    ready_to_p = [
        [Fraction(0), Fraction(-1), Fraction(0)],
        [Fraction(1), Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(0), Fraction(0)],
    ]
    ready_to_q = [
        [Fraction(0), Fraction(0), Fraction(-1)],
        [Fraction(0), Fraction(0), Fraction(0)],
        [Fraction(1), Fraction(0), Fraction(0)],
    ]
    capture_generator = add(kron(p, ready_to_p), kron(q, ready_to_q))
    capture_ready = inject_pointer(0, 3)
    capture_p = inject_pointer(1, 3)
    capture_q = inject_pointer(2, 3)
    capture_generator_on_ready = mul(capture_generator, capture_ready)
    expected_capture_direction = add(mul(capture_p, p), mul(capture_q, q))
    capture_generator_squared_on_ready = mul(
        mul(capture_generator, capture_generator), capture_ready
    )

    capture_cosine = Fraction(4, 5)
    capture_sine = Fraction(3, 5)
    attenuation = capture_cosine * capture_cosine
    no_record = scale(capture_cosine, eye(6))
    p_record = scale(capture_sine, p)
    q_record = scale(capture_sine, q)
    no_record_effect = mul(transpose(no_record), no_record)
    p_record_effect = mul(transpose(p_record), p_record)
    q_record_effect = mul(transpose(q_record), q_record)

    probe = [
        [Fraction(2 * (row + 1) + 3 * (column + 1), 41) for column in range(6)]
        for row in range(6)
    ]
    diagonal_blocks = add(mul(mul(p, probe), p), mul(mul(q, probe), q))
    cross_blocks = add(mul(mul(p, probe), q), mul(mul(q, probe), p))
    one_step_channel = add(
        scale(attenuation, probe),
        scale(1 - attenuation, diagonal_blocks),
    )
    expected_one_step_channel = add(
        diagonal_blocks, scale(attenuation, cross_blocks)
    )

    number_of_steps = 3
    grid_attenuation = attenuation**number_of_steps
    iterated_channel = probe
    for _ in range(number_of_steps):
        iterated_diagonal = add(
            mul(mul(p, iterated_channel), p),
            mul(mul(q, iterated_channel), q),
        )
        iterated_channel = add(
            scale(attenuation, iterated_channel),
            scale(1 - attenuation, iterated_diagonal),
        )
    expected_grid_channel = add(
        diagonal_blocks, scale(grid_attenuation, cross_blocks)
    )

    cumulative_no_record_effect = scale(grid_attenuation, eye(6))
    cumulative_p_record_effect = scale(1 - grid_attenuation, p)
    cumulative_q_record_effect = scale(1 - grid_attenuation, q)
    cumulative_effect_sum = add(
        cumulative_no_record_effect,
        add(cumulative_p_record_effect, cumulative_q_record_effect),
    )

