    require(all(packet["checks"].values()), "G3BJ checks")
    require(not any(packet["guardrails"].values()), "G3BJ guardrails")
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3BJ transcendental discriminant-avoiding path: PASS")


if __name__ == "__main__":
    main()
