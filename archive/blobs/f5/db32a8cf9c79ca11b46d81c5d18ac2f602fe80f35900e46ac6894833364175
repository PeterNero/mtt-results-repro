    def weighted_adjoint(
        matrix: list[list[Fraction]],
        weights: list[Fraction],
    ) -> list[list[Fraction]]:
        size = len(matrix)
        return [
            [
                matrix[column][row]
                * weights[column]
                / weights[row]
                for column in range(size)
            ]
            for row in range(size)
        ]

    def matrix_hash(matrix: list[list[Fraction]]) -> str:
        encoded = json.dumps(
            fraction_matrix_strings(matrix),
            separators=(",", ":"),
        ).encode("ascii")
