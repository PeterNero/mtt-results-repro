#!/usr/bin/env python3
"""Independently verify the exact G3AP fiber-two qslimgb result."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import run_ust_g3ap_selected_cayley_fiber2_qslimgb_hedge as qslim
from verify_ust_g3ap_selected_cayley_fiber2_qring_top_dimension import (
    verify_quotient_caches,
)


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ap_selected_cayley_fiber2_qslimgb.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qslimgb-top.v1",
        "schema",
    )
    require(packet["theorem_id"] == "UST.G3AP.FIBER2.QSLIMGB", "theorem id")
    require(all(packet["checks"].values()), "all checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")

    source = checked(packet["inputs"]["selected_source"], "selected source")
    base_cache = checked(packet["inputs"]["base_cache"], "base cache")
    script = checked(packet["execution"]["script"], "qslimgb script")
    output = checked(packet["execution"]["output"], "qslimgb output")
    module_cache = checked(
        packet["execution"]["bounded_module_cache"], "qslimgb module cache"
    )

    source_text = source.read_text(encoding="ascii")
    script_text = script.read_text(encoding="ascii")
    require(script_text == qslim.qslimgb_script(source_text), "exact script reconstruction")
    require('def cachedBase=read("ssi:r ' in script_text, "selected cached base")
    require("qring q=GI;" in script_text, "base quotient ring")
    require("module G=qslimgb(M);" in script_text, "qslimgb quotient module basis")
    require("degBound=44;" in script_text, "degree bound")
    require('attrib(G,"isSB",0);' in script_text, "module trust cleared")
    for generator in qring.derivative_generators():
        require(generator in script_text, f"quotient module generator {generator}")

    raw = output.read_text(encoding="utf-8")
    require("G3AP_F2_QSLIM_BOUND=44" in raw, "raw degree bound")
    require("G3AP_F2_QSLIM_MODULE_GENERATORS=21" in raw, "raw generator count")
    require("G3AP_F2_QSLIM_LEADER_EXPORT_PASS" in raw, "raw pass")
    base, module = qslim.parse_bases(raw)
    require(len(base) == packet["execution"]["base_basis_size"], "base leader count")
    require(
        len(module) == packet["execution"]["module_basis_size_through_bound"],
        "module leader count",
    )
    weights = (1, 1, 1, 3, 1, 1, 1)
    require(
        all(
            sum(weight * power for weight, power in zip(weights, exponent)) <= 44
            for _, exponent in module
        ),
        "module leaders lie through degree 44",
    )
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL == 174865, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "unique top standard")
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    require(
        packet["ordinary_top_piece"]["basis"] == ["w^12*t2^4*s^2"]
        and packet["ordinary_top_piece"]["dimension"] == 1,
        "top line",
    )
    require(base_cache.stat().st_size == packet["inputs"]["base_cache"]["bytes"], "base bytes")
    require(
        packet["inputs"]["base_cache"]["isSB_trust_attribute_stored"] is False,
        "base cache trust scope",
    )
    module_record = packet["execution"]["bounded_module_cache"]
    require(module_cache.stat().st_size == module_record["bytes"] > 0, "module bytes")
    require(
        module_record["valid_through_base_scalar_degree"] == 44
        and module_record["isSB_trust_attribute_stored"] is False,
        "module cache scope",
    )

    # This deliberately uses ordinary std, not qslimgb, as the independent
    # reconstruction algorithm for both the ideal and quotient module.
    verify_quotient_caches(
        source_text,
        base_cache,
        module_cache,
        len(base),
        len(module),
    )
    print(
        "UST.G3AP.FIBER2.QSLIMGB selected ordinary top: PASS "
        f"base={len(base)} module={len(module)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
