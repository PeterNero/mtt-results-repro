import verify_ust_g3ap_selected_cayley_target_macaulay_full_reused as source_verifier


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
LOWER_VERIFIER = ROOT / "verify_ust_g3ap_selected_cayley_ordinary_top_lower_bound.py"
PACKET = (
    STATE
    / "ust_g3ap_selected_cayley_target_macaulay_full_reused.certified.packet.json"
)
TARGET_RANK = macaulay.EXPECTED_TARGET_COORDINATES - 1


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def relative(path: Path) -> str:
    return str(path.relative_to(ROOT)).replace("\\", "/")


def record(path: Path) -> dict[str, object]:
    return {
        "path": relative(path),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def checked(item: dict[str, object], label: str) -> Path:
    path = ROOT / str(item["path"])
    require(
        path.is_file()
        and sha256(path) == item["sha256"]
        and path.stat().st_size == item.get("bytes", path.stat().st_size),
        label,
    )
    return path


def monomial_label(component: int, exponent: tuple[int, ...]) -> str:
    factors = []
    for name, power in zip(("x", "y", "z", "w", "t0", "t1", "t2"), exponent):
        if power == 1:
            factors.append(name)
        elif power > 1:
            factors.append(f"{name}^{power}")
    factors.append(("u^2", "u*v", "u*s", "v^2", "v*s", "s^2")[component - 1])
    return "*".join(factors)


def run_prerequisite_verifiers(timeout: int, reuse: bool) -> None:
    subprocess.run([sys.executable, str(LOWER_VERIFIER)], cwd=ROOT, check=True)
    subprocess.run(
        [
            sys.executable,
            str(ROOT / base_certifier.__file__),
            "--timeout",
            str(timeout),
            "--reuse-output",
        ],
        cwd=ROOT,
        check=True,
    )
    if not reuse:
        subprocess.run(
            [sys.executable, str(ROOT / source_verifier.__file__)],
            cwd=ROOT,
            check=True,
        )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--reuse-source-certificate", action="store_true")
    args = parser.parse_args()
    run_prerequisite_verifiers(args.timeout, args.reuse_source_certificate)

    lower_packet = json.loads(lower.OUT.read_text(encoding="ascii"))
    require(
        lower_packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_AT_LEAST_ONE"
        and all(lower_packet["checks"].values())
        and not any(lower_packet["guardrails"].values()),
        "selected ordinary-top lower bound",
    )
    base_packet = json.loads(base_certifier.PACKET.read_text(encoding="ascii"))
    require(
        base_packet["schema"].endswith("base-certified.v1")
        and base_packet["status"]
        == "CLOSED_EXACT_SELECTED_BASE_IDEAL_AND_LEADING_IDEAL_EQUALITY"
        and all(base_packet["checks"].values())
        and not any(base_packet["guardrails"].values()),
        "selected base certificate",
    )
    source_packet = json.loads(source_verifier.OUT.read_text(encoding="ascii"))
    require(
        source_packet["schema"].endswith("full-source-certified.v1")
        and source_packet["status"]
        == "CLOSED_EXACT_FULL_92979_ROW_SELECTED_MACAULAY_SOURCE_PROVENANCE_NOT_RANK"
        and all(source_packet["checks"].values())
        and not any(source_packet["guardrails"].values()),
        "full-source certificate",
    )
    rank_packet = json.loads(rank_runner.PACKET.read_text(encoding="ascii"))
    require(
        rank_packet["schema"].endswith("full-rank-candidate.v1")
        and all(rank_packet["checks"].values())
        and not any(rank_packet["guardrails"].values()),
        "full-source rank candidate",
    )

    base_source = checked(base_packet["inputs"]["selected_source"], "base source")
    source_source = checked(source_packet["inputs"]["selected_source"], "source source")
    source_matrix = checked(source_packet["inputs"]["full_matrix"], "source matrix")
    rank_matrix = checked(rank_packet["inputs"]["campaign_matrix"], "rank matrix")
    require(
        base_source == source_source == macaulay.SOURCE
        and source_matrix == rank_matrix == rank_runner.FULL_MATRIX,
        "same selected source and matrix",
    )
    checked(base_packet["execution"]["certified_cache"], "certified base cache")
    checked(rank_packet["inputs"]["native_tools_build"], "native tools build")
    campaign_path = checked(rank_packet["inputs"]["campaign"], "rank campaign")
    campaign = json.loads(campaign_path.read_text(encoding="ascii"))
    require(
        campaign["matrix"]["sha256"] == sha256(rank_matrix)
        and campaign["matrix"]["rows"] == source_packet["matrix"]["rows"] == 92979
        and campaign["matrix"]["columns"]
        == source_packet["matrix"]["columns"]
        == macaulay.EXPECTED_TARGET_COORDINATES
        and campaign["matrix"]["nonzeros"] == source_packet["matrix"]["nonzeros"],
        "source/rank campaign identity",
    )

    extraction_path = checked(
        rank_packet["inputs"]["minor_extraction"], "minor extraction"
    )
    selected_minor = checked(rank_packet["inputs"]["selected_minor"], "selected minor")
    extraction = json.loads(extraction_path.read_text(encoding="ascii"))
    require(
        selected_minor == ROOT / extraction["minor"]["path"]
        and extraction["minor"]["size"] == TARGET_RANK,
        "extracted full-source minor",
    )
    custom_engine = rank_packet["engines"]["custom_sparse_column_elimination"]
    custom_output = checked(custom_engine["output"], "custom rank output")
    checked(custom_engine["source"], "custom rank source")
    checked(custom_engine["binary"], "custom rank binary")
    checked(custom_engine["log"], "custom rank log")
    for index, dependency in enumerate(custom_engine["source_dependencies"]):
        checked(dependency, f"custom rank dependency {index}")
    scalars, vectors = minor.parse_output(custom_output)
    functional = vectors["QUOTIENT_FUNCTIONAL_PACKED"]
    require(
        scalars["STATUS"] == "EXACT_F1016_NONZERO_MINOR_FOUND"
        and int(scalars["SOURCE_ROWS"]) == 92979
        and int(scalars["TARGET_COORDINATES"])
        == macaulay.EXPECTED_TARGET_COORDINATES
        and int(scalars["MINOR_SIZE"]) == TARGET_RANK
        and int(scalars["QUOTIENT_FUNCTIONAL_VERIFIED_SOURCE_ROWS"]) == 92979
        and minor.determinant(
            vectors["PIVOT_TARGET_COORDINATES_ZERO_BASED"],
            vectors["PIVOT_COEFFICIENTS_PACKED"],
        )
        == int(scalars["MINOR_DETERMINANT_PACKED"])
        != 0,
        "custom exact rank transcript",
    )

    linbox_engine = rank_packet["engines"]["linbox_givaro_sparse_elimination"]
    linbox_output = checked(linbox_engine["output"], "LinBox rank output")
    checked(linbox_engine["source"], "LinBox source")
    checked(linbox_engine["binary"], "LinBox binary")
    linbox_shape = shared_runner.parse_linbox(
        linbox_output.read_text(encoding="utf-8")
    )
    require(
        linbox_shape[0] == linbox_shape[1] == linbox_shape[3] == TARGET_RANK
        and linbox_shape[2] == extraction["minor"]["nonzeros"],
        "independent exact minor rank",
    )
    functional_engine = rank_packet["engines"][
        "givaro_full_matrix_functional_replay"
    ]
    functional_artifact = checked(functional_engine["functional"], "functional")
    functional_output = checked(
        functional_engine["output"], "functional replay output"
    )
    checked(functional_engine["source"], "functional replay source")
    checked(functional_engine["binary"], "functional replay binary")
    functional_shape = shared_runner.parse_functional_replay(
        functional_output.read_text(encoding="utf-8")
    )
    require(
        functional_shape[:4]
        == (
            92979,
            macaulay.EXPECTED_TARGET_COORDINATES,
            campaign["matrix"]["nonzeros"],
            92979,
        ),
        "independent full-source functional replay",
    )
    for name, item in rank_packet["field_self_test"].items():
        if isinstance(item, dict) and "path" in item:
            checked(item, f"field self-test {name}")
    require(rank_packet["field_self_test"]["exact_rank"] == 1, "field self-test rank")

    base_coordinate_path = checked(
        source_packet["inputs"]["base_coordinate_packet"], "base coordinates"
    )
    base_coordinates = json.loads(base_coordinate_path.read_text(encoding="ascii"))
    leaders = [
        tuple(int(value) for value in item)
        for item in base_coordinates["base_leading_exponents"]
    ]
    targets, _ = macaulay.coordinate_data(leaders)
    normalization = int(
        scalars["QUOTIENT_NORMALIZATION_TARGET_COORDINATE_ZERO_BASED"]
    )
    require(
        len(functional) == len(targets) == macaulay.EXPECTED_TARGET_COORDINATES
        and functional[normalization] == 1,
        "normalized quotient functional",
    )
    component, exponent = targets[normalization]
    functional_hash = hashlib.sha256(
        json.dumps(functional, separators=(",", ":")).encode("ascii")
    ).hexdigest()
    require(
        functional_hash
        == extraction["minor"]["quotient_functional"]["packed_coefficients_sha256"],
        "quotient functional identity",
    )

    packet: dict[str, object] = {
        "schema": (
            "mtt.unified-source.g3ap-selected-cayley-target-macaulay-"
            "full-certified.v1"
        ),
        "date": "2026-08-11",
        "theorem_id": "UST.G3AP.FULL-SOURCE-MACAULAY-RANK-SQUEEZE",
        "status": (
            "CLOSED_EXACT_SELECTED_F1016_FULL_SOURCE_ORDINARY_TOP_DIMENSION_ONE"
        ),
        "inputs": {
            "selected_ordinary_top_lower_bound": record(lower.OUT),
            "selected_base_certificate": record(base_certifier.PACKET),
            "full_source_certificate": record(source_verifier.OUT),
            "full_rank_candidate": record(rank_runner.PACKET),
            "selected_source": record(macaulay.SOURCE),
            "base_coordinate_packet": record(base_coordinate_path),
        },
        "base_quotient": {
            "ideal": "(K,E,C)",
            "cached_generators": base_packet["execution"]["cached_generators"],
            "cached_ideal_equals_selected_ideal": True,
            "cached_and_recomputed_leading_ideals_are_equal": True,
            "certified_cache": base_packet["execution"]["certified_cache"],
            "cache": base_packet["execution"]["certified_cache"],
        },
        "target_relation_map": {
            "Cox_degree": [18, 2, 2],
            "coordinates": macaulay.EXPECTED_TARGET_COORDINATES,
            "selected_relation_rows": 92979,
            "selected_relation_nonzeros": campaign["matrix"]["nonzeros"],
            "source_order": source_packet["matrix"]["source_order"],
            "source_order_is_a_permutation_of_the_full_selected_map": True,
            "exact_rank": TARGET_RANK,
            "codimension_upper_bound": 1,
            "custom_nonzero_minor_determinant_packed": int(
                scalars["MINOR_DETERMINANT_PACKED"]
            ),
            "independent_linbox_minor_rank": TARGET_RANK,
        },
        "quotient_functional": {
            "coefficient_encoding": "sum_i coefficient_i*101^i in 1,g,...,g^5",
            "packed_coefficients_sha256": functional_hash,
            "packed_coefficients": functional,
            "normalization_target_coordinate_zero_based": normalization,
            "normalization_component": component,
            "normalization_base_exponent": list(exponent),
            "normalization_basis": monomial_label(component, exponent),
            "normalization_value_packed": 1,
            "annihilates_all_92979_selected_relation_rows": True,
            "annihilates_every_campaign_relation_row": True,
            "artifact": record(functional_artifact),
            "independent_givaro_replay": record(functional_output),
        },
        "ordinary_top_piece": {
            "Cox_degree": [18, 2, 2],
            "Cox_monomials_enumerated": fiber2.EXPECTED_TOTAL,
            "base_quotient_target_coordinates": len(targets),
            "upper_bound_dimension": 1,
            "lower_bound_dimension": 1,
            "dimension": 1,
            "basis": [monomial_label(component, exponent)],
            "basis_component": component,
            "basis_base_exponent": list(exponent),
        },
        "checks": {
            "the_cached_base_ideal_is_exactly_the_selected_K_E_C_ideal": True,
            "the_cached_and_recomputed_leading_monomial_ideals_are_equal": True,
            "all_92979_rows_have_independently_replayed_selected_source_provenance": True,
            "the_full_source_order_is_an_exact_permutation_of_all_selected_relation_multiples": True,
            "the_custom_engine_emits_a_nonzero_rank39725_minor": True,
            "the_custom_pivot_determinant_is_independently_recomputed": True,
            "independent_LinBox_Givaro_elimination_finds_minor_rank39725": True,
            "the_unique_normalized_quotient_functional_annihilates_all_92979_rows": True,
            "independent_Givaro_arithmetic_replays_the_functional_on_all_92979_rows": True,
            "the_full_selected_relation_span_gives_target_dimension_at_most_one": True,
            "the_independent_selected_R1_theorem_gives_target_dimension_at_least_one": True,
            "the_selected_ordinary_top_piece_has_dimension_exactly_one": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
        "guardrails": {
            "claims_a_full_unrestricted_standard_basis": False,
            "claims_characteristic_zero_promotion": False,
            "claims_response_rank_or_beta_C_is_computed": False,
            "claims_the_q79_Hull_Strominger_endpoint": False,
        },
        "theorem": {
            "name": (
                "selectedCayleyOrdinaryTopDimensionByFullSourceExactTargetMacaulay"
                "RankSqueezeTheorem"
            ),
            "tier": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_ONE",
            "statement": (
                "For the selected F_101^6 Cayley member, the exact full 92,979-row "
                "selected-source target Macaulay map has rank 39,725 in a "
                "39,726-coordinate presentation. The independently selected toric "
                "R1 theorem gives the matching lower bound, so the ordinary top "
                "quotient in Cox degree (18,2,2) is one-dimensional; the emitted "
                "normalized dual functional is its exact finite reduction map."
            ),
        },
        "next_required_object": (
            "Adopt this full-source quotient functional as canonical G3AP and "
            "execute the same-carrier G3AM principal-response rank."
        ),
    }
    require(all(packet["checks"].values()), "full G3AP certification checks")
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP full-source target Macaulay rank-squeeze certification: PASS "
        f"rows=92979 coordinates={len(targets)} rank={TARGET_RANK} dimension=1 "
        f"basis={packet['ordinary_top_piece']['basis'][0]}"
    )


if __name__ == "__main__":
    main()
