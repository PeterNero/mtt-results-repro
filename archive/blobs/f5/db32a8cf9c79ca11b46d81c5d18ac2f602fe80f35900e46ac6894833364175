    def block_diagonal(
        blocks: list[list[list[Fraction]]],
    ) -> list[list[Fraction]]:
        row_count = sum(len(block) for block in blocks)
        column_count = sum(len(block[0]) for block in blocks)
        output = zeros(row_count, column_count)
        row_offset = 0
        column_offset = 0
        for block in blocks:
            for row, values in enumerate(block):
                for column, value in enumerate(values):
                    output[row_offset + row][
                        column_offset + column
                    ] = value
            row_offset += len(block)
            column_offset += len(block[0])
        return output

    def determinant(matrix: list[list[Fraction]]) -> Fraction:
        work = [row[:] for row in matrix]
        value = Fraction(1)
        for column in range(len(work)):
            pivot_row = next(
                (
                    row
                    for row in range(column, len(work))
                    if work[row][column] != 0
                ),
                None,
            )
            if pivot_row is None:
                return Fraction(0)
            if pivot_row != column:
                work[column], work[pivot_row] = (
                    work[pivot_row],
                    work[column],
                )
                value *= -1
            pivot = work[column][column]
            value *= pivot
            for row in range(column + 1, len(work)):
                factor = work[row][column] / pivot
                for entry in range(column, len(work)):
                    work[row][entry] -= factor * work[column][entry]
        return value

