def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def rational(record: dict[str, int]) -> sp.Rational:
    return sp.Rational(record["numerator"], record["denominator"])


def polynomial_from_low_coefficients(
    coefficients: list[int],
    variable: sp.Symbol,
) -> sp.Poly:
    return sp.Poly(
        sum(
            int(coefficient) * variable**index
            for index, coefficient in enumerate(coefficients)
        ),
        variable,
        domain=sp.ZZ,
    )


def sign_at(poly: sp.Poly, point) -> int:
    if point == sp.oo:
        return 1 if poly.LC() > 0 else -1
    if point == -sp.oo:
        sign = 1 if poly.LC() > 0 else -1
        return sign if poly.degree() % 2 == 0 else -sign
    value = poly.eval(point)
    require(value != 0, "Sturm endpoint is not a root")
    return 1 if value > 0 else -1


def sign_variations(signs: list[int]) -> int:
    return sum(
        left != right
        for left, right in zip(signs, signs[1:], strict=False)
    )


def independent_sturm_count(poly: sp.Poly, left, right) -> int:
    sequence = [
        sp.Poly(item, poly.gens[0], domain=sp.QQ)
        for item in sp.sturm(poly.as_expr(), poly.gens[0])
    ]
    left_signs = [sign_at(item, left) for item in sequence]
    right_signs = [sign_at(item, right) for item in sequence]
    return sign_variations(left_signs) - sign_variations(right_signs)


def sylvester_determinant(first: sp.Poly, second: sp.Poly) -> int:
    first_coefficients = [int(item) for item in first.all_coeffs()]
    second_coefficients = [int(item) for item in second.all_coeffs()]
    first_degree = first.degree()
    second_degree = second.degree()
    rows = []
    for shift in range(second_degree):
        rows.append(
            [0] * shift
            + first_coefficients
            + [0] * (second_degree - 1 - shift)
        )
    for shift in range(first_degree):
        rows.append(
            [0] * shift
            + second_coefficients
            + [0] * (first_degree - 1 - shift)
        )
    return int(sp.Matrix(rows).det(method="domain-ge"))


def verify_resultant_by_evaluation(
    affine: sp.Expr,
    critical: sp.Poly,
    content: int,
) -> None:
    x, y = sp.symbols("x y")
    affine_y = sp.Poly(affine, y, domain=sp.ZZ[x])
    derivative_y = affine_y.diff()
    first_max_degree = max(
        sp.Poly(coefficient, x).degree()
        for coefficient in affine_y.all_coeffs()
    )
    second_max_degree = max(
        sp.Poly(coefficient, x).degree()
        for coefficient in derivative_y.all_coeffs()
    )
    determinant_degree_bound = (
        derivative_y.degree() * first_max_degree
        + affine_y.degree() * second_max_degree
    )
    require(
        determinant_degree_bound >= critical.degree(),
        "resultant degree bound",
    )

    half = determinant_degree_bound // 2
    evaluation_points = list(range(-half, half + 1))
    while len(evaluation_points) < determinant_degree_bound + 1:
        evaluation_points.append(evaluation_points[-1] + 1)
    require(
        len(evaluation_points) >= determinant_degree_bound + 1,
        "enough resultant identity evaluations",
    )
    for value in evaluation_points:
        first = sp.Poly(affine.subs(x, value), y, domain=sp.ZZ)
        second = first.diff()
        determinant = sylvester_determinant(first, second)
        require(
            determinant == content * int(critical.eval(value)),
            f"Sylvester/resultant identity at x={value}",
        )


def verify_projection(packet: dict, f6: sp.Expr) -> None:
    x, y, z = sp.symbols("x y z")
    projection = packet["real_branch_projection_certificate"]
    chart_specs = (
        ("z_equals_1", {z: 1}, (y, x)),
        ("y_equals_1", {y: 1}, (z, x)),
        ("x_equals_1", {x: 1}, (z, y)),
    )
    recorded_charts = {
        row["chart"]: row
        for row in projection["projective_smoothness_charts"]
    }
    for name, substitution, variables in chart_specs:
        chart = sp.expand(f6.subs(substitution))
        basis = sp.groebner(
            [chart, *(sp.diff(chart, variable) for variable in variables)],
            *variables,
            order="lex",
            domain=sp.QQ,
        )
        require(
            [str(item.as_expr()) for item in basis.polys] == ["1"],
            f"independent projective smoothness chart {name}",
        )
        require(
            recorded_charts[name]["jacobian_groebner_basis"] == ["1"],
            f"recorded projective smoothness chart {name}",
        )
    require(
        int(f6.subs({x: 0, y: 1, z: 0}))
        == projection["projection_center_branch_value"]
        != 0,
        "projection center",
    )
    affine = sp.expand(f6.subs(z, 1))
    require(str(sp.Poly(affine, y, x).as_expr()) == projection["affine_equation"], "affine equation")
    require(sp.Poly(affine, y).degree() == 6, "affine y degree")

    resultant_record = projection["critical_value_resultant"]
    critical = polynomial_from_low_coefficients(
        resultant_record["primitive_coefficients_low_to_high"],
        x,
    )
    require(critical.degree() == 30, "critical degree")
    require(sp.gcd(critical, critical.diff()).degree() == 0, "critical squarefree")
    verify_resultant_by_evaluation(
        affine,
        critical,
        int(resultant_record["raw_resultant_content"]),
    )
    require(
        independent_sturm_count(critical, -sp.oo, sp.oo) == 6,
        "independent total critical root count",
    )
    intervals = resultant_record["isolating_intervals"]
    require(len(intervals) == 6, "six critical intervals")
    parsed_intervals = []
    for index, row in enumerate(intervals, start=1):
        left = rational(row["interval"][0])
        right = rational(row["interval"][1])
        require(left < right, f"critical interval order {index}")
        require(
            independent_sturm_count(critical, left, right) == 1,
            f"independent critical interval {index}",
        )
        parsed_intervals.append((left, right))

    fiber_counts = []
    for index, row in enumerate(projection["regular_fiber_counts"]):
        sample = rational(row["sample_x"])
        if index:
            require(sample > parsed_intervals[index - 1][1], "sample above left root")
        if index < len(parsed_intervals):
            require(sample < parsed_intervals[index][0], "sample below right root")
        fiber = sp.Poly(affine.subs(x, sample), y, domain=sp.QQ)
        count = independent_sturm_count(fiber, -sp.oo, sp.oo)
        require(
            count == row["real_branch_points_in_fiber"],
            f"independent fiber count {index}",
        )
        fiber_counts.append(count)
    require(fiber_counts == [2, 0, 2, 0, 2, 0, 2], "fiber pattern")

    infinity_record = projection["infinity_fiber"]
    infinity = polynomial_from_low_coefficients(
        infinity_record["coefficients_low_to_high"],
        y,
    )
    require(infinity == sp.Poly(f6.subs({x: 1, z: 0}), y), "infinity equation")
    require(sp.gcd(infinity, infinity.diff()).degree() == 0, "infinity squarefree")
    require(
        independent_sturm_count(infinity, -sp.oo, sp.oo) == 2,
        "infinity real roots",
    )

    bounded_active_bands = sum(
        fiber_counts[index] == 2
        and fiber_counts[index - 1] == 0
        and fiber_counts[index + 1] == 0
        for index in range(1, len(fiber_counts) - 1)
    )
    require(bounded_active_bands == 2, "two bounded ovals")
    require(
        fiber_counts[0] == fiber_counts[-1] == 2
        and infinity_record["real_point_count"] == 2,
        "one projectively closed tail component",
    )
    inferred_components = bounded_active_bands + 1
    require(
        inferred_components == projection["real_branch_components"] == 3,
        "real branch component count",
    )


def is_forest(parents: tuple[int, ...]) -> bool:
    for start in range(len(parents)):
        current = start
        visited = {start}
        while parents[current] != -1:
            current = parents[current]
            if current in visited:
                return False
            visited.add(current)
    return True


def independent_three_oval_euler_values() -> tuple[list[int], int]:
    values: set[int] = set()
    accepted = 0
    for parents in itertools.product((-1, 0, 1, 2), repeat=3):
        if any(parent == node for node, parent in enumerate(parents)):
            continue
        if not is_forest(parents):
            continue
        accepted += 1
        root_children = parents.count(-1)
        euler = [1 - root_children]
        euler.extend(
            1 - parents.count(node)
            for node in range(3)
        )
        depth = []
        for node in range(3):
            value = 1
            current = node
            while parents[current] != -1:
                value += 1
                current = parents[current]
            depth.append(value)
        for outside_sign in (0, 1):
            selected = [
                index
                for index, value in enumerate([0, *depth])
                if value % 2 == outside_sign
            ]
            values.add(sum(euler[index] for index in selected))
    return sorted(values), accepted


def verify_hodge_obstruction(packet: dict, picard: dict, global_bk3: dict) -> None:
    real = packet["real_structure_and_kernel_certificate"]
    require(
        picard["exact_picard_rank_certificate"]["geometric_picard_rank"] == 2,
        "Picard rank predecessor",
    )
    require(
        picard["exact_picard_rank_certificate"]["transcendental_rank"] == 20,
        "transcendental rank predecessor",
    )
    require(
        global_bk3["compactness_and_kernel_theorem"]["rho_less_than_twenty"][
            "kernel_rank"
        ]
        == [0, 1],
        "global kernel predecessor",
    )

    euler_values, forest_count = independent_three_oval_euler_values()
    nesting = real["three_oval_nesting_exhaustion"]
    require(euler_values == [-2, -1, 0, 1, 2, 3], "positive-region Euler values")
    require(euler_values == nesting["possible_chi_R_plus"], "recorded region Euler values")
    require(forest_count == nesting["labeled_rooted_forests_checked"], "forest count")
    real_euler = [2 * value for value in euler_values]
    require(real_euler == nesting["possible_chi_X_real"], "real K3 Euler values")

    h2_plus = [10 + value // 2 for value in real_euler]
    require(
        h2_plus == real["real_lefschetz"]["possible_H2_plus_dimensions"],
        "real Lefschetz dimensions",
    )
    allocation_pairs = sorted(
        {
            (plus - ns_plus, 20 - (plus - ns_plus))
            for plus in h2_plus
            for ns_plus in range(3)
        }
    )
    require(
        [list(pair) for pair in allocation_pairs]
        == real["allocation_independent_check"]["possible_T_eigenspace_pairs"],
        "allocation-independent T signatures",
    )
    require(
        all(plus not in (1, 19) and minus not in (1, 19)
            for plus, minus in allocation_pairs),
        "rank-one extreme signatures absent",
    )
    obstruction = real["rank_one_resonance_obstruction"]
    require(
        obstruction["rank_one_forced_pairs"] == [[1, 19], [19, 1]],
        "rank-one forced signatures",
    )
    require(obstruction["rank_one_excluded"], "rank one excluded")
    require(
        real["large_gauge_immersion_kernel_rank"] == 0,
        "kernel rank zero",
    )
    require(
        packet["global_b_K3_conclusion"]["kernel_rank"] == 0,
        "global kernel conclusion",
    )


