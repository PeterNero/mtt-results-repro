            and all(value > 0 for value in replay_shape[5:])
            and replay_source != ROOT / custom["source"]["path"]
            and pivot_minor.stat().st_size > 0,
            "independent exact Givaro-map minor rank",
        )
        independent_rank_route = "Givaro_basis_map_pivot_replay"
    else:
        require(
            "structural_scc_factorization" in witness["engines"]
            and "linbox_givaro_scc_factor_elimination" in witness["engines"],
            "independent SCC rank engines",
        )
        checked(
            witness["inputs"]["structural_factorization_lemma"],
            "structural factorization lemma",
        )
        structural = witness["engines"]["structural_scc_factorization"]
        checked(structural["source"], "structural source")
        checked(structural["binary"], "structural binary")
        checked(structural["output"], "structural output")
        largest_factor = checked(structural["largest_factor"], "largest SCC factor")
        remainder_factor = checked(
            structural["remainder_factor"], "remainder SCC factor"
        )
        linbox = witness["engines"]["linbox_givaro_scc_factor_elimination"]
        checked(linbox["source"], "LinBox source")
        checked(linbox["binary"], "LinBox binary")
        largest_output = checked(linbox["largest_output"], "largest SCC LinBox output")
        remainder_output = checked(
            linbox["remainder_output"], "remainder SCC LinBox output"
        )
        largest_shape = shared_runner.parse_linbox(
            largest_output.read_text(encoding="utf-8")
        )
        remainder_shape = shared_runner.parse_linbox(
            remainder_output.read_text(encoding="utf-8")
        )
        with largest_factor.open("r", encoding="ascii") as stream:
            largest_header = tuple(int(value) for value in stream.readline().split())
        with remainder_factor.open("r", encoding="ascii") as stream:
            remainder_header = tuple(int(value) for value in stream.readline().split())
        require(
            largest_shape[0] == largest_shape[1] == largest_shape[3]
            and remainder_shape[0] == remainder_shape[1] == remainder_shape[3]
            and largest_shape[0] + remainder_shape[0] == TARGET_RANK
            and largest_shape[:3] == largest_header
            and remainder_shape[:3] == remainder_header
            and structural["perfect_matching_size"] == TARGET_RANK
            and structural["scc_blocks"] >= 2,
            "independent exact SCC-factor minor rank",
        )
        independent_rank_route = "perfect_matching_SCC_block_triangular_factors"
    incremental_functional_engine = witness["engines"][
        "givaro_incremental_matrix_functional_replay"
    ]
    functional_artifact = checked(
        incremental_functional_engine["functional"], "functional artifact"
    )
    checked(incremental_functional_engine["output"], "incremental functional replay")
    checked(incremental_functional_engine["source"], "functional source")
    functional_binary = checked(
        incremental_functional_engine["binary"], "functional binary"
    )

    if not args.reuse_full_functional:
        full_raw = shared_runner.run_exact(
            functional_binary,
            [relative(full_matrix), relative(functional_artifact)],
            FULL_FUNCTIONAL_OUTPUT,
            args.timeout,
        )
    else:
        require(FULL_FUNCTIONAL_OUTPUT.is_file(), "existing full functional replay")
        full_raw = FULL_FUNCTIONAL_OUTPUT.read_text(encoding="utf-8")
    full_functional_shape = shared_runner.parse_functional_replay(full_raw)
    require(
        full_functional_shape[:4]
        == (
            92979,
            macaulay.EXPECTED_TARGET_COORDINATES,
            source_packet["matrix"]["nonzeros"],
            92979,
        ),
        "independent full-map functional replay",
    )
    for name, item in witness["field_self_test"].items():
        if isinstance(item, dict) and "path" in item:
            checked(item, f"field self-test {name}")
    require(witness["field_self_test"]["exact_rank"] == 1, "field self-test rank")

    base_coordinate_path = checked(
        source_packet["inputs"]["base_coordinate_packet"], "base coordinates"
    )
    base_coordinates = json.loads(base_coordinate_path.read_text(encoding="ascii"))
    leaders = [
        tuple(int(value) for value in item)
        for item in base_coordinates["base_leading_exponents"]
    ]
    targets, _ = macaulay.coordinate_data(leaders)
    normalization = int(
        scalars["QUOTIENT_NORMALIZATION_TARGET_COORDINATE_ZERO_BASED"]
    )
    require(
        len(functional) == len(targets) == macaulay.EXPECTED_TARGET_COORDINATES
        and functional[normalization] == 1,
        "normalized full quotient functional",
    )
    component, exponent = targets[normalization]
    functional_hash = hashlib.sha256(
        json.dumps(functional, separators=(",", ":")).encode("ascii")
    ).hexdigest()
    require(
        functional_hash
        == extraction["minor"]["quotient_functional"]["packed_coefficients_sha256"],
        "quotient functional identity",
    )

    packet: dict[str, object] = {
        "schema": (
            "mtt.unified-source.g3ap-selected-cayley-target-macaulay-"
            "full-certified.v1"
        ),
        "date": "2026-08-11",
        "theorem_id": "UST.G3AP.FULL-SOURCE-MACAULAY-RANK-SQUEEZE",
        "status": (
            "CLOSED_EXACT_SELECTED_F1016_FULL_SOURCE_ORDINARY_TOP_DIMENSION_ONE"
        ),
        "inputs": {
            "selected_ordinary_top_lower_bound": record(lower.OUT),
            "selected_base_certificate": record(base_certifier.PACKET),
            "full_source_certificate": record(source_verifier.OUT),
            "incremental_rank_witness": record(witness_path),
            "selected_source": record(macaulay.SOURCE),
            "base_coordinate_packet": record(base_coordinate_path),
            "monotone_rank_squeeze_lemma": record(MONOTONE_LEMMA),
        },
        "base_quotient": {
            "ideal": "(K,E,C)",
            "cached_generators": base_packet["execution"]["cached_generators"],
            "cached_ideal_equals_selected_ideal": True,
            "cached_and_recomputed_leading_ideals_are_equal": True,
            "certified_cache": base_packet["execution"]["certified_cache"],
            "cache": base_packet["execution"]["certified_cache"],
        },
        "target_relation_map": {
            "Cox_degree": [18, 2, 2],
            "coordinates": macaulay.EXPECTED_TARGET_COORDINATES,
            "selected_relation_rows": 92979,
            "selected_relation_nonzeros": source_packet["matrix"]["nonzeros"],
            "rank_witness_selected_rows": incremental_campaign["selection"][
                "selected_nonzero_source_rows"
            ],
            "source_order": source_packet["matrix"]["source_order"],
            "source_order_is_a_permutation_of_the_full_selected_map": True,
            "exact_rank": TARGET_RANK,
            "rank_lower_bound_from_incremental_minor": TARGET_RANK,
            "rank_upper_bound_from_selected_nonzero_ordinary_top_class": TARGET_RANK,
            "codimension": 1,
            "custom_nonzero_minor_determinant_packed": int(
                scalars["MINOR_DETERMINANT_PACKED"]
            ),
            "independent_exact_minor_rank": TARGET_RANK,
            "independent_rank_route": independent_rank_route,
        },
        "quotient_functional": {
