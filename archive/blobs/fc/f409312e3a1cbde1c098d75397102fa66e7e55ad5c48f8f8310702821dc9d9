    target = evidence["elementary_transform_target"]
    require(target["required_i_star_q"] == "-6u", "target Gysin row")
    require(target["required_q_squared"] == -6, "target square row")
    forced_horizontal_coefficient = -6
    required_vertical_coefficient = Fraction(target["required_q_squared"], 2 * forced_horizontal_coefficient)
    require(required_vertical_coefficient == Fraction(1, 2), "forced half-integral vertical coefficient")
