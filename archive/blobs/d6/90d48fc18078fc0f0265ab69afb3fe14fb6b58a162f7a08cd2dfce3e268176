#!/usr/bin/env python3
"""Calibrate the H02 endpoint determinant CRT candidate at the independent GF(11) root."""

from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import numpy as np

import build_ust_g3bt_h02_endpoint_action_one_split_prime as action
import build_ust_g3bu_h02_endpoint_determinant_crt_campaign as campaign
import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
EVIDENCE = ROOT / "evidence" / "ust_g3bv"
OUT = ROOT / "state" / "ust_g3bv_h02_endpoint_gf11_calibration.packet.json"
PRIME = 11
GAMMA_ROOT = 3


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    repository = repository.resolve()
    try:
        relative = resolved.relative_to(repository)
    except ValueError:
        repository = next(
            (
                candidate
                for candidate in (resolved.parent, *resolved.parents)
                if (candidate / ".git").exists()
            ),
            resolved.parent,
        )
        relative = resolved.relative_to(repository)
    return {
        "repository": repository.name,
        "repository_path": str(repository),
        "repository_relative_path": relative.as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def main() -> None:
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    g3bi_path = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
    g3bk_path = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"
    g3bu_path = ROOT / "state" / "ust_g3bu_h02_endpoint_determinant_crt_campaign.packet.json"
    g3bi = load(g3bi_path)
    g3bk = load(g3bk_path)
    g3bu = load(g3bu_path)
    for packet, label in ((g3bi, "G3BI"), (g3bk, "G3BK"), (g3bu, "G3BU")):
        require(all(packet["checks"].values()), f"{label} checks")

    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H02.packet.json"
    csc_path = mld / "q79_eta9_original_jacobian_macaulay_H02_csc.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H02.packet.json"
    macaulay = load(macaulay_path)
    csc = load(csc_path)
    factor = load(factor_path)
    base_packet = load(oracle.BASE)
    global_f0 = load(oracle.GLOBAL_F0)
    b89 = load(oracle.B89)
    generators0, _, _ = oracle.exact_generators(base_packet, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = [int(value) for value in csc["binary"]["quotient_unit_rows"]]
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"]["minimal_polynomial_coefficients_ascending"]
    ]
    require(arithmetic.evaluate(minpoly, GAMMA_ROOT, PRIME) == 0, "GF11 selected root")

    chart, construction = action.endpoint_chart(
        PRIME,
        GAMMA_ROOT,
        g3bi,
        macaulay,
        factor,
        quotient_rows,
        descriptors,
        generators0,
        target_lookup,
        oracle,
        exporter,
    )
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    chart_path = EVIDENCE / "H02.p11.g3.G3BI_endpoint.chart.bin"
    rhs_path = EVIDENCE / "H02.p11.g3.G3BI_endpoint.unit.rhs.bin"
    log_path = EVIDENCE / "H02.p11.g3.G3BI_endpoint.calibration.log"
    exporter.write_chart(
        chart_path,
        PRIME,
        action.DIMENSION,
        action.QUOTIENT_UNITS,
        action.IMAGE_RANK,
        chart.indptr.astype(np.uint64).tolist(),
        chart.indices.astype(np.uint32).tolist(),
        chart.data.astype(np.uint32).tolist(),
    )
    campaign.write_unit_rhs(rhs_path, PRIME, quotient_rows[0], exporter)
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(chart_path),
        "--rhs",
        runtime.wsl_path(rhs_path),
        "--log",
        runtime.wsl_path(log_path),
        "--determinant-only",
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    if completed.returncode == 0:
        fields = initializer.parse_log(log_path)
        require(fields.get("STATUS") == "SUCCESS", "GF11 determinant status")
        determinant = int(fields["CHART_DETERMINANT"])
        calibration_status = "INVERTIBLE"
        dependent_column = None
        transcript = completed.stdout.strip()
    else:
        match = re.search(
            r"(?:selected chart became dependent at column|dependent selected chart column) (\d+)",
            completed.stderr,
        )
        require(match is not None, completed.stdout + completed.stderr)
        determinant = 0
        calibration_status = "SINGULAR_EXACT_DEPENDENT_COLUMN"
        dependent_column = int(match.group(1))
        transcript = (completed.stdout + completed.stderr).strip()
        log_path.write_text(
            "SCHEMA MTTUnifiedSourceG3bvGF11Calibration.v1\n"
            "STATUS SINGULAR_EXACT_DEPENDENT_COLUMN\n"
            f"PRIME {PRIME}\n"
            f"ROWS {action.DIMENSION}\n"
            "CHART_DETERMINANT 0\n"
            f"DEPENDENT_COLUMN {dependent_column}\n"
            "END_CERTIFICATE\n",
            encoding="ascii",
        )

    candidates = [int(value) for value in g3bu["CRT"]["full_signed_coefficient_candidates"]]
    candidate_value = arithmetic.evaluate(candidates, GAMMA_ROOT, PRIME)
    require(candidate_value != determinant, "GF11 calibration must distinguish CRT alias")
    checks = {
        "gamma3_is_a_root_of_the_selected_sextic_mod11": True,
        "the_GF11_endpoint_chart_is_rebuilt_from_the_exact_characteristic_zero_source": True,
        "the_exact_GF11_factorization_decides_the_endpoint_determinant": True,
        "the_eight_prime_centered_CRT_candidate_fails_the_independent_GF11_calibration": True,
        "the_centered_CRT_candidate_is_not_promoted": True,
    }
    require(all(checks.values()), "G3BV checks")
    packet = {
        "schema": "mtt.unified-source.g3bv-h02-endpoint-gf11-calibration.v1",
        "date": "2026-08-12",
        "status": "EXACT_H02_ENDPOINT_GF11_CALIBRATION_REJECTS_EIGHT_PRIME_CRT_ALIAS",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
            "G3BI": record(g3bi_path),
            "G3BK": record(g3bk_path),
            "G3BU": record(g3bu_path),
            "H02_Macaulay": external_record(macaulay_path, mld),
            "H02_CSC": external_record(csc_path, mld),
            "H02_factorization": external_record(factor_path, mld),
            "three_block_oracle": external_record(oracle.OUT, mld),
            "base": external_record(oracle.BASE, mld),
            "global_F0": external_record(oracle.GLOBAL_F0, mld),
            "B89": external_record(oracle.B89, mld),
            "split_prime_solver": external_record(solver, mld),
        },
        "field": {"prime": PRIME, "gamma_root": GAMMA_ROOT},
        "endpoint_chart": {
            "construction": construction,
            "binary": record(chart_path),
            "unit_RHS": record(rhs_path),
            "calibration_log": record(log_path),
            "calibration_status": calibration_status,
            "dependent_column": dependent_column,
            "determinant_mod11": determinant,
            "solver_transcript": transcript,
        },
        "CRT_alias_test": {
            "eight_prime_centered_coefficients": candidates,
            "candidate_evaluation_mod11_at_gamma3": candidate_value,
            "exact_endpoint_determinant_mod11_at_gamma3": determinant,
            "matches": False,
        },
        "checks": checks,
        "guardrails": {
            "claims_eight_prime_CRT_reconstruction": False,
            "claims_characteristic_zero_H02_determinant": False,
            "claims_characteristic_zero_H02_inverse_action": False,
            "claims_integral_parallel_transport_or_terminal_readout": False,
        },
        "theorem": {
            "name": "ustG3bvH02EndpointGf11Calibration",
            "tier": "CLOSED_EXACT_INDEPENDENT_CRT_ALIAS_REJECTION",
            "statement": (
                "The exact selected H02 endpoint chart is evaluated independently at "
                "(11,gamma-3). Its determinant disagrees with the evaluation of the centered "
                "eight-prime CRT candidate. Therefore that candidate is not the characteristic-zero "
                "determinant, independently confirming the G3BU holdout failure."
            ),
        },
        "next_required_object": (
            "Add split primes only to the six H02 determinant coordinates until independent "
            "holdouts stabilize, then prove a height bound or exact determinant relation before "
            "reconstructing determinant-cleared adjugate actions."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3BV H02 endpoint GF11 calibration: PASS")
    print(
        f"status={calibration_status} determinant={determinant} "
        f"CRT_candidate_mod11={candidate_value} match=false"
    )
    print(f"packet_sha256={sha256(OUT)}")


if __name__ == "__main__":
    main()
