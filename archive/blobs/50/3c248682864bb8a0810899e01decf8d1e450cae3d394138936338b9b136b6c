            "start_parameter": 1,
            "endpoint_parameter": 0,
            "coefficient_count": 249,
            "nonzero_correction_rows": sum(any(row) for row in correction),
            "correction_vectors": correction,
            "both_endpoints_are_smooth": True,
            "discriminant_line_is_not_identically_zero": True,
        },
        "selected_path": {
            "parameter_interval": [0, 1],
            "formula": "a(t)=1-t+i*pi*t*(1-t)",
            "orientation": "t increases from G3BI start at a=1 to fixed B67/B89 F0 at a=0",
            "interior_imaginary_sign": "positive",
            "derivative": "a'(t)=-1+i*pi*(1-2t)",
            "derivative_is_never_zero": True,
            "works_for_every_archimedean_embedding": True,
            "selection_role": "computational marking convention; path changes alter the lift only by integral periods",
        },
        "discriminant_avoidance_proof": {
            "step_1": "The eta9 singular-section locus is Zariski closed over Qbar because the critical incidence projects properly from the projective K3-times-Fermat carrier.",
            "step_2": "The correction line is not contained in that locus because its a=0 and a=1 fibers are both certified smooth; hence its projective discriminant intersection is finite.",
            "step_3": "Every finite parameter in that intersection is algebraic under every embedding of Q(gamma).",
            "step_4": "For 0<t<1, if a(t) were algebraic then Re(a)=1-t would make t algebraic; pi*t*(1-t) would then be a nonzero algebraic multiple of the transcendental number pi, hence transcendental, contradicting algebraicity of Im(a). If t is transcendental, Re(a) is already transcendental.",
            "conclusion": "Every interior path value is transcendental and every critical value is algebraic, so the path is disjoint from the discriminant; the smooth endpoints complete the proof.",
            "critical_values_or_discriminant_polynomial_needed": False,
        },
        "integral_transport": {
            "local_system": "the locked rank-1509 integral Gauss-Manin local system restricted to the G3BJ path",
            "theorem": "Ehresmann local triviality along the smooth proper path gives a path-oriented integral lattice isomorphism from the G3BI fiber to fixed B89",
            "selected_source_vector": "z4=(-e2+2f2) tensor u_B",
            "abstract_terminal_class": "PT_G3BJ(z4)",
            "integrality_is_preserved": True,
            "terminal_rank1509_coordinates_emitted": False,
            "terminal_meridian_word_emitted": False,
        },
        "theorem": {
            "name": "TranscendentalArcDiscriminantAvoidanceAndIntegralTransportTheorem",
            "statement": "For every Archimedean embedding of Q(gamma), the path F_{a(t)} with a(t)=1-t+i*pi*t(1-t) joins the explicit G3BI root-containing member to fixed B67/B89 F0 and contains no singular fiber. Indeed, the correction-pencil discriminant is a finite algebraic set, whereas every interior a(t) is transcendental. The resulting smooth proper family carries a canonical path-oriented integral Gauss-Manin isomorphism. Thus the path-selection clause and abstract integral one-vector transport map are closed; coordinates of PT_G3BJ(z4), a meridian word and the 248-row readout remain open.",
            "tier": "CLOSED_EXACT_PATH_AND_ABSTRACT_INTEGRAL_LOCAL_SYSTEM_TRANSPORT",
