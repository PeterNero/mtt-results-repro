def f3_add(left: F3, right: F3) -> F3:
    return tuple((a + b) % P for a, b in zip(left, right))  # type: ignore[return-value]


def f3_neg(value: F3) -> F3:
    return tuple((-entry) % P for entry in value)  # type: ignore[return-value]


def f3_mul(left: F3, right: F3) -> F3:
    work = [0] * 5
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            work[i + j] = (work[i + j] + a * b) % P
    relation = (70, 32, 89)  # alpha^3=-31-69 alpha-12 alpha^2 modulo 101
    for degree in (4, 3):
        coefficient = work[degree] % P
        if coefficient:
            for index, replacement in enumerate(relation):
                work[degree - 3 + index] = (
                    work[degree - 3 + index] + coefficient * replacement
                ) % P
        work[degree] = 0
    return tuple(work[:3])  # type: ignore[return-value]


def k(value: list[int] | tuple[int, ...]) -> K:
    require(len(value) == 6, "K coordinate length")
    return tuple(int(entry) % P for entry in value)  # type: ignore[return-value]


def k_add(left: K, right: K) -> K:
    return tuple((a + b) % P for a, b in zip(left, right))  # type: ignore[return-value]


def k_neg(value: K) -> K:
    return tuple((-entry) % P for entry in value)  # type: ignore[return-value]


def k_sub(left: K, right: K) -> K:
    return k_add(left, k_neg(right))


def k_mul(left: K, right: K) -> K:
    a, b = left[:3], left[3:]
    c, d = right[:3], right[3:]
    real = f3_add(f3_mul(a, c), f3_neg(tuple(3 * x % P for x in f3_mul(b, d))))
    mu = f3_add(f3_mul(a, d), f3_mul(b, c))
    return tuple(real + mu)  # type: ignore[return-value]


def k_pow(value: K, exponent: int) -> K:
    result = ONE
    base = value
    power = exponent
    while power:
        if power & 1:
            result = k_mul(result, base)
        base = k_mul(base, base)
        power //= 2
    return result


def k_inv(value: K) -> K:
    require(value != ZERO, "inverse of zero")
    inverse = k_pow(value, P**6 - 2)
    require(k_mul(value, inverse) == ONE, "field inverse")
    return inverse


Polynomial = list[K]


def p_trim(value: Polynomial) -> Polynomial:
    result = value[:]
    while result and result[-1] == ZERO:
        result.pop()
    return result


def p_add(left: Polynomial, right: Polynomial) -> Polynomial:
    result = [ZERO] * max(len(left), len(right))
    for index in range(len(result)):
        result[index] = k_add(
            left[index] if index < len(left) else ZERO,
            right[index] if index < len(right) else ZERO,
        )
    return p_trim(result)


def p_neg(value: Polynomial) -> Polynomial:
    return p_trim([k_neg(entry) for entry in value])


def p_sub(left: Polynomial, right: Polynomial) -> Polynomial:
    return p_add(left, p_neg(right))


def p_mul(left: Polynomial, right: Polynomial) -> Polynomial:
    if not left or not right:
        return []
    result = [ZERO] * (len(left) + len(right) - 1)
    for i, a in enumerate(left):
        for j, b in enumerate(right):
            result[i + j] = k_add(result[i + j], k_mul(a, b))
    return p_trim(result)


def p_scale(value: Polynomial, scalar: K) -> Polynomial:
    return p_trim([k_mul(entry, scalar) for entry in value])


def p_divmod(numerator: Polynomial, denominator: Polynomial) -> tuple[Polynomial, Polynomial]:
    require(bool(denominator), "polynomial division by zero")
    remainder = p_trim(numerator)
    quotient = [ZERO] * max(0, len(remainder) - len(denominator) + 1)
    inverse_lead = k_inv(denominator[-1])
    while remainder and len(remainder) >= len(denominator):
        degree = len(remainder) - len(denominator)
        coefficient = k_mul(remainder[-1], inverse_lead)
        quotient[degree] = coefficient
        subtraction = [ZERO] * degree + p_scale(denominator, coefficient)
        remainder = p_sub(remainder, subtraction)
    return p_trim(quotient), p_trim(remainder)


def p_xgcd(left: Polynomial, right: Polynomial) -> tuple[Polynomial, Polynomial, Polynomial]:
    old_r, r = p_trim(left), p_trim(right)
    old_s, s = [ONE], []
    old_t, t = [], [ONE]
    while r:
        quotient, remainder = p_divmod(old_r, r)
        old_r, r = r, remainder
        old_s, s = s, p_sub(old_s, p_mul(quotient, s))
        old_t, t = t, p_sub(old_t, p_mul(quotient, t))
    require(bool(old_r), "zero polynomial gcd")
    normalizer = k_inv(old_r[-1])
    return (
        p_scale(old_r, normalizer),
        p_scale(old_s, normalizer),
        p_scale(old_t, normalizer),
    )


def determinant3(matrix: list[list[Polynomial]]) -> Polynomial:
    require(len(matrix) == 3 and all(len(row) == 3 for row in matrix), "3x3")
    positive = p_add(
        p_mul(p_mul(matrix[0][0], matrix[1][1]), matrix[2][2]),
        p_add(
            p_mul(p_mul(matrix[0][1], matrix[1][2]), matrix[2][0]),
            p_mul(p_mul(matrix[0][2], matrix[1][0]), matrix[2][1]),
        ),
    )
    negative = p_add(
        p_mul(p_mul(matrix[0][2], matrix[1][1]), matrix[2][0]),
        p_add(
            p_mul(p_mul(matrix[0][1], matrix[1][0]), matrix[2][2]),
            p_mul(p_mul(matrix[0][0], matrix[1][2]), matrix[2][1]),
        ),
    )
    return p_sub(positive, negative)


def matrix_rank(matrix: list[list[K]]) -> int:
    work = [row[:] for row in matrix]
    rows = len(work)
    columns = len(work[0]) if rows else 0
    rank = 0
    for column in range(columns):
        pivot = next((row for row in range(rank, rows) if work[row][column] != ZERO), None)
        if pivot is None:
            continue
        work[rank], work[pivot] = work[pivot], work[rank]
        inverse = k_inv(work[rank][column])
        work[rank] = [k_mul(entry, inverse) for entry in work[rank]]
        for row in range(rows):
            if row == rank or work[row][column] == ZERO:
                continue
            factor = work[row][column]
            work[row] = [
                k_sub(entry, k_mul(factor, pivot_entry))
                for entry, pivot_entry in zip(work[row], work[rank])
            ]
        rank += 1
        if rank == rows:
            break
    return rank


def determinant(matrix: list[list[K]]) -> K:
    require(matrix and len(matrix) == len(matrix[0]), "square determinant")
    work = [row[:] for row in matrix]
    result = ONE
    sign = 1
    for column in range(len(work)):
        pivot = next((row for row in range(column, len(work)) if work[row][column] != ZERO), None)
        if pivot is None:
            return ZERO
        if pivot != column:
            work[column], work[pivot] = work[pivot], work[column]
            sign *= -1
        pivot_value = work[column][column]
        result = k_mul(result, pivot_value)
        inverse = k_inv(pivot_value)
        for row in range(column + 1, len(work)):
            if work[row][column] == ZERO:
                continue
            factor = k_mul(work[row][column], inverse)
            work[row] = [
                k_sub(entry, k_mul(factor, pivot_entry))
                for entry, pivot_entry in zip(work[row], work[column])
            ]
    return k_neg(result) if sign < 0 else result


def serialize_polynomial(value: Polynomial) -> list[list[int]]:
    return [list(entry) for entry in value]


