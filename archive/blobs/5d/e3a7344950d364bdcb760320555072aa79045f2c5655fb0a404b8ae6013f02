        require(len(set(local_profiles)) == 1, f"common degree8 chart p={prime}")
        coefficients = g3fe.interpolate(np.stack(local_values), roots, prime)
        residues.append(coefficients.ravel().astype(np.uint32))
        fiber_rows.append(
            {
                "prime": prime,
                "roots": list(roots),
