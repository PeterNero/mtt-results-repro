#!/usr/bin/env python3
"""Export one deterministic chunk of the exact G3AP target Macaulay map.

The chunk is selected from the balanced source schedule defined by
``build_ust_g3ap_selected_cayley_target_macaulay_matrix``.  Output triples use
global one-based source-row numbers so independently generated chunks can be
concatenated without rewriting their entries.
"""

from __future__ import annotations

import argparse
import gzip
import hashlib
import json
from pathlib import Path
import subprocess
import threading

import build_ust_g3ap_selected_cayley_target_macaulay_matrix as macaulay
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
CHUNK_ROOT = ROOT / "state" / "ust_g3ap_selected_cayley_target_macaulay_chunks"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def selection_hash(values: list[tuple[int, tuple[int, ...]]]) -> str:
    payload = json.dumps(
        [[generator, list(exponent)] for generator, exponent in values],
        separators=(",", ":"),
    ).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def paths(total: int, index: int, count: int) -> dict[str, Path]:
    stem = f"balanced{total}_chunk{index:03d}of{count:03d}"
    return {
        "script": CHUNK_ROOT / f"{stem}.sing",
        "output": CHUNK_ROOT / f"{stem}.singular.out.gz",
        "triples": CHUNK_ROOT / f"{stem}.packed-triples",
        "packet": CHUNK_ROOT / f"{stem}.packet.json",
    }


def load_coordinates() -> tuple[list[tuple[int, ...]], dict[str, object]]:
    return macaulay.load_inspection()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--balanced-rows", type=int, required=True)
    parser.add_argument("--chunk-index", type=int, required=True)
    parser.add_argument("--chunk-count", type=int, required=True)
    parser.add_argument("--timeout", type=int, default=43200)
    args = parser.parse_args()
    require(args.chunk_count > 0, "positive chunk count")
    require(0 <= args.chunk_index < args.chunk_count, "chunk index")
    require(21 <= args.balanced_rows <= macaulay.EXPECTED_SOURCE_MULTIPLES, "balanced rows")
    CHUNK_ROOT.mkdir(parents=True, exist_ok=True)

    leaders, base_packet = load_coordinates()
    targets, _ = macaulay.coordinate_data(leaders)
    target_index = {value: index for index, value in enumerate(targets, start=1)}
    require(len(target_index) == len(targets), "unique target coordinates")
    all_sources, _ = macaulay.source_data(leaders)
    selected, quotas = macaulay.balanced_source_subset(all_sources, args.balanced_rows)
    start = args.balanced_rows * args.chunk_index // args.chunk_count
    stop = args.balanced_rows * (args.chunk_index + 1) // args.chunk_count
    chunk = selected[start:stop]
    require(chunk, "nonempty chunk")

    output_paths = paths(args.balanced_rows, args.chunk_index, args.chunk_count)
    source_text = macaulay.SOURCE.read_text(encoding="ascii")
    output_paths["script"].write_text(
        macaulay.export_script(source_text, chunk), encoding="ascii"
    )

    process = subprocess.Popen(
        singular_command(ROOT, output_paths["script"]),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    require(process.stdout is not None, "Singular stdout")
    nonzeros = 0
    singular_errors: list[str] = []
    marker = f"G3AP_MACAULAY_EXPORT_ROWS={len(chunk)}"
    marker_seen = False
    pass_seen = False
    timed_out = threading.Event()

    def kill_on_timeout() -> None:
        if process.poll() is None:
            timed_out.set()
            process.kill()

    watchdog = threading.Timer(args.timeout, kill_on_timeout)
    watchdog.daemon = True
    watchdog.start()
    try:
        with (
            gzip.open(output_paths["output"], "wt", encoding="utf-8") as raw_output,
            output_paths["triples"].open("w", encoding="ascii") as triple_output,
        ):
            for line in process.stdout:
                raw_output.write(line)
                stripped = line.rstrip()
                if stripped == marker:
                    marker_seen = True
                elif stripped == "G3AP_MACAULAY_EXPORT_PASS":
                    pass_seen = True
                if line.lstrip().startswith("?"):
                    singular_errors.append(stripped)
                if not line.startswith("G3AP_MACAULAY_TERM="):
                    continue
                row_text, component_text, exponent_text, coefficient_text = (
                    stripped.split("=", 1)[1].split("|", 3)
                )
                local_row = int(row_text)
                require(1 <= local_row <= len(chunk), "local source row")
                coordinate = (
                    int(component_text),
                    tuple(int(value) for value in exponent_text.split(",")),
                )
                require(coordinate in target_index, "relation term outside target coordinates")
                packed = macaulay.packed_coefficient(coefficient_text)
                require(packed != 0, "nonzero exported coefficient")
                triple_output.write(
                    f"{start + local_row} {target_index[coordinate]} {packed}\n"
                )
                nonzeros += 1
        returncode = process.wait()
    finally:
        watchdog.cancel()
    if timed_out.is_set():
        raise subprocess.TimeoutExpired(str(output_paths["script"]), args.timeout)
    require(returncode == 0, "Macaulay chunk execution")
    require(not singular_errors, f"Singular errors: {singular_errors[:3]}")
    require(marker_seen and pass_seen, "Macaulay chunk completion markers")

    packet: dict[str, object] = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-target-macaulay-chunk.v1",
        "date": "2026-08-10",
        "status": "CANDIDATE_EXACT_MATRIX_CHUNK_NOT_G3AP_CLOSURE",
        "inputs": {
            "selected_source": {
                "path": macaulay.relative(macaulay.SOURCE),
                "sha256": macaulay.sha256(macaulay.SOURCE),
            },
            "base_coordinate_packet": {
                "path": macaulay.relative(macaulay.INSPECT_PACKET),
                "sha256": sha256(macaulay.INSPECT_PACKET),
            },
        },
        "selection": {
            "kind": "balanced_quantiles_across_all_21_selected_derivative_generators",
            "balanced_rows": args.balanced_rows,
            "per_generator_quotas": quotas,
            "selection_sha256": selection_hash(selected),
            "chunk_index": args.chunk_index,
            "chunk_count": args.chunk_count,
            "global_start_zero_based": start,
            "global_stop_exclusive_zero_based": stop,
            "chunk_rows": len(chunk),
        },
        "execution": {
            "script": {
                "path": macaulay.relative(output_paths["script"]),
                "sha256": sha256(output_paths["script"]),
            },
            "compressed_output": {
                "path": macaulay.relative(output_paths["output"]),
                "sha256": sha256(output_paths["output"]),
                "bytes": output_paths["output"].stat().st_size,
            },
            "packed_triples": {
                "path": macaulay.relative(output_paths["triples"]),
                "sha256": sha256(output_paths["triples"]),
                "bytes": output_paths["triples"].stat().st_size,
            },
            "nonzeros": nonzeros,
        },
        "matrix_shape_after_assembly": [args.balanced_rows, len(targets)],
        "guardrails": {
            "claims_matrix_rank": False,
            "claims_target_dimension_at_most_one": False,
            "claims_G3AP_is_closed": False,
        },
    }
    output_paths["packet"].write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP target Macaulay chunk: PASS "
        f"chunk={args.chunk_index + 1}/{args.chunk_count} rows={len(chunk)} "
        f"nonzeros={nonzeros}"
    )


if __name__ == "__main__":
    main()
