    require(len(target_lookup) == AMBIENT_DIMENSION, "H02 target lookup")

    quotient = np.load(G3GJ_QUOTIENT, allow_pickle=False).astype(np.int64) % PRIME
    endpoint_rows = endpoint_coefficient_rows(g3bi, cayley)
    correction = correction_row(g3bi)
    sources = source_rows(quotient, h02, ordinary)
    header = model_header(base, endpoint_rows)
    basis_text = basis_script(header)
    return_text = return_script(header, correction, sources, args.lift_bound)
    BASIS_SCRIPT.write_text(basis_text, encoding="ascii")
    RETURN_SCRIPT.write_text(return_text, encoding="ascii")

    provenance = {
        "git_head": git_head(),
        "kernel_model_sha256": args.kernel_model_sha256,
        "prime": PRIME,
        "gamma_root": ROOT_VALUE,
        "inputs": {
            "G3BI": record(G3BI),
            "G3BT": record(G3BT),
