#!/usr/bin/env python3
"""Independently verify the exact G3AP fiber-two quotient module."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import subprocess
import tempfile

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ap_selected_cayley_fiber2_qring.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def verify_quotient_caches(
    source_text: str,
    base_cache: Path,
    module_cache: Path,
    expected_base_size: int,
    expected_module_size: int,
) -> None:
    base_relative = str(base_cache.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(module_cache.relative_to(ROOT)).replace("\\", "/")
    representatives_before, representatives_after = qring.derivative_representatives()
    generators = ",\n  ".join(qring.derivative_generators())
    script = fiber2.selected_base_prefix(source_text) + f'''option(noredTail);
{representatives_before}
ideal I0=K,E,C;
ideal G0=std(I0);
def cachedIdeal=read("ssi:r {base_relative}");
ideal GI=cachedIdeal;
print("G3AP_F2_QCHECK_BASE_IS_SB_ATTR="+string(attrib(GI,"isSB")));
print("G3AP_F2_QCHECK_BASE_SIZE="+string(size(GI)));
ideal GICheck=std(GI);
int equalBase=1;
int i;
for (i=1;i<=size(G0);i++) {{ if (reduce(G0[i],GICheck)!=0) {{ equalBase=0; }} }}
for (i=1;i<=size(GICheck);i++) {{ if (reduce(GICheck[i],G0)!=0) {{ equalBase=0; }} }}
print("G3AP_F2_QCHECK_BASE_IDEAL_EQUAL="+string(equalBase));
attrib(GICheck,"isSB",1);
qring q=GICheck;
{representatives_after}
module M=
  {generators};
intvec componentShifts=12,15,8,18,11,4;
attrib(M,"isHomog",componentShifts);
degBound=44;
def cachedModule=read("ssi:r {module_relative}");
module GM=cachedModule;
print("G3AP_F2_QCHECK_MODULE_IS_SB_ATTR="+string(attrib(GM,"isSB")));
print("G3AP_F2_QCHECK_MODULE_SIZE="+string(size(GM)));
attrib(GM,"isHomog",componentShifts);
module GMCheck=std(GM);
int badGeneratorRemainders=0;
for (i=1;i<=size(M);i++)
{{ if (reduce(M[i],GMCheck)!=0) {{ badGeneratorRemainders=badGeneratorRemainders+1; }} }}
print("G3AP_F2_QCHECK_MODULE_BAD_GENERATOR_REMAINDERS="+string(badGeneratorRemainders));
print("G3AP_F2_QCHECK_PASS");
quit;
'''
    path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            suffix=".sing",
            prefix="ust_g3ap_f2_qcheck_",
            dir=ROOT / "state",
            delete=False,
        ) as temporary:
            temporary.write(script)
            path = Path(temporary.name)
        completed = subprocess.run(
            singular_command(ROOT, path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=1800,
            check=False,
        )
        require(completed.returncode == 0, "quotient cache reconstruction")
        require("G3AP_F2_QCHECK_PASS" in completed.stdout, "quotient cache check pass")
        expected = {
            "G3AP_F2_QCHECK_BASE_IS_SB_ATTR": 0,
            "G3AP_F2_QCHECK_BASE_SIZE": expected_base_size,
            "G3AP_F2_QCHECK_BASE_IDEAL_EQUAL": 1,
            "G3AP_F2_QCHECK_MODULE_IS_SB_ATTR": 0,
            "G3AP_F2_QCHECK_MODULE_SIZE": expected_module_size,
            "G3AP_F2_QCHECK_MODULE_BAD_GENERATOR_REMAINDERS": 0,
        }
        for label, value in expected.items():
            require(
                re.search(rf"^{label}={value}$", completed.stdout, re.MULTILINE)
                is not None,
                label,
            )
    finally:
        if path is not None:
            path.unlink(missing_ok=True)


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-top.v1",
        "schema",
    )
    require(packet["theorem_id"] == "UST.G3AP.FIBER2.QRING", "theorem id")
    require(all(packet["checks"].values()), "all checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    source = checked(packet["inputs"]["selected_source"], "selected source")
    script = checked(packet["execution"]["script"], "quotient script")
    output = checked(packet["execution"]["output"], "quotient output")
    base_cache = checked(packet["execution"]["base_cache"], "base cache")
    module_cache = checked(
        packet["execution"]["bounded_module_cache"], "quotient module cache"
    )
    source_text = source.read_text(encoding="ascii")
    script_text = script.read_text(encoding="ascii")
    require(script_text == qring.qring_script(source_text), "exact script reconstruction")
    require("ideal I0=K,E,C;" in script_text, "selected base ideal")
    require("qring q=GI;" in script_text, "base quotient ring")
    require("module G=std(M);" in script_text, "quotient module basis")
    require("degBound=44;" in script_text, "degree bound")
    require('attrib(GI,"isSB",0);' in script_text, "base trust cleared")
    require('attrib(G,"isSB",0);' in script_text, "module trust cleared")
    representatives_before, representatives_after = qring.derivative_representatives()
    for line in representatives_before.splitlines() + representatives_after.splitlines():
        require(line in script_text, f"derivative representative {line}")
    for generator in qring.derivative_generators():
        require(generator in script_text, f"quotient module generator {generator}")
    require(packet["execution"]["module_generator_count"] == 21, "21 generators")
    require(
        packet["fiber_degree_two_module"]["base_quotient"] == "B/(K,E,C)",
        "base quotient",
    )
    require(
        packet["fiber_degree_two_module"]["components"]
        == ["u2", "uv", "us", "v2", "vs", "s2"],
        "component order",
    )
    require(
        packet["fiber_degree_two_module"]["component_scalar_shifts"]
        == [12, 15, 8, 18, 11, 4],
        "component shifts",
    )
    raw = output.read_text(encoding="utf-8")
    require("G3AP_F2_QRING_BOUND=44" in raw, "raw degree bound")
    require("G3AP_F2_QRING_MODULE_GENERATORS=21" in raw, "raw generator count")
    require("G3AP_F2_QRING_LEADER_EXPORT_PASS" in raw, "raw pass")
    base, module = qring.parse_leaders(raw)
    require(len(base) == packet["execution"]["base_basis_size"], "base leader count")
    require(
        len(module) == packet["execution"]["module_basis_size_through_bound"],
        "module leader count",
    )
    weights = (1, 1, 1, 3, 1, 1, 1)
    require(
        all(
            sum(weight * power for weight, power in zip(weights, exponent)) <= 44
            for _, exponent in module
        ),
        "module leaders lie through degree 44",
    )
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL == 174865, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "unique top standard")
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    top = packet["ordinary_top_piece"]
    require(top["Cox_degree"] == [18, 2, 2] and top["dimension"] == 1, "top line")
    require(
        top["basis"] == ["w^12*t2^4*s^2"]
        and top["basis_component"] == "s2",
        "top basis",
    )
    base_record = packet["execution"]["base_cache"]
    module_record = packet["execution"]["bounded_module_cache"]
    require(base_cache.stat().st_size == base_record["bytes"] > 0, "base bytes")
    require(module_cache.stat().st_size == module_record["bytes"] > 0, "module bytes")
    require(base_record["isSB_trust_attribute_stored"] is False, "base cache scope")
    require(
        module_record["valid_through_base_scalar_degree"] == 44
        and module_record["isSB_trust_attribute_stored"] is False,
        "module cache scope",
    )
    verify_quotient_caches(
        source_text,
        base_cache,
        module_cache,
        len(base),
        len(module),
    )
    print(
        "UST.G3AP.FIBER2.QRING selected ordinary top: PASS "
        f"base={len(base)} module={len(module)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
