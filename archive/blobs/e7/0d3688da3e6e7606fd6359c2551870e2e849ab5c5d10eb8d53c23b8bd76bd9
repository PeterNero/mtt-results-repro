        "next_required_object": "Execute only the three canonical primal Frobenius/path transports. At lambda=0 apply the exact B103 polarization to each transported line, certify the normalized polarization dual, and reconstruct the three common-frame Picard-Lefschetz projectors. Then perform finite relation detection and integral normalization on the surviving subsystem.",
    }
    require(all(checks.values()), "G3AT checks")
    require(not any(packet["guardrails"].values()), "G3AT guardrails")
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3AT polarized primal-only transport: PASS 6 ODEs -> 3 ODEs")


if __name__ == "__main__":
    main()
