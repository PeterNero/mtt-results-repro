def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def ideal_basis(
    generators: dict[int, np.ndarray], degree: int, prime: int
) -> tuple[np.ndarray, int]:
    blocks = [
        graded.multiply_space(generators[source], source, degree, prime)
        for source in (11, 14, 15)
        if degree >= source
    ]
    dimension = len(graded.homogeneous_exponents(degree))
    if not blocks:
        return np.zeros((dimension, 0), dtype=np.int64), 0
    matrix = np.concatenate(blocks, axis=1)
    rank, pivots, _ = graded.rref(matrix, prime)
    return matrix[:, pivots] % prime, rank


def socle_dimension(
    current: np.ndarray, following: np.ndarray, degree: int, prime: int
) -> int:
    source = graded.homogeneous_exponents(degree)
    target = graded.homogeneous_exponents(degree + 1)
    target_lookup = {exponent: row for row, exponent in enumerate(target)}
    variables = graded.homogeneous_exponents(1)

    if following.shape[1]:
        _, _, annihilator_columns = graded.rref(
            following.T, prime, emit_nullspace=True
        )
        require(annihilator_columns is not None, "following annihilator")
        annihilator = annihilator_columns.T
    else:
        annihilator = np.eye(len(target), dtype=np.int64)

    equations = np.zeros(
        (len(variables) * annihilator.shape[0], len(source)), dtype=np.int64
    )
    for variable_index, variable in enumerate(variables):
        first = variable_index * annihilator.shape[0]
        past = first + annihilator.shape[0]
        for column, exponent in enumerate(source):
            product = tuple(
                exponent[index] + variable[index] for index in range(3)
            )
            equations[first:past, column] = annihilator[:, target_lookup[product]]
    equation_rank, _, _ = graded.rref(equations, prime)
    kernel_dimension = len(source) - equation_rank
    require(kernel_dimension >= current.shape[1], "socle contains current ideal")
    return kernel_dimension - current.shape[1]


def hilbert_numerator(hilbert: tuple[int, ...]) -> dict[int, int]:
    padded = hilbert + (0, 0)
    result: dict[int, int] = {}
    for degree in range(len(padded)):
        coefficient = padded[degree]
        if degree >= 1:
            coefficient -= 3 * padded[degree - 1]
        if degree >= 2:
            coefficient += 3 * padded[degree - 2]
        if degree >= 3:
            coefficient -= padded[degree - 3]
        if coefficient:
            result[degree] = coefficient
    return result


def betti_2_from_numerator(
    numerator: dict[int, int], betti_3: dict[int, int]
) -> dict[int, int]:
    result: dict[int, int] = {}
    for degree in range(1, max(numerator | betti_3 | EXPECTED_BETTI_1) + 1):
        value = (
            numerator.get(degree, 0)
            + EXPECTED_BETTI_1.get(degree, 0)
            + betti_3.get(degree, 0)
        )
        require(value >= 0, f"nonnegative beta2 degree{degree}")
        if value:
            result[degree] = value
    return result


def main() -> None:
    require(G3FN.is_file(), "G3FN certificate")
    split_packets = [conic.load(path) for path in conic.SPLIT_PACKETS]
    primes = tuple(int(packet["field"]["prime"]) for packet in split_packets)
    require(primes == conic.EXPECTED_PRIMES, "split-prime order")

    fiber_rows: list[dict[str, object]] = []
    for packet_path, packet, prime in zip(
        conic.SPLIT_PACKETS, split_packets, primes, strict=True
    ):
        rows = {int(row["gamma_root"]): row for row in packet["root_kernels"]}
        for root in (int(value) for value in packet["field"]["roots"]):
            generators, _, _ = g3fe.extract_fiber(
                ROOT / rows[root]["kernel"]["path"], prime
            )
            bases: dict[int, np.ndarray] = {}
            hilbert: list[int] = []
            for degree in range(21):
                bases[degree], ideal_dimension = ideal_basis(
                    generators, degree, prime
                )
                hilbert.append(
                    len(graded.homogeneous_exponents(degree)) - ideal_dimension
                )
            require(tuple(hilbert) == EXPECTED_HILBERT_FUNCTION, "Hilbert function")

            socle = {
                degree: value
                for degree in range(11, 20)
                if (
                    value := socle_dimension(
                        bases[degree], bases[degree + 1], degree, prime
                    )
                )
            }
            require(socle == EXPECTED_SOCLE, "socle profile")
            betti_3 = {degree + 3: value for degree, value in socle.items()}
            numerator = hilbert_numerator(tuple(hilbert))
            betti_2 = betti_2_from_numerator(numerator, betti_3)
            require(betti_2 == EXPECTED_BETTI_2, "second Betti row")
            require(betti_3 == EXPECTED_BETTI_3, "third Betti row")

            fiber_rows.append(
                {
                    "prime": prime,
                    "gamma_root": root,
                    "hilbert_function_degrees0_through20": hilbert,
                    "length": sum(hilbert),
                    "socle_by_degree": {str(key): value for key, value in socle.items()},
                    "hilbert_numerator": {
                        str(key): value for key, value in numerator.items()
                    },
                }
            )
            print(
                f"G3FO p={prime} gamma={root}: length=656 "
