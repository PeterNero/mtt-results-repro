#!/usr/bin/env python3
"""Independently verify the G3DX/G3DY H02 localization and source theorem."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np
from sympy import Poly, expand, symbols, sympify

import build_ust_g3di_h02_split_algebra_kernel_relations as kernel_io


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3dy_h02_branch_sextic_square_source.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def checked(record: dict[str, Any], base: Path = ROOT) -> Path:
    path = base / record["path"]
    require(path.is_file(), f"missing {path}")
    require(path.stat().st_size == int(record["bytes"]), f"size {path.name}")
    require(sha256(path) == record["sha256"], f"hash {path.name}")
    return path


def checked_external(record: dict[str, Any]) -> Path:
    repository = ROOT.parent / record["repository"]
    path = repository / record["repository_relative_path"]
    require(path.is_file(), f"missing external {path}")
    require(path.stat().st_size == int(record["bytes"]), f"external size {path.name}")
    require(sha256(path) == record["sha256"], f"external hash {path.name}")
    return path


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (left, middle, degree - left - middle)
        for left in range(degree + 1)
        for middle in range(degree - left + 1)
    ]


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    local_inputs = {
        label: json.loads(checked(record).read_text(encoding="ascii"))
        for label, record in packet["inputs"].items()
        if "path" in record
    }
    require(all(all(value["checks"].values()) for value in local_inputs.values()), "local input checks")
    g3dx = local_inputs["G3DX"]
    ledger = g3dx["prefix_gap_localization"]
    rows = ledger["component_rows"]
    require(len(rows) == 34, "34 prefix rows")
    require(sum(int(row["structural_rank_increment"]) for row in rows) == 5223, "structural increments")
    require(sum(int(row["finite_rank_increment"]) for row in rows) == 4748, "finite increments")
    require(sum(int(row["gap_increment"]) for row in rows) == 475, "gap increments")
    require(rows[0]["dimension"] == 190 and rows[0]["finite_rank_increment"] == 162, "first prefix")
    require(rows[-1]["structural_prefix_rank"] == 29990 and rows[-1]["finite_prefix_rank"] == 29515, "final prefix ranks")
    checked(ledger["arrays"])

    source_arrays = np.load(checked(packet["evidence"]["arrays"]), allow_pickle=False)
    component_exponents = [tuple(int(value) for value in row) for row in source_arrays["component_exponents"]]
    degree6 = [tuple(int(value) for value in row) for row in source_arrays["degree6_multipliers"]]
    degree12 = [tuple(int(value) for value in row) for row in source_arrays["degree12_exponents"]]
    numerator = source_arrays["principal_macaulay_numerator"].astype(np.int64)
    dependents = source_arrays["component_dependent_coordinates"].astype(np.int32)
    transition_numerator = source_arrays["exact_transition_numerator"].astype(np.int64)
    require(len(component_exponents) == 190 and degree6 == homogeneous_exponents(6), "carrier bases")
    require(degree12 == homogeneous_exponents(12), "degree12 basis")
    require(numerator.shape == (190, 28) and dependents.size == 28, "principal map shape")
    require(np.array_equal(numerator[dependents, :], transition_numerator), "transition extraction")
    require(np.array_equal(np.diag(transition_numerator), np.full(28, 16)), "transition diagonal")
    require(np.count_nonzero(np.tril(transition_numerator, -1)) == 0, "transition triangularity")

    k3_path = checked_external(packet["inputs"]["q79_K3_base"])
    k3 = json.loads(k3_path.read_text(encoding="utf-8"))
    x, y, z = symbols("x y z")
    f6 = Poly(
        sympify(
            k3["explicit_K3"]["F6_equals_G3_squared_plus_Q2_H4"],
            locals={"x": x, "y": y, "z": z},
        ),
        x,
        y,
        z,
    )
    square = Poly(expand(f6.as_expr() ** 2), x, y, z)
    square_coefficients = np.asarray(
        [int(square.coeff_monomial(exponent)) for exponent in degree12], dtype=np.int64
    )
    require(np.array_equal(square_coefficients, source_arrays["F6_squared_numerators"]), "F6 square coefficients")
    lookup = {exponent: index for index, exponent in enumerate(component_exponents)}
    rebuilt = np.zeros((190, 28), dtype=np.int64)
    for column, multiplier in enumerate(degree6):
        for exponent, coefficient in zip(degree12, square_coefficients, strict=True):
            target = tuple(exponent[index] + multiplier[index] for index in range(3))
            rebuilt[lookup[target], column] = int(coefficient)
    require(np.array_equal(rebuilt, numerator), "principal source reconstruction")

    relation_mismatches = source_mismatches = 0
    root_count = 0
    for row in packet["finite_identification"]["root_rows"]:
        prime = int(row["prime"])
        payload = kernel_io.read_kernel(checked(row["kernel"]))
        columns = np.flatnonzero(payload["dependent"] < 190).astype(np.int32)
        require(columns.size == 28 and np.array_equal(payload["dependent"][columns], dependents), "finite component partition")
        matrix = payload["matrix"]
        for column in columns:
            first, past = matrix.indptr[column : column + 2]
            require(np.count_nonzero(matrix.indices[first:past] >= 190) == 0, "component support escape")
        normalized = matrix[:190, columns].toarray().astype(np.int64)
        principal = (numerator % prime) * pow(16, -1, prime) % prime
        transition = principal[dependents, :]
        relation_mismatches += int(np.count_nonzero((normalized @ transition - principal) % prime))
        root_count += 1
    require(root_count == 48 and relation_mismatches == 0, "48 relation-space replays")

    shifted_rows = np.asarray(
        [lookup[(left, middle, right + 6)] for left, middle, right in degree12], dtype=np.int32
    )
    for row in packet["finite_identification"]["archive_rows"]:
        prime = int(row["prime"])
        coefficients = np.load(checked(row["archive"]), allow_pickle=False)["coefficients"]
        observed = coefficients[:, shifted_rows, 0].astype(np.int64)
        expected = np.zeros((6, 91), dtype=np.int64)
        expected[0] = (square_coefficients % prime) * pow(16, -1, prime) % prime
        source_mismatches += int(np.count_nonzero(observed != expected))
        del coefficients, observed
    require(source_mismatches == 0, "eight source-archive replays")

    g3dw = json.loads(checked(g3dx["inputs"]["G3DW"]).read_text(encoding="ascii"))
    require(all(g3dw["checks"].values()), "G3DW checks")
    g3dv = json.loads(checked(g3dw["inputs"]["G3DV"]).read_text(encoding="ascii"))
    require(all(g3dv["checks"].values()), "G3DV checks")
    totals = g3dv["totals"]
    require(
        totals["entries"] == 46032168
        and totals["eighth_prime_holdout_passes"] == 36656107
        and totals["seven_prime_aliases"] == 5699180
        and totals["pass_nonzero"] == 250215,
        "final holdout totals",
    )
    print(
        "UST.G3DX/G3DY independent verification: PASS "
        "prefix_gap=475 component0=Sym18/(F6^2 Sym6) roots=48 mismatches=0"
    )


if __name__ == "__main__":
    main()
