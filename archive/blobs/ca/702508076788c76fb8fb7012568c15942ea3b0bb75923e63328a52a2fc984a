ROOT = Path(__file__).resolve().parent
G3BU = ROOT / "state" / "ust_g3bu_h02_endpoint_determinant_crt_campaign.packet.json"
G3BW = ROOT / "state" / "ust_g3bw_g3bi_h02_dm_woodbury_reduction.packet.json"
G3BZ = ROOT / "state" / "ust_g3bz_g3bi_h02_exact_path_update_rank.packet.json"
G3DE = ROOT / "state" / "ust_g3de_h02_fraction_free_path_woodbury.packet.json"
G3DI = ROOT / "state" / "ust_g3di_h02_split_algebra_kernel_relations.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3dj"
OUT = ROOT / "state" / "ust_g3dj_h02_second_prime_kernel_relations.packet.json"
PRIME = 33863
ROOTS = (3590, 4184, 6574, 9630, 19465, 24259)
UPDATE_START = 24767
UPDATE_DIMENSION = 6022
KERNEL_DIMENSION = 1274
COUPLING_RANK = 4748


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def normalize(matrix: sparse.spmatrix) -> sparse.csc_matrix:
    value = matrix.tocsc().astype(np.int64)
    value.sum_duplicates()
    value.data %= PRIME
    value.eliminate_zeros()
    return value.astype(np.uint32)


def evaluate(records: list[dict[str, Any]], root: int) -> sparse.csr_matrix:
    matrices = [
        sparse.load_npz(ROOT / row["path"]).tocsr().astype(np.int64)
        for row in records
    ]
    result = sparse.csr_matrix(matrices[0].shape, dtype=np.int64)
    power = 1
    for matrix in matrices:
        result = result + matrix * power
        power = power * root % PRIME
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def interpolate(values: np.ndarray) -> np.ndarray:
    vandermonde = np.asarray(
        [[pow(root, degree, PRIME) for degree in range(6)] for root in ROOTS],
        dtype=np.int64,
    )
    augmented = np.concatenate((vandermonde, np.eye(6, dtype=np.int64)), axis=1)
    for column in range(6):
        choices = np.flatnonzero(augmented[column:, column] % PRIME)
        require(choices.size > 0, "Vandermonde pivot")
        selected = column + int(choices[0])
        if selected != column:
            augmented[[column, selected]] = augmented[[selected, column]]
        augmented[column] = augmented[column] * pow(int(augmented[column, column] % PRIME), -1, PRIME) % PRIME
        for row in range(6):
            if row == column:
                continue
            factor = int(augmented[row, column] % PRIME)
            if factor:
                augmented[row] = (augmented[row] - factor * augmented[column]) % PRIME
    inverse = augmented[:, 6:].astype(np.uint64)
    coefficients = np.empty(values.shape, dtype=np.uint16)
    for degree in range(6):
        accumulator = np.zeros(values.shape[1:], dtype=np.uint64)
        for root_index in range(6):
            accumulator += values[root_index].astype(np.uint64) * inverse[degree, root_index]
            accumulator %= PRIME
        coefficients[degree] = accumulator.astype(np.uint16)
    return coefficients


def evaluate_dense(coefficients: np.ndarray, root: int) -> np.ndarray:
    value = coefficients[-1].astype(np.uint64)
    for degree in reversed(range(5)):
        value = (value * root + coefficients[degree]) % PRIME
    return value.astype(np.uint16)


def main() -> None:
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import export_q79_eta9_split_prime_selected_chart as exporter

    g3bu = load(G3BU)
    g3bw = load(G3BW)
    g3bz = load(G3BZ)
    g3de = load(G3DE)
    g3di = load(G3DI)
    for packet, label in ((g3bu, "G3BU"), (g3bw, "G3BW"), (g3bz, "G3BZ"), (g3de, "G3DE"), (g3di, "G3DI")):
        require(all(packet["checks"].values()), f"{label} checks")
    prime_record = next(row for row in g3bu["prime_residues"] if int(row["prime"]) == PRIME)
    require(tuple(prime_record["roots"]) == ROOTS, "second-prime roots")
    endpoints = {int(row["gamma_root"]): row for row in prime_record["root_solves"]}

    dm = np.load(ROOT / g3bw["DM_reduction"]["arrays"]["path"], allow_pickle=False)
    core = 17597
    core_rows = np.flatnonzero(dm["component_by_row"] == core).astype(np.int32)
    core_columns = np.flatnonzero(dm["component_by_column"] == core).astype(np.int32)
    require(core_rows.size == core_columns.size == UPDATE_START, "core dimensions")
    delta_records = g3bz["affine_path_update"]["exact_gamma_coefficient_matrices"]
    u_records = g3de["factorization"]["U_gamma_coefficients"]
    w_records = g3de["factorization"]["W_gamma_coefficients"]
    first_selection = np.load(
        ROOT / g3di["split_algebra_kernel"]["selection"]["path"], allow_pickle=False
    )
    selected_reference = first_selection["selected_update_columns"].astype(np.int32)
    dependent_reference = first_selection["dependent_update_columns"].astype(np.int32)

    source = ROOT / g3di["inputs"]["kernel_tool_source"]["path"]
    executable = ROOT / g3di["inputs"]["kernel_tool_executable"]["path"]
    require(sha256(source) == g3di["inputs"]["kernel_tool_source"]["sha256"], "kernel source hash")
    require(sha256(executable) == g3di["inputs"]["kernel_tool_executable"]["sha256"], "kernel executable hash")
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    root_payloads: list[dict[str, Any]] = []
    matrices: list[sparse.csc_matrix] = []
    for index, root in enumerate(ROOTS, start=1):
        print(f"G3DJ root {index}/6 gamma={root}: constructing second-prime border", flush=True)
        endpoint_path = ROOT / endpoints[root]["endpoint_chart"]["path"]
        require(sha256(endpoint_path) == endpoints[root]["endpoint_chart"]["sha256"], "endpoint hash")
        endpoint = split_io.as_scipy(
            arithmetic.read_csc(endpoint_path, b"MTTSPC1\0", 6)
        ).tocsc().astype(np.int64)
        delta = evaluate(delta_records, root)
        u = evaluate(u_records, root)
        w = evaluate(w_records, root)
        base = normalize(endpoint[dm["complement_rows"], :][:, 248:] - delta)
        a_core = normalize(base[core_rows, :][:, core_columns])
        u_core = normalize(u[core_rows, :])
        w_core = normalize(w[:, core_columns])
        outside = np.ones(u.shape[0], dtype=bool)
        outside[core_rows] = False
        require(u[outside, :].nnz == 0, "U core support")
        border = normalize(
            sparse.bmat(
                [[a_core, u_core], [w_core, sparse.csc_matrix((UPDATE_DIMENSION, UPDATE_DIMENSION), dtype=np.uint32)]],
                format="csc",
            )
        )
        border_path = EVIDENCE / f"H02.B89.bordered_Q.p{PRIME}.g{root}.chart.bin"
        exporter.write_chart(
            border_path,
            PRIME,
            border.shape[0],
            0,
            border.shape[0],
            border.indptr.astype(np.uint64).tolist(),
            border.indices.astype(np.uint32).tolist(),
            border.data.astype(np.uint32).tolist(),
        )
        kernel_path = EVIDENCE / f"H02.Q_kernel.p{PRIME}.g{root}.bin"
        log_path = EVIDENCE / f"H02.Q_kernel.p{PRIME}.g{root}.log"
        completed = subprocess.run(
            [
                "wsl",
                runtime.wsl_path(executable),
                "--chart",
                runtime.wsl_path(border_path),
                "--kernel",
                runtime.wsl_path(kernel_path),
                "--log",
                runtime.wsl_path(log_path),
                "--update-start",
                str(UPDATE_START),
                "--progress-seconds",
                "20",
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        require(completed.returncode == 0, completed.stdout + completed.stderr)
        fields = rank_runtime.initializer.parse_log(log_path)
        require(int(fields["RANK"]) == UPDATE_START + COUPLING_RANK, "second-prime border rank")
        require(int(fields["VERIFIED_RELATIONS"]) == KERNEL_DIMENSION, "second-prime verified relations")
        payload = first_prime.read_kernel(kernel_path)
        require(np.array_equal(payload["selected"], selected_reference), "same selected columns across primes")
        require(np.array_equal(payload["dependent"], dependent_reference), "same dependent columns across primes")
        matrices.append(payload["matrix"])
        root_payloads.append(
            {
                "gamma_root": root,
                "endpoint_chart": record(endpoint_path),
                "border_chart": record(border_path),
                "kernel": record(kernel_path),
                "kernel_log": record(log_path),
                "kernel_nonzero_entries": int(payload["matrix"].nnz),
                "solver_stdout": completed.stdout.strip(),
            }
        )
        print(f"G3DJ gamma={root}: rank=4748 kernel_nnz={payload['matrix'].nnz}", flush=True)

    values = np.stack(
        [matrix.toarray().astype(np.uint16, copy=False) for matrix in matrices], axis=0
    )
    coefficients = interpolate(values)
    mismatches = sum(
        int(np.count_nonzero(evaluate_dense(coefficients, root) != values[index]))
        for index, root in enumerate(ROOTS)
    )
    require(mismatches == 0, "second-prime interpolation")
    power_path = EVIDENCE / "H02.Q_kernel.p33863.power_basis.u16.npz"
    np.savez_compressed(power_path, coefficients=coefficients)
    del values, coefficients

    checks = {
        "G3BU_G3BW_G3BZ_G3DE_and_G3DI_are_hash_bound_and_passing": True,
        "all_six_roots_of_the_independent_split_prime33863_are_executed": True,
        "all_six_second_prime_couplings_have_rank4748_and1274_verified_relations": True,
        "the_selected_and_dependent_column_partition_is_identical_across_both_rational_primes": True,
        "six_root_interpolation_emits_the_complete_second_split_algebra_kernel": mismatches == 0,
        "the_two_prime_CRT_modulus_is738789071_but_no_height_bound_is_claimed": PRIME * 21817 == 738789071,
        "no_characteristic_zero_relation_or_rank_upper_bound_is_inferred_yet": True,
        "no_Archimedean_value_source_path_observed_value_or_fit_is_used": True,
    }
    require(all(checks.values()), "G3DJ checks")
    packet = {
        "schema": "mtt.unified-source.g3dj-h02-second-prime-kernel-relations.v1",
        "date": "2026-08-14",
        "theorem_id": "UST.G3DJ",
        "status": "CLOSED_EXACT_H02_SECOND_SPLIT_PRIME_1274_KERNEL_RELATIONS",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {"G3BU": record(G3BU), "G3BW": record(G3BW), "G3BZ": record(G3BZ), "G3DE": record(G3DE), "G3DI": record(G3DI)},
        "field": {"prime": PRIME, "roots": list(ROOTS), "algebra": "F_33863[gamma]/(m_gamma) is the product over the six roots"},
        "root_kernels": root_payloads,
        "second_split_algebra_kernel": {
            "shape": [UPDATE_DIMENSION, KERNEL_DIMENSION],
            "rank": KERNEL_DIMENSION,
            "coupling_rank": COUPLING_RANK,
            "power_basis_coefficients": record(power_path),
            "power_basis_shape": [6, UPDATE_DIMENSION, KERNEL_DIMENSION],
            "interpolation_evaluation_mismatches": mismatches,
            "same_selection_as_G3DI": True,
        },
        "multiprime_promotion": {
            "primes": [21817, PRIME],
            "CRT_modulus": 21817 * PRIME,
            "CRT_modulus_bits": (21817 * PRIME).bit_length(),
            "height_bound_available": False,
            "exact_Q_gamma_promotion": False,
        },
        "checks": checks,
        "guardrails": {
            "claims_the_relations_lift_to_Q_gamma": False,
            "claims_rank_Q_gamma_Q_equals4748": False,
            "claims_Archimedean_values_source_contraction_path_integration_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3djH02SecondPrimeKernelRelations",
            "tier": "CLOSED_EXACT_SECOND_COMPLETE_SPLIT_ALGEBRA_KERNEL",
            "statement": "At every root of the independent completely split prime 33863, the selected H02 coupling again has rank 4748 and the exact kernel compiler emits 1274 normalized zero-residual relations. The selected/dependent coordinate partition is identical to G3DI at prime 21817. The complete degree-less-than-six second-prime kernel is persisted. Thus the defect is neither root-specific nor specific to one rational prime, while characteristic-zero promotion still requires reconstruction with a bound or direct exact verification.",
        },
        "frontier_delta": {
            "before": "G3DI materialized the complete kernel only modulo one rational prime.",
            "after": "The same normalized 1274-relation kernel dimension and coordinate partition are closed over a second independent split algebra. The next wall is coefficient reconstruction and exact Q(gamma) identity verification, not another rank or support search.",
        },
        "next_required_object": "CRT-combine the two normalized power-basis kernels, add independent split primes until rational reconstruction stabilizes under holdout, derive a valid coefficient-height bound or direct exact candidate verification, and then promote the 1274 relations to Q(gamma).",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3DJ H02 second-prime kernel relations: PASS")
    print(f"six_ranks=4748 kernel=6022x1274 CRT_modulus={21817 * PRIME}")
    print(f"packet_sha256={sha256(OUT)}")


