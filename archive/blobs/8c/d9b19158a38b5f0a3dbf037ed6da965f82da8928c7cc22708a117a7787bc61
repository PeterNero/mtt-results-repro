#!/usr/bin/env python3
"""Run the restartable exact complement export and full-matrix assembly."""

from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import json
from pathlib import Path
import subprocess
import sys

import assemble_ust_g3ap_selected_cayley_target_macaulay_full_reuse as assembler
import build_ust_g3ap_selected_cayley_target_macaulay_complement_chunk as chunk


ROOT = Path(__file__).resolve().parent


def current(index: int, count: int) -> bool:
    paths = chunk.paths(index, count)
    if not paths["packet"].is_file() or not paths["triples"].is_file():
        return False
    try:
        packet = json.loads(paths["packet"].read_text(encoding="ascii"))
        return (
            packet.get("schema")
            == "mtt.unified-source.g3ap-selected-cayley-target-macaulay-complement-chunk.v1"
            and all(packet.get("checks", {}).values())
            and not any(packet.get("guardrails", {}).values())
            and packet["selection"]["chunk_index"] == index
            and packet["selection"]["chunk_count"] == count
            and packet["execution"]["packed_triples"]["sha256"]
            == chunk.sha256(paths["triples"])
        )
    except (KeyError, OSError, ValueError, json.JSONDecodeError):
        return False


def execute(index: int, count: int, timeout: int, reuse: bool) -> str:
    if reuse and current(index, count):
        return f"G3AP complement chunk: REUSE chunk={index + 1}/{count}"
    completed = subprocess.run(
        [
            sys.executable,
            str(ROOT / "build_ust_g3ap_selected_cayley_target_macaulay_complement_chunk.py"),
            "--chunk-index",
            str(index),
            "--chunk-count",
            str(count),
            "--timeout",
            str(timeout),
        ],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(
            f"complement chunk {index + 1}/{count} failed:\n{completed.stdout[-4000:]}"
        )
    return completed.stdout.strip()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--chunk-count", type=int, default=12)
    parser.add_argument("--workers", type=int, default=4)
    parser.add_argument("--timeout-per-chunk", type=int, default=43_200)
    parser.add_argument("--index-start", type=int, default=0)
    parser.add_argument("--index-stop", type=int, default=0)
    parser.add_argument("--no-assemble", action="store_true")
    parser.add_argument("--no-reuse", action="store_true")
    args = parser.parse_args()
    stop = args.index_stop or args.chunk_count
    if not (
        1 <= args.workers <= args.chunk_count <= 64
        and 0 <= args.index_start < stop <= args.chunk_count
    ):
        raise AssertionError("worker/chunk bounds")

    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = {
            pool.submit(
                execute,
                index,
                args.chunk_count,
                args.timeout_per_chunk,
                not args.no_reuse,
            ): index
            for index in range(args.index_start, stop)
        }
        for future in as_completed(futures):
            print(future.result(), flush=True)

    if args.no_assemble:
        print("G3AP COMPLEMENT CHUNK RANGE COMPLETE", flush=True)
        return

    subprocess.run(
        [
            sys.executable,
            str(ROOT / "assemble_ust_g3ap_selected_cayley_target_macaulay_full_reuse.py"),
            "--chunk-count",
            str(args.chunk_count),
        ],
        cwd=ROOT,
        check=True,
    )
    packet = json.loads(assembler.PACKET.read_text(encoding="ascii"))
    if packet["matrix"]["rows"] != chunk.FULL_ROWS:
        raise AssertionError("full matrix row count")
    print("G3AP FULL COMPLEMENT CAMPAIGN COMPLETE", flush=True)


if __name__ == "__main__":
    main()
