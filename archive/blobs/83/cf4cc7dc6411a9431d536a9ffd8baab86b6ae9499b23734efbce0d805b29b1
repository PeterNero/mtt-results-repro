            "column_basis": basis,
            "matrix_sha256": canonical_hash(matrix_rows),
            "rhs_sha256": canonical_hash([list(value) for value in rhs]),
            "rank": len(pivots),
            "pivot_columns": pivots,
            "nullity": len(basis) - len(pivots),
            "canonical_rule": "RREF in displayed column order with every free variable set to zero",
            "consistent": True,
        },
        "canonical_correction": {
            "sparse_rows": sparse_correction,
            "nonzero_coefficient_count": len(sparse_correction),
            "full_solution_sha256": canonical_hash([list(value) for value in correction]),
            "matrix_times_correction_equals_negative_G3AD_obstruction": True,
        },
        "joint_lift_result": {
            "coefficient_formula": "F_joint=F_Q+101*delta_F mod 101^2",
            "selected_second_H_graph_unchanged_from_G3AD": True,
            "restriction_zero_mod1012": True,
            "all_32_restriction_rows_zero_mod1012": True,
        },
        "theorem": {
