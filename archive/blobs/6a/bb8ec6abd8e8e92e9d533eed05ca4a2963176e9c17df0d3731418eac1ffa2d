#!/usr/bin/env python3
"""Independently verify the G3AU adjoint normal-first reduction."""

from __future__ import annotations

from fractions import Fraction
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
PACKET = STATE / "ust_g3au_adjoint_normal_first_obstruction.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def multiply(left: list[list[Fraction]], right: list[list[Fraction]]) -> list[list[Fraction]]:
    return [
        [sum((left[i][k] * right[k][j] for k in range(len(right))), Fraction(0)) for j in range(len(right[0]))]
        for i in range(len(left))
    ]


def exact_associativity_test() -> None:
    normal = [[Fraction(1), Fraction(-2), Fraction(0), Fraction(3)],
              [Fraction(0), Fraction(1), Fraction(4), Fraction(-1)]]
    frame = [[Fraction(1), Fraction(2), Fraction(0)],
             [Fraction(-1), Fraction(0), Fraction(3)],
             [Fraction(2), Fraction(1), Fraction(1)],
             [Fraction(0), Fraction(-2), Fraction(1)]]
    period = [[Fraction(1), Fraction(0)],
              [Fraction(2), Fraction(1)],
              [Fraction(-1), Fraction(3)]]
    source = [[Fraction(5)], [Fraction(-2)]]
    beta_b103 = multiply(period, source)
    beta_g3al = multiply(frame, beta_b103)
    direct = multiply(normal, beta_g3al)
    pulled_b103 = multiply(multiply(normal, frame), beta_b103)
    pulled_source = multiply(multiply(multiply(normal, frame), period), source)
    require(direct == pulled_b103 == pulled_source, "adjoint associativity")
    require(any(value != 0 for row in direct for value in row), "nonzero obstruction witness")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--upstream-g3as-verified-in-caller", action="store_true")
    parser.add_argument("--upstream-g3at-verified-in-caller", action="store_true")
    args = parser.parse_args()
    if not args.upstream_g3as_verified_in_caller:
        subprocess.run(
            [sys.executable, str(ROOT / "verify_ust_g3as_selected_finite_normal_operator.py")],
            cwd=ROOT,
            check=True,
        )
    if not args.upstream_g3at_verified_in_caller:
        subprocess.run(
            [sys.executable, str(ROOT / "verify_ust_g3at_polarized_primal_transport.py")],
            cwd=ROOT,
            check=True,
        )

    packet = load(PACKET)
    require(packet["schema"] == "mtt.unified-source.g3au-adjoint-normal-first-obstruction.v1", "schema")
    require(packet["theorem_id"] == "UST.G3AU", "theorem id")
    require(
        packet["status"] == "CLOSED_EXACT_ADJOINT_NORMAL_FIRST_OBSTRUCTION_REDUCTION_126_ROWS",
        "status",
    )
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    for name in ("G3AS", "G3AT", "G3AR_contract"):
        item = packet["inputs"][name]
        path = ROOT / item["path"]
        require(path.is_file() and sha256(path) == item["sha256"], f"input {name}")
        require(path.stat().st_size == item["bytes"], f"input bytes {name}")
    g3as = load(ROOT / packet["inputs"]["G3AS"]["path"])
    require(g3as["factorization"]["Nfull_shape"] == [126, 248], "actual G3AS shape")
    require(g3as["factorization"]["Nfull_rank"] == 126, "actual G3AS rank")
    normal_binary = packet["inputs"]["G3AS_normal_binary"]
    path = ROOT / normal_binary["path"]
    require(path.is_file() and sha256(path) == normal_binary["sha256"], "actual G3AS binary")
    decision = packet["adaptive_decision"]
    require(decision["full_beta_coordinate_count"] == 248, "beta row count")
    require(decision["maximum_normal_rows_before_obstruction_or_survival"] == 126, "normal row count")
    require(decision["rows_not_materialized_on_the_maximal_early_test"] == 122, "avoided output rows")
    require(decision["full_to_normal_output_ratio"] == "124/63", "exact output ratio")
    exact_associativity_test()
    print("UST.G3AU adjoint normal-first obstruction: PASS 248 rows -> at most 126 rows")
    print("nonzero exits immediately; all-zero remains a G3AR survivor, not endpoint closure")


if __name__ == "__main__":
    main()
