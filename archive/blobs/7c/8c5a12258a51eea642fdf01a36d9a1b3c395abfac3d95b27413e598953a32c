def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def source_monomials(degree: int) -> list[tuple[int, int, int]]:
    """Reproduce the locked B67 coefficient order without an adjacent-repo import."""
    return [
        (x_power, y_power, degree - x_power - y_power)
        for x_power in reversed(range(degree + 1))
        for y_power in reversed(range(degree - x_power + 1))
    ]


def coefficient_add(
    left: tuple[int, ...], right: tuple[int, ...]
) -> tuple[int, ...]:
    return tuple(a + b for a, b in zip(left, right, strict=True))


def add_term(
    target: dict[tuple[int, int, int], tuple[int, ...]],
    exponent: tuple[int, int, int],
    coefficient: tuple[int, ...],
) -> None:
    updated = coefficient_add(target.get(exponent, (0,) * 6), coefficient)
    if any(updated):
        target[exponent] = updated
    else:
        target.pop(exponent, None)


def restricted_coefficient(
    coefficients: list[list[int]], theta: int
) -> dict[tuple[int, int, int], tuple[int, ...]]:
    """Return A_theta(x,y,z,w=-G3) as a degree-nine Q(gamma) polynomial."""
    result: dict[tuple[int, int, int], tuple[int, ...]] = {}
    offset = 83 * theta
    for local, exponent in enumerate(source_monomials(9)):
        add_term(result, exponent, tuple(int(value) for value in coefficients[offset + local]))
    for local, exponent in enumerate(source_monomials(6)):
        value = tuple(int(raw) for raw in coefficients[offset + 55 + local])
        for g3_exponent, g3_coefficient in G3_TERMS.items():
            product = tuple(
                exponent[index] + g3_exponent[index] for index in range(3)
            )
            add_term(result, product, tuple(-g3_coefficient * raw for raw in value))
    return result


def exact_conic_quotient(
    coefficients: list[list[int]],
) -> tuple[np.ndarray, dict[tuple[int, int, int], tuple[int, ...]]]:
    """Factor (A0-A1)|_{w=-G3}=(xz-y^2)D7 coefficientwise over Q(gamma)."""
    left = restricted_coefficient(coefficients, 0)
    right = restricted_coefficient(coefficients, 1)
    difference: dict[tuple[int, int, int], tuple[int, ...]] = {}
    for exponent in set(left) | set(right):
        add_term(
            difference,
            exponent,
            tuple(
                left.get(exponent, (0,) * 6)[index]
                - right.get(exponent, (0,) * 6)[index]
                for index in range(6)
            ),
        )

    x, y, z = sp.symbols("x y z")
    conic = sp.Poly(x * z - y**2, x, y, z, domain=sp.ZZ)
    quotients: list[sp.Poly] = []
    for coordinate in range(6):
        polynomial = sp.Poly(
            sum(
                value[coordinate]
                * x ** exponent[0]
                * y ** exponent[1]
                * z ** exponent[2]
                for exponent, value in difference.items()
            ),
            x,
            y,
            z,
            domain=sp.ZZ,
        )
        quotient, remainder = sp.div(polynomial, conic)
        require(remainder.is_zero, f"exact conic divisibility coordinate{coordinate}")
        require(quotient.total_degree() == 7, f"degree-seven quotient coordinate{coordinate}")
        require(polynomial == conic * quotient, f"literal quotient replay coordinate{coordinate}")
        quotients.append(quotient)

    basis7 = graded.homogeneous_exponents(7)
    rows = np.asarray(
        [
            [
                int(
                    quotient.coeff_monomial(
                        x ** exponent[0] * y ** exponent[1] * z ** exponent[2]
                    )
                )
                for quotient in quotients
            ]
            for exponent in basis7
        ],
        dtype=np.int64,
    )
    require(rows.shape == (36, 6), "D7 coefficient shape")
    require(np.count_nonzero(np.any(rows != 0, axis=1)) == 35, "D7 support")
    return rows, difference


def conic_power_matrix(power: int, prime: int | None = None) -> np.ndarray:
    source_degree = 15 - 2 * power
    source = graded.homogeneous_exponents(source_degree)
    target = graded.homogeneous_exponents(15)
    lookup = {exponent: index for index, exponent in enumerate(target)}
    matrix = np.zeros((136, len(source)), dtype=np.int64)
    for column, exponent in enumerate(source):
        for y_pair_count in range(power + 1):
            shifted = list(exponent)
            shifted[0] += power - y_pair_count
            shifted[1] += 2 * y_pair_count
            shifted[2] += power - y_pair_count
            matrix[lookup[tuple(shifted)], column] += (
                math.comb(power, y_pair_count) * (-1) ** y_pair_count
            )
    return matrix if prime is None else matrix % prime


def component_kernel(row: dict[str, object], prime: int) -> np.ndarray:
    path = ROOT / row["kernel"]["path"]
    require(path.is_file(), f"kernel exists: {path}")
    require(sha256(path) == row["kernel"]["sha256"], f"kernel hash: {path.name}")
    payload = kernel_runtime.read_kernel(path)
    require(payload["prime"] == prime, "kernel prime")
    dependent = payload["dependent"]
    selected = np.flatnonzero(
        (dependent >= DEPENDENT_START) & (dependent < DEPENDENT_PAST)
    )
    kernel = (
        payload["matrix"][COMPONENT_START:COMPONENT_PAST, :][:, selected]
        .toarray()
        .astype(np.int64)
        % prime
    )
    require(kernel.shape == (136, 100), "canonical component kernel shape")
    require(graded.rref(kernel, prime)[0] == 100, "canonical component kernel rank")
    return kernel


