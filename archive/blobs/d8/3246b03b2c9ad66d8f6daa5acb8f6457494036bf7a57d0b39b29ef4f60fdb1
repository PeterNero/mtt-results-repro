        "exact_nonzero_entries_over_Q_gamma": exact_nonzeros,
        "good_reduction_nonzero_entries": reduced_nonzeros,
        "canonical_exact_source_sha256": exact_digest.hexdigest(),
        "canonical_good_reduction_source_sha256": reduced_digest.hexdigest(),
        "sample_entries": sample,
        "return_contract": "apply the bound toric Griffiths-Dwork pole6-to-pole5 targeted transform and recursive divergence",
        "return_executed": False,
    }


def main() -> None:
    mld = resolve_mld()
    g3bi = load(G3BI)
    g3bj = load(G3BJ)
    require(all(g3bi["checks"].values()), "G3BI checks")
    require(all(g3bj["checks"].values()), "G3BJ checks")
    require(g3bj["selected_path"]["formula"] == "a(t)=1-t+i*pi*t*(1-t)", "G3BJ path")

    paths = {
        "B103": mld / "q79_eta9_full_vanishing_residue_basis.packet.json",
        "H20_characteristic_zero_resolvent": mld
        / "q79_eta9_characteristic_zero_H20_family_resolvent.packet.json",
        "three_block_characteristic_zero_chart_oracle": mld
        / "q79_eta9_characteristic_zero_three_block_chart_oracle.packet.json",
        "toric_Griffiths_Dwork_contract": mld
        / "q79_eta9_toric_griffiths_dwork_contract.packet.json",
    }
    for target in TARGETS:
        paths[f"{target}_Macaulay"] = mld / f"q79_eta9_original_jacobian_macaulay_{target}.packet.json"
        paths[f"{target}_factorization"] = mld / f"q79_eta9_original_jacobian_coordinate_factorization_{target}.packet.json"
    paths["H20_CSC"] = mld / "q79_eta9_original_jacobian_macaulay_H20_csc.packet.json"
    packets = {name: load(path) for name, path in paths.items()}
    for name, packet in packets.items():
        if "checks" in packet:
            require(all(packet["checks"].values()), f"{name} checks")

    terms = correction_terms(g3bi)
    require(sum(row["mod11"] != 0 for row in terms) == 18, "18 surviving good-reduction terms")
    derivatives = derivative_generators(terms)
    derivative_counts = {
        variable: len(derivatives[index]) for index, variable in enumerate(VARIABLES)
    }
    require(derivative_counts == {"x": 16, "y": 9, "z": 16, "w": 0, "t0": 18, "t1": 0, "t2": 0, "u": 0, "v": 0, "s": 18}, "correction derivative counts")

    h20_resolvent = packets["H20_characteristic_zero_resolvent"]
    h20_macaulay = packets["H20_Macaulay"]
    h20_csc = packets["H20_CSC"]
    h20_target = [
        tuple(int(value) for value in row)
        for row in h20_macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    h20_lookup = {row: index for index, row in enumerate(h20_target)}
    quotient_rows = {int(value) for value in h20_csc["binary"]["quotient_unit_rows"]}
    residual_rows = [row for row in range(len(h20_target)) if row not in quotient_rows]
    left_covector = [
        int(value)
        for value in h20_resolvent["selected_H20_chart"]["primitive_left_null_covector_on_complement"]
    ]
    require(len(residual_rows) == len(left_covector) == 34, "H20 complement covector")
    correction_vector = [[[0] * 6][0] for _ in h20_target]
    for term in terms:
        row = h20_lookup.get(tuple(term["F_exponent"]))
        require(row is not None, "correction F term in H20 ambient basis")
        correction_vector[row] = [int(value) for value in term["coefficients"]]
    numerator = [
        sum(left_covector[index] * correction_vector[row][power] for index, row in enumerate(residual_rows))
        for power in range(6)
    ]
    denominator = [
        int(value)
        for value in h20_resolvent["chart_determinant_ratio"]["D_coefficients_ascending"]
    ]
    require(numerator == [3261, 1627, -611, -3170, -827, 2917], "exact correction numerator")
    require(denominator == [-335, 547, 1304, 627, 443, -407], "frozen H20 denominator")
    endpoint_sum = [a + b for a, b in zip(denominator, numerator)]
    require(any(numerator) and any(denominator) and any(endpoint_sum), "nonzero H20 field elements")
    require(evaluate_mod11(numerator) == 9, "correction alpha numerator mod11")
    require(evaluate_mod11(denominator) == 8, "H20 denominator mod11")
    require(evaluate_mod11(endpoint_sum) == 6, "start endpoint chart remains a unit at the proof prime")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    target_summaries: dict[str, Any] = {}
    for target in TARGETS:
        macaulay = packets[f"{target}_Macaulay"]
        factor = packets[f"{target}_factorization"]
        matrix = build_update(macaulay, factor, derivatives)
        matrix_path = EVIDENCE / f"g3bk_correction_family_update_{target}.npz"
        certificate_path = EVIDENCE / f"g3bk_correction_family_update_{target}.certificate.npz"
        sparse.save_npz(matrix_path, matrix, compressed=True)
        structural, arrays = structural_certificate(matrix)
        exact_rank, component_ranks = componentwise_rank_mod_prime(
            matrix, arrays["bipartite_component_labels"]
        )
        require(
            exact_rank <= int(structural["structural_rank_upper_bound"]),
            "algebraic rank below structural rank",
        )
        structural["exact_algebraic_rank_mod11"] = exact_rank
        structural["characteristic_zero_rank_lower_bound"] = exact_rank
        structural["component_ranks_mod11"] = component_ranks
        np.savez_compressed(certificate_path, **arrays)
        selected_by_generator = {name: 0 for name in VARIABLES}
        for generator, _ in selected_column_descriptors(macaulay, factor):
            selected_by_generator[VARIABLES[generator]] += 1
        target_summaries[target] = {
            "selected_columns_by_original_partial": selected_by_generator,
            "good_reduction_update": structural,
            "matrix": local_record(matrix_path),
            "matching_cover_certificate": local_record(certificate_path),
        }

    require(target_summaries["H20"]["good_reduction_update"]["nonzero_columns"] == 1, "rank-one H20 support")
