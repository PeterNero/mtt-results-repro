#!/usr/bin/env python3
"""Independently verify the exact G3CE Hodge-block Schur reduction."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

import numpy as np


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ce_hodge_schur_affine_reduction.packet.json"
PRIME = 11


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def determinant_mod_prime(matrix: np.ndarray) -> int:
    """Compute a square determinant by a fresh GF(11) elimination."""
    work = np.asarray(matrix, dtype=np.int64).copy() % PRIME
    require(work.ndim == 2 and work.shape[0] == work.shape[1], "square determinant")
    determinant = 1
    size = work.shape[0]
    for column in range(size):
        candidates = np.flatnonzero(work[column:, column])
        if candidates.size == 0:
            return 0
        selected = column + int(candidates[0])
        if selected != column:
            work[[column, selected]] = work[[selected, column]]
            determinant = -determinant
        pivot = int(work[column, column])
        determinant = determinant * pivot % PRIME
        inverse = pow(pivot, -1, PRIME)
        work[column, column:] = work[column, column:] * inverse % PRIME
        if column + 1 < size:
            factors = work[column + 1 :, column].copy()
            active = np.flatnonzero(factors)
            if active.size:
                target = column + 1 + active
                work[target, column:] = (
                    work[target, column:]
                    - factors[active, None] * work[column, column:]
                ) % PRIME
    return determinant % PRIME


def normalized(vector: np.ndarray, label: str) -> np.ndarray:
    result = np.asarray(vector, dtype=np.int64) % PRIME
    support = np.flatnonzero(result)
    require(support.size > 0, f"{label} nonzero")
    require(int(result[support[0]]) == 1, f"{label} normalization")
    return result


def main() -> None:
    packet = load(PACKET)
    require(
        packet["schema"] == "mtt.unified-source.g3ce-hodge-schur-affine-reduction.v1",
        "schema",
    )
    require(packet["theorem_id"] == "UST.G3CE", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")

    g3cd_path = verify_record(packet["input"])
    g3cd = load(g3cd_path)
    require(
        g3cd["schema"] == "mtt.unified-source.g3cd-correction-full-affine-operator.v1",
        "G3CD schema",
    )
    require(all(g3cd["checks"].values()), "G3CD checks")
    require(not any(g3cd["guardrails"].values()), "G3CD guardrails")

    matrix_path = verify_record(g3cd["correction_operator"]["dense_uint8"])
    source_path = verify_record(g3cd["selected_affine_source"]["source_vector"])
    full_right_path = verify_record(
        g3cd["selected_affine_source"]["right_kernel"]["vector"]
    )
    full_left_path = verify_record(
        g3cd["selected_affine_source"]["left_cokernel"]["vector"]
    )
    matrix = np.fromfile(matrix_path, dtype=np.uint8).reshape(1509, 1509).astype(np.int64)
    source = np.load(source_path, allow_pickle=False).astype(np.int64)
    full_right = normalized(np.load(full_right_path, allow_pickle=False), "full right kernel")
    full_left = normalized(np.load(full_left_path, allow_pickle=False), "full left cokernel")

    lower_response_path = verify_record(packet["block_decomposition"]["lower_response"])
    lower_source_path = verify_record(
        packet["block_decomposition"]["lower_selected_source_solution"]
    )
    schur_path = verify_record(packet["schur_operator"]["operator"])
    effective_source_path = verify_record(packet["effective_affine_source"]["source"])
    schur_right_path = verify_record(packet["schur_operator"]["right_kernel"])
    schur_left_path = verify_record(packet["schur_operator"]["left_cokernel"])
    affine_path = verify_record(packet["effective_affine_source"]["affine_operator"])
    minor_path = verify_record(packet["schur_operator"]["rank247_minor"]["certificate"])

    lower_response = np.load(lower_response_path, allow_pickle=False).astype(np.int64)
    lower_source = np.load(lower_source_path, allow_pickle=False).astype(np.int64)
    schur = np.load(schur_path, allow_pickle=False).astype(np.int64)
    effective_source = np.load(effective_source_path, allow_pickle=False).astype(np.int64)
    schur_right = normalized(
        np.load(schur_right_path, allow_pickle=False), "Schur right kernel"
    )
    schur_left = normalized(
        np.load(schur_left_path, allow_pickle=False), "Schur left cokernel"
    )
    affine = np.load(affine_path, allow_pickle=False).astype(np.int64)

    top = 248
    A = matrix[:top, :top] % PRIME
    U = matrix[:top, top:] % PRIME
    L = matrix[top:, :top] % PRIME
    J = matrix[top:, top:] % PRIME
    b_lower = source[top:] % PRIME
    require(matrix.shape == (1509, 1509), "full matrix shape")
    require(source.shape == (1509,), "full source shape")
    require(not np.any(source[:top] % PRIME), "source top block")
    require(J.shape == (1261, 1261), "lower block shape")
    require(lower_response.shape == (1261, 248), "lower response shape")
    require(lower_source.shape == (1261,), "lower source shape")

    determinant_j = determinant_mod_prime(J)
    require(
        determinant_j
        == int(packet["block_decomposition"]["lower_block_determinant_mod11"])
        == 4,
        "lower-block determinant",
    )
    require(not np.any((J @ lower_response - L) % PRIME), "J lower-response identity")
    require(not np.any((J @ lower_source - b_lower) % PRIME), "J source identity")

    expected_schur = (A - U @ lower_response) % PRIME
    expected_source = (-U @ lower_source) % PRIME
    require(np.array_equal(schur % PRIME, expected_schur), "Schur reconstruction")
    require(
        np.array_equal(effective_source % PRIME, expected_source),
        "effective-source reconstruction",
    )
    require(schur.shape == (248, 248), "Schur shape")
    require(effective_source.shape == (248,), "effective source shape")
    require(not np.any(schur @ schur_right % PRIME), "Schur right identity")
    require(not np.any(schur_left @ schur % PRIME), "Schur left identity")

    with np.load(minor_path, allow_pickle=False) as certificate:
        rows = certificate["rows"].astype(np.int64)
        columns = certificate["columns"].astype(np.int64)
    require(rows.shape == columns.shape == (247,), "rank-minor index shape")
    require(np.unique(rows).size == np.unique(columns).size == 247, "rank-minor indices")
    minor_determinant = determinant_mod_prime(schur[np.ix_(rows, columns)])
    require(
        minor_determinant
        == int(packet["schur_operator"]["rank247_minor"]["determinant_mod11"])
        != 0,
        "rank-247 minor",
    )

    obstruction = int(schur_left @ effective_source % PRIME)
    require(
        obstruction
        == int(packet["effective_affine_source"]["obstruction_pairing_mod11"])
        == 2,
        "Schur obstruction pairing",
    )
    expected_affine = np.zeros((249, 249), dtype=np.int64)
    expected_affine[:248, :248] = schur % PRIME
    expected_affine[:248, 248] = effective_source % PRIME
    require(np.array_equal(affine % PRIME, expected_affine), "affine payload")
    augmented_minor = np.column_stack([schur[:, columns], effective_source])
    affine_minor_determinant = determinant_mod_prime(augmented_minor)
    require(affine_minor_determinant != 0, "rank-248 affine minor")
    require(
        int(packet["effective_affine_source"]["affine_rank_mod11"]) == 248,
        "affine rank record",
    )

    reconstructed_right = np.concatenate(
        [schur_right, (-lower_response @ schur_right) % PRIME]
    )
    require(np.array_equal(reconstructed_right, full_right), "full right reconstruction")
    require(not np.any(matrix @ reconstructed_right % PRIME), "full right identity")

    require(np.array_equal(full_left[:top], schur_left), "full left top block")
    require(
        not np.any((J.T @ (-full_left[top:] % PRIME) - U.T @ schur_left) % PRIME),
        "unique full left reconstruction",
    )
    require(not np.any(full_left @ matrix % PRIME), "full left identity")
    full_pairing = int(full_left @ source % PRIME)
    require(full_pairing == obstruction == 2, "full/reduced pairing identity")

    print("UST.G3CE Hodge Schur affine reduction verifier: PASS")
    print(
        f"detJ={determinant_j} rankS=247 minor_det={minor_determinant} "
        f"affine_minor_det={affine_minor_determinant} obstruction={obstruction}"
    )


if __name__ == "__main__":
    main()
