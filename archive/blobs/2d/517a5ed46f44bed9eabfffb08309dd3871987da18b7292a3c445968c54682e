def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, object]:
    require(path.is_file(), f"external artifact exists: {path}")
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def homogeneous_exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (a, b, degree - a - b)
        for a in range(degree + 1)
        for b in range(degree - a + 1)
    ]


def source_polynomial(
    coefficients: list[list[int]], theta: int, coordinate: int
) -> sp.Poly:
    x, y, z, w = sp.symbols("x y z w")
    offset = 83 * theta
    expression = sum(
        int(coefficients[offset + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(g3ff_runtime.source_monomials(9))
    )
    expression += w * sum(
        int(coefficients[offset + 55 + local][coordinate])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(g3ff_runtime.source_monomials(6))
    )
    return sp.Poly(expression, x, y, z, w, domain=sp.ZZ)


def exterior_incidence() -> tuple[np.ndarray, np.ndarray]:
    wedge = np.zeros((4, 16, 16), dtype=np.int8)
    contraction = np.zeros((4, 16, 16), dtype=np.int8)
    for index in range(4):
        lower_mask = (1 << index) - 1
        for source in range(16):
            sign = -1 if (source & lower_mask).bit_count() % 2 else 1
            if not source & (1 << index):
                wedge[index, source | (1 << index), source] = sign
            if source & (1 << index):
                contraction[index, source ^ (1 << index), source] = sign
    return wedge, contraction


def main() -> None:
    g3bi = load(G3BI)
    g3fi = load(G3FI)
    g3fj = load(G3FJ)
    pdelta = load(PDELTA)
    for label, packet in (("G3BI", g3bi), ("G3FI", g3fi), ("G3FJ", g3fj)):
        require(all(packet["checks"].values()), f"{label} checks")
    require(all(pdelta["checks"].values()), "Pdelta checks")

    normal_path = ROOT / g3fj["matrix_factorization"]["artifact"]["path"]
    require(
        sha256(normal_path) == g3fj["matrix_factorization"]["artifact"]["sha256"],
        "G3FJ artifact hash",
    )
    normal = np.load(normal_path, allow_pickle=False)
    b6_rows = normal["B6_gamma_coordinates"].astype(np.int64)
    d7_rows = normal["D7_gamma_coordinates"].astype(np.int64)
    h4_rows = normal["H4_coefficients"].astype(np.int64)

    x, y, z, w, t0, t1, t2, u, v, s = sp.symbols(
        "x y z w t0 t1 t2 u v s"
    )
    q = x * z - y**2
    g3 = sum(
        coefficient * x ** exponent[0] * y ** exponent[1] * z ** exponent[2]
        for exponent, coefficient in g3ff_runtime.G3_TERMS.items()
    )
    r = w + g3
    rbar = w - g3
    ell = t0 + t1
    qe = t0**2 - t0 * t1 + t1**2
    h4 = sum(
        int(h4_rows[local])
        * x ** exponent[0]
        * y ** exponent[1]
        * z ** exponent[2]
        for local, exponent in enumerate(homogeneous_exponents(4))
    )
    k3 = sp.expand(r * rbar + q * h4)
    elliptic = t0**3 + t1**3 + t2**3
    require(sp.expand(ell * qe + t2 * t2**2 - elliptic) == 0, "Fermat point decomposition")

    coefficients = g3bi["selected_source"]["coefficient_vectors"]
    a = [
        [source_polynomial(coefficients, theta, coordinate).as_expr() for coordinate in range(6)]
        for theta in range(3)
    ]
    b6 = [
        sum(
            int(b6_rows[local, coordinate])
            * x ** exponent[0]
            * y ** exponent[1]
            * z ** exponent[2]
            for local, exponent in enumerate(homogeneous_exponents(6))
        )
        for coordinate in range(6)
    ]
    d7 = [
        sum(
            int(d7_rows[local, coordinate])
            * x ** exponent[0]
            * y ** exponent[1]
            * z ** exponent[2]
            for local, exponent in enumerate(homogeneous_exponents(7))
        )
        for coordinate in range(6)
    ]

    eta9_coordinates: list[sp.Expr] = []
    source_coordinates: list[sp.Expr] = []
    potential_coordinates: list[sp.Expr] = []
    factorized_potential_coordinates: list[sp.Expr] = []
    for coordinate in range(6):
        eta9 = sp.expand(t0 * a[0][coordinate] + t1 * a[1][coordinate] + t2 * a[2][coordinate])
        source_eta9 = sp.expand(
            q * t0 * d7[coordinate]
            + r * t0 * b6[coordinate]
            + ell * a[1][coordinate]
            + t2 * a[2][coordinate]
        )
        require(sp.expand(eta9 - source_eta9) == 0, f"eta9 four-normal coordinate {coordinate}")
        eta9_coordinates.append(eta9)
        source_coordinates.append(source_eta9)

        potential = sp.expand(s * eta9)
        if coordinate == 0:
            potential += u * k3 + v * elliptic
        factorized = sp.expand(
            q * (u * h4 + s * t0 * d7[coordinate] if coordinate == 0 else s * t0 * d7[coordinate])
            + r * (u * rbar + s * t0 * b6[coordinate] if coordinate == 0 else s * t0 * b6[coordinate])
            + ell * (v * qe + s * a[1][coordinate] if coordinate == 0 else s * a[1][coordinate])
            + t2 * (v * t2**2 + s * a[2][coordinate] if coordinate == 0 else s * a[2][coordinate])
        )
        require(sp.expand(potential - factorized) == 0, f"Cayley source coordinate {coordinate}")
        potential_coordinates.append(sp.expand(potential))
        factorized_potential_coordinates.append(factorized)

    # Reconcile the selected K3 normal pair with the already certified residue
    # representative of the splitting-conic class.
    jacobian = sp.Matrix(
        [
            [sp.diff(polynomial, variable) for variable in (x, y, z, w)]
            for polynomial in (q, h4, rbar, r)
        ]
    )
    determinant = sp.expand(jacobian.det())
    pdelta_exact = sp.sympify(
        pdelta["residue_polynomial"]["expanded"],
        locals={"x": x, "y": y, "z": z, "w": w},
    )
    require(sp.expand(determinant - 6 * pdelta_exact) == 0, "Pdelta determinant normalization")

    wedge, contraction = exterior_incidence()
    identity16 = np.eye(16, dtype=np.int8)
    zero16 = np.zeros((16, 16), dtype=np.int8)
    for i in range(4):
        for j in range(4):
            require(
                np.array_equal(wedge[i] @ wedge[j] + wedge[j] @ wedge[i], zero16),
                f"wedge anticommutator {i},{j}",
            )
            require(
                np.array_equal(
                    contraction[i] @ contraction[j]
                    + contraction[j] @ contraction[i],
                    zero16,
                ),
                f"contraction anticommutator {i},{j}",
            )
            mixed = wedge[i] @ contraction[j] + contraction[j] @ wedge[i]
            require(
                np.array_equal(mixed, identity16 if i == j else zero16),
                f"Clifford mixed relation {i},{j}",
            )
    even_masks = np.asarray([mask for mask in range(16) if mask.bit_count() % 2 == 0], dtype=np.int8)
    odd_masks = np.asarray([mask for mask in range(16) if mask.bit_count() % 2 == 1], dtype=np.int8)
    require(even_masks.size == odd_masks.size == 8, "8+8 parity split")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(
        CLIFFORD,
        wedge=wedge,
        contraction=contraction,
        even_masks=even_masks,
        odd_masks=odd_masks,
        H4_coefficients=h4_rows,
        B6_gamma_coordinates=b6_rows,
        D7_gamma_coordinates=d7_rows,
    )

