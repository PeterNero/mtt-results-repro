#!/usr/bin/env python3
"""Independently replay the G3DG H02 bordered-rank certificate."""

from __future__ import annotations

import hashlib
import json
import struct
import subprocess
import tempfile
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse
from scipy.sparse.csgraph import maximum_bipartite_matching

import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3dg_h02_split_place_full_coupling_rank.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def checked_path(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"missing {path}")
    require(path.stat().st_size == int(record["bytes"]), f"size {path.name}")
    require(sha256(path) == record["sha256"], f"hash {path.name}")
    return path


def parse_log(path: Path) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition(" ")
        if separator:
            fields[key] = value.strip()
    return fields


def read_chart(path: Path) -> tuple[int, sparse.csc_matrix]:
    raw = path.read_bytes()
    require(raw[:8] == b"MTTSPC1\0", "chart magic")
    prime, rows, columns, nonzeros, _, _ = struct.unpack_from("<6Q", raw, 8)
    offset = 8 + 6 * 8
    indptr = np.frombuffer(raw, dtype="<u8", count=columns + 1, offset=offset).copy()
    offset += (columns + 1) * 8
    indices = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset).copy()
    offset += nonzeros * 4
    data = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset).copy()
    matrix = sparse.csc_matrix((data, indices, indptr), shape=(rows, columns))
    require(matrix.has_canonical_format, "canonical chart CSC")
    return int(prime), matrix


def write_unit_rhs(path: Path, prime: int, rows: int) -> None:
    with path.open("wb") as handle:
        handle.write(b"MTTSRH1\0")
        handle.write(struct.pack("<4Q", prime, rows, 1, 1))
        handle.write(np.asarray([0, 1], dtype="<u8").tobytes())
        handle.write(np.asarray([0], dtype="<u4").tobytes())
        handle.write(np.asarray([1], dtype="<u4").tobytes())


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(all(packet["checks"].values()), "packet checks")
    core = packet["core"]
    coupling = packet["bordered_coupling"]
    core_chart = checked_path(core["chart"])
    checked_path(core["determinant_log"])
    border_chart = checked_path(coupling["chart"])
    checked_path(coupling["rank_log"])
    rank_source = checked_path(packet["inputs"]["rank_tool_source"])
    rank_executable = checked_path(packet["inputs"]["rank_tool_executable"])
    require(rank_source.name == "ust_split_prime_sparse_rank.cpp", "rank source name")

    mld = runtime.resolve_mld()
    split_solver = mld / packet["inputs"]["split_prime_solver"]["repository_relative_path"]
    require(split_solver.is_file(), "split-prime solver")
    require(sha256(split_solver) == packet["inputs"]["split_prime_solver"]["sha256"], "solver hash")

    with tempfile.TemporaryDirectory(prefix="ust_g3dg_verify_") as temporary:
        temp = Path(temporary)
        rhs = temp / "unit.rhs.bin"
        determinant_log = temp / "core.det.log"
        prime, core_matrix = read_chart(core_chart)
        require((prime, core_matrix.shape, core_matrix.nnz) == (21817, (24767, 24767), 1796760), "core archive")
        write_unit_rhs(rhs, prime, core_matrix.shape[0])
        determinant_run = subprocess.run(
            [
                "wsl",
                runtime.wsl_path(split_solver),
                "--chart",
                runtime.wsl_path(core_chart),
                "--rhs",
                runtime.wsl_path(rhs),
                "--log",
                runtime.wsl_path(determinant_log),
                "--determinant-only",
            ],
            cwd=mld,
            capture_output=True,
            text=True,
            check=False,
        )
        require(determinant_run.returncode == 0, determinant_run.stdout + determinant_run.stderr)
        determinant_fields = parse_log(determinant_log)
        require(int(determinant_fields["CHART_DETERMINANT"]) == int(core["determinant_mod21817"]) == 349, "core determinant replay")

        rank_log = temp / "border.rank.log"
        rank_run = subprocess.run(
            [
                "wsl",
                runtime.wsl_path(rank_executable),
                "--chart",
                runtime.wsl_path(border_chart),
                "--log",
                runtime.wsl_path(rank_log),
                "--progress-seconds",
                "60",
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        require(rank_run.returncode == 0, rank_run.stdout + rank_run.stderr)
        rank_fields = parse_log(rank_log)
        require(int(rank_fields["RANK"]) == int(coupling["border_rank_over_F21817"]) == 29515, "border rank replay")

    border_prime, border = read_chart(border_chart)
    require((border_prime, border.shape, border.nnz) == (21817, (30789, 30789), 1990851), "border archive")
    matching = maximum_bipartite_matching(border.astype(bool).tocsr(), perm_type="column")
    structural_rank = int(np.count_nonzero(matching >= 0))
    finite_q_rank = int(coupling["border_rank_over_F21817"]) - 24767
    structural_q_upper = structural_rank - 24767
    require((finite_q_rank, structural_q_upper) == (4748, 5223), "Q rank interval replay")
    require(
        coupling["Q_rank_over_Q_gamma_lower_bound"] == finite_q_rank
        and coupling["Q_rank_over_Q_gamma_upper_bound"] == structural_q_upper,
        "packet interval",
    )
    require(packet["guardrails"]["claims_the_exact_Q_gamma_rank_is_decided"] is False, "rank guardrail")
    require(packet["guardrails"]["claims_Q_values_are_materialized"] is False, "value guardrail")
    print(
        "UST.G3DG independent verification: PASS "
        f"core_det=349 finite_Q_rank={finite_q_rank} structural_Q_upper={structural_q_upper}"
    )


if __name__ == "__main__":
    main()
