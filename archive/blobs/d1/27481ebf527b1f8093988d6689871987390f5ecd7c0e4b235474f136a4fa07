#!/usr/bin/env python3
"""Optional WSL flatter candidate-reduction backend."""

from __future__ import annotations

import os
import re
import subprocess


def reduce_flatter(
    lattice: list[list[int]],
    delta: float,
) -> list[list[int]]:
    rows = len(lattice)
    columns = len(lattice[0])
    encoded = "[" + "\n".join(
        "[" + " ".join(str(value) for value in row) + " ]" for row in lattice
    ) + "\n]\n"
    binary = os.environ.get("UST_FLATTER_BIN", "flatter")
    completed = subprocess.run(
        ["wsl.exe", binary, "-delta", str(delta)],
        input=encoded,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(f"flatter failed: {completed.stderr[-2000:]}")
    values = [int(value) for value in re.findall(r"-?\d+", completed.stdout)]
    if len(values) != rows * columns:
        raise RuntimeError(
            f"flatter output shape: expected {rows * columns}, got {len(values)}"
        )
    return [
        values[index * columns : (index + 1) * columns]
        for index in range(rows)
    ]
