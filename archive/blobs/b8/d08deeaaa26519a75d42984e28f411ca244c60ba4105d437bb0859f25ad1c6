#!/usr/bin/env python3
"""Run an untrusted Hilbert-guided G3AP quotient-module hedge.

The predecessor Hilbert numerator is used only to accelerate ``std``.  Both
the cached base basis and the resulting quotient-module basis remain
untrusted until the independent certification program reconstructs them.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import time

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import run_ust_g3ap_selected_cayley_fiber2_hilbert_hedge as guided
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
SOURCE = fiber2.SOURCE
HINT = guided.HINT
BASE_CACHE = qring.BASE_CACHE
SCRIPT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_hilbert_guided.sing"
OUTPUT = STATE / "ust_g3ap_selected_cayley_fiber2_qring_hilbert_guided.singular.out"
MODULE_CACHE = STATE / "ust_g3ap_selected_cayley_fiber2_qring_hilbert_guided_degree44.ssi"
PACKET = STATE / "ust_g3ap_selected_cayley_fiber2_qring_hilbert_guided.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def guided_qring_script(
    source: str,
    hilbert: list[int],
    module_cache: Path = MODULE_CACHE,
) -> str:
    generators = ",\n  ".join(qring.derivative_generators())
    representatives_before, representatives_after = qring.derivative_representatives()
    hint = ",".join(str(value) for value in hilbert)
    base_relative = str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(module_cache.relative_to(ROOT)).replace("\\", "/")
    return fiber2.selected_base_prefix(source) + f'''option(noredTail);
{representatives_before}
def cachedIdeal=read("ssi:r {base_relative}");
ideal GI=cachedIdeal;
int i;
print("G3AP_F2_QHGUIDE_BASE_IS_SB_ATTR="+string(attrib(GI,"isSB")));
print("G3AP_F2_QHGUIDE_BASE_GB_SIZE="+string(size(GI)));
for (i=1;i<=size(GI);i++)
{{ print("G3AP_F2_QHGUIDE_BASE_LEADER_"+string(i)+"_EXP="+string(leadexp(GI[i]))); }}
attrib(GI,"isSB",1);
qring q=GI;
{representatives_after}
module M=
  {generators};
intvec componentShifts=12,15,8,18,11,4;
attrib(M,"isHomog",componentShifts);
bigintvec predecessorHilbert={hint};
intvec selectedWeights=1,1,1,3,1,1,1;
degBound=44;
module G=std(M,predecessorHilbert,selectedWeights);
print("G3AP_F2_QHGUIDE_BOUND="+string(degBound));
print("G3AP_F2_QHGUIDE_MODULE_GENERATORS="+string(size(M)));
print("G3AP_F2_QHGUIDE_MODULE_GB_SIZE="+string(size(G)));
for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_QHGUIDE_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_QHGUIDE_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isSB",0);
write("ssi:w {module_relative}",G);
print("G3AP_F2_QHGUIDE_LEADER_EXPORT_PASS");
quit;
'''


def parse_leaders(
    raw: str,
) -> tuple[list[tuple[int, ...]], list[tuple[int, tuple[int, ...]]]]:
    normalized = raw.replace("G3AP_F2_QHGUIDE_", "G3AP_F2_QRING_")
    return qring.parse_leaders(normalized)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    require(BASE_CACHE.is_file() and BASE_CACHE.stat().st_size > 0, "base cache")
    hint_packet, hilbert = guided.load_hint()
    source = SOURCE.read_text(encoding="ascii")
    SCRIPT.write_text(guided_qring_script(source, hilbert), encoding="ascii")
    if args.emit_only:
        print(f"emitted {SCRIPT.relative_to(ROOT)}")
        return
    MODULE_CACHE.unlink(missing_ok=True)
    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, "quotient Hilbert-guided execution")
    require("G3AP_F2_QHGUIDE_LEADER_EXPORT_PASS" in completed.stdout, "guided pass")
    require(MODULE_CACHE.is_file() and MODULE_CACHE.stat().st_size > 0, "guided module cache")
    base, module = parse_leaders(completed.stdout)
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(total == fiber2.EXPECTED_TOTAL, "complete target enumeration")
    require(standards == [fiber2.EXPECTED_STANDARD], "candidate unique top standard")
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-hilbert-guided-candidate.v1",
        "date": "2026-08-10",
        "status": "CANDIDATE_REQUIRES_INDEPENDENT_BASE_AND_SELECTED_SOURCE_CERTIFICATION",
        "inputs": {
            "selected_source": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            },
            "predecessor_hint": {
                "path": str(HINT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(HINT),
            },
            "untrusted_base_cache": {
                "path": str(BASE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(BASE_CACHE),
                "bytes": BASE_CACHE.stat().st_size,
                "isSB_trust_attribute_stored": False,
            },
        },
        "execution": {
            "script": {
                "path": str(SCRIPT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SCRIPT),
            },
            "output": {
                "path": str(OUTPUT.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(OUTPUT),
            },
            "returncode": completed.returncode,
            "elapsed_seconds": time.time() - started,
            "base_basis_size": len(base),
            "module_generator_count": 21,
            "candidate_basis_size_through_bound": len(module),
            "scalar_degree_bound": 44,
            "candidate_module_cache": {
                "path": str(MODULE_CACHE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(MODULE_CACHE),
                "bytes": MODULE_CACHE.stat().st_size,
                "valid_through_base_scalar_degree": 44,
                "isSB_trust_attribute_stored": False,
            },
        },
        "fiber_degree_two_module": {
            "base_quotient": "B/(K,E,C)",
            "components": [name for _, name, _, _ in fiber2.COMPONENTS],
            "component_scalar_shifts": [shift for _, _, _, shift in fiber2.COMPONENTS],
            "sectors": sectors,
        },
        "candidate_top_piece": {
            "Cox_degree": [18, 2, 2],
            "scalar_weight": 44,
            "enumerated_monomials": total,
            "dimension_if_candidate_is_certified": 1,
            "basis_if_candidate_is_certified": ["w^12*t2^4*s^2"],
        },
        "checks": {
            "selected_source_is_hash_bound": True,
            "predecessor_is_used_only_as_a_Hilbert_acceleration_hint": True,
            "all_21_selected_quotient_module_generators_are_supplied_to_std": True,
            "all_174865_target_monomials_are_enumerated": True,
            "candidate_leading_module_leaves_one_target_standard": True,
        },
        "guardrails": {
            "claims_the_loaded_base_cache_is_independently_certified": False,
            "claims_the_predecessor_hint_proves_selected_flatness": False,
            "claims_the_candidate_module_is_independently_certified": False,
            "claims_G3AP_is_closed": False,
            "claims_response_rank_or_beta_C_is_computed": False,
        },
        "next_required_object": (
            "Reconstruct B/(K,E,C), recompute std on the untrusted module candidate "
            "without the Hilbert hint, and reduce all 21 selected generators."
        ),
        "acceleration_hint_sha256": hashlib.sha256(
            json.dumps(hint_packet["fiber_degree_two"]["hilbert_numerator"]).encode("ascii")
        ).hexdigest(),
    }
    PACKET.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(
        "G3AP fiber2 qring Hilbert-guided candidate: PASS "
        f"base={len(base)} module={len(module)} monomials={total} certification=OPEN"
    )


if __name__ == "__main__":
    main()
