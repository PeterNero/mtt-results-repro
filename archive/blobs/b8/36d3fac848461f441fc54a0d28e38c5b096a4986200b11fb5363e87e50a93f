        "theorem_id": "UST.G3DI",
        "status": "CLOSED_EXACT_H02_SPLIT_ALGEBRA_1274_KERNEL_RELATIONS",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
