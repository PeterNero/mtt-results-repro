            "exact_recovery_rows": 800,
            "literal_exact_audit_rows": 400,
            "exact_rank": exact_subsystem_rank,
            "exact_nullity": exact_subsystem_nullity,
            "free_coordinate_identity_checked_by_native_replay": True,
            "literal_selected_audit_residual_nonzero_slots": 0,
            "combined_selected_row_residual_nonzero_slots": 0,
        },
        "residual_adjudication": {
            "exact_defect_rows": len(exact_source_rows),
            "exact_defect_source_rows_zero_based": exact_source_rows,
            "exact_nonzero_slots": exact_nonzero_slots,
