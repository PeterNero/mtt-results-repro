def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path, *, repository: Path = ROOT) -> dict[str, Any]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    require(path.is_file(), f"external artifact exists: {path}")
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def exponents(degree: int) -> list[tuple[int, int, int]]:
    return [
        (x_power, y_power, degree - x_power - y_power)
        for x_power in range(degree + 1)
        for y_power in range(degree - x_power + 1)
    ]


def inverse_mod(matrix: np.ndarray, prime: int) -> np.ndarray:
    matrix = np.asarray(matrix, dtype=np.int64) % prime
    require(matrix.ndim == 2 and matrix.shape[0] == matrix.shape[1], "square inverse input")
    size = matrix.shape[0]
    work = np.concatenate((matrix.copy(), np.eye(size, dtype=np.int64)), axis=1)
    for column in range(size):
        choices = np.flatnonzero(work[column:, column])
        require(choices.size > 0, "invertible pivot")
        selected = column + int(choices[0])
        if selected != column:
            work[[column, selected]] = work[[selected, column]]
        work[column] = work[column] * pow(int(work[column, column]), -1, prime) % prime
        for row in range(size):
            if row != column and work[row, column]:
                work[row] = (work[row] - int(work[row, column]) * work[column]) % prime
    require(np.array_equal(work[:, :size], np.eye(size, dtype=np.int64)), "inverse replay")
    return work[:, size:] % prime


def determinant_mod(matrix: np.ndarray, prime: int) -> int:
    work = np.asarray(matrix, dtype=np.int64).copy() % prime
    require(work.ndim == 2 and work.shape[0] == work.shape[1], "square determinant input")
    result = 1
    sign = 1
    for column in range(work.shape[0]):
        choices = np.flatnonzero(work[column:, column])
        if choices.size == 0:
            return 0
        selected = column + int(choices[0])
        if selected != column:
            work[[column, selected]] = work[[selected, column]]
            sign = -sign
        pivot = int(work[column, column])
        result = result * pivot % prime
        inverse = pow(pivot, -1, prime)
        for row in range(column + 1, work.shape[0]):
            if work[row, column]:
                factor = int(work[row, column]) * inverse % prime
                work[row, column:] = (work[row, column:] - factor * work[column, column:]) % prime
    return result if sign > 0 else (-result) % prime


def selected_component_rows(
    g3de: dict[str, Any], mld: Path
) -> tuple[np.ndarray, np.ndarray, Path, Path, Path]:
    sys.path.insert(0, str(mld))
    import build_q79_eta9_family_macaulay_update as family_update

    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H02.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H02.packet.json"
    macaulay = load(macaulay_path)
    factor = load(factor_path)
    require(all(macaulay["checks"].values()), "H02 Macaulay checks")
    selected_original = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_original)
    require(len(descriptors) == COMPLEMENT_DIMENSION, "42,458 selected descriptor rows")

    selection_path = ROOT / g3de["factorization"]["selection"]["path"]
    require(
        selection_path.is_file()
        and sha256(selection_path) == g3de["factorization"]["selection"]["sha256"],
        "G3DE selection hash",
    )
    selected_updates = np.load(selection_path, allow_pickle=False)["selected_columns"].astype(np.int64)
    require(selected_updates.shape == (6022,), "6,022 selected update columns")
    component_columns = selected_updates[COMPONENT_START:COMPONENT_PAST]
    require(component_columns.shape == (COMPONENT_DIMENSION,), "136 component columns")
    require(np.unique(component_columns).size == COMPONENT_DIMENSION, "unique component columns")

    basis15 = exponents(15)
    for local, exponent in enumerate(basis15):
        generator, multiplier = descriptors[int(component_columns[local])]
        require(generator == EXPECTED_GENERATOR, f"component generator local={local}")
        require(tuple(multiplier[:3]) == exponent, f"component exponent local={local}")
        require(tuple(multiplier[3:]) == EXPECTED_TAIL, f"component tail local={local}")
    solution_rows = QUOTIENT_DIMENSION + component_columns
    require(np.all(solution_rows < AMBIENT_DIMENSION), "component solution-row bounds")
    return component_columns, solution_rows, selection_path, macaulay_path, factor_path


def read_solution(path: Path, mld: Path) -> np.ndarray:
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic

    solution = split_io.as_scipy(
        arithmetic.read_csc(path, b"MTTSCO1\0", 6)
    ).tocsc()
    require(solution.shape == (AMBIENT_DIMENSION, SOURCE_DIMENSION), "chart solution shape")
    return solution


def target_plane() -> tuple[np.ndarray, int, int]:
    arrays = np.load(G3FR_ARRAYS, allow_pickle=False)
    primes = arrays["primes"].astype(np.int64)
    roots = arrays["roots"].astype(np.int64)
    prime_positions = np.flatnonzero(primes == PRIME)
    require(prime_positions.size == 1, "unique anchor prime")
    prime_index = int(prime_positions[0])
    root_positions = np.flatnonzero(roots[prime_index] == ROOT_VALUE)
    require(root_positions.size == 1, "unique anchor root")
    root_index = int(root_positions[0])
    target = arrays["degree15_primitives"][prime_index, root_index].astype(np.int64) % PRIME
    require(target.shape == (COMPONENT_DIMENSION, SOURCE_DIMENSION), "G3FR target shape")
    return target, prime_index, root_index


def comparison(projected: np.ndarray, target: np.ndarray) -> dict[str, Any]:
    projected = np.asarray(projected, dtype=np.int64) % PRIME
    target = np.asarray(target, dtype=np.int64) % PRIME
    projected_rank = graded.rref(projected, PRIME)[0]
    target_rank = graded.rref(target, PRIME)[0]
    joint_rank = graded.rref(np.concatenate((projected, target), axis=1), PRIME)[0]
    target_row_rank, pivot_rows, _ = graded.rref(target.T, PRIME)
    require(target_row_rank == SOURCE_DIMENSION and len(pivot_rows) == SOURCE_DIMENSION, "target pivot rows")
    pivot_array = np.asarray(pivot_rows, dtype=np.int64)
    transfer = inverse_mod(target[pivot_array, :], PRIME) @ projected[pivot_array, :] % PRIME
    residual = (target @ transfer - projected) % PRIME
    transfer_rank = graded.rref(transfer, PRIME)[0]
    transfer_determinant = determinant_mod(transfer, PRIME)
    equal = (
        projected_rank == SOURCE_DIMENSION
        and target_rank == SOURCE_DIMENSION
        and joint_rank == SOURCE_DIMENSION
        and np.count_nonzero(residual) == 0
        and transfer_rank == SOURCE_DIMENSION
        and transfer_determinant != 0
    )
    return {
        "projected_rank": projected_rank,
        "target_rank": target_rank,
        "joint_rank": joint_rank,
        "target_pivot_rows": pivot_array,
        "transfer": transfer,
        "transfer_rank": transfer_rank,
        "transfer_determinant": transfer_determinant,
        "residual": residual,
        "residual_nonzeros": int(np.count_nonzero(residual)),
        "planes_equal": equal,
    }


