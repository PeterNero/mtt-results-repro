@cache
def q79_support_stratified_spectral_strain_boundary_hessian() -> dict[
    str, Any
]:
    prior = q79_intrinsic_spectral_strain_quotient_shorted_hessian_cutset()

    edge_names = ("z_12", "z_20", "z_01")
    source_hessian = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(1),
            Fraction(4),
            Fraction(1),
            Fraction(4),
            Fraction(1),
            Fraction(4),
            Fraction(1),
        ]
    )
    reduced_green = diagonal(
        [
            Fraction(1),
            Fraction(1),
            Fraction(1),
            Fraction(1, 4),
            Fraction(1),
            Fraction(1, 4),
            Fraction(1),
            Fraction(1, 4),
            Fraction(1),
        ]
    )
    lane_quarterturn = jde()

    def apply_matrix(
        matrix: list[list[Fraction]], vector: list[Fraction]
    ) -> list[Fraction]:
        return [
            sum(
                (entry * vector[column] for column, entry in enumerate(row)),
                Fraction(0),
            )
            for row in matrix
        ]

    def support_key(mask: int) -> str:
        return "".join(
            "1" if mask & (1 << edge) else "0"
            for edge in range(3)
        )

    def in_tangent_cone(
        vector: list[Fraction], support: tuple[int, ...]
    ) -> bool:
        return all(
            vector[3 + edge] >= 0
            for edge in range(3)
            if edge not in support
        )

    support_strata: dict[str, Any] = {}
    rank_distribution: dict[str, int] = {}
    stratum_checks: dict[str, bool] = {}
    jet_checks: dict[str, bool] = {}
    shorting_checks: dict[str, bool] = {}
    c4_checks: dict[str, bool] = {}
    boundary_scaling_checks: dict[str, bool] = {}

    t_witness = Fraction(1, 2)
    source_cost_witness = Fraction(1, 2) * t_witness**2
    target_normal_witness = t_witness**2
    ordinary_quadratic_target_witness = (
        Fraction(1, 2) * target_normal_witness**2
    )
    stratified_linear_target_witness = (
        Fraction(1, 2) * target_normal_witness
    )

    for mask in range(8):
        key = support_key(mask)
        support = tuple(
            edge for edge in range(3) if mask & (1 << edge)
        )
        absent = tuple(
            edge for edge in range(3) if edge not in support
        )
        support_size = len(support)
        rank_distribution[str(support_size)] = (
            rank_distribution.get(str(support_size), 0) + 1
        )

        jacobian = zeros(6, 9)
        for diagonal_index in range(3):
            jacobian[diagonal_index][diagonal_index] = Fraction(1)
        for edge in support:
            jacobian[3 + edge][3 + 2 * edge] = Fraction(2)

        tangent_rows = [0, 1, 2] + [3 + edge for edge in support]
        tangent_jacobian = [jacobian[row] for row in tangent_rows]
        tangent_covariance = mul(
            mul(tangent_jacobian, reduced_green),
            transpose(tangent_jacobian),
        )
        horizontal_lift = mul(
            reduced_green,
            transpose(tangent_jacobian),
        )
        full_covariance = mul(
            mul(jacobian, reduced_green),
            transpose(jacobian),
        )

        tangent_is_vector_space = not absent
        c4_compatible_targets = ["111"] if not absent else []
        c4_counterexample: dict[str, Any] | None = None
        if absent:
            witness = [Fraction(0) for _ in range(6)]
            witness[absent[0]] = Fraction(-1)
            image = apply_matrix(lane_quarterturn, witness)
            c4_counterexample = {
                "source_vector": [str(value) for value in witness],
                "image_vector": [str(value) for value in image],
                "source_is_in_tangent_cone": in_tangent_cone(
                    witness, support
                ),
                "image_is_in_same_tangent_cone": in_tangent_cone(
                    image, support
                ),
            }

        row_checks = {
            "Jacobian_rank_is_3_plus_support_size": (
                rank(jacobian) == 3 + support_size
            ),
            "ambient_kernel_dimension_is_6_minus_support_size": (
                9 - rank(jacobian) == 6 - support_size
            ),
            "tangent_covariance_is_identity": (
                tangent_covariance == eye(3 + support_size)
            ),
            "horizontal_lift_is_a_tangent_right_inverse": (
                mul(tangent_jacobian, horizontal_lift)
                == eye(3 + support_size)
            ),
            "horizontal_lift_solves_the_tangent_Euler_Lagrange_equation": (
                mul(source_hessian, horizontal_lift)
                == transpose(tangent_jacobian)
            ),
            "full_covariance_rank_matches_the_stratum": (
                rank(full_covariance) == 3 + support_size
            ),
            "complete_relative_phase_quotient_has_one_residual_phase_only_on_top_stratum": (
                support_size - min(support_size, 2)
                == int(support_size == 3)
            ),
            "target_tangent_cone_is_a_vector_space_only_on_top_stratum": (
                tangent_is_vector_space == (support_size == 3)
            ),
            "C4_has_a_compatible_target_cone_only_on_top_stratum": (
                bool(c4_compatible_targets) == (support_size == 3)
            ),
        }
        for name, value in row_checks.items():
            stratum_checks[f"{key}_{name}"] = value

        for edge in range(3):
            z_real = Fraction(1) if edge in support else Fraction(0)
            z_imag = Fraction(0)
            v_real = Fraction(2)
            v_imag = Fraction(-1)
            jet_parameter = Fraction(2, 3)
            direct_norm = (
                z_real + jet_parameter * v_real
            ) ** 2 + (
                z_imag + jet_parameter * v_imag
            ) ** 2
            expanded_norm = (
                z_real**2
                + z_imag**2
                + jet_parameter
                * 2
                * (z_real * v_real + z_imag * v_imag)
                + jet_parameter**2 * (v_real**2 + v_imag**2)
            )
            jet_checks[f"{key}_{edge_names[edge]}_exact_quadratic_jet"] = (
                direct_norm == expanded_norm
            )
            if edge in absent:
                jet_checks[
                    f"{key}_{edge_names[edge]}_zero_first_normal_jet"
                ] = all(
                    jacobian[3 + edge][column] == 0
                    for column in range(9)
                )
                jet_checks[
                    f"{key}_{edge_names[edge]}_unit_parabolic_normal_jet"
                ] = Fraction(1) == Fraction(1) ** 2

        shorting_checks[f"{key}_stratumwise_shorting_is_exact"] = (
            all(row_checks[name] for name in (
                "tangent_covariance_is_identity",
                "horizontal_lift_is_a_tangent_right_inverse",
                "horizontal_lift_solves_the_tangent_Euler_Lagrange_equation",
            ))
        )
        shorting_checks[
            f"{key}_ordinary_full_six_Hessian_exists_iff_top_stratum"
        ] = (rank(full_covariance) == 6) == (support_size == 3)

        if absent:
            assert c4_counterexample is not None
            c4_checks[f"{key}_boundary_cone_C4_counterexample"] = (
                c4_counterexample["source_is_in_tangent_cone"]
                and not c4_counterexample[
                    "image_is_in_same_tangent_cone"
                ]
            )
            boundary_scaling_checks[
                f"{key}_source_cost_matches_linear_normal_cost"
