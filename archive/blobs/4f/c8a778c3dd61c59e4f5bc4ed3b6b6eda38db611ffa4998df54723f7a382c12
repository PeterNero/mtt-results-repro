#!/usr/bin/env python3
"""Build UST.G3AW, the six-pairing three-line meridian reduction."""

from __future__ import annotations

import hashlib
import json
from fractions import Fraction
from pathlib import Path


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
G3AT = STATE / "ust_g3at_polarized_primal_transport.packet.json"
G3AV = STATE / "ust_g3av_scale_free_b103_polarization.packet.json"
G3AR = ROOT / "UST_G3AR_SAME_MEMBER_BETA_C_SOURCE_AND_NORMAL_DECISION_CONTRACT_v1.md"
OUT = STATE / "ust_g3aw_three_line_gram_meridian_reduction.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, object]:
    return {
        "path": str(path.relative_to(ROOT)).replace("\\", "/"),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def main() -> None:
    g3at = load(G3AT)
    g3av = load(G3AV)
    require(g3at["theorem_id"] == "UST.G3AT", "G3AT theorem")
    require(g3av["theorem_id"] == "UST.G3AV", "G3AV theorem")
    require(
        g3av["Mavlyutov_cup_weights"]
        == {
            "formula": "c_ab=(-1)^(a(a+1)/2+b(b+1)/2+a^2+d-1)/(a!*b!), with d=7",
            "c_24": "-1/48",
            "c_33": "-1/36",
            "c_42": "-1/48",
            "c_33_over_c_24": "4/3",
        },
        "G3AV weights",
    )
    require(
        Fraction(-1, 144) * 3 == Fraction(-1, 48)
        and Fraction(-1, 144) * 4 == Fraction(-1, 36),
        "combined top-polynomial coefficients",
    )

    old_reductions = int(
        g3av["execution_reduction"]["total_top_coefficient_reductions"]
    )
    selected_lines = int(g3av["execution_reduction"]["selected_lines"])
    gram_reductions = selected_lines * (selected_lines + 1) // 2
    require(old_reductions == 4527 and gram_reductions == 6, "work counts")

    checks = {
        "G3AT_and_G3AV_are_hash_bound": True,
        "the_G3AV_weights_combine_as_minus_one_over144_times3_4_3": True,
        "all_combined_pairing_terms_have_the_same_top_degree18_2_2": True,
        "a_symmetric_three_line_Gram_matrix_has_six_unordered_entries": True,
        "the_common_pairing_and_top_generator_scales_cancel_from_reflection_ratios": True,
        "nondegenerate_E_splits_the_ambient_space_as_E_plus_Eperp": True,
        "the_three_reflections_fix_Eperp_pointwise": True,
        "word_identity_is_therefore_decided_on_the_three_dimensional_span": True,
        "the_full_ambient_dual_rows_remain_a_declared_fallback": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    require(all(checks.values()), "G3AW checks")

    packet = {
        "schema": "mtt.unified-source.g3aw-three-line-gram-meridian-reduction.v1",
        "date": "2026-08-12",
        "theorem_id": "UST.G3AW",
        "status": "CLOSED_EXACT_THREE_LINE_GRAM_MERIDIAN_REDUCTION_SIX_TOP_REDUCTIONS_INPUTS_OPEN",
        "inputs": {
            "G3AT": record(G3AT),
            "G3AV": record(G3AV),
            "G3AR_contract": record(G3AR),
        },
        "three_line_pairing": {
            "selected_lines": selected_lines,
            "ordered_hodge_blocks": ["H20", "H11", "H02"],
            "combined_top_polynomial": (
                "p_ij=3*(e_i20*e_j02+e_i02*e_j20)+4*e_i11*e_j11"
            ),
            "top_coefficient": "h_ij=tau(p_ij)",
            "G3AV_pairing": "qhat(e_i,e_j)=-h_ij/144",
            "unordered_pairs_zero_based": [
                [0, 0], [0, 1], [0, 2], [1, 1], [1, 2], [2, 2]
            ],
            "top_reductions": gram_reductions,
        },
        "gram_decision": {
            "matrix": "H=(h_ij) with H symmetric",
            "required_nonzero_diagonal_entries": 3,
            "required_nondegeneracy_certificate": "det(H) != 0",
            "reflection_on_E": "R_i=I3-2*u_i*row_i(H)/h_ii",
            "involution_identity": "R_i^2=I3",
            "orthogonality_identity": "R_i^T*H*R_i=H",
            "ambient_split_when_nondegenerate": "V=E direct-sum Eperp",
            "global_word_test": "W=I_V if and only if W|E=I3",
            "source_reconstruction": "W(e_j)=sum_i c_i*e_i emits the full source from three transported vectors and one coefficient column",
        },
        "execution_reduction": {
            "previous_full_row_top_reductions": old_reductions,
            "immediate_gram_top_reductions": gram_reductions,
            "top_reductions_removed": old_reductions - gram_reductions,
            "retained_fraction": "2/1509",
            "removed_fraction": "1507/1509",
            "full_dual_rows_required_for_immediate_relation_detection": False,
            "full_dual_rows_required_for_arbitrary_ambient_action": True,
        },
        "required_execution_certificate": {
            "inputs": "the three G3AT common-base primal vectors in frozen B103 order",
            "outputs": [
                "six exact characteristic-zero top coefficients h_ij",
                "three nonzero diagonal certificates",
                "one exact det(H) nonzero certificate",
                "three exact 3x3 reflection matrices",
                "the selected finite word decision",
                "an integral-normalization certificate for the surviving source",
            ],
            "fallback": "if det(H)=0 or an ambient action is required, execute the full G3AV rows",
        },
        "checks": checks,
        "theorem": {
            "name": "ThreeLineGramMeridianReductionTheorem",
            "tier": "CLOSED_EXACT_EXECUTION_REDUCTION",
            "statement": (
                "For three transported nonisotropic lines with nondegenerate Gram span, "
                "the generated Picard-Lefschetz group fixes the orthogonal complement "
                "and is completely represented by three 3x3 Gram reflections. The exact "
                "G3AV cup weights combine each unordered pairing into one top reduction, "
                "so finite relation detection and source extraction require six top "
                "reductions rather than three full 1509-coordinate dual rows."
            ),
        },
        "parameter_ledger": {
            "observed_values_used": 0,
            "new_continuous_fit_parameters": 0,
            "new_discrete_fit_parameters": 0,
        },
        "guardrails": {
            "claims_the_three_primal_transports_are_executed": False,
            "claims_the_six_top_reductions_are_executed": False,
            "claims_the_Gram_determinant_is_nonzero": False,
            "claims_an_integral_meridian_is_emitted": False,
            "claims_the_full_ambient_dual_rows_are_unnecessary_for_every_later_task": False,
            "claims_beta_C_or_an_endpoint": False,
        },
        "next_required_object": (
            "Finish the three primal transports, execute the six combined G3AV top "
            "reductions, certify nonzero diagonal and determinant, and decide the finite "
            "reflection word on the emitted 3x3 Gram span."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print("UST.G3AW three-line Gram reduction: PASS 4527 top reductions -> 6")


if __name__ == "__main__":
    main()
