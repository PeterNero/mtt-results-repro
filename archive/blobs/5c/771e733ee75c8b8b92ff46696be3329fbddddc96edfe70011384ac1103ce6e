for (i=1;i<=size(G);i++)
{{
  print("G3AP_F2_QRING_MODULE_LEADER_"+string(i)+"_COMP="+string(ustLeadComponent(G[i])));
  print("G3AP_F2_QRING_MODULE_LEADER_"+string(i)+"_EXP="+string(leadexp(G[i])));
}}
attrib(G,"isSB",0);
write("ssi:w state/ust_g3ap_selected_cayley_fiber2_qring_module_degree44.ssi",G);
print("G3AP_F2_QRING_LEADER_EXPORT_PASS");
