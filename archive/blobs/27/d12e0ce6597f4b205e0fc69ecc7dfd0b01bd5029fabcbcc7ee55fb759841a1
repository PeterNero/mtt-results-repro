#!/usr/bin/env python3
"""Adopt an independently verified qslimgb fiber-two result as G3AP."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
SOURCE = ROOT / "state" / "ust_g3ap_selected_cayley_fiber2_qslimgb.packet.json"
VERIFIER = ROOT / "verify_ust_g3ap_selected_cayley_fiber2_qslimgb_top_dimension.py"
OUT = ROOT / "state" / "ust_g3ap_selected_cayley_ordinary_top_dimension.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    subprocess.run([sys.executable, str(VERIFIER)], cwd=ROOT, check=True)
    source = json.loads(SOURCE.read_text(encoding="ascii"))
    require(
        source["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qslimgb-top.v1",
        "source schema",
    )
    require(
        source["status"]
        == "CLOSED_EXACT_SELECTED_F1016_FIBER2_QSLIMGB_TOP_DIMENSION_ONE",
        "source status",
    )
    require(all(source["checks"].values()), "source checks")
    require(not any(source["guardrails"].values()), "source guardrails")
    checked(source["inputs"]["selected_source"], "selected source")
    checked(source["inputs"]["base_cache"], "base cache")
    checked(source["execution"]["script"], "qslimgb script")
    checked(source["execution"]["output"], "qslimgb output")
    checked(source["execution"]["bounded_module_cache"], "module cache")
    top = source["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["scalar_weight"] == 44
        and top["enumerated_monomials"] == 174865
        and top["dimension"] == 1
        and top["basis"] == ["w^12*t2^4*s^2"],
        "selected top line",
    )
    checks = {
        "selected_fiber2_qslimgb_certificate_is_hash_current": True,
        "qslimgb_quotient_module_is_independently_reconstructed_by_std": True,
        "base_quotient_is_exactly_B_mod_K_E_C": True,
        "the_21_relations_are_the_remaining_fiber_degree_two_Jacobian_relations": True,
        "all_174865_Cox_degree_18_2_2_monomials_are_enumerated": True,
        "standard_module_monomials_are_decided_by_exact_leading_divisibility": True,
        "the_selected_ordinary_top_piece_has_dimension_one": True,
        "its_unique_basis_is_w12_t2_4_s2": True,
        "no_full_ten_variable_basis_is_claimed_or_needed_for_this_fiber_degree": True,
        "no_GF11_leading_monomial_is_imported": True,
        "no_observed_value_or_fit_parameter_is_used": True,
    }
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1",
        "date": "2026-08-10",
        "theorem_id": "UST.G3AP",
        "status": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_SOCLE_DIMENSION_ONE",
        "inputs": {
            "fiber2_qslimgb_top": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            }
        },
        "leading_ideal": {
            "method": "exact_fiber_degree_two_qslimgb_over_B_mod_K_E_C_through_degree_44",
            "base_basis_size": source["execution"]["base_basis_size"],
            "module_generator_count": source["execution"]["module_generator_count"],
            "basis_size": source["execution"]["module_basis_size_through_bound"],
            "scalar_degree_bound": 44,
            "export_script": source["execution"]["script"],
            "raw_output": source["execution"]["output"],
            "base_cache": source["inputs"]["base_cache"],
            "bounded_module_cache": source["execution"]["bounded_module_cache"],
            "full_ten_variable_standard_basis_claimed": False,
        },
        "ordinary_top_piece": top,
        "checks": checks,
        "guardrails": {
            "claims_toric_R1_survival_without_G3AO": False,
            "claims_characteristic_zero_rank_promotion": False,
            "claims_beta_C_is_computed": False,
        },
        "theorem": {
            "name": "selectedCayleyOrdinaryTopDimensionByFiberTwoQslimgbTheorem",
            "tier": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_ONE",
            "statement": (
                "For the selected F_101^6 Cayley member, the exact qslimgb "
                "fiber-degree-two quotient module leaves precisely "
                "w^12*t2^4*s^2 among all 174,865 monomials of Cox degree "
                "(18,2,2); ordinary std independently reconstructs the result."
            ),
        },
        "next_required_object": (
            "Execute the principal and direct Schur response blocks as vector "
            "normal forms over the same certified quotient module."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print("UST.G3AP qslimgb fiber-two result adopted as canonical top dimension one")


if __name__ == "__main__":
    main()
