from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path

import sympy as sp


ROOT = Path(__file__).resolve().parent
TEXPAPERS = Path(os.environ.get("MTT_TEXPAPERS_ROOT", ROOT.parent))
QM_ROOT = Path(os.environ.get("MTT_QM_ROOT", TEXPAPERS / "mtt-qm-source-proof"))
PACKET = ROOT / "q79_continuum_spectral_recorder_compiler_and_intertwiner_error.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def all_boolean_leaves_true(value: object) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, dict):
        return bool(value) and all(all_boolean_leaves_true(item) for item in value.values())
    return False


def source_checks_pass(source: dict) -> bool:
    if source.get("all_checks_pass") is True:
        return True
    if "checks" in source:
        return all_boolean_leaves_true(source["checks"])
    if "declared_dependency_hash_checks" in source:
        return all_boolean_leaves_true(source["declared_dependency_hash_checks"])
    return False


def matrix(values: list[list[object]], locals_: dict[str, object] | None = None) -> sp.Matrix:
    local_values = locals_ or {}
    return sp.Matrix(
        [[sp.sympify(entry, locals=local_values) for entry in row] for row in values]
    )


def is_zero(value: sp.MatrixBase) -> bool:
    return all(sp.simplify(entry) == 0 for entry in value)


def hermitian_trace_norm(value: sp.MatrixBase) -> sp.Expr:
    require(is_zero(value.H - value), "trace-norm Hermitian")
    total = sp.Integer(0)
    for eigenvalue, multiplicity in value.eigenvals().items():
        eigenvalue = sp.simplify(eigenvalue)
        if eigenvalue.is_nonnegative:
            total += multiplicity * eigenvalue
        elif eigenvalue.is_nonpositive:
            total -= multiplicity * eigenvalue
        else:
            raise AssertionError(f"eigenvalue sign: {eigenvalue}")
    return sp.simplify(total)


def verify_inputs(packet: dict) -> dict[str, dict]:
    roots = {
        "closure-dynamics": ROOT,
        "mtt-qm-source-proof": QM_ROOT,
    }
    sources: dict[str, dict] = {}
    for label, record in packet["inputs"].items():
        repository = record["repository"]
        require(repository in roots, f"repository: {label}")
        path = roots[repository] / record["relative_path"]
        require(path.is_file(), f"source exists: {label}")
        require(sha256(path) == record["sha256"], f"source hash: {label}")
        source = load(path)
        identity = source.get("schema") or source.get("certificate")
        require(identity == record["identity"], f"source identity: {label}")
        require(source["status"] == record["status"], f"source status: {label}")
        require(source_checks_pass(source), f"source checks: {label}")
        sources[label] = source
    require(len(sources) == 6, "six sources")
    return sources


def verify_continuum_reconciliation(packet: dict, sources: dict[str, dict]) -> None:
    cauchy = sources["canonical_Cauchy_Fock_model"]
    augmented = sources["augmented_endpoint_Hilbert_compiler"]
    require(
        cauchy["blocker_assessment"]["B.QM.02_exit_certificate"]
        == "complete_at_canonical_q79_binary_one_anchor_finite_symbol_tier",
        "Cauchy finite-symbol tier",
    )
    require(
        cauchy["blocker_assessment"]["local_QFT_and_continuum_HYM"]
        == "open_under_B.QFT.01_and_B.HS.01",
        "HYM boundary",
    )
    require(augmented["checks"]["physical_nonlinear_residual_remains_open"], "Scont open")
    require(augmented["checks"]["finite_continuum_intertwiner_remains_open"], "Tfin open")
    reconciliation = packet["continuum_word_reconciliation"]
    require("finite-symbol" in reconciliation["closed_Cauchy_continuum"], "stored Cauchy tier")
    require("Hull-Strominger/HYM" in reconciliation["open_internal_continuum"], "stored HYM tier")
    require("not evidence" in reconciliation["logical_relation"], "stored logical boundary")


def exact_compiler_data(packet: dict, sources: dict[str, dict]) -> dict[str, object]:
    locals_ = {"I": sp.I, "sqrt": sp.sqrt}
    fourier = sources["selected_static_qutrit_Fourier"]
    trajectory = sources["q79_path_trajectory"]
    f3 = matrix(fourier["exact_selected_qutrit_Fourier_witness"]["F3"], locals_)
    p_c = sp.diag(1, 0, 0)
    q_c = sp.eye(3) - p_c
    a_c = sp.diag(0, 2, 5)
    p_f = matrix(
        trajectory["selected_Morse_Bott_repair_test"]["projectors"]["P"], locals_
    )
    q_f = sp.eye(3) - p_f
    require(is_zero(f3.H * f3 - sp.eye(3)), "F3 unitary")
    require(is_zero(a_c * p_c), "kernel")
    require(is_zero(a_c * q_c - a_c), "support")
    require(is_zero(p_f - f3 * p_c * f3.H), "P transfer")
    require(is_zero(q_f - f3 * q_c * f3.H), "Q transfer")
    return {
        "locals": locals_,
        "F3": f3,
        "Pc": p_c,
        "Qc": q_c,
        "Ac": a_c,
        "Pf": p_f,
        "Qf": q_f,
    }


def verify_spectral_compiler(packet: dict, sources: dict[str, dict]) -> None:
    data = exact_compiler_data(packet, sources)
    f3 = data["F3"]
    p_c, q_c = data["Pc"], data["Qc"]
    p_f, q_f = data["Pf"], data["Qf"]
    gamma = sp.log(448)
    lc_p, lc_q = sp.sqrt(gamma) * p_c, sp.sqrt(gamma) * q_c
    lf_p, lf_q = sp.sqrt(gamma) * p_f, sp.sqrt(gamma) * q_f
    k_c = -gamma * sp.eye(3) / 2
    k_f = -gamma * sp.eye(3) / 2
    require(is_zero(k_c + k_c.H + lc_p.H * lc_p + lc_q.H * lc_q), "HP continuum")
    require(is_zero(k_f + k_f.H + lf_p.H * lf_p + lf_q.H * lf_q), "HP finite")
    require(is_zero(f3 * lc_p - lf_p * f3), "LP")
    require(is_zero(f3 * lc_q - lf_q * f3), "LQ")
    require(is_zero(f3 * k_c - k_f * f3), "K")

    compiler = packet["continuum_spectral_recorder_compiler"]
    require(len(compiler["input"]) == 6, "six compiler inputs")
    require(len(compiler["output_coefficients"]) == 3, "three coefficients")
    require("K+K^dagger" in compiler["HP_unitarity"], "stored HP identity")
    require("T tensor I_Fock" in compiler["Fock_lift"], "stored Fock lift")
    require("phase gauge" in compiler["uniqueness"], "gauge uniqueness")
    require("not an eigenvalue" in compiler["rate_guard"], "rate guard")


def verify_exact_path_transfer(packet: dict, sources: dict[str, dict]) -> None:
    data = exact_compiler_data(packet, sources)
    locals_ = data["locals"]
    f3 = data["F3"]
    p_c, q_c = data["Pc"], data["Qc"]
    p_f, q_f = data["Pf"], data["Qf"]
    e0 = sp.Matrix([1, 0, 0])
    rho_f = e0 * e0.H
    rho_c = sp.simplify(f3.H * rho_f * f3)
    require(is_zero(f3 * rho_c * f3.H - rho_f), "density transfer")
    require(
        [sp.trace(rho_c * p_c), sp.trace(rho_c * q_c)]
        == [sp.Rational(1, 3), sp.Rational(2, 3)],
        "continuum weights",
    )
    ready = sp.Rational(1, 448)
    capture = 1 - ready
    continuum = [
        ready * rho_c,
        capture * p_c * rho_c * p_c,
        capture * q_c * rho_c * q_c,
    ]
    finite = [
        ready * rho_f,
        capture * p_f * rho_f * p_f,
        capture * q_f * rho_f * q_f,
    ]
    require(
        all(is_zero(f3 * source * f3.H - target) for source, target in zip(continuum, finite)),
        "path rows",
    )
    probabilities = [sp.simplify(sp.trace(value)) for value in finite]
    require(probabilities == [
        sp.Rational(1, 448),
        sp.Rational(149, 448),
        sp.Rational(149, 224),
    ], "checkpoint")

    stored = packet["exact_q79_F3_compiler_witness"]
    require(is_zero(matrix(stored["intertwiner_T"], locals_) - f3), "stored T")
    require(is_zero(matrix(stored["continuum_root_density"], locals_) - rho_c), "stored rho c")
    require(stored["finite_ready_P_Q_checkpoint"] == ["1/448", "149/448", "149/224"], "stored checkpoint")
    require(stored["source_tier"].startswith("EXACT_FINITE_LOW_MODE"), "witness tier")


def verify_approximate_bounds(packet: dict, sources: dict[str, dict]) -> None:
    data = exact_compiler_data(packet, sources)
    locals_ = data["locals"]
    f3 = data["F3"]
    p_c, q_c = data["Pc"], data["Qc"]
    p_f, q_f = data["Pf"], data["Qf"]
    rotation = sp.Matrix(
        [
            [sp.Rational(12, 13), -sp.Rational(5, 13), 0],
            [sp.Rational(5, 13), sp.Rational(12, 13), 0],
            [0, 0, 1],
        ]
    )
    t_approx = sp.simplify(f3 * rotation)
    require(is_zero(t_approx.H * t_approx - sp.eye(3)), "approximate isometry")
    d_p = sp.simplify(p_f * t_approx - t_approx * p_c)
    d_q = sp.simplify(q_f * t_approx - t_approx * q_c)
    eps_p = sp.sqrt(max((d_p.H * d_p).eigenvals().keys()))
    eps_q = sp.sqrt(max((d_q.H * d_q).eigenvals().keys()))
    require(eps_p == eps_q == sp.Rational(5, 13), "epsilons")

    rho = p_c
    pushed = sp.simplify(t_approx * rho * t_approx.H)
    hazard_error = sp.simplify(abs(sp.trace(pushed * p_f) - sp.trace(rho * p_c)))
    require(hazard_error == sp.Rational(25, 169), "hazard witness")
    require(bool(hazard_error <= eps_p), "hazard inequality")

    exact_jump = sp.simplify(t_approx * p_c * rho * p_c * t_approx.H)
    approximate_jump = sp.simplify(p_f * pushed * p_f)
    jump_error = hermitian_trace_norm(approximate_jump - exact_jump)
    jump_bound = sp.simplify(2 * eps_p + eps_p**2)
    require(jump_error == 5 * sp.sqrt(601) / 169, "jump witness")
    require(bool(jump_error <= jump_bound), "jump inequality")

    normalized_exact = exact_jump / sp.trace(exact_jump)
    normalized_approximate = approximate_jump / sp.trace(approximate_jump)
    normalized_error = hermitian_trace_norm(normalized_approximate - normalized_exact)
    minimum_weight = sp.Min(sp.trace(exact_jump), sp.trace(approximate_jump))
    conditional_bound = sp.simplify(2 * jump_bound / minimum_weight)
    require(minimum_weight == sp.Rational(144, 169), "minimum weight")
    require(normalized_error == sp.Rational(10, 13), "normalized witness")
    require(bool(normalized_error <= conditional_bound), "normalized inequality")

    capture = sp.Rational(447, 448)
    horizon_error = sp.simplify(capture * hazard_error)
    horizon_bound = sp.simplify(capture * eps_p)
    require(bool(horizon_error <= horizon_bound), "horizon inequality")

    stored = packet["exact_approximate_witness"]
    require(is_zero(matrix(stored["rotation"], locals_) - rotation), "stored rotation")
    require(stored["epsilon_P"] == stored["epsilon_Q"] == "5/13", "stored epsilons")
    require(stored["hazard_error"] == "25/169", "stored hazard")
    require(stored["jump_trace_norm_error"] == "5*sqrt(601)/169", "stored jump")
    require(stored["normalized_jump_trace_distance"] == "10/13", "stored conditional")


def verify_scope_and_contract(packet: dict, sources: dict[str, dict]) -> None:
    rate = sources["geometric_rate_separation"]
    require(rate["parameter_ledger"]["automatic_rate_equality"] is False, "rate source")
    require(
        rate["rate_separation_theorem"]["common_rate_conclusion"].startswith("rejected"),
        "rate rejection",
    )
    contract = packet["reduced_physical_source_contract"]
    require(len(contract["S_cont"]) == 4, "four Scont rows")
    require(len(contract["T_fin"]) == 3, "three Tfin rows")
    require(len(contract["compiled_not_independent"]) == 5, "five compiled outputs")

    require(
        packet["schema"]
        == "MTTQ79ContinuumSpectralRecorderCompilerAndIntertwinerError.v1",
        "schema",
    )
    require(all_boolean_leaves_true(packet["checks"]), "checks")
    require(all(value is False for value in packet["guardrails"].values()), "guardrails")
    tiers = packet["claim_tiers"]
    require(tiers["abstract_continuum_spectral_to_HP_compiler"] == "CLOSED_EXACT", "compiler tier")
    require(tiers["approximate_intertwiner_error_contract"] == "CLOSED_EXACT", "error tier")
    require(tiers["selected_physical_S_cont"] == "OPEN", "Scont tier")
    require(tiers["selected_physical_T_fin"] == "OPEN", "Tfin tier")
    require(tiers["physical_HYM_to_Fock_cocycle"] == "CONDITIONAL_COMPILER_READY", "physical tier")
    require(
        packet["parameter_ledger"]
        == {
            "new_continuous_fit_parameters": 0,
            "new_discrete_fit_parameters": 0,
            "new_observed_values": 0,
            "new_physical_couplings": 0,
            "inherited_dimensionless_clock_anchors": 1,
            "inherited_categorical_Luders_contexts": 1,
            "remaining_compound_physical_source_maps": 2,
            "remaining_physical_clock_normalizations": 1,
        },
        "parameter ledger",
    )
    require(
        packet["frontier_delta"]["next_theorem"]
        == "q79SelectedPhysicalAugmentedEndpointSpectralSectorAndQutritPartialIsometry.v1",
        "next theorem",
    )


def main() -> None:
    packet = load(PACKET)
    sources = verify_inputs(packet)
    verify_continuum_reconciliation(packet, sources)
    verify_spectral_compiler(packet, sources)
    verify_exact_path_transfer(packet, sources)
    verify_approximate_bounds(packet, sources)
    verify_scope_and_contract(packet, sources)
    print("Q79_CONTINUUM_SPECTRAL_RECORDER_COMPILER_AND_INTERTWINER_ERROR_VERIFY_PASS")


if __name__ == "__main__":
    main()
