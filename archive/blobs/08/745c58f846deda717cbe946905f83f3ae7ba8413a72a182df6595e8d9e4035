#!/usr/bin/env python3
"""Evaluate the selected H02 endpoint correction action at all roots of one split prime."""

from __future__ import annotations

import hashlib
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse

import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import build_ust_g3bs_h02_endpoint_action_root5 as root5_action
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
EVIDENCE = ROOT / "evidence" / "ust_g3bt"
OUT = ROOT / "state" / "ust_g3bt_h02_endpoint_action_one_split_prime.packet.json"
PRIME = 21817
DIMENSION = 42706
QUOTIENT_UNITS = 248
IMAGE_RANK = 42458
SOURCE_COLUMNS = 1013


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    repository = repository.resolve()
    try:
        relative = resolved.relative_to(repository)
    except ValueError:
        repository = next(
            (
                candidate
                for candidate in (resolved.parent, *resolved.parents)
                if (candidate / ".git").exists()
            ),
            resolved.parent,
        )
        relative = resolved.relative_to(repository)
    return {
        "repository": repository.name,
        "repository_path": str(repository),
        "repository_relative_path": relative.as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def endpoint_chart(
    prime: int,
    root: int,
    g3bi: dict[str, Any],
    macaulay: dict[str, Any],
    factor: dict[str, Any],
    quotient_rows: list[int],
    descriptors: list[Any],
    generators0: Any,
    target_lookup: dict[tuple[int, ...], int],
    oracle: Any,
    exporter: Any,
) -> tuple[sparse.csc_matrix, dict[str, int]]:
    chart_indptr = [0]
    chart_indices: list[int] = []
    chart_data: list[int] = []
    exact_base_entries = QUOTIENT_UNITS
    base_entries_vanishing = 0
    for row in quotient_rows:
        chart_indices.append(row)
        chart_data.append(1)
        chart_indptr.append(len(chart_indices))
    for descriptor in descriptors:
        column = oracle.exact_column(descriptor, generators0, target_lookup)
        reduced = exporter.append_column(column, prime, root, chart_indices, chart_data)
        exact_base_entries += len(column)
        base_entries_vanishing += len(column) - reduced
        chart_indptr.append(len(chart_indices))
    base_chart = sparse.csc_matrix(
        (
            np.asarray(chart_data, dtype=np.uint32),
            np.asarray(chart_indices, dtype=np.int32),
            np.asarray(chart_indptr, dtype=np.int64),
        ),
        shape=(DIMENSION, DIMENSION),
        dtype=np.uint32,
    )
    derivatives = initializer.correction_derivatives(g3bi, exporter, prime, root)
    update = initializer.correction_update(macaulay, factor, derivatives, prime)
    require(update.shape == (DIMENSION, IMAGE_RANK), "H02 correction update shape")
    endpoint_update = sparse.hstack(
        [sparse.csc_matrix((DIMENSION, QUOTIENT_UNITS), dtype=np.uint32), update],
        format="csc",
    )
    chart = (base_chart.astype(np.uint64) + endpoint_update.astype(np.uint64)).tocsc()
    chart.data %= prime
    chart.eliminate_zeros()
    return chart, {
        "exact_base_entries_before_evaluation": exact_base_entries,
        "base_entries_vanishing": base_entries_vanishing,
        "base_nonzero_entries": int(base_chart.nnz),
        "update_nonzero_entries": int(update.nnz),
        "update_active_columns": int(np.count_nonzero(np.diff(update.indptr))),
        "endpoint_nonzero_entries": int(chart.nnz),
    }


def run_solver(
    solver: Path,
    chart_path: Path,
    rhs_path: Path,
    solution_path: Path,
    log_path: Path,
    mld: Path,
) -> str:
    command = [
        "wsl",
        runtime.wsl_path(solver),
        "--chart",
        runtime.wsl_path(chart_path),
        "--rhs",
        runtime.wsl_path(rhs_path),
        "--output",
        runtime.wsl_path(solution_path),
        "--log",
        runtime.wsl_path(log_path),
    ]
    completed = subprocess.run(command, cwd=mld, capture_output=True, text=True, check=False)
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    return completed.stdout.strip()


def write_checkpoint(root: int, payload: dict[str, Any]) -> None:
    path = EVIDENCE / f"H02.p{PRIME}.g{root}.checkpoint.json"
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="ascii")


def representation_digest(
    roots: list[int], lagrange_rows: list[list[int]], root_records: list[dict[str, Any]]
) -> str:
    payload = {
        "prime": PRIME,
        "roots": roots,
        "lagrange_rows": lagrange_rows,
        "solutions": [row["solution"]["sha256"] for row in root_records],
    }
    return hashlib.sha256(
        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("ascii")
    ).hexdigest()


def main() -> None:
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as split_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    g3bi_path = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
    g3bk_path = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"
    g3br_path = ROOT / "state" / "ust_g3br_h02_alternate_split_prime_initializer.packet.json"
    g3bs_path = ROOT / "state" / "ust_g3bs_h02_endpoint_action_root5.packet.json"
    g3bi = load(g3bi_path)
    g3bk = load(g3bk_path)
    g3br = load(g3br_path)
    g3bs = load(g3bs_path)
    for packet, label in ((g3bi, "G3BI"), (g3bk, "G3BK"), (g3br, "G3BR"), (g3bs, "G3BS")):
        require(all(packet["checks"].values()), f"{label} checks")

    b103_path = mld / "q79_eta9_full_vanishing_residue_basis.packet.json"
    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H02.packet.json"
    csc_path = mld / "q79_eta9_original_jacobian_macaulay_H02_csc.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H02.packet.json"
    residue_packet_path = (
        mld
        / "eta9_split_prime_H11_residues"
        / f"H11.physical_H20_to_H11.p{PRIME}.packet.json"
    )
    b103 = load(b103_path)
    macaulay = load(macaulay_path)
    csc = load(csc_path)
    factor = load(factor_path)
    residue_packet = load(residue_packet_path)
    for packet, label in ((b103, "B103"), (macaulay, "Macaulay"), (csc, "CSC"), (factor, "factor"), (residue_packet, "residue")):
        require(all(packet["checks"].values()), f"{label} checks")
    roots = [int(value) for value in residue_packet["field"]["roots_of_selected_sextic"]]
    require(len(roots) == 6 and len(set(roots)) == 6 and 5 in roots, "six split roots")
    minpoly = [
        int(value)
        for value in g3bk["correction_direction"]["minimal_polynomial_coefficients_ascending"]
    ]
    require(
        all(
            sum(value * pow(root, degree, PRIME) for degree, value in enumerate(minpoly))
            % PRIME
            == 0
            for root in roots
        ),
        "all selected roots satisfy the sextic",
    )

    base_packet = load(oracle.BASE)
    global_f0 = load(oracle.GLOBAL_F0)
    b89 = load(oracle.B89)
    generators0, _, _ = oracle.exact_generators(base_packet, global_f0, b89)
    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    quotient_rows = [int(value) for value in csc["binary"]["quotient_unit_rows"]]
    selected_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, selected_columns)
    require(len(target_lookup) == DIMENSION, "H02 target dimension")
    require(len(quotient_rows) == QUOTIENT_UNITS, "H02 quotient units")
    require(len(descriptors) == IMAGE_RANK, "H02 image rank")

    expected_digest = g3bk["characteristic_zero_derivative_sources"]["H11_to_H02"][
        "canonical_exact_source_sha256"
    ]
    solver = mld / "solve_q79_eta9_split_prime_selected_chart"
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    quotient_values: list[np.ndarray] = []
    root_records: list[dict[str, Any]] = []
    determinants: list[int] = []
    total_residuals = 0

    for position, root in enumerate(roots, start=1):
        print(f"G3BT root {position}/6: gamma={root}", flush=True)
        rhs, source_digest = root5_action.exact_source_matrix(
            g3bi, b103, macaulay, exporter, root, PRIME
        )
        require(source_digest == expected_digest, "canonical exact H11-to-H02 source digest")
        if root == 5:
            chart_path = ROOT / g3br["endpoint_chart"]["binary"]["path"]
            rhs_path = ROOT / g3bs["operator_action"]["RHS"]["path"]
            solution_path = ROOT / g3bs["operator_action"]["solution"]["path"]
            log_path = ROOT / g3bs["operator_action"]["solver_log"]["path"]
            chart = split_io.as_scipy(arithmetic.read_csc(chart_path, b"MTTSPC1\0", 6))
            stored_rhs = split_io.as_scipy(arithmetic.read_csc(rhs_path, b"MTTSRH1\0", 4))
            require((stored_rhs != rhs).nnz == 0, "G3BS root-five RHS identity")
            construction = {
                "exact_base_entries_before_evaluation": int(g3br["base_chart"]["exact_entries_before_evaluation"]),
                "base_entries_vanishing": int(g3br["base_chart"]["entries_vanishing_at_proof_place"]),
                "base_nonzero_entries": int(g3br["base_chart"]["nonzero_entries"]),
                "update_nonzero_entries": int(g3br["endpoint_update"]["nonzero_entries"]),
                "update_active_columns": int(g3br["endpoint_update"]["active_columns"]),
                "endpoint_nonzero_entries": int(g3br["endpoint_chart"]["nonzero_entries"]),
            }
            solver_stdout = "reused independently verified G3BR/G3BS root-five action"
        else:
            chart, construction = endpoint_chart(
                PRIME,
                root,
                g3bi,
                macaulay,
                factor,
                quotient_rows,
                descriptors,
                generators0,
                target_lookup,
                oracle,
                exporter,
            )
            stem = f"H02.p{PRIME}.g{root}.G3BI_endpoint_correction.c0-1012"
            chart_path = EVIDENCE / f"{stem}.chart.bin"
            rhs_path = EVIDENCE / f"{stem}.rhs.bin"
            solution_path = EVIDENCE / f"{stem}.solution.bin"
            log_path = EVIDENCE / f"{stem}.solve.log"
            exporter.write_chart(
                chart_path,
                PRIME,
                DIMENSION,
                QUOTIENT_UNITS,
                IMAGE_RANK,
                chart.indptr.astype(np.uint64).tolist(),
                chart.indices.astype(np.uint32).tolist(),
                chart.data.astype(np.uint32).tolist(),
            )
            exporter.write_rhs(
                rhs_path,
                PRIME,
                DIMENSION,
                rhs.indptr.astype(np.uint64).tolist(),
                rhs.indices.astype(np.uint32).tolist(),
                rhs.data.astype(np.uint32).tolist(),
            )
            reusable = False
            if solution_path.is_file() and log_path.is_file():
                fields = initializer.parse_log(log_path)
                if fields.get("STATUS") == "SUCCESS":
                    try:
                        prior_solution = split_io.as_scipy(
                            arithmetic.read_csc(solution_path, b"MTTSCO1\0", 6)
                        )
                        reusable = (
                            prior_solution.shape == (DIMENSION, SOURCE_COLUMNS)
                            and split_io.residual_nonzeros(chart, prior_solution, rhs, PRIME) == 0
                        )
                    except (AssertionError, OSError, ValueError):
                        reusable = False
            if reusable:
                solver_stdout = "reused exact zero-residual root checkpoint"
            else:
                solver_stdout = run_solver(
                    solver, chart_path, rhs_path, solution_path, log_path, mld
                )

        solution = split_io.as_scipy(
            arithmetic.read_csc(solution_path, b"MTTSCO1\0", 6)
        )
        require(solution.shape == (DIMENSION, SOURCE_COLUMNS), "solution shape")
        residual = split_io.residual_nonzeros(chart, solution, rhs, PRIME)
        require(residual == 0, "H02 endpoint action residual")
        total_residuals += residual
        fields = initializer.parse_log(log_path)
        require(fields.get("STATUS") == "SUCCESS", "split-prime solver success")
        determinant = int(fields["CHART_DETERMINANT"])
        require(0 < determinant < PRIME, "nonzero endpoint determinant")
        determinants.append(determinant)
        quotient = solution[:QUOTIENT_UNITS, :].toarray().astype(np.uint32, copy=False)
        quotient_values.append(quotient)
        row_record = {
            "gamma_root": root,
            "construction": construction,
            "endpoint_chart": record(chart_path),
            "RHS": record(rhs_path),
            "solution": record(solution_path),
            "solver_log": record(log_path),
            "source_nonzero_entries": int(rhs.nnz),
            "solution_nonzero_entries": int(solution.nnz),
            "quotient_nonzero_entries": int(np.count_nonzero(quotient)),
            "preimage_nonzero_entries": int(solution[QUOTIENT_UNITS:, :].nnz),
            "endpoint_determinant_mod21817": determinant,
            "residual_nonzeros": residual,
            "solver_stdout": solver_stdout,
        }
        root_records.append(row_record)
        write_checkpoint(root, row_record)
        print(
            f"G3BT root gamma={root}: determinant={determinant} "
            f"solution_nnz={solution.nnz} residual={residual}",
            flush=True,
        )
        del solution, quotient
        if root != 5:
            del chart

    lagrange_rows = [
        arithmetic.interpolate(roots, [1 if row == column else 0 for row in range(6)], PRIME)
        for column in range(6)
    ]
    quotient_coefficients64 = np.zeros(
        (QUOTIENT_UNITS, SOURCE_COLUMNS, 6), dtype=np.uint64
    )
    for root_index, values in enumerate(quotient_values):
        values64 = values.astype(np.uint64, copy=False)
        for degree, coefficient in enumerate(lagrange_rows[root_index]):
            quotient_coefficients64[:, :, degree] = (
                quotient_coefficients64[:, :, degree] + values64 * coefficient
            ) % PRIME
    quotient_coefficients = quotient_coefficients64.astype(np.uint32)
    evaluation_mismatches = 0
    for root_index, root in enumerate(roots):
        evaluated = np.zeros((QUOTIENT_UNITS, SOURCE_COLUMNS), dtype=np.uint64)
        for degree in reversed(range(6)):
            evaluated = (evaluated * root + quotient_coefficients[:, :, degree]) % PRIME
        evaluation_mismatches += int(
            np.count_nonzero(evaluated.astype(np.uint32) != quotient_values[root_index])
        )
    quotient_path = EVIDENCE / f"H02.G3BI_endpoint_correction.quotient.p{PRIME}.power_basis.npy"
    np.save(quotient_path, quotient_coefficients, allow_pickle=False)
    action_digest = representation_digest(roots, lagrange_rows, root_records)
    checks = {
        "all_six_roots_are_distinct_roots_of_the_selected_sextic_mod21817": True,
        "all_six_endpoint_charts_are_exact_evaluations_of_the_selected_G3BI_H02_chart": True,
        "all1013_RHS_columns_are_the_exact_G3BK_minus4_P_sC_sources": True,
        "the_canonical_characteristic_zero_source_digest_matches_G3BK": True,
        "all_six_endpoint_chart_determinants_are_nonzero": all(value != 0 for value in determinants),
        "all_six_42706_by1013_inverse_actions_have_zero_residual": total_residuals == 0,
        "six_root_interpolation_reconstructs_every_quotient_value": evaluation_mismatches == 0,
        "the_complete_full_actions_are_retained_as_six_exact_sparse_evaluations": True,
    }
    require(all(checks.values()), "G3BT checks")
    packet = {
        "schema": "mtt.unified-source.g3bt-h02-endpoint-action-one-split-prime.v1",
        "date": "2026-08-12",
        "status": "EXACT_H02_G3BI_ENDPOINT_CORRECTION_ACTION_RECOVERED_MODULO_ONE_SPLIT_PRIME",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
            "G3BI": record(g3bi_path),
            "G3BK": record(g3bk_path),
            "G3BR": record(g3br_path),
            "G3BS": record(g3bs_path),
            "B103": external_record(b103_path, mld),
            "H02_Macaulay": external_record(macaulay_path, mld),
            "H02_CSC": external_record(csc_path, mld),
            "H02_factorization": external_record(factor_path, mld),
            "split_prime_roots": external_record(residue_packet_path, mld),
            "three_block_oracle": external_record(oracle.OUT, mld),
            "base": external_record(oracle.BASE, mld),
            "global_F0": external_record(oracle.GLOBAL_F0, mld),
            "B89": external_record(oracle.B89, mld),
            "split_prime_solver": external_record(solver, mld),
        },
        "field": {
            "prime": PRIME,
            "roots_of_selected_sextic": roots,
            "power_basis": ["1", "gamma", "gamma^2", "gamma^3", "gamma^4", "gamma^5"],
            "lagrange_rows_root_to_power_basis": lagrange_rows,
        },
        "operator_action": {
            "formula": "A_G3BI^-1 (-4 P sC) for all 1013 H11 residue sources P",
            "target_coordinate_rows": DIMENSION,
            "source_columns": SOURCE_COLUMNS,
            "quotient_rows": QUOTIENT_UNITS,
            "original_Jacobian_preimage_rows": IMAGE_RANK,
            "full_power_basis_shape": [DIMENSION, SOURCE_COLUMNS, 6],
            "full_action_representation": "six exact sparse root evaluations plus the displayed Lagrange transform",
            "full_action_representation_sha256": action_digest,
            "quotient_power_basis": {
                "shape": list(quotient_coefficients.shape),
                "nonzero_coefficients": int(np.count_nonzero(quotient_coefficients)),
                "binary": record(quotient_path),
                "binary_format": "NumPy NPY v1/v2 little-endian uint32 row-source-power",
            },
        },
        "root_solves": root_records,
        "verification": {
            "linear_system_residual_nonzeros": total_residuals,
            "quotient_interpolation_evaluation_mismatches": evaluation_mismatches,
        },
        "checks": checks,
        "guardrails": {
            "claims_exact_Q_gamma_rational_reconstruction_from_one_prime": False,
            "claims_a_materialized_full_power_basis_tensor": False,
            "claims_recursive_return_of_the_H02_preimages": False,
            "claims_integral_parallel_transport_or_terminal_readout": False,
        },
        "theorem": {
            "name": "ustG3btH02EndpointActionOneSplitPrime",
            "tier": "CLOSED_EXACT_ONE_SPLIT_PRIME_OPERATOR_ACTION",
            "statement": (
                "At p=21817, all six evaluations of the exact selected G3BI endpoint H02 chart "
                "are invertible and their inverse actions on all 1013 exact G3BK correction sources "
                "have zero residual. The six sparse actions and the displayed Lagrange transform "
                "give the unique full action in the power basis of F_21817[gamma]/(m_gamma); the "
                "248-row quotient power-basis tensor is emitted explicitly."
            ),
        },
        "next_required_object": (
            "Repeat the selected H02 endpoint action at independent split primes, then apply CRT "
            "with a proved height bound or an independent exact annihilating relation before "
            "promoting the action over Q(gamma)."
        ),
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3BT H02 endpoint action one split prime: PASS", flush=True)
    print(
        f"prime={PRIME} roots=6 residuals={total_residuals} "
        f"quotient_interpolation_mismatches={evaluation_mismatches} "
        f"quotient_nonzero_coefficients={np.count_nonzero(quotient_coefficients)}",
        flush=True,
    )
    print(f"packet_sha256={sha256(OUT)}", flush=True)


if __name__ == "__main__":
    main()
