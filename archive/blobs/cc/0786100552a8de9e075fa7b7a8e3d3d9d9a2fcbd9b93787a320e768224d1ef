#!/usr/bin/env python3
"""Audit four-prime H02 rational reconstructions against a fifth prime."""

from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path
from typing import Any

import numpy as np

try:
    from numba import njit
except ImportError as error:  # pragma: no cover
    raise RuntimeError("G3DP requires numba for the exact coefficient audit") from error


ROOT = Path(__file__).resolve().parent
G3DI = ROOT / "state" / "ust_g3di_h02_split_algebra_kernel_relations.packet.json"
G3DJ = ROOT / "state" / "ust_g3dj_h02_second_prime_kernel_relations.packet.json"
G3DK = ROOT / "state" / "ust_g3dk_h02_third_prime_kernel_relations.packet.json"
G3DM = ROOT / "state" / "ust_g3dm_h02_fourth_prime_holdout_kernel.packet.json"
G3DN = ROOT / "state" / "ust_g3dn_h02_three_prime_reconstruction_holdout.packet.json"
G3DO = ROOT / "state" / "ust_g3do_h02_fifth_prime_holdout_kernel.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3dp"
OUT = ROOT / "state" / "ust_g3dp_h02_four_prime_reconstruction_holdout.packet.json"
P1, P2, P3, P4, P5 = 21817, 33863, 37493, 38113, 68213
M2 = P1 * P2
M3 = M2 * P3
M4 = M3 * P4
B4 = math.isqrt((M4 - 1) // 2)
INV12 = pow(P1, -1, P2)
INV123 = pow(M2, -1, P3)
INV1234 = pow(M3, -1, P4)


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {"path": path.relative_to(ROOT).as_posix(), "sha256": sha256(path), "bytes": path.stat().st_size}


@njit(cache=True)
def gcd_int(left: int, right: int) -> int:
    if left < 0:
        left = -left
    if right < 0:
        right = -right
    while right:
        left, right = right, left % right
    return left


@njit(cache=True)
def reconstruct(residue: int) -> tuple[int, int, bool]:
    old_remainder = M4
    remainder = residue
    old_denominator = 0
    denominator = 1
    while remainder > B4:
        quotient = old_remainder // remainder
        old_remainder, remainder = remainder, old_remainder - quotient * remainder
        old_denominator, denominator = denominator, old_denominator - quotient * denominator
    numerator = remainder
    if denominator < 0:
        numerator = -numerator
        denominator = -denominator
    valid = (
        denominator > 0
        and denominator <= B4
        and abs(numerator) <= B4
        and gcd_int(numerator, denominator) == 1
    )
    return numerator, denominator, valid


@njit(cache=True)
def audit_degree(
    first: np.ndarray,
    second: np.ndarray,
    third: np.ndarray,
    fourth: np.ndarray,
    fifth: np.ndarray,
) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    size = first.size
    candidate = np.zeros(size, dtype=np.bool_)
    passed = np.zeros(size, dtype=np.bool_)
    numerator = np.zeros(size, dtype=np.int64)
    denominator = np.zeros(size, dtype=np.int64)
    for index in range(size):
        r1 = int(first[index])
        r2 = int(second[index])
        r3 = int(third[index])
        r4 = int(fourth[index])
        r5 = int(fifth[index])
        residue12 = r1 + P1 * (((r2 - r1) * INV12) % P2)
        residue123 = residue12 + M2 * (((r3 - residue12 % P3) * INV123) % P3)
        residue1234 = residue123 + M3 * (((r4 - residue123 % P4) * INV1234) % P4)
        value, divisor, valid = reconstruct(residue1234)
        if valid:
            candidate[index] = True
            numerator[index] = value
            denominator[index] = divisor
            if (value - r5 * divisor) % P5 == 0:
                passed[index] = True
    return candidate, passed, numerator, denominator


def coordinate(index: int) -> dict[str, int]:
    row, column = divmod(index, 1274)
    return {"row": row, "column": column}


def sample_rows(
    mask: np.ndarray,
    degree: int,
    numerator: np.ndarray,
    denominator: np.ndarray,
    residues: tuple[np.ndarray, ...],
    limit: int = 4,
) -> list[dict[str, Any]]:
    output: list[dict[str, Any]] = []
    for index in np.flatnonzero(mask)[:limit]:
        output.append(
            {
                "degree": degree,
                **coordinate(int(index)),
                "numerator": int(numerator[index]),
                "denominator": int(denominator[index]),
                "residues": [int(value[index]) for value in residues],
            }
        )
    return output


def main() -> None:
    packet_paths = (("G3DI", G3DI), ("G3DJ", G3DJ), ("G3DK", G3DK), ("G3DM", G3DM), ("G3DN", G3DN), ("G3DO", G3DO))
    packets = {label: load(path) for label, path in packet_paths}
    require(all(all(packet["checks"].values()) for packet in packets.values()), "input checks")
    coefficient_paths = (
        ROOT / packets["G3DI"]["split_algebra_kernel"]["power_basis_coefficients"]["path"],
        ROOT / packets["G3DJ"]["second_split_algebra_kernel"]["power_basis_coefficients"]["path"],
        ROOT / packets["G3DK"]["third_split_algebra_kernel"]["power_basis_coefficients"]["path"],
        ROOT / packets["G3DM"]["fourth_split_algebra_kernel"]["power_basis_coefficients"]["path"],
        ROOT / packets["G3DO"]["fifth_split_algebra_kernel"]["power_basis_coefficients"]["path"],
    )
    arrays = tuple(np.load(path, allow_pickle=False)["coefficients"] for path in coefficient_paths)
    require(all(value.shape == (6, 6022, 1274) for value in arrays), "coefficient shapes")
    prior_masks = np.load(ROOT / packets["G3DN"]["evidence"]["masks"]["path"], allow_pickle=False)

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    packed_candidate: list[np.ndarray] = []
    packed_pass: list[np.ndarray] = []
    per_degree: list[dict[str, Any]] = []
    samples = {"four_prime_pass": [], "four_prime_alias": [], "new_stable_beyond_three_prime": []}
    digest = hashlib.sha256()
    totals = {
        "entries": 0,
        "four_prime_candidates": 0,
        "four_prime_holdout_passes": 0,
        "four_prime_holdout_failures": 0,
        "four_prime_no_candidate": 0,
        "four_prime_pass_integers": 0,
        "four_prime_pass_zeros": 0,
        "retained_three_prime_passes": 0,
        "lost_three_prime_passes": 0,
        "new_stable_beyond_three_prime": 0,
    }
    for degree in range(6):
        print(f"G3DP auditing power-basis degree {degree}/5", flush=True)
        values = tuple(array[degree].reshape(-1) for array in arrays)
        candidate, passed, numerator, denominator = audit_degree(*values)
        expected = np.unpackbits(
            prior_masks["four_prime_candidate"][degree], bitorder="little"
        )[: values[0].size].astype(bool)
        require(np.array_equal(candidate, expected), f"G3DN four-prime mask degree {degree}")
        passed3 = np.unpackbits(
            prior_masks["three_prime_holdout_pass"][degree], bitorder="little"
        )[: values[0].size].astype(bool)
        alias = candidate & ~passed
        retained = passed3 & passed
        lost = passed3 & ~passed
        new_stable = passed & ~passed3
        row = {
            "degree": degree,
            "entries": int(values[0].size),
            "four_prime_candidates": int(np.count_nonzero(candidate)),
            "four_prime_holdout_passes": int(np.count_nonzero(passed)),
            "four_prime_holdout_failures": int(np.count_nonzero(alias)),
            "four_prime_no_candidate": int(np.count_nonzero(~candidate)),
            "four_prime_pass_integers": int(np.count_nonzero(passed & (denominator == 1))),
            "four_prime_pass_zeros": int(np.count_nonzero(passed & (numerator == 0))),
            "retained_three_prime_passes": int(np.count_nonzero(retained)),
            "lost_three_prime_passes": int(np.count_nonzero(lost)),
            "new_stable_beyond_three_prime": int(np.count_nonzero(new_stable)),
        }
        per_degree.append(row)
        for key in totals:
            if key in row:
                totals[key] += row[key]
        packed_candidate.append(np.packbits(candidate, bitorder="little"))
        packed_pass.append(np.packbits(passed, bitorder="little"))
        for value in (
            np.where(passed, numerator, 0).astype("<i8", copy=False),
            np.where(passed, denominator, 0).astype("<i8", copy=False),
        ):
            digest.update(value.tobytes(order="C"))
        samples["four_prime_pass"].extend(sample_rows(passed, degree, numerator, denominator, values))
        samples["four_prime_alias"].extend(sample_rows(alias, degree, numerator, denominator, values))
        samples["new_stable_beyond_three_prime"].extend(sample_rows(new_stable, degree, numerator, denominator, values))

    require(totals["entries"] == 46032168, "entry total")
    require(totals["four_prime_candidates"] == packets["G3DN"]["totals"]["four_prime_candidates"], "G3DN candidate total")
    require(totals["four_prime_candidates"] == totals["four_prime_holdout_passes"] + totals["four_prime_holdout_failures"], "four-prime partition")
    mask_path = EVIDENCE / "H02.Q_kernel.reconstruction_masks.packbits.npz"
    np.savez_compressed(
        mask_path,
        four_prime_candidate=np.stack(packed_candidate),
        four_prime_holdout_pass=np.stack(packed_pass),
        entries_per_degree=np.asarray([6022 * 1274], dtype=np.int64),
    )
    samples_path = EVIDENCE / "H02.Q_kernel.reconstruction_samples.json"
    samples_path.write_text(json.dumps(samples, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    checks = {
        "G3DI_through_G3DO_are_hash_bound_and_passing": True,
        "all46032168_coefficients_are_replayed": totals["entries"] == 46032168,
        "the_G3DN_four_prime_candidate_mask_is_reproduced_exactly": True,
        "prime68213_is_consulted_only_after_four_prime_candidates_are_constructed": True,
        "four_prime_candidates_are_partitioned_into_holdout_passes_and_aliases": totals["four_prime_candidates"] == totals["four_prime_holdout_passes"] + totals["four_prime_holdout_failures"],
        "no_five_prime_candidate_is_constructed_with_signed64_arithmetic": True,
        "no_finite_prime_agreement_is_promoted_to_Q_gamma": True,
        "no_observed_value_or_fit_is_used": True,
    }
    require(all(checks.values()), "G3DP checks")
    packet = {
        "schema": "mtt.unified-source.g3dp-h02-four-prime-reconstruction-holdout.v1",
        "date": "2026-08-14",
        "theorem_id": "UST.G3DP",
        "status": "CLOSED_EXACT_FOUR_PRIME_RECONSTRUCTION_WITH_INDEPENDENT_FIFTH_PRIME_HOLDOUT",
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {label: record(path) for label, path in packet_paths},
        "reconstruction_contract": {
            "construction_primes": [P1, P2, P3, P4],
            "reserved_holdout_prime": P5,
            "four_prime_modulus": M4,
            "four_prime_modulus_bits": M4.bit_length(),
            "four_prime_uniqueness_bound": B4,
            "algorithm": "extended-Euclidean uniqueness-range rational reconstruction",
            "holdout_test": "n congruent to residue*d modulo 68213",
            "five_prime_candidate_policy": "deferred_to_unsigned128_or_multiprecision_executor",
        },
        "totals": totals,
        "fractions": {
            "four_prime_candidate_fraction": totals["four_prime_candidates"] / totals["entries"],
            "four_prime_holdout_pass_fraction_of_all": totals["four_prime_holdout_passes"] / totals["entries"],
            "four_prime_holdout_pass_fraction_of_candidates": totals["four_prime_holdout_passes"] / totals["four_prime_candidates"],
            "four_prime_alias_fraction_of_candidates": totals["four_prime_holdout_failures"] / totals["four_prime_candidates"],
            "new_stable_fraction_of_all": totals["new_stable_beyond_three_prime"] / totals["entries"],
        },
        "per_degree": per_degree,
        "evidence": {
            "masks": record(mask_path),
            "samples": record(samples_path),
            "canonical_passed_candidate_stream_sha256": digest.hexdigest(),
            "canonical_passed_candidate_stream_order": "for each degree: passed-four-prime n,d; int64 little-endian; zero outside pass mask",
        },
        "checks": checks,
        "guardrails": {
            "claims_a_holdout_pass_is_an_exact_rational_coefficient": False,
            "claims_the_relations_lift_to_Q_gamma": False,
            "claims_rank_Q_gamma_Q_equals4748": False,
            "claims_path_source_readout_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3dpH02FourPrimeReconstructionHoldout",
            "tier": "CLOSED_EXACT_MULTIPRIME_RECONSTRUCTION_AUDIT",
            "statement": "Every G3DN four-prime H02 kernel candidate is tested against independently reserved prime 68213. Passing, alias, retained and newly stable sets are exact and persisted. No five-prime candidate is formed until a 128-bit-safe executor is supplied.",
        },
        "frontier_delta": {
            "before": "Four-prime candidates had no fifth-prime verdict.",
            "after": "Every four-prime candidate has an exact fifth-prime verdict and the stable coefficient set is isolated without overflowing the five-prime CRT modulus.",
        },
        "next_required_object": "Build an unsigned128 rational-reconstruction executor, construct five-prime candidates, reserve prime69011 as holdout, and continue toward direct exact Q(gamma) polynomial verification.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3DP H02 four-prime reconstruction holdout: PASS")
    print(
        f"four_candidates={totals['four_prime_candidates']} "
        f"holdout_pass={totals['four_prime_holdout_passes']} "
        f"aliases={totals['four_prime_holdout_failures']} "
        f"new_stable={totals['new_stable_beyond_three_prime']}"
    )
    print(f"packet_sha256={sha256(OUT)}")


if __name__ == "__main__":
    main()
