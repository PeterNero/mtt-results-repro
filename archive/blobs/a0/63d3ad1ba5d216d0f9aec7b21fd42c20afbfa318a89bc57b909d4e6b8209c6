EXTRACTION = ROOT / "evidence" / "ust_g3bc" / "q79_eta9_B89_residue_meridian_extraction.packet.json.blob"
TEMPLATE = STATE / "ust_g3bc_integral_affine_residue_payload.template.json"
SYNTHETIC_DIR = STATE / "ust_g3bc_synthetic_certificates"
SYNTHETIC_INPUT = STATE / "ust_g3bc_synthetic_bezout_dual.test-only.json"
SYNTHETIC_OUTPUT = STATE / "ust_g3bc_synthetic_bezout_dual.test-only.packet.json"
OUT = STATE / "ust_g3bc_pairing_one_dual_replacement.packet.json"

EXPECTED_HASHES = {
    "B87": "d6534e9c4c0e5e03060b5cc71468cdcc1a0628bbac632149cdba21d577fc0952",
    "normalized_B_sweep": "31f979e87c977dfe18d8035479fb41c0e452e987ae6557158872afeb78513515",
    "B89_residue_extraction": "384384f8cbb68ce6c3515f4fdbba140f71669ac69ff098292d17378e1950caf1",
}
PENCIL_SHA256 = "2fb3bdf9f4ff5c8fcc83d685b588d5634647be0dbd2736191ea703c8e572db83"
DIMENSION = 248


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def point_interval(value: int) -> dict[str, Any]:
    return {
        "real": {"lower": [value, 1], "upper": [value, 1]},
        "imag": {"lower": [0, 1], "upper": [0, 1]},
    }


def write_synthetic_certificate(
    index: int, value: int, bindings: dict[str, str]
) -> tuple[Path, dict[str, Any]]:
    SYNTHETIC_DIR.mkdir(parents=True, exist_ok=True)
    path = SYNTHETIC_DIR / f"m{index}.test-only.certificate.json"
    column = [point_interval(1 if coordinate == index else 0) for coordinate in range(DIMENSION)]
    certificate = {
        "schema": "mtt.unified-source.g3bc-integral-affine-residue-certificate.v1",
        "status": "TEST_ONLY_SYNTHETIC_INTEGRAL_AFFINE_RESIDUE",
        "test_only": True,
        "meridian_id": f"test.m{index}",
        "bindings": bindings,
        "normalization_tier": "INTEGRAL_PICARD_LEFSCHETZ_AFFINE_PAIRING",
        "integral_affine_pairing": value,
        "period_column_248": column,
        "checks": {
            "the_meridian_is_integral_in_the_test_lattice": True,
            "the_affine_pairing_is_an_exact_integer": True,
            "the_period_column_has_248_exact_complex_point_intervals": True,
            "the_fixture_is_explicitly_nonphysical": True,
        },
    }
    path.write_text(json.dumps(certificate, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    return path, certificate


def main() -> None:
    paths = {
        "B87": B87,
        "normalized_B_sweep": NORMALIZED,
        "B89_residue_extraction": EXTRACTION,
    }
    require(
        {name: sha256(path) for name, path in paths.items()} == EXPECTED_HASHES,
        "vendored source hashes",
    )
    b87 = load(B87)
    g3bb = load(G3BB)
    normalized = load(NORMALIZED)
    extraction = load(EXTRACTION)
    require(all(b87["checks"].values()), "B87 checks")
    require(all(g3bb["checks"].values()), "G3BB checks")
    require(all(normalized["checks"].values()), "normalized sweep checks")
    require(all(extraction["checks"].values()), "residue extraction checks")
    require(
        b87["integral_index"]["positive_generator"] == 1
        and b87["integral_index"]["selected_transgression_saturated"],
        "unit pairing ideal",
    )
    require(g3bb["selected_target"]["forced_relation_defect"] == 1, "G3BB orientation")
    require(
        extraction["inputs"]["q79_eta9_B89_projective_lefschetz_certificate.packet.json"]["sha256"]
        == PENCIL_SHA256,
        "fixed B89 pencil binding",
    )
    require(
        extraction["theorem"]["tier"]
        == "CLOSED_EXACT_RESIDUE_TO_FINITE_RATIONAL_MERIDIAN_REDUCTION",
        "rank-one residue reduction",
    )
    require(
        normalized["rank248_readout"]["lift_change"]
        == "changing the integral normal-function lift changes R_B by Pi_C(v) for v in V_Z and therefore leaves [R_B] unchanged",
        "integral-lift quotient invariance",
    )

    bindings = {
        "B87_source_sha256": EXPECTED_HASHES["B87"],
        "G3BB_target_sha256": sha256(G3BB),
        "B89_pencil_sha256": PENCIL_SHA256,
    }
    template = {
        "schema": "mtt.unified-source.g3bc-bezout-dual-input.v1",
        "status": "PRODUCTION_INTEGRAL_RESIDUE_PAYLOAD",
        "bindings": bindings,
        "affine_residue_rows": [],
        "required_certificate_contract": {
            "schema": "mtt.unified-source.g3bc-integral-affine-residue-certificate.v1",
            "normalization_tier": "INTEGRAL_PICARD_LEFSCHETZ_AFFINE_PAIRING",
            "required_value": "integral_affine_pairing=<h_Z,e_i> in Z",
            "optional_value": "period_column_248 as outward rational complex rectangles",
            "rejected_shortcuts": [
                "GF(11) residue without integral Betti normalization",
                "unbound numerical complex residue",
                "a residue from another pencil or source",
            ],
        },
    }
    TEMPLATE.write_text(json.dumps(template, indent=2, ensure_ascii=True) + "\n", encoding="ascii")

    residue_values = [6, 10, 15]
    synthetic_rows = []
    for index, value in enumerate(residue_values):
        path, certificate = write_synthetic_certificate(index, value, bindings)
        synthetic_rows.append(
