 #include "data.h"
 #include "../msolve/streams.h"
 
+/* Optional q79 audit instrumentation.  The value propagated in BINDEX is an
+ * upper bound on the largest original-generator degree used by this concrete
+ * F4 row.  It is enabled only while one audited F4 matrix is reduced. */
+static int q79_f4_provenance_enabled = 0;
+static int q79_f4_provenance_active = 0;
+static const char *q79_f4_provenance_path = NULL;
+static len_t *q79_f4_basis_provenance = NULL;
+static bl_t q79_f4_basis_provenance_size = 0;
+static uint32_t q79_f4_provenance_round = 0;
+
+static void q79_f4_provenance_ensure(const bl_t need)
+{
+    if (!q79_f4_provenance_enabled || need <= q79_f4_basis_provenance_size) {
+        return;
+    }
+    bl_t next = q79_f4_basis_provenance_size == 0 ? 64 : q79_f4_basis_provenance_size;
+    while (next < need) {
+        next *= 2;
+    }
+    q79_f4_basis_provenance = realloc(
+            q79_f4_basis_provenance, (uint64_t)next * sizeof(len_t));
+    for (bl_t i = q79_f4_basis_provenance_size; i < next; ++i) {
+        q79_f4_basis_provenance[i] = 0;
+    }
+    q79_f4_basis_provenance_size = next;
+}
+
+static void q79_f4_provenance_initialize(const bs_t *bs)
+{
+    q79_f4_provenance_path = getenv("MSOLVE_F4_PROVENANCE_DUMP");
+    if (q79_f4_provenance_path == NULL || q79_f4_provenance_path[0] == '\0') {
+        return;
+    }
+    q79_f4_provenance_enabled = 1;
+    q79_f4_provenance_active = 0;
+    q79_f4_provenance_round = 0;
+    q79_f4_provenance_ensure(bs->ld);
+    FILE *file = fopen(q79_f4_provenance_path, "w");
+    if (file == NULL) {
+        q79_f4_provenance_enabled = 0;
+        return;
+    }
+    fprintf(file, "FORMAT\tMSOLVE_F4_ORIGINAL_DEGREE_UPPER_BOUND_V1\n");
+    for (bl_t i = 0; i < bs->ld; ++i) {
+        q79_f4_basis_provenance[i] = (len_t)bs->hm[i][DEG];
+        fprintf(file, "INITIAL\t%u\t%u\n", i, q79_f4_basis_provenance[i]);
+    }
+    fclose(file);
+}
+
+static void q79_f4_provenance_prepare(mat_t *mat, const bs_t *bs)
+{
+    if (!q79_f4_provenance_enabled) {
+        return;
+    }
+    q79_f4_provenance_round++;
+    FILE *file = fopen(q79_f4_provenance_path, "a");
+    if (file == NULL) {
+        q79_f4_provenance_enabled = 0;
+        return;
+    }
+    fprintf(file, "MATRIX\t%u\t%d\t%u\t%u\t%u\n",
+            q79_f4_provenance_round, mat->cd, bs->ld, mat->nru, mat->nrl);
+    for (len_t block = 0; block < 2; ++block) {
+        hm_t **rows = block == 0 ? mat->rr : mat->tr;
+        const len_t count = block == 0 ? mat->nru : mat->nrl;
+        const char kind = block == 0 ? 'R' : 'T';
+        for (len_t i = 0; i < count; ++i) {
+            hm_t *row = rows[i];
+            const bl_t basis_index = row[BINDEX];
+            if (basis_index >= q79_f4_basis_provenance_size) {
+                fprintf(file, "ERROR\t%c\t%u\tBASIS_INDEX\t%u\n",
+                        kind, i, basis_index);
+                fclose(file);
+                q79_f4_provenance_enabled = 0;
+                return;
+            }
+            const len_t multiplier_degree = (len_t)bs->ht->hd[row[MULT]].deg;
+            const len_t bound = q79_f4_basis_provenance[basis_index]
+                + multiplier_degree;
+            fprintf(file, "INPUT\t%c\t%u\t%u\t%u\t%u\n",
+                    kind, i, basis_index, multiplier_degree, bound);
+            row[BINDEX] = bound;
+        }
+    }
+    fprintf(file, "ENDINPUTS\n");
+    fclose(file);
+    q79_f4_provenance_active = 1;
+}
+
+static void q79_f4_provenance_capture(
+        const mat_t *mat,
+        const bl_t from,
+        const md_t *md,
+        const ht_t *sht
+        )
+{
+    if (!q79_f4_provenance_enabled || !q79_f4_provenance_active) {
+        return;
+    }
+    q79_f4_provenance_ensure(from + mat->np);
+    FILE *file = fopen(q79_f4_provenance_path, "a");
+    if (file == NULL) {
+        q79_f4_provenance_enabled = 0;
+        q79_f4_provenance_active = 0;
+        return;
+    }
+    for (len_t k = 0; k < mat->np; ++k) {
+        const len_t row_index = mat->np - 1 - k;
+        const hm_t *row = mat->tr[row_index];
+        const len_t bound = row[BINDEX];
+        const deg_t lead_degree = sht->hd[md->hcm[row[OFFSET]]].deg;
+        q79_f4_basis_provenance[from+k] = bound;
+        fprintf(file, "OUTPUT\t%u\t%u\t%u\t%u\t%d\t%u\n",
+                q79_f4_provenance_round, from+k, row_index, bound,
+                lead_degree, row[LENGTH]);
+    }
+    fprintf(file, "ENDMATRIX\n");
+    fclose(file);
+    q79_f4_provenance_active = 0;
+}
+
