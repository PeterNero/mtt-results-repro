        substitute_diagonal(component, Fraction(1, 2), Fraction(1, 3))
        for component in source_residual
    )
    target_cost = repair_cost(target_residual)

    source_hessian = hessian_form(source_cost)
    target_hessian = hessian_form(target_cost)
    source_covariance = inverse_diagonal(source_hessian)
    target_covariance = inverse_diagonal(target_hessian)

    transported_field_metric = multiply(
        transpose(inverse_transform), inverse_transform
    )
    source_hessian_operator = multiply(
        inverse_diagonal(identity(2)), source_hessian
    )
    target_hessian_operator = multiply(
        inverse_diagonal(transported_field_metric), target_hessian
    )

    source_v3 = derivative_at_zero(source_cost, (1, 1, 1))
    source_v4 = derivative_at_zero(source_cost, (1, 1, 1, 1))
    target_v3 = derivative_at_zero(target_cost, (1, 1, 1))
    target_v4 = derivative_at_zero(target_cost, (1, 1, 1, 1))

