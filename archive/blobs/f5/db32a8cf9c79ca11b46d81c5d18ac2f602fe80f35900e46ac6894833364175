    def block_diagonal(
        blocks: list[list[list[Fraction]]],
    ) -> list[list[Fraction]]:
        row_count = sum(len(block) for block in blocks)
        column_count = sum(len(block[0]) for block in blocks)
        output = zeros(row_count, column_count)
        row_offset = 0
        column_offset = 0
        for block in blocks:
            for row, values in enumerate(block):
                for column, value in enumerate(values):
                    output[row_offset + row][
                        column_offset + column
                    ] = value
            row_offset += len(block)
            column_offset += len(block[0])
        return output

    def determinant(matrix: list[list[Fraction]]) -> Fraction:
        work = [row[:] for row in matrix]
        value = Fraction(1)
        for column in range(len(work)):
            pivot_row = next(
                (
                    row
                    for row in range(column, len(work))
                    if work[row][column] != 0
                ),
                None,
            )
            if pivot_row is None:
                return Fraction(0)
            if pivot_row != column:
                work[column], work[pivot_row] = (
                    work[pivot_row],
                    work[column],
                )
                value *= -1
            pivot = work[column][column]
            value *= pivot
            for row in range(column + 1, len(work)):
                factor = work[row][column] / pivot
                for entry in range(column, len(work)):
                    work[row][entry] -= factor * work[column][entry]
        return value

    def contractible_bv_block(
        amplitude: Fraction,
    ) -> list[list[Fraction]]:
        return [
            [Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
            [amplitude, Fraction(0), Fraction(0), Fraction(0)],
            [Fraction(0), Fraction(0), Fraction(0), -amplitude],
            [Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
        ]

    symplectic_block = [
        [Fraction(0), Fraction(0), Fraction(1), Fraction(0)],
        [Fraction(0), Fraction(0), Fraction(0), Fraction(1)],
        [Fraction(-1), Fraction(0), Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(-1), Fraction(0), Fraction(0)],
    ]
    lagrangian_block = [
        [Fraction(1), Fraction(0)],
        [Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(1)],
    ]
    exact_image_block = [
        [Fraction(0), Fraction(0)],
        [Fraction(1), Fraction(0)],
        [Fraction(0), Fraction(1)],
        [Fraction(0), Fraction(0)],
    ]

    amplitudes = [Fraction(1), Fraction(2), Fraction(3)]
    q_bv = block_diagonal(
        [contractible_bv_block(value) for value in amplitudes]
    )
    q_bv_adjoint = transpose(q_bv)
    omega_bv = block_diagonal([symplectic_block] * 3)
    delta_bv = add(
        mul(q_bv, q_bv_adjoint),
        mul(q_bv_adjoint, q_bv),
    )
    delta_bv_inverse = diagonal(
        [
            Fraction(1, value * value)
            for value in amplitudes
            for _ in range(4)
        ]
    )
    h_bv = mul(q_bv_adjoint, delta_bv_inverse)
    exact_projector = mul(q_bv, h_bv)
    coexact_projector = mul(h_bv, q_bv)
    lagrangian_basis = block_diagonal([lagrangian_block] * 3)
    exact_image_basis = block_diagonal([exact_image_block] * 3)
    q_on_lagrangian = mul(
        transpose(exact_image_basis),
        mul(q_bv, lagrangian_basis),
    )
    shell_hessian = mul(
        transpose(lagrangian_basis),
        mul(omega_bv, mul(q_bv, lagrangian_basis)),
    )
    shell_hessian_determinant = determinant(shell_hessian)
    q_divergence = sum(
