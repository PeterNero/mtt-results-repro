#!/usr/bin/env python3
"""Adopt a separately certified Hilbert-guided basis as the canonical cache."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
CERTIFICATION = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_certify.result.json"
NORED_CERTIFICATION = ROOT / "state" / "ust_g3am_selected_cayley_basis_hilbert_nored_certify.result.json"
CANONICAL = ROOT / "state" / "ust_g3al_selected_cayley_basis.result.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def artifact(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--variant", choices=("red", "nored"), default="red")
    args = parser.parse_args()
    certification_path = (
        NORED_CERTIFICATION if args.variant == "nored" else CERTIFICATION
    )
    certification = json.loads(certification_path.read_text(encoding="ascii"))
    require(
        certification["schema"]
        == "mtt.unified-source.g3am-selected-cayley-basis-hilbert-certification.v1",
        "certification schema",
    )
    require(certification["passed"] is True, "certification passed")
    require(all(certification["proof_logic"].values()), "certification proof logic")
    script = artifact(certification["script"], "certification script")
    output = artifact(certification["output"], "certification output")
    cache = artifact(certification["cache"], "certified cache")
    raw_output = output.read_text(encoding="utf-8")
    require("G3AM_HILBERT_CERTIFIED_BASIS_PASS" in raw_output, "certified marker")
    require(cache.stat().st_size == certification["cache"]["bytes"] > 0, "cache size")
    result = {
        "schema": "mtt.unified-source.g3al-selected-cayley-basis-result.v1",
        "script": certification["script"],
        "output": certification["output"],
        "cache": certification["cache"],
        "algorithm": "std_of_untrusted_hilbert_guided_candidate",
        "adopted_from": {
            "path": str(certification_path.relative_to(ROOT)).replace("\\", "/"),
            "sha256": sha256(certification_path),
        },
        "elapsed_seconds": certification["elapsed_seconds"],
        "returncode": 0,
        "timed_out": False,
        "passed": True,
    }
    CANONICAL.write_text(json.dumps(result, indent=2) + "\n", encoding="ascii")
    print(
        "UST.G3AM certified Hilbert-guided Cayley basis adopted "
        f"variant={args.variant}: PASS"
    )


if __name__ == "__main__":
    main()
