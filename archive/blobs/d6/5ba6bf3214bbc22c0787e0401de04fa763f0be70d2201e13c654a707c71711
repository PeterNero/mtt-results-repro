#!/usr/bin/env python3
"""Independently verify the selected F_101^6 toric-regularity cover."""

from __future__ import annotations

import hashlib
import itertools
import json
from pathlib import Path

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as uvs_msolve_inputs
import build_ust_g3ao_selected_cayley_toric_uvs_primal_msolve_input as uvs_primal_inputs
import build_ust_g3ao_selected_cayley_toric_uvs_cusp_original_msolve_inputs as uvs_flex_inputs
import build_ust_g3ao_selected_cayley_toric_uvs_cusp_split_msolve_inputs as uvs_flex_split
import build_ust_g3ao_selected_cayley_toric_vs_flex_msolve_inputs as vs_flex_inputs
import build_ust_g3ao_selected_cayley_toric_vs_primal_msolve_input as vs_primal_inputs
import run_ust_g3ao_selected_cayley_toric_regularity as campaign
import run_ust_g3ao_selected_cayley_toric_determinantal_retries as determinantal
import run_ust_g3ao_selected_cayley_toric_uvs_dual_elimination as uvs_dual
import run_ust_g3ao_selected_cayley_toric_uvs_quadratic_elimination as uvs_quadratic
import run_ust_g3ao_selected_cayley_toric_vs_dual_elimination as vs_dual
import run_ust_g3ao_selected_cayley_toric_vs_off_k_elimination as vs_off_k
import run_ust_g3ao_selected_cayley_toric_vs_reciprocal_elimination as vs_reciprocal
from ust_msolve_runtime import msolve_output_is_unit_ideal


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3ao_selected_cayley_toric_regularity.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ao-selected-cayley-toric-regularity.v1",
        "packet schema",
    )
    require(packet["theorem_id"] == "UST.G3AO", "theorem id")
    require(
        packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_CAYLEY_TORIC_REGULARITY_735_OF_735",
        "packet status",
    )
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "guardrails remain false")
    for name, record in packet["inputs"].items():
        path = ROOT / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"input {name}")
    source_hash = packet["inputs"]["selected_Cayley_source"]["sha256"]
    require(source_hash == sha256(campaign.SOURCE), "selected source hash")
    polynomials = campaign.selected_polynomials()
    expected_items = list(
        itertools.product(
            campaign.nonempty_subsets(campaign.BASE),
            campaign.nonempty_subsets(campaign.ELLIPTIC),
            campaign.nonempty_subsets(campaign.FIBER),
        )
    )
    require(len(expected_items) == 735, "expected orbit count")
    seen: set[str] = set()
    for item in expected_items:
        orbit_label = campaign.label(*item)
        record_path = campaign.CAMPAIGN / f"{orbit_label}.packet.json"
        record = json.loads(record_path.read_text(encoding="ascii"))
        require(
            record["schema"]
            == "mtt.unified-source.g3ao-selected-cayley-toric-orbit.v1",
            f"{orbit_label} schema",
        )
        require(record["label"] == orbit_label, f"{orbit_label} label")
        require(record["source_sha256"] == source_hash, f"{orbit_label} source")
        require(record["passed"] is True, f"{orbit_label} pass")
        require(record["returncode"] == 0, f"{orbit_label} return code")
        require(record["timed_out"] is False, f"{orbit_label} timeout")
        require(
            record["supports"]
            == {
                "base": list(item[0]),
                "elliptic": list(item[1]),
                "Cayley_fiber": list(item[2]),
            },
            f"{orbit_label} supports",
        )
        script = campaign.CAMPAIGN / record["script"]["path"]
        output = campaign.CAMPAIGN / record["output"]["path"]
        require(script.is_file() and sha256(script) == record["script"]["sha256"], f"{orbit_label} script")
        require(output.is_file() and sha256(output) == record["output"]["sha256"], f"{orbit_label} output")
        certificate_method = record.get("certificate_method", "direct_multiplier_locus")
        if certificate_method == "direct_multiplier_locus":
            expected_script = campaign.make_script(
                polynomials, *item, record["algorithm"]
            )
            expected_marker = f"G3AO_TORIC_ORBIT_PASS {orbit_label}"
        elif certificate_method == "determinantal_necessary_locus":
            require(
                record["algorithm"] in ("determinantal_std", "determinantal_slimgb"),
                f"{orbit_label} determinantal algorithm",
            )
            require(
                all(record["proof_scope"].values()),
                f"{orbit_label} determinantal proof scope",
            )
            expected_script = determinantal.make_script(
                polynomials,
                *item,
                record["algorithm"].removeprefix("determinantal_"),
            )
            expected_marker = (
                f"G3AO_DETERMINANTAL_TORIC_ORBIT_PASS {orbit_label}"
            )
        elif certificate_method == "uvs_elliptic_bidual_contact_and_cusp_necessary_loci":
            require(orbit_label == uvs_dual.LABEL, "bidual full-support label")
            require(
                record["algorithm"] in ("uvs_dual_std", "uvs_dual_slimgb"),
                "bidual algorithm",
            )
            require(all(record["proof_scope"].values()), "bidual proof scope")
            bidual_algorithm = record["algorithm"].removeprefix("uvs_dual_")
            expected_script = uvs_dual.make_script(polynomials, bidual_algorithm)
            expected_marker = f"G3AO_UVS_DUAL_ELIMINATION_PASS {orbit_label}"
        elif certificate_method == "uvs_quadratic_norm_and_compatibility_elimination":
            require(orbit_label == uvs_quadratic.LABEL, "quadratic full-support label")
            require(
                record["algorithm"] in ("uvs_quadratic_std", "uvs_quadratic_slimgb"),
                "quadratic algorithm",
            )
            require(all(record["proof_scope"].values()), "quadratic proof scope")
            quadratic_algorithm = record["algorithm"].removeprefix("uvs_quadratic_")
            expected_script = uvs_quadratic.make_script(polynomials, quadratic_algorithm)
            expected_marker = f"G3AO_UVS_QUADRATIC_ELIMINATION_PASS {orbit_label}"
        elif certificate_method == "uvs_quadratic_prime_field_f4_elimination":
            require(orbit_label == uvs_quadratic.LABEL, "F4 full-support label")
            require(
                record["algorithm"] == "uvs_quadratic_msolve_f4_exact",
                "F4 algorithm",
            )
            require(all(record["proof_scope"].values()), "F4 proof scope")
            expected_script = uvs_msolve_inputs.make_export_script(polynomials)
            expected_marker = "G3AO_MSOLVE_EXPORT_PASS"
            input_dependency = record["dependencies"]["input_packet"]
            input_packet_path = campaign.CAMPAIGN / input_dependency["path"]
            require(
                input_packet_path.is_file()
                and sha256(input_packet_path) == input_dependency["sha256"],
                "F4 input packet",
            )
            input_packet = json.loads(input_packet_path.read_text(encoding="ascii"))
            require(all(input_packet["checks"].values()), "F4 input checks")
            require(input_packet["source_sha256"] == source_hash, "F4 input source")
            for locus in ("smooth", "singular"):
                locus_dependency = record["dependencies"]["loci"][locus]
                locus_packet_path = campaign.CAMPAIGN / locus_dependency["path"]
                require(
                    locus_packet_path.is_file()
                    and sha256(locus_packet_path) == locus_dependency["sha256"],
                    f"F4 {locus} packet",
                )
                locus_packet = json.loads(locus_packet_path.read_text(encoding="ascii"))
                require(
                    locus_packet["passed"] is True
                    and locus_packet["unit_ideal"] is True
                    and locus_packet["backend"]["probabilistic_linearization_used"] is False,
                    f"F4 {locus} exact unit ideal",
                )
                locus_output = campaign.CAMPAIGN / locus_packet["output"]["path"]
                require(
                    locus_output.is_file()
                    and sha256(locus_output) == locus_packet["output"]["sha256"],
                    f"F4 {locus} output",
                )
                require(
                    msolve_output_is_unit_ideal(locus_output.read_text(encoding="utf-8")),
                    f"F4 {locus} raw unit basis",
                )
        elif certificate_method == "uvs_primal_contact_and_original_flex_prime_field_f4_elimination":
            require(orbit_label == uvs_dual.LABEL, "primal-flex full-support label")
            require(
                record["algorithm"]
                == "uvs_smooth_primal_and_nine_original_flex_msolve_f4_exact",
                "primal-flex algorithm",
            )
            require(all(record["proof_scope"].values()), "primal-flex proof scope")
            expected_script = uvs_primal_inputs.make_export_script(polynomials)
            expected_marker = "G3AO_MSOLVE_EXPORT_PASS"
            smooth_input_dependency = record["dependencies"]["smooth_input_packet"]
            smooth_input_path = campaign.CAMPAIGN / smooth_input_dependency["path"]
            require(
                smooth_input_path.is_file()
                and sha256(smooth_input_path) == smooth_input_dependency["sha256"],
                "primal-flex smooth input packet",
            )
            smooth_input_packet = json.loads(smooth_input_path.read_text(encoding="ascii"))
            require(all(smooth_input_packet["checks"].values()), "primal-flex smooth input checks")
            require(smooth_input_packet["source_sha256"] == source_hash, "primal-flex smooth source")
            smooth_execution_dependency = record["dependencies"]["smooth_execution"]
            smooth_execution_path = campaign.CAMPAIGN / smooth_execution_dependency["path"]
            require(
                smooth_execution_path.is_file()
                and sha256(smooth_execution_path) == smooth_execution_dependency["sha256"],
                "primal-flex smooth execution packet",
            )
            smooth_execution = json.loads(smooth_execution_path.read_text(encoding="ascii"))
            require(
                smooth_execution["passed"] is True
                and smooth_execution["unit_ideal"] is True
                and smooth_execution["backend"]["probabilistic_linearization_used"] is False,
                "primal-flex smooth exact unit ideal",
            )
            smooth_output = campaign.CAMPAIGN / smooth_execution["output"]["path"]
            require(
                smooth_output.is_file()
                and sha256(smooth_output) == smooth_execution["output"]["sha256"]
                and msolve_output_is_unit_ideal(smooth_output.read_text(encoding="utf-8")),
                "primal-flex smooth raw unit basis",
            )
            flex_input_dependency = record["dependencies"]["flex_input_packet"]
            flex_input_path = campaign.CAMPAIGN / flex_input_dependency["path"]
            require(
                flex_input_path.is_file()
                and sha256(flex_input_path) == flex_input_dependency["sha256"],
                "primal-flex flex input packet",
            )
            flex_input_packet = json.loads(flex_input_path.read_text(encoding="ascii"))
            require(all(flex_input_packet["checks"].values()), "primal-flex flex input checks")
            require(flex_input_packet["source_sha256"] == source_hash, "primal-flex flex source")
            for case in uvs_flex_split.CASES:
                for root in uvs_flex_split.ROOTS:
                    component = f"{case}_{root}"
                    dependency = record["dependencies"]["flex_executions"][component]
                    execution_path = campaign.CAMPAIGN / dependency["path"]
                    require(
                        execution_path.is_file() and sha256(execution_path) == dependency["sha256"],
                        f"primal-flex {component} execution packet",
                    )
                    execution = json.loads(execution_path.read_text(encoding="ascii"))
                    require(
                        execution["component"] == component
                        and execution["passed"] is True
                        and execution["unit_ideal"] is True
                        and execution["backend"]["probabilistic_linearization_used"] is False,
                        f"primal-flex {component} exact unit ideal",
                    )
                    component_output = campaign.CAMPAIGN / execution["output"]["path"]
                    require(
                        component_output.is_file()
                        and sha256(component_output) == execution["output"]["sha256"]
                        and msolve_output_is_unit_ideal(component_output.read_text(encoding="utf-8")),
                        f"primal-flex {component} raw unit basis",
                    )
        elif certificate_method == "vs_primal_contact_and_original_flex_prime_field_f4_elimination":
            require(orbit_label == vs_dual.LABEL, "vs primal-flex full-support label")
            require(
                record["algorithm"]
                == "vs_smooth_primal_and_nine_original_flex_msolve_f4_exact",
                "vs primal-flex algorithm",
            )
            require(all(record["proof_scope"].values()), "vs primal-flex proof scope")
            expected_script = vs_primal_inputs.make_export_script(polynomials)
            expected_marker = "G3AO_MSOLVE_EXPORT_PASS"
            smooth_input_dependency = record["dependencies"]["smooth_input_packet"]
            smooth_input_path = campaign.CAMPAIGN / smooth_input_dependency["path"]
            require(
                smooth_input_path.is_file()
                and sha256(smooth_input_path) == smooth_input_dependency["sha256"],
                "vs primal-flex smooth input packet",
            )
            smooth_input_packet = json.loads(smooth_input_path.read_text(encoding="ascii"))
            require(
                smooth_input_packet["schema"]
                == "mtt.unified-source.g3ao-vs-smooth-primal-msolve-input.v1",
                "vs primal-flex smooth input schema",
            )
            require(all(smooth_input_packet["checks"].values()), "vs primal-flex smooth input checks")
            require(smooth_input_packet["source_sha256"] == source_hash, "vs primal-flex smooth source")
            smooth_execution_dependency = record["dependencies"]["smooth_execution"]
            smooth_execution_path = campaign.CAMPAIGN / smooth_execution_dependency["path"]
            require(
                smooth_execution_path.is_file()
                and sha256(smooth_execution_path) == smooth_execution_dependency["sha256"],
                "vs primal-flex smooth execution packet",
            )
            smooth_execution = json.loads(smooth_execution_path.read_text(encoding="ascii"))
            require(
                smooth_execution["schema"]
                == "mtt.unified-source.g3ao-vs-smooth-primal-msolve.v1"
                and smooth_execution["source_sha256"] == source_hash
                and smooth_execution["input_packet"]["sha256"] == sha256(smooth_input_path)
                and smooth_execution["passed"] is True
                and smooth_execution["unit_ideal"] is True
                and smooth_execution["returncode"] == 0
                and smooth_execution["timed_out"] is False
                and smooth_execution["backend"]["probabilistic_linearization_used"] is False,
                "vs primal-flex smooth exact unit ideal",
            )
            smooth_output = campaign.CAMPAIGN / smooth_execution["output"]["path"]
            require(
                smooth_output.is_file()
                and sha256(smooth_output) == smooth_execution["output"]["sha256"]
                and msolve_output_is_unit_ideal(smooth_output.read_text(encoding="utf-8")),
                "vs primal-flex smooth raw unit basis",
            )
            flex_input_dependency = record["dependencies"]["flex_input_packet"]
            flex_input_path = campaign.CAMPAIGN / flex_input_dependency["path"]
            require(
                flex_input_path.is_file()
                and sha256(flex_input_path) == flex_input_dependency["sha256"],
                "vs primal-flex flex input packet",
            )
            flex_input_packet = json.loads(flex_input_path.read_text(encoding="ascii"))
            require(
                flex_input_packet["schema"]
                == "mtt.unified-source.g3ao-vs-original-flex-msolve-inputs.v1",
                "vs primal-flex flex input schema",
            )
            require(all(flex_input_packet["checks"].values()), "vs primal-flex flex input checks")
            require(flex_input_packet["source_sha256"] == source_hash, "vs primal-flex flex source")
            for case in uvs_flex_split.CASES:
                for root in uvs_flex_split.ROOTS:
                    component = f"{case}_{root}"
                    dependency = record["dependencies"]["flex_executions"][component]
                    execution_path = campaign.CAMPAIGN / dependency["path"]
                    require(
                        execution_path.is_file() and sha256(execution_path) == dependency["sha256"],
                        f"vs primal-flex {component} execution packet",
                    )
                    execution = json.loads(execution_path.read_text(encoding="ascii"))
                    require(
                        execution["schema"]
                        == "mtt.unified-source.g3ao-vs-original-flex-msolve-component.v1"
                        and execution["source_sha256"] == source_hash
                        and execution["input_packet"]["sha256"] == sha256(flex_input_path)
                        and execution["component"] == component
                        and execution["passed"] is True
                        and execution["unit_ideal"] is True
                        and execution["returncode"] == 0
                        and execution["timed_out"] is False
                        and execution["backend"]["probabilistic_linearization_used"] is False,
                        f"vs primal-flex {component} exact unit ideal",
                    )
                    component_output = campaign.CAMPAIGN / execution["output"]["path"]
                    require(
                        component_output.is_file()
                        and sha256(component_output) == execution["output"]["sha256"]
                        and msolve_output_is_unit_ideal(component_output.read_text(encoding="utf-8")),
                        f"vs primal-flex {component} raw unit basis",
                    )
        elif certificate_method == "vs_elliptic_bidual_contact_and_cusp_necessary_loci":
            require(
                orbit_label == vs_dual.LABEL,
                "vs bidual full-support label",
            )
            require(
                record["algorithm"] in ("vs_dual_std", "vs_dual_slimgb"),
                "vs bidual algorithm",
            )
            require(all(record["proof_scope"].values()), "vs bidual proof scope")
            bidual_algorithm = record["algorithm"].removeprefix("vs_dual_")
            expected_script = vs_dual.make_script(polynomials, bidual_algorithm)
            expected_marker = "G3AO_VS_BIDUAL_SMOOTH_EMPTY=1"
        elif certificate_method == "vs_K_split_uvs_structural_and_off_K_bidual":
            require(
                orbit_label == vs_off_k.LABEL,
                "vs K-split full-support label",
            )
            require(
                record["algorithm"] in ("vs_off_k_std", "vs_off_k_slimgb"),
                "vs off-K algorithm",
            )
            require(all(record["proof_scope"].values()), "vs K-split proof scope")
            off_k_algorithm = record["algorithm"].removeprefix("vs_off_k_")
            expected_script = vs_off_k.make_script(polynomials, off_k_algorithm)
            expected_marker = "G3AO_VS_BIDUAL_SMOOTH_EMPTY=1"
            dependency = record["dependencies"]["structural_uvs_packet"]
            dependency_path = campaign.CAMPAIGN / dependency["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency["sha256"],
                "vs K-split structural uvs dependency",
            )
            dependency_packet = json.loads(
                dependency_path.read_text(encoding="ascii")
            )
            require(
                dependency_packet.get("certificate_method")
                in {
                    "uvs_elliptic_bidual_contact_and_cusp_necessary_loci",
                    "uvs_quadratic_norm_and_compatibility_elimination",
                },
                "vs K-split structural uvs method",
            )
        else:
            require(
                certificate_method
                == "vs_K_split_uvs_structural_and_reciprocal_bidual",
                f"{orbit_label} known certificate method",
            )
            require(orbit_label == vs_reciprocal.LABEL, "vs reciprocal label")
            require(
                record["algorithm"]
                in ("vs_reciprocal_std", "vs_reciprocal_slimgb"),
                "vs reciprocal algorithm",
            )
            require(all(record["proof_scope"].values()), "vs reciprocal proof scope")
            reciprocal_algorithm = record["algorithm"].removeprefix(
                "vs_reciprocal_"
            )
            expected_script = vs_reciprocal.make_script(
                polynomials, reciprocal_algorithm
            )
            expected_marker = "G3AO_VS_RECIPROCAL_SMOOTH_EMPTY=1"
            dependency = record["dependencies"]["structural_uvs_packet"]
            dependency_path = campaign.CAMPAIGN / dependency["path"]
            require(
                dependency_path.is_file()
                and sha256(dependency_path) == dependency["sha256"],
                "vs reciprocal structural uvs dependency",
            )
            dependency_packet = json.loads(
                dependency_path.read_text(encoding="ascii")
            )
            require(
                dependency_packet.get("certificate_method")
                in {
                    "uvs_elliptic_bidual_contact_and_cusp_necessary_loci",
                    "uvs_quadratic_norm_and_compatibility_elimination",
                },
                "vs reciprocal structural uvs method",
            )
        require(
            script.read_text(encoding="ascii") == expected_script,
            f"{orbit_label} exact script reconstruction",
        )
        script_text = script.read_text(encoding="ascii")
        require("ring source=(101,g)" in script_text, f"{orbit_label} source field")
        if certificate_method in {
            "direct_multiplier_locus",
            "determinantal_necessary_locus",
            "uvs_elliptic_bidual_contact_and_cusp_necessary_loci",
            "uvs_primal_contact_and_original_flex_prime_field_f4_elimination",
            "vs_primal_contact_and_original_flex_prime_field_f4_elimination",
        }:
            require("ring orbit=(101,g)" in script_text, f"{orbit_label} orbit field")
        elif certificate_method in {
            "uvs_quadratic_norm_and_compatibility_elimination",
            "uvs_quadratic_prime_field_f4_elimination",
        }:
            require("ring quadratic=(101,g)" in script_text, "quadratic extension field")
            require("ring base=(101,g)" in script_text, "quadratic base field")
        else:
            require("ring smoothOrbit=(101,g)" in script_text, "vs smooth field")
            require("ring cuspOrbit=(101,g)" in script_text, "vs cusp field")
        require("ring orbit=11" not in script_text, f"{orbit_label} no GF11")
        require("ring source=11" not in script_text, f"{orbit_label} no GF11 source")
        raw_output = output.read_text(encoding="utf-8")
        require(expected_marker in raw_output, f"{orbit_label} raw pass marker")
        if certificate_method == "uvs_elliptic_bidual_contact_and_cusp_necessary_loci":
            require("G3AO_UVS_BIDUAL_SMOOTH_EMPTY=1" in raw_output, "smooth bidual empty")
            require("G3AO_UVS_BIDUAL_SINGULAR_EMPTY=1" in raw_output, "cusp locus empty")
        if certificate_method == "uvs_quadratic_norm_and_compatibility_elimination":
            require("G3AO_UVS_QUADRATIC_SMOOTH_EMPTY=1" in raw_output, "quadratic smooth empty")
            require("G3AO_UVS_QUADRATIC_SINGULAR_EMPTY=1" in raw_output, "quadratic singular empty")
        if certificate_method == "uvs_quadratic_prime_field_f4_elimination":
            require("G3AO_MSOLVE_EXPORT_PASS" in raw_output, "F4 export pass")
        if certificate_method == "uvs_primal_contact_and_original_flex_prime_field_f4_elimination":
            require("G3AO_MSOLVE_EXPORT_PASS" in raw_output, "primal-flex export pass")
        if certificate_method == "vs_primal_contact_and_original_flex_prime_field_f4_elimination":
            require("G3AO_MSOLVE_EXPORT_PASS" in raw_output, "vs primal-flex export pass")
        if certificate_method == "vs_elliptic_bidual_contact_and_cusp_necessary_loci":
            require("G3AO_VS_BIDUAL_SMOOTH_EMPTY=1" in raw_output, "vs smooth bidual empty")
            require("G3AO_VS_BIDUAL_CUSP_EMPTY=1" in raw_output, "vs cusp locus empty")
        if certificate_method == "vs_K_split_uvs_structural_and_off_K_bidual":
            require("G3AO_VS_BIDUAL_SMOOTH_EMPTY=1" in raw_output, "vs off-K smooth empty")
            require("G3AO_VS_BIDUAL_CUSP_EMPTY=1" in raw_output, "vs off-K cusp empty")
        if certificate_method == "vs_K_split_uvs_structural_and_reciprocal_bidual":
            require("G3AO_VS_RECIPROCAL_SMOOTH_EMPTY=1" in raw_output, "vs reciprocal smooth empty")
            require("G3AO_VS_RECIPROCAL_CUSP_EMPTY=1" in raw_output, "vs reciprocal cusp empty")
        require(orbit_label not in seen, f"duplicate {orbit_label}")
        seen.add(orbit_label)
    require(len(seen) == 735, "complete orbit cover")
    require(packet["toric_ambient"] == campaign.TORIC_AMBIENT, "toric ambient ledger")
    require(packet["toric_ambient"]["dimension"] == 7, "ambient dimension")
    require(packet["toric_ambient"]["Cayley_degree"] == [0, 0, 1], "Cayley degree")
    require(
        packet["toric_ambient"]["Cox_anticanonical_degree"] == [-9, -1, 3],
        "anticanonical degree",
    )
    transport = packet["coordinate_transport"]
    require(transport["determinant"] == -14, "elliptic determinant")
    require(transport["determinant"] % 101 != 0, "elliptic unit mod101")
    require(
        transport["preserves_complete_intersection_and_response_rank"] is True
        and transport["is_a_physical_parameter"] is False,
