        },
        "checks": checks,
        "guardrails": {
            "claims_J_is_invertible_at_a1": False,
            "claims_characteristic_zero_entries_of_K_J_S_or_b_eff_are_emitted": False,
            "claims_the_GF11_rank247_Schur_defect_persists_in_characteristic_zero": False,
