def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, object]:
    require(path.is_file(), f"input exists: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path, *, repository: Path = ROOT) -> dict[str, object]:
    return {
        "path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def evaluate(coefficients: np.ndarray, root: int, prime: int) -> np.ndarray:
    value = coefficients[-1].astype(np.int64)
    for degree in reversed(range(coefficients.shape[0] - 1)):
        value = (value * root + coefficients[degree]) % prime
    return value


def component_kernel(row: dict[str, object], prime: int) -> np.ndarray:
    payload = kernel_runtime.read_kernel(ROOT / row["kernel"]["path"])
    require(payload["prime"] == prime, "target kernel prime")
    dependent = payload["dependent"]
    relations = np.flatnonzero(
        (dependent >= DEPENDENT_START) & (dependent < DEPENDENT_PAST)
    )
    require(relations.size == 100, "target relation count")
    return (
        payload["matrix"][COMPONENT_START:COMPONENT_PAST, :][:, relations]
        .toarray()
        .astype(np.int64)
        % prime
    )


def ideal_profile(kernel: np.ndarray, prime: int) -> tuple[int, ...]:
    rank, _, annihilator_columns = graded.rref(
        kernel.T, prime, emit_nullspace=True
    )
    require(rank == 100 and annihilator_columns is not None, "component rank")
    annihilator = annihilator_columns.T
    return tuple(
        graded.ideal_piece(annihilator, degree, prime)[0].shape[1]
        for degree in range(16)
    )


def q_times_pdelta_vector(prime: int) -> np.ndarray:
    packet = load(PDELTA)
    x, y, z = sp.symbols("x y z")
    expression = (x * z - y**2) * sp.sympify(
        packet["residue_polynomial"]["expanded"],
        locals={"x": x, "y": y, "z": z},
    )
    polynomial = sp.Poly(sp.expand(expression), x, y, z)
    result = np.zeros(45, dtype=np.int64)
    for row, exponent in enumerate(graded.homogeneous_exponents(8)):
        coefficient = polynomial.coeff_monomial(
            x ** exponent[0] * y ** exponent[1] * z ** exponent[2]
        )
        result[row] = (
            int(coefficient.p) % prime
            * pow(int(coefficient.q) % prime, -1, prime)
        ) % prime
    return result


def raw_fourth_normal_space(
    d7_coefficients: np.ndarray, root: int, prime: int
) -> np.ndarray:
    d7 = evaluate(d7_coefficients.T.reshape(6, 36), root, prime)
    basis7 = graded.homogeneous_exponents(7)
    basis8 = graded.homogeneous_exponents(8)
    lookup8 = {exponent: row for row, exponent in enumerate(basis8)}
    result = np.zeros((45, 4), dtype=np.int64)
    for column, shift in enumerate(((1, 0, 0), (0, 1, 0), (0, 0, 1))):
        for row, exponent in enumerate(basis7):
            target = tuple(exponent[index] + shift[index] for index in range(3))
            result[lookup8[target], column] = d7[row]
    result[:, 3] = q_times_pdelta_vector(prime)
    return result % prime


