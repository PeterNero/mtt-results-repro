def q79_sm_local_formal_state_space_gluing() -> dict[str, Any]:
    prior = q79_sm_local_formal_physical_state()
    renormalized = q79_sm_renormalized_timeordering_local_qme()
    hyperbolic = q79_sm_gaugefixed_hyperbolic_bv_equicausal()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    external_names = {
        row["name"] for row in manifest["external_theorems"]
    }

    def matrix_trace(matrix: list[list[Fraction]]) -> Fraction:
        return sum(
            (matrix[index][index] for index in range(len(matrix))),
            Fraction(0),
        )

    def expectation(
        density: list[list[Fraction]],
        observable: list[list[Fraction]],
    ) -> Fraction:
        return matrix_trace(mul(density, observable))

    def bit_tuple(index: int, count: int) -> list[int]:
        return [
            (index >> (count - position - 1)) & 1
            for position in range(count)
        ]

    def bit_index(bits: list[int]) -> int:
        value = 0
        for bit in bits:
            value = 2 * value + bit
        return value

    def partial_trace_qubits(
        density: list[list[Fraction]],
        keep: list[int],
    ) -> list[list[Fraction]]:
        dimension = len(density)
        qubits = dimension.bit_length() - 1
        if 2**qubits != dimension:
            raise ValueError("density dimension must be a qubit power")
        traced = [
            position for position in range(qubits)
            if position not in keep
        ]
        output_dimension = 2 ** len(keep)
        output = zeros(output_dimension, output_dimension)
        for output_row in range(output_dimension):
            kept_row = bit_tuple(output_row, len(keep))
            for output_column in range(output_dimension):
                kept_column = bit_tuple(output_column, len(keep))
                value = Fraction(0)
                for traced_index in range(2 ** len(traced)):
                    traced_bits = bit_tuple(traced_index, len(traced))
                    input_row = [0] * qubits
                    input_column = [0] * qubits
                    for offset, position in enumerate(keep):
                        input_row[position] = kept_row[offset]
                        input_column[position] = kept_column[offset]
                    for offset, position in enumerate(traced):
                        input_row[position] = traced_bits[offset]
                        input_column[position] = traced_bits[offset]
                    value += density[bit_index(input_row)][
                        bit_index(input_column)
                    ]
                output[output_row][output_column] = value
        return output

    def diagonal_nonnegative(
        matrix: list[list[Fraction]],
    ) -> bool:
        return (
            transpose(matrix) == matrix
            and all(
                matrix[row][column] == 0
                for row in range(len(matrix))
                for column in range(len(matrix))
                if row != column
            )
            and all(
                matrix[index][index] >= 0
                for index in range(len(matrix))
            )
        )

    # A common-parent state gives compatible restrictions exactly.  The
    # rational GHZ density matrix avoids floating-point or square-root data.
    ghz_parent = zeros(8, 8)
    for row, column in [(0, 0), (0, 7), (7, 0), (7, 7)]:
        ghz_parent[row][column] = Fraction(1, 2)
    ghz_ab = partial_trace_qubits(ghz_parent, [0, 1])
    ghz_bc = partial_trace_qubits(ghz_parent, [1, 2])
    ghz_b_via_ab = partial_trace_qubits(ghz_ab, [1])
    ghz_b_via_bc = partial_trace_qubits(ghz_bc, [0])
    ghz_b_direct = partial_trace_qubits(ghz_parent, [1])
    half_identity = scale(Fraction(1, 2), eye(2))

    # Agreement on an overlap is not sufficient for arbitrary quantum-state
    # gluing.  Bell states on AB and BC have the same B marginal, but no ABC
    # state can have both marginals because a pure AB marginal factorizes C.
    bell = zeros(4, 4)
    for row, column in [(0, 0), (0, 3), (3, 0), (3, 3)]:
        bell[row][column] = Fraction(1, 2)
    bell_b_from_ab = partial_trace_qubits(bell, [1])
    bell_b_from_bc = partial_trace_qubits(bell, [0])
    pauli_x = [
        [Fraction(0), Fraction(1)],
        [Fraction(1), Fraction(0)],
    ]
    xx_correlation = kronecker(pauli_x, pauli_x)
    bell_xx_expectation = expectation(bell, xx_correlation)
