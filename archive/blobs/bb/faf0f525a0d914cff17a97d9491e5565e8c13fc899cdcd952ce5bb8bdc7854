#!/usr/bin/env python3
"""Adopt the two exact msolve/F4 G3AO uvs locus certificates."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import build_ust_g3ao_selected_cayley_toric_uvs_msolve_inputs as inputs
import run_ust_g3ao_selected_cayley_toric_regularity as direct
from ust_msolve_runtime import msolve_output_is_unit_ideal


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    source_hash = sha256(direct.SOURCE)
    input_packet = json.loads(inputs.OUT.read_text(encoding="ascii"))
    require(input_packet["source_sha256"] == source_hash, "selected input source")
    require(all(input_packet["checks"].values()), "input checks")
    locus_packets: dict[str, dict[str, object]] = {}
    dependencies: dict[str, dict[str, object]] = {}
    for locus in ("smooth", "singular"):
        path = inputs.CAMPAIGN / f"{locus}.msolve.packet.json"
        require(path.is_file(), f"{locus} packet")
        packet = json.loads(path.read_text(encoding="ascii"))
        require(packet["schema"] == "mtt.unified-source.g3ao-uvs-msolve-locus.v1", f"{locus} schema")
        require(packet["locus"] == locus, f"{locus} label")
        require(packet["source_sha256"] == source_hash, f"{locus} source")
        require(packet["passed"] is True and packet["unit_ideal"] is True, f"{locus} unit ideal")
        require(packet["returncode"] == 0 and packet["timed_out"] is False, f"{locus} completion")
        require(packet["backend"]["probabilistic_linearization_used"] is False, f"{locus} exact backend")
        for key in ("input", "output", "log"):
            artifact = direct.CAMPAIGN / packet[key]["path"]
            require(artifact.is_file() and sha256(artifact) == packet[key]["sha256"], f"{locus} {key}")
        raw_output = (direct.CAMPAIGN / packet["output"]["path"]).read_text(encoding="utf-8")
        require(msolve_output_is_unit_ideal(raw_output), f"{locus} raw unit basis")
        locus_packets[locus] = packet
        dependencies[locus] = {
            "path": str(path.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(path),
        }
    label = direct.label(direct.BASE, direct.ELLIPTIC, ("u", "v", "s"))
    canonical = {
        "schema": "mtt.unified-source.g3ao-selected-cayley-toric-orbit.v1",
        "label": label,
        "source_sha256": source_hash,
        "field": "F_101[g]/(g^6+24g^5+89g^4+44g^3+33g^2+16g+64)",
        "supports": {
            "base": list(direct.BASE),
            "elliptic": list(direct.ELLIPTIC),
            "Cayley_fiber": ["u", "v", "s"],
        },
        "script": input_packet["export_script"],
        "output": input_packet["raw_output"],
        "algorithm": "uvs_quadratic_msolve_f4_exact",
        "certificate_method": "uvs_quadratic_prime_field_f4_elimination",
        "dependencies": {
            "input_packet": {
                "path": str(inputs.OUT.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
                "sha256": sha256(inputs.OUT),
            },
            "loci": dependencies,
        },
        "proof_scope": {
            "the_selected_F101e6_member_is_presented_by_the_irreducible_g_minpoly_over_F101": True,
            "its_six_geometric_g_roots_are_Frobenius_conjugate": True,
            "emptiness_is_invariant_under_simultaneous_Frobenius_conjugation": True,
            "the_quadratic_norm_and_compatibility_elimination_is_exact_on_the_full_torus": True,
            "exact_F4_unit_ideals_are_obtained_for_smooth_and_singular_loci": True,
            "no_probabilistic_linearization_is_used": True,
            "the_original_full_support_uvs_critical_locus_is_empty": True,
        },
        "elapsed_seconds": sum(float(packet["elapsed_seconds"]) for packet in locus_packets.values()),
        "returncode": 0,
        "timed_out": False,
        "passed": True,
    }
    canonical_path = direct.CAMPAIGN / f"{label}.packet.json"
    canonical_path.write_text(json.dumps(canonical, indent=2) + "\n", encoding="ascii")
    print(f"{label}: ADOPTED EXACT PRIME-FIELD F4 CERTIFICATE")


if __name__ == "__main__":
    main()
