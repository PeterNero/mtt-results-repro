        for exponent, coefficients in correction[generator].items():
            product = tuple(multiplier[index] + exponent[index] for index in range(3))
            key = (degree27_lookup[product], column)
            require(key not in presentation_entries, "unique gradient product entry")
            presentation_entries[key] = tuple(int(value) for value in coefficients)
    for local, multiplier in enumerate(degree18):
        column = COMPONENT_DIMENSION + local
