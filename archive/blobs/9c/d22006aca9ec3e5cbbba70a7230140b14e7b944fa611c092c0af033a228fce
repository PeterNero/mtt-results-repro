def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    path = path.resolve()
    repository = repository.resolve()
    return {
        "repository": repository.name,
        "repository_path": str(repository),
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def evaluate(coefficients: tuple[int, ...], value: int, prime: int) -> int:
    result = 0
    for coefficient in reversed(coefficients):
        result = (result * value + coefficient) % prime
    return result


def exact_path_update(
    descriptors: list[tuple[int, tuple[int, ...]]],
    corrections: list[dict[tuple[int, ...], tuple[int, ...]]],
    target_lookup: dict[tuple[int, ...], int],
    complement_lookup: dict[int, int],
    gamma_root: int = GAMMA_ROOT,
) -> tuple[sparse.csr_matrix, sparse.csr_matrix]:
    pattern_rows = array("i")
    pattern_columns = array("i")
    evaluated_rows = array("i")
    evaluated_columns = array("i")
    evaluated_values = array("I")
    zero = (0, 0, 0, 0, 0, 0)
    for column, (generator, multiplier) in enumerate(descriptors):
        entries: dict[int, tuple[int, ...]] = {}
        for exponent, coefficients in corrections[generator].items():
            product = tuple(a + b for a, b in zip(multiplier, exponent, strict=True))
            ambient_row = target_lookup.get(product)
            require(ambient_row is not None, "path-update term in H02 target")
            entries[ambient_row] = endpoint.coefficient_add(
                entries.get(ambient_row, zero), coefficients
            )
        for ambient_row, coefficients in entries.items():
            if not any(coefficients):
                continue
            local_row = complement_lookup.get(ambient_row)
            if local_row is None:
                continue
            pattern_rows.append(local_row)
            pattern_columns.append(column)
            value = evaluate(coefficients, gamma_root, PRIME)
            if value:
                evaluated_rows.append(local_row)
                evaluated_columns.append(column)
                evaluated_values.append(value)
    dimension = len(descriptors)
    pattern = sparse.csr_matrix(
        (
            np.ones(len(pattern_rows), dtype=np.uint8),
            (
                np.frombuffer(pattern_rows, dtype=np.int32),
                np.frombuffer(pattern_columns, dtype=np.int32),
            ),
        ),
        shape=(dimension, dimension),
    )
    pattern.sum_duplicates()
    pattern.data[:] = 1
    evaluated = sparse.csr_matrix(
        (
            np.frombuffer(evaluated_values, dtype=np.uint32),
            (
                np.frombuffer(evaluated_rows, dtype=np.int32),
                np.frombuffer(evaluated_columns, dtype=np.int32),
            ),
        ),
        shape=(dimension, dimension),
        dtype=np.uint32,
    )
    evaluated.sum_duplicates()
    evaluated.data %= PRIME
    evaluated.eliminate_zeros()
    return pattern, evaluated


def exact_coefficient_matrices(
    descriptors: list[tuple[int, tuple[int, ...]]],
    corrections: list[dict[tuple[int, ...], tuple[int, ...]]],
    target_lookup: dict[tuple[int, ...], int],
    complement_lookup: dict[int, int],
) -> list[sparse.csr_matrix]:
    rows = [[] for _ in range(6)]
    columns = [[] for _ in range(6)]
    values = [[] for _ in range(6)]
    zero = (0, 0, 0, 0, 0, 0)
    for column, (generator, multiplier) in enumerate(descriptors):
        entries: dict[int, tuple[int, ...]] = {}
        for exponent, coefficients in corrections[generator].items():
            product = tuple(a + b for a, b in zip(multiplier, exponent, strict=True))
            ambient_row = target_lookup.get(product)
            require(ambient_row is not None, "path-update term in H02 target")
            entries[ambient_row] = endpoint.coefficient_add(
                entries.get(ambient_row, zero), coefficients
            )
        for ambient_row, coefficients in entries.items():
            local_row = complement_lookup.get(ambient_row)
            if local_row is None:
                continue
            for degree, coefficient in enumerate(coefficients):
                if coefficient:
                    rows[degree].append(local_row)
                    columns[degree].append(column)
                    values[degree].append(coefficient)
    dimension = len(descriptors)
    result = []
    for degree in range(6):
        matrix = sparse.csr_matrix(
            (values[degree], (rows[degree], columns[degree])),
            shape=(dimension, dimension),
            dtype=np.int64,
        )
        matrix.sum_duplicates()
        matrix.eliminate_zeros()
        result.append(matrix)
    return result


def pivot_columns_mod_prime(matrix: np.ndarray, prime: int) -> list[int]:
    work = np.asarray(matrix, dtype=np.int64).copy() % prime
    pivot_columns: list[int] = []
    pivot_row = 0
    for column in range(work.shape[1]):
        candidates = np.flatnonzero(work[pivot_row:, column])
        if candidates.size == 0:
            continue
        selected = pivot_row + int(candidates[0])
        if selected != pivot_row:
            work[[pivot_row, selected]] = work[[selected, pivot_row]]
        inverse = pow(int(work[pivot_row, column]), -1, prime)
        work[pivot_row] = work[pivot_row] * inverse % prime
        if pivot_row + 1 < work.shape[0]:
            factors = work[pivot_row + 1 :, column].copy()
            nonzero = np.flatnonzero(factors)
            if nonzero.size:
                rows = pivot_row + 1 + nonzero
                work[rows] = (
                    work[rows] - factors[nonzero, None] * work[pivot_row]
                ) % prime
        pivot_columns.append(column)
        pivot_row += 1
        if pivot_row == work.shape[0]:
            break
    return pivot_columns


def component_rank_certificate(
    matrix: sparse.csr_matrix,
    prime: int,
    *,
    select_minor: bool,
) -> tuple[list[dict[str, int]], np.ndarray, np.ndarray]:
    coo = matrix.tocoo()
    dimension = matrix.shape[0]
    graph = sparse.csr_matrix(
        (
            np.ones(2 * coo.nnz, dtype=np.uint8),
            (
                np.concatenate((coo.row, dimension + coo.col)),
                np.concatenate((dimension + coo.col, coo.row)),
            ),
        ),
        shape=(2 * dimension, 2 * dimension),
    )
    _, labels = connected_components(graph, directed=False, return_labels=True)
    active_components = np.unique(labels[coo.row])
    summaries: list[dict[str, int]] = []
    selected_rows: list[np.ndarray] = []
    selected_columns: list[np.ndarray] = []
    for component in active_components.tolist():
        rows = np.flatnonzero(labels[:dimension] == component).astype(np.int32)
        columns = np.flatnonzero(labels[dimension:] == component).astype(np.int32)
        dense = matrix[rows, :][:, columns].toarray()
        local_columns = pivot_columns_mod_prime(dense, prime)
        rank = len(local_columns)
        summaries.append(
            {
                "rows": int(rows.size),
                "columns": int(columns.size),
                "rank": rank,
            }
        )
        if select_minor and rank:
            local_rows = pivot_columns_mod_prime(dense.T, prime)
            require(len(local_rows) == rank, "component row and column ranks agree")
            selected_rows.append(rows[np.asarray(local_rows, dtype=np.int32)])
            selected_columns.append(columns[np.asarray(local_columns, dtype=np.int32)])
    if not select_minor:
        return summaries, np.empty(0, dtype=np.int32), np.empty(0, dtype=np.int32)
    return (
        summaries,
        np.concatenate(selected_rows).astype(np.int32),
        np.concatenate(selected_columns).astype(np.int32),
    )


def exact_defective_component_ranks(
    coefficient_matrices: list[sparse.csr_matrix],
    evaluated: sparse.csr_matrix,
    minimal_polynomial: list[int],
    modular_summaries: list[dict[str, int]],
) -> list[dict[str, int]]:
    coo = evaluated.tocoo()
    dimension = evaluated.shape[0]
    graph = sparse.csr_matrix(
        (
            np.ones(2 * coo.nnz, dtype=np.uint8),
            (
                np.concatenate((coo.row, dimension + coo.col)),
                np.concatenate((dimension + coo.col, coo.row)),
            ),
        ),
        shape=(2 * dimension, 2 * dimension),
    )
    _, labels = connected_components(graph, directed=False, return_labels=True)
    active_components = np.unique(labels[coo.row])
    gamma = symbols("gamma")
    field = QQ.alg_field_from_poly(
        Poly(
            sum(
                value * gamma**degree
                for degree, value in enumerate(minimal_polynomial)
            ),
            gamma,
        ),
        alias="gamma",
    )
    results = []
    for component_index, component in enumerate(active_components.tolist()):
        rows = np.flatnonzero(labels[:dimension] == component).astype(np.int32)
        columns = np.flatnonzero(labels[dimension:] == component).astype(np.int32)
        pattern = evaluated[rows, :][:, columns].copy()
        pattern.data = np.ones(pattern.nnz, dtype=np.uint8)
        matching = maximum_bipartite_matching(pattern, perm_type="column")
        structural_rank = int(np.count_nonzero(matching >= 0))
        modular_rank = modular_summaries[component_index]["rank"]
        if modular_rank == structural_rank:
            continue
        coordinate_coefficients: dict[tuple[int, int], list[int]] = {}
        for degree, coefficient_matrix in enumerate(coefficient_matrices):
            block = coefficient_matrix[rows, :][:, columns].tocoo()
            for row, column, value in zip(
                block.row.tolist(), block.col.tolist(), block.data.tolist(), strict=True
            ):
                coordinate_coefficients.setdefault((row, column), [0] * 6)[degree] += int(
                    value
                )
        entries: dict[int, dict[int, object]] = {}
        for (row, column), ascending in coordinate_coefficients.items():
            entries.setdefault(row, {})[column] = field(list(reversed(ascending)))
        exact_rank = int(
            DomainMatrix(entries, (int(rows.size), int(columns.size)), field).rank()
        )
        results.append(
            {
                "component": component_index,
                "rows": int(rows.size),
                "columns": int(columns.size),
                "structural_rank": structural_rank,
                "split_place_rank": modular_rank,
                "exact_Q_gamma_rank": exact_rank,
                "algebraic_defect_from_matching": structural_rank - exact_rank,
            }
        )
    return results


