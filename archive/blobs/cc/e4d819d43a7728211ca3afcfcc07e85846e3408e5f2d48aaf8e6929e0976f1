#!/usr/bin/env python3
"""Independently verify the exact selected finite-residue N_full operator."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

import verify_ust_g3ak_full_graph_incidence_normal_decomposition as arithmetic
import verify_ust_g3an_selected_cayley_full_response_schur as g3an_verify
import build_ust_g3as_selected_finite_normal_operator as g3as_builder


ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
PACKET = STATE / "ust_g3as_selected_finite_normal_operator.packet.json"
G3AN = STATE / "ust_g3an_selected_cayley_full_response_schur.packet.json"
G3AM = STATE / "ust_g3am_selected_cayley_principal_response.packet.json"
G3AQ = STATE / "ust_g3aq_selected_cayley_relative_residue_promotion.packet.json"
DEGREE = 6


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def decode_plain(raw: bytes, shape: list[int]) -> list[list[tuple[int, ...]]]:
    rows, columns, degree = [int(value) for value in shape]
    require(degree == DEGREE and len(raw) == rows * columns * degree, "normal binary shape")
    result = []
    offset = 0
    for _ in range(rows):
        row = []
        for _ in range(columns):
            row.append(tuple(raw[offset : offset + degree]))
            offset += degree
        result.append(row)
    require(offset == len(raw), "normal binary fully decoded")
    return result


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--upstream-g3an-verified-in-caller", action="store_true")
    parser.add_argument("--upstream-g3aq-verified-in-caller", action="store_true")
    args = parser.parse_args()
    if not args.upstream_g3an_verified_in_caller:
        subprocess.run(
            [sys.executable, str(ROOT / "verify_ust_g3an_selected_cayley_full_response_schur.py")],
            cwd=ROOT,
            check=True,
        )
    if not args.upstream_g3aq_verified_in_caller:
        subprocess.run(
            [
                sys.executable,
                str(ROOT / "verify_ust_g3aq_selected_cayley_relative_residue_promotion.py"),
                "--upstream-g3an-verified-in-caller",
            ],
            cwd=ROOT,
            check=True,
        )

    packet = load(PACKET)
    g3an = load(G3AN)
    g3am = load(G3AM)
    g3aq = load(G3AQ)
    require(packet["schema"] == "mtt.unified-source.g3as-selected-finite-normal-operator.v1", "schema")
    require(packet["theorem_id"] == "UST.G3AS", "theorem id")
    require(packet["status"] == "CLOSED_EXACT_SELECTED_FINITE_RESIDUE_NORMAL_OPERATOR_RANK126", "status")
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    for name, record in packet["inputs"].items():
        path = ROOT / record["path"]
        require(path.is_file() and sha256(path) == record["sha256"], f"input {name}")
        require(path.stat().st_size == record["bytes"], f"input bytes {name}")

    field = packet["residue_field"]
    require(field == g3an["residue_field"], "same selected residue field")
    require(
        g3aq["status"]
        == "CLOSED_EXACT_SELECTED_CHARACTERISTIC_ZERO_RELATIVE_R1_RESPONSE_RANK122"
        and g3aq["inputs"]["G3AN"]["sha256"] == sha256(G3AN),
        "same G3AQ saturated characteristic-zero response",
    )
    require(
        g3aq["promotion_result"]["finite_unit_minor_certificate"]["method"]
        == "block_Gaussian_elimination_with_explicit_R0_and_E0_inverses",
        "unit minor saturation certificate",
    )
    relation = tuple(int(value) for value in field["gamma_relation_coefficients_ascending"])
    zero = arithmetic.arithmetic.qzero(DEGREE)
    one = arithmetic.arithmetic.qone(DEGREE)
    block = g3an["full_response_schur"]
    bundle = block["binary_artifact"]
    raw_bundle = (ROOT / bundle["path"]).read_bytes()
    layout = bundle["layout"]
    n0 = g3an_verify.decode(raw_bundle, layout["N0_principal_quotient"], "N0")
    left = g3an_verify.decode(raw_bundle, layout["L_extra_quotient"], "L")
    expected = g3as_builder.sparse_multiply(left, n0, relation)

    operator = packet["normal_operator"]
    path = ROOT / operator["path"]
    require(path.is_file() and sha256(path) == operator["sha256"], "N_full binary hash")
    require(path.stat().st_size == operator["bytes"], "N_full binary bytes")
    observed = decode_plain(path.read_bytes(), operator["shape"])
    require(observed == expected, "independent N_full=L*N0 replay")
    require((len(observed), len(observed[0])) == (126, 248), "N_full shape")
    quotient_rows = [int(value) for value in block["principal_quotient_rows_zero_based"]]
    final_rows = [int(value) for value in block["final_normal_rows_in_principal_quotient_zero_based"]]
    require(
        all(
            n0[row][quotient_row] == (one if row == column else zero)
            for row in range(215)
            for column, quotient_row in enumerate(quotient_rows)
        ),
        "N0 quotient identity",
    )
    require(
        all(
            left[row][final_row] == (one if row == column else zero)
            for row in range(126)
            for column, final_row in enumerate(final_rows)
        ),
        "L quotient identity",
    )
    require(packet["factorization"]["Nfull_rank"] == 126, "rank N_full by surjective composition")

    # A zero integral residual always reduces to zero. The contrapositive is the
    # one-way modular obstruction used here; the converse is intentionally absent.
    require(
        packet["checks"]["a_nonzero_reduced_residual_would_certify_a_nonzero_integral_residual"],
        "modular nonzero obstruction",
    )
    require(
        packet["checks"]["a_zero_reduced_residual_is_not_promoted_to_characteristic_zero_equality"],
        "no modular-zero overclaim",
    )
    print("UST.G3AS selected finite normal operator: PASS shape=126x248 rank=126")
    print("modular nonzero is a no-go certificate; modular zero is not endpoint closure")


if __name__ == "__main__":
    main()
