#!/usr/bin/env python3
"""Independently verify the weighted G3AP target lower/upper squeeze."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import build_ust_g3ap_selected_cayley_fiber2_weighted_hilbert_hint as weighted
import certify_ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_candidate as cert
import certify_ust_g3ap_selected_cayley_fiber2_weighted_ltrunc_hilbert_candidate as ltrunc_cert
import run_ust_g3ap_selected_cayley_fiber2_qring_weighted_hilbert_hedge as candidate_runner
import run_ust_g3ap_selected_cayley_fiber2_weighted_boxtrunc_hilbert_hedge as boxtrunc_runner
import run_ust_g3ap_selected_cayley_fiber2_weighted_ltrunc_hilbert_hedge as ltrunc_runner
import run_ust_g3ap_selected_cayley_fiber2_weighted_qslimgb_hedge as qslimgb_runner
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
PACKET = cert.PACKET


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def verify_cache_headers(
    source: str,
    base_cache: Path,
    module_cache: Path,
    base_size: int,
    module_size: int,
) -> None:
    base_relative = str(base_cache.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(module_cache.relative_to(ROOT)).replace("\\", "/")
    script = weighted.weighted_base_prefix(source) + f'''def cachedBase=read("ssi:r {base_relative}");
ideal GI=cachedBase;
print("G3AP_F2_WQHVERIFY_BASE_IS_SB_ATTR="+string(attrib(GI,"isSB")));
print("G3AP_F2_WQHVERIFY_BASE_SIZE="+string(size(GI)));
attrib(GI,"isSB",1);
qring q=GI;
def cachedModule=read("ssi:r {module_relative}");
module G=cachedModule;
print("G3AP_F2_WQHVERIFY_MODULE_IS_SB_ATTR="+string(attrib(G,"isSB")));
print("G3AP_F2_WQHVERIFY_MODULE_SIZE="+string(size(G)));
print("G3AP_F2_WQHVERIFY_CACHE_PASS");
quit;
'''
    path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            suffix=".sing",
            prefix="ust_g3ap_f2_wqhverify_",
            dir=ROOT / "state",
            delete=False,
        ) as temporary:
            temporary.write(script)
            path = Path(temporary.name)
        completed = subprocess.run(
            singular_command(ROOT, path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=600,
            check=False,
        )
        require(completed.returncode == 0, "cache header execution")
        require("G3AP_F2_WQHVERIFY_CACHE_PASS" in completed.stdout, "cache pass")
        expected = {
            "G3AP_F2_WQHVERIFY_BASE_IS_SB_ATTR": 0,
            "G3AP_F2_WQHVERIFY_BASE_SIZE": base_size,
            "G3AP_F2_WQHVERIFY_MODULE_IS_SB_ATTR": 0,
            "G3AP_F2_WQHVERIFY_MODULE_SIZE": module_size,
        }
        for label, value in expected.items():
            require(
                re.search(rf"^{label}={value}$", completed.stdout, re.MULTILINE)
                is not None,
                label,
            )
    finally:
        if path is not None:
            path.unlink(missing_ok=True)


def main() -> None:
    weighted.validate_grading()
    subprocess.run([sys.executable, str(cert.LOWER_VERIFIER)], cwd=ROOT, check=True)
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-weighted-leading-squeeze-certified-top.v1",
        "schema",
    )
    require(
        packet["theorem_id"]
        == "UST.G3AP.FIBER2.QRING.WEIGHTED-LEADING-SQUEEZE.CERTIFIED",
        "theorem id",
    )
    require(
        packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_FIBER2_QRING_WEIGHTED_LEADING_SQUEEZE_TOP_DIMENSION_ONE",
        "status",
    )
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    candidate_path = checked(packet["inputs"]["candidate"], "candidate packet")
    source_path = checked(packet["inputs"]["selected_source"], "selected source")
    lower_path = checked(
        packet["inputs"]["selected_ordinary_top_lower_bound"], "lower bound"
    )
    lower_packet = json.loads(lower_path.read_text(encoding="ascii"))
    require(
        lower_packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_AT_LEAST_ONE"
        and all(lower_packet["checks"].values())
        and not any(lower_packet["guardrails"].values()),
        "lower-bound tier",
    )
    script = checked(packet["execution"]["script"], "certification script")
    output = checked(packet["execution"]["output"], "certification output")
    base_cache = checked(packet["execution"]["certified_base_cache"], "certified base")
    module_cache = checked(packet["execution"]["certified_module_cache"], "certified module")
    candidate = json.loads(candidate_path.read_text(encoding="ascii"))
    require(
        candidate["schema"]
        in (
            "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-weighted-hilbert-candidate.v1",
            "mtt.unified-source.g3ap-selected-cayley-fiber2-weighted-qslimgb-candidate.v1",
            "mtt.unified-source.g3ap-selected-cayley-fiber2-weighted-ltrunc-hilbert-candidate.v1",
            "mtt.unified-source.g3ap-selected-cayley-fiber2-weighted-boxtrunc-hilbert-candidate.v1",
        ),
        "candidate schema",
    )
    if candidate["schema"].endswith("weighted-ltrunc-hilbert-candidate.v1"):
        require(
            candidate["status"]
            == "CANDIDATE_REQUIRES_INDEPENDENT_TARGET_TRUNCATION_CERTIFICATION",
            "candidate status",
        )
    elif candidate["schema"].endswith("weighted-boxtrunc-hilbert-candidate.v1"):
        require(
            candidate["status"]
            == "CANDIDATE_REQUIRES_INDEPENDENT_TARGET_BOX_CERTIFICATION",
            "candidate status",
        )
    else:
        require(
            candidate["status"]
            in (
                "CANDIDATE_REQUIRES_NO_HINT_RECONSTRUCTION_IN_THE_SAME_POSITIVE_COX_ORDER",
                "CANDIDATE_REQUIRES_INDEPENDENT_SELECTED_TARGET_CERTIFICATION",
            ),
            "candidate status",
        )
    require(all(candidate["checks"].values()), "candidate checks")
    require(not any(candidate["guardrails"].values()), "candidate guardrails")
    require(packet["grading"] == candidate["grading"], "same grading")
    source = source_path.read_text(encoding="ascii")
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    candidate_output = checked(candidate["execution"]["output"], "candidate output")
    candidate_module = checked(candidate["execution"]["candidate_module_cache"], "candidate module")
    if candidate["schema"].endswith("weighted-hilbert-candidate.v1"):
        _, hilbert = weighted.load_hint()
        candidate_base = checked(
            candidate["execution"]["untrusted_base_cache"], "candidate base"
        )
        expected_candidate_script = candidate_runner.candidate_script(source, hilbert)
        candidate_pass_marker = "G3AP_F2_WQH_LEADER_EXPORT_PASS"
        candidate_engine = "hilbert"
        expected_certification_script = cert.certification_script(
            source, candidate_base, candidate_module
        )
        parse_certified_leaders = cert.parse_leaders
        raw_prefix = "G3AP_F2_WQHCERT"
    elif candidate["schema"].endswith("weighted-qslimgb-candidate.v1"):
        candidate_base = checked(
            candidate["inputs"]["weighted_base_cache"], "candidate base"
        )
        expected_candidate_script = qslimgb_runner.candidate_script(source)
        candidate_pass_marker = "G3AP_F2_WQSLIM_LEADER_EXPORT_PASS"
        candidate_engine = "qslimgb"
        expected_certification_script = cert.certification_script(
            source, candidate_base, candidate_module
        )
        parse_certified_leaders = cert.parse_leaders
        raw_prefix = "G3AP_F2_WQHCERT"
    elif candidate["schema"].endswith("weighted-ltrunc-hilbert-candidate.v1"):
        candidate_base = checked(
            candidate["inputs"]["weighted_base_cache"], "candidate base"
        )
        hint_path = checked(candidate["inputs"]["truncated_hint"], "truncated hint")
        hint = json.loads(hint_path.read_text(encoding="ascii"))
        hint_script = checked(hint["script"], "truncated hint script")
        hint_output = checked(hint["output"], "truncated hint output")
        require(
            hint_script.read_text(encoding="ascii")
            == ltrunc_runner.hint_script(ltrunc_runner.predecessor_leaders()),
            "truncated hint reconstruction",
        )
        require(
            "G3AP_F2_WLTRUNC_HINT_PASS" in hint_output.read_text(encoding="utf-8"),
            "truncated hint execution",
        )
        expected_candidate_script = ltrunc_runner.candidate_script(
            source, hint["hilbert_numerator"]
        )
        candidate_pass_marker = "G3AP_F2_WLTRUNC_LEADER_EXPORT_PASS"
        candidate_engine = "ltrunc-hilbert"
        expected_certification_script = ltrunc_cert.certification_script(
            source, candidate_base, candidate_module
        )
        parse_certified_leaders = ltrunc_cert.parse_leaders
        raw_prefix = "G3AP_F2_WLTRUNCCERT"
    else:
        candidate_base = checked(
            candidate["inputs"]["weighted_base_cache"], "candidate base"
        )
        hint_path = checked(candidate["inputs"]["truncated_hint"], "truncated hint")
        hint = json.loads(hint_path.read_text(encoding="ascii"))
        hint_script = checked(hint["script"], "truncated hint script")
        hint_output = checked(hint["output"], "truncated hint output")
        require(
            hint_script.read_text(encoding="ascii")
            == boxtrunc_runner.hint_script(boxtrunc_runner.predecessor_leaders()),
            "Cox-box hint reconstruction",
        )
        require(
            "G3AP_F2_WBOXTRUNC_HINT_PASS"
            in hint_output.read_text(encoding="utf-8"),
            "Cox-box hint execution",
        )
        expected_candidate_script = boxtrunc_runner.candidate_script(
            source, hint["hilbert_numerator"]
        )
        candidate_pass_marker = "G3AP_F2_WBOXTRUNC_LEADER_EXPORT_PASS"
        candidate_engine = "boxtrunc-hilbert"
        expected_certification_script = ltrunc_cert.certification_script(
            source, candidate_base, candidate_module
        )
        parse_certified_leaders = ltrunc_cert.parse_leaders
        raw_prefix = "G3AP_F2_WLTRUNCCERT"
    require(
        fiber2.candidate_script_matches(
            candidate_script.read_text(encoding="ascii"),
            expected_candidate_script,
            bool(candidate["execution"].get("leader_recovery_used")),
        ),
        "candidate reconstruction",
    )
    require(
        candidate_pass_marker in candidate_output.read_text(encoding="utf-8"),
        "candidate exact selected-engine execution",
    )
    require(packet["execution"]["candidate_engine"] == candidate_engine, "candidate engine")
    require(
        script.read_text(encoding="ascii") == expected_certification_script,
        "certification reconstruction",
    )
    raw = output.read_text(encoding="utf-8")
    expected = {
        f"{raw_prefix}_BASE_CANDIDATE_IS_SB_ATTR": 0,
        f"{raw_prefix}_BASE_IDEAL_EQUAL": 1,
        f"{raw_prefix}_MODULE_CANDIDATE_IS_SB_ATTR": 0,
        f"{raw_prefix}_ORIGINAL_GENERATORS": 21,
        f"{raw_prefix}_BAD_GENERATOR_REMAINDERS": 0,
        f"{raw_prefix}_BOUND": weighted.TARGET_SCALAR_DEGREE,
    }
    if candidate_engine in ("ltrunc-hilbert", "boxtrunc-hilbert"):
        expected[f"{raw_prefix}_COX_HOMOGENEOUS"] = 1
    for label, value in expected.items():
        require(
            re.search(rf"^{label}={value}$", raw, re.MULTILINE) is not None,
            label,
        )
    require(f"{raw_prefix}_PASS" in raw, "raw pass")
    base, module = parse_certified_leaders(raw)
    candidate_base_leaders = cert.parse_candidate_base_leaders(raw, raw_prefix)
    require(
        cert.same_monomial_ideal(candidate_base_leaders, base),
        "candidate/recomputed base leading-ideal equality",
    )
    require(len(base) == packet["execution"]["base_basis_size"], "base count")
    require(
        len(module) == packet["execution"]["certified_target_reduction_set_size"],
        "module count",
    )
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    candidate_runner.annotate_weighted_sectors(sectors)
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(
        total == fiber2.EXPECTED_TOTAL == 174865
        and standards == [fiber2.EXPECTED_STANDARD],
        "exact target replay",
    )
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    if candidate_engine == "ltrunc-hilbert":
        expected_l_degrees = [2, 5, 3, 8, 6, 4]
        require(
            candidate["truncation"]
            == packet["truncation"]
            == {
                "kind": "componentwise_L_degree_above_target",
                "target_L_degrees": expected_l_degrees,
                "minimal_monomial_generators": 165,
                "target_piece_of_truncation_module_is_zero": True,
            },
            "target-preserving L truncation",
        )
        require(
            len(ltrunc_runner.truncation_generators()) == 165,
            "independent truncation generator count",
        )
    elif candidate_engine == "boxtrunc-hilbert":
        require(
            candidate["truncation"]
            == packet["truncation"]
            == {
                "kind": "componentwise_H_and_L_degree_above_target",
                "target_H_degrees": [30, 24, 33, 18, 27, 36],
                "target_L_degrees": [2, 5, 3, 8, 6, 4],
                "minimal_H_boundary_generators": 11994,
                "minimal_L_boundary_generators": 165,
                "minimal_monomial_generators": 12159,
                "target_divisor_box_piece_of_truncation_module_is_zero": True,
            },
            "target-preserving Cox-box truncation",
        )
        require(
            len(boxtrunc_runner.h_boundary_generators()) == 11994
            and len(boxtrunc_runner.truncation_generators()) == 12159,
            "independent Cox-box generator count",
        )
    top = packet["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["H_plus_L_scalar_degree"] == 44
        and top["weighted_scalar_degree"] == weighted.TARGET_SCALAR_DEGREE
        and top["dimension"] == 1
        and top["basis"] == ["w^12*t2^4*s^2"],
        "top line",
    )
    base_record = packet["execution"]["certified_base_cache"]
    module_record = packet["execution"]["certified_module_cache"]
    require(base_cache.stat().st_size == base_record["bytes"] > 0, "base bytes")
    require(module_cache.stat().st_size == module_record["bytes"] > 0, "module bytes")
    require(base_record["isSB_trust_attribute_stored"] is False, "base trust scope")
    require(
        module_record["valid_through_weighted_scalar_degree"]
        == weighted.TARGET_SCALAR_DEGREE
        and module_record["valid_for_Cox_degree"] == [18, 2, 2]
        and module_record["is_full_standard_basis"] is False
        and module_record["isSB_trust_attribute_stored"] is False,
        "module scope",
    )
    verify_cache_headers(source, base_cache, module_cache, len(base), len(module))
    print(
        "UST.G3AP weighted leading-squeeze verifier: PASS "
        f"base={len(base)} reducer={len(module)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
