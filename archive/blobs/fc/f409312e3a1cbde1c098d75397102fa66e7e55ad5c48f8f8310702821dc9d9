def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="ascii"))


def dump(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, ensure_ascii=True) + "\n", encoding="ascii")


def binary_quartic_invariants(coefficients: list[int]) -> tuple[int, int, int, Fraction]:
    require(len(coefficients) == 5, "binary quartic coefficient count")
    a, b, c, d, e = coefficients
    invariant_i = 12 * a * e - 3 * b * d + c * c
    invariant_j = (
        72 * a * c * e
        + 9 * b * c * d
        - 27 * a * d * d
        - 27 * b * b * e
        - 2 * c * c * c
    )
    discriminant_numerator = 4 * invariant_i**3 - invariant_j**2
    j_invariant = Fraction(6912 * invariant_i**3, discriminant_numerator)
    return invariant_i, invariant_j, discriminant_numerator, j_invariant


def parse_phi3_specialization(path: Path) -> dict[int, int]:
    coefficients: dict[int, int] = {0: 0}
    pattern = re.compile(r"^\[(\d+),(\d+)\]\s+(-?\d+)$")
    for raw_line in path.read_text(encoding="ascii").splitlines():
        match = pattern.fullmatch(raw_line.strip())
        require(match is not None, "classical modular polynomial row")
        power_x, power_y, value = map(int, match.groups())
        if power_y == 0:
            coefficients[power_x] = value
    return coefficients


def evaluate_polynomial(coefficients: dict[int, int], value: Fraction) -> Fraction:
    return sum((Fraction(coefficient) * value**power for power, coefficient in coefficients.items()), Fraction(0))


def main() -> None:
    evidence = load(EVIDENCE)
    source_hashes = {
        name: item["sha256"] for name, item in evidence["source_packets"].items()
    }
    require(source_hashes == EXPECTED_SOURCE_HASHES, "source packet hash locks")
    selected = evidence["selected_support"]
    require(selected["delta_pullback"] == "O", "delta-trivial support")
    require(selected["fiber_j_invariant"] == 0, "Fermat j invariant")

    invariant_i, invariant_j, discriminant_numerator, j_base = binary_quartic_invariants(
        selected["base_quartic_coefficients"]
    )
    require(discriminant_numerator // 27 == selected["base_quartic_discriminant"], "quartic discriminant")
    require(
        j_base == Fraction(132105539357000, 288838009),
        "base j invariant",
    )
    require(math.gcd(j_base.numerator, j_base.denominator) == 1, "reduced base j")
    require(j_base.denominator > 1, "base j is a nonintegral rational")

    phi3 = parse_phi3_specialization(PHI3)
    scale = 12288000
    expected_phi3 = {0: 0, 1: scale**3, 2: 3 * scale**2, 3: 3 * scale, 4: 1}
    require(phi3 == expected_phi3, "Phi_3(X,0)=X(X+12288000)^3")
    phi3_at_base = evaluate_polynomial(phi3, j_base)
    require(phi3_at_base != 0, "no cyclic degree-three isogeny")
    require(evaluate_polynomial(phi3, Fraction(0)) == 0, "Phi3 j=0 control")
    require(
        evaluate_polynomial(phi3, Fraction(-scale)) == 0,
        "Phi3 nonzero CM-neighbor control",
    )

    classes = evidence["numerical_classes"]
    require(
        classes["A_squared"] == classes["B_squared"] == 0
        and classes["A_dot_B"] == 1
        and classes["gysin_A"] == "0"
        and classes["gysin_B"] == "u",
