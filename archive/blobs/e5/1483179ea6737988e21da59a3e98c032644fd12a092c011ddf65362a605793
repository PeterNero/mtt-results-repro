#!/usr/bin/env python3
"""Verify the one-split-prime H11 endpoint correction action."""

from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path
from typing import Any

import numpy as np
from scipy import sparse

import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import build_ust_g3bo_h11_endpoint_correction_action as builder
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3bo_h11_endpoint_correction_action.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any], repository: Path | None = None) -> Path:
    path = (
        repository / record["repository_relative_path"]
        if repository is not None
        else ROOT / record["path"]
    )
    require(path.is_file(), f"record path {path}")
    require(sha256(path) == record["sha256"], f"record hash {path.name}")
    require(path.stat().st_size == record["bytes"], f"record bytes {path.name}")
    return path


def main() -> None:
    packet = load(PACKET)
    require(
        packet["schema"] == "mtt.unified-source.g3bo-h11-endpoint-correction-action.v1",
        "schema",
    )
    require(all(packet["checks"].values()), "recorded checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_H11_physical_split_prime_residue as h11_io
    import build_q79_eta9_H20_split_prime_reconstruction as arithmetic
    import export_q79_eta9_split_prime_selected_chart as exporter

    paths: dict[str, Path] = {}
    for name, record in packet["inputs"].items():
        paths[name] = verify_record(record, mld if "repository_relative_path" in record else None)
    residue_path = verify_record(packet["operator_action"]["binary"])
    prime, coefficients = h11_io.read_residue(residue_path)
    require(prime == packet["field"]["prime"] == builder.PRIME, "residue prime")
    require(coefficients.shape == (5439, 248, 6), "residue shape")
    require(
        np.count_nonzero(coefficients) == packet["operator_action"]["nonzero_coefficients"],
        "residue nonzeros",
    )

    g3bi = load(paths["G3BI"])
    g3bk = load(paths["G3BK"])
    b103 = load(paths["B103"])
    macaulay = load(paths["H11_Macaulay"])
    factor = load(paths["H11_factorization"])
    base_actions = load(paths["split_prime_base_actions"])
    roots = [int(value) for value in packet["field"]["roots_of_selected_sextic"]]
    require(roots == [int(value) for value in base_actions["field"]["roots_of_selected_sextic"]], "root order")
    expected_digest = g3bk["characteristic_zero_derivative_sources"]["H20_to_H11"][
        "canonical_exact_source_sha256"
    ]
    total_residuals = 0
    evaluation_mismatches = 0
    for root_record, root in zip(packet["root_solves"], roots, strict=True):
        require(int(root_record["gamma_root"]) == root, "root record order")
        base_chart_path = verify_record(root_record["base_chart"], mld)
        chart_path = verify_record(root_record["endpoint_chart"])
        rhs_path = verify_record(root_record["correction_RHS"])
        solution_path = verify_record(root_record["solution"])
        log_path = verify_record(root_record["solver_log"])
        base_chart, base_prime, quotient_units, image_rank = initializer.read_chart(base_chart_path)
        require(base_prime == prime and (quotient_units, image_rank) == (1013, 4426), "base chart typing")
        derivatives = initializer.correction_derivatives(g3bi, exporter, prime, root)
        update = initializer.correction_update(macaulay, factor, derivatives, prime)
        expected_chart = (
            base_chart.astype(np.uint64)
            + sparse.hstack(
                [
                    sparse.csc_matrix((5439, quotient_units), dtype=np.uint64),
                    update.astype(np.uint64),
                ],
                format="csc",
            )
        ).tocsc()
        expected_chart.data %= prime
        expected_chart.eliminate_zeros()
        stored_chart, stored_prime, stored_quotient, stored_image = initializer.read_chart(chart_path)
        require(
            (stored_prime, stored_quotient, stored_image) == (prime, quotient_units, image_rank),
            "endpoint chart typing",
        )
        require((stored_chart != expected_chart).nnz == 0, "endpoint chart replay")
        expected_rhs, digest = builder.exact_source_matrix(
            g3bi, b103, macaulay, exporter, root
        )
        require(digest == expected_digest, "exact source digest")
        rhs_binary = arithmetic.read_csc(rhs_path, b"MTTSRH1\0", 4)
        solution_binary = arithmetic.read_csc(solution_path, b"MTTSCO1\0", 6)
        rhs = h11_io.as_scipy(rhs_binary)
        solution = h11_io.as_scipy(solution_binary)
        require((rhs != expected_rhs).nnz == 0, "correction RHS replay")
        residuals = h11_io.residual_nonzeros(stored_chart, solution, rhs, prime)
        total_residuals += residuals
        require(residuals == root_record["residual_nonzeros"] == 0, "root residual")
        fields = initializer.parse_log(log_path)
        require(fields["STATUS"] == "SUCCESS", "solver status")
        require(
            int(fields["CHART_DETERMINANT"])
            == root_record["endpoint_determinant_mod21817"]
            != 0,
            "root determinant",
        )
        evaluated = np.zeros((5439, 248), dtype=np.uint64)
        for degree in reversed(range(6)):
            evaluated = (evaluated * root + coefficients[:, :, degree]) % prime
        evaluation_mismatches += int(
            np.count_nonzero(evaluated.astype(np.uint32) != solution.toarray().astype(np.uint32))
        )

    require(total_residuals == packet["verification"]["linear_system_residual_nonzeros"] == 0, "all residuals")
    require(
        evaluation_mismatches
        == packet["verification"]["interpolation_evaluation_mismatches"]
        == 0,
        "interpolation replay",
    )
    require(packet["theorem"]["tier"] == "CLOSED_EXACT_ONE_SPLIT_PRIME_OPERATOR_ACTION", "theorem tier")
    print("UST.G3BO H11 endpoint correction action verifier: PASS")
    print(
        f"prime={prime} roots=6 residuals={total_residuals} interpolation_mismatches={evaluation_mismatches}"
    )


if __name__ == "__main__":
    main()
