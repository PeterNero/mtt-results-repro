#!/usr/bin/env python3
"""Locate and invoke Singular reproducibly on native hosts or through WSL."""

from __future__ import annotations

import os
from pathlib import Path
import shlex
import shutil
import subprocess


def wsl_path(path: Path) -> str:
    resolved = path.resolve()
    drive = resolved.drive.rstrip(":").lower()
    if not drive:
        raise ValueError(f"Windows drive is required for WSL conversion: {resolved}")
    return f"/mnt/{drive}{resolved.as_posix()[2:]}"


def singular_command(root: Path, script: Path) -> list[str]:
    """Return a one-core Singular command with portable bundled-runtime discovery."""
    binary_override = os.environ.get("MTT_SINGULAR_BIN")
    if os.name != "nt":
        binary = binary_override or shutil.which("Singular")
        if not binary:
            raise FileNotFoundError("Singular; set MTT_SINGULAR_BIN")
        return [str(binary), "-q", "--threads=1", str(script)]

    distribution = os.environ.get("MTT_WSL_DISTRIBUTION", "Ubuntu")
    root_override = os.environ.get("MTT_SINGULAR_ROOT")
    if not root_override:
        home_probe = subprocess.run(
            [
                "wsl",
                "-d",
                distribution,
                "--",
                "sh",
                "-c",
                'printf "%s" "$HOME"',
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        home = home_probe.stdout.strip()
        for candidate in (
            f"{home}/.local/opt/singular-4.4.1/root",
            f"{home}/.local/opt/singular/root",
        ):
            if not home:
                break
            probe = subprocess.run(
                ["wsl", "-d", distribution, "--", "test", "-d", candidate],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if probe.returncode == 0:
                root_override = candidate
                break
    relative = str(script.resolve().relative_to(root.resolve())).replace("\\", "/")
    if root_override:
        binary = binary_override or f"{root_override}/usr/bin/Singular"
        library = f"{root_override}/usr/lib/x86_64-linux-gnu"
        modules = f"{library}/singular/MOD"
        shell = (
            f"export LD_LIBRARY_PATH={shlex.quote(library + ':' + modules)}; "
            f"export SINGULARPATH={shlex.quote(root_override + '/usr/share/singular/LIB:' + modules)}; "
            f"export SINGULAR_BIN_DIR={shlex.quote(root_override + '/usr/bin')}; "
            f"export SINGULAR_DATA_DIR={shlex.quote(root_override + '/usr/share')}; "
            f"export SINGULAR_PROCS_DIR={shlex.quote(modules)}; "
            f"export SINGULAR_ROOT_DIR={shlex.quote(root_override + '/usr')}; "
            f"cd {shlex.quote(wsl_path(root))} && "
            f"{shlex.quote(binary)} -q --threads=1 {shlex.quote(relative)}"
        )
    else:
        binary = binary_override or "Singular"
        shell = (
            f"cd {shlex.quote(wsl_path(root))} && "
            f"{shlex.quote(binary)} -q --threads=1 {shlex.quote(relative)}"
        )
    return ["wsl", "-d", distribution, "--", "bash", "-lc", shell]
