+typedef struct {
+    len_t node;
+    uint32_t coefficient;
+} q79_f4_dag_term_t;
+
+static int q79_f4_dag_enabled = 0;
+static int q79_f4_dag_active = 0;
+static const char *q79_f4_dag_path = NULL;
+static FILE *q79_f4_dag_file = NULL;
+static len_t q79_f4_dag_next_node = 1;
+static uint64_t q79_f4_dag_reducer_terms = 0;
+
+static void q79_f4_dag_initialize(const bs_t *bs, const md_t *md)
+{
+    q79_f4_dag_path = getenv("MSOLVE_F4_OPERATION_DAG");
+    if (q79_f4_dag_path == NULL || q79_f4_dag_path[0] == '\0') {
+        return;
+    }
+    q79_f4_dag_file = fopen(q79_f4_dag_path, "w");
+    if (q79_f4_dag_file == NULL) {
+        return;
+    }
+    if (md->ff_bits != 8 || md->nthrds != 1) {
+        fprintf(q79_f4_dag_file, "ERROR\tREQUIRES_FF8_AND_ONE_THREAD\n");
+        fclose(q79_f4_dag_file);
+        q79_f4_dag_file = NULL;
+        return;
+    }
+    q79_f4_dag_enabled = 1;
+    q79_f4_dag_next_node = 1;
+    q79_f4_dag_reducer_terms = 0;
+    fprintf(q79_f4_dag_file,
+            "FORMAT\tMSOLVE_F4_OPERATION_DAG_V1\t%u\t%u\t%u\n",
+            md->fc, bs->ht->nv, bs->ht->evl);
+    for (bl_t i = 0; i < bs->ld; ++i) {
+        const hm_t *row = bs->hm[i];
+        const cf8_t *coefficients = bs->cf_8[row[COEFFS]];
+        fprintf(q79_f4_dag_file, "INITIAL\t%u\t%d\t%u\n",
+                i, row[DEG], row[LENGTH]);
+        for (len_t j = 0; j < row[LENGTH]; ++j) {
+            const exp_t *exponent = bs->ht->ev[row[OFFSET+j]];
+            fprintf(q79_f4_dag_file, "ITERM\t%u", coefficients[j]);
+            for (len_t k = 1; k < bs->ht->evl; ++k) {
+                fprintf(q79_f4_dag_file, "\t%u", exponent[k]);
+            }
+            fprintf(q79_f4_dag_file, "\n");
+        }
+        fprintf(q79_f4_dag_file, "ENDINITIAL\n");
+    }
+    fflush(q79_f4_dag_file);
+}
+
+static void q79_f4_dag_attach_input(
+        hm_t *row,
+        const bs_t *bs,
+        const bl_t basis_index,
+        const hi_t multiplier_hash,
+        const char kind,
+        const len_t matrix_row
+        )
+{
+    if (!q79_f4_dag_enabled) {
+        return;
+    }
+    const len_t node = q79_f4_dag_next_node++;
+    const exp_t *exponent = bs->ht->ev[multiplier_hash];
+    fprintf(q79_f4_dag_file, "INPUT\t%u\t%u\t%c\t%u\t%u",
+            node, q79_f4_provenance_round, kind, matrix_row, basis_index);
+    for (len_t k = 1; k < bs->ht->evl; ++k) {
+        fprintf(q79_f4_dag_file, "\t%u", exponent[k]);
+    }
+    fprintf(q79_f4_dag_file, "\n");
+    row[MULT] = node;
+}
+
+static len_t q79_f4_dag_reduce(
+        const len_t parent,
+        const q79_f4_dag_term_t *terms,
+        const len_t count,
+        const int nonzero
+        )
+{
+    if (!q79_f4_dag_active) {
+        return parent;
+    }
+    if (count == 0 && nonzero) {
+        return parent;
+    }
+    if (!nonzero) {
+        return parent;
+    }
+    const len_t node = q79_f4_dag_next_node++;
+    fprintf(q79_f4_dag_file, "REDUCE\t%u\t%u\t%u",
+            node, parent, count);
+    for (len_t i = 0; i < count; ++i) {
+        fprintf(q79_f4_dag_file, "\t%u\t%u",
+                terms[i].node, terms[i].coefficient);
+    }
+    fprintf(q79_f4_dag_file, "\n");
+    q79_f4_dag_reducer_terms += count;
+    return node;
+}
+
+static void q79_f4_dag_scale(hm_t *row, const uint32_t coefficient)
+{
+    if (!q79_f4_dag_active || coefficient == 1) {
+        return;
+    }
+    const len_t node = q79_f4_dag_next_node++;
+    fprintf(q79_f4_dag_file, "SCALE\t%u\t%u\t%u\n",
+            node, row[MULT], coefficient);
+    row[MULT] = node;
+}
+
+static void q79_f4_dag_capture(const mat_t *mat, const bl_t from)
+{
+    if (!q79_f4_dag_enabled || !q79_f4_dag_active) {
+        return;
+    }
+    for (len_t k = 0; k < mat->np; ++k) {
+        const len_t row_index = mat->np - 1 - k;
+        fprintf(q79_f4_dag_file, "BASIS\t%u\t%u\n",
+                from+k, mat->tr[row_index][MULT]);
+    }
+    fprintf(q79_f4_dag_file, "ENDROUND\t%u\n", q79_f4_provenance_round);
+    fflush(q79_f4_dag_file);
+    q79_f4_dag_active = 0;
+}
+
+static void q79_f4_dag_finalize(void)
+{
+    if (q79_f4_dag_file == NULL) {
+        return;
+    }
+    fprintf(q79_f4_dag_file, "END\t%u\t%llu\n",
+            q79_f4_dag_next_node - 1,
+            (unsigned long long)q79_f4_dag_reducer_terms);
+    fclose(q79_f4_dag_file);
+    q79_f4_dag_file = NULL;
+    q79_f4_dag_enabled = 0;
+    q79_f4_dag_active = 0;
+}
