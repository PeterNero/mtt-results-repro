def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def diagonal(values: list[Fraction]) -> list[list[Fraction]]:
    return [
        [value if row == column else Fraction(0) for column in range(len(values))]
        for row, value in enumerate(values)
    ]


def kronecker(
    left: list[list[Fraction]], right: list[list[Fraction]]
) -> list[list[Fraction]]:
    rows = len(left) * len(right)
    columns = len(left[0]) * len(right[0])
    output = zeros(rows, columns)
    for left_row, left_values in enumerate(left):
        for left_column, left_value in enumerate(left_values):
            for right_row, right_values in enumerate(right):
                for right_column, right_value in enumerate(right_values):
                    output[left_row * len(right) + right_row][
                        left_column * len(right[0]) + right_column
                    ] = left_value * right_value
    return output


@cache
def source_freshness() -> dict[str, Any]:
    manifest = json.loads((ROOT / "source_manifest.json").read_text(encoding="utf-8"))
    rows = []
    for source in manifest["sources"]:
        path = (ROOT / source["path"]).resolve()
        actual = sha256(path) if path.is_file() else None
        rows.append(
            {
                "id": source["id"],
                "role": source["role"],
                "path": source["path"],
                "expected_sha256": source["sha256"],
                "actual_sha256": actual,
                "state": "current" if actual == source["sha256"] else ("missing" if actual is None else "stale"),
            }
        )
    return {
        "schema": "MTTQMSourceFreshnessCertificate.v1",
        "all_current": all(row["state"] == "current" for row in rows),
        "sources": rows,
    }


