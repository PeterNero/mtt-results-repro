            "next_positive_gap_units": 100,
        },
        "checks": {
            "rank1200_subsystem_is_exact_and_has21_independent_kernel_columns": True,
            "exact_recovery_and_literal_complement_audit_cover_all1200_selected_rows": True,
            "all_exact_defects_are_confined_to_the38_omitted_rows": True,
            "new_good_specialization_matches_the_exact_residual_map_in798_slots": True,
            "exact_adjugate_or_quotient_elimination_proves_the_residual_rank": True,
            "component16_rank_and_nullity_follow_by_exact_rank_nullity": True,
            "global_upper_endpoint_uses_the_exact_component16_increment": True,
        },
        "guardrails": {
            "claims_all21_finite_kernel_directions_lift_to_Qgamma": False,
            "claims_global_H02_rank_equals4748": False,
            "claims_remaining_global_gap_is_closed": False,
            "claims_selected_evolving_source_or_path_execution": False,
            "claims_physical_endpoint_or_master_operator": False,
        },
        "theorem": {
            "statement": (
                "The selected1200-row component16 subsystem has exact rank1200 and a "
                "displayed21-column kernel basis. Exact recovery enforces800 selected "
                "rows and literal Q(gamma) replay vanishes on the complementary400; "
                "all exact defects lie in the38 omitted rows. Exact quotient-field "
                f"factorization gives residual rank{exact_residual_rank}. The full "
                f"reduced matrix therefore has rank{exact_full_reduced_rank} and "
                f"nullity{exact_full_reduced_nullity}; reversing608 exact contractions "
                f"gives component16 rank{component16_rank}. Exactly{lifted_directions} "
                f"of the21 finite kernel directions lift to characteristic zero and "
                f"{nonlifting_directions} do not, tightening the global interval to"
                f"4748..{global_upper}."
            ),
            "tier": "CLOSED_EXACT_CHARACTERISTIC_ZERO_COMPONENT_LIFT_ADJUDICATION",
        },
        "frontier_delta": {
            "before": "Component16 had finite rank138 and nullity21, but the characteristic-zero fate of those21 relations was undecided.",
            "after": (
                f"The exact residual map has rank{exact_residual_rank}; "
                f"{lifted_directions} finite relations lift and {nonlifting_directions} "
                f"do not. Component16 is frozen at exact rank{component16_rank}, and "
                f"the global interval is4748..{global_upper}."
            ),
        },
        "next_required_object": (
            "Freeze components0,9,12,16. Inspect only ordered component20's100-unit "
            "gap and require the same exact lift-or-no-lift adjudication before any "
