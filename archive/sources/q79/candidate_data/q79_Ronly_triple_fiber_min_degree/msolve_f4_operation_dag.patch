             fprintf(file, "INPUT\t%c\t%u\t%u\t%u\t%u\n",
@@ -94,11 +231,14 @@ static void q79_f4_provenance_prepare(mat_t *mat, const bs_t *bs)
                     kind, i, basis_index, multiplier_degree, bound);
             row[BINDEX] = bound;
