{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtt.unified-source.q79-invariant-yoneda-column.v1",
  "title": "UST.G3M q79 conjugate-clock invariant Yoneda column certificate",
  "type": "object",
  "required": [
    "schema",
    "candidate_id",
    "source_hash",
    "orbit_member",
    "stabilizer",
    "domain_dimension",
    "fixed_quotient_line_artifact",
    "cech_representative_artifact",
    "target_basis_artifact",
    "yoneda_column_artifact",
    "column_decision",
    "connecting_lift_artifact",
    "shift_transport_artifact",
    "empirical_inputs",
    "physical_promotion_requested"
  ],
  "properties": {
    "schema": {
      "const": "mtt.unified-source.q79-invariant-yoneda-column.v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "orbit_member": {
      "const": 0
    },
    "stabilizer": {
      "const": "Z_0"
    },
    "domain_dimension": {
      "const": 1
    },
    "fixed_quotient_line_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "cech_representative_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "target_basis_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "yoneda_column_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "column_decision": {
      "enum": [
        "UNDECIDED",
        "ZERO",
        "NONZERO"
      ]
    },
    "connecting_lift_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "shift_transport_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "empirical_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "physical_promotion_requested": {
      "type": "boolean"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
