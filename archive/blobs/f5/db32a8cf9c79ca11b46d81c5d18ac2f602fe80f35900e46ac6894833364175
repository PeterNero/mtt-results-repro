    guardrail_checks = {
        "auxiliary_spectral_family_is_not_called_upper_action_selected": True,
        "first_tangent_match_is_not_called_full_EG_jet_equality": True,
        "SP_orbit_equivalence_is_not_called_literal_composite_field_equality": True,
        "no_uniform_cutoff_estimate_is_inferred_from_Duhamel": True,
        "no_interacting_continuum_Cstar_net_is_claimed": True,
