        "certificate": "MTTQMQFTGRRecoveryInterface",
        "status": "MTT_QM_QFT_GR_RECOVERY_INTERFACE_BUILT_EMPIRICAL_LEDGER_OPEN",
        "candidate_path": str(OUTPUT_DATA.relative_to(ROOT)),
        "note_path": str(OUTPUT_NOTE.relative_to(ROOT)),
        "what_closes": {
            "QM_recovery_interface": True,
            "QFT_recovery_interface": True,
