    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="utf-8")
    print("UST.G3EU component16 exact residual adjudication: PASS")
    print(
        f"residual_rank={exact_residual_rank} full_reduced_rank={exact_full_reduced_rank} "
        f"component16_rank={component16_rank}"
