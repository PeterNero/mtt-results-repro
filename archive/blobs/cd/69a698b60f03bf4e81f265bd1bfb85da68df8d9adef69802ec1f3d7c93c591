ROOT = Path(__file__).resolve().parent
STATE = ROOT / "state"
DEFAULT_SOURCE = (
    ROOT / "evidence" / "q79_eta9_cayley_jacobian_leading_exponents.singular.out"
)
SOURCE_SHA256 = "c601d55c6df41c73f80189d80700fb287483e434bb7f2eeca5ffcd3a71c0beb9"
SOURCE_COMMIT = "bc0c9f9e852b41bae9d26a9ac0a17b6cd9de2692"
