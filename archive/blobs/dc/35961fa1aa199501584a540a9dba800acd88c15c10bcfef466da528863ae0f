    f6 = base["explicit_K3"]["F6_equals_G3_squared_plus_Q2_H4"].replace("**", "^")
    return "\n".join(
        [
            "option(redSB);",
            f"ring r={PRIME},({','.join(VARIABLES)}),{ordering};",
            f"number gamma={ROOT_VALUE};",
            "number gammaRelation=0;",
            f"poly F6={f6};",
            "poly K=w^2-F6;",
            "poly E=t0^3+t1^3+t2^3;",
            f"poly A0={endpoint_rows[0]};",
            f"poly A1={endpoint_rows[1]};",
            f"poly A2={endpoint_rows[2]};",
            "poly C=A0*t0+A1*t1+A2*t2;",
            "poly Phi=u*K+v*E+s*C;",
            "ideal J=jacob(Phi);",
        ]
    )


def degree_check_procedure() -> str:
    return r'''
proc coxDegreeCheck(poly inputPoly, int targetH, int targetL, int targetXi)
{
  poly remaining=inputPoly;
  intvec exponent;
  int degreeH; int degreeL; int degreeXi;
  while (remaining!=0)
  {
    exponent=leadexp(remaining);
    degreeH=exponent[1]+exponent[2]+exponent[3]+3*exponent[4]-6*exponent[8]-9*exponent[10];
    degreeL=exponent[5]+exponent[6]+exponent[7]-3*exponent[9]-exponent[10];
    degreeXi=exponent[8]+exponent[9]+exponent[10];
    if ((degreeH!=targetH) || (degreeL!=targetL) || (degreeXi!=targetXi)) { return(0); }
    remaining=remaining-lead(remaining);
  }
  return(1);
}
'''


