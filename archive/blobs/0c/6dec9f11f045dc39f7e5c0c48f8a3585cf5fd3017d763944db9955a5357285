int i;
print("G3AP_F2_WQHCERT_BASE_CANDIDATE_IS_SB_ATTR="+string(attrib(GI,"isSB")));
print("G3AP_F2_WQHCERT_BASE_CANDIDATE_SIZE="+string(size(GI)));
for (i=1;i<=size(GI);i++)
{{ print("G3AP_F2_WQHCERT_BASE_CANDIDATE_LEADER_"+string(i)+"_EXP="+string(leadexp(GI[i]))); }}
ideal GICheck=std(GI);
int equalBase=1;
for (i=1;i<=size(G0);i++)
{{ if (reduce(G0[i],GICheck)!=0) {{ equalBase=0; }} }}
for (i=1;i<=size(GICheck);i++)
{{ if (reduce(GICheck[i],G0)!=0) {{ equalBase=0; }} }}
print("G3AP_F2_WQHCERT_BASE_IDEAL_EQUAL="+string(equalBase));
print("G3AP_F2_WQHCERT_BASE_GB_SIZE="+string(size(GICheck)));
for (i=1;i<=size(GICheck);i++)
{{ print("G3AP_F2_WQHCERT_BASE_LEADER_"+string(i)+"_EXP="+string(leadexp(GICheck[i]))); }}
attrib(GICheck,"isSB",0);
write("ssi:w {base_relative}",GICheck);
attrib(GICheck,"isSB",1);
qring q=GICheck;
{representatives_after}
module M=
  {generators};
intvec componentShifts={shifts};
attrib(M,"isHomog",componentShifts);
def cachedCandidate=read("ssi:r {candidate_module_relative}");
module candidateBasis=cachedCandidate;
print("G3AP_F2_WQHCERT_MODULE_CANDIDATE_IS_SB_ATTR="+string(attrib(candidateBasis,"isSB")));
attrib(candidateBasis,"isHomog",componentShifts);
degBound={weighted.TARGET_SCALAR_DEGREE};
