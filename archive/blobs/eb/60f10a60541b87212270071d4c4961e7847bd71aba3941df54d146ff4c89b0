            },
            "interpolation_evaluation_mismatches": interpolation_mismatches,
        },
        "promotion_reduction": {
            "previous_normalized_full_kernel_field_coefficients": old_field_coefficients,
            "graded_generator_field_coefficients": field_coefficients,
            "previous_power_basis_scalars": old_field_coefficients * 6,
            "graded_generator_power_basis_scalars": field_coefficients * 6,
            "compression_factor": old_field_coefficients / field_coefficients,
            "fraction_removed": 1.0 - field_coefficients / old_field_coefficients,
        },
        "checks": {
