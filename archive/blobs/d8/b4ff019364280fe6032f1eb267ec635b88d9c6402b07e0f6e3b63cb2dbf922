ROOT = Path(__file__).resolve().parent
CANONICAL = ROOT / "state" / "ust_g3ap_selected_cayley_ordinary_top_dimension.packet.json"
BASE_NAMES = ("x", "y", "z", "w", "t0", "t1", "t2")
PHYSICAL_COMPONENTS = ("u2", "uv", "us", "v2", "vs", "s2")
DEFAULT_TOP_EXPONENT = (0, 0, 0, 12, 0, 0, 4)
TARGET_RESPONSE_COX_DEGREE = [18, 2, 2]
TARGET_RESPONSE_H_PLUS_L_DEGREE = 44


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    if not path.is_file() or sha256(path) != record["sha256"]:
        raise AssertionError(f"{label} hash")
    return path


def scalar_monomial(exponent: list[int] | tuple[int, ...]) -> str:
    if len(exponent) != len(BASE_NAMES) or any(int(value) < 0 for value in exponent):
        raise AssertionError("fiber-two scalar monomial exponent")
    factors: list[str] = []
    for name, value in zip(BASE_NAMES, exponent):
        power = int(value)
        if power == 1:
            factors.append(name)
        elif power > 1:
            factors.append(f"{name}^{power}")
    return "*".join(factors) or "1"


def fiber2_coordinates_from_canonical(canonical: dict) -> dict[str, object]:
    """Extract and validate physical-to-module coordinates from a G3AP packet."""
    if (
        canonical.get("schema")
        != "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1"
        or canonical.get("status")
        != "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_SOCLE_DIMENSION_ONE"
        or not all(canonical.get("checks", {}).values())
        or any(canonical.get("guardrails", {}).values())
    ):
        raise AssertionError("canonical G3AP coordinate source is not closed")

    permutation = canonical.get("leading_ideal", {}).get("permutation")
    if permutation is None:
        order = list(range(1, 7))
        old_to_new = {value: value for value in order}
        new_to_old = dict(old_to_new)
        label = "identity"
    else:
        order = [int(value) for value in permutation["old_components_in_new_position_order"]]
        old_to_new = {
            int(key): int(value) for key, value in permutation["old_to_new"].items()
        }
        new_to_old = {
            int(key): int(value) for key, value in permutation["new_to_old"].items()
        }
        label = str(permutation["label"])
    if (
        sorted(order) != list(range(1, 7))
        or old_to_new != {old: new for new, old in enumerate(order, start=1)}
        or new_to_old != {new: old for old, new in old_to_new.items()}
    ):
        raise AssertionError("canonical G3AP component permutation")

    top = canonical["ordinary_top_piece"]
    if "basis_base_exponent" in top:
        exponent = [int(value) for value in top["basis_base_exponent"]]
        normalization_old = int(top.get("basis_old_component", 6))
    else:
        if top.get("basis") != ["w^12*t2^4*s^2"]:
            raise AssertionError("legacy canonical G3AP top basis")
        exponent = list(DEFAULT_TOP_EXPONENT)
        normalization_old = 6
    if len(exponent) != 7 or not 1 <= normalization_old <= 6:
        raise AssertionError("canonical G3AP normalization basis")
    normalization_new = old_to_new[normalization_old]
    if (
        "basis_new_component" in top
        and int(top["basis_new_component"]) != normalization_new
    ):
        raise AssertionError("canonical G3AP normalization component map")

    initial_old = 2
    return {
        "permutation_label": label,
        "old_components_in_module_position_order": order,
        "old_to_module_position": [old_to_new[value] for value in range(1, 7)],
        "module_position_to_old": [new_to_old[value] for value in range(1, 7)],
        "physical_components_in_old_order": list(PHYSICAL_COMPONENTS),
        "initial_physical_component": PHYSICAL_COMPONENTS[initial_old - 1],
        "initial_old_component": initial_old,
        "initial_module_position": old_to_new[initial_old],
        "normalization_physical_component": PHYSICAL_COMPONENTS[
            normalization_old - 1
        ],
        "normalization_old_component": normalization_old,
        "normalization_module_position": normalization_new,
        "normalization_base_exponent": exponent,
        "normalization_scalar_monomial": scalar_monomial(exponent),
    }


def selected_fiber2_coordinates() -> dict[str, object]:
    """Return physical-to-module coordinates bound by the canonical G3AP packet."""
    if not CANONICAL.is_file():
        raise AssertionError("canonical G3AP certificate is absent")
    canonical = json.loads(CANONICAL.read_text(encoding="ascii"))
    return fiber2_coordinates_from_canonical(canonical)


