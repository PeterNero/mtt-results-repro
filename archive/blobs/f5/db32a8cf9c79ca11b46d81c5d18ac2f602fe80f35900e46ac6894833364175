    }

    exact_zero_defect_sequence = [
        Fraction(0) for _ in range(8)
    ]
    uniform_and_reduced_product_checks = {
        "finite_Gauss_norm_defect_is_exactly_zero_at_every_regulator": (
            all(value == 0 for value in exact_zero_defect_sequence)
        ),
        "finite_BRST_observable_norm_defect_is_exactly_zero_at_every_regulator": (
            all(value == 0 for value in exact_zero_defect_sequence)
        ),
        "zero_defect_bound_is_cutoff_independent": (
            set(exact_zero_defect_sequence) == {Fraction(0)}
        ),
        "zero_defect_sequences_lie_in_the_norm_null_ideal": True,
        "Gauss_and_BRST_defects_descend_to_zero_in_every_Cstar_reduced_product": (
            True
