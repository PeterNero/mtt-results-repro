        work = [row[:] for row in matrix]
        value = Fraction(1)
        for column in range(len(work)):
            pivot_row = next(
                (
                    row
                    for row in range(column, len(work))
                    if work[row][column] != 0
                ),
                None,
            )
            if pivot_row is None:
                return Fraction(0)
            if pivot_row != column:
                work[column], work[pivot_row] = (
                    work[pivot_row],
                    work[column],
                )
                value *= -1
            pivot = work[column][column]
            value *= pivot
            for row in range(column + 1, len(work)):
                factor = work[row][column] / pivot
                for entry in range(column, len(work)):
                    work[row][entry] -= (
                        factor * work[column][entry]
                    )
        return value

    def contractible_bv_block(
        amplitude: Fraction,
    ) -> list[list[Fraction]]:
        return [
            [Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
            [amplitude, Fraction(0), Fraction(0), Fraction(0)],
            [Fraction(0), Fraction(0), Fraction(0), -amplitude],
            [Fraction(0), Fraction(0), Fraction(0), Fraction(0)],
        ]

    symplectic_block = [
        [Fraction(0), Fraction(0), Fraction(1), Fraction(0)],
        [Fraction(0), Fraction(0), Fraction(0), Fraction(1)],
        [Fraction(-1), Fraction(0), Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(-1), Fraction(0), Fraction(0)],
    ]
    lagrangian_block = [
        [Fraction(1), Fraction(0)],
        [Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(1)],
    ]
    q_initial = block_diagonal(
        [
            contractible_bv_block(Fraction(1)),
            contractible_bv_block(Fraction(2)),
        ]
    )
    omega = block_diagonal(
        [symplectic_block, symplectic_block]
    )
    delta_initial = add(
        mul(q_initial, transpose(q_initial)),
        mul(transpose(q_initial), q_initial),
    )
    delta_inverse = diagonal(
        [Fraction(1) for _ in range(4)]
        + [Fraction(1, 4) for _ in range(4)]
    )
    h_initial = mul(transpose(q_initial), delta_inverse)
    lagrangian_initial = block_diagonal(
        [lagrangian_block, lagrangian_block]
    )
    shell_hessian_initial = mul(
        transpose(lagrangian_initial),
        mul(omega, mul(q_initial, lagrangian_initial)),
    )

    boundary_rotation = [
        [Fraction(3, 5), Fraction(-4, 5)],
        [Fraction(4, 5), Fraction(3, 5)],
    ]
    interior_rotation = [
        [Fraction(5, 13), Fraction(-12, 13)],
        [Fraction(12, 13), Fraction(5, 13)],
    ]
    boundary_unitary = block_diagonal(
        [boundary_rotation, boundary_rotation]
    )
    interior_unitary = block_diagonal(
        [interior_rotation, interior_rotation]
    )
    transported_region_unitary = block_diagonal(
        [boundary_unitary, interior_unitary]
    )
    based_diffeomorphism_unitary = block_diagonal(
        [eye(4), interior_unitary]
    )
    boundary_trace = [
        [
            Fraction(int(row == column))
            if column < 4
            else Fraction(0)
            for column in range(8)
        ]
        for row in range(4)
    ]

    q_transported = mul(
