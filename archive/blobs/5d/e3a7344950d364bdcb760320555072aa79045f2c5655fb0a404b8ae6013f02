def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record(path: Path) -> dict[str, object]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def inverse_mod(matrix: np.ndarray, prime: int) -> np.ndarray:
    size = matrix.shape[0]
    require(matrix.shape == (size, size), "square inverse input")
    work = np.concatenate(
        (matrix.astype(np.int64) % prime, np.eye(size, dtype=np.int64)), axis=1
    )
    for column in range(size):
        choices = np.flatnonzero(work[column:, column])
        require(choices.size > 0, "invertible pivot")
        selected = column + int(choices[0])
        if selected != column:
            work[[column, selected]] = work[[selected, column]]
        work[column] = (
            work[column] * pow(int(work[column, column]), -1, prime)
        ) % prime
        for row in range(size):
            if row != column and work[row, column]:
                work[row] = (
                    work[row] - int(work[row, column]) * work[column]
                ) % prime
    return work[:, size:]


def lift_syzygy(
    syzygy: np.ndarray,
    coefficient_degree: int,
    target_degree: int,
    prime: int,
) -> np.ndarray:
    source_basis = graded.homogeneous_exponents(coefficient_degree)
    target_basis = graded.homogeneous_exponents(target_degree)
    target_lookup = {exponent: row for row, exponent in enumerate(target_basis)}
    multipliers = graded.homogeneous_exponents(target_degree - coefficient_degree)
    result = np.zeros((4 * len(target_basis), len(multipliers)), dtype=np.int64)
    for local, multiplier in enumerate(multipliers):
        for generator in range(4):
            for row, exponent in enumerate(source_basis):
                shifted = tuple(exponent[index] + multiplier[index] for index in range(3))
                result[
                    generator * len(target_basis) + target_lookup[shifted], local
                ] = syzygy[generator * len(source_basis) + row]
    return result % prime


def canonical_degree8_syzygy(
    generators11: np.ndarray,
    syzygy1: np.ndarray,
    syzygy2: np.ndarray,
    prime: int,
) -> tuple[np.ndarray, tuple[int, ...], int, tuple[int, ...]]:
    map19 = graded.multiply_space(generators11, 11, 19, prime)
    rank19, _, syzygies8 = graded.rref(map19, prime, emit_nullspace=True)
    require(rank19 == 115 and syzygies8 is not None, "degree19 syzygy space")
    require(syzygies8.shape == (180, 65), "degree8 coefficient syzygies")

    inherited = np.concatenate(
        (
            lift_syzygy(syzygy1, 1, 8, prime),
            lift_syzygy(syzygy2, 2, 8, prime),
        ),
        axis=1,
    )
    inherited_rank, _, _ = graded.rref(inherited, prime)
    require(inherited.shape == (180, 64) and inherited_rank == 64, "64 inherited syzygies")
    new, selected, combined_rank = graded.complement_columns(
        inherited, syzygies8, prime
    )
    require(new.shape == (180, 1) and combined_rank == 65, "one new degree8 syzygy")

    pivot_rank, pivot_rows, _ = graded.rref(inherited.T, prime)
    require(pivot_rank == 64 and len(pivot_rows) == 64, "inherited pivot rows")
    pivot = np.asarray(pivot_rows, dtype=np.int64)
    coefficients = inverse_mod(inherited[pivot, :], prime) @ new[pivot, 0] % prime
    canonical = (new[:, 0] - inherited @ coefficients) % prime
    require(np.count_nonzero(canonical[pivot]) == 0, "quotient representative pivot zeros")
    support = np.flatnonzero(canonical)
    require(support.size > 0, "nonzero quotient representative")
    normalization_coordinate = int(support[0])
    canonical = (
        canonical * pow(int(canonical[normalization_coordinate]), -1, prime)
    ) % prime
    require(canonical[normalization_coordinate] == 1, "degree8 normalization")
    require(np.count_nonzero(map19 @ canonical % prime) == 0, "degree8 syzygy replay")
    return canonical, tuple(int(value) for value in pivot_rows), normalization_coordinate, selected


def multiply_polynomials(
    left: np.ndarray,
    left_degree: int,
    right: np.ndarray,
    right_degree: int,
    prime: int,
) -> np.ndarray:
    left_basis = graded.homogeneous_exponents(left_degree)
    right_basis = graded.homogeneous_exponents(right_degree)
    target_basis = graded.homogeneous_exponents(left_degree + right_degree)
    lookup = {exponent: row for row, exponent in enumerate(target_basis)}
    result = np.zeros(len(target_basis), dtype=np.int64)
    for i, left_exponent in enumerate(left_basis):
        if not left[i]:
            continue
        for j, right_exponent in enumerate(right_basis):
            if not right[j]:
                continue
            exponent = tuple(
                left_exponent[index] + right_exponent[index] for index in range(3)
            )
            result[lookup[exponent]] += int(left[i]) * int(right[j])
    return result % prime


def determinant3(columns: list[list[np.ndarray]], prime: int) -> np.ndarray:
    result = np.zeros(len(graded.homogeneous_exponents(11)), dtype=np.int64)
    for permutation in itertools.permutations(range(3)):
        inversions = sum(
            permutation[i] > permutation[j]
            for i in range(3)
            for j in range(i + 1, 3)
        )
        first = multiply_polynomials(
            columns[0][permutation[0]], (1, 2, 8)[permutation[0]],
            columns[1][permutation[1]], (1, 2, 8)[permutation[1]], prime,
        )
        product = multiply_polynomials(
            first, (1, 2, 8)[permutation[0]] + (1, 2, 8)[permutation[1]],
            columns[2][permutation[2]], (1, 2, 8)[permutation[2]], prime,
        )
        result = (result + (-1 if inversions % 2 else 1) * product) % prime
    return result


def signed_maximal_minors(
    syzygy1: np.ndarray,
    syzygy2: np.ndarray,
    syzygy8: np.ndarray,
    prime: int,
) -> np.ndarray:
    sizes = (3, 6, 45)
    vectors = (syzygy1, syzygy2, syzygy8)
    matrix = [
        [
            vectors[column][row * sizes[column] : (row + 1) * sizes[column]]
            for column in range(3)
        ]
        for row in range(4)
    ]
    minors: list[np.ndarray] = []
    for omitted in range(4):
        rows = [matrix[row] for row in range(4) if row != omitted]
        determinant = determinant3(rows, prime)
        minors.append(((-1) ** omitted * determinant) % prime)
    return np.stack(minors, axis=1) % prime


def common_scalar(left: np.ndarray, right: np.ndarray, prime: int) -> int:
    support = np.argwhere(right % prime)
    require(support.size > 0, "comparison support")
    row, column = (int(value) for value in support[0])
    scalar = int(left[row, column]) * pow(int(right[row, column]), -1, prime) % prime
    require(np.array_equal(left % prime, scalar * right % prime), "common scalar equality")
    return scalar


def projective_line_restriction(polynomial: np.ndarray, prime: int) -> np.ndarray:
    """Restrict a degree-11 form to [x:y:z]=[s:t:s+2t], then set s=1."""
    result = np.zeros(12, dtype=np.int64)
    for coefficient, (a, b, c) in zip(
        polynomial, graded.homogeneous_exponents(11), strict=True
    ):
        for power in range(c + 1):
            result[b + power] += (
                int(coefficient) * math.comb(c, power) * 2**power
            )
    return result % prime


def polynomial_gcd(left: np.ndarray, right: np.ndarray, prime: int) -> np.ndarray:
    def trim(value: np.ndarray) -> np.ndarray:
        nonzero = np.flatnonzero(value % prime)
        return np.zeros(1, dtype=np.int64) if nonzero.size == 0 else value[: int(nonzero[-1]) + 1] % prime

    a = trim(left)
    b = trim(right)
    while np.any(b):
        remainder = a.copy()
        inverse = pow(int(b[-1]), -1, prime)
        while remainder.size >= b.size and np.any(remainder):
            shift = remainder.size - b.size
            coefficient = int(remainder[-1]) * inverse % prime
            remainder[shift : shift + b.size] = (
                remainder[shift : shift + b.size] - coefficient * b
            ) % prime
            remainder = trim(remainder)
        a, b = b, remainder
    require(np.any(a), "nonzero polynomial gcd")
    return a * pow(int(a[-1]), -1, prime) % prime


