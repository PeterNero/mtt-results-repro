            operator_rank, row_profile, _ = graded.rref(operator.T, prime)
            require(operator_rank == 115, "operator rank")
            canonical_row_profiles.append(tuple(int(value) for value in row_profile))
            square = chart_matrix(operator, prime)
            determinant = determinant_mod(square, prime)
            require(determinant != 0, "fixed chart determinant")
            determinant_values[prime_index, root_index] = determinant
            source = g3fz["second_jet_source_coefficients"][
                prime_index, root_index
            ].astype(np.int64) % prime
            require(np.count_nonzero(operator @ source % prime) == 0, "source kernel")
            require(np.array_equal(square @ source % prime, rhs), "fixed-minor source")
