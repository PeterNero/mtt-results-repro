        _, packet = split_by_prime[prime]
        roots = tuple(int(value) for value in packet["field"]["roots"])
        target_rows = {int(row["gamma_root"]): row for row in packet["root_kernels"]}
        residues = np.load(height.cache_paths(prime)[0], allow_pickle=False)[
            "normalized_relation_power_basis_residues"
        ].astype(np.int64)
        q_pdelta = q_times_pdelta_vector(prime)
        require(q_pdelta.shape == (45,), "qPdelta vector")
        for root in roots:
            normalized = evaluate(residues, root, prime)
            canonical = normalized[local_component, :] % prime
            target = component_kernel(target_rows[root], prime)
            identity = np.eye(100, dtype=np.int64)
            require(
                np.array_equal(canonical[36:, :], identity)
                and np.array_equal(target[36:, :], identity),
                "common dependent identity",
            )
            mismatches = int(np.count_nonzero(canonical[:36, :] != target[:36, :]))
            require(mismatches > 0, "planes separated")
            separation_rows.append(
                {
                    "prime": prime,
                    "gamma_root": root,
                    "independent_block_slots": 3600,
                    "mismatches": mismatches,
                }
            )

            generators, syzygy_block, _ = finite.extract_fiber(
                ROOT / target_rows[root]["kernel"]["path"], prime
            )
            degree8, _, _, _ = hilbert_burch.canonical_degree8_syzygy(
                generators[11], syzygy_block[:12], syzygy_block[12:], prime
            )
            finite_space = degree8.reshape(4, 45).T.astype(np.int64) % prime
            raw_space = raw_fourth_normal_space(d7_coefficients, root, prime)
            finite_rank = graded.rref(finite_space, prime)[0]
            raw_rank = graded.rref(raw_space, prime)[0]
            joint_rank = graded.rref(
                np.concatenate((finite_space, raw_space), axis=1), prime
            )[0]
            require((finite_rank, raw_rank, joint_rank) == (4, 4, 8), "raw source separation")
            raw_rows.append(
                {
                    "prime": prime,
                    "gamma_root": root,
                    "finite_O8_rank": finite_rank,
                    "raw_xD7_yD7_zD7_qPdelta_rank": raw_rank,
                    "combined_rank": joint_rank,
                }
            )

            if anchor_profiles is None:
                anchor_profiles = {
                    "G3FT_canonical_plane": list(ideal_profile(canonical, prime)),
                    "G3FR_selected_plane": list(ideal_profile(target, prime)),
                }

    require(len(separation_rows) == len(raw_rows) == 48, "48-fiber campaign")
    require(anchor_profiles is not None, "anchor profiles")
    require(tuple(anchor_profiles["G3FT_canonical_plane"]) == CANONICAL_PROFILE, "canonical profile")
    require(tuple(anchor_profiles["G3FR_selected_plane"]) == TARGET_PROFILE, "selected profile")

