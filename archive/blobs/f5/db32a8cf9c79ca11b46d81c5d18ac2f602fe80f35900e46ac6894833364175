        two_interval_path_effects[1],
        two_interval_path_effects[3],
    )
    two_interval_q_effect = add(
        two_interval_path_effects[2],
        two_interval_path_effects[4],
    )
    path_effects_commute = all(
        mul(left, right) == mul(right, left)
        for left in two_interval_path_effects
        for right in two_interval_path_effects
    )
    path_effects_are_nondemolition = all(
        mul(effect, p) == mul(p, effect)
