#!/usr/bin/env python3
"""Run a path-isolated std hedge for the selected Cayley basis calculation."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import time

from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
SOURCE = ROOT / "state" / "ust_g3al_selected_cayley_basis.sing"
SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std.sing"
OUTPUT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std.singular.out"
CACHE = ROOT / "state" / "ust_g3am_selected_cayley_basis_std.ssi"
RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std.result.json"
NORED_SCRIPT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std_nored.sing"
NORED_OUTPUT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std_nored.singular.out"
NORED_CACHE = ROOT / "state" / "ust_g3am_selected_cayley_basis_std_nored.ssi"
NORED_RESULT = ROOT / "state" / "ust_g3am_selected_cayley_basis_std_nored.result.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=86400)
    parser.add_argument("--no-red", action="store_true")
    args = parser.parse_args()
    source = SOURCE.read_text(encoding="ascii")
    script_path = NORED_SCRIPT if args.no_red else SCRIPT
    output_path = NORED_OUTPUT if args.no_red else OUTPUT
    cache_path = NORED_CACHE if args.no_red else CACHE
    result_path = NORED_RESULT if args.no_red else RESULT
    cache_relative = str(cache_path.relative_to(ROOT)).replace("\\", "/")
    require(source.count("ideal G=slimgb(J);") == 1, "one slimgb basis command")
    require(
        source.count('write("ssi:w state/ust_g3al_selected_cayley_basis.ssi",G);') == 1,
        "one canonical cache write",
    )
    script_source = source
    if args.no_red:
        require(source.count("option(redSB);\n") == 1, "one redSB option")
        script_source = source.replace("option(redSB);\n", "", 1)
    script = script_source.replace("ideal G=slimgb(J);", "ideal G=std(J);").replace(
        'write("ssi:w state/ust_g3al_selected_cayley_basis.ssi",G);',
        f'write("ssi:w {cache_relative}",G);',
    )
    script_path.write_text(script, encoding="ascii")
    started = time.time()
    timed_out = False
    try:
        completed = subprocess.run(
            singular_command(ROOT, script_path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        output = completed.stdout
        returncode = completed.returncode
    except subprocess.TimeoutExpired as error:
        timed_out = True
        raw = error.stdout or b""
        output = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else raw
        returncode = 124
    output_path.write_text(output, encoding="utf-8")
    elapsed = time.time() - started
    passed = (
        not timed_out
        and returncode == 0
        and "G3AL_SELECTED_CAYLEY_BASIS_PASS" in output
        and "G3AL_SOCLE_ZERO=0" in output
        and cache_path.is_file()
        and cache_path.stat().st_size > 0
    )
    result = {
        "schema": "mtt.unified-source.g3am-selected-cayley-basis-std-hedge-result.v1",
        "source": {"path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(SOURCE)},
        "script": {"path": str(script_path.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(script_path)},
        "output": {"path": str(output_path.relative_to(ROOT)).replace("\\", "/"), "sha256": sha256(output_path)},
        "cache": (
            {"path": cache_relative, "sha256": sha256(cache_path), "bytes": cache_path.stat().st_size}
            if cache_path.is_file()
            else None
        ),
        "algorithm": "std_nored" if args.no_red else "std",
        "uses_redSB": not args.no_red,
        "elapsed_seconds": elapsed,
        "returncode": returncode,
        "timed_out": timed_out,
        "passed": passed,
    }
    result_path.write_text(json.dumps(result, indent=2) + "\n", encoding="ascii")
    print(
        "G3AM selected Cayley std hedge "
        f"variant={'nored' if args.no_red else 'redSB'} "
        f"passed={passed} elapsed={elapsed:.1f}s"
    )
    if not passed:
        raise SystemExit(returncode or 1)


if __name__ == "__main__":
    main()
