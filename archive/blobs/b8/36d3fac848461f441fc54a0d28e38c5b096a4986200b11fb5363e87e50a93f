def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def compile_tool() -> str:
    require(SOURCE.is_file(), "kernel-tool source")
    completed = subprocess.run(
        [
            "wsl",
            "g++",
            "-O3",
            "-std=c++17",
            runtime.wsl_path(SOURCE),
            "-o",
            runtime.wsl_path(EXECUTABLE),
        ],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    require(completed.returncode == 0, completed.stdout + completed.stderr)
    require(EXECUTABLE.is_file(), "kernel-tool executable")
    return completed.stdout.strip() or "compiled exact split-prime kernel tool"


def read_kernel(path: Path) -> dict[str, Any]:
    raw = path.read_bytes()
    require(raw[:8] == b"MTTKER1\0", "kernel magic")
    (
        prime,
        rows,
        columns,
        nonzeros,
        ambient_rows,
        ambient_rank,
        update_start,
        selected_count,
    ) = struct.unpack_from("<8Q", raw, 8)
    offset = 8 + 8 * 8
    indptr = np.frombuffer(raw, dtype="<u8", count=columns + 1, offset=offset).copy()
    offset += (columns + 1) * 8
    indices = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset).copy()
    offset += nonzeros * 4
    data = np.frombuffer(raw, dtype="<u4", count=nonzeros, offset=offset).copy()
    offset += nonzeros * 4
    dependent = np.frombuffer(raw, dtype="<u4", count=columns, offset=offset).copy()
    offset += columns * 4
    selected = np.frombuffer(raw, dtype="<u4", count=selected_count, offset=offset).copy()
    offset += selected_count * 4
    require(offset == len(raw), "kernel binary length")
    matrix = sparse.csc_matrix((data, indices, indptr), shape=(rows, columns))
    require(matrix.has_canonical_format, "canonical kernel CSC")
    return {
        "prime": int(prime),
        "ambient_rows": int(ambient_rows),
        "ambient_rank": int(ambient_rank),
        "update_start": int(update_start),
        "selected": selected.astype(np.int32),
        "dependent": dependent.astype(np.int32),
        "matrix": matrix,
    }


def interpolate(values: np.ndarray) -> np.ndarray:
    require(values.shape[0] == 6, "six root values")
    vandermonde = np.asarray(
        [[pow(root, degree, PRIME) for degree in range(6)] for root in ROOTS],
        dtype=np.int64,
    )
    augmented = np.concatenate(
        (vandermonde, np.eye(6, dtype=np.int64)), axis=1
    )
    for column in range(6):
        choices = np.flatnonzero(augmented[column:, column] % PRIME)
        require(choices.size > 0, "Vandermonde pivot")
        selected = column + int(choices[0])
        if selected != column:
            augmented[[column, selected]] = augmented[[selected, column]]
        augmented[column] = augmented[column] * pow(int(augmented[column, column] % PRIME), -1, PRIME) % PRIME
        for row in range(6):
            if row == column:
                continue
            factor = int(augmented[row, column] % PRIME)
            if factor:
                augmented[row] = (augmented[row] - factor * augmented[column]) % PRIME
    inverse = augmented[:, 6:].astype(np.uint64)
    coefficients = np.empty(values.shape, dtype=np.uint16)
    for degree in range(6):
        accumulator = np.zeros(values.shape[1:], dtype=np.uint64)
        for root_index in range(6):
            accumulator += values[root_index].astype(np.uint64) * inverse[degree, root_index]
            accumulator %= PRIME
        coefficients[degree] = accumulator.astype(np.uint16)
    return coefficients


def evaluate(coefficients: np.ndarray, root: int) -> np.ndarray:
    value = coefficients[-1].astype(np.uint64)
    for degree in reversed(range(coefficients.shape[0] - 1)):
        value = (value * root + coefficients[degree]) % PRIME
    return value.astype(np.uint16)


