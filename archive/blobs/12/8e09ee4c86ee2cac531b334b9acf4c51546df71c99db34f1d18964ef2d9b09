#!/usr/bin/env python3
"""Verify the selected toric-residue lower bound for G3AP."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path

import build_ust_g3ap_selected_cayley_ordinary_top_lower_bound as build


ROOT = Path(__file__).resolve().parent
PACKET = build.OUT


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> dict:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-ordinary-top-lower-bound.v1",
        "schema",
    )
    require(packet["theorem_id"] == "UST.G3AP.LOWER", "theorem id")
    require(
        packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_AT_LEAST_ONE",
        "status",
    )
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    g3ao = checked(packet["inputs"]["G3AO_selected_toric_regularity"], "G3AO")
    b71 = checked(packet["inputs"]["B71_common_toric_ambient"], "B71")
    b72 = checked(packet["inputs"]["B72_structural_R1_duality"], "B72")
    require(sha256(build.B71) == build.B71_SHA256, "immutable B71")
    require(sha256(build.B72) == build.B72_SHA256, "immutable B72")
    require(
        g3ao["orbit_systems"] == {"passed": 735, "total": 735}
        and all(g3ao["checks"].values()),
        "selected regularity replay",
    )
    common_keys = (
        "description",
        "Cox_degree_matrix_by_variable",
        "dimension",
        "Cayley_degree",
        "Cox_anticanonical_degree",
        "maximal_chart_count",
        "chart_cover",
        "chart_gauge_degree_determinants",
    )
    require(
        all(
            g3ao["toric_ambient"][key] == b71["toric_ambient"][key]
            for key in common_keys
        ),
        "ambient replay",
    )
    require(
        g3ao["toric_ambient"]["chart_gauge_is_etale_over_F1016"] is True,
        "etale gauges",
    )
    require(
        b71["semiample_certificate"]["top_self_intersection_xi7"]
        == build.TOP_INTERSECTION
        and build.TOP_INTERSECTION % build.PRIME == 60,
        "residue unit replay",
    )
    require(
        b72["degree_ledger"]["ordinary_top_degree_8beta_minus2beta0"]
        == [18, 2, 2]
        and b72["checks"][
            "the_ordinary_partial_Jacobian_ideal_is_contained_in_J1"
        ]
        is True,
        "ordinary R1 map replay",
    )
    require(
        packet["selected_field"]
        == {
            "prime": 101,
            "extension_degree": 6,
            "chart_gauge_degree_determinants": [1, 3],
            "top_self_intersection": 14301,
            "top_self_intersection_mod_prime": 60,
        },
        "selected field arithmetic",
    )
    top = packet["ordinary_top_piece"]
    require(
        top["Cox_degree"] == [18, 2, 2]
        and top["lower_bound_dimension"] == 1,
        "top lower bound",
    )
    require(
        [row["name"] for row in packet["proof_chain"]]
        == [
            "selected_logarithmic_regular_sequence",
            "selected_R1_top_line_nonzero",
            "ordinary_top_surjection",
        ],
        "proof chain",
    )
    print(
        "UST.G3AP selected ordinary-top lower-bound verifier: PASS "
        "dimension>=1 residue_unit=60 mod101"
    )


if __name__ == "__main__":
    main()
