            "G3FK": record(G3FK),
        },
        "source_matrix": {
            "ring": "Q(gamma)[x,y,z,w,t0,t1,t2] with the frozen Cox bidegrees",
            "shape": [4, 3],
            "rows": ["q", "r", "ell", "t2"],
            "columns": ["K3", "E", "F_selected"],
            "entries": [
