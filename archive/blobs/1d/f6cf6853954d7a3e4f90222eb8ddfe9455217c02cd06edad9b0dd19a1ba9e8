def main() -> None:
    mld = resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_cayley_jacobian_reducer as cayley_reducer
    import build_q79_eta9_cayley_ordinary_top_dimension as ordinary
    import build_q79_eta9_smooth_graph_slice_witness as residue
    import build_q79_eta9_targeted_original_jacobian_transform as targeted
    import build_q79_eta9_toric_return_stage1_chunk as stage
    import verify_q79_eta9_original_jacobian_coordinate_solver as solver_io

    g3bm = load(G3BM)
    g3cc = load(G3CC)
    g3cn = load(G3CN)
    g3co = load(G3CO)
    for label, packet in (("G3BM", g3bm), ("G3CC", g3cc), ("G3CN", g3cn), ("G3CO", g3co)):
        require(all(packet["checks"].values()), f"{label} checks")

    schedule_path = mld / "q79_eta9_targeted_original_jacobian_macaulay_schedule.packet.json"
    schedule = load(schedule_path)
    b103 = load(stage.B103)
    quotient_jets = quotient_jet_polynomials(g3cn, schedule, solver_io)
    selected_indices = [int(value) for value in schedule["inputs"]["support_union"]["support_indices_one_based"]] if "support_indices_one_based" in schedule["inputs"]["support_union"] else [
        int(value)
        for group in schedule["groups_in_selected_order"]
        for value in group["selected_Groebner_indices_one_based"]
    ]
    require(len(selected_indices) == 225, "selected support")
    require(selected_indices == [int(value) for value in load(stage.SUPPORT)["support_union_indices_one_based"]], "support order")

    h02 = next(block for block in b103["basis_blocks"] if block["name"] == "H02")
    source_record = g3cc["terminal_source"]["B103_H02_vector"]
    source_path = ROOT / source_record["path"]
    require(source_path.is_file() and sha256(source_path) == source_record["sha256"], "G3CC source vector")
    source_vector = np.load(source_path).astype(np.uint8)
    require(source_vector.shape == (248,), "source vector shape")
    source_polynomial = {
        tuple(int(value) for value in exponent): int(coefficient)
        for exponent, coefficient in zip(h02["basis_exponent_vectors"], source_vector, strict=True)
        if int(coefficient) % PRIME
    }
    require(len(source_polynomial) == 229, "selected source nnz")
    source_text = polynomial_text(source_polynomial, ordinary)

    g3bi = load(ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json")
    correction_b0, correction_terms = __import__(
        "probe_ust_g3bm_correction_toric_return_chunk"
    ).correction_b0(g3bi, ordinary)
    require(len(correction_terms) == 18, "correction terms")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    script_path = EVIDENCE / "selected_source_transform_defect.sing"
    output_path = EVIDENCE / "selected_source_transform_defect.singular.out"
    ls_cache = EVIDENCE / "selected_source_pole_six_division_LS.ssi"
    defect_cache = EVIDENCE / "selected_source_composed_quotient_defect.ssi"
    correction_cache = EVIDENCE / "selected_source_original_partial_correction.ssi"
    correction_return_cache = EVIDENCE / "selected_source_correction_return.ssi"
    correction_normal_cache = EVIDENCE / "selected_source_correction_H02_normal_form.ssi"
    correction_next_cache = EVIDENCE / "selected_source_correction_next_quotient.ssi"
    ls_json_path = EVIDENCE / "selected_source_pole_six_division_LS.json"
    defect_json_path = EVIDENCE / "selected_source_composed_quotient_defect.json"
    correction_json_path = EVIDENCE / "selected_source_original_partial_correction.json"
    correction_return_json_path = EVIDENCE / "selected_source_correction_return.json"
    correction_normal_json_path = EVIDENCE / "selected_source_correction_H02_normal_form.json"
    correction_normal_binary_path = EVIDENCE / "selected_source_correction_H02_normal_form.u8"
    correction_ambient_rhs_path = EVIDENCE / "selected_source_correction_H02_ambient.rhs.cscbin"
    correction_ambient_npz_path = EVIDENCE / "selected_source_correction_H02_ambient.npz"
    script_path.write_text(
        make_script(
            source_text,
            correction_b0,
            quotient_jets,
            selected_indices,
            ordinary,
            targeted,
            cayley_reducer,
            stage.TRANSFORM_CACHE,
            ls_cache,
            defect_cache,
            correction_cache,
            correction_return_cache,
            correction_normal_cache,
            correction_next_cache,
            stage.make_degree_check_procedure(),
        ),
        encoding="utf-8",
    )
    output, engine, timed_out, elapsed = residue.run_singular(script_path, 1800.0)
    output_path.write_text(output, encoding="utf-8")
    require(not timed_out, f"Singular timeout after {elapsed:.1f}s")
    require("G3CQ_PASS" in output, output[-4000:])
    require(parse_marker(output, "G3CQ_GAMMA_REL") == 0, "gamma relation")
    require(parse_marker(output, "G3CQ_SOURCE_DIVISION_RESIDUAL_ZERO") == 1, "source division")
    require(parse_marker(output, "G3CQ_DEFECT_REDUCTION_RESIDUAL_ZERO") == 1, "defect reduction")
    require(parse_marker(output, "G3CQ_SELECTED_RECONSTRUCTION_ZERO") == 1, "selected reconstruction")
    require(parse_marker(output, "G3CQ_CORRECTION_COEFFICIENT_DEGREES_OK") == 1, "correction coefficient degrees")
    require(parse_marker(output, "G3CQ_CORRECTION_RETURN_DEGREE_OK") == 1, "correction return degree")

    ls_polynomials: list[dict[tuple[int, ...], int]] = []
    for index in range(225):
        match = re.search(rf"^G3CQ_LS_{index}=(.*)$", output, flags=re.MULTILINE)
        require(match is not None, f"LS row {index}")
        parsed = stage.strict.parse_normal_form(match.group(1).strip())
        ls_polynomials.append({tuple(key): int(value) % PRIME for key, value in parsed.items() if int(value) % PRIME})
    defect_match = re.search(r"^G3CQ_DEFECT=(.*)$", output, flags=re.MULTILINE)
    require(defect_match is not None, "defect polynomial")
    singular_defect = {
        tuple(key): int(value) % PRIME
        for key, value in stage.strict.parse_normal_form(defect_match.group(1).strip()).items()
        if int(value) % PRIME
    }

    python_defect: defaultdict[tuple[int, ...], int] = defaultdict(int)
    for quotient, multiplier in zip(quotient_jets, ls_polynomials, strict=True):
        for left_exp, left_coefficient in quotient.items():
            for right_exp, right_coefficient in multiplier.items():
                exponent = tuple(left + right for left, right in zip(left_exp, right_exp, strict=True))
                python_defect[exponent] = (
                    python_defect[exponent] + left_coefficient * right_coefficient
                ) % PRIME
    python_defect = defaultdict(int, {key: value for key, value in python_defect.items() if value})
    require(dict(python_defect) == singular_defect, "independent defect convolution")
    require(len(singular_defect) == parse_marker(output, "G3CQ_DEFECT_TERMS"), "defect term count")

    correction_coefficients: list[dict[tuple[int, ...], int]] = []
    for index in range(10):
        match = re.search(rf"^G3CQ_CORRECTION_COEFFICIENT_{index}=(.*)$", output, flags=re.MULTILINE)
        require(match is not None, f"correction coefficient {index}")
        parsed = stage.strict.parse_normal_form(match.group(1).strip())
        correction_coefficients.append(
            {tuple(key): int(value) % PRIME for key, value in parsed.items() if int(value) % PRIME}
        )
    correction_return_match = re.search(r"^G3CQ_CORRECTION_RETURN=(.*)$", output, flags=re.MULTILINE)
    correction_normal_match = re.search(r"^G3CQ_CORRECTION_NORMAL_FORM=(.*)$", output, flags=re.MULTILINE)
    require(correction_return_match is not None and correction_normal_match is not None, "correction returns")
    correction_return = {
        tuple(key): int(value) % PRIME
        for key, value in stage.strict.parse_normal_form(correction_return_match.group(1).strip()).items()
        if int(value) % PRIME
    }
    correction_normal = {
        tuple(key): int(value) % PRIME
        for key, value in stage.strict.parse_normal_form(correction_normal_match.group(1).strip()).items()
        if int(value) % PRIME
    }
    python_return: dict[tuple[int, ...], int] = {}
    for variable_index, coefficient in enumerate(correction_coefficients):
        for exponent, value in derivative(coefficient, variable_index).items():
            python_return[exponent] = (python_return.get(exponent, 0) - value) % PRIME
            if python_return[exponent] == 0:
                del python_return[exponent]
    require(python_return == correction_return, "independent minus-divergence")
    require(len(correction_return) == parse_marker(output, "G3CQ_CORRECTION_RETURN_TERMS"), "correction return terms")
    require(len(correction_normal) == parse_marker(output, "G3CQ_CORRECTION_NORMAL_FORM_TERMS"), "normal form terms")
    h02_lookup = {
        tuple(int(value) for value in exponent): index
        for index, exponent in enumerate(h02["basis_exponent_vectors"])
    }
    require(all(exponent in h02_lookup for exponent in correction_normal), "correction normal form in H02 basis")
    correction_normal_vector = np.zeros(248, dtype=np.uint8)
    for exponent, coefficient in correction_normal.items():
        correction_normal_vector[h02_lookup[exponent]] = coefficient % PRIME
    correction_normal_binary_path.write_bytes(correction_normal_vector.tobytes(order="C"))
    h02_macaulay = load(stage.H02_MACAULAY)
    require(all(h02_macaulay["checks"].values()), "H02 Macaulay checks")
    h02_ambient_vectors = [
        tuple(int(value) for value in exponent)
        for exponent in h02_macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    h02_ambient_lookup = {exponent: index for index, exponent in enumerate(h02_ambient_vectors)}
    require(len(h02_ambient_vectors) == len(h02_ambient_lookup) == 42706, "H02 ambient basis")
    require(all(exponent in h02_ambient_lookup for exponent in correction_return), "correction return in H02 ambient basis")
    ambient_rows = np.asarray(
        [h02_ambient_lookup[exponent] for exponent in correction_return], dtype=np.int32
    )
    ambient_data = np.asarray(
        [correction_return[exponent] for exponent in correction_return], dtype=np.uint8
    )
    correction_ambient_rhs = sparse.csc_matrix(
        (ambient_data, (ambient_rows, np.zeros(len(ambient_rows), dtype=np.int32))),
        shape=(42706, 1),
        dtype=np.uint8,
    )
