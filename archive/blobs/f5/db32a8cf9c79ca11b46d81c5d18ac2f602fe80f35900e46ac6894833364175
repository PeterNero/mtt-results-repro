        covector: tuple[int, int, int, int],
    ) -> dict[str, Any]:
        k = [Fraction(value) for value in covector]
        norm_squared = sum((value * value for value in k), Fraction(0))
        k_column = [[value] for value in k]
        k_row = [k]
        longitudinal = mul(k_column, k_row)
        maxwell = sub(
            scale(norm_squared, eye(4)),
            longitudinal,
        )

        differential = zeros(10, 10)
        for row in range(4):
            differential[1 + row][0] = k[row]
            differential[9][5 + row] = k[row]
            for column in range(4):
                differential[5 + row][1 + column] = maxwell[row][
                    column
                ]

        # The transverse principal projector is order zero. It gives a
        # square-zero symbol-level gauge-fixing map even though it is not a
        # local differential operator in position space.
        transverse = scale(Fraction(1, norm_squared), maxwell)
        gauge_fixing = zeros(10, 10)
        for column in range(4):
            gauge_fixing[0][1 + column] = k[column]
            gauge_fixing[5 + column][9] = k[column]
            for row in range(4):
                gauge_fixing[1 + row][5 + column] = transverse[row][
                    column
                ]

        commutator = add(
            mul(differential, gauge_fixing),
            mul(gauge_fixing, differential),
        )
        naive_adjoint_hodge = add(
            mul(differential, transpose(differential)),
            mul(transpose(differential), differential),
        )
        expected = scale(norm_squared, eye(10))
        checks = {
            "detour_differential_squares_to_zero": (
                mul(differential, differential) == zeros(10, 10)
            ),
            "transverse_projector_is_idempotent": (
                mul(transverse, transverse) == transverse
