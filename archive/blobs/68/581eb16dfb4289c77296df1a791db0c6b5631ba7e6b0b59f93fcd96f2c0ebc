            "precision_bits": args.precision,
            "root_isolation_bits": args.root_bits,
            "evaluated_embedding_index": EMBEDDING_INDEX,
            "evaluated_gamma_ball": str(gamma),
            "conjugate_embedding_index": CONJUGATE_INDEX,
            "conjugate_gamma_ball": str(roots[CONJUGATE_INDEX]),
        },
        "selected_action": {
            "DM_component": CORE_COMPONENT,
            "core_dimension": CORE_DIMENSION,
            "exact_core_nonzero_entries": core_nonzeros,
            "selected_minor_columns_total": int(minor_columns.size),
            "selected_minor_columns_supported_on_core221": int(
                selected_kernel_columns.size
            ),
            "right_hand_side_support_entries": len(rhs_support),
            "solution_shape": [CORE_DIMENSION, SELECTED_CORE_COLUMNS],
            "solution_accuracy": solution_accuracy,
            "residual_entries_containing_zero": residual_zero,
            "persisted_enclosure": persisted,
            "samples": samples,
        },
        "timing_seconds": {
            "input_and_exact_core_construction": construction_seconds,
            "certified_Arb_solve": solve_seconds,
            "residual_replay": residual_seconds,
            "portable_enclosure_serialization": enclosure_seconds,
            "total": time.perf_counter() - started,
        },
        "checks": checks,
        "guardrails": {
            "claims_the_downstream684_core_or_scalar_DAG_is_executed": False,
            "claims_the_full_Q_or_selected710_minor_is_materialized": False,
            "claims_the_two_real_or_other_complex_embeddings_are_executed": False,
            "claims_an_Archimedean_embedding_is_physically_selected": False,
            "claims_x0_path_integration_integral_marking_or_beta_C": False,
        },
        "theorem": {
            "name": "ustG3czSelectedH11Core221ArchimedeanAction",
            "tier": "CLOSED_CERTIFIED_SELECTED_LARGEST_CORE_ACTION_ON_A_CONJUGATE_PAIR",
            "statement": "On canonical embedding 4 of the selected sextic field, the exact B89 H11 component 221 acts invertibly on all 499 selected G3CY minor columns supported on that component. Arb returns a finite 1710-by-499 complex-ball solution whose 853290 residual entries all contain zero. A portable widened double-double enclosure contains every certified solution entry. Since all matrix and source coefficients are rational polynomials in gamma, complex conjugation certifies the corresponding action on canonical embedding 5 without another numerical solve.",
        },
        "frontier_delta": {
            "before": "G3CY selected the exact rank-710 second Woodbury coordinates, but no selected characteristic-zero action of the largest 1710-dimensional H11 DM core had been evaluated.",
            "after": "The largest core action is now rigorously evaluated and persisted for all 499 selected columns that enter it on one conjugate Archimedean pair. The remaining work on that pair is downstream propagation through 279 scalar components and the 684 core, followed by assembly of the selected 710-square coupling.",
        },
        "next_required_object": "Load the persisted core221 enclosure, propagate the selected columns through the exact 279-singleton/684-core corridor, contract with the selected W rows, and emit the certified 710-square T_Q action on embeddings 4 and 5.",
    }
    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3CZ H11 core221 Archimedean action: PASS")
    print(
        f"embedding_pair={EMBEDDING_INDEX},{CONJUGATE_INDEX} "
        f"shape={CORE_DIMENSION}x{SELECTED_CORE_COLUMNS} "
        f"residual_zero={residual_zero} archive={enclosure_path.name}",
        flush=True,
