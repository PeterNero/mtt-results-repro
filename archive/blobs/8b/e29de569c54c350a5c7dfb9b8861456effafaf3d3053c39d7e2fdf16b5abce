ROOT = Path(__file__).resolve().parent
EVIDENCE = ROOT / "evidence" / "ust_g3dc"
OUT = ROOT / "state" / "ust_g3dc_h11_archimedean_affine_source_action.packet.json"

G3BI = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
G3BK = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"
G3CV = ROOT / "state" / "ust_g3cv_h11_fraction_free_path_woodbury.packet.json"

FIELD_DEGREE = 6
H11_DIMENSION = 4426
H20_DIMENSION = 248
SOURCE_DIMENSION = 2 * H20_DIMENSION
COMPONENT_221 = 221
COMPONENT_449 = 449
EMBEDDING_INDEX = 4
CONJUGATE_INDEX = 5


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    resolved = path.resolve()
    return {
        "repository": repository.name,
        "repository_relative_path": resolved.relative_to(repository.resolve()).as_posix(),
        "sha256": sha256(resolved),
        "bytes": resolved.stat().st_size,
    }


def isolated_roots(root_bits: int, maxprec: int) -> list[acb]:
    polynomial = acb_poly([64, 16, 33, 44, 89, 24, 1])
    roots = polynomial.roots(tol=arb(2) ** (-root_bits), maxprec=maxprec)
    require(len(roots) == FIELD_DEGREE, "six isolated roots")
    roots = sorted(roots, key=lambda value: (float(value.real.mid()), float(value.imag.mid())))
    require(
        all(
            not roots[left].overlaps(roots[right])
            for left in range(FIELD_DEGREE)
            for right in range(left + 1, FIELD_DEGREE)
        ),
        "pairwise disjoint roots",
    )
    require(all(polynomial(root).contains(0) for root in roots), "root residuals")
    require(
        roots[CONJUGATE_INDEX].overlaps(roots[EMBEDDING_INDEX].conjugate()),
        "embedding4/5 conjugate pair",
    )
    return roots


def sparse_coefficients(
    coefficient_rows: list[list[int]],
    coefficient_columns: list[list[int]],
    coefficient_data: list[list[int]],
    shape: tuple[int, int],
) -> list[sparse.csr_matrix]:
    result: list[sparse.csr_matrix] = []
    for power in range(FIELD_DEGREE):
        matrix = sparse.csr_matrix(
            (
                np.asarray(coefficient_data[power], dtype=np.int64),
                (
                    np.asarray(coefficient_rows[power], dtype=np.int32),
                    np.asarray(coefficient_columns[power], dtype=np.int32),
                ),
            ),
            shape=shape,
        )
        matrix.sum_duplicates()
        matrix.eliminate_zeros()
        result.append(matrix)
    return result


def union_pattern(matrices: list[sparse.csr_matrix]) -> sparse.csr_matrix:
    pattern = matrices[0].copy().astype(np.uint8)
    pattern.data[:] = 1
    for matrix in matrices[1:]:
        term = matrix.copy().astype(np.uint8)
        term.data[:] = 1
        pattern = pattern.maximum(term)
    pattern.sum_duplicates()
    pattern.data[:] = 1
    return pattern.tocsr()


def evaluate_submatrix(
    coefficients: list[sparse.csr_matrix],
    rows: np.ndarray,
    columns: np.ndarray,
    powers: list[acb],
) -> tuple[acb_mat, int]:
    result = acb_mat(len(rows), len(columns))
    support: set[tuple[int, int]] = set()
    for power, matrix in enumerate(coefficients):
        block = matrix[rows, :][:, columns].tocoo()
        for row, column, coefficient in zip(
            block.row.tolist(),
            block.col.tolist(),
            block.data.tolist(),
            strict=True,
        ):
            result[row, column] = result[row, column] + int(coefficient) * powers[power]
            support.add((int(row), int(column)))
    return result, len(support)


def evaluate_source_rows(
    base_coefficients: list[sparse.csr_matrix],
    correction_coefficients: list[sparse.csr_matrix],
    rows: np.ndarray,
    selected_sources: list[int],
    powers: list[acb],
) -> acb_mat:
    result = acb_mat(len(rows), len(selected_sources))
    selected_lookup = {source: position for position, source in enumerate(selected_sources)}
    for offset, coefficients in (
        (0, base_coefficients),
        (H20_DIMENSION, correction_coefficients),
    ):
        actual = [source - offset for source in selected_sources if offset <= source < offset + H20_DIMENSION]
        if not actual:
            continue
        output_positions = [selected_lookup[offset + source] for source in actual]
        actual_array = np.asarray(actual, dtype=np.int32)
        for power, matrix in enumerate(coefficients):
            block = matrix[rows, :][:, actual_array].tocoo()
            for row, local_column, coefficient in zip(
                block.row.tolist(),
                block.col.tolist(),
                block.data.tolist(),
                strict=True,
            ):
                output = output_positions[int(local_column)]
                result[row, output] = result[row, output] + int(coefficient) * powers[power]
    return result


def widened_double_double(value: arb) -> tuple[float, float, float, arb]:
    midpoint = value.mid()
    high = float(midpoint)
    low = float((midpoint - arb(high)).mid())
    center = arb(high) + arb(low)
    radius_bound = abs(midpoint - center) + value.rad()
    radius = math.nextafter(float(radius_bound), math.inf)
    enclosure = center + arb(0, radius)
    while not enclosure.contains(value):
        radius = math.nextafter(radius, math.inf)
        enclosure = center + arb(0, radius)
    return high, low, radius, enclosure


def persist_source_range(
    path: Path,
    solution: acb_mat,
    source_start: int,
    source_stop: int,
    coordinate_columns: np.ndarray,
) -> dict[str, Any]:
    rows = solution.nrows()
    columns = source_stop - source_start
    shape = (rows, columns)
    real_high = np.empty(shape, dtype=np.float64)
    real_low = np.empty(shape, dtype=np.float64)
    real_radius = np.empty(shape, dtype=np.float64)
    imag_high = np.empty(shape, dtype=np.float64)
    imag_low = np.empty(shape, dtype=np.float64)
    imag_radius = np.empty(shape, dtype=np.float64)
    contained = 0
    minimum_accuracy: int | None = None
    zero_containing = 0
    for row in range(rows):
        for local_column, source in enumerate(range(source_start, source_stop)):
            value = solution[row, source]
            rh, rl, rr, real_enclosure = widened_double_double(value.real)
            ih, il, ir, imag_enclosure = widened_double_double(value.imag)
            real_high[row, local_column] = rh
            real_low[row, local_column] = rl
            real_radius[row, local_column] = rr
            imag_high[row, local_column] = ih
            imag_low[row, local_column] = il
            imag_radius[row, local_column] = ir
            enclosure = acb(real_enclosure, imag_enclosure)
            if enclosure.real.contains(value.real) and enclosure.imag.contains(value.imag):
                contained += 1
            if enclosure.contains(0):
                zero_containing += 1
            else:
                accuracy = int(enclosure.rel_accuracy_bits())
                minimum_accuracy = accuracy if minimum_accuracy is None else min(minimum_accuracy, accuracy)
    require(contained == rows * columns, "portable source enclosure containment")
    np.savez_compressed(
        path,
        image_coordinate_columns=coordinate_columns.astype(np.int32),
        source_columns=np.arange(columns, dtype=np.int32),
        real_high=real_high,
        real_low=real_low,
        real_radius=real_radius,
        imag_high=imag_high,
        imag_low=imag_low,
        imag_radius=imag_radius,
    )
    return {
        "shape": list(shape),
        "contained_solution_entries": contained,
        "entries_containing_zero": zero_containing,
        "minimum_relative_accuracy_bits_away_from_zero": minimum_accuracy or 0,
        "archive": record(path),
        "format": "real/imag double-double centers plus outward float64 radii",
    }


def bit_indices(mask: int) -> list[int]:
    result: list[int] = []
    while mask:
        least = mask & -mask
        result.append(least.bit_length() - 1)
        mask ^= least
    return result


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--precision", type=int, default=384)
    parser.add_argument("--root-bits", type=int, default=320)
    parser.add_argument("--maxprec", type=int, default=2048)
    args = parser.parse_args()
    require(args.precision >= 256, "minimum precision")
    require(args.root_bits >= 224, "minimum root isolation")
    require(args.maxprec >= args.precision, "root maximum precision")
    ctx.prec = args.precision

    started = time.perf_counter()
    g3bi = load(G3BI)
    g3bk = load(G3BK)
    g3cv = load(G3CV)
    for packet, label in ((g3bi, "G3BI"), (g3bk, "G3BK"), (g3cv, "G3CV")):
        require(all(packet["checks"].values()), f"{label} checks")

    mld = runtime.resolve_mld()
    sys.path.insert(0, str(mld))
    import build_q79_eta9_characteristic_zero_H20_to_H11_source_oracle as source_oracle
    import build_q79_eta9_characteristic_zero_three_block_chart_oracle as oracle
    import build_q79_eta9_family_macaulay_update as family_update
    import export_q79_eta9_split_prime_selected_chart as exporter

    dm_path = mld / "q79_eta9_H11_Dulmage_Mendelsohn_decomposition.packet.json"
    macaulay_path = mld / "q79_eta9_original_jacobian_macaulay_H11.packet.json"
    factor_path = mld / "q79_eta9_original_jacobian_coordinate_factorization_H11.packet.json"
    b103_path = mld / "q79_eta9_full_vanishing_residue_basis.packet.json"
    source_oracle_path = mld / "q79_eta9_characteristic_zero_H20_to_H11_source_oracle.packet.json"
    dm = load(dm_path)
    macaulay = load(macaulay_path)
    factor = load(factor_path)
    b103 = load(b103_path)
    b89_source_packet = load(source_oracle_path)
    base = load(oracle.BASE)
    global_f0 = load(oracle.GLOBAL_F0)
    b89 = load(oracle.B89)
    for packet, label in (
        (dm, "DM"),
        (macaulay, "Macaulay"),
        (factor, "factor"),
        (b103, "B103"),
        (b89_source_packet, "B89 source oracle"),
        (base, "base"),
        (global_f0, "global F0"),
        (b89, "B89"),
    ):
        require(all(packet["checks"].values()), f"{label} checks")

    dm_arrays_path = mld / dm["Dulmage_Mendelsohn"]["arrays"]["path"]
    dm_arrays = np.load(dm_arrays_path, allow_pickle=False)
    complement_rows = dm_arrays["complement_ambient_rows"].astype(np.int32)
    component_by_row = dm_arrays["component_by_complement_row"].astype(np.int32)
    component_by_column = dm_arrays["component_by_image_column"].astype(np.int32)
    component_sizes = dm_arrays["component_sizes"].astype(np.int32)
    component_order = dm_arrays["topological_component_order"].astype(np.int32)
    component_count = int(component_sizes.size)
    require(complement_rows.size == H11_DIMENSION, "H11 complement dimension")
    require(component_count == 1813, "H11 DM component count")
    order_position = np.empty(component_count, dtype=np.int32)
    order_position[component_order] = np.arange(component_count, dtype=np.int32)
    component_rows = [np.flatnonzero(component_by_row == component).astype(np.int32) for component in range(component_count)]
    component_columns = [np.flatnonzero(component_by_column == component).astype(np.int32) for component in range(component_count)]
    require(
        all(len(component_rows[index]) == len(component_columns[index]) == int(component_sizes[index]) for index in range(component_count)),
        "square DM components",
    )

    target = [
        tuple(int(value) for value in exponent)
        for exponent in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {exponent: index for index, exponent in enumerate(target)}
    complement_lookup = {
        int(ambient_row): local_row for local_row, ambient_row in enumerate(complement_rows.tolist())
    }

    exact_started = time.perf_counter()
    generators0, _, _ = oracle.exact_generators(base, global_f0, b89)
    original_columns = [
        int(value)
        for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]
    ]
    descriptors = family_update.selected_column_data(macaulay, original_columns)
    a_rows = [[] for _ in range(FIELD_DEGREE)]
    a_columns = [[] for _ in range(FIELD_DEGREE)]
    a_data = [[] for _ in range(FIELD_DEGREE)]
    for column, descriptor in enumerate(descriptors):
        exact_column = oracle.exact_column(descriptor, generators0, target_lookup)
        for ambient_row, coefficients in exact_column.items():
            row = complement_lookup.get(int(ambient_row))
            if row is None:
                continue
            for power, coefficient in enumerate(coefficients):
                if coefficient:
                    a_rows[power].append(row)
                    a_columns[power].append(column)
                    a_data[power].append(int(coefficient))
    a_coefficients = sparse_coefficients(a_rows, a_columns, a_data, (H11_DIMENSION, H11_DIMENSION))
    a_pattern = union_pattern(a_coefficients)

    b89_columns = exporter.exact_H20_to_H11_source_columns(
        b103, b89, target_lookup, list(range(H20_DIMENSION))
    )
    require(
        source_oracle.canonical_hash(b89_columns)
        == b89_source_packet["source_theorem"]["canonical_exact_source_SHA256"],
        "B89 source digest",
    )
    b0_rows = [[] for _ in range(FIELD_DEGREE)]
    b0_columns = [[] for _ in range(FIELD_DEGREE)]
    b0_data = [[] for _ in range(FIELD_DEGREE)]
    for column, source in enumerate(b89_columns):
        for ambient_row, coefficients in source.items():
            row = complement_lookup.get(int(ambient_row))
            if row is None:
                continue
            for power, coefficient in enumerate(coefficients):
                if coefficient:
                    b0_rows[power].append(row)
                    b0_columns[power].append(column)
                    b0_data[power].append(int(coefficient))
    b0_coefficients = sparse_coefficients(b0_rows, b0_columns, b0_data, (H11_DIMENSION, H20_DIMENSION))

    source_block = next(block for block in b103["basis_blocks"] if block["name"] == "H20")
    source_vectors = [tuple(int(value) for value in row) for row in source_block["basis_exponent_vectors"]]
    correction_terms = compiler.correction_terms(g3bi)
    correction_digest = hashlib.sha256()
    bc_rows = [[] for _ in range(FIELD_DEGREE)]
    bc_columns = [[] for _ in range(FIELD_DEGREE)]
    bc_data = [[] for _ in range(FIELD_DEGREE)]
    correction_ambient_nonzeros = 0
    for column, source in enumerate(source_vectors):
        rows_seen: set[int] = set()
        for term in correction_terms:
            product = tuple(a + b for a, b in zip(source, term["sF_exponent"], strict=True))
            ambient_row = target_lookup.get(product)
            require(ambient_row is not None and ambient_row not in rows_seen, "correction source coordinate")
            rows_seen.add(ambient_row)
            coefficients = [-3 * int(value) for value in term["coefficients"]]
            correction_digest.update(f"{column}:{ambient_row}:".encode("ascii"))
            correction_digest.update(",".join(str(value) for value in coefficients).encode("ascii"))
            correction_digest.update(b"\n")
            correction_ambient_nonzeros += 1
            row = complement_lookup.get(int(ambient_row))
            if row is None:
                continue
            for power, coefficient in enumerate(coefficients):
                if coefficient:
                    bc_rows[power].append(row)
                    bc_columns[power].append(column)
                    bc_data[power].append(coefficient)
    require(
        correction_digest.hexdigest()
        == g3bk["characteristic_zero_derivative_sources"]["H20_to_H11"]["canonical_exact_source_sha256"],
        "correction source digest",
    )
    require(correction_ambient_nonzeros == 4712, "correction ambient source entries")
    bc_coefficients = sparse_coefficients(bc_rows, bc_columns, bc_data, (H11_DIMENSION, H20_DIMENSION))
    exact_seconds = time.perf_counter() - exact_started

    pattern_rows, pattern_columns = a_pattern.nonzero()
    edge_sources = component_by_row[pattern_rows]
    edge_targets = component_by_column[pattern_columns]
    require(
        np.count_nonzero(order_position[edge_sources] > order_position[edge_targets]) == 0,
        "DM block upper-triangular pattern",
    )
    successors: list[set[int]] = [set() for _ in range(component_count)]
    for source, target_component in zip(edge_sources.tolist(), edge_targets.tolist(), strict=True):
        if source != target_component:
            successors[int(source)].add(int(target_component))

    source_masks = [0] * component_count
    for offset, coefficients in ((0, b0_coefficients), (H20_DIMENSION, bc_coefficients)):
        source_pattern = union_pattern(coefficients).tocoo()
        for row, column in zip(source_pattern.row.tolist(), source_pattern.col.tolist(), strict=True):
            component = int(component_by_row[int(row)])
            source_masks[component] |= 1 << (offset + int(column))
    for component in reversed(component_order.tolist()):
        for successor in successors[int(component)]:
            source_masks[int(component)] |= source_masks[successor]

    base_mask = (1 << H20_DIMENSION) - 1
    correction_mask = base_mask << H20_DIMENSION
    base_active_components = [component for component, mask in enumerate(source_masks) if mask & base_mask]
    correction_active_components = [component for component, mask in enumerate(source_masks) if mask & correction_mask]
    base_active_dimension = sum(int(component_sizes[component]) for component in base_active_components)
    correction_active_dimension = sum(int(component_sizes[component]) for component in correction_active_components)
    require(len(base_active_components) == 1482, "B89 source dependency components")
    require(base_active_dimension == 4095, "B89 source dependency dimension")
    print(
        f"G3DC exact compiler: A_support={a_pattern.nnz} B0_support={union_pattern(b0_coefficients).nnz} "
        f"BC_support={union_pattern(bc_coefficients).nnz} base_cone=1482/4095 "
        f"correction_cone={len(correction_active_components)}/{correction_active_dimension} "
        f"seconds={exact_seconds:.3f}",
        flush=True,
    )

    roots = isolated_roots(args.root_bits, args.maxprec)
    gamma = roots[EMBEDDING_INDEX]
    powers = [acb(1)]
    for _ in range(FIELD_DEGREE - 1):
        powers.append(powers[-1] * gamma)

    solution = acb_mat(H11_DIMENSION, SOURCE_DIMENSION)
    active_residuals = 0
    minimum_accuracy: int | None = None
    solved_components = 0
    solve_started = time.perf_counter()
    core_records: list[dict[str, Any]] = []
    for reverse_position, component_value in enumerate(reversed(component_order.tolist())):
        component = int(component_value)
        mask = source_masks[component]
        if mask == 0:
            continue
        rows = component_rows[component]
        columns = component_columns[component]
        selected_sources = bit_indices(mask)
        direct = evaluate_source_rows(
            b0_coefficients,
            bc_coefficients,
            rows,
            selected_sources,
            powers,
        )
        row_pattern = a_pattern[rows, :]
        candidate_columns = np.unique(row_pattern.nonzero()[1]).astype(np.int32)
        off_columns = np.asarray(
            [
                int(column)
                for column in candidate_columns.tolist()
                if int(component_by_column[int(column)]) != component
                and source_masks[int(component_by_column[int(column)])] & mask
            ],
            dtype=np.int32,
        )
        if off_columns.size:
            off_matrix, _ = evaluate_submatrix(a_coefficients, rows, off_columns, powers)
            downstream = acb_mat(
                int(off_columns.size),
                len(selected_sources),
                [solution[int(column), source] for column in off_columns.tolist() for source in selected_sources],
            )
            rhs = direct - off_matrix * downstream
        else:
            rhs = direct
        diagonal, diagonal_support = evaluate_submatrix(a_coefficients, rows, columns, powers)
        require(diagonal_support >= len(rows), "diagonal component support")
        if len(rows) == 1:
            divisor = diagonal[0, 0]
            require(not divisor.contains(0), f"component {component} singleton divisor")
            local_solution = acb_mat(1, len(selected_sources))
            for source_position in range(len(selected_sources)):
                local_solution[0, source_position] = rhs[0, source_position] / divisor
        else:
            local_solution = diagonal.solve(rhs, algorithm="precond")
        residual = diagonal * local_solution - rhs
        residual_entries = residual.entries()
        require(all(value.contains(0) for value in residual_entries), f"component {component} residuals")
        active_residuals += len(residual_entries)
        entries = local_solution.entries()
        require(all(value.is_finite() for value in entries), f"component {component} finite solution")
        for value in entries:
            if not value.contains(0):
                accuracy = int(value.rel_accuracy_bits())
                minimum_accuracy = accuracy if minimum_accuracy is None else min(minimum_accuracy, accuracy)
        for local_row, global_column in enumerate(columns.tolist()):
            for source_position, source in enumerate(selected_sources):
                solution[int(global_column), source] = local_solution[local_row, source_position]
        solved_components += 1
        if component in (COMPONENT_221, COMPONENT_449) or solved_components % 300 == 0:
            elapsed = time.perf_counter() - solve_started
            print(
                f"G3DC solve: component={component} size={len(rows)} sources={len(selected_sources)} "
                f"solved_components={solved_components} active_residuals={active_residuals} "
                f"min_accuracy={minimum_accuracy} seconds={elapsed:.3f}",
                flush=True,
            )
        if component in (COMPONENT_221, COMPONENT_449):
            core_records.append(
                {
                    "component": component,
                    "size": len(rows),
                    "source_columns": len(selected_sources),
                    "base_source_columns": sum(source < H20_DIMENSION for source in selected_sources),
                    "correction_source_columns": sum(source >= H20_DIMENSION for source in selected_sources),
                    "residual_entries_containing_zero": len(residual_entries),
                }
            )
    solve_seconds = time.perf_counter() - solve_started
    require(solved_components == len([mask for mask in source_masks if mask]), "all active components solved")
    structural_zero_residuals = H11_DIMENSION * SOURCE_DIMENSION - active_residuals
    require(structural_zero_residuals >= 0, "structural residual count")
    require((minimum_accuracy or 0) >= 96, "source action accuracy")

    EVIDENCE.mkdir(parents=True, exist_ok=True)
    persist_started = time.perf_counter()
    base_archive = EVIDENCE / "H11.A0_inverse_B89.embedding4.p384.ddball.npz"
    correction_archive = EVIDENCE / "H11.A0_inverse_BC.embedding4.p384.ddball.npz"
    coordinate_columns = np.arange(H11_DIMENSION, dtype=np.int32)
    base_persisted = persist_source_range(
        base_archive, solution, 0, H20_DIMENSION, coordinate_columns
    )
    correction_persisted = persist_source_range(
        correction_archive,
        solution,
        H20_DIMENSION,
        SOURCE_DIMENSION,
        coordinate_columns,
    )
    persist_seconds = time.perf_counter() - persist_started
    require(
        base_persisted["minimum_relative_accuracy_bits_away_from_zero"] >= 80,
