import build_ust_g3bn_h11_alternate_split_prime_initializer as initializer
import build_ust_g3cv_h11_fraction_free_path_woodbury as woodbury
import probe_ust_g3bl_endpoint_chart_unit as runtime


ROOT = Path(__file__).resolve().parent
G3CU = ROOT / "state" / "ust_g3cu_h11_exact_path_update_rank.packet.json"
G3CV = ROOT / "state" / "ust_g3cv_h11_fraction_free_path_woodbury.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3cw"
OUT = ROOT / "state" / "ust_g3cw_h11_split_place_base_action.packet.json"
PRIME = 21817
ROOTS = (5, 1971, 6912, 10062, 10605, 14055)
AMBIENT = 5439
QUOTIENT = 1013
COMPLEMENT = 4426
