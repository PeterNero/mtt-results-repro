ROOT = Path(__file__).resolve().parent
G3BI = ROOT / "state" / "ust_g3bi_explicit_root_start.packet.json"
G3BJ = ROOT / "state" / "ust_g3bj_transcendental_arc_path.packet.json"
EVIDENCE = ROOT / "evidence" / "ust_g3bk"
OUT = ROOT / "state" / "ust_g3bk_correction_pencil_operator.packet.json"

VARIABLES = ("x", "y", "z", "w", "t0", "t1", "t2", "u", "v", "s")
TARGETS = ("H20", "H11", "H02")
PRIME = 11
GAMMA_RESIDUE = 3
MINPOLY = [64, 16, 33, 44, 89, 24, 1]


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def local_record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def upstream_record(path: Path) -> dict[str, Any]:
    packet = load(path)
    return {
        "repository": "20 Mathematical Language Discovery Program",
        "path": path.name,
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
        "schema": packet.get("schema", "UNSCHEMATIZED"),
        "status": packet.get("status", "NO_STATUS"),
    }


def resolve_mld() -> Path:
    candidates = []
    configured = os.environ.get("MTT_MLD_REPO")
    if configured:
        candidates.append(Path(configured))
    candidates.extend(
        [
            ROOT.parent / "20 Mathematical Language Discovery Program",
            ROOT.parent / "Mathematical Language Discovery Program",
        ]
    )
    for candidate in candidates:
        if (candidate / "q79_eta9_full_vanishing_residue_basis.packet.json").is_file():
            return candidate.resolve()
    raise FileNotFoundError(
        "Set MTT_MLD_REPO to the Mathematical Language Discovery Program repository"
    )


def evaluate_mod11(coefficients: list[int]) -> int:
    return sum(
        (int(value) % PRIME) * pow(GAMMA_RESIDUE, power, PRIME)
        for power, value in enumerate(coefficients)
    ) % PRIME


def weighted_base_monomials(h_degree: int, l_degree: int):
    if h_degree < 0 or l_degree < 0:
        return
    for w_exponent in range(h_degree // 3 + 1):
        xyz_degree = h_degree - 3 * w_exponent
        for x_exponent in range(xyz_degree + 1):
            for y_exponent in range(xyz_degree - x_exponent + 1):
                z_exponent = xyz_degree - x_exponent - y_exponent
                for t0_exponent in range(l_degree + 1):
                    for t1_exponent in range(l_degree - t0_exponent + 1):
                        t2_exponent = l_degree - t0_exponent - t1_exponent
                        yield (
                            x_exponent,
                            y_exponent,
                            z_exponent,
                            w_exponent,
                            t0_exponent,
                            t1_exponent,
                            t2_exponent,
                        )


def monomials_of_cox_degree(degree: tuple[int, int, int]) -> list[tuple[int, ...]]:
    h_target, l_target, xi_target = degree
    if xi_target < 0:
        return []
    result = []
    for u_exponent in range(xi_target + 1):
        for v_exponent in range(xi_target - u_exponent + 1):
            s_exponent = xi_target - u_exponent - v_exponent
            h_degree = h_target + 6 * u_exponent + 9 * s_exponent
            l_degree = l_target + 3 * v_exponent + s_exponent
            for base in weighted_base_monomials(h_degree, l_degree):
                result.append(base + (u_exponent, v_exponent, s_exponent))
    require(len(result) == len(set(result)), "unique Cox monomials")
    return result


def correction_terms(g3bi: dict[str, Any]) -> list[dict[str, Any]]:
    result = []
    for row in g3bi["exact_construction"]["right_inverse_rows"]:
        xyz = tuple(int(value) for value in row["source_monomial"])
        coefficients = [int(value) for value in row["correction_gamma_coordinates"]]
        require(len(coefficients) == 6 and any(coefficients), "nonzero Q(gamma) row")
        # C is the t0 coefficient of F; s*C is the Cayley-family deformation.
        f_exponent = xyz + (0, 1, 0, 0, 0, 0, 0)
        cayley_exponent = xyz + (0, 1, 0, 0, 0, 0, 1)
        result.append(
            {
                "t_power": int(row["t_power"]),
                "F_exponent": f_exponent,
                "sF_exponent": cayley_exponent,
                "coefficients": coefficients,
                "mod11": evaluate_mod11(coefficients),
            }
        )
    require(len(result) == 19, "19 correction terms")
    require(len({row["F_exponent"] for row in result}) == 19, "unique F terms")
    require(len({row["sF_exponent"] for row in result}) == 19, "unique sF terms")
    return result


def derivative_generators(
    terms: list[dict[str, Any]],
) -> list[list[tuple[int, tuple[int, ...]]]]:
    result: list[list[tuple[int, tuple[int, ...]]]] = []
    for variable in range(len(VARIABLES)):
        derivative: dict[tuple[int, ...], int] = {}
        for row in terms:
            coefficient = int(row["mod11"])
            exponent = tuple(int(value) for value in row["sF_exponent"])
            power = exponent[variable]
            if coefficient == 0 or power == 0:
                continue
            reduced = list(exponent)
            reduced[variable] -= 1
            key = tuple(reduced)
            derivative[key] = (derivative.get(key, 0) + coefficient * power) % PRIME
        result.append(
            [(value, exponent) for exponent, value in sorted(derivative.items()) if value]
        )
    return result


def locate_column(blocks: list[dict[str, Any]], column: int) -> tuple[int, int]:
    for generator, block in enumerate(blocks):
        first = int(block["first_column"])
        stop = int(block["past_last_column"])
        if first <= column < stop:
            return generator, column - first
    raise AssertionError(f"column {column} outside all Macaulay blocks")


def selected_column_descriptors(
    macaulay: dict[str, Any], factor: dict[str, Any]
) -> list[tuple[int, tuple[int, ...]]]:
    blocks = macaulay["column_blocks"]
    multiplier_cache = [
        monomials_of_cox_degree(tuple(int(value) for value in block["coefficient_Cox_degree"]))
        for block in blocks
    ]
    result = []
    for value in factor["exact_coordinate_identity"]["selected_original_Jacobian_columns"]:
        generator, local = locate_column(blocks, int(value))
        require(local < len(multiplier_cache[generator]), "selected multiplier index")
        result.append((generator, multiplier_cache[generator][local]))
    return result


def build_update(
    macaulay: dict[str, Any], factor: dict[str, Any], derivatives
) -> sparse.csc_matrix:
    target = [
        tuple(int(value) for value in row)
        for row in macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {row: index for index, row in enumerate(target)}
    require(len(target_lookup) == len(target), "unique ambient target basis")
    descriptors = selected_column_descriptors(macaulay, factor)
    rows: list[int] = []
    columns: list[int] = []
    data: list[int] = []
    for selected_index, (generator, multiplier) in enumerate(descriptors):
        entries: dict[int, int] = {}
        for coefficient, exponent in derivatives[generator]:
            product = tuple(a + b for a, b in zip(multiplier, exponent))
            target_row = target_lookup.get(product)
            require(target_row is not None, "correction update term in ambient basis")
            entries[target_row] = (entries.get(target_row, 0) + coefficient) % PRIME
        for target_row, coefficient in sorted(entries.items()):
            if coefficient:
                rows.append(target_row)
                columns.append(selected_index)
                data.append(coefficient)
    matrix = sparse.csc_matrix(
        (
            np.asarray(data, dtype=np.uint8),
            (np.asarray(rows, dtype=np.int32), np.asarray(columns, dtype=np.int32)),
        ),
        shape=(len(target), len(descriptors)),
        dtype=np.uint8,
    )
    matrix.sum_duplicates()
    matrix.data %= PRIME
    matrix.eliminate_zeros()
    return matrix


def minimum_vertex_cover(
    matrix: sparse.csr_matrix, row_match: np.ndarray
) -> tuple[np.ndarray, np.ndarray]:
    rows, columns = matrix.shape
    column_match = np.full(columns, -1, dtype=np.int32)
    matched_rows = np.flatnonzero(row_match >= 0)
    column_match[row_match[matched_rows]] = matched_rows
    visited_rows = np.zeros(rows, dtype=np.bool_)
    visited_columns = np.zeros(columns, dtype=np.bool_)
    queue: deque[int] = deque(int(row) for row in np.flatnonzero(row_match < 0))
    visited_rows[row_match < 0] = True
    while queue:
        row = queue.popleft()
        first, stop = int(matrix.indptr[row]), int(matrix.indptr[row + 1])
        for column_value in matrix.indices[first:stop]:
            column = int(column_value)
            if row_match[row] == column or visited_columns[column]:
                continue
            visited_columns[column] = True
            matched_row = int(column_match[column])
            if matched_row >= 0 and not visited_rows[matched_row]:
                visited_rows[matched_row] = True
                queue.append(matched_row)
    return ~visited_rows, visited_columns


def structural_certificate(matrix: sparse.csc_matrix) -> tuple[dict[str, Any], dict[str, np.ndarray]]:
    support = matrix.copy().tocsc()
    support.data[:] = 1
    support.eliminate_zeros()
    csr = support.tocsr()
    row_match = maximum_bipartite_matching(csr, perm_type="column").astype(np.int32)
    matched_rows = np.flatnonzero(row_match >= 0)
    row_cover, column_cover = minimum_vertex_cover(csr, row_match)
    coo = support.tocoo()
    require(
        bool(np.all(row_cover[coo.row] | column_cover[coo.col])),
        "minimum vertex cover contains every edge",
    )
    matching_size = int(matched_rows.size)
    cover_size = int(row_cover.sum() + column_cover.sum())
    require(matching_size == cover_size, "Konig matching-cover equality")
    graph_rows = np.concatenate([coo.row, support.shape[0] + coo.col])
    graph_columns = np.concatenate([support.shape[0] + coo.col, coo.row])
    graph = sparse.csr_matrix(
        (np.ones(graph_rows.size, dtype=np.uint8), (graph_rows, graph_columns)),
        shape=(support.shape[0] + support.shape[1],) * 2,
    )
    component_count, labels = connected_components(graph, directed=False, return_labels=True)
    active_labels = np.unique(labels[coo.row]) if coo.nnz else np.asarray([], dtype=np.int32)
    summary = {
        "shape": list(support.shape),
        "nonzero_entries": int(support.nnz),
        "nonzero_rows": int(np.count_nonzero(np.diff(csr.indptr))),
        "nonzero_columns": int(np.count_nonzero(np.diff(support.indptr))),
        "maximum_matching_size": matching_size,
        "minimum_vertex_cover_size": cover_size,
        "structural_rank_upper_bound": matching_size,
        "connected_components_including_isolated_vertices": int(component_count),
        "active_connected_components": int(active_labels.size),
    }
    arrays = {
        "row_match": row_match,
        "minimum_vertex_cover_rows": np.flatnonzero(row_cover).astype(np.int32),
        "minimum_vertex_cover_columns": np.flatnonzero(column_cover).astype(np.int32),
        "bipartite_component_labels": labels.astype(np.int32),
    }
    return summary, arrays


def dense_rank_mod_prime(matrix: np.ndarray, prime: int = PRIME) -> int:
    work = np.asarray(matrix, dtype=np.int64) % prime
    rows, columns = work.shape
    rank = 0
    for column in range(columns):
        candidates = np.flatnonzero(work[rank:, column])
        if candidates.size == 0:
            continue
        pivot = rank + int(candidates[0])
        if pivot != rank:
            work[[rank, pivot]] = work[[pivot, rank]]
        work[rank] = work[rank] * pow(int(work[rank, column]), -1, prime) % prime
        if rank + 1 < rows:
            factors = work[rank + 1 :, column].copy()
            active = np.flatnonzero(factors)
            if active.size:
                target_rows = rank + 1 + active
                work[target_rows] = (
                    work[target_rows] - factors[active, None] * work[rank]
                ) % prime
        rank += 1
        if rank == rows:
            break
    return rank


def componentwise_rank_mod_prime(
    matrix: sparse.csc_matrix, component_labels: np.ndarray
) -> tuple[int, list[dict[str, int]]]:
    coo = matrix.tocoo()
    row_count = matrix.shape[0]
    active_labels = np.unique(component_labels[coo.row])
    total = 0
    components = []
    for label_value in active_labels:
        label = int(label_value)
        rows = np.flatnonzero(component_labels[:row_count] == label)
        columns = np.flatnonzero(component_labels[row_count:] == label)
        rank = dense_rank_mod_prime(matrix[rows][:, columns].toarray())
        total += rank
        components.append(
            {
                "component_label": label,
                "rows": int(rows.size),
                "columns": int(columns.size),
                "rank_mod11": rank,
            }
        )
    return total, components


def canonical_source_block(
    source_block: dict[str, Any],
    target_macaulay: dict[str, Any],
    terms: list[dict[str, Any]],
    pole_order: int,
) -> dict[str, Any]:
    source = [tuple(int(value) for value in row) for row in source_block["basis_exponent_vectors"]]
    target = [
        tuple(int(value) for value in row)
        for row in target_macaulay["target_monomial_basis"]["exponent_vectors"]
    ]
    target_lookup = {row: index for index, row in enumerate(target)}
    exact_digest = hashlib.sha256()
    reduced_digest = hashlib.sha256()
    exact_nonzeros = 0
    reduced_nonzeros = 0
    sample: list[dict[str, Any]] = []
    for column, basis_exponent in enumerate(source):
        rows_seen = set()
        for term in terms:
            product = tuple(
                a + b for a, b in zip(basis_exponent, term["sF_exponent"])
            )
            row = target_lookup.get(product)
            require(row is not None, "source derivative term in target ambient basis")
            require(row not in rows_seen, "no within-column source collision")
            rows_seen.add(row)
            coefficients = [-pole_order * int(value) for value in term["coefficients"]]
            require(any(coefficients), "nonzero exact source coefficient")
            exact_digest.update(f"{column}:{row}:".encode("ascii"))
            exact_digest.update(",".join(str(value) for value in coefficients).encode("ascii"))
            exact_digest.update(b"\n")
            exact_nonzeros += 1
            reduced = (-pole_order * int(term["mod11"])) % PRIME
            if reduced:
                reduced_digest.update(f"{column}:{row}:{reduced}\n".encode("ascii"))
                reduced_nonzeros += 1
            if len(sample) < 3:
                sample.append(
                    {
                        "column": column,
                        "ambient_row": row,
                        "coefficients_ascending": coefficients,
                        "mod11": reduced,
                    }
                )
    return {
        "source_dimension": len(source),
        "target_ambient_dimension": len(target),
        "source_pole_order": pole_order,
        "formula": f"R_P=-{pole_order}*P*s*C for every frozen B103 source monomial P",
        "exact_nonzero_entries_over_Q_gamma": exact_nonzeros,
        "good_reduction_nonzero_entries": reduced_nonzeros,
        "canonical_exact_source_sha256": exact_digest.hexdigest(),
        "canonical_good_reduction_source_sha256": reduced_digest.hexdigest(),
        "sample_entries": sample,
    }


