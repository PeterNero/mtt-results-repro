    def integer_factorial(value: int) -> int:
        result = 1
        for factor in range(2, value + 1):
            result *= factor
        return result

    def matrix_vector(
        matrix: list[list[Fraction]],
        vector: list[Fraction],
    ) -> list[Fraction]:
        return [
            sum(
                (
                    matrix[row][column] * vector[column]
                    for column in range(len(vector))
                ),
                Fraction(0),
            )
            for row in range(len(matrix))
        ]

    polynomial_dimension = 5
    half_laplacian = zeros(
        polynomial_dimension, polynomial_dimension
    )
    for degree in range(2, polynomial_dimension):
        half_laplacian[degree - 2][degree] = Fraction(
            degree * (degree - 1), 2
        )

    def normal_ordering_map(
        covariance_shift: Fraction,
    ) -> list[list[Fraction]]:
        output = eye(polynomial_dimension)
        power = eye(polynomial_dimension)
        for order in range(1, polynomial_dimension):
            power = mul(power, half_laplacian)
            output = add(
                output,
                scale(
                    covariance_shift**order
                    / integer_factorial(order),
                    power,
                ),
            )
        return output

    def polynomial_derivative(
        polynomial: list[Fraction],
        order: int,
    ) -> list[Fraction]:
        output = list(polynomial)
        for _ in range(order):
            output = [
                Fraction(degree + 1) * output[degree + 1]
                for degree in range(polynomial_dimension - 1)
            ] + [Fraction(0)]
        return output

    def polynomial_product(
        left: list[Fraction],
        right: list[Fraction],
    ) -> list[Fraction]:
        output = [Fraction(0)] * polynomial_dimension
        for left_degree, left_value in enumerate(left):
            for right_degree, right_value in enumerate(right):
                degree = left_degree + right_degree
                if degree < polynomial_dimension:
                    output[degree] += left_value * right_value
        return output

    def polynomial_star(
        left: list[Fraction],
        right: list[Fraction],
        covariance: Fraction,
    ) -> list[Fraction]:
        output = [Fraction(0)] * polynomial_dimension
        for order in range(polynomial_dimension):
            left_derivative = polynomial_derivative(left, order)
            right_derivative = polynomial_derivative(right, order)
            term = polynomial_product(
                left_derivative, right_derivative
            )
            coefficient = (
                covariance**order / integer_factorial(order)
            )
            output = [
                output[index] + coefficient * term[index]
                for index in range(polynomial_dimension)
            ]
        return output

