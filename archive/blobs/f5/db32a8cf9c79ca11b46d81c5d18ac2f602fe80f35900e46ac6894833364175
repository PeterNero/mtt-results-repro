    freshness = source_freshness()
    free_cstar = q79_sm_free_physical_cstar_reference_and_nonpromotion()
    formal_bridge = q79_lorentzian_spectral_sp_qme_cauchy_bridge()
    manifest = json.loads(
        (ROOT / "source_manifest.json").read_text(encoding="utf-8")
    )
    external_names = {
        row["name"] for row in manifest["external_theorems"]
    }

    source_checks = {
        "all_hash_pinned_sources_are_current": freshness["all_current"],
        "prior_free_physical_Cstar_certificate_passes": (
            free_cstar["all_checks_pass"]
