    for prime_index, (packet_path, packet) in enumerate(
        zip(conic.SPLIT_PACKETS, packets, strict=True)
    ):
        prime = int(packet["field"]["prime"])
        roots = tuple(int(value) for value in packet["field"]["roots"])
        root_rows = {int(row["gamma_root"]): row for row in packet["root_kernels"]}
        local_profiles: list[tuple[int, ...]] = []
        for root_index, gamma in enumerate(roots):
            generators, syzygy_block, _ = g3fe.extract_fiber(
                ROOT / root_rows[gamma]["kernel"]["path"], prime
            )
            d7 = evaluate_coordinates(
                g3fx["D7_gamma_coordinates"], gamma, prime
            )
            b6 = evaluate_coordinates(
                g3fx["B6_gamma_coordinates"], gamma, prime
            )
            forms9 = tuple(
                source_runtime.evaluate_selected_form(
                    coefficient_vectors, theta, gamma, prime
                )
                for theta in range(3)
            )
            canonical, source_coefficient, profile, source_profile = fiber_source(
                generators[11],
                syzygy_block,
                d7,
                b6,
                forms9,
                g3fn["degree8_syzygy_values"][prime_index, root_index],
                prime,
            )
            replay[prime_index, root_index] = canonical.astype(np.uint32)
            source_coefficients[prime_index, root_index] = source_coefficient.astype(
                np.uint32
            )
            local_profiles.append(profile)
            profiles.append(profile)
            source_profiles.append(source_profile)
            print(
                f"G3FZ p={prime} gamma={gamma}: first=5/0 "
                "second=17/1 O8=replayed",
                flush=True,
            )
        require(len(set(local_profiles)) == 1, f"common root profile p={prime}")
        source_residues.append(
            g3fe.interpolate(
                source_coefficients[prime_index].astype(np.int64), roots, prime
            ).reshape(-1).astype(np.uint32)
        )
        rows.append(
            {
                "prime": prime,
                "roots": list(roots),
                "profile": list(local_profiles[0]),
                "source_packet": record(packet_path),
            }
        )
    require(len(profiles) == 48 and len(set(profiles)) == 1, "common48 profile")
    require(
        len(source_profiles) == 48 and len(set(source_profiles)) == 1,
        "common48 source normalization chart",
    )
    require(
        np.array_equal(replay, g3fn["degree8_syzygy_values"]),
        "all48 O8 replay",
    )
    source_residue_matrix = np.stack(source_residues)
    require(source_residue_matrix.shape == (8, 792), "source residue shape")
    reconstruction = g3fe.reconstruction_audit(
        source_residue_matrix, conic.EXPECTED_PRIMES
