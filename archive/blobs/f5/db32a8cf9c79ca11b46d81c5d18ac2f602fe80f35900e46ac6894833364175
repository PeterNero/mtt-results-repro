        if not matrix:
            return Fraction(1)
        if len(matrix) == 1:
            return matrix[0][0]
        total = Fraction(0)
        for column, coefficient in enumerate(matrix[0]):
            if coefficient == 0:
                continue
            minor = [
                row[:column] + row[column + 1:]
                for row in matrix[1:]
            ]
            sign = Fraction(1 if column % 2 == 0 else -1)
            total += sign * coefficient * determinant(minor)
        return total

