def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def load_gzip(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    with gzip.open(path, "rt", encoding="utf-8") as handle:
        return json.load(handle)


def write_gzip_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    with gzip.open(temporary, "wt", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"))
        handle.write("\n")
    temporary.replace(path)


def determinant_mod_prime(candidates: list[list[int]]) -> int:
    matrix = [
        [
            sum(
                int(row[relation * 6 + degree])
                * pow(ROOT_VALUE, degree, PRIME)
                for degree in range(6)
            )
            % PRIME
            for relation in range(10)
        ]
        for row in candidates
    ]
    determinant = 1
    for column in range(10):
        pivot = next(
            (index for index in range(column, 10) if matrix[index][column]),
            None,
        )
        require(pivot is not None, "free projection is nonsingular")
        if pivot != column:
            matrix[column], matrix[pivot] = matrix[pivot], matrix[column]
            determinant = -determinant % PRIME
        pivot_value = matrix[column][column]
        determinant = determinant * pivot_value % PRIME
        inverse = pow(pivot_value, -1, PRIME)
        matrix[column] = [value * inverse % PRIME for value in matrix[column]]
        for row in range(column + 1, 10):
            factor = matrix[row][column]
            if factor:
                matrix[row] = [
                    (value - factor * pivot_entry) % PRIME
                    for value, pivot_entry in zip(
                        matrix[row], matrix[column], strict=True
                    )
                ]
    return determinant


