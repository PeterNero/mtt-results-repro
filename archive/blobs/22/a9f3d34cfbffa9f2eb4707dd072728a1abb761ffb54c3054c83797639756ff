#!/usr/bin/env python3
"""Hensel-lift the 21 reduced component-16 kernel directions."""

from __future__ import annotations

import argparse
import gzip
import json
import time
from pathlib import Path

import probe_ust_g3ec_component12_padic_kernel as padic


ROOT = Path(__file__).resolve().parent
MATRIX = ROOT / "evidence/ust_g3el/H02.component16.unit_pivot_reduced.number_field.sms"
CERTIFICATE = ROOT / "evidence/ust_g3el/H02.component16.unit_pivot_reduction.json"
DEFAULT_OUTPUT = ROOT / "evidence/ust_g3em/H02.component16.reduced.padic-exp64.residue.json.gz"
ROWS = 1238
COLUMNS = 1221


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--exponent", type=int, default=64)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    arguments = parser.parse_args()
    require(arguments.exponent >= 1, "positive p-adic exponent")

    certificate = json.loads(CERTIFICATE.read_text(encoding="utf-8"))
    require(certificate["output"]["shape"] == [ROWS, COLUMNS], "matrix shape")
    require(certificate["output"]["finite_nullity"] == 21, "finite nullity")
    free_columns = tuple(
        int(value) for value in certificate["output"]["free_component16_columns"]
    )
    require(free_columns == tuple(range(986, 1007)), "free component16 columns")

    padic.MATRIX = MATRIX
    padic.ROWS = ROWS
    padic.COLUMNS = COLUMNS
    padic.FREE_COLUMNS = free_columns

    started = time.monotonic()
    exact_rows = padic.load_rows()
    lifted = [padic.hensel_root(root, arguments.exponent) for root in padic.ROOTS]
    modulus = lifted[0][1]
    require(all(item[1] == modulus for item in lifted), "common p-adic modulus")
    print(
        f"G3EM p={padic.PRIME} exponent={arguments.exponent} "
        f"modulus_bits={modulus.bit_length()} active_rows={sum(bool(row) for row in exact_rows)}",
        flush=True,
    )
    kernels = [
        padic.solve_root(exact_rows, gamma, modulus) for gamma, _ in lifted
    ]
    destination = arguments.output
    if not destination.is_absolute():
        destination = ROOT / destination
    destination.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "schema": "ust.g3em.h02.component16.padic-kernel-residue.v1",
        "date": "2026-08-14",
        "matrix": MATRIX.relative_to(ROOT).as_posix(),
        "reduction_certificate": CERTIFICATE.relative_to(ROOT).as_posix(),
        "prime": padic.PRIME,
        "exponent": arguments.exponent,
        "modulus": str(modulus),
        "modulus_bits": modulus.bit_length(),
        "lifted_roots": [str(value) for value, _ in lifted],
        "shape": [len(kernels), COLUMNS, len(free_columns)],
        "free_columns": list(free_columns),
        "kernels": kernels,
        "claim_boundary": (
            "Six zero-residual p-adic kernels are search data only. Component16 is "
            "promoted only after 21 independent vectors replay literally over Q(gamma)."
        ),
    }
    temporary = destination.with_suffix(destination.suffix + ".tmp")
    with gzip.open(temporary, "wt", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"))
        handle.write("\n")
    temporary.replace(destination)
    print(
        f"G3EM component16 p-adic kernel: PASS shape={payload['shape']} "
        f"bytes={destination.stat().st_size} elapsed={time.monotonic()-started:.3f}",
        flush=True,
    )


if __name__ == "__main__":
    main()
