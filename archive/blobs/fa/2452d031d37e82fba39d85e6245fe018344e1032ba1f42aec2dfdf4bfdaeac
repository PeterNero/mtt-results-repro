def parse_linbox(output: str) -> tuple[int, int, int, int]:
    match = re.fullmatch(
        r"EXACT_F1016_SPARSE_ELIMINATION_RANK rows=(\d+) columns=(\d+) "
        r"nonzeros=(\d+) rank=(\d+)\s*",
        output,
    )
    require(match is not None, "LinBox output")
    return tuple(int(value) for value in match.groups())


def monomial_label(component: int, exponent: tuple[int, ...]) -> str:
    factors = []
    for name, power in zip(("x", "y", "z", "w", "t0", "t1", "t2"), exponent):
        if power == 1:
            factors.append(name)
        elif power > 1:
            factors.append(f"{name}^{power}")
    factors.append(("u^2", "u*v", "u*s", "v^2", "v*s", "s^2")[component - 1])
    return "*".join(factors)


def independently_pack_raw_coefficient(value: str) -> int:
    """Parse Singular's F_101(g) coefficient syntax without producer helpers."""
    expression = "".join(value.split())
    while expression.startswith("(") and expression.endswith(")"):
        expression = expression[1:-1]
    require(expression != "" and "(" not in expression and ")" not in expression,
            "raw coefficient parentheses")

    coefficients = [0] * RAW_COEFFICIENT_BASIS_DEGREE
    position = 0
    while position < len(expression):
        sign = 1
        if expression[position] in "+-":
            sign = -1 if expression[position] == "-" else 1
            position += 1
        require(position < len(expression), "raw coefficient trailing sign")

        end = position
        while end < len(expression) and expression[end] not in "+-":
            end += 1
        term = expression[position:end]
        require(term != "", "raw coefficient empty term")

        if "g" not in term:
            require(term.isdigit(), "raw integer coefficient term")
            scalar = int(term)
            power = 0
        else:
            require(term.count("g") == 1, "raw coefficient generator count")
            generator = term.index("g")
            scalar_text = term[:generator]
            if scalar_text:
                require(
                    scalar_text.endswith("*") and scalar_text[:-1].isdigit(),
                    "raw coefficient scalar syntax",
                )
                scalar = int(scalar_text[:-1])
            else:
                scalar = 1
            power_text = term[generator + 1 :]
            if power_text:
                require(
                    power_text.startswith("^") and power_text[1:].isdigit(),
                    "raw coefficient power syntax",
                )
                power = int(power_text[1:])
            else:
                power = 1
            require(
                0 <= power < RAW_COEFFICIENT_BASIS_DEGREE,
                "raw coefficient basis degree",
            )

        coefficients[power] = (
            coefficients[power] + sign * scalar
        ) % RAW_COEFFICIENT_PRIME
        position = end

    return sum(
        coefficient * RAW_COEFFICIENT_PRIME**power
        for power, coefficient in enumerate(coefficients)
    )


def self_test_raw_coefficient_parser() -> None:
    require(independently_pack_raw_coefficient("1") == 1, "raw parser unit")
    require(independently_pack_raw_coefficient("-1") == 100, "raw parser sign")
    require(independently_pack_raw_coefficient("g") == 101, "raw parser generator")
    require(
        independently_pack_raw_coefficient("(g^5-2*g^3+3)")
        == 3 + 99 * 101**3 + 101**5,
        "raw parser polynomial",
    )


def replay_raw_export(
    raw_output: Path,
    start: int,
    stop: int,
    target_index: dict[tuple[int, tuple[int, ...]], int],
) -> tuple[int, str]:
    """Reconstruct one packed-triple stream directly from raw Singular output."""
    marker = f"G3AP_MACAULAY_EXPORT_ROWS={stop - start}"
    marker_seen = False
    pass_seen = False
    errors: list[str] = []
    count = 0
    digest = hashlib.sha256()
    with gzip.open(raw_output, "rt", encoding="utf-8") as stream:
        for line in stream:
            stripped = line.rstrip()
            if stripped == marker:
                marker_seen = True
            elif stripped == "G3AP_MACAULAY_EXPORT_PASS":
                pass_seen = True
            if line.lstrip().startswith("?"):
                errors.append(stripped)
            if not line.startswith("G3AP_MACAULAY_TERM="):
                continue
            row_text, component_text, exponent_text, coefficient_text = (
                stripped.split("=", 1)[1].split("|", 3)
            )
            local_row = int(row_text)
            coordinate = (
                int(component_text),
                tuple(int(value) for value in exponent_text.split(",")),
            )
            require(
                1 <= local_row <= stop - start and coordinate in target_index,
                "raw export coordinate",
            )
            packed = independently_pack_raw_coefficient(coefficient_text)
            require(packed != 0, "raw export nonzero coefficient")
            digest.update(
                f"{start + local_row} {target_index[coordinate]} {packed}\n".encode(
                    "ascii"
                )
            )
            count += 1
    require(marker_seen and pass_seen and not errors, "raw export completion transcript")
    return count, digest.hexdigest()


def validate_campaign(
    campaign: dict[str, object], base_packet: dict[str, object]
) -> tuple[list[tuple[int, tuple[int, ...]]], int]:
    self_test_raw_coefficient_parser()
    require(
        RAW_COEFFICIENT_PRIME == macaulay.PRIME == minor.PRIME
        and RAW_COEFFICIENT_BASIS_DEGREE == minor.DEGREE
        and minor.FIELD_ORDER
        == RAW_COEFFICIENT_PRIME**RAW_COEFFICIENT_BASIS_DEGREE,
        "selected coefficient field",
    )
    rows = int(campaign["selection"]["rows"])
    schema = campaign["schema"]
    require(
        schema
        in (
            "mtt.unified-source.g3ap-selected-cayley-target-macaulay-campaign.v1",
            "mtt.unified-source.g3ap-selected-cayley-target-macaulay-campaign.v2",
            "mtt.unified-source.g3ap-selected-cayley-target-macaulay-campaign.v3",
        ),
        "campaign schema",
    )
    pieces = int(
        campaign["selection"].get(
            "workers", campaign["selection"].get("pieces", -1)
        )
    )
    require(rows >= TARGET_RANK and pieces == len(campaign["chunks"]), "campaign size")
    leaders = [tuple(int(value) for value in item) for item in base_packet["base_leading_exponents"]]
    targets, _ = macaulay.coordinate_data(leaders)
    target_index = {value: index for index, value in enumerate(targets, start=1)}
    require(len(target_index) == len(targets), "unique target coordinates")
    all_sources, _ = macaulay.source_data(leaders)
    selected, quotas = macaulay.balanced_source_subset(all_sources, rows)
    require(
        chunk_builder.selection_hash(selected) == campaign["selection"]["selection_sha256"]
        and quotas == campaign["selection"]["per_generator_quotas"],
        "balanced source schedule",
    )
    source_text = macaulay.SOURCE.read_text(encoding="ascii")
    expected_matrix_hash = hashlib.sha256()
    expected_matrix_hash.update(
        f"{rows} {macaulay.EXPECTED_TARGET_COORDINATES} {campaign['matrix']['nonzeros']}\n".encode(
            "ascii"
        )
    )
    total_nonzeros = 0
    expected_start = 0
    executed_rows = 0
    executed_per_generator = [0] * len(quotas)
    for index, record in enumerate(campaign["chunks"]):
        packet_path = checked(record["packet"], f"chunk {index} packet")
        chunk = json.loads(packet_path.read_text(encoding="ascii"))
        chunk_schema = chunk["schema"]
        require(
            chunk_schema
            in (
                "mtt.unified-source.g3ap-selected-cayley-target-macaulay-chunk.v1",
                "mtt.unified-source.g3ap-selected-cayley-target-macaulay-range.v1",
            )
            and chunk["selection"]["balanced_rows"] == rows
            and chunk["selection"]["selection_sha256"]
            == campaign["selection"]["selection_sha256"],
            f"chunk {index} identity",
        )
        start, stop = [int(value) for value in record["global_range_zero_based"]]
        require(
            (start == expected_start if schema.endswith(("v1", "v2")) else start >= expected_start)
            and 0 <= start < stop <= rows
            and chunk["selection"]["global_start_zero_based"] == start
            and chunk["selection"]["global_stop_exclusive_zero_based"] == stop,
            f"chunk {index} range",
        )
        if chunk_schema.endswith("chunk.v1"):
            require(
                chunk["selection"]["chunk_count"] > 0
                and 0 <= chunk["selection"]["chunk_index"]
                < chunk["selection"]["chunk_count"],
                f"chunk {index} fixed partition identity",
            )
        expected_start = stop
        executed_rows += stop - start
        for generator, _ in selected[start:stop]:
            executed_per_generator[generator] += 1
        script = checked(chunk["execution"]["script"], f"chunk {index} script")
        expected_script = macaulay.export_script(source_text, selected[start:stop])
        require(
            script.read_text(encoding="ascii") == expected_script,
            f"chunk {index} selected-source script reconstruction",
        )
        raw_output = checked(
            chunk["execution"]["compressed_output"], f"chunk {index} raw output"
        )
        triples = checked(chunk["execution"]["packed_triples"], f"chunk {index} triples")
        previous_row = start
        seen_columns: set[int] = set()
        counted = 0
        semantic_triples_hash = hashlib.sha256()
        with triples.open("rb") as stream:
            for raw_line in stream:
                row_text, column_text, packed_text = raw_line.split()
                row = int(row_text)
                column = int(column_text)
                packed = int(packed_text)
                require(
                    start + 1 <= row <= stop
                    and row >= previous_row
                    and 1 <= column <= macaulay.EXPECTED_TARGET_COORDINATES
                    and 0 < packed < minor.FIELD_ORDER,
                    f"chunk {index} exact triple",
                )
                if row != previous_row:
                    seen_columns.clear()
                    previous_row = row
                require(column not in seen_columns, f"chunk {index} duplicate coordinate")
                seen_columns.add(column)
                semantic_triples_hash.update(
                    f"{row} {column} {packed}\n".encode("ascii")
                )
                expected_matrix_hash.update(raw_line)
                counted += 1
        require(counted == chunk["execution"]["nonzeros"], f"chunk {index} nonzeros")
        replayed_count, replayed_hash = replay_raw_export(
            raw_output, start, stop, target_index
        )
        require(
            replayed_count == counted
            and replayed_hash == semantic_triples_hash.hexdigest(),
            f"chunk {index} raw-to-triple replay",
        )
        total_nonzeros += counted
    if schema.endswith(("v1", "v2")):
        require(expected_start == rows, "complete campaign range cover")
    else:
        require(
            executed_rows == campaign["selection"]["executed_rows"]
            and executed_rows >= TARGET_RANK,
            "rank subcampaign row coverage",
        )
        require(
            executed_per_generator
            == campaign["selection"]["executed_per_generator"],
            "rank subcampaign generator coverage",
        )
        reference_quotient, reference_remainder = divmod(TARGET_RANK, len(quotas))
        reference_rows = [
            reference_quotient + (generator < reference_remainder)
            for generator in range(len(quotas))
        ]
        require(
            campaign["selection"]["reference_rank_balanced_rows"]
            == reference_rows
            and campaign["selection"]["reference_rank_balanced_deficits"]
            == [
                max(0, target - actual)
                for target, actual in zip(reference_rows, executed_per_generator)
            ],
            "rank subcampaign balance diagnostic",
        )
    matrix_path = ROOT / str(campaign["matrix"]["path"])
    require(
        total_nonzeros == campaign["matrix"]["nonzeros"]
        and expected_matrix_hash.hexdigest() == campaign["matrix"]["sha256"]
        and matrix_path.is_file()
        and sha256(matrix_path) == campaign["matrix"]["sha256"],
        "assembled exact matrix",
    )
    return targets, total_nonzeros


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=43200)
    parser.add_argument("--emit-only", action="store_true")
    args = parser.parse_args()
    source = macaulay.SOURCE.read_text(encoding="ascii")
    BASE_SCRIPT.write_text(base_certification_script(source), encoding="ascii")
    if args.emit_only:
        print(f"emitted {relative(BASE_SCRIPT)}")
        return

    subprocess.run([sys.executable, str(LOWER_VERIFIER)], cwd=ROOT, check=True)
    lower_packet = json.loads(lower.OUT.read_text(encoding="ascii"))
    require(
        lower_packet["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_AT_LEAST_ONE"
        and all(lower_packet["checks"].values())
        and not any(lower_packet["guardrails"].values()),
        "selected lower bound",
    )
    rank_candidate = json.loads(RANK_CANDIDATE.read_text(encoding="ascii"))
    require(
        rank_candidate["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-target-macaulay-rank-candidate.v1"
        and all(rank_candidate["checks"].values())
        and not any(rank_candidate["guardrails"].values()),
        "rank candidate",
    )
    checked(rank_candidate["inputs"]["native_tools_build"], "native tools build")
    require(native_tools.current(), "hash-current native tools build")
    campaign_path = checked(rank_candidate["inputs"]["campaign"], "campaign")
    matrix_path = checked(rank_candidate["inputs"]["campaign_matrix"], "campaign matrix")
    extraction_path = checked(
        rank_candidate["inputs"]["minor_extraction"], "minor extraction"
    )
    selected_minor = checked(rank_candidate["inputs"]["selected_minor"], "selected minor")
    campaign = json.loads(campaign_path.read_text(encoding="ascii"))
    require(matrix_path == ROOT / campaign["matrix"]["path"], "campaign matrix identity")
    base_packet_path = checked(campaign["inputs"]["base_coordinate_packet"], "base packet")
    base_packet = json.loads(base_packet_path.read_text(encoding="ascii"))
    require(
        base_packet["inputs"]["selected_source"]["sha256"] == sha256(macaulay.SOURCE),
        "selected source binding",
    )
    targets, matrix_nonzeros = validate_campaign(campaign, base_packet)

    started = time.time()
    completed = subprocess.run(
        singular_command(ROOT, BASE_SCRIPT),
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=args.timeout,
        check=False,
    )
    BASE_OUTPUT.write_text(completed.stdout, encoding="utf-8")
    require(completed.returncode == 0, "base certification execution")
    require(
        not any(line.lstrip().startswith("?") for line in completed.stdout.splitlines()),
        "base certification Singular errors",
    )
    for label, value in {
        "G3AP_MACAULAY_BASECERT_CACHE_IN_SELECTED": 1,
        "G3AP_MACAULAY_BASECERT_SELECTED_IN_CACHE": 1,
        "G3AP_MACAULAY_BASECERT_CACHE_LEADING_IN_CHECK": 1,
        "G3AP_MACAULAY_BASECERT_CHECK_LEADING_IN_CACHE": 1,
    }.items():
        require(f"{label}={value}" in completed.stdout, label)
    require("G3AP_MACAULAY_BASECERT_PASS" in completed.stdout, "base pass")
    require(BASE_STANDARD_CACHE.is_file(), "certified standard-basis cache")
    cache_size = int(
        re.search(
            r"^G3AP_MACAULAY_BASECERT_CACHE_SIZE=(\d+)$",
            completed.stdout,
            re.MULTILINE,
        ).group(1)
    )
    cache_leaders = {
        int(match.group(1)): tuple(int(value) for value in match.group(2).split(","))
        for match in re.finditer(
            r"^G3AP_MACAULAY_BASECERT_CACHE_LEADER_(\d+)=([0-9,]+)$",
            completed.stdout,
            re.MULTILINE,
        )
    }
    require(
        set(cache_leaders) == set(range(1, cache_size + 1))
        and [cache_leaders[index] for index in range(1, cache_size + 1)]
        == [tuple(value) for value in base_packet["base_leading_exponents"]],
        "certified base coordinate leaders",
    )

    extraction = json.loads(extraction_path.read_text(encoding="ascii"))
    custom_engine = rank_candidate["engines"]["custom_sparse_column_elimination"]
    checked(custom_engine["source"], "custom source")
    checked(custom_engine["binary"], "custom binary")
    checked(custom_engine["log"], "custom log")
    for index, dependency in enumerate(custom_engine.get("source_dependencies", [])):
        checked(dependency, f"custom source dependency {index}")
    scheduler_test = custom_engine.get("scheduler_self_test")
    if custom_engine.get("scheduler") == "weighted-free-fast":
        require(isinstance(scheduler_test, dict), "free-support scheduler self-test")
        checked(scheduler_test["matrix"], "free-support scheduler matrix")
        scheduler_output = checked(
            scheduler_test["output"], "free-support scheduler output"
        )
        checked(scheduler_test["log"], "free-support scheduler log")
        scheduler_scalars, scheduler_vectors = minor.parse_output(scheduler_output)
        require(
            scheduler_scalars["ROW_ORDER"]
            == "adaptive-free-then-weighted-support"
            and int(scheduler_scalars["PROCESSED_SOURCE_ROWS"]) == 2
            and int(scheduler_scalars["RESCORED_SOURCE_ROWS"]) >= 1
            and scheduler_vectors["SELECTED_SOURCE_ROWS_ZERO_BASED"] == [0, 2],
            "free-support scheduler exact ordering replay",
        )
    custom_output = checked(custom_engine["output"], "custom output")
    scalars, vectors = minor.parse_output(custom_output)
    functional = vectors["QUOTIENT_FUNCTIONAL_PACKED"]
    require(
        scalars["SCHEMA"] == "MTTF1016SparseColumnMinorExactOutput.v2"
        and int(scalars["MINOR_SIZE"]) == TARGET_RANK
        and int(scalars["QUOTIENT_FUNCTIONAL_VERIFIED_MATRIX_NONZEROS"])
        == matrix_nonzeros
        and len(functional) == len(targets) == macaulay.EXPECTED_TARGET_COORDINATES,
        "custom quotient output",
    )
    require(
        minor.determinant(
            vectors["PIVOT_TARGET_COORDINATES_ZERO_BASED"],
            vectors["PIVOT_COEFFICIENTS_PACKED"],
        )
        == int(scalars["MINOR_DETERMINANT_PACKED"])
        != 0,
        "independent determinant replay",
    )
    normalization = int(scalars["QUOTIENT_NORMALIZATION_TARGET_COORDINATE_ZERO_BASED"])
    require(functional[normalization] == 1, "quotient normalization")
    linbox_output = checked(
        rank_candidate["engines"]["linbox_givaro_sparse_elimination"]["output"],
        "LinBox output",
    )
    linbox_shape = parse_linbox(linbox_output.read_text(encoding="utf-8"))
    require(
        linbox_shape[0] == linbox_shape[1] == linbox_shape[3] == TARGET_RANK
        and linbox_shape[2] == extraction["minor"]["nonzeros"]
        and selected_minor == ROOT / extraction["minor"]["path"],
        "independent exact minor rank",
    )
    functional_engine = rank_candidate["engines"][
        "givaro_full_matrix_functional_replay"
    ]
    checked(functional_engine["source"], "Givaro functional source")
    checked(functional_engine["binary"], "Givaro functional binary")
    functional_artifact = checked(functional_engine["functional"], "functional artifact")
    functional_output = checked(functional_engine["output"], "Givaro functional output")
    functional_shape = rank_runner.parse_functional_replay(
        functional_output.read_text(encoding="utf-8")
    )
    require(
        functional_shape[0] == campaign["matrix"]["rows"]
        and functional_shape[1] == macaulay.EXPECTED_TARGET_COORDINATES
        and functional_shape[2] == matrix_nonzeros
        and functional_shape[3] == campaign["matrix"]["rows"],
        "independent Givaro functional replay",
    )
    for record_name in (
        "matrix",
