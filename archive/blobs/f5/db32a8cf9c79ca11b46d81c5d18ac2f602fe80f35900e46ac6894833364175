        polynomial: dict[int, Fraction],
    ) -> dict[int, Fraction]:
        return {
            degree - 1: coefficient * degree
            for degree, coefficient in polynomial.items()
            if degree > 0 and coefficient != 0
        }

    def polynomial_add_term(
        polynomial: dict[int, Fraction],
        degree: int,
        coefficient: Fraction,
    ) -> None:
        polynomial[degree] = (
            polynomial.get(degree, Fraction(0)) + coefficient
        )
        if polynomial[degree] == 0:
            del polynomial[degree]

    def flat_derivative_successor(
        polynomial: dict[int, Fraction],
    ) -> dict[int, Fraction]:
        # For x=1/lambda and f=(1/2)exp(1-x^2):
        # d_lambda(P(x)exp(1-x^2))
        # =(-x^2 P'(x)+2x^3 P(x))exp(1-x^2).
        output: dict[int, Fraction] = {}
        for degree, coefficient in polynomial_derivative(
            polynomial
        ).items():
            polynomial_add_term(
                output,
                degree + 2,
                -coefficient,
            )
        for degree, coefficient in polynomial.items():
            polynomial_add_term(
                output,
                degree + 3,
                2 * coefficient,
            )
        return output

