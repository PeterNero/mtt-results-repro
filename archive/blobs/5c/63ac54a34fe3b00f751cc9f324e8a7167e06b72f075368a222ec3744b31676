Element = g3ad.Element


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def normalized_text_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes().replace(b"\r\n", b"\n")).hexdigest()


def canonical_hash(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def transpose(columns: list[list[Element]]) -> list[list[Element]]:
    return [list(row) for row in zip(*columns)]


def dot(left: list[Element], right: list[Element], ring: g3ad.QuotientRing) -> Element:
    value = ring.zero
    for a, b in zip(left, right):
        value = ring.add(value, ring.mul(a, b))
    return value


def matrix_vector(
    matrix: list[list[Element]], vector: list[Element], ring: g3ad.QuotientRing
) -> list[Element]:
    return [dot(row, vector, ring) for row in matrix]


def inverse_matrix(
    matrix: list[list[Element]], ring: g3ad.QuotientRing
) -> list[list[Element]]:
    size = len(matrix)
    require(size and all(len(row) == size for row in matrix), "square matrix")
    augmented = [
        list(row)
        + [ring.one if column == row_index else ring.zero for column in range(size)]
        for row_index, row in enumerate(matrix)
    ]
    reduced, pivots = g3ak.rref(augmented, ring)
    require(pivots[:size] == list(range(size)), "invertible matrix")
    require(
        all(
            reduced[row][column] == (ring.one if row == column else ring.zero)
            for row in range(size)
            for column in range(size)
        ),
        "identity left block",
    )
    return [row[size:] for row in reduced]


def selected_frames() -> dict[str, object]:
    g3ad_packet = load(G3AD)
    g3af_packet = load(G3AF)
    g3ag_packet = load(G3AG)
    g3ak_packet = load(G3AK)
    relation = g3ad_packet["completion_ring"]["gamma_relation_coefficients_ascending"]
    ring = g3ad.QuotientRing(P, relation)
    basis = g3ae.coefficient_basis()

    raw = INCIDENCE.read_bytes()
    require(len(raw) == 168 * 249 * 6, "incidence byte count")
    offset = 0
    incidence: list[list[Element]] = []
    for _ in range(168):
        row = []
        for _ in range(249):
            row.append(tuple(raw[offset : offset + 6]))
            offset += 6
        incidence.append(row)
    reduced, pivots = g3ak.rref(incidence, ring)
    free, kernel = g3ak.canonical_kernel_basis(reduced, pivots, ring)
    require(len(pivots) == 126 and len(free) == len(kernel) == 123, "G3AK ranks")

    selected = g3ak.coefficient_vector(g3ad_packet, basis, ring)
    union, _ = g3ak.graph_union(g3ad_packet, g3af_packet, ring)
    principal, labels = g3ak.principal_slice(union, basis, ring)
    extra_positions = g3ak_packet["full_graph_preserving_frame"][
        "extra_kernel_basis_positions_zero_based"
    ]
    extra = [kernel[int(position)] for position in extra_positions]
    require(len(principal) == 33 and len(extra) == 89, "33+89 frame")

    pivot = next(index for index, value in enumerate(selected) if value != ring.zero)
    pivot_inverse = ring.inverse_field(selected[pivot])

    def chart(vector: list[Element]) -> list[Element]:
        scale = ring.mul(vector[pivot], pivot_inverse)
        normalized = [
            ring.sub(value, ring.mul(scale, selected_value))
            for value, selected_value in zip(vector, selected)
        ]
        require(normalized[pivot] == ring.zero, "projective chart normalization")
        return normalized[:pivot] + normalized[pivot + 1 :]

    d0 = [chart(vector) for vector in principal]
    d1 = [chart(vector) for vector in extra]
    full = d0 + d1
    # Each list entry is one column of the displayed 248-row map.  RREF of
    # this transpose returns independent target-row positions.
    _, principal_pivots = g3ak.rref(d0, ring)
    _, full_pivots = g3ak.rref(full, ring)
    require(len(principal_pivots) == 33, "principal chart rank")
    require(len(full_pivots) == 122, "full chart rank")
    return {
        "ring": ring,
        "relation": relation,
        "basis": basis,
        "selected": selected,
        "principal": principal,
        "extra": extra,
        "principal_chart": d0,
        "extra_chart": d1,
        "principal_labels": labels,
        "projective_pivot": pivot,
        "principal_pivot_rows": principal_pivots,
        "g3ad": g3ad_packet,
        "g3ag": g3ag_packet,
    }


def quotient_data(frames: dict[str, object]) -> dict[str, object]:
    ring: g3ad.QuotientRing = frames["ring"]  # type: ignore[assignment]
    d0: list[list[Element]] = frames["principal_chart"]  # type: ignore[assignment]
    d1: list[list[Element]] = frames["extra_chart"]  # type: ignore[assignment]
    d0_rows = transpose(d0)
    d1_rows = transpose(d1)
    pivot_rows = [int(value) for value in frames["principal_pivot_rows"]]  # type: ignore[arg-type]
    pivot_set = set(pivot_rows)
    quotient_rows = [row for row in range(248) if row not in pivot_set]
    r0 = [d0_rows[row] for row in pivot_rows]
    r0_inverse = inverse_matrix(r0, ring)

    def n0(value: list[Element]) -> list[Element]:
        coordinates = matrix_vector(r0_inverse, [value[row] for row in pivot_rows], ring)
        return [
            ring.sub(value[row], dot(d0_rows[row], coordinates, ring))
            for row in quotient_rows
        ]

    require(
        all(all(value == ring.zero for value in n0(column)) for column in d0),
        "N0 D0=0",
    )
    e_columns = [n0(column) for column in d1]
    e_rows = transpose(e_columns)
    _, e_column_pivots = g3ak.rref(e_rows, ring)
    require(len(e_column_pivots) == 89, "extra Schur rank 89")
    # E columns are stored as 89 rows of E^T, so these pivots are E-row
    # positions and select an invertible 89x89 row minor.
    _, e_pivot_rows = g3ak.rref(e_columns, ring)
    require(len(e_pivot_rows) == 89, "89 independent E rows")
    e_pivot_set = set(e_pivot_rows)
    final_rows = [row for row in range(215) if row not in e_pivot_set]
    e0 = [e_rows[row] for row in e_pivot_rows]
    e0_inverse = inverse_matrix(e0, ring)

    def left_normal(value: list[Element]) -> list[Element]:
        coordinates = matrix_vector(
            e0_inverse, [value[row] for row in e_pivot_rows], ring
        )
        return [
            ring.sub(value[row], dot(e_rows[row], coordinates, ring))
            for row in final_rows
        ]

    require(
        all(
            all(value == ring.zero for value in left_normal(column))
            for column in e_columns
        ),
        "L E=0",
    )

    # The factored solver recovers the two coordinate blocks without forming a
    # dense 122x248 inverse.
    for index, column in enumerate(d0):
        b1 = matrix_vector(e0_inverse, [n0(column)[row] for row in e_pivot_rows], ring)
        b0 = matrix_vector(r0_inverse, [column[row] for row in pivot_rows], ring)
        require(all(value == ring.zero for value in b1), "D0 extra coordinates zero")
        require(
            b0 == [ring.one if j == index else ring.zero for j in range(33)],
            "D0 coordinates recovered",
        )
    for index, column in enumerate(d1):
        q = n0(column)
        b1 = matrix_vector(e0_inverse, [q[row] for row in e_pivot_rows], ring)
        require(
            b1 == [ring.one if j == index else ring.zero for j in range(89)],
            "D1 coordinates recovered",
        )
        residual = [
            ring.sub(value, dot(row, b1, ring)) for value, row in zip(column, d1_rows)
        ]
        b0 = matrix_vector(r0_inverse, [residual[row] for row in pivot_rows], ring)
        require(all(value == ring.zero for value in b0), "D1 principal coordinates zero")

    return {
        "principal_pivot_rows": pivot_rows,
        "principal_quotient_rows": quotient_rows,
        "principal_pivot_inverse": r0_inverse,
        "extra_schur_columns": e_columns,
        "extra_pivot_rows": e_pivot_rows,
        "final_normal_rows": final_rows,
        "extra_pivot_inverse": e0_inverse,
    }


def singular_element(value: Element) -> str:
    pieces = []
    for exponent, coefficient in enumerate(value):
        coefficient %= P
        if coefficient == 0:
            continue
        power = "" if exponent == 0 else "g" if exponent == 1 else f"g^{exponent}"
        if exponent == 0:
            pieces.append(str(coefficient))
        elif coefficient == 1:
            pieces.append(power)
        else:
            pieces.append(f"{coefficient}*{power}")
    return "+".join(pieces) if pieces else "0"


def monomial(row: dict[str, object]) -> str:
    pieces = []
    for variable, power in zip(("x", "y", "z"), row["powers_xyz"]):
        power = int(power)
        if power == 1:
            pieces.append(variable)
        elif power > 1:
            pieces.append(f"{variable}^{power}")
    if row["basis_kind"] == "K3_sheet_times_degree6":
        pieces.append("w")
    return "*".join(pieces) if pieces else "1"


def coefficient_polynomials(
    vector: list[Element], basis: list[dict[str, object]]
) -> list[str]:
    result = []
    for target in range(3):
        terms = []
        for value, row in zip(vector, basis):
            if int(row["target_coordinate"]) != target or not any(value):
                continue
            terms.append(f"({singular_element(value)})*{monomial(row)}")
        result.append("+".join(terms) if terms else "0")
    return result


def singular_minpoly(relation: list[int]) -> str:
    return "+".join(
        str(coefficient)
        if exponent == 0
        else ("g" if coefficient == 1 and exponent == 1 else f"g^{exponent}" if coefficient == 1 else f"{coefficient}*g^{exponent}")
        for exponent, coefficient in enumerate(relation)
        if coefficient % P
    )


