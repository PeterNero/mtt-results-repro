#!/usr/bin/env python3
"""Independently verify the exact H02 source-observation corridor."""

from __future__ import annotations

import hashlib
import json
from collections import Counter
from pathlib import Path

import numpy as np
from scipy import sparse

import build_ust_g3df_h02_dm_source_observation_corridor as builder


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3df_h02_dm_source_observation_corridor.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def load(path: Path):
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> None:
    packet = load(PACKET)
    require(packet["theorem_id"] == "UST.G3DF", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    for value in packet["inputs"].values():
        path = ROOT / value["path"]
        require(sha256(path) == value["sha256"], f"input hash {path.name}")

    g3de = load(ROOT / packet["inputs"]["G3DE"]["path"])
    g3bw = load(ROOT / packet["inputs"]["G3BW"]["path"])
    reduction = g3bw["DM_reduction"]
    pattern = sparse.load_npz(ROOT / reduction["pattern"]["path"]).tocsr()
    arrays = np.load(ROOT / reduction["arrays"]["path"], allow_pickle=False)
    component_by_column = arrays["component_by_column"].astype(np.int32)
    component_by_row = arrays["component_by_row"].astype(np.int32)
    component_sizes = arrays["component_sizes"].astype(np.int32)
    topological_order = arrays["topological_component_order"].astype(np.int32)
    successors, predecessors, edge_pairs = builder.component_dag(
        pattern, component_by_row, component_by_column, int(component_sizes.size)
    )
    order_position = np.empty(component_sizes.size, dtype=np.int32)
    order_position[topological_order] = np.arange(component_sizes.size, dtype=np.int32)
    require(
        all(order_position[left] < order_position[right] for left, right in edge_pairs),
        "DAG order",
    )

    factor = g3de["factorization"]
    u_pattern = builder.union_pattern(factor["U_gamma_coefficients"])
    w_pattern = builder.union_pattern(factor["W_gamma_coefficients"])
    sources = set(int(value) for value in np.unique(component_by_row[u_pattern.nonzero()[0]]))
    observations = set(int(value) for value in np.unique(component_by_column[w_pattern.nonzero()[1]]))
    solution = builder.closure(sources, predecessors)
    descendants = builder.closure(observations, successors)
    corridor = solution & descendants
    active_columns, zero_columns, active_rows, zero_rows = builder.active_kernel_coordinates(
        u_pattern,
        w_pattern,
        component_by_row,
        component_by_column,
        descendants,
        solution,
    )
    histogram = Counter(int(component_sizes[value]) for value in corridor)
    require(len(sources) == 1 and len(observations) == 19, "source/observation counts")
    require(len(solution) == 95 and int(component_sizes[list(solution)].sum()) == 24861, "recovery cone")
    require(len(descendants) == 17598 and int(component_sizes[list(descendants)].sum()) == 42364, "observation cone")
    require(histogram == Counter({24767: 1}), "corridor core")
    require(len(active_columns) == len(active_rows) == 6022, "active kernel")
    require(not zero_columns and not zero_rows, "zero kernel coordinates")

    emitted_path = ROOT / packet["exact_component_DAG"]["arrays"]["path"]
    require(sha256(emitted_path) == packet["exact_component_DAG"]["arrays"]["sha256"], "emitted arrays hash")
    emitted = np.load(emitted_path, allow_pickle=False)
    require(np.array_equal(emitted["corridor_components"], np.asarray(sorted(corridor), dtype=np.int32)), "corridor arrays")
    require(np.array_equal(emitted["solution_components"], np.asarray(sorted(solution), dtype=np.int32)), "solution arrays")
    print("UST.G3DF H02 DM source-observation corridor verifier: PASS")
    print("corridor_dimension=24767 recovery_dimension=24861 active_kernel=6022x6022")


if __name__ == "__main__":
    main()
