def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


@dataclass
class Trie:
    children: dict[int, "Trie"] = field(default_factory=dict)
    terminal: bool = False

    def add(self, point: tuple[int, ...], depth: int = 0) -> None:
        if depth == len(point):
            self.terminal = True
        else:
            self.children.setdefault(point[depth], Trie()).add(point, depth + 1)

    def divides(self, point: tuple[int, ...], depth: int = 0) -> bool:
        if self.terminal:
            return True
        return depth < len(point) and any(
            child.divides(point, depth + 1)
            for exponent, child in self.children.items()
            if exponent <= point[depth]
        )


def trie_for(
    leaders: list[tuple[int, ...]], fiber: tuple[int, int, int]
) -> Trie:
    projected = {
        tuple(leader[index] for index in PROJECTION)
        for leader in leaders
        if all(leader[7 + offset] <= fiber[offset] for offset in range(3))
    }
    trie = Trie()
    for point in sorted(projected, key=lambda value: (sum(value), value)):
        if not trie.divides(point):
            trie.add(point)
    return trie


def verify_bounded(packet: dict) -> None:
    record = packet["inputs"]["bounded_top"]
    bounded_path = ROOT / record["path"]
    require(
        bounded_path.is_file() and sha256(bounded_path) == record["sha256"],
        "bounded certificate",
    )
    bounded = json.loads(bounded_path.read_text(encoding="ascii"))
    require(
        bounded["schema"] == "mtt.unified-source.g3ap-selected-cayley-bounded-top.v1",
        "bounded schema",
    )
    require(
        bounded["status"]
        == "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_DIMENSION_ONE",
        "bounded status",
    )
    require(all(bounded["checks"].values()), "bounded checks")
    require(not any(bounded["guardrails"].values()), "bounded guardrails")
    leading = packet["leading_ideal"]
    require(
        leading["method"]
        == "homogeneous_standard_basis_truncated_through_scalar_degree_44"
        and leading["scalar_degree_bound"] == 44
        and leading["full_standard_basis_claimed"] is False,
        "bounded method",
    )
    source_keys = {
        "export_script": "script",
        "raw_output": "output",
        "bounded_basis_cache": "bounded_basis_cache",
    }
    for key, source_key in source_keys.items():
        item = leading[key]
        path = ROOT / item["path"]
        require(path.is_file() and sha256(path) == item["sha256"], f"bounded {key}")
        require(item == bounded["execution"][source_key], f"copied {key}")
    raw = (ROOT / leading["raw_output"]["path"]).read_text(encoding="utf-8")
    require("G3AP_BOUND=44" in raw, "raw degree bound")
    require("G3AP_LEADING_EXPONENT_EXPORT_PASS" in raw, "raw pass")
    count = re.search(r"^G3AP_LEADING_EXPONENT_COUNT=(\d+)$", raw, re.MULTILINE)
    require(count is not None, "raw count")
    leaders = [
        tuple(int(item) for item in match.group(1).split(","))
        for match in re.finditer(
            r"^G3AP_LEADING_EXPONENT_\d+=([0-9,]+)$", raw, re.MULTILINE
        )
    ]
    require(
        len(leaders) == int(count.group(1)) == leading["basis_size"],
        "all bounded leaders",
    )
    require(all(len(value) == 10 for value in leaders), "bounded leader widths")
    standards = []
    total = 0
    sector_counts = {}
    for u_power in range(3):
        for v_power in range(3 - u_power):
            s_power = 2 - u_power - v_power
            trie = trie_for(leaders, (u_power, v_power, s_power))
            h_degree = 18 + 6 * u_power + 9 * s_power
            l_degree = 2 + 3 * v_power + s_power
            sector_total = 0
            sector_standard = 0
            for w_power in range(h_degree // 3 + 1):
                xyz_degree = h_degree - 3 * w_power
                for x_power in range(xyz_degree + 1):
                    for y_power in range(xyz_degree - x_power + 1):
                        z_power = xyz_degree - x_power - y_power
                        for t0_power in range(l_degree + 1):
                            for t1_power in range(l_degree - t0_power + 1):
                                t2_power = l_degree - t0_power - t1_power
                                exponent = (
                                    x_power, y_power, z_power, w_power,
                                    t0_power, t1_power, t2_power,
                                    u_power, v_power, s_power,
                                )
                                sector_total += 1
                                point = tuple(exponent[index] for index in PROJECTION)
                                if not trie.divides(point):
                                    standards.append(exponent)
                                    sector_standard += 1
            total += sector_total
            sector_counts[f"u{u_power}_v{v_power}_s{s_power}"] = (
                sector_total,
                sector_standard,
            )
    top = packet["ordinary_top_piece"]
    require(top == bounded["ordinary_top_piece"], "copied top piece")
    require(total == top["enumerated_monomials"] == 174865, "target enumeration")
    require(standards == [EXPECTED_SOCLE], "unique bounded socle")
    require(top["dimension"] == 1 and top["basis"] == ["w^12*t2^4*s^2"], "top line")
    for key, (sector_total, sector_standard) in sector_counts.items():
        require(
            top["fiber_sectors"][key]["enumerated_monomials"] == sector_total
            and top["fiber_sectors"][key]["standard_monomials"] == sector_standard,
            f"bounded sector {key}",
        )
    print(
        f"UST.G3AP selected ordinary top line: PASS bounded_leaders={len(leaders)} "
        "Cox_monomials=174865 dimension=1"
    )


