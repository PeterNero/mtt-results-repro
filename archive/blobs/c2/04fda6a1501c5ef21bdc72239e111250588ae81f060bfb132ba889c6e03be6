            f"CLOSED_EXACT_H02_COMPONENT16_{lift_label}_RANK"
            f"{component16_rank}_GLOBAL_UPPER{global_upper}"
        ),
        "controlling_blockers": ["B.ETA9.01", "B.ETA9.02"],
        "inputs": {
            "G3EJ": record(G3EJ),
            "G3DX": record(G3DX),
            "G3EK": record(G3EK),
            "G3EL": record(G3EL),
            "G3EQ": record(G3EQ),
            "G3ET": record(G3ET),
            "G3ET_recovered_kernel": record(G3ET_RECOVERY),
            "cutset": record(CUTSET),
            "audit_rows": record(AUDIT),
            "exact_residual_map": record(exact_map),
            "modular_residual_map": record(MODULAR_MAP),
            "modular_witness_certificate": record(MODULAR_CERTIFICATE),
            "modular_residual_campaign": record(MODULAR_CAMPAIGN),
            "exact_residual_rank_certificate": record(EXACT_RANK_CERTIFICATE),
            "native_replay_source": record(NATIVE_REPLAY),
        },
        "exact_subsystem_certificate": {
