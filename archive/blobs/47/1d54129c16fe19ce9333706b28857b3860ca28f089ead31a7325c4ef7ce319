from __future__ import annotations

import hashlib
import json
import os
from itertools import permutations
from pathlib import Path

import sympy as sp


ROOT = Path(__file__).resolve().parent
TEXPAPERS = Path(os.environ.get("MTT_TEXPAPERS_ROOT", ROOT.parent))
REPOSITORIES = {
    "20 Mathematical Language Discovery Program": ROOT,
    "mtt-protospinor-gr-response-proof": Path(
        os.environ.get(
            "MTT_PROTOSPINOR_GR_ROOT",
            TEXPAPERS / "mtt-protospinor-gr-response-proof",
        )
    ),
    "mtt-qm-source-proof": Path(
        os.environ.get(
            "MTT_QM_SOURCE_ROOT",
            TEXPAPERS / "mtt-qm-source-proof",
        )
    ),
    "mtt-sm-parity-closure": Path(
        os.environ.get(
            "MTT_SM_CLOSURE_ROOT",
            TEXPAPERS / "mtt-sm-parity-closure",
        )
    ),
}
PACKET = ROOT / "q79_shared_circle_closure_dynamics_source.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict:
    if not path.is_file():
        raise FileNotFoundError(path)
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def matrix(values: list[list[object]]) -> sp.Matrix:
    return sp.Matrix(
        [[sp.sympify(value, locals={"I": sp.I}) for value in row] for row in values]
    )


def is_zero(value: sp.MatrixBase) -> bool:
    return all(sp.simplify(entry) == 0 for entry in value)


def permutation_matrix(permutation: tuple[int, ...]) -> sp.Matrix:
    result = sp.zeros(len(permutation))
    for column, row in enumerate(permutation):
        result[row, column] = 1
    return result


def verify_inputs(packet: dict) -> dict[str, Path]:
    resolved: dict[str, Path] = {}
    for label, record in packet["inputs"].items():
        repository = record["repository"]
        require(repository in REPOSITORIES, f"unknown repository: {repository}")
        path = REPOSITORIES[repository] / Path(record["relative_path"])
        require(path.is_file(), f"missing input: {label}")
        require(sha256(path) == record["sha256"], f"stale input hash: {label}")
        resolved[label] = path
    return resolved


def main() -> None:
    packet = load(PACKET)
    require(
        packet["schema"] == "MTTQ79SharedCircleClosureDynamicsSource.v1",
        "schema",
    )
    require(
        packet["theorem"]["name"]
        == "q79SharedCircleMorseBottClosureRepairPhaseAndFilteredCoherentSourceTheorem",
        "theorem name",
    )
    require(
        packet["theorem"]["tier"]
        == "CLOSED_EXACT_FINITE_ROOTSTACK_SAME_ACTION_HOLOMORPHIC_REPAIR_UNITARY_BRIDGE_WITH_EXPLICIT_PHYSICAL_PROMOTION_BOUNDARY",
        "theorem tier",
    )
    paths = verify_inputs(packet)

    hessian_source = load(paths["finite_Reynolds_Hessian"])
    jde_source = load(paths["shared_rootplane_JDE"])
    qm_source = load(paths["finite_q79_quantum_kinematics"])
    action_source = load(paths["accepted_finite_q79_action"])
    preparation_source = load(paths["finite_preparation_polarization_no_go"])
    pq_context_source = load(paths["canonical_PQ_response_typing"])
    universal_source = load(paths["universal_shared_line"])
    upper_source = load(paths["q79_upstairs_derived_complex"])

    source_data = packet["finite_source_data"]
    identity = sp.eye(6)
    tangent = matrix(source_data["tangent_or_invariant_projector_P"])
    normal = matrix(source_data["normal_or_positive_Hessian_projector_Q"])
    complex_structure = matrix(source_data["shared_quarter_turn_JDE"])

    require(
        tangent == matrix(hessian_source["finite_data"]["reynolds_projector"]),
        "tangent projector provenance",
    )
    require(
        normal
        == matrix(hessian_source["finite_data"]["normalized_hessian_shape"]),
        "normal Hessian provenance",
    )
    require(
        complex_structure == matrix(hessian_source["finite_data"]["J_DE"]),
        "J_DE Hessian provenance",
    )
    require(
        complex_structure == matrix(jde_source["finite_data"]["induced_JDE"]),
        "J_DE independent provenance",
    )
    require(
        normal == matrix(qm_source["operators"]["normalized_hessian_shape"]),
        "finite QM Hessian provenance",
    )

    representations = [
        sp.diag(
            permutation_matrix(permutation),
            permutation_matrix(permutation),
        )
        for permutation in permutations(range(3))
    ]
    reconstructed_reynolds = sum(representations, sp.zeros(6)) / len(
        representations
    )
    reconstructed_defect_gram = sum(
        (
            (identity - representation).T
            * (identity - representation)
            for representation in representations
        ),
        sp.zeros(6),
    ) / (2 * len(representations))
    require(reconstructed_reynolds == tangent, "action Reynolds reconstruction")
    require(reconstructed_defect_gram == normal, "action Hessian reconstruction")
    require(
        action_source["finite_action_source"]["hessian"]
        == "H_fin=kappa_fin Q",
        "accepted action Hessian",
    )
    require(
        pq_context_source["q79_selected_context"]["interpretation"]
        == ["coherent/symmetric response", "closure-strain response"],
        "P/Q role typing",
    )

    require(tangent**2 == tangent, "P idempotent")
    require(normal**2 == normal, "Q idempotent")
    require(tangent + normal == identity, "P+Q=I")
    require(is_zero(tangent * normal), "PQ=0")
    require(tangent.rank() == 2 and normal.rank() == 4, "projector ranks")
    require(complex_structure**2 == -identity, "J^2=-I")
    require(complex_structure.T == -complex_structure, "J skew")
    require(complex_structure.T * complex_structure == identity, "J orthogonal")
    require(
        is_zero(complex_structure * tangent - tangent * complex_structure),
        "[J,P]=0",
    )
    require(
        is_zero(complex_structure * normal - normal * complex_structure),
        "[J,Q]=0",
    )

    r, s = sp.symbols("r s", real=True)
    repair_r = tangent + r * normal
    repair_s = tangent + s * normal
    require(
        sp.simplify(
            repair_r * repair_s - (tangent + r * s * normal)
        )
        == sp.zeros(6),
        "repair semigroup",
    )
    require(
        sp.simplify(
            repair_r.T * normal * repair_r - r**2 * normal
        )
        == sp.zeros(6),
        "repair energy identity",
    )

    jp = complex_structure * tangent
    jq = complex_structure * normal
    coherent = -jp
    complement = -jq
    require(coherent.T == -coherent, "coherent phase skew")
    require(complement.T == -complement, "complement phase skew")
    require(coherent != complement, "phase endpoints distinct")
    require(coherent.rank() == 2, "coherent phase rank")
    require(complement.rank() == 4, "complement phase rank")
    require(coherent + complement == -complex_structure, "global phase sum")
    require(is_zero(coherent * normal - normal * coherent), "coherent commutation")
    require(
        is_zero(complement * normal - normal * complement),
        "complement commutation",
    )

    coefficient_vectors = sp.Matrix.hstack(
        sp.Matrix(jp).reshape(36, 1),
        sp.Matrix(jq).reshape(36, 1),
    )
    require(coefficient_vectors.rank() == 2, "phase allocation dimension")

    k_plus = (tangent - sp.I * complex_structure * tangent) / 2
    k_minus = (tangent + sp.I * complex_structure * tangent) / 2
    require(k_plus.rank() == 1 and k_minus.rank() == 1, "polarization ranks")
    require(is_zero(k_plus**2 - k_plus), "K_plus projector")
    require(is_zero(k_minus**2 - k_minus), "K_minus projector")
    require(is_zero(sp.conjugate(k_plus).T - k_plus), "K_plus Hermitian")
    require(is_zero(sp.conjugate(k_minus).T - k_minus), "K_minus Hermitian")
    require(k_plus != k_minus, "polarizations distinct")
    require(
        preparation_source["checks"]["two_ground_states_are_distinct"] is True,
        "independent polarization no-go",
    )

    scalar_x = sp.symbols("x", real=True)
    nonlinear_lambda = sp.symbols("lambda", real=True, nonzero=True)
    action_1 = scalar_x**2 / 2
    action_2 = action_1 + nonlinear_lambda * scalar_x**4
    require(
        sp.diff(action_1, scalar_x, 2).subs(scalar_x, 0)
        == sp.diff(action_2, scalar_x, 2).subs(scalar_x, 0)
        == 1,
        "nonlinear actions share Hessian",
    )
    require(
        sp.simplify(
            sp.diff(action_2, scalar_x) - sp.diff(action_1, scalar_x)
        )
        == 4 * nonlinear_lambda * scalar_x**3,
        "nonlinear repair fields differ",
    )

    chi_zero, chi_one, repair_factor = sp.symbols(
        "chi_0 chi_1 repair_factor",
        real=True,
    )
    finite_filter = chi_zero * tangent + chi_one * normal
    finite_repair = tangent + repair_factor * normal
    finite_filtered_operator = sp.simplify(
        tangent
        * finite_filter
        * finite_repair
        * finite_filter
        * tangent
    )
    require(
        is_zero(finite_filtered_operator - chi_zero**2 * tangent),
        "finite duality filtered compression",
    )
    require(
        not finite_filtered_operator.has(repair_factor),
        "finite duality tau independence",
    )
    require(
        all(
            is_zero(element * normal - normal * element)
            for element in (
                identity,
                complex_structure,
                normal,
                complex_structure * normal,
            )
        ),
        "minimal algebra preprojection no-go",
    )

    c0, c1, c2, c3 = sp.symbols("c0 c1 c2 c3", real=True)
    candidate = (
        c0 * identity
        + c1 * complex_structure
        + c2 * normal
        + c3 * complex_structure * normal
    )
    equations = list(candidate + candidate.T)
    coefficients, _ = sp.linear_eq_to_matrix(
        equations,
        [c0, c1, c2, c3],
    )
    nullspace = coefficients.nullspace()
    require(len(nullspace) == 2, "minimal algebra skew dimension")
    require(
        nullspace == [
            sp.Matrix([0, 1, 0, 0]),
            sp.Matrix([0, 0, 0, 1]),
        ],
        "minimal algebra skew basis",
    )

    holomorphic = packet["same_action_holomorphic_semigroup"]
    complex_source = matrix(
        holomorphic["negative_imaginary_quarter_boundary"]["matrix"]
    )
    complex_source_conjugate = matrix(
        holomorphic["positive_imaginary_quarter_boundary"]["matrix"]
    )
    require(complex_source == tangent + sp.I * normal, "negative quarter boundary")
    require(
        complex_source_conjugate == tangent - sp.I * normal,
        "positive quarter boundary",
    )
    require(
        is_zero(sp.conjugate(complex_source).T * complex_source - identity),
        "negative quarter boundary unitary",
    )
    require(
        is_zero(
            sp.conjugate(complex_source_conjugate).T
            * complex_source_conjugate
            - identity
        ),
        "positive quarter boundary unitary",
    )
    require(complex_source**4 == identity, "quarter boundary order four")
    require(
        is_zero(sp.conjugate(complex_source) - complex_source_conjugate),
        "quarter boundaries conjugate",
    )
    require(
        is_zero(
            tangent * complex_source_conjugate * tangent - tangent
        ),
        "same-action unitary compresses trivially to coherent sector",
    )
    require(
        is_zero(tangent * complement * tangent),
        "same-action generator vanishes on coherent sector",
    )

    positive_i = (identity - sp.I * complex_structure) / 2
    complement_quarter = tangent - jq
    require(
        is_zero(
            complement_quarter * positive_i
            - (tangent - sp.I * normal) * positive_i
        ),
        "existing finite flow polarization",
    )
    require(
        qm_source["operators"]["dimensionless_flow"]
        == "U(s)=P_Haar+exp(-i s)(I-P_Haar)",
        "existing finite flow source",
    )

    require(
        packet["phase_generator_classification"][
            "uniqueness_from_current_operator_projector_data"
        ]
        is False,
        "phase nonuniqueness retained",
    )
    require(
        packet["phase_generator_classification"][
            "uniqueness_after_same_action_analytic_boundary_rule"
        ]
        is True,
        "same-action boundary uniqueness",
    )
    require(
        holomorphic["dimensionless_same_action_bridge_closed"] is True,
        "finite same-action bridge",
    )
    require(
        holomorphic["physical_time_and_scale_selected"] is False,
        "physical time boundary",
    )
    require(
        packet["abstract_same_action_linearization_theorem"][
            "spatial_heat_kernel_status"
        ].startswith("NOT_CLAIMED:"),
        "spatial heat-kernel boundary",
    )
    duality = packet["duality_filtered_operator_source_assessment"]
    require(
        duality["finite_q79_specialization"]["linearization"] == "A_fin=Q",
        "finite duality linearization",
    )
    require(
        duality["finite_q79_specialization"][
            "nontrivial_coherent_spectral_dynamics_emitted"
        ]
        is False,
        "finite coherent-spectrum boundary",
    )
    require(
        duality["status"]
        == "CONDITIONAL_GENERAL_SOURCE_CLOSED_EXACT_AND_FINITE_Q79_"
        "ZERO_MODE_COMPRESSION_OBSTRUCTION_CLOSED_EXACT_"
        "CONTINUUM_SPECTRUM_OR_NONINVARIANT_REDUCTION_OPEN",
        "duality source assessment tier",
    )
    require(
        universal_source["guardrails"][
            "claims_q79_Z64_is_the_SM_hypercharge_circle"
        ]
        is False,
        "circle separation",
    )
    require(
        upper_source["strict_physical_upper_state_readiness"]["gates"][
            "balanced_HYM_superconnection"
        ]
        is False,
        "physical HYM boundary",
    )
    require(
        packet["blocker_assessment"]["B.ACTION.01"].startswith("OPEN:"),
        "B.ACTION.01 boundary",
    )
    require(
        packet["blocker_assessment"]["B.OP.01"].startswith("OPEN:"),
        "B.OP.01 boundary",
    )
    require(all(packet["checks"].values()), "serialized checks")
    require(
        not any(
            value
            for key, value in packet["guardrails"].items()
            if key.startswith("claims_")
        ),
        "guardrails",
    )
    require(packet["guardrails"]["uses_observed_values"] is False, "no observations")
    require(
        packet["guardrails"]["adds_dimensionless_fitted_parameters"] is False,
        "no fitted parameters",
    )

    print("Q79_SHARED_CIRCLE_CLOSURE_DYNAMICS_SOURCE_VERIFY_PASS")
    print("finite same-action holomorphic repair/unitary bridge verified")
    print("physical q79 continuum action, reconstruction and time scale remain open")


if __name__ == "__main__":
    main()
