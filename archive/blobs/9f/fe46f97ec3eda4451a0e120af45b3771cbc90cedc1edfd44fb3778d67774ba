ROOT = Path(__file__).resolve().parent
CHUNK_DIR = ROOT / "state" / "g3am_cayley_fiber2_response_chunks"
G3AL_PACKET = ROOT / "state" / "ust_g3al_selected_carrier_response_schur.packet.json"
