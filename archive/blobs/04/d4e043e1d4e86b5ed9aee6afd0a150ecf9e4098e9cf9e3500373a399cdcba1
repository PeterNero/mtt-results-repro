def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    return {
        "repository": "20 Mathematical Language Discovery Program",
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def exact_residual_nonzeros(left: sparse.spmatrix, right: sparse.spmatrix) -> int:
    residual = (left.astype(np.int32) - right.astype(np.int32)).tocsc()
    residual.data %= PRIME
    residual.eliminate_zeros()
    return int(residual.nnz)


def require_log(path: Path, rhs_columns: int) -> None:
    text = path.read_text(encoding="utf-8")
    require("SUCCESS" in text, f"{path.name} success")
    require(f"rhs_columns={rhs_columns}" in text, f"{path.name} RHS count")


def normalize(matrix: sparse.spmatrix) -> sparse.csc_matrix:
    result = matrix.tocsc(copy=True)
    result.data %= PRIME
    result.eliminate_zeros()
    return result


def normalized_null_vector(
    matrix: np.ndarray,
) -> tuple[np.ndarray, list[int], list[int], int]:
    """Return one canonical null vector and the pivot columns over GF(11)."""
    work = np.asarray(matrix, dtype=np.int64).copy() % PRIME
    rows, columns = work.shape
    pivot_row = 0
    pivot_columns: list[int] = []
    pivot_rows: list[int] = []
    row_labels = np.arange(rows, dtype=np.int32)
    pivot_minor_determinant = 1
    for column in range(columns):
        candidates = np.flatnonzero(work[pivot_row:, column])
        if candidates.size == 0:
            continue
        selected = pivot_row + int(candidates[0])
        if selected != pivot_row:
            work[[pivot_row, selected]] = work[[selected, pivot_row]]
            row_labels[[pivot_row, selected]] = row_labels[[selected, pivot_row]]
        pivot = int(work[pivot_row, column])
        pivot_minor_determinant = pivot_minor_determinant * pivot % PRIME
        pivot_rows.append(int(row_labels[pivot_row]))
        work[pivot_row] = work[pivot_row] * pow(pivot, -1, PRIME) % PRIME
        if pivot_row + 1 < rows:
            factors = work[pivot_row + 1 :, column].copy()
            active = np.flatnonzero(factors)
            if active.size:
                target_rows = pivot_row + 1 + active
                work[target_rows] = (
                    work[target_rows] - factors[active, None] * work[pivot_row]
                ) % PRIME
        pivot_columns.append(column)
        pivot_row += 1
        if pivot_row == rows:
            break
    free_columns = [column for column in range(columns) if column not in set(pivot_columns)]
    require(free_columns, "null vector requires a free column")
    free = free_columns[0]
    vector = np.zeros(columns, dtype=np.int64)
    vector[free] = 1
    for row in range(len(pivot_columns) - 1, -1, -1):
        pivot_column = pivot_columns[row]
        value = int(np.dot(work[row, pivot_column + 1 :], vector[pivot_column + 1 :]) % PRIME)
        vector[pivot_column] = (-value) % PRIME
    residual = np.asarray(matrix, dtype=np.int64) @ vector % PRIME
    require(not np.any(residual), "null-vector residual")
    first = int(np.flatnonzero(vector)[0])
    vector = vector * pow(int(vector[first]), -1, PRIME) % PRIME
    require(int(vector[first]) == 1, "canonical null-vector normalization")
    return vector.astype(np.uint8), pivot_columns, pivot_rows, pivot_minor_determinant


def sector_nonzeros(vector: np.ndarray) -> dict[str, int]:
    return {
        "H20": int(np.count_nonzero(vector[:248])),
        "H11": int(np.count_nonzero(vector[248:1261])),
        "H02": int(np.count_nonzero(vector[1261:1509])),
    }


