#!/usr/bin/env python3
"""Verify the selected G3AP quotient-ring Hilbert certificate."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import subprocess
import tempfile

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import build_ust_g3ap_selected_cayley_fiber2_qring_top_dimension as qring
import certify_ust_g3ap_selected_cayley_fiber2_qring_hilbert_candidate as cert
import run_ust_g3ap_selected_cayley_fiber2_qring_hilbert_hedge as guided
import run_ust_g3ap_selected_cayley_fiber2_qring_hilbert44_hedge as guided44
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
PACKET = cert.PACKET


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def checked(record: dict, label: str) -> Path:
    path = ROOT / record["path"]
    require(path.is_file() and sha256(path) == record["sha256"], label)
    return path


def verify_cache_headers(
    source: str,
    base_cache: Path,
    module_cache: Path,
    base_size: int,
    module_size: int,
) -> None:
    base_relative = str(base_cache.relative_to(ROOT)).replace("\\", "/")
    module_relative = str(module_cache.relative_to(ROOT)).replace("\\", "/")
    script = fiber2.selected_base_prefix(source) + f'''def cachedBase=read("ssi:r {base_relative}");
ideal GI=cachedBase;
print("G3AP_F2_QHVERIFY_BASE_IS_SB_ATTR="+string(attrib(GI,"isSB")));
print("G3AP_F2_QHVERIFY_BASE_SIZE="+string(size(GI)));
attrib(GI,"isSB",1);
qring q=GI;
def cachedModule=read("ssi:r {module_relative}");
module G=cachedModule;
print("G3AP_F2_QHVERIFY_MODULE_IS_SB_ATTR="+string(attrib(G,"isSB")));
print("G3AP_F2_QHVERIFY_MODULE_SIZE="+string(size(G)));
print("G3AP_F2_QHVERIFY_CACHE_PASS");
quit;
'''
    path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            suffix=".sing",
            prefix="ust_g3ap_f2_qhverify_",
            dir=ROOT / "state",
            delete=False,
        ) as temporary:
            temporary.write(script)
            path = Path(temporary.name)
        completed = subprocess.run(
            singular_command(ROOT, path),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=600,
            check=False,
        )
        require(completed.returncode == 0, "cache header execution")
        require("G3AP_F2_QHVERIFY_CACHE_PASS" in completed.stdout, "cache header pass")
        expected = {
            "G3AP_F2_QHVERIFY_BASE_IS_SB_ATTR": 0,
            "G3AP_F2_QHVERIFY_BASE_SIZE": base_size,
            "G3AP_F2_QHVERIFY_MODULE_IS_SB_ATTR": 0,
            "G3AP_F2_QHVERIFY_MODULE_SIZE": module_size,
        }
        for label, value in expected.items():
            require(
                re.search(rf"^{label}={value}$", completed.stdout, re.MULTILINE)
                is not None,
                label,
            )
    finally:
        if path is not None:
            path.unlink(missing_ok=True)


def main() -> None:
    packet = json.loads(PACKET.read_text(encoding="ascii"))
    require(
        packet["schema"]
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-hilbert-certified-top.v1",
        "schema",
    )
    require(
        packet["theorem_id"] == "UST.G3AP.FIBER2.QRING.HILBERT.CERTIFIED",
        "theorem id",
    )
    require(all(packet["checks"].values()), "checks")
    require(not any(packet["guardrails"].values()), "guardrails")
    candidate_path = checked(packet["inputs"]["candidate"], "candidate packet")
    source_path = checked(packet["inputs"]["selected_source"], "selected source")
    script = checked(packet["execution"]["script"], "certification script")
    output = checked(packet["execution"]["output"], "certification output")
    base_cache = checked(
        packet["execution"]["certified_base_cache"], "certified base cache"
    )
    module_cache = checked(
        packet["execution"]["certified_module_cache"], "certified module cache"
    )
    candidate = json.loads(candidate_path.read_text(encoding="ascii"))
    candidate_schema = candidate["schema"]
    if (
        candidate_schema
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-hilbert-guided-candidate.v1"
    ):
        candidate_runner = guided
        expected_status = (
            "CANDIDATE_REQUIRES_INDEPENDENT_BASE_AND_SELECTED_SOURCE_CERTIFICATION"
        )
    elif (
        candidate_schema
        == "mtt.unified-source.g3ap-selected-cayley-fiber2-qring-hilbert44-guided-candidate.v1"
    ):
        candidate_runner = guided44
        expected_status = "CANDIDATE_REQUIRES_ORDINARY_NO_HINT_RECONSTRUCTION"
    else:
        raise AssertionError("candidate schema")
    require(candidate["status"] == expected_status, "candidate tier")
    require(
        candidate["inputs"]["selected_source"]["sha256"] == sha256(source_path),
        "same selected source",
    )
    source = source_path.read_text(encoding="ascii")
    _, full_hint = guided.guided.load_hint()
    hint = (
        full_hint
        if candidate_runner is guided
        else guided44.prefix_hint(full_hint)
    )
    candidate_script = checked(candidate["execution"]["script"], "candidate script")
    candidate_base = checked(
        candidate["inputs"]["untrusted_base_cache"], "candidate base cache"
    )
    candidate_module = checked(
        candidate["execution"]["candidate_module_cache"],
        "candidate module cache",
    )
    require(
        candidate_script.read_text(encoding="ascii")
        == guided.guided_qring_script(source, hint, candidate_runner.MODULE_CACHE),
        "guided provenance reconstruction",
    )
    require(candidate_base == candidate_runner.BASE_CACHE, "candidate base path")
    require(candidate_module == candidate_runner.MODULE_CACHE, "candidate module path")
    require(
        script.read_text(encoding="ascii")
        == cert.certification_script(source, candidate_base, candidate_module),
        "certification reconstruction",
    )
    raw = output.read_text(encoding="utf-8")
    expected_markers = {
        "G3AP_F2_QHCERT_BASE_CANDIDATE_IS_SB_ATTR": 0,
        "G3AP_F2_QHCERT_BASE_IDEAL_EQUAL": 1,
        "G3AP_F2_QHCERT_MODULE_CANDIDATE_IS_SB_ATTR": 0,
        "G3AP_F2_QHCERT_ORIGINAL_GENERATORS": 21,
        "G3AP_F2_QHCERT_BAD_GENERATOR_REMAINDERS": 0,
    }
    for label, value in expected_markers.items():
        require(
            re.search(rf"^{label}={value}$", raw, re.MULTILINE) is not None,
            label,
        )
    require("G3AP_F2_QHCERT_PASS" in raw, "raw pass")
    base, module = cert.parse_leaders(raw)
    require(len(base) == packet["execution"]["base_basis_size"], "base leader count")
    require(
        len(module) == packet["execution"]["certified_basis_size_through_bound"],
        "module leader count",
    )
    standards, sectors = fiber2.enumerate_target(qring.combined_leaders(base, module))
    total = sum(sector["enumerated_monomials"] for sector in sectors.values())
    require(
        total == fiber2.EXPECTED_TOTAL == 174865
        and standards == [fiber2.EXPECTED_STANDARD],
        "exact target replay",
    )
    require(packet["fiber_degree_two_module"]["sectors"] == sectors, "sector replay")
    top = packet["ordinary_top_piece"]
    require(
        top["dimension"] == 1 and top["basis"] == ["w^12*t2^4*s^2"],
        "top line",
    )
    base_record = packet["execution"]["certified_base_cache"]
    module_record = packet["execution"]["certified_module_cache"]
    require(base_cache.stat().st_size == base_record["bytes"] > 0, "base bytes")
    require(module_cache.stat().st_size == module_record["bytes"] > 0, "module bytes")
    require(base_record["isSB_trust_attribute_stored"] is False, "base cache scope")
    require(
        module_record["valid_through_base_scalar_degree"] == 44
        and module_record["isSB_trust_attribute_stored"] is False,
        "module cache scope",
    )
    verify_cache_headers(source, base_cache, module_cache, len(base), len(module))
    print(
        "UST.G3AP.FIBER2.QRING.HILBERT.CERTIFIED verifier: PASS "
        f"base={len(base)} module={len(module)} Cox_monomials={total} dimension=1"
    )


if __name__ == "__main__":
    main()
