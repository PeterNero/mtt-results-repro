#!/usr/bin/env python3
"""Adopt the verified full-source target-Macaulay quotient map as canonical G3AP."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
SOURCE = (
    ROOT
    / "state"
    / "ust_g3ap_selected_cayley_target_macaulay_full_reused.certified.packet.json"
)
FULL_VERIFIER = ROOT / "certify_ust_g3ap_selected_cayley_target_macaulay_full.py"
INCREMENTAL_VERIFIER = (
    ROOT
    / "certify_ust_g3ap_selected_cayley_target_macaulay_full_from_incremental.py"
)
INCREMENTAL_WITNESS = (
    ROOT
    / "state"
    / "ust_g3ap_selected_cayley_target_macaulay_incremental_rank_witness.latest.json"
)
OUT = ROOT / "state" / "ust_g3ap_selected_cayley_ordinary_top_dimension.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while block := stream.read(8 * 1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--skip-verifier", action="store_true")
    args = parser.parse_args()
    if not args.skip_verifier:
        use_incremental = INCREMENTAL_WITNESS.is_file()
        if SOURCE.is_file():
            existing = json.loads(SOURCE.read_text(encoding="ascii"))
            use_incremental = "incremental_rank_witness" in existing.get(
                "inputs", {}
            )
        verifier = INCREMENTAL_VERIFIER if use_incremental else FULL_VERIFIER
        command = [sys.executable, str(verifier), "--reuse-source-certificate"]
        if use_incremental and SOURCE.is_file():
            command.append("--reuse-full-functional")
        subprocess.run(
            command,
            cwd=ROOT,
            check=True,
        )
    source = json.loads(SOURCE.read_text(encoding="ascii"))
    require(
        source["status"]
        == "CLOSED_EXACT_SELECTED_F1016_FULL_SOURCE_ORDINARY_TOP_DIMENSION_ONE"
        and all(source["checks"].values())
        and not any(source["guardrails"].values()),
        "source certificate",
    )
    top = source["ordinary_top_piece"]
    quotient = source["quotient_functional"]
    require(
        top["dimension"] == 1
        and top["basis_component"] == quotient["normalization_component"]
        and top["basis_base_exponent"] == quotient["normalization_base_exponent"],
        "top quotient normalization",
    )
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1",
        "date": "2026-08-11",
        "theorem_id": "UST.G3AP",
        "status": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_CAYLEY_TOP_SOCLE_DIMENSION_ONE",
        "inputs": {
            "target_macaulay_rank_squeeze_certified_top": {
                "path": str(SOURCE.relative_to(ROOT)).replace("\\", "/"),
                "sha256": sha256(SOURCE),
            }
        },
        "leading_ideal": {
            "method": "full_92979_row_selected_source_exact_target_Macaulay_rank39725_squeezed_by_selected_R1_lower_bound",
            "base_quotient": "B/(K,E,C)",
            "target_coordinates": source["target_relation_map"]["coordinates"],
            "scheduled_relation_rows": source["target_relation_map"][
                "selected_relation_rows"
            ],
            "selected_relation_rows": source["target_relation_map"][
                "selected_relation_rows"
            ],
            "explicit_zero_rows": 0,
            "selected_relation_rank": source["target_relation_map"]["exact_rank"],
            "base_quotient_target_coordinates": source["target_relation_map"][
                "coordinates"
            ],
            "quotient_functional": quotient["artifact"],
            "custom_minor_determinant_packed": source["target_relation_map"][
                "custom_nonzero_minor_determinant_packed"
            ],
            "independent_exact_minor_rank": source["target_relation_map"][
                "independent_exact_minor_rank"
            ],
            "independent_rank_route": source["target_relation_map"][
                "independent_rank_route"
            ],
            "full_standard_basis_claimed": False,
        },
        "ordinary_top_piece": {
            "Cox_degree": top["Cox_degree"],
            "enumerated_monomials": top["Cox_monomials_enumerated"],
            "base_quotient_target_coordinates": top[
                "base_quotient_target_coordinates"
            ],
            "dimension": 1,
            "basis": top["basis"],
            "basis_old_component": top["basis_component"],
            "basis_new_component": top["basis_component"],
            "basis_base_exponent": top["basis_base_exponent"],
        },
        "checks": {
            "selected_base_ideal_is_independently_reconstructed": True,
            "every_Macaulay_row_has_exact_selected_source_provenance": True,
            "a_nonzero_39725_minor_is_emitted_and_its_determinant_replayed": True,
            "independent_exact_field_arithmetic_confirms_rank39725": True,
            "the_normalized_quotient_functional_is_independently_replayed_on_every_selected_row": True,
            "the_selected_R1_residue_theorem_gives_the_lower_bound_one": True,
            "the_selected_ordinary_top_piece_has_dimension_one": True,
            "the_exact_finite_quotient_reduction_functional_is_emitted": True,
            "no_predecessor_entry_is_used_as_selected_source_evidence": True,
            "no_observed_value_or_fit_parameter_is_used": True,
        },
        "guardrails": {
            "claims_a_full_unrestricted_standard_basis": False,
            "claims_characteristic_zero_rank_promotion": False,
            "claims_beta_C_is_computed": False,
        },
        "theorem": {
            "name": "selectedCayleyOrdinaryTopDimensionByFullSourceExactTargetMacaulayRankSqueezeTheorem",
            "tier": "CLOSED_EXACT_SELECTED_F1016_ORDINARY_TOP_DIMENSION_ONE",
            "statement": source["theorem"]["statement"],
        },
        "next_required_object": (
            "Apply the emitted exact target quotient functional directly to the "
            "same-carrier G3AM principal-response products."
        ),
    }
    require(all(packet["checks"].values()), "canonical checks")
    OUT.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print("UST.G3AP target-Macaulay quotient map adopted as canonical dimension one")


if __name__ == "__main__":
    main()
