    pointer_minus = [
        [Fraction(0), Fraction(0)],
        [Fraction(0), Fraction(1)],
    ]
    gram = mul(transpose(interaction_derivative), interaction_derivative)
    gram_inverse_sqrt = [
        [Fraction(1, 2), Fraction(0)],
        [Fraction(0), Fraction(1, 3)],
    ]
    polar_isometry = mul(interaction_derivative, gram_inverse_sqrt)
    response_plus = mul(pointer_plus, interaction_derivative)
    response_minus = mul(pointer_minus, interaction_derivative)
