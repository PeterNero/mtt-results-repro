#!/usr/bin/env python3
"""Independently verify the G3CF rational-domain certificate."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent
PACKET = ROOT / "state" / "ust_g3cf_transcendental_arc_schur_gauge.packet.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing input: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def verify_record(record: dict[str, Any]) -> Path:
    path = ROOT / record["path"]
    require(path.is_file(), f"record path: {path}")
    require(path.stat().st_size == int(record["bytes"]), f"record size: {path}")
    require(sha256(path) == record["sha256"], f"record hash: {path}")
    return path


def main() -> None:
    packet = load(PACKET)
    require(packet["schema"] == "mtt.unified-source.g3cf-transcendental-arc-schur-gauge.v1", "schema")
    require(packet["theorem_id"] == "UST.G3CF", "theorem id")
    require(all(packet["checks"].values()), "packet checks")
    require(not any(packet["guardrails"].values()), "packet guardrails")

    inputs = {name: load(verify_record(record)) for name, record in packet["inputs"].items()}
    expected_schemas = {
        "G3BJ": "mtt.unified-source.g3bj-transcendental-arc-path.v1",
        "G3BK": "mtt.unified-source.g3bk-correction-pencil-operator.v1",
        "G3BN": "mtt.unified-source.g3bn-h11-alternate-split-prime-initializer.v1",
        "G3BR": "mtt.unified-source.g3br-h02-alternate-split-prime-initializer.v1",
        "G3CA": "mtt.unified-source.g3ca-selected-delta-correction-h02-source.v1",
        "G3CE": "mtt.unified-source.g3ce-hodge-schur-affine-reduction.v1",
    }
    for name, source in inputs.items():
        require(source["schema"] == expected_schemas[name], f"{name} schema")
        require(all(source["checks"].values()), f"{name} checks")
        require(not any(source["guardrails"].values()), f"{name} guardrails")

    g3bj = inputs["G3BJ"]
    g3bk = inputs["G3BK"]
    g3bn = inputs["G3BN"]
    g3br = inputs["G3BR"]
    g3ca = inputs["G3CA"]
    g3ce = inputs["G3CE"]
    require(g3bj["selected_path"]["formula"] == "a(t)=1-t+i*pi*t*(1-t)", "path formula")
    require(g3bj["selected_path"]["derivative"] == "a'(t)=-1+i*pi*(1-2t)", "path derivative")
    require(g3bj["checks"]["every_interior_selected_path_parameter_is_transcendental"], "path transcendence")
    require(g3bk["checks"]["all_three_frozen_charts_avoid_poles_on_the_open_transcendental_arc"], "parent chart avoidance")
    boundary = g3bk["all_block_interior_chart_avoidance"]["start_endpoint"]
    require(boundary["maximum_remaining_chart_transition_location"] == "the initial endpoint a=1 only", "parent boundary")
    require(g3bn["endpoint_chart"]["determinant_mod21817"] == 276, "H11 endpoint unit")
    require(g3br["endpoint_chart"]["determinant_mod21817"] == 419, "H02 endpoint unit")
    require(g3ce["block_decomposition"]["lower_block_determinant_mod11"] == 4, "nonzero terminal lower determinant")
    require(g3ce["block_decomposition"]["lower_block_shape"] == [1261, 1261], "lower shape")
    require(g3ca["selected_source"]["coefficient_field"] == "Q(gamma)", "source field")
    source_path = verify_record(g3ca["selected_source"]["exact_polynomial"])
    source_terms = load(source_path)
    require(len(source_terms) > 0 if isinstance(source_terms, list) else bool(source_terms), "source payload nonempty")

    require(packet["coefficient_field"]["family"] == "k(a)", "family field")
    require(packet["static_schur_oracle"]["domain"] == "0<t<=1", "Schur domain")
    require(packet["static_schur_oracle"]["static_affine_matrix_size"] == 249, "static size")
    require(packet["static_schur_oracle"]["transport_affine_size_without_an_invariant_graph_theorem"] == 1510, "transport size")
    require(packet["pole_avoidance"]["unresolved_boundary"] == "J(1) at t=0 only; all three parent charts are already units there", "unresolved boundary")
    require("det J(0) reduces to 4" in packet["rational_family_typing"]["terminal_nonzero_certificate"], "terminal certificate text")
    require("transcendental" in packet["pole_avoidance"]["interior_path_values"], "interior avoidance text")

    print("UST.G3CF transcendental-arc Schur gauge verifier: PASS")
    print("rational_family=Q(gamma)(a) domain=0<t<=1 static=249 transport=1510 J1=open")


if __name__ == "__main__":
    main()
