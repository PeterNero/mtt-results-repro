#!/usr/bin/env python3
"""Certify the G3AO vs chart off K by the exact reciprocal presentation."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import time

import run_ust_g3ao_selected_cayley_toric_regularity as direct
import run_ust_g3ao_selected_cayley_toric_vs_dual_elimination as vs_dual
from ust_singular_runtime import singular_command


ROOT = Path(__file__).resolve().parent
CAMPAIGN = direct.CAMPAIGN / "vs_reciprocal"
LABEL = vs_dual.LABEL
ITEM = vs_dual.ITEM


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def make_script(polynomials: dict[str, str], algorithm: str) -> str:
    return f'''// UST.G3AO full-support vs exact reciprocal-bidual certificate.
// On r*K=1, C/K=B_ambient+r*C_reduced and dr=-r^2*dK.
ring source=(101,g),(x,y,z,w,t0,t1,t2,r),dp;
minpoly={polynomials["minpoly"]};
poly F6={polynomials["F6"]};
poly K=w^2-F6;
poly E={direct.ELLIPTIC_POLYNOMIAL};
poly A0={polynomials["A0"]};
poly A1={polynomials["A1"]};
poly A2={polynomials["A2"]};
poly Ap0=A0;
poly Ap1=A0+A1+3*A2;
poly Ap2=A0+7*A1+7*A2;
poly B_ambient={direct.AMBIENT_GAUGE};
poly D0=diff(B_ambient,t0);
poly D1=diff(B_ambient,t1);
poly D2=diff(B_ambient,t2);
poly P0=D0+r*Ap0;
poly P1=D1+r*Ap1;
poly P2=D2+r*Ap2;
poly Cscaled=P0*t0+P1*t1+P2*t2;
poly dual0=-14*P0;
poly dual1=-4*P0+7*P1-3*P2;
poly dual2=6*P0-7*P1+P2;
poly dualSextic=dual0^6+dual1^6+dual2^6
  -2*(dual0^3*dual1^3+dual0^3*dual2^3+dual1^3*dual2^3);
poly q0=dual0^2*(dual0^3-dual1^3-dual2^3);
poly q1=dual1^2*(dual1^3-dual0^3-dual2^3);
poly q2=dual2^2*(dual2^3-dual0^3-dual1^3);
poly contact0=-14*q0-4*q1+6*q2;
poly contact1=7*q1-7*q2;
poly contact2=-3*q1+q2;
poly contactR=contact0*Ap0+contact1*Ap1+contact2*Ap2;
poly baseResponseY=contact0*diff(P0,y)+contact1*diff(P1,y)+contact2*diff(P2,y)
  -r^2*diff(K,y)*contactR;
poly baseResponseZ=contact0*diff(P0,z)+contact1*diff(P1,z)+contact2*diff(P2,z)
  -r^2*diff(K,z)*contactR;
poly baseResponseW=contact0*diff(P0,w)+contact1*diff(P1,w)+contact2*diff(P2,w)
  -r^2*diff(K,w)*contactR;
ideal smoothDualLocus=r*K-1,dualSextic,baseResponseY,baseResponseZ,baseResponseW;
poly CscaledR=diff(Cscaled,r);
poly baseCscaledY=diff(Cscaled,y)-r^2*diff(K,y)*CscaledR;
poly baseCscaledZ=diff(Cscaled,z)-r^2*diff(K,z)*CscaledR;
poly baseCscaledW=diff(Cscaled,w)-r^2*diff(K,w)*CscaledR;
poly ellipticMinor=diff(E,t1)*diff(Cscaled,t2)-diff(E,t2)*diff(Cscaled,t1);
ideal singularDualLocus=r*K-1,E,Cscaled,baseCscaledY,baseCscaledZ,
  baseCscaledW,ellipticMinor,contact0,contact1,contact2;
ring smoothOrbit=(101,g),(y,z,w,r,orbitInv),dp;
minpoly={polynomials["minpoly"]};
map smoothMap=source,1,y,z,w,1,1,1,r;
ideal smoothRestricted=smoothMap(smoothDualLocus),orbitInv*(y*z*w*r)-1;
ideal smoothBasis={algorithm}(smoothRestricted);
int smoothEmpty=(size(smoothBasis)==1 && smoothBasis[1]==1);
print("G3AO_VS_RECIPROCAL_SMOOTH_EMPTY="+string(smoothEmpty));
setring source;
ring cuspOrbit=(101,g),(y,z,w,t1,t2,r,orbitInv),dp;
minpoly={polynomials["minpoly"]};
map cuspMap=source,1,y,z,w,1,t1,t2,r;
ideal cuspRestricted=cuspMap(singularDualLocus),orbitInv*(y*z*w*t1*t2*r)-1;
ideal cuspBasis={algorithm}(cuspRestricted);
int cuspEmpty=(size(cuspBasis)==1 && cuspBasis[1]==1);
print("G3AO_VS_RECIPROCAL_CUSP_EMPTY="+string(cuspEmpty));
if (smoothEmpty==1 && cuspEmpty==1)
{{ print("G3AO_VS_RECIPROCAL_ELIMINATION_PASS {LABEL}"); }}
else
{{ print("G3AO_VS_RECIPROCAL_ELIMINATION_INCONCLUSIVE {LABEL}"); }}
quit;
'''


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=int, default=7200)
    parser.add_argument("--algorithm", choices=("std", "slimgb"), default="std")
    args = parser.parse_args()
    require(args.timeout > 0, "positive timeout")
    require(direct.label(*ITEM) == LABEL, "selected full-support label")
    polynomials = direct.selected_polynomials()
    source_hash = sha256(direct.SOURCE)
    CAMPAIGN.mkdir(parents=True, exist_ok=True)
    script = CAMPAIGN / f"{LABEL}.{args.algorithm}.sing"
    output = CAMPAIGN / f"{LABEL}.{args.algorithm}.singular.out"
    packet_path = CAMPAIGN / f"{LABEL}.{args.algorithm}.packet.json"
    script.write_text(make_script(polynomials, args.algorithm), encoding="ascii")
    started = time.time()
    timed_out = False
    try:
        completed = subprocess.run(
            singular_command(ROOT, script),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=args.timeout,
            check=False,
        )
        raw = completed.stdout
        returncode = completed.returncode
    except subprocess.TimeoutExpired as error:
        timed_out = True
        captured = error.stdout or b""
        raw = (
            captured.decode("utf-8", errors="replace")
            if isinstance(captured, bytes)
            else captured
        )
        returncode = 124
    output.write_text(raw, encoding="utf-8")
    elapsed = time.time() - started
    passed = (
        not timed_out
        and returncode == 0
        and "G3AO_VS_RECIPROCAL_SMOOTH_EMPTY=1" in raw
        and "G3AO_VS_RECIPROCAL_CUSP_EMPTY=1" in raw
    )
    packet = {
        "schema": "mtt.unified-source.g3ao-selected-cayley-toric-orbit-vs-reciprocal.v1",
        "label": LABEL,
        "source_sha256": source_hash,
        "field": "F_101[g]/(g^6+24g^5+89g^4+44g^3+33g^2+16g+64)",
        "supports": {
            "base": list(direct.BASE),
            "elliptic": list(direct.ELLIPTIC),
            "Cayley_fiber": ["v", "s"],
        },
        "script": {
            "path": str(script.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(script),
        },
        "output": {
            "path": str(output.relative_to(direct.CAMPAIGN)).replace("\\", "/"),
            "sha256": sha256(output),
        },
        "algorithm": f"vs_reciprocal_{args.algorithm}",
        "certificate_method": "vs_off_K_reciprocal_bidual_smooth_and_cusp_loci",
        "proof_scope": {
            "the_exact_open_locus_relation_rK_equals_one_is_imposed": True,
            "C_over_K_equals_B_ambient_plus_r_C_reduced_on_that_locus": True,
            "the_tangent_rule_dr_equals_minus_r_squared_dK_is_used_in_every_base_derivative": True,
            "multiplication_by_the_unit_r_preserves_the_vs_critical_equations_on_C_zero": True,
            "smooth_and_singular_dual_loci_are_both_tested": True,
            "unit_saturated_ideals_prove_the_off_K_vs_locus_empty": passed,
            "the_complementary_K_zero_locus_is_not_claimed_by_this_packet": True,
            "a_nonunit_smooth_or_cusp_ideal_would_be_inconclusive": True,
        },
        "elapsed_seconds": elapsed,
        "returncode": returncode,
        "timed_out": timed_out,
        "passed": passed,
    }
    packet_path.write_text(json.dumps(packet, indent=2) + "\n", encoding="ascii")
    print(f"{LABEL}: {'PASS' if passed else 'INCONCLUSIVE'} RECIPROCAL ({elapsed:.1f}s)")
    if not passed:
        raise SystemExit(returncode or 1)


if __name__ == "__main__":
    main()
