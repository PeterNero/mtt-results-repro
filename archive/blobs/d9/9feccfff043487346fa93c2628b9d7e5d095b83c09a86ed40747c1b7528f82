def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path.relative_to(ROOT)}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def record(path: Path) -> dict[str, Any]:
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def write_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, ensure_ascii=True) + "\n", encoding="ascii")


def point_interval(value: int) -> dict[str, Any]:
    return {
        "real": {"lower": [value, 1], "upper": [value, 1]},
        "imag": {"lower": [0, 1], "upper": [0, 1]},
    }


def basis_column(index: int) -> list[dict[str, Any]]:
    return [point_interval(1 if coordinate == index else 0) for coordinate in range(DIMENSION)]


