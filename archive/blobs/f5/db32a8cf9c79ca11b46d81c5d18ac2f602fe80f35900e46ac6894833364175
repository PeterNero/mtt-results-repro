    dependency_checks = {
        "successor_continuum_table_remains_one_of_nine": (
            continuum_acceptance_count == 1
            and len(continuum_promotion_rows) == 9
        ),
        "formal_EG_first_tangent_remains_the_only_accepted_row": (
            [
                key
                for key, row in continuum_promotion_rows.items()
                if row["accepted"]
            ]
            == ["formal_EG_tangent_identification"]
        ),
        "full_quantum_Ward_row_remains_unaccepted": (
            not continuum_promotion_rows[
                "vanishing_Gauss_BRST_Ward_defect"
            ]["accepted"]
        ),
        "Ward_row_points_to_the_chiral_measure_row": (
            continuum_promotion_rows[
                "vanishing_Gauss_BRST_Ward_defect"
            ]["reduced_to"]
            == "full_nonabelian_chiral_measure_at_fixed_cutoff"
        ),
        "seven_independent_continuum_exits_remain": (
            independent_open_rows == expected_independent_open_rows
        ),
        "one_open_row_is_now_dependency_reduced": (
            dependent_open_rows
            == ["vanishing_Gauss_BRST_Ward_defect"]
        ),
    }

    guardrail_checks = {
        "finite_Z2_witness_is_not_called_the_full_SM_gauge_group": True,
        "nilpotent_ghost_matrix_is_not_called_a_positive_ghost_Hilbert_representation": (
            True
        ),
        "compact_gauge_fixed_points_are_not_called_full_BV_cohomology": (
            True
        ),
        "zero_algebraic_defect_is_not_called_a_chiral_measure_construction": (
            True
        ),
        "formal_anomaly_cancellation_is_not_called_nonperturbative_measure_closure": (
            True
        ),
        "the_full_quantum_Ward_row_is_not_promoted": True,
        "the_continuum_acceptance_count_is_not_increased": True,
        "no_physical_coupling_or_observed_value_is_introduced": True,
        "B_QFT_02_and_B_ACTION_01_remain_open": True,
    }

    theorem_checks = {
        "uniform_algebraic_Gauss_and_ghostzero_BRST_defect_theorem_is_closed": (
            all(source_checks.values())
            and all(algebraic_defect_checks.values())
            and all(dynamics_checks.values())
            and all(uniform_and_reduced_product_checks.values())
        ),
        "full_quantum_Ward_defect_is_reduced_to_the_chiral_measure_Jacobian": (
            all(quantum_ward_reduction_checks.values())
            and all(dependency_checks.values())
        ),
        "one_independent_continuum_blocker_is_eliminated_without_false_promotion": (
            len(independent_open_rows) == 7
            and len(dependent_open_rows) == 1
            and continuum_acceptance_count == 1
        ),
        "claim_boundary_is_preserved": all(guardrail_checks.values()),
    }

    checks = {
        **source_checks,
        **algebraic_defect_checks,
        **dynamics_checks,
        **uniform_and_reduced_product_checks,
        **quantum_ward_reduction_checks,
        **dependency_checks,
        **guardrail_checks,
        **theorem_checks,
    }

    return {
        "schema": (
            "MTTq79UniformGaussGhostZeroBRSTWardDefect"
            "AndChiralMeasureReductionCertificate.v1"
