#!/usr/bin/env python3
"""Verify UST.G3GI and independently replay its anchor obstruction."""

from __future__ import annotations

import json
import hashlib
import sys
from pathlib import Path

import numpy as np


ROOT = Path(__file__).resolve().parent
CALC = ROOT / "calculations/ust_g3gi_full_catalecticant_campaign"
sys.path.insert(0, str(CALC))

import run_shard


CERTIFICATE = ROOT / "evidence/ust_g3gi/H02.component20.full_catalecticant_source_exclusion.json"


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def main() -> None:
    packet = json.loads(CERTIFICATE.read_text(encoding="utf-8"))
    require(all(packet["checks"].values()), "certificate checks")
    require(not any(packet["guardrails"].values()), "certificate guardrails")
    campaign = json.loads(
        (CALC / "outputs/campaign.json").read_text(encoding="utf-8")
    )
    require(campaign["accepted"] and len(campaign["rows"]) == 96, "campaign")
    for artifact in campaign["shards"]:
        path = CALC / artifact["path"]
        require(path.is_file(), "shard artifact")
        require(sha256(path) == artifact["sha256"], "shard artifact hash")
    execution = json.loads(
        (CALC / "kernel_execution.json").read_text(encoding="utf-8")
    )
    require(len(execution["jobs"]) == 5, "isolated job count")
    require(
        all(row["exit_code"] == 0 for row in execution["jobs"]),
        "isolated exit codes",
    )
    require(
        all(execution["requester_verification"].values()),
        "requester verification",
    )
    arrays = np.load(
        CALC / "input/g3gi_full_catalecticant_input.npz", allow_pickle=False
    )
    prime = int(arrays["primes"][0])
    kernel = arrays["pdelta_kernels"][0].astype(np.int64) % prime
    target = arrays["degree15_targets"][0, 0].astype(np.int64) % prime
    for ordinary in (False, True):
        result = run_shard.run_fiber(
            kernel, target, prime, ordinary=ordinary
        )
        require(result["obstruction_rank"] == 244, "anchor rank")
        require(result["nullity"] == 9, "anchor nullity")
        require(result["induced_map_ranks"] == [0] * 9, "anchor zero maps")
    print(
        "UST.G3GI verifier: PASS campaign_rows=96 anchor_replay=2 "
        "rank=244 nullity=9 maps=zero",
        flush=True,
    )


if __name__ == "__main__":
    main()
