    def firstorder_gauge_symbol(
        covector_tuple: tuple[int, int, int, int],
    ) -> dict[str, Any]:
        covector = [
            Fraction(component) for component in covector_tuple
        ]
        norm_squared = sum(
            (component * component for component in covector),
            Fraction(0),
        )
        wedge_0 = wedge_symbol(covector, 0)
        wedge_1 = wedge_symbol(covector, 1)
        wedge_2 = wedge_symbol(covector, 2)
        wedge_3 = wedge_symbol(covector, 3)
        one_to_self_dual = mul(self_dual_projection, wedge_1)
        self_dual_to_three = mul(
            wedge_2,
            self_dual_inclusion,
        )

        differential_0 = zeros(7, 1)
        for row in range(4):
            differential_0[row][0] = wedge_0[row][0]

        differential_1 = zeros(7, 7)
        for row in range(3):
            for column in range(4):
                differential_1[row][column] = (
                    one_to_self_dual[row][column]
                )
        for row in range(4):
            for column in range(3):
                differential_1[3 + row][4 + column] = (
                    -self_dual_to_three[row][column]
                )

