def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def load(path: Path) -> dict[str, Any]:
    require(path.is_file(), f"missing {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def record(path: Path, *, repository: Path = ROOT) -> dict[str, Any]:
    require(path.is_file(), f"artifact exists: {path}")
    return {
        "path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def external_record(path: Path, repository: Path) -> dict[str, Any]:
    require(path.is_file(), f"external artifact exists: {path}")
    return {
        "repository": repository.name,
        "repository_relative_path": path.relative_to(repository).as_posix(),
        "sha256": sha256(path),
        "bytes": path.stat().st_size,
    }


def atomic_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(
        json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="ascii"
    )
    os.replace(temporary, path)


def update_progress(phase: str, **extra: Any) -> None:
    payload = {
        "schema": "mtt.unified-source.g3gk-progress.v1",
        "phase": phase,
        **extra,
    }
    atomic_json(PROGRESS, payload)
    print(f"G3GK progress phase={phase}", flush=True)


