    OUT.write_text(json.dumps(packet, indent=2, ensure_ascii=True) + "\n", encoding="ascii")
    print("UST.G3CF transcendental-arc Schur gauge: PASS")
    print("domain=0<t<=1 static_affine_size=249 transport_size=1510 J1=open")
    print(f"packet_sha256={sha256(OUT)}")


if __name__ == "__main__":
    main()
