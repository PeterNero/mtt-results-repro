#!/usr/bin/env python3
"""Adopt a certified direct 9H+L/L-truncated squeeze as canonical G3AP."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

import build_ust_g3ap_selected_cayley_fiber2_module_top_dimension as fiber2
import certify_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_candidate as certifier
import run_ust_g3ap_selected_cayley_fiber2_weighted_permuted_boxtrunc_hilbert_hedge as permuted


ROOT = Path(__file__).resolve().parent
OUT = ROOT / "state" / "ust_g3ap_selected_cayley_ordinary_top_dimension.packet.json"
FIBER_NAMES = ("u^2", "u*v", "u*s", "v^2", "v*s", "s^2")
BASE_NAMES = ("x", "y", "z", "w", "t0", "t1", "t2")


def require(condition: bool, label: str) -> None:
    if not condition:
        raise AssertionError(label)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def monomial(exponent: list[int], component: int) -> str:
    factors: list[str] = []
    for name, power in zip(BASE_NAMES, exponent):
        if power == 1:
            factors.append(name)
        elif power > 1:
            factors.append(f"{name}^{power}")
    factors.append(FIBER_NAMES[component - 1])
    return "*".join(factors)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--permutation", choices=tuple(permuted.PERMUTATIONS), required=True)
    parser.add_argument(
        "--candidate-engine", choices=tuple(certifier.RUNNERS), default="hilbert"
    )
    args = parser.parse_args()
    label = args.permutation
    candidate_engine = args.candidate_engine
    selected_runner = certifier.RUNNERS[candidate_engine]
    subprocess.run(
        [
            sys.executable,
            str(
                ROOT
                / "verify_ust_g3ap_selected_cayley_fiber2_hmajor_direct_ltrunc_certified.py"
            ),
            "--permutation",
            label,
            "--candidate-engine",
            candidate_engine,
        ],
        cwd=ROOT,
        check=True,
    )
    source_path = certifier.certified_paths(label, candidate_engine)["packet"]
    source = json.loads(source_path.read_text(encoding="ascii"))
    require(all(source["checks"].values()) and not any(source["guardrails"].values()), "source scope")
    top_source = source["ordinary_top_piece"]
    component = int(top_source["standard_old_component"])
    exponent = [int(value) for value in top_source["standard_exponent"]]
    basis = monomial(exponent, component)
    packet = {
        "schema": "mtt.unified-source.g3ap-selected-cayley-ordinary-top-dimension.v1",
        "date": "2026-08-10",
